<?xml version="1.0" encoding="utf-8"?>
<stepos.support.v7.widget.PopupNestedScrollingLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nested_scrolling_layout"
    android:background="@color/transparent"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/stepos_lite_popup_padding_horizontal">
    <LinearLayout
        android:id="@+id/action_bar_container"
        android:background="@color/transparent"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-1px">
        <stepos.support.v7.widget.Toolbar
            android:id="@+id/title_bar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/widget_text_blue"
                    android:gravity="center"
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="取消"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/colorBlack"
                    android:gravity="center"
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="家庭无线网络"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/widget_text_blue"
                    android:gravity="center"
                    android:id="@+id/save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </stepos.support.v7.widget.Toolbar>
    </LinearLayout>
    <stepos.support.v7.widget.LitePopupContentFrameLayout
        android:id="@+id/content_panel"
        android:background="?attr/colorSurfaceBright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_nested_scrollview="true"/>
</stepos.support.v7.widget.PopupNestedScrollingLayout>
