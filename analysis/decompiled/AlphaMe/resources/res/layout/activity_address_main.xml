<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/address_content_layout"
    android:background="@drawable/popu_action_bar_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/action_bar_container"
        android:background="@drawable/popu_action_bar_bg"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <stepos.support.v7.widget.Toolbar
            android:id="@+id/title_bar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:id="@+id/toolbar_title"
                    android:background="@drawable/press_anim_background_4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="家庭无线网络"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"
                    android:id="@+id/save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </stepos.support.v7.widget.Toolbar>
    </androidx.core.widget.NestedScrollView>
    <com.stepos.common.widget.EmptyView
        android:id="@+id/main_emptyView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="297dp"
        android:layout_centerHorizontal="true"
        app:mcSrcOfImage="@drawable/aicy_ic_empty_view_no_network"
        app:mcTitle="@string/stepos_wif_setting_dialog_message"
        app:mcTitleTextAppearance="@style/TextAppearance.Small.EmptyViewToast.Title"
        app:mcTopMarginOfTips="12dp"/>
    <RelativeLayout
        android:id="@+id/loadingViewLayout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="297dp"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="16dp">
        <com.stepos.common.widget.LoadingView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            style="@style/Widget.StepOSCommon.LoadingView.Light"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:text="@string/loading_view_text"
            android:layout_centerHorizontal="true"
            style="@style/LoadingViewTextStyle.Light"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/mc_search_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:transitionName="@string/mc_search_view_share_element_name">
        <com.stepos.common.widget.SearchEditText
            android:ellipsize="end"
            android:id="@+id/mc_search_edit"
            android:paddingLeft="@dimen/mc_search_edit_padding_left"
            android:paddingRight="@dimen/mc_search_edit_padding_right"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mc_search_edittext_height"
            android:hint="@string/address_setting_tips"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:imeOptions="flagNoFullscreen|actionSearch"
            android:contentDescription="@string/mc_search_description"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/mc_search_edit_padding_left"
            android:paddingEnd="@dimen/mc_search_edit_padding_right"
            style="?attr/steposSearchEditTextStyle"/>
        <com.stepos.common.widget.ImageFontCompatView
            android:id="@+id/mc_search_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fd_sys_margin_small"
            android:layout_alignParentStart="true"
            style="?attr/steposSearchEditSearchIconStyle"/>
        <ImageView
            android:id="@+id/mc_input_clear"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mc_search_edittext_height"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:contentDescription="@string/mc_search_icon_input_clear"
            android:layout_alignEnd="@+id/mc_search_edit"
            style="?attr/steposSearchEditClearIconStyle"/>
        <com.stepos.common.widget.ImageFontCompatView
            android:id="@+id/mc_voice_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:contentDescription="@string/mc_voice_icon"
            android:layout_marginEnd="@dimen/fd_sys_margin_small"
            android:layout_alignEnd="0x7f0901f3"
            style="?attr/steposSearchEditVoiceIconStyle"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_address_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center_horizontal"
            android:id="@+id/map_view_layout"
            android:layout_width="360dp"
            android:layout_height="280dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp">
            <FrameLayout
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/bt_location"
                android:background="@drawable/current_location"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="208dp"
                android:layout_marginStart="288dp"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:ellipsize="end"
                android:id="@+id/address_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/address_tip_title"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"/>
            <stepos.support.v7.widget.StepOSRecyclerView
                android:id="@+id/main_address_listview"
                android:paddingBottom="64dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="com.stepos.architecture.binding_recyclerview.layout_manager.WrapContentLinearLayoutManager"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/search_address_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">
        <com.stepos.common.widget.EmptyView
            android:id="@+id/search_emptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:mcSrcOfImage="@drawable/aicy_ic_empty_view_no_network"
            app:mcTitle="@string/stepos_wif_setting_dialog_message"
            app:mcTitleTextAppearance="@style/TextAppearance.Small.EmptyViewToast.Title"
            app:mcTopMarginOfTips="12dp"/>
        <stepos.support.v7.widget.StepOSRecyclerView
            android:id="@+id/search_address_listview"
            android:paddingBottom="64dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="com.stepos.architecture.binding_recyclerview.layout_manager.WrapContentLinearLayoutManager"/>
    </FrameLayout>
</LinearLayout>
