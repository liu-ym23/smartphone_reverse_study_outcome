<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/stepos_alert_dialog_normal_margin_start"
    android:paddingEnd="@dimen/stepos_alert_dialog_normal_margin_end">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="#8c8c8c"
            android:id="@+id/stepos_specific_permission_dialog_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="true"/>
    </ScrollView>
    <CheckBox
        android:textSize="15sp"
        android:textColor="#8c8c8c"
        android:id="@+id/stepos_specific_permission_dialog_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="false"
        android:button="@drawable/stepos_btn_check_button_brand_on_layer_mini"
        android:text="@string/stepos_permission_almost_deny"
        android:paddingStart="8dp"/>
</LinearLayout>
