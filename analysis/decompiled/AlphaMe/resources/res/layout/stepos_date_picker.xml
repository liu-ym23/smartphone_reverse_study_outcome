<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.DeviceDefault.Light.StepOSPickerLayout">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/stepos_select_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/stepos_picker_box_selected"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/stepos_column_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/stepos_picker_padding_left"
        android:paddingEnd="@dimen/stepos_picker_padding_right">
        <FrameLayout
            android:id="@+id/stepos_column1Layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/stepos_picker_height"
            android:layout_weight="1">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/stepos_scroll1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_month_scroll_padding_right"/>
            <TextView
                android:textSize="@dimen/stepos_picker_text_size"
                android:textColor="@color/stepos_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/stepos_scroll1_text"
                android:layout_width="@dimen/stepos_picker_text_width"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_month_text_padding_right"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/stepos_divider_bar1"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/stepos_column2Layout"
            android:layout_width="@dimen/stepos_picker_column_width"
            android:layout_height="@dimen/stepos_picker_height"
            android:layout_weight="0">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/stepos_scroll2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_day_scroll_padding_right"/>
            <TextView
                android:textSize="@dimen/stepos_picker_text_size"
                android:textColor="@color/stepos_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/stepos_scroll2_text"
                android:layout_width="@dimen/stepos_picker_text_width"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_day_text_padding_right"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/stepos_divider_bar2"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/stepos_column3Layout"
            android:layout_width="@dimen/stepos_picker_year_column_width"
            android:layout_height="@dimen/stepos_picker_height"
            android:layout_weight="0">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/stepos_scroll3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_year_scroll_padding_right"/>
            <TextView
                android:textSize="@dimen/stepos_picker_text_size"
                android:textColor="@color/stepos_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/stepos_scroll3_text"
                android:layout_width="@dimen/stepos_picker_text_width"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/stepos_picker_year_text_padding_right"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
