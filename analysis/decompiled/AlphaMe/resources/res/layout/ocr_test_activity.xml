<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btn_path"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_cut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="360dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff0000"
                android:gravity="center_horizontal"
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="100dp"
                android:text="Ocr还未解析结果"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_path"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="1.选择图片，ocr path"
        android:layout_above="@+id/btn_uri"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_uri"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="2.选择图片，ocr uri"
        android:layout_above="@+id/btn_byte"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_byte"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="3.选择图片，ocr byte"
        android:layout_above="@+id/btn_detect"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_detect"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="4.选择图片，检测坐标，ocr_det"
        android:layout_above="@+id/btn_point"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_point"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="5.获取按钮3的结果，所有坐标，ocr_rec"
        android:layout_above="@+id/btn_cut"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/btn_cut"
        android:background="#1368fb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="6.选择图片，进行扣图，cut_image"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
