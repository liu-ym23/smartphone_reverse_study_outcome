<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@drawable/immersive_item_bkg_alone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/suggestion_app"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_toStartOf="@+id/bt_select"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/use_address_information"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_below="@+id/title"
            android:fontFamily="sans-serif-regular"
            android:layout_toStartOf="@+id/bt_select"/>
        <RadioButton
            android:id="@+id/bt_select"
            android:clickable="false"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="?android:attr/listChoiceIndicatorSingle"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
