<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <com.stepos.common.preference.SwitchPreferenceCompat
        android:title="@string/personal_title"
        android:key="personal_switch"
        android:summary="@string/personal_summary"
        android:defaultValue="true"/>
    <PreferenceCategory
        android:title="@string/address"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/home_address"
            android:key="home_address"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
        <Preference
            android:title="@string/company_address"
            android:key="company_address"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/network"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/home_wifi"
            android:key="home_wifi"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
        <Preference
            android:title="@string/company_wifi"
            android:key="company_wifi"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/commuting"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/time_away_from_home"
            android:key="time_away_from_home"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
        <Preference
            android:title="@string/off_duty_time"
            android:key="off_duty_time"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
        <Preference
            android:title="@string/commuting_mode"
            android:key="commuting_mode"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/sleep"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/sleep_time"
            android:key="sleep_time"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
        <Preference
            android:title="@string/wake_up_time"
            android:key="wake_up_time"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/car_information"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/car_bluetooth"
            android:key="car_bluetooth"
            android:summary="@string/learning"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/other"
        android:iconSpaceReserved="false">
        <Preference
            android:title="@string/about"
            android:key="about"
            android:widgetLayout="@layout/stepos_right_arrow"/>
    </PreferenceCategory>
</PreferenceScreen>
