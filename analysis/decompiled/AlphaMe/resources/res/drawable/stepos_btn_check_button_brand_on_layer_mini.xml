<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/checked">
        <layer-list>
            <item
                android:gravity="center"
                android:height="16dp"
                android:width="16dp">
                <inset android:inset="1dp">
                    <shape android:shape="oval">
                        <solid android:color="@color/stepos_btn_check_checked_color_state_brand"/>
                    </shape>
                </inset>
            </item>
            <item android:drawable="@drawable/stepos_btn_check_button_inner_drawable_mini"/>
        </layer-list>
    </item>
    <item
        android:id="@+id/not_checked"
        android:drawable="@drawable/stepos_btn_check_button_square_off_mini"/>
    <transition
        android:drawable="@drawable/fa_checkbox_btn_off_to_on_mini"
        android:toId="@+id/checked"
        android:fromId="@+id/not_checked"/>
</animated-selector>
