<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/stepos_popup_item_radius"
                android:topRightRadius="@dimen/stepos_popup_item_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
            <solid android:color="@color/stepos_popup_item_selected"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/stepos_popup_item_radius"
                android:topRightRadius="@dimen/stepos_popup_item_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
            <solid android:color="@color/stepos_popup_item_normal"/>
        </shape>
    </item>
</selector>
