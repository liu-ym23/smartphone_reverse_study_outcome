        "_html_pet_doc": "Gamification demo — agent body is a tiny WebView.",
        "html_pet": {
          "meta": { "name": "HTML 宠物（演示）", "desc": "" },
          "body": {
            "html": "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'><style>html,body{margin:0;padding:0;height:100%;background:transparent;display:flex;align-items:center;justify-content:center;font-family:sans-serif;}.pet{width:88%;height:88%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#FFD86A 0%,#E9692E 60%,#A03C12 100%);border-radius:50%;box-shadow:0 6px 18px rgba(176,79,18,.45);animation:bounce 1.6s ease-in-out infinite;}.face{font-size:2.2rem;text-shadow:0 2px 4px rgba(0,0,0,.25);}@keyframes bounce{0%,100%{transform:translateY(0) scale(1);}50%{transform:translateY(-6%) scale(1.04);}}</style></head><body><div class='pet'><span class='face'>(\u00b4\u30fb\u03c9\u30fb\u0060)</span></div></body></html>",
            "sandbox": true,
            "lines": "agent_lines_html_pet"
          }
        }
