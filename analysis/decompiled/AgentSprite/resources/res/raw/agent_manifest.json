{
  "_doc": [
    "manifest v2: 每个 AgentState = 一场表演 = 可选 background + 必填 body。",
    "place 不再声明 background；同一场景下不同 state 可有或无背景。",
    "lines 仅写在 body 内。",
    "Entry 格式见 SDK AssetManifest 文档。"
  ],
  "agents": {
    "default": {

      "_states_doc": [
        "顶层 states = place=NONE 或 place 未覆盖时的默认表演。",
        "{ \"background\": [...], \"body\": { drawable|pag|frames|... } }"
      ],
      "states": {
        "thinking": {
          "meta": { "name": "任务执行中-工作中", "desc": "任务执行中循环动画" },
          "body": {
            "pag": "thinking.pag",
            "loop": -1
          }
        },
        "awaiting_user": {
          "meta": { "name": "任务待处理-等待用户确认", "desc": "任务待处理循环动画" },
          "body": {
            "pag": "awaiting_user.pag",
            "loop": -1
          }
        },
        "success": {
          "meta": { "name": "任务完成-庆祝", "desc": "任务完成单次动画" },
          "body": {
            "pag": "success.pag",
            "loop": 1
          }
