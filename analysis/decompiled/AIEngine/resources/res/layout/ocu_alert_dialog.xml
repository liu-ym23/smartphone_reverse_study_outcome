<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ocu_bg_card"
    android:paddingTop="38dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="19sp"
        android:textColor="@color/ocu_title_text"
        android:gravity="center"
        android:id="@+id/ocu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textFontWeight="500"/>
    <com.stepos.core.ota.confirmui.MaxHeightScrollView
        android:id="@+id/ocu_message_scroll"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:overScrollMode="never">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/ocu_message_text"
            android:gravity="start"
            android:id="@+id/ocu_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.stepos.core.ota.confirmui.MaxHeightScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ocu_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"/>
</LinearLayout>
