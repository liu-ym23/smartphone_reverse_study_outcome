<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">
    <ImageView
        android:id="@+id/mm_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/mm_ic_model"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/mm_on_surface"
            android:id="@+id/mm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/mm_on_surface_variant"
            android:id="@+id/mm_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/mm_on_surface_variant"
            android:id="@+id/mm_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/mm_blue"
        android:gravity="center"
        android:id="@+id/mm_action"
        android:background="@drawable/mm_bg_btn_blue"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:layout_marginStart="12dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"/>
</LinearLayout>
