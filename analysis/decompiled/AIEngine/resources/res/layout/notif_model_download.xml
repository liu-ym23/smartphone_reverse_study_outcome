<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/notif_root"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <ImageView
        android:id="@+id/notif_model_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_live_dl_model"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="normal"
            android:textColor="@color/notif_dl_title"
            android:ellipsize="end"
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/notif_dl_subtitle"
            android:ellipsize="end"
            android:id="@+id/notif_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/notif_action"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"/>
</LinearLayout>
