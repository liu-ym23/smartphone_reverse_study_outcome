<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.textinputlayout.TextInputLayout
        android:textColorHint="@color/stepos_text_input_hint_color"
        android:id="@+id/text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/text_input_text_content_margin_top"
        android:layout_marginBottom="@dimen/text_input_text_content_margin_bottom"
        android:layout_marginStart="@dimen/text_input_text_content_margin_left"
        android:layout_marginEnd="@dimen/text_input_text_content_margin_left"
        app:errorBackground="@drawable/stepos_edit_text_background_error_frame">
        <com.stepos.textinputlayout.EditTextWithClearIcon
            android:textSize="@dimen/text_input_text_size"
            android:id="@+id/stepos_text_input_edit"
            android:background="@drawable/stepos_edit_text_background_gray_frame"
            android:paddingTop="@dimen/text_input_edit_padding_top"
            android:paddingBottom="@dimen/text_input_edit_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/text_input_edit_min_height"
            android:hint="@string/text_input_hint_text"
            android:paddingHorizontal="12dp"/>
    </com.stepos.textinputlayout.TextInputLayout>
</LinearLayout>
