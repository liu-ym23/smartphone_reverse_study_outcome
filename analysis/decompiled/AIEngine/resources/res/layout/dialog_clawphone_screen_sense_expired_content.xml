<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="19sp"
        android:textColor="@color/fd_sys_color_on_surface_default"
        android:gravity="center"
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clawphone_screen_sense_dialog_title"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clawphone_dialog_title_to_content_margin">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/fd_sys_color_primary_blue"
            android:gravity="center"
            android:id="@+id/tv_expired_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clawphone_screen_sense_dialog_expired_notice"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/fd_sys_color_on_surface_variant_default"
            android:gravity="start"
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clawphone_dialog_expired_notice_bottom_margin"
            android:text="@string/clawphone_screen_sense_dialog_message"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clawphone_dialog_scope_section_top_margin"
        layout="@layout/dialog_clawphone_screen_sense_radio_panel"/>
</LinearLayout>
