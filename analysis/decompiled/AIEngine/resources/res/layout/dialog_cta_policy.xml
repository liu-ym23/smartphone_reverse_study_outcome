<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/cta_dialog_text_primary"
            android:gravity="center"
            android:id="@+id/cta_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name_ai_engine"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cta_dialog_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cta_policy_content_desc"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cta_dialog_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cta_policy_perm_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cta_dialog_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cta_policy_req_network"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cta_dialog_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cta_policy_req_network_desc"
            android:lineSpacingMultiplier="1.15"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cta_dialog_text_secondary"
            android:textColorLink="@color/cta_dialog_link"
            android:id="@+id/cta_dialog_read_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.15"/>
        <CheckBox
            android:textSize="14sp"
            android:textColor="@color/cta_dialog_text_secondary"
            android:id="@+id/cta_dialog_wifi_auto_update"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:checked="true"
            android:button="@drawable/cta_btn_checkbox"
            android:text="@string/cta_policy_wifi_auto_update"
            android:paddingStart="8dp"/>
    </LinearLayout>
</ScrollView>
