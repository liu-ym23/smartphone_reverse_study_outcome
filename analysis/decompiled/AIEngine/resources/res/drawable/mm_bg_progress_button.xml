<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mm_progress_track"/>
            <stroke
                android:width="1dp"
                android:color="@color/mm_progress_chip_border"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:id="@+id/mm_progress_clip">
        <clip
            android:gravity="left"
            android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <solid android:color="@color/mm_progress_fill"/>
                <corners android:radius="100dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
