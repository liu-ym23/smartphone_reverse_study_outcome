<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha
        android:interpolator="@interpolator/stepos_dialog_alert_alpha_interpolator"
        android:duration="128"
        android:fromAlpha="1"
        android:toAlpha="0"/>
    <scale
        android:interpolator="@interpolator/stepos_dialog_alert_scale_exit_interpolator"
        android:duration="128"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="1"
        android:toXScale="0.99"
        android:fromYScale="1"
        android:toYScale="0.99"/>
</set>
