  {
    "id": "stepos-asr",
    "type": "asr",
    "name": "ASR",
    "protocol": "audio",
    "model": {
      "modelId": "step-asr",
      "modelFile": "model_config.json",
      "backend": "QNN_AUDIO",
      "enable": true,
      "description": "step_infer ASREngine（Genie 流式 ASR 包，入口 model_config.json，OTA 目录 voice_asr，支持流式分段与端云协同）",
      "inferenceConfig": {
        "threads": 2,
        "computeDevice": "dsp",
        "performanceProfile": "balanced"
      },
      "supportedSocs": ["SM8845"]
    },
    "cloud": {
      "enable": true,
      "timeout": 30000,
      "download_url_expires_seconds": 7200,
      "scene_type_by_package": {
        "com.android.soundrecorder": { "stream": "recorder_streaming_asr", "file": "recorder_file_asr" },
        "com.stepos.ailauncher": { "stream": "ailauncher_streaming_asr" },
        "com.stepos.aiengine.test": { "stream": "aiengine_test", "file": "aiengine_test" }
      },
      "params": {
        "stream": {
          "format": { "type": "pcm", "codec": "pcm_s16le", "rate": 16000, "bits": 16, "channel": 1 },
          "transcription": { "model": "stepaudio-2.5-asr-stream", "language": "zh", "enable_itn": true, "full_rerun_on_commit": false, "enable_timestamp_align": true },
          "turn_detection": { "type": "server_vad", "silence_duration_ms": 800, "threshold": 0.5 },
          "preempt": { "close_ack_timeout_ms": 2000 }
        },
        "file": {
          "audio": { "format": "wav", "codec": "pcm" },
          "request": {
            "model_name": "stepaudio-2.5-asr",
            "show_utterances": true,
            "enable_speaker_info": true,
            "enable_speaker_embedding": true,
            "enable_channel_split": false,
            "prompt": ""
          }
        }
      },
      "params_by_package": {
        "com.stepos.ailauncher": { "stream": { "turn_detection": { "type": "server_vad", "silence_duration_ms": 1500, "threshold": 0.7 } } }
      }
    },
    "segmentation": {
      "max_chars": 0,
      "punct_window": 80,
      "apply_to": "all",
      "package_override": {
        "com.android.soundrecorder": { "max_chars": 500, "punct_window": 50 }
      }
    }
  },
  {
    "id": "stepos-asr-realtime",
