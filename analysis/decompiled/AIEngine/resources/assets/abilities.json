  {
    "id": "stepos-vad",
    "type": "vad",
    "name": "语音活动检测（端侧判停 + 能量波形）",
    "protocol": "audio",
    "model": {
      "modelId": "ten-vad",
      "modelFile": "ten_vad.onnx",
      "backend": "TEN_VAD_ONNX",
      "enable": true,
      "mock": true,
      "description": "ten-vad 端侧 VAD：起说/判停端点事件 + 能量波形，不出文本。mock=true 不表示假模型——模型真实存在于 APK assets，由 TenVadOnnxModel 自行拷到 cacheDir 加载；置 mock 是为跳过 ability 层的 ModelCache 托管与 models 目录文件校验（VAD 引擎实例按会话独占、不进 ModelCache，因为 hidden state 与单条音频流一一绑定）。注意：本 model 块除 enable/mock 外均为占位，不参与运行——modelId/modelFile 由 TenVadOnnxModel 自行决定（会话实例用 ten-vad-session / ten-vad-stream），threads 固定 1（单帧 256 sample 的推理拆多线程只会增加调度开销）",
      "inferenceConfig": {
        "threads": 1,
        "computeDevice": "cpu",
        "performanceProfile": "balanced"
      }
    },
    "vad": {
      "threshold": 0.5,
      "minSpeechRms": 0.01,
      "speechStartMs": 32,
      "silenceDurationMs": 800,
      "leadingSilenceTimeoutMs": 5000,
      "maxDurationMs": 60000,
      "maxDurationCeilingMs": 600000,
      "levelEnabled": false,
      "levelIntervalMs": 100
    },
    "quota": {
      "maxConcurrent": 2
    }
  },
