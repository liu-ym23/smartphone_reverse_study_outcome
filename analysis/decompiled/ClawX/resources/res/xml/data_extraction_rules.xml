<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="."/>
        <exclude
            domain="file"
            path="user-data/credentials"/>
        <exclude
            domain="file"
            path="user-data/identity"/>
        <exclude
            domain="file"
            path="user-data/memory"/>
        <exclude
            domain="file"
            path="openclaw/identity"/>
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="."/>
        <exclude
            domain="file"
            path="user-data/credentials"/>
        <exclude
            domain="file"
            path="user-data/identity"/>
        <exclude
            domain="file"
            path="user-data/memory"/>
        <exclude
            domain="file"
            path="openclaw/identity"/>
    </device-transfer>
</data-extraction-rules>
