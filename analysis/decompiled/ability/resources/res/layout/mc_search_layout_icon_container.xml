<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/mc_search_layout_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/mc_search_layout_padding_left">
    <include
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/stepos_action_bar_search_layout_height"
        android:layout_weight="1"
        layout="@layout/mc_search_layout"/>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/mc_collectingview_white_heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"/>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/stepos_ic_sb_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
