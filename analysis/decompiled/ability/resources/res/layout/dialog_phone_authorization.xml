<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_dialog_card"
    android:paddingTop="@dimen/auth_dialog_padding_top"
    android:paddingBottom="@dimen/auth_dialog_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/auth_dialog_padding_horizontal">
    <TextView
        android:textSize="@dimen/auth_dialog_title_text_size"
        android:textColor="@color/auth_dialog_title_text"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_dialog_title"
        android:fontFamily="sans-serif-medium"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/auth_dialog_desc_text_size"
                android:textColor="@color/auth_dialog_desc_text"
                android:gravity="start"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_dialog_title_desc_spacing"
                android:text="@string/auth_dialog_desc"
                android:lineSpacingMultiplier="1.32"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_dialog_capability_spacing">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/auth_dialog_capability_title_text_size"
                        android:textColor="@color/auth_dialog_capability_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_dialog_capability_1_title"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/auth_dialog_desc_text_size"
                        android:textColor="@color/auth_dialog_desc_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_dialog_capability_title_desc_spacing"
                        android:text="@string/auth_dialog_capability_1_desc"
                        android:lineSpacingMultiplier="1.32"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_dialog_capability_spacing">
                    <TextView
                        android:textSize="@dimen/auth_dialog_capability_title_text_size"
                        android:textColor="@color/auth_dialog_capability_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_dialog_capability_2_title"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/auth_dialog_desc_text_size"
                        android:textColor="@color/auth_dialog_desc_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_dialog_capability_title_desc_spacing"
                        android:text="@string/auth_dialog_capability_2_desc"
                        android:lineSpacingMultiplier="1.32"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_dialog_capability_spacing">
                    <TextView
                        android:textSize="@dimen/auth_dialog_capability_title_text_size"
                        android:textColor="@color/auth_dialog_capability_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_dialog_capability_3_title"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/auth_dialog_desc_text_size"
                        android:textColor="@color/auth_dialog_desc_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_dialog_capability_title_desc_spacing"
                        android:text="@string/auth_dialog_capability_3_desc"
                        android:lineSpacingMultiplier="1.32"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/auth_dialog_desc_text_size"
                android:textColor="@color/auth_dialog_desc_text"
                android:gravity="start"
                android:id="@+id/tv_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_dialog_capability_spacing"
                android:text="@string/auth_dialog_footer"
                android:lineSpacingMultiplier="1.32"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_dialog_content_button_spacing">
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/auth_dialog_capability_title_text_size"
            android:textColor="@color/auth_dialog_button_text"
            android:id="@+id/btn_deny"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_dialog_button_height"
            android:text="@string/auth_dialog_button_deny"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="@dimen/auth_dialog_button_spacing"
            android:backgroundTint="@color/auth_dialog_button_secondary_bg"
            app:cornerRadius="@dimen/auth_dialog_button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/auth_dialog_capability_title_text_size"
            android:textColor="@color/auth_dialog_button_text"
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_dialog_button_height"
            android:text="@string/auth_dialog_button_confirm"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="@color/auth_dialog_button_primary_bg"
            app:cornerRadius="@dimen/auth_dialog_button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    </LinearLayout>
</LinearLayout>
