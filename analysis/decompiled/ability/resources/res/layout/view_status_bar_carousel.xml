<?xml version="1.0" encoding="utf-8"?>
<com.stepos.taskrobot.llmapi.stepfun.view.PullableHandleHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="@dimen/status_bar_card_width"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/handle"
            android:background="@drawable/bg_status_bar_handle"
            android:layout_width="@dimen/status_bar_handle_width"
            android:layout_height="@dimen/status_bar_handle_height"
            android:layout_marginBottom="@dimen/status_bar_handle_card_gap"/>
        <FrameLayout
            android:id="@+id/card_body"
            android:background="@drawable/bg_status_bar_carousel"
            android:layout_width="@dimen/status_bar_card_width"
            android:layout_height="@dimen/status_bar_card_height"
            android:clipToOutline="true">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_input_card_light"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/status_bar_content_height"
                android:layout_marginStart="@dimen/status_bar_content_padding_horizontal"
                android:layout_marginEnd="@dimen/status_bar_content_padding_horizontal">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/zone_left"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/status_bar_text_size"
                        android:textColor="@color/status_bar_text"
                        android:ellipsize="end"
                        android:id="@+id/text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/btn_stop"
                    android:background="@drawable/bg_voice_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/status_bar_stop_button_size"
                    android:layout_height="@dimen/status_bar_stop_button_size"
                    android:contentDescription="@string/fullscreen_overlay_stop_btn_desc">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_stop_indicator"
                        android:contentDescription="@null"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.stepos.taskrobot.llmapi.stepfun.view.PullableHandleHost>
