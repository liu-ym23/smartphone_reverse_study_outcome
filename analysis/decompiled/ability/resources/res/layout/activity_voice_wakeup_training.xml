<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voicewakeupRoot"
    android:background="@color/voicewakeup_bg"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.glass.StepOSGlassImageButton
        android:id="@+id/btnBack"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_voicewakeup_back"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:steposGlassEffect="clear"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/voicewakeup_white_45"
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/voicewakeup_white_90"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/phoneticPill"
        android:background="@drawable/bg_voicewakeup_phonetic_pill"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <ImageView
            android:id="@+id/btnPlayPhonetic"
            android:background="@drawable/bg_voicewakeup_phonetic_play_btn"
            android:padding="4dp"
            android:focusable="false"
            android:clickable="false"
            android:duplicateParentState="true"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_voicewakeup_play_sm"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/voicewakeup_white_90"
            android:id="@+id/tvPhonetic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <View
        android:id="@+id/orbSlot"
        android:layout_width="137dp"
        android:layout_height="174dp"
        android:layout_marginTop="267dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.libpag.PAGView
        android:id="@+id/orb"
        android:layout_width="191dp"
        android:layout_height="222dp"
        android:translationX="-2.2dp"
        android:translationY="-54.5dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/orbSlot"
        app:layout_constraintStart_toStartOf="@+id/orbSlot"
        app:layout_constraintTop_toTopOf="@+id/orbSlot"/>
    <FrameLayout
        android:id="@+id/flBottomGlowSlot"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="@drawable/bg_voicewakeup_bottom_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/ivBottomGlow"
            android:layout_width="388dp"
            android:layout_height="89dp"
            android:layout_marginBottom="-4dp"
            android:src="@drawable/ic_voicewakeup_bottom_glow"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/voicewakeup_white_70"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tvListening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="78dp"
            android:text="@string/voice_wake_train_listening"/>
    </FrameLayout>
    <com.stepos.ability.voicewakeup.ui.TrainingPhraseCarousel
        android:id="@+id/phraseCarousel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orbSlot"/>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/voicewakeup_white_90"
        android:id="@+id/tvDoneTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/voice_wake_train_done_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stepos.widget.button.StepOSButton
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/btnDone"
        android:background="@drawable/bg_voicewakeup_glass_pill_btn"
        android:visibility="gone"
        android:layout_width="298dp"
        android:layout_height="52dp"
        android:layout_marginBottom="0dp"
        android:text="@string/voice_wake_train_done_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StepOSWidget.Button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
