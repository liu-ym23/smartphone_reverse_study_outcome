<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_card"
    android:paddingTop="@dimen/bottom_sheet_padding_top"
    android:paddingBottom="@dimen/bottom_sheet_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/bottom_sheet_padding_horizontal">
    <TextView
        android:textSize="@dimen/bottom_sheet_title_text_size"
        android:textColor="@color/bottom_sheet_title_text"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_title_option_spacing"
        android:text="@string/auth_dialog_title"/>
    <TextView
        android:textSize="@dimen/bottom_sheet_option_text_size"
        android:textColor="@color/bottom_sheet_option_text"
        android:gravity="start"
        android:id="@+id/btn_confirm"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_dialog_button_confirm"
        android:paddingVertical="@dimen/bottom_sheet_option_row_padding_vertical"/>
    <View
        android:background="@color/bottom_sheet_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_sheet_divider_height"/>
    <TextView
        android:textSize="@dimen/bottom_sheet_option_text_size"
        android:textColor="@color/bottom_sheet_option_text"
        android:gravity="start"
        android:id="@+id/btn_deny"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_dialog_button_deny"
        android:paddingVertical="@dimen/bottom_sheet_option_row_padding_vertical"/>
</LinearLayout>
