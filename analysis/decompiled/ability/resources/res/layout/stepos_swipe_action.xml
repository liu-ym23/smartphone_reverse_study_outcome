<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/stepos_swipe_action_panel"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/stepos_swipe_action_touch_min"
        android:paddingStart="@dimen/stepos_swipe_action_half_gap"
        android:paddingEnd="@dimen/stepos_swipe_action_half_gap">
        <FrameLayout
            android:id="@+id/stepos_swipe_action_primary_target"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/stepos_swipe_action_primary">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/stepos_swipe_action_primary_icon"
                android:duplicateParentState="true"
                android:layout_width="@dimen/stepos_swipe_action_icon_size"
                android:layout_height="@dimen/stepos_swipe_action_icon_size"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/stepos_swipe_action_half_gap"
                android:layout_marginEnd="@dimen/stepos_swipe_action_half_gap"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/stepos_swipe_action_secondary_target"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/stepos_swipe_action_secondary">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/stepos_swipe_action_secondary_icon"
                android:duplicateParentState="true"
                android:layout_width="@dimen/stepos_swipe_action_icon_size"
                android:layout_height="@dimen/stepos_swipe_action_icon_size"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/stepos_swipe_action_half_gap"
                android:layout_marginEnd="@dimen/stepos_swipe_action_half_gap"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/stepos_swipe_action_delete_target"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/stepos_swipe_action_delete">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/stepos_swipe_action_delete_icon"
                android:duplicateParentState="true"
                android:layout_width="@dimen/stepos_swipe_action_icon_size"
                android:layout_height="@dimen/stepos_swipe_action_icon_size"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/stepos_swipe_action_half_gap"
                android:layout_marginEnd="@dimen/stepos_swipe_action_half_gap"/>
        </FrameLayout>
    </LinearLayout>
</merge>
