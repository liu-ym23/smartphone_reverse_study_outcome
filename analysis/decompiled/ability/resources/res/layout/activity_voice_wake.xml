<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/voiceWakeSettingsRoot"
    android:background="@color/voice_wake_settings_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_collapsed_height"
        app:steposTitle="@string/voice_wake_title"
        app:steposTitleGravity="center"
        style="@style/Widget.VoiceWakeup.Settings.TitleBar"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/ivWakeIllustration"
                android:layout_width="@dimen/voice_wake_illustration_width"
                android:layout_height="@dimen/voice_wake_illustration_height"
                android:layout_marginTop="@dimen/voice_wake_illustration_top_spacing"
                android:src="@drawable/bg_voice_wake_phone"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <com.stepos.widget.list.StepOSListGroup
                android:id="@+id/settingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/voice_wake_settings_group_top_spacing"
                android:layout_marginHorizontal="16dp">
                <com.stepos.widget.list.StepOSListItem
                    android:id="@+id/itemWakeEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:steposListItemTitle="@string/voice_wake_item_enable"
                    app:steposListItemTrailingType="toggle"/>
                <com.stepos.widget.list.StepOSListItem
                    android:id="@+id/itemRerecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:steposListItemRightIcon="@drawable/ic_voice_wake_arrow_right"
                    app:steposListItemTitle="@string/voice_wake_item_record"
                    app:steposListItemTrailingType="arrow"/>
                <com.stepos.widget.list.StepOSListItem
                    android:id="@+id/itemClearVoiceprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:steposListItemTitle="@string/voice_wake_item_clear"
                    app:steposListItemTrailingType="none"/>
            </com.stepos.widget.list.StepOSListGroup>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llCurrentWord"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_wake_current_word_label"
                    android:layout_marginStart="8dp"/>
                <com.stepos.widget.list.StepOSListGroup
                    android:id="@+id/llCurrentWordList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
