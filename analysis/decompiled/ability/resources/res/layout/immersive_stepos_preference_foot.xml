<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/immersive_item_bkg_foot"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <com.stepos.common.widget.SmoothCornerView
        android:id="@android:id/icon_frame"
        android:layout_marginEnd="@dimen/stepos_preference_icon_margin_horizontal"
        app:steposCornerRadius="@dimen/stepos_list_icon_item_icon_corner_radius"
        style="@style/Widget.StepOS.Preference.Icon">
        <ImageView
            android:id="@android:id/icon"
            android:scaleType="centerInside"
            style="@style/Widget.StepOS.Preference.Icon"/>
    </com.stepos.common.widget.SmoothCornerView>
    <LinearLayout
        android:id="@+id/preference_text_layout"
        style="@style/Widget.StepOS.Preference.TextContentLayout">
        <TextView
            android:id="@android:id/title"
            style="@style/Widget.StepOS.Preference.Title"/>
        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="4dp"
            style="@style/TextAppearance.StepOS.Body.Mini"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_marginEnd="@dimen/fd_sys_margin_medium"
        style="@style/Widget.StepOS.List.Vertical.Divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/preference_item_padding_inner"/>
</LinearLayout>
