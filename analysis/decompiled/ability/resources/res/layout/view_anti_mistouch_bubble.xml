<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anti_mistouch_bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/anti_mistouch_bubble_tint"
        android:background="@drawable/bg_anti_mistouch_bubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/anti_mistouch_bubble_text"
        app:layout_constraintEnd_toEndOf="@+id/anti_mistouch_bubble_text"
        app:layout_constraintStart_toStartOf="@+id/anti_mistouch_bubble_text"
        app:layout_constraintTop_toTopOf="@+id/anti_mistouch_bubble_text"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/anti_mistouch_bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
