<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/passive_card_body"
    android:layout_width="@dimen/passive_takeover_card_width"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/passive_card_blur_tint"
        android:background="@drawable/bg_passive_takeover_prompt_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/passive_card_content"
        app:layout_constraintEnd_toEndOf="@+id/passive_card_content"
        app:layout_constraintStart_toStartOf="@+id/passive_card_content"
        app:layout_constraintTop_toTopOf="@+id/passive_card_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/passive_card_content"
        android:paddingTop="@dimen/passive_takeover_v2_content_padding_top"
        android:paddingBottom="@dimen/passive_takeover_v2_content_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/passive_takeover_v2_explain_size"
            android:textColor="@color/passive_takeover_explain_v2"
            android:ellipsize="end"
            android:id="@+id/text_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/passive_takeover_v2_text_to_list_gap"
            android:maxLines="4"
            android:layout_marginHorizontal="@dimen/passive_takeover_v2_text_margin_horizontal"/>
        <FrameLayout
            android:id="@+id/row_takeover"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/passive_takeover_v2_row_height"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/passive_takeover_v2_row_padding_start"
            android:paddingEnd="@dimen/passive_takeover_v2_row_padding_end">
            <TextView
                android:textSize="@dimen/passive_takeover_v2_row_text_size"
                android:textColor="@color/passive_takeover_v2_row_text"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fullscreen_passive_takeover_action_takeover"/>
        </FrameLayout>
        <View
            android:background="@color/passive_takeover_v2_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/passive_takeover_v2_divider_height"
            android:layout_marginHorizontal="@dimen/passive_takeover_v2_text_margin_horizontal"/>
        <FrameLayout
            android:id="@+id/row_stop"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/passive_takeover_v2_row_height"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/passive_takeover_v2_row_padding_start"
            android:paddingEnd="@dimen/passive_takeover_v2_row_padding_end">
            <TextView
                android:textSize="@dimen/passive_takeover_v2_row_text_size"
                android:textColor="@color/passive_takeover_v2_row_text"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fullscreen_passive_takeover_action_stop"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/handle"
        android:paddingTop="@dimen/passive_takeover_v2_handle_hit_padding_top"
        android:paddingBottom="@dimen/passive_takeover_v2_handle_hit_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/passive_takeover_v2_handle_hit_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/bg_passive_takeover_handle"
            android:layout_width="@dimen/passive_takeover_handle_width"
            android:layout_height="@dimen/passive_takeover_handle_height"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
