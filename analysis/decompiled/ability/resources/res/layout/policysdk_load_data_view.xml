<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:common="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/mc_loading_view_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.common.widget.EmptyView
            android:layout_gravity="center"
            android:id="@+id/empty_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            common:layout_constraintBottom_toBottomOf="parent"
            common:layout_constraintTop_toTopOf="parent"
            common:mcTitle="@string/stepos_wif_setting_dialog_message"
            common:mcTitleTextAppearance="@style/TextAppearance.Small.EmptyViewToast.Title"/>
        <Button
            android:layout_gravity="center"
            android:id="@+id/btn_setting_net_work"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/policy_sdk_btn_setting_network"
            common:layout_constraintEnd_toEndOf="parent"
            common:layout_constraintStart_toStartOf="parent"
            common:layout_constraintTop_toBottomOf="@+id/empty_view"
            style="@style/Widget.DeviceDefault.Light.Button.LightColor.Color.Blue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
