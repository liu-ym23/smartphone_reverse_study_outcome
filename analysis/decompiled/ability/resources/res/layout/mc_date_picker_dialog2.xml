<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stepos.common.widget.SimpleAdaptiveTextView
            android:textAppearance="@style/TextAppearance.StepOS.HeadLine.Small"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center_horizontal"
            android:id="@+id/time_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="24dp"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <com.stepos.common.picker.DatePicker2
        android:layout_gravity="center_horizontal"
        android:id="@+id/date_picker2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"/>
</LinearLayout>
