<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/stepos_recipient_list_item_height"
    android:paddingStart="@dimen/stepos_recipient_padding_horizontal"
    android:paddingEnd="@dimen/stepos_recipient_padding_horizontal">
    <ImageView
        android:id="@android:id/icon"
        android:visibility="gone"
        android:layout_width="@dimen/stepos_recipient_add_size"
        android:layout_height="@dimen/stepos_recipient_add_size"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/stepos_recipient_chip_spacing"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:ellipsize="end"
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/StepOSTextAppearance.Recipient.DropdownTitle"/>
        <TextView
            android:ellipsize="end"
            android:id="@android:id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/StepOSTextAppearance.Recipient.DropdownSubtitle"/>
    </LinearLayout>
</LinearLayout>
