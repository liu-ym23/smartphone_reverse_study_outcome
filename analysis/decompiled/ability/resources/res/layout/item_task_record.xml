<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/droidrun_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_task_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务名称"
                android:singleLine="true"
                android:maxLength="10"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/droidrun_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tv_task_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ID: task_001"
                android:singleLine="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/droidrun_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tv_trace_id"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="TraceId: -"
                android:singleLine="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/droidrun_text_secondary"
                android:id="@+id/tv_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开始: 2024-01-26 10:00"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#9c27b0"
                android:ellipsize="end"
                android:id="@+id/tv_model_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="模型: -"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/tv_task_state"
                android:background="@drawable/bg_status_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行中"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:src="@android:drawable/ic_media_play"
                android:rotation="0"
                app:tint="@color/droidrun_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
