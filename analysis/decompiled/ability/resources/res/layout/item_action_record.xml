<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/droidrun_surface"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_action_index"
            android:background="@drawable/bg_action_index"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_action_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="click"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_action_source"
                    android:background="@drawable/bg_source_tag"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="经验库"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/droidrun_text_secondary"
                android:id="@+id/tv_action_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="结果: success"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/droidrun_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tv_action_message"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="消息: "
                android:maxLines="3"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/droidrun_text_secondary"
                    android:id="@+id/tv_action_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始: 10:00:00"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/droidrun_text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:layout_marginHorizontal="8dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/droidrun_text_secondary"
                    android:id="@+id/tv_action_end_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束: 10:00:01"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_screenshot"
            android:background="@drawable/bg_screenshot_placeholder"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
