<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rounded_corner_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:id="@+id/tvAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#424242"
        android:id="@+id/tvPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <ImageView
        android:id="@+id/ivScreenshot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#ff9800"
            android:id="@+id/tvScreenshotDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ff9800"
            android:id="@+id/tvInferenceDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#ff9800"
            android:id="@+id/tvTotalDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#9e9e9e"
            android:id="@+id/tvStartTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="截图时间:"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#9e9e9e"
            android:id="@+id/tvStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#9e9e9e"
        android:id="@+id/tvEndTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4caf50"
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llSecondaryInfo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvActionContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvDurationDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvCurrActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bdbdbd"
            android:id="@+id/tvOrientation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#2196f3"
        android:layout_gravity="end"
        android:id="@+id/tvToggleDetails"
        android:padding="4dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示详情"/>
</LinearLayout>
