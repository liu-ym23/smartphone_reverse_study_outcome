<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/full_screen_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mirror_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/glow_overlay"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.stepos.taskrobot.llmapi.stepfun.view.StatusBarCarouselView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/status_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fullscreen_overlay_margin_bottom"/>
    <com.stepos.taskrobot.llmapi.stepfun.view.blur.BlurCardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ack_card"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/takeover_ack_margin_bottom"/>
    <com.stepos.taskrobot.llmapi.stepfun.view.blur.BlurCardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/mini_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_bar_margin_bottom"/>
    <View
        android:id="@+id/exit_mask"
        android:background="@android:color/black"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
