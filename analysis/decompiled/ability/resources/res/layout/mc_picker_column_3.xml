<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.StepOSCommon.McPickerLayout">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mc_select_box"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/stepos_picker_box_selected"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/mc_column_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/mc_picker_padding_left"
        android:paddingEnd="@dimen/mc_picker_padding_right">
        <FrameLayout
            android:id="@+id/mc_column1Layout"
            android:layout_width="85dp"
            android:layout_height="@dimen/mc_picker_height"
            android:layout_weight="0">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/mc_scroll1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/mc_picker_text_size"
                android:textStyle="bold"
                android:textColor="@color/mc_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/mc_scroll1_text"
                android:layout_width="37dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/mc_divider_bar1"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mc_column2Layout"
            android:layout_width="82.5dp"
            android:layout_height="@dimen/mc_picker_height">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/mc_scroll2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/mc_picker_text_size"
                android:textStyle="bold"
                android:textColor="@color/mc_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/mc_scroll2_text"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/mc_divider_bar2"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mc_column3Layout"
            android:layout_width="87dp"
            android:layout_height="@dimen/mc_picker_height"
            android:layout_weight="0">
            <com.stepos.common.widget.ScrollTextView
                android:id="@+id/mc_scroll3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/mc_picker_text_size"
                android:textStyle="bold"
                android:textColor="@color/mc_picker_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/mc_scroll3_text"
                android:layout_width="@dimen/mc_picker_text_width"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
