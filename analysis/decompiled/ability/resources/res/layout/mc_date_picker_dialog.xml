<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:common="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stepos.common.widget.SimpleAdaptiveTextView
            android:textSize="19sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_gravity="center_horizontal"
            android:id="@+id/time_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="22dp"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <com.stepos.common.widget.DatePicker
        android:layout_gravity="center_horizontal"
        android:id="@+id/datePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:spinnersShown="true"
        android:calendarViewShown="false"
        common:mcInternalLayout="@layout/mc_custom_date_picker"
        common:mcVisibleRow="5"/>
</LinearLayout>
