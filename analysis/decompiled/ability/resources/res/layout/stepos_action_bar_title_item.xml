<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/RtlOverlay.Widget.StepOS.AppCompat.ActionBar.TitleItem">
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal">
        <TextView
            android:id="@+id/action_bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </HorizontalScrollView>
    <TextView
        android:ellipsize="middle"
        android:id="@+id/action_bar_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/abc_action_bar_subtitle_top_margin_material"
        android:maxWidth="@dimen/stepos_toolbar_title_max_width"
        android:singleLine="true"/>
</LinearLayout>
