<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end"
    android:layout_gravity="end"
    android:id="@+id/mc_stretch_search_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/mc_stretch_search_padding_left"
    android:paddingEnd="@dimen/mc_stretch_search_tv_padding_right">
    <include
        android:gravity="center"
        android:layout_gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/mc_stretch_search_padding_right"
        android:layout_alignParentEnd="true"
        layout="@layout/mc_search_layout"/>
    <TextView
        android:textSize="@dimen/stepos_text_size_normal"
        android:textColor="@color/stepos_stretch_search_textview_textcolor"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/mc_search_textview"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="@dimen/mc_stretch_search_textview_width"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
