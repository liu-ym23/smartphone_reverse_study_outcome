<?xml version="1.0" encoding="utf-8"?>
<com.stepos.taskrobot.llmapi.stepfun.view.PullableHandleHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="@dimen/passive_takeover_card_width"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/handle"
            android:background="@drawable/bg_passive_takeover_handle"
            android:layout_width="@dimen/passive_takeover_handle_width"
            android:layout_height="@dimen/passive_takeover_handle_height"
            android:layout_marginBottom="@dimen/passive_takeover_handle_card_gap"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/passive_card_body"
            android:padding="@dimen/passive_takeover_card_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/passive_takeover_header_height">
                <TextView
                    android:textSize="@dimen/passive_takeover_title_size"
                    android:textColor="@color/passive_takeover_title"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fullscreen_passive_takeover_title"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_stop"
                    android:background="@drawable/bg_passive_takeover_icon"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/passive_takeover_icon_size"
                    android:layout_height="@dimen/passive_takeover_icon_size"
                    android:src="@drawable/ic_passive_takeover_stop"
                    android:scaleType="center"
                    android:contentDescription="@string/fullscreen_overlay_stop_btn_desc"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/passive_takeover_explain_size"
                android:textColor="@color/passive_takeover_explain"
                android:ellipsize="end"
                android:id="@+id/text_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/passive_takeover_card_gap"
                android:maxLines="3"/>
        </LinearLayout>
    </LinearLayout>
</com.stepos.taskrobot.llmapi.stepfun.view.PullableHandleHost>
