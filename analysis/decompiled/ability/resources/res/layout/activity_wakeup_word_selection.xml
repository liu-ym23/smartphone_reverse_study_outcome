<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/voicewakeup_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.glass.StepOSGlassImageButton
        android:id="@+id/btnBack"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_voicewakeup_back"
        android:contentDescription="@string/voice_wake_word_select_cancel"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:steposGlassEffect="clear"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/voicewakeup_white_90"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/voice_wake_word_select_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"/>
    <View
        android:id="@+id/orbSlot"
        android:layout_width="137dp"
        android:layout_height="174dp"
        android:layout_marginBottom="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/llWordList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <org.libpag.PAGView
        android:id="@+id/orb"
        android:layout_width="191dp"
        android:layout_height="222dp"
        android:translationX="-2.2dp"
        android:translationY="-54.5dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/orbSlot"
        app:layout_constraintStart_toStartOf="@+id/orbSlot"
        app:layout_constraintTop_toTopOf="@+id/orbSlot"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llWordList"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
