<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/stepos_menu_item_min_height">
    <com.stepos.widget.menu.StepOSMenuPressOverlayView
        android:id="@+id/stepos_menu_item_press_overlay"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/stepos_menu_item_content"
        android:paddingTop="@dimen/stepos_menu_item_padding_vertical"
        android:paddingBottom="@dimen/stepos_menu_item_padding_vertical"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/stepos_menu_item_min_height"
        android:paddingStart="@dimen/stepos_menu_item_padding_horizontal"
        android:paddingEnd="@dimen/stepos_menu_item_padding_horizontal">
        <ImageView
            android:id="@+id/stepos_menu_item_checkbox"
            android:visibility="gone"
            android:layout_width="@dimen/stepos_menu_item_checkbox_size"
            android:layout_height="@dimen/stepos_menu_item_checkbox_size"
            android:src="@drawable/stepos_bg_menu_item_checkbox"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/stepos_menu_item_checkbox_gap"/>
        <ImageView
            android:id="@+id/stepos_menu_item_icon"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="@dimen/stepos_menu_item_icon_size"
            android:layout_height="@dimen/stepos_menu_item_icon_size"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/stepos_menu_item_icon_gap"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/stepos_menu_item_text"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="@style/StepOSTextAppearance.Menu.Item"
                android:ellipsize="end"
                android:id="@+id/stepos_menu_item_title"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/StepOSTextAppearance.Menu.Item.Subtitle"
                android:ellipsize="end"
                android:id="@+id/stepos_menu_item_subtitle"
                android:visibility="gone"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stepos_menu_item_subtitle_gap"
                android:maxLines="1"/>
        </LinearLayout>
        <View
            android:id="@+id/stepos_menu_item_badge"
            android:background="@drawable/stepos_bg_menu_item_badge"
            android:visibility="gone"
            android:layout_width="@dimen/stepos_menu_item_badge_size"
            android:layout_height="@dimen/stepos_menu_item_badge_size"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/stepos_menu_item_mark_gap"/>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Menu.Item.Tag"
            android:ellipsize="end"
            android:id="@+id/stepos_menu_item_tag"
            android:background="@drawable/stepos_bg_menu_item_tag"
            android:paddingTop="@dimen/stepos_menu_item_tag_padding_vertical"
            android:paddingBottom="@dimen/stepos_menu_item_tag_padding_vertical"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/stepos_menu_item_tag_padding_horizontal"
            android:paddingEnd="@dimen/stepos_menu_item_tag_padding_horizontal"
            android:layout_marginStart="@dimen/stepos_menu_item_mark_gap"/>
        <ImageView
            android:id="@+id/stepos_menu_item_trailing_icon"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="@dimen/stepos_menu_item_trailing_icon_size"
            android:layout_height="@dimen/stepos_menu_item_trailing_icon_size"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/stepos_menu_item_mark_gap"/>
        <ImageView
            android:id="@+id/stepos_menu_item_unfold"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="@dimen/stepos_menu_item_icon_size"
            android:layout_height="@dimen/stepos_menu_item_icon_size"
            android:src="@drawable/stepos_icon_menu_unfold"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/stepos_menu_item_mark_gap"/>
        <ImageView
            android:id="@+id/stepos_menu_item_mark"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="@dimen/stepos_menu_item_mark_size"
            android:layout_height="@dimen/stepos_menu_item_mark_size"
            android:src="@drawable/stepos_icon_menu_selected_mark"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/stepos_menu_item_mark_gap"/>
    </LinearLayout>
</FrameLayout>
