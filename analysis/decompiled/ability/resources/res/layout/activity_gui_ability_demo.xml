<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_coordinator"
    android:background="@color/droidrun_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="GUI 能力 Demo"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/white"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/root_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/running_container"
            android:paddingTop="6dp"
            android:paddingBottom="72dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/top_status_chip"
                android:background="@drawable/rounded_pill_background"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/demo_chip_running">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/chip_task_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="240dp"
                    android:maxLines="2"/>
                <View
                    android:background="#55ffffff"
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ccffffff"
                    android:id="@+id/chip_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0s"/>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="center_horizontal"
                android:id="@+id/surface_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="#333333"
                app:strokeWidth="4dp">
                <FrameLayout
                    android:background="#000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.stepos.taskrobot.llmapi.stepfun.mirror.UnifiedMirrorView
                        android:id="@+id/surface_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <View
                        android:layout_gravity="top"
                        android:background="#1a000000"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>
                    <View
                        android:id="@+id/takeover_stroke_overlay"
                        android:background="@drawable/bg_takeover_stroke"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/action_timeline"
                android:background="@color/demo_timeline_bg"
                android:padding="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/scene_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="选一个场景，一键演示"/>
            <com.google.android.material.button.MaterialButton
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/btn_custom_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="✏️ 新建自定义任务"
                app:backgroundTint="@color/droidrun_primary"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="@android:color/white"/>
            <include
                android:id="@+id/scene_card_xhs"
                layout="@layout/item_demo_scene_card"/>
            <include
                android:id="@+id/scene_card_meituan"
                layout="@layout/item_demo_scene_card"/>
            <include
                android:id="@+id/scene_card_jd"
                layout="@layout/item_demo_scene_card"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_control_bar"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/active_ops_scroll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_takeover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="接管"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/droidrun_primary"
                    android:paddingVertical="8dp"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.TonalButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_recover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="继续运行"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/droidrun_primary"
                    android:paddingVertical="8dp"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.TonalButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="退出虚拟屏"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingVertical="8dp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@android:color/white"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/terminal_ops"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="再来一次"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/droidrun_primary"
                    android:paddingVertical="8dp"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.TonalButton"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_back_to_scenes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="换场景"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingVertical="8dp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@android:color/white"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
