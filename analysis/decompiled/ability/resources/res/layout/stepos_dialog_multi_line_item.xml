<?xml version="1.0" encoding="utf-8"?>
<com.stepos.widget.dialog.StepOSCheckableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/stepos_bg_dialog_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/stepos_dialog_list_item_padding_horizontal"
    android:paddingEnd="0dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="@dimen/stepos_dialog_multi_line_padding_vertical"
        android:paddingBottom="@dimen/stepos_dialog_multi_line_padding_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Dialog.ListItem"
            android:id="@+id/stepos_dialog_multi_line_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Dialog.ListItem.Detail"
            android:id="@+id/stepos_dialog_multi_line_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/stepos_dialog_multi_line_check_box"
        android:background="@null"
        android:clickable="false"
        android:layout_width="@dimen/stepos_dialog_check_size"
        android:layout_height="@dimen/stepos_dialog_check_size"
        android:button="@drawable/stepos_icon_dialog_check_multi"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/stepos_dialog_list_item_padding_horizontal"
        android:layout_marginEnd="@dimen/stepos_dialog_list_item_padding_horizontal"
        android:buttonTint="@null"/>
</com.stepos.widget.dialog.StepOSCheckableLayout>
