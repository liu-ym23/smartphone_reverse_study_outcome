<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/status_bar_corner_radius"/>
            <solid android:color="@color/status_bar_card_fill_dark"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/status_bar_corner_radius"/>
            <solid android:color="@color/status_bar_card_fill_overlay"/>
            <stroke
                android:width="@dimen/status_bar_stroke_width"
                android:color="@color/status_bar_card_stroke"/>
        </shape>
    </item>
</layer-list>
