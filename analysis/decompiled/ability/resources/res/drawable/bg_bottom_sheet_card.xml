<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_sheet_card_background"/>
            <corners android:radius="@dimen/bottom_sheet_card_corner_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_sheet_card_wash"/>
            <corners android:radius="@dimen/bottom_sheet_card_corner_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/bottom_sheet_card_corner_radius"/>
            <stroke
                android:width="1dp"
                android:color="@color/bottom_sheet_card_border"/>
        </shape>
    </item>
</layer-list>
