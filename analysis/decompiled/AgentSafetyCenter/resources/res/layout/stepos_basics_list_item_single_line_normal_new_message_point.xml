<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_item"
    style="@style/Widget.StepOS.List.Layout">
    <LinearLayout style="@style/Widget.StepOS.SingleList.ContainerRelativeLayout">
        <TextView
            android:id="@+id/title"
            style="@style/Widget.StepOS.SingleList.Title"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_vertical"
        android:layout_width="20dp"
        android:layout_height="20dp"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="24dp"
        android:layout_height="24dp">
        <com.stepos.common.widget.NewMessageView
            android:id="@+id/title_new_message_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
