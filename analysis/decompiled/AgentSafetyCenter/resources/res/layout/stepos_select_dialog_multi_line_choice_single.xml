<?xml version="1.0" encoding="utf-8"?>
<stepos.support.v7.widget.StepOSMultiLinesCheckLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/stepos_alert_dialog_listview_item_bg_radius"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:choiceMode="singleChoice"
    android:paddingStart="20dp"
    android:paddingEnd="0dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textStyle="normal"
            android:id="@+id/alert_title_multi_line_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            style="@style/TextAppearance.StepOS.Label.Large"/>
        <TextView
            android:id="@+id/alert_detail_multi_line_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:fontFamily="sans-serif"
            style="@style/Widget.StepOS.MultipleList.Desc.NormalDisplay.AdjoinTitle"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/alert_title_multi_line_check_box_single"
        android:background="@drawable/stepos_vec_btn_checked_true_normal_color_blue"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="25dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>
</stepos.support.v7.widget.StepOSMultiLinesCheckLayout>
