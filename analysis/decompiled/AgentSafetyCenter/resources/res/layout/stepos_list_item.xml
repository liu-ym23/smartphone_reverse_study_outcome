<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/stepos_list_item_badge"
        android:visibility="gone"
        android:layout_width="@dimen/stepos_list_item_badge_size"
        android:layout_height="@dimen/stepos_list_item_badge_size"
        android:layout_marginEnd="@dimen/stepos_list_item_icon_text_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_leading_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <ImageView
        android:id="@+id/stepos_list_item_leading_icon"
        android:visibility="gone"
        android:layout_width="@dimen/stepos_list_item_icon_size"
        android:layout_height="@dimen/stepos_list_item_icon_size"
        android:scaleType="centerCrop"
        android:contentDescription="@string/stepos_list_item_icon_desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stepos_list_item_badge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <FrameLayout
        android:id="@+id/stepos_list_item_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/stepos_list_item_accessory"
            android:layout_width="@dimen/stepos_list_item_accessory_size"
            android:layout_height="@dimen/stepos_list_item_accessory_size"
            android:src="@drawable/stepos_icon_arrow_right"
            android:scaleType="fitCenter"
            android:contentDescription="@string/stepos_list_item_accessory_desc"/>
    </FrameLayout>
    <View
        android:id="@+id/stepos_list_item_right_badge"
        android:visibility="gone"
        android:layout_width="@dimen/stepos_list_item_badge_size"
        android:layout_height="@dimen/stepos_list_item_badge_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_trailing"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <TextView
        android:textAppearance="@style/StepOSTextAppearance.ListItem.Value"
        android:ellipsize="end"
        android:id="@+id/stepos_list_item_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_right_badge"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/stepos_list_item_trailing_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="stepos_list_item_value,stepos_list_item_right_badge,stepos_list_item_trailing"/>
    <TextView
        android:textAppearance="@style/StepOSTextAppearance.ListItem.Title"
        android:ellipsize="end"
        android:id="@+id/stepos_list_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/stepos_list_item_icon_text_gap"
        app:layout_constraintBottom_toTopOf="@+id/stepos_list_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_title_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/stepos_list_item_leading_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textAppearance="@style/StepOSTextAppearance.ListItem.Subtitle"
        android:ellipsize="end"
        android:id="@+id/stepos_list_item_title_end"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/stepos_list_item_content_gap"
        app:layout_constraintBaseline_toBaselineOf="@+id/stepos_list_item_title"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_trailing_barrier"
        app:layout_constraintStart_toEndOf="@+id/stepos_list_item_title"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textAppearance="@style/StepOSTextAppearance.ListItem.Subtitle"
        android:ellipsize="end"
        android:id="@+id/stepos_list_item_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stepos_list_item_title_subtitle_gap"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/stepos_list_item_value_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stepos_list_item_trailing_barrier"
        app:layout_constraintStart_toStartOf="@+id/stepos_list_item_title"
        app:layout_constraintTop_toBottomOf="@+id/stepos_list_item_title"/>
</merge>
