<?xml version="1.0" encoding="utf-8"?>
<stepos.support.v7.widget.ActionBarCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/decor_content_parent"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:statusBarBackground="@null">
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/stepos_appbar_scrolling_view_behavior">
        <include layout="@layout/stepos_screen_fits_bottom_content_include"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/top_shadow_mask_view_stub"
        android:layout="@layout/transparent_title_top_mask"
        android:layout_width="match_parent"
        android:layout_height="165dp"/>
    <stepos.support.v7.widget.StepOSAppBarLayout
        android:id="@+id/app_bar_layout"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?attr/actionBarStyle">
        <stepos.support.v7.widget.StepOSCollapsingToolbarLayout
            android:id="@+id/action_bar_container"
            android:layout_width="match_parent"
            android:layout_height="?attr/steposActionBarExpandedSize"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:statusBarScrim="@android:color/transparent"
            app:toolbarId="@+id/action_bar">
            <stepos.support.v7.widget.Toolbar
                android:id="@+id/action_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                style="?attr/steposToolbarStyleFullScreen"/>
            <stepos.support.v7.widget.ActionBarContextView
                android:theme="?attr/actionBarTheme"
                android:id="@+id/action_context_bar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                style="?attr/steposActionModeStyleFullScreen"/>
        </stepos.support.v7.widget.StepOSCollapsingToolbarLayout>
        <FrameLayout
            android:id="@+id/action_bar_spring_layout_middle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/action_bar_spring_layout_quick"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </stepos.support.v7.widget.StepOSAppBarLayout>
    <ViewStub
        android:id="@+id/stepos_action_bar_dropdown_stub"
        android:layout="@layout/stepos_action_bar_drop_down_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <stepos.support.v7.widget.ActionBarContainer
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/split_action_bar"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?attr/actionBarSplitStyle">
        <View
            android:layout_gravity="top"
            android:id="@+id/stepos_nested_bottom_divider"
            android:background="?attr/colorOutlineVariant"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_below="@+id/mc_search_layout_container"
            android:alpha="1"/>
    </stepos.support.v7.widget.ActionBarContainer>
</stepos.support.v7.widget.ActionBarCoordinatorLayout>
