uniform float2 iResolution;
uniform float iTime;
uniform float glowIntensity;
uniform float glowWidth;
uniform float borderRadius;
uniform float amplitude;

const float PI = 3.14159265;
const float HALFPI = 1.57079633;

// 圆角矩形有符号距离场（内部为负，边线为 0，外侧为正）
float rrectSDF(float2 p, float2 hs, float r) {
    float2 d = abs(p) - hs + r;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
}

float hash(float n) { return fract(sin(n * 127.1) * 43758.5453123); }

// 归一化周长坐标：自“顶部中点”顺时针绕一圈 → [0,1)
// t∈(0,0.5) 落在屏幕右半，t∈(0.5,1) 落在屏幕左半。
float perimeterT(float2 p, float2 hs, float r) {
    float2 inner = hs - r;
    float arc = r * HALFPI;
    float total = 4.0 * inner.x + 4.0 * inner.y + 4.0 * arc;
    float ax = abs(p.x);
    float ay = abs(p.y);
    float dist;

    if (ay > inner.y && ax <= inner.x) {
        if (p.y < 0.0) {
            // 顶边
            if (p.x >= 0.0) dist = p.x;                                              // A 顶边右半
            else            dist = 3.0 * inner.x + 4.0 * inner.y + 4.0 * arc + (p.x + inner.x); // I 顶边左半
        } else {
            dist = inner.x + 2.0 * arc + 2.0 * inner.y + (inner.x - p.x);            // E 底边
        }
    } else if (ax > inner.x && ay <= inner.y) {
        if (p.x > 0.0) dist = inner.x + arc + (p.y + inner.y);                        // C 右边
        else           dist = 3.0 * inner.x + 3.0 * arc + 2.0 * inner.y + (inner.y - p.y); // G 左边
    } else {
        // 圆角
        float2 c = float2(sign(p.x) * inner.x, sign(p.y) * inner.y);
        float ang = atan(p.y - c.y, p.x - c.x);
        if (p.x > 0.0 && p.y < 0.0) {
            float f = clamp((ang + HALFPI) / HALFPI, 0.0, 1.0);                       // B 右上
            dist = inner.x + f * arc;
        } else if (p.x > 0.0 && p.y > 0.0) {
            float f = clamp(ang / HALFPI, 0.0, 1.0);                                  // D 右下
            dist = inner.x + arc + 2.0 * inner.y + f * arc;
        } else if (p.x < 0.0 && p.y > 0.0) {
            float f = clamp((ang - HALFPI) / HALFPI, 0.0, 1.0);                       // F 左下
            dist = 3.0 * inner.x + 2.0 * arc + 2.0 * inner.y + f * arc;
        } else {
            float a2 = ang < 0.0 ? ang + 6.2831853 : ang;                            // H 左上
            float f = clamp((a2 - PI) / HALFPI, 0.0, 1.0);
            dist = 3.0 * inner.x + 3.0 * arc + 4.0 * inner.y + f * arc;
        }
    }

    return fract(dist / total);
}

// CSS cubic-bezier(x1,y1,x2,y2)：牛顿迭代解 Bx(s)=t，返回 By(s)
float cubicBezier(float x1, float y1, float x2, float y2, float t) {
    float s = t;
    for (int i = 0; i < 6; i++) {
        float s1 = 1.0 - s;
        float bx = 3.0 * s1 * s1 * s * x1 + 3.0 * s1 * s * s * x2 + s * s * s;
        float dbx = 3.0 * x1 * s1 * (1.0 - 3.0 * s) + 3.0 * x2 * s * (2.0 - 3.0 * s) + 3.0 * s * s;
        s = clamp(s - (bx - t) / (abs(dbx) < 1e-4 ? 1e-4 : dbx), 0.0, 1.0);
    }
    float s1 = 1.0 - s;
    return 3.0 * s1 * s1 * s * y1 + 3.0 * s1 * s * s * y2 + s * s * s;
}

// 三段透明度时间线（循环周期 1400ms）：0→100%(300) → 100→50%(500) → 50→0%(600)
float opacityAnim(float tMs) {
    float p = 1400.0 * fract(tMs / 1400.0);
    if (p < 300.0) {
        return cubicBezier(0.33, 0.00, 0.66, 0.88, p / 300.0);
    } else if (p < 800.0) {
        return mix(1.0, 0.5, cubicBezier(0.33, -0.26, 0.67, 1.00, (p - 300.0) / 500.0));
    } else {
        return mix(0.5, 0.0, cubicBezier(0.17, 0.00, 0.83, 1.00, (p - 800.0) / 600.0));
    }
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspect = iResolution.x / iResolution.y;

    float intensity = glowIntensity > 0.0 ? glowIntensity : 1.8;
    float width = glowWidth > 0.0 ? glowWidth : 0.045;
    float radius = borderRadius > 0.0 ? borderRadius : 0.12;
    float amp = amplitude > 0.0 ? clamp(amplitude, 0.0, 1.0) : 0.5;
    float mTime = iTime * 3.0;   // 运动时间：流光/底部条速度加倍（透明度动画仍用真实 iTime）

    float2 p = (uv - 0.5) * float2(aspect, 1.0);
    float2 hs = float2(aspect * 0.5, 0.5);
    float r = min(hs.x, hs.y) * radius * 2.0;

    float d = rrectSDF(p, hs, r);          // 到边线的有符号距离（p 空间，屏高=1）
    float tp = perimeterT(p, hs, r);       // 当前像素的周长坐标

    float2 inner = hs - r;
    float arc = r * HALFPI;
    float totalP = 4.0 * inner.x + 4.0 * inner.y + 4.0 * arc;  // 周长（p 空间）
    float totalPx = totalP * iResolution.y;                    // 周长（像素）

    // 颜色取自 效果.png：暖金橙 / azure 蓝
    float3 cOrange = float3(1.0, 0.60, 0.20);
    float3 cBlue   = float3(0.16, 0.60, 1.0);

    float op = opacityAnim(iTime * 1000.0); // 全局透明度动画值（0→1→0.5→0）
    // 流光宽度随 alpha 动画同步：进入 0→max，退出 max→0
    float baseSig = width * 0.22 * op;  // 中段最粗时的垂直高斯 sigma（p 空间，窄条）

    // 6 段流光：3 橙 3 蓝，随机分布、随机长度(>200px)，相遇处颜色 add 叠加
    float3 accum = float3(0.0);
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float s1 = hash(fi * 1.7 + 0.3);
        float s2 = hash(fi * 2.3 + 1.1);
        float s3 = hash(fi * 3.9 + 2.7);

        float start = s1;                              // 随机起始位置
        float Lpx = 2180.0 + s2 * 297.0;                // 随机长度 (>2180px)
        float hlt = (Lpx * 0.5) / max(totalPx, 1.0);   // 半长（周长比例）
        float speed = 0.035 + s3 * 0.05;               // 周长 / 秒
        float dir = start < 0.5 ? -1.0 : 1.0;          // 右半→逆时针(-)，左半→顺时针(+)
        float center = fract(start + dir * speed * mTime + 8.0);

        float3 segCol = (i < 3) ? cOrange : cBlue;

        // 沿周长的有向距离（环形 wrap 到 [-0.5,0.5]）
        float dd = tp - center;
        dd = dd - floor(dd + 0.5);
        float u = dd / max(hlt, 1e-4);
        float au = abs(u);

        // 纵向羽化：中段=1、两端=0 的平滑包络（cos 钟形）
        float bump = au < 1.0 ? 0.5 + 0.5 * cos(au * PI) : 0.0;
        // 垂直粗细：两端细、中段粗
        float sig = baseSig * mix(0.30, 1.0, bump);
        float perp = exp(-(d * d) / (2.0 * sig * sig + 1e-6));

        accum += bump * perp * segCol;
    }

    // 默认不发光：单条只呈现本色（峰值≈0.8），不做泛光；仅相遇叠加处自然提亮
    accum *= intensity * (0.20 + 0.5 * amp);

    // ── 底部常驻双色条：蓝/橙各自左右随机游走，重叠处橙+蓝加性提亮 ──
    float bx = uv.x;
    float bd = 1.0 - uv.y;                          // 距底边（0=底，向上增大）
    float cxO = clamp(0.5 + 0.30 * sin(mTime * 0.70) + 0.15 * sin(mTime * 1.70 + 1.0), 0.06, 0.94);
    float cxB = clamp(0.5 + 0.30 * sin(mTime * 0.55 + 2.1) + 0.15 * sin(mTime * 1.30 + 3.7), 0.06, 0.94);
    float sigX = 0.26;
    float HO = 0.066 * (0.75 + 0.25 * sin(mTime * 1.6 + 0.5));   // 峰高随时间起伏
    float HB = 0.066 * (0.75 + 0.25 * sin(mTime * 1.9 + 2.0));
    float dO = (bx - cxO) / sigX;
    float dB = (bx - cxB) / sigX;
    // 各自的纵向覆盖：底部最亮、到各自高度处羽化；x 方向高斯保证横向无突变
    float colO = exp(-dO * dO);                       // 橙在该 x 的强度 (0~1)
    float colB = exp(-dB * dB);                       // 蓝在该 x 的强度 (0~1)
    // 指数纵向衰减：底部最亮、向上长尾羽化，无硬边
    // 统一到达高度（不再两侧抬高）→ 每条单峰，避免出现多个波峰
    float vsO = HO * 0.8;
    float vsB = HB * 0.8;
    // 指数幂次：中间(colO→1)幂大→平顶更“实”，两侧(→0)幂为 1→长尾更“虚”
    float kO = mix(1.0, 2.2, colO);
    float kB = mix(1.0, 2.2, colB);
    float covO = colO * exp(-pow(bd / (vsO + 1e-4), kO));
    float covB = colB * exp(-pow(bd / (vsB + 1e-4), kB));
    // 加性混合：纯色区保持本色（与六条同色），重叠区橙+蓝相加→提亮，过渡平滑无分界线
    float3 botCol = covO * cOrange + covB * cBlue;
    accum += botCol * (0.9 + 0.3 * amp);

    // 仅屏幕最外约 2 像素提亮，形成一条贴边亮线（仅放大已有光，无光处不变）
    float edgePx = min(min(uv.x, 1.0 - uv.x) * iResolution.x,
                       min(uv.y, 1.0 - uv.y) * iResolution.y);
    float edgeLine = 1.0 - smoothstep(0.0, 2.0, edgePx);
    accum *= 1.0 + 1.0 * edgeLine;

    float3 rgb = clamp(accum, 0.0, 1.0);
    float a = clamp(max(rgb.r, max(rgb.g, rgb.b)), 0.0, 1.0);  // 预乘 alpha
    return half4(half3(rgb * op), half(a * op));
}
