<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:constraintSetEnd="@+id/state_expanded_multi_row"
        motion:constraintSetStart="@+id/state_compact_single_row"
        motion:duration="100"/>
    <ConstraintSet android:id="@+id/state_compact_single_row">
        <Constraint
            android:id="@+id/bg_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintStart_toEndOf="@+id/layout_btn_voice"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_camera"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/layout_btn_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_text_send"
            motion:layout_goneMarginEnd="5dp">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_text_send"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="5dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/voiceRecordingView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintStart_toEndOf="@+id/layout_btn_voice">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/longPressTxtView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintStart_toEndOf="@+id/layout_btn_voice">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/state_expanded_multi_row">
        <Constraint
            android:id="@+id/bg_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_camera"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="16dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintTop_toBottomOf="@+id/bg_input">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/layout_btn_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/bg_input">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_text_send"
            motion:layout_constraintTop_toBottomOf="@+id/bg_input"
            motion:layout_goneMarginEnd="5dp">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/btn_text_send"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="5dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/bg_input">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/voiceRecordingView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintStart_toEndOf="@+id/layout_btn_voice">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint
            android:id="@+id/longPressTxtView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/btn_more"
            motion:layout_constraintStart_toEndOf="@+id/layout_btn_voice">
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
    </ConstraintSet>
</MotionScene>
