<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">
            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/taskspace_card_placeholder"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#ffffffff"
                android:id="@+id/tv_tag"
                android:background="@drawable/bg_highlight_tag_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_action_shoot_guide"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="#fdfdfd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/recommend_card_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99000000"
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/recommend_card_subtitle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/tv_action"
                android:background="#f3f3f3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/common_view"
                android:paddingVertical="10dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
