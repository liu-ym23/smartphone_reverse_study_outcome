<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/amoo_store_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/appDetailScroll"
        android:paddingTop="68dp"
        android:paddingBottom="156dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/appIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/amoo_app_detail_text_inset"
                android:paddingVertical="16dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/appHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">
                    <ImageView
                        android:id="@+id/ivAppIcon"
                        android:background="@drawable/bg_amoo_app_detail_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_amoo_market_agent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"
                        android:clipToOutline="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="20sp"
                            android:textColor="#ffffffff"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/tvAppName"
                            android:layout_width="match_parent"
                            android:layout_height="24sp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:lineHeight="24sp"
                            android:textFontWeight="420"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#80ffffff"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/tvAppSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="20sp"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:lineHeight="20sp"
                            android:textFontWeight="340"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tvAppDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:maxLines="3"
                    android:includeFontPadding="false"
                    android:lineHeight="22sp"
                    android:textFontWeight="260"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/appStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/amoo_app_detail_card_inset">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="88">
                    <TextView
                        android:id="@+id/tvStatSizeValue"
                        style="@style/AmooAppDetailStatValue"/>
                    <TextView
                        android:text="@string/amoo_app_detail_size_label"
                        style="@style/AmooAppDetailStatLabel"/>
                </LinearLayout>
                <View style="@style/AmooAppDetailStatDivider"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="75">
                    <TextView
                        android:id="@+id/tvStatDownloadsValue"
                        style="@style/AmooAppDetailStatValue"/>
                    <TextView
                        android:text="@string/amoo_app_detail_downloads_label"
                        style="@style/AmooAppDetailStatLabel"/>
                </LinearLayout>
                <View style="@style/AmooAppDetailStatDivider"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="142">
                    <TextView
                        android:id="@+id/tvStatUpdatedValue"
                        style="@style/AmooAppDetailStatValue"/>
                    <TextView
                        android:text="@string/amoo_app_detail_updated_label"
                        style="@style/AmooAppDetailStatLabel"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rvAppScreenshots"
                android:visibility="gone"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/amoo_app_detail_screenshot_inset"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAssetInfo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="@dimen/amoo_app_detail_card_inset">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/tvAssetInfoTitle"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="@string/amoo_app_detail_info_title"
                    android:includeFontPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textFontWeight="580"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/assetInfoCard"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:clipToOutline="true">
                    <LinearLayout
                        android:id="@+id/rowInfoVersion"
                        style="@style/AmooAppDetailInfoRow">
                        <LinearLayout style="@style/AmooAppDetailInfoKv">
                            <TextView
                                android:text="@string/amoo_app_detail_info_version"
                                style="@style/AmooAppDetailInfoKey"/>
                            <TextView
                                android:id="@+id/tvInfoVersion"
                                style="@style/AmooAppDetailInfoValue"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowInfoCategory"
                        style="@style/AmooAppDetailInfoRow">
                        <View style="@style/AmooAppDetailInfoDivider"/>
                        <LinearLayout style="@style/AmooAppDetailInfoKv">
                            <TextView
                                android:text="@string/amoo_app_detail_info_category"
                                style="@style/AmooAppDetailInfoKey"/>
                            <TextView
                                android:id="@+id/tvInfoCategory"
                                style="@style/AmooAppDetailInfoValue"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowInfoCreated"
                        android:visibility="gone"
                        style="@style/AmooAppDetailInfoRow">
                        <View style="@style/AmooAppDetailInfoDivider"/>
                        <LinearLayout style="@style/AmooAppDetailInfoKv">
                            <TextView
                                android:text="@string/amoo_app_detail_info_created"
                                style="@style/AmooAppDetailInfoKey"/>
                            <TextView
                                android:id="@+id/tvInfoCreated"
                                style="@style/AmooAppDetailInfoValue"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowInfoUpdated"
                        style="@style/AmooAppDetailInfoRow">
                        <View style="@style/AmooAppDetailInfoDivider"/>
                        <LinearLayout style="@style/AmooAppDetailInfoKv">
                            <TextView
                                android:text="@string/amoo_app_detail_updated_label"
                                style="@style/AmooAppDetailInfoKey"/>
                            <TextView
                                android:id="@+id/tvInfoUpdated"
                                style="@style/AmooAppDetailInfoValue"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowInfoDownloads"
                        style="@style/AmooAppDetailInfoRow">
                        <View style="@style/AmooAppDetailInfoDivider"/>
                        <LinearLayout style="@style/AmooAppDetailInfoKv">
                            <TextView
                                android:text="@string/amoo_app_detail_downloads_label"
                                style="@style/AmooAppDetailInfoKey"/>
                            <TextView
                                android:id="@+id/tvInfoDownloads"
                                style="@style/AmooAppDetailInfoValue"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/detailTopBar"
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btnBack"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_back"
            android:contentDescription="@string/common_back"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btnMore"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:visibility="gone"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_ellipsis"
            android:contentDescription="@null"/>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="68dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottomChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <com.stepos.ailauncher.chat.view.ProgressSplitTextView
        android:textSize="17sp"
        android:textColor="#1c1c1e"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btnInstall"
        android:background="@drawable/bg_amoo_app_detail_install_button"
        android:layout_width="274dp"
        android:layout_height="46dp"
        android:layout_marginBottom="46dp"
        android:text="@string/amoo_app_detail_install_app"
        android:translationZ="2dp"
        android:textFontWeight="500"/>
</FrameLayout>
