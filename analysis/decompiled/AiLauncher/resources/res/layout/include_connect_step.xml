<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_connect_section_card"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_step_index"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@+id/tv_step_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#99ffffff"
        android:id="@+id/tv_step_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="34dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_connect_code_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="34dp"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#e6ffffff"
            android:id="@+id/tv_step_cmd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"/>
        <ImageButton
            android:id="@+id/btn_step_copy"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_connect_copy"
            android:scaleType="centerInside"
            android:contentDescription="@string/connect_step1_subtitle"/>
    </LinearLayout>
</LinearLayout>
