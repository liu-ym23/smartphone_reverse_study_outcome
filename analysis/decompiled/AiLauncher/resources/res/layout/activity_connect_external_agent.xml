<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_nav"
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_arrow_back_24dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/connect_page_back"
            app:tint="#e5ffffff"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:text="@string/connect_external_agent_unified_title"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:lineHeight="24sp"
            android:textFontWeight="580"/>
    </FrameLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_column"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#f5ede6"
                android:gravity="center"
                android:id="@+id/tv_prerequisite_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect_section_prerequisite"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:id="@+id/tv_prerequisite_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/connect_external_prerequisite_desc_unified"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="28dp"
                android:text="@string/connect_step_section_steps"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingVertical="8dp"
                android:lineHeight="20sp"
                android:textFontWeight="580"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_agent_step_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#f5ede6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_step1_title"
                    android:includeFontPadding="false"
                    android:lineHeight="22sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/connect_step1_subtitle"
                    android:includeFontPadding="false"
                    android:lineHeight="16sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/connect_step1_label_macos"/>
                <FrameLayout
                    android:background="@drawable/bg_connect_code_box"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ccffffff"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_step1_cmd_mac"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"/>
                    <ImageButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/btn_copy_step1_mac"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_connect_copy"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"
                        android:layout_marginEnd="6dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/connect_step1_label_windows"/>
                <FrameLayout
                    android:background="@drawable/bg_connect_code_box"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ccffffff"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_step1_cmd_win"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"/>
                    <ImageButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/btn_copy_step1_win"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_connect_copy"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"
                        android:layout_marginEnd="6dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_agent_step_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#f5ede6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_step2_title"
                    android:includeFontPadding="false"
                    android:lineHeight="22sp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/connect_step2_subtitle"
                    android:includeFontPadding="false"
                    android:lineHeight="16sp"/>
                <FrameLayout
                    android:background="@drawable/bg_connect_code_box"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ccffffff"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_step2_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"/>
                    <ImageButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/btn_copy_step2"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_connect_copy"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"
                        android:layout_marginEnd="6dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_agent_step_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#f5ede6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_step3_title"
                        android:includeFontPadding="false"
                        android:lineHeight="22sp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#99ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/connect_step3_subtitle"
                        android:includeFontPadding="false"
                        android:lineHeight="16sp"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btn_scan"
                    android:background="@drawable/bg_connect_step_action"
                    android:padding="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_connect_scan"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#99ffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/connect_external_footer"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
