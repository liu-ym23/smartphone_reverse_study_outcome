<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_ime_glow"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_three_tile_ime_glow"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stepos.ailauncher.task.space.SoftLightGreetingView
        android:textSize="32sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/three_tile_greeting"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif-light-medium"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:textFontWeight="250"
        app:layout_constraintBottom_toTopOf="@+id/layout_suggestions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_suggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="89dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/con_layout_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_1"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_suggest_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_schedule"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_suggest_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_schedule"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_2"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_suggest_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_bills"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_suggest_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_bills"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_3"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_suggest_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_trips"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_suggest_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_trips"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_all_tasks"
        android:background="@drawable/bg_three_tile_all_tasks"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="94dp"
        android:stateListAnimator="@animator/anim_press_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="#b3ffffff"
            android:id="@+id/tv_all_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/three_tile_all_tasks"
            android:includeFontPadding="false"
            android:layout_marginEnd="-1dp"/>
        <ImageView
            android:id="@+id/iv_all_tasks_chevron"
            android:layout_width="10dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_all_tasks_chevron_up"
            android:scaleType="center"
            android:contentDescription="@null"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_layout_input"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chat_recommend_chips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/layout_input_bar_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chat_recommend_1"
                android:background="@drawable/bg_three_tile_suggest_chip"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:id="@+id/iv_chat_recommend_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_suggest_schedule"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#d9ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_chat_recommend_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/three_tile_suggest_schedule"
                    android:maxLines="2"
                    android:fontFamily="sans-serif-light-medium"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chat_recommend_2"
                android:background="@drawable/bg_three_tile_suggest_chip"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:id="@+id/iv_chat_recommend_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_suggest_bills"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#d9ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_chat_recommend_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/three_tile_suggest_bills"
                    android:maxLines="2"
                    android:fontFamily="sans-serif-light-medium"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chat_recommend_3"
                android:background="@drawable/bg_three_tile_suggest_chip"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:id="@+id/iv_chat_recommend_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_suggest_trips"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#d9ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_chat_recommend_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/three_tile_suggest_trips"
                    android:maxLines="2"
                    android:fontFamily="sans-serif-light-medium"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.stepos.ailauncher.chat.view.HomeInputView
            android:id="@+id/layout_input_bar_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_input_thinking_bar"
            android:background="@drawable/bg_float_input_box"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="12dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_input_bar_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/home_input_thinking_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_chat_agent"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/home_input_thinking_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wake_asr_finalizing"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/home_input_thinking_stop"
                app:layout_constraintStart_toEndOf="@+id/home_input_thinking_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/home_input_thinking_stop"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_stop_reply"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
