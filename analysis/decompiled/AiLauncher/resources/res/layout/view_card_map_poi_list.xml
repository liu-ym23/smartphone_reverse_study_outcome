<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_map_shell_night"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.ailauncher.foundation.appui.card.provider.amap.MapAspectFrameLayout
        android:id="@+id/flPoiListMap"
        android:background="@color/card_map_shell_night_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivPoiListMap"
            android:background="@drawable/bg_map_slot_top_rounded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <com.stepos.agentframework.uikit.IndeterminateSpinnerView
            android:layout_gravity="center"
            android:id="@+id/vPoiListMapLoading"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:elevation="24dp"/>
        <FrameLayout
            android:id="@+id/flPoiMarkerOverlay"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="16dp"/>
        <com.stepos.ailauncher.foundation.appui.card.provider.amap.NestedScrollableHost
            android:layout_gravity="bottom"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_map_poi_card_strip_height"
            android:layout_marginBottom="@dimen/card_map_poi_card_strip_margin_bottom"
            android:elevation="4dp">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpPoiCards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.stepos.ailauncher.foundation.appui.card.provider.amap.NestedScrollableHost>
    </com.stepos.ailauncher.foundation.appui.card.provider.amap.MapAspectFrameLayout>
    <FrameLayout
        android:id="@+id/flPoiDetail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</LinearLayout>
