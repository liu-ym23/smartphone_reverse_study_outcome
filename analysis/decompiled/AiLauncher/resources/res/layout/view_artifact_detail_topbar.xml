<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/topbar_end_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/version_btn_group"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="11dp">
            <ImageView
                android:id="@+id/ivPartPrev"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_part_prev"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_part_prev"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:id="@+id/ivPartNext"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_part_next"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_part_next"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/action_btn_group"
            android:background="@drawable/bg_top_bar_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="11dp">
            <ImageView
                android:id="@+id/ivFullscreen"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_fullscreen"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_fullscreen"/>
            <ImageView
                android:id="@+id/ivMore"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_top_bar_more"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_more"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/ivDownload"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_download"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_download"
                android:layout_marginStart="16dp"
                app:tint="@color/white"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_back"
            android:background="@null"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_chrome_close"
            android:scaleType="fitCenter"
            android:contentDescription="@string/chat_sheet_back"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</merge>
