<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">
    <ImageView
        android:id="@+id/taskstoreLargeChecklistIcon"
        android:layout_width="@dimen/taskstore_card_check_size"
        android:layout_height="@dimen/taskstore_card_check_size"
        android:src="@drawable/ic_taskstore_check_circle"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/taskstore_card_item_size"
        android:textColor="@color/taskstore_card_item_text"
        android:id="@+id/taskstoreLargeChecklistText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"/>
</LinearLayout>
