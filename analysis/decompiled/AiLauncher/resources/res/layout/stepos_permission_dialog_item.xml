<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/stepos_alert_dialog_normal_margin_start">
    <TextView
        android:ellipsize="end"
        android:id="@+id/stepos_permission_dialog_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:includeFontPadding="false"
        android:textDirection="locale"
        style="@style/Widget.StepOS.SingleList.Title"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/stepos_permission_dialog_item_text_normal"
        android:id="@+id/stepos_permission_dialog_item_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"
        android:textDirection="locale"/>
</LinearLayout>
