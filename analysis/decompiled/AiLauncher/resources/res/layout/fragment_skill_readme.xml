<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/iv_back"
            android:background="@drawable/bg_agent_detail_icon_btn"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_agent_detail_back"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sd_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:text="@string/skill_detail_section_readme"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:textFontWeight="580"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingTop="@dimen/ail_sheet_title_bar_total_height"
        android:paddingBottom="36dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_skill_readme_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sd_text_primary"
                android:id="@+id/tv_readme_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
</FrameLayout>
