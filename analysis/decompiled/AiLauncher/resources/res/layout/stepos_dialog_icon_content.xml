<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/stepos_dialog_icon_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stepos_dialog_icon_content_left"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/stepos_dialog_icon_content_left_icon_frame"
            android:background="@drawable/stepos_bg_dialog_icon_content_selected"
            android:layout_width="@dimen/stepos_dialog_icon_content_size"
            android:layout_height="@dimen/stepos_dialog_icon_content_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/stepos_dialog_icon_content_left_icon"
                android:padding="@dimen/stepos_dialog_icon_content_icon_inset"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Dialog.IconContent"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/stepos_dialog_icon_content_left_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stepos_dialog_icon_content_label_gap"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stepos_dialog_icon_content_right"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/stepos_dialog_icon_content_column_gap">
        <FrameLayout
            android:id="@+id/stepos_dialog_icon_content_right_icon_frame"
            android:background="@drawable/stepos_bg_dialog_icon_content_unselected"
            android:layout_width="@dimen/stepos_dialog_icon_content_size"
            android:layout_height="@dimen/stepos_dialog_icon_content_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/stepos_dialog_icon_content_right_icon"
                android:padding="@dimen/stepos_dialog_icon_content_icon_inset"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Dialog.IconContent"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/stepos_dialog_icon_content_right_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stepos_dialog_icon_content_label_gap"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
