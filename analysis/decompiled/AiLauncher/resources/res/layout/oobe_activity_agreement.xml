<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/agreement_root"
    android:background="@color/oobe_dark_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:paddingBottom="154dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.stepos.widget.toolbar.StepOSScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="36sp"
                android:textColor="@color/oobe_agreement_text_primary"
                android:gravity="center"
                android:id="@+id/title_section"
                android:paddingBottom="52dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oobe_title"
                android:paddingHorizontal="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/oobe_agreement_text_secondary"
                    android:background="@drawable/bg_agreement_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/oobe_perm_top"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="16dp"
                    android:lineHeight="22sp"/>
                <FrameLayout
                    android:paddingTop="24dp"
                    android:paddingBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <CheckBox
                        android:id="@+id/cb_agree_all"
                        android:text="@string/oobe_agree_all"
                        style="@style/OobeAgreeAllCheckbox"/>
                    <View
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/overlay_cb_agree_all"
                        android:background="@android:color/transparent"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="34dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="-8dp"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_agreement_card"
                    android:paddingTop="0dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_perm1_desc"
                        android:paddingHorizontal="14dp"
                        android:lineHeight="22sp"/>
                    <FrameLayout
                        android:paddingBottom="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp">
                        <CheckBox
                            android:id="@+id/cb_user_agreement"
                            android:text="@string/oobe_perm1_consent"
                            style="@style/OobeConsentCheckbox"/>
                        <View
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/overlay_cb_user_agreement"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="34dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="-8dp"/>
                    </FrameLayout>
                    <View
                        android:background="@drawable/bg_agreement_divider"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="14dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_perm2_desc"
                        android:paddingHorizontal="14dp"
                        android:lineHeight="22sp"/>
                    <FrameLayout
                        android:paddingBottom="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp">
                        <CheckBox
                            android:id="@+id/cb_voiceprint"
                            android:text="@string/oobe_perm2_consent"
                            style="@style/OobeConsentCheckbox"/>
                        <View
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/overlay_cb_voiceprint"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="-8dp"/>
                    </FrameLayout>
                    <View
                        android:background="@drawable/bg_agreement_divider"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="14dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_perm3_desc"
                        android:paddingHorizontal="14dp"
                        android:lineHeight="22sp"/>
                    <FrameLayout
                        android:paddingBottom="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp">
                        <CheckBox
                            android:id="@+id/cb_improvement"
                            android:text="@string/oobe_perm3_consent"
                            style="@style/OobeConsentCheckbox"/>
                        <View
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/overlay_cb_improvement"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="-8dp"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stepos.widget.toolbar.StepOSAppBarLayout
        android:id="@+id/app_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        style="@style/StepOSWidget.AppBarLayout">
        <com.stepos.widget.toolbar.StepOSCollapsingTitleBar
            android:id="@+id/collapsing_title_bar"
            android:background="@color/oobe_dark_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:steposBackdropBlurEnabled="true"
            app:steposBackdropScrimColor="@color/oobe_dark_bg"
            app:steposCollapsingActionBottomPadding="@dimen/stepos_titlebar_padding_bottom"
            app:steposCollapsingActionTopPadding="@dimen/stepos_titlebar_padding_top"
            app:steposTitle="@string/oobe_title"
            style="@style/Oobe.CollapsingTitleBar"/>
    </com.stepos.widget.toolbar.StepOSAppBarLayout>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="top"
        android:id="@+id/tv_compact_title"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_collapsed_height"
        android:text="@string/oobe_title"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="76dp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="13sp"
        android:autoSizeMaxTextSize="17sp"
        android:textFontWeight="600"/>
    <com.stepos.widget.glass.StepOSGlassPanel
        android:layout_gravity="bottom"
        android:id="@+id/footer_panel"
        android:background="@color/oobe_dark_bg"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:steposGlassBlurDirection="topToBottom"
        app:steposGlassBlurRadius="@dimen/oobe_agreement_footer_blur_radius"
        app:steposGlassBlurScale="0"
        app:steposGlassBlurUniform="false"
        app:steposGlassCornerRadius="0dp"
        app:steposGlassEnabled="true"
        app:steposGlassScope="inWindow"
        app:steposGlassScrim="@drawable/bg_agreement_footer_scrim"
        style="@style/StepOSWidget.GlassPanel">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/footer_content"
            android:paddingTop="36dp"
            android:paddingBottom="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="36dp">
            <com.stepos.widget.button.StepOSButton
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stepos_button_height"
                android:text="@string/oobe_continue"
                style="@style/Oobe.Button"/>
            <com.stepos.widget.button.StepOSButton
                android:id="@+id/btn_later"
                android:background="@drawable/bg_oobe_later_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stepos_button_height"
                android:layout_marginTop="@dimen/stepos_button_bar_gap"
                android:text="@string/oobe_later"
                style="@style/Oobe.Button.Secondary"/>
        </LinearLayout>
    </com.stepos.widget.glass.StepOSGlassPanel>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
