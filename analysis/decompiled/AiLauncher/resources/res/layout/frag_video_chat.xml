<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llIsland"
        android:background="@drawable/bg_island"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivIsland"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_live_island"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tvIsland"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Call"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#040404"
        android:id="@+id/tvSubtitles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/video_subtitle_placeholder"
        android:includeFontPadding="false"
        android:layout_marginEnd="16dp"
        android:letterSpacing="10"
        android:paddingHorizontal="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSubtitlesOn"
        android:background="@drawable/bg_subtitles_on"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/ic_subtitles_on"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvSubtitles"
        app:layout_constraintEnd_toEndOf="@+id/tvSubtitles"/>
    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:src="@drawable/img_mascot_connected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llIsland"/>
    <FrameLayout
        android:id="@+id/flSubtitlesContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/llChatStatus"
        app:layout_constraintTop_toBottomOf="@+id/llIsland">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubtitles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/ivScrollToBottom"
            android:background="@drawable/bg_arrow_down"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@string/scroll_to_bottom"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/ivMuteSwitch"
        android:layout_marginBottom="60dp"
        android:src="@drawable/ic_mic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivVideoSwitch"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/VideoChatButtonsStyle"/>
    <ImageView
        android:id="@+id/ivVideoSwitch"
        android:src="@drawable/ic_video"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivMuteSwitch"
        app:layout_constraintEnd_toStartOf="@+id/ivClose"
        app:layout_constraintStart_toEndOf="@+id/ivMuteSwitch"
        style="@style/VideoChatButtonsStyle"/>
    <ImageView
        android:id="@+id/ivClose"
        android:src="@drawable/ic_close"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivMuteSwitch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivVideoSwitch"
        style="@style/VideoChatButtonsStyle"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llChatStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="73dp"
        app:layout_constraintBottom_toTopOf="@+id/ivMuteSwitch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/aniChatStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#92808c"
            android:id="@+id/tvChatStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
