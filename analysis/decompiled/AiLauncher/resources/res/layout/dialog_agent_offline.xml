<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_overlay"
    android:background="#99000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_card"
        android:background="@drawable/bg_agent_offline_card"
        android:paddingTop="38dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="18dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="#eeeeee"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_agent_offline_title"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#73ebebf5"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/chat_agent_offline_desc"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#1564ed"
            android:gravity="center"
            android:id="@+id/btn_reconnect"
            android:background="@drawable/bg_agent_offline_btn_primary"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="38dp"
            android:text="@string/chat_agent_offline_reconnect"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#1564ed"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_agent_offline_btn_secondary"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/common_cancel"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
