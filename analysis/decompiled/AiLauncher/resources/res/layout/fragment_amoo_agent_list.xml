<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/amoo_store_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btnBack"
            android:background="@drawable/bg_new_session_circle"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_back"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:textFontWeight="580"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingTop="@dimen/ail_sheet_title_bar_total_height"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAgents"
            android:background="@drawable/bg_amoo_entry_card"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:clipToOutline="true"/>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
</FrameLayout>
