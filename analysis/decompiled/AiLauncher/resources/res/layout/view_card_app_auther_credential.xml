<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/llAutherShell"
    android:background="@drawable/bg_card_auther_shell"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivAutherIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_card_auther_app_placeholder"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvAutherTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="14dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/card_auther_status_unauthorized"
            android:id="@+id/tvAutherStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/card_text_secondary"
        android:id="@+id/tvAutherDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llAutherKeyBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:gravity="center"
            android:id="@+id/btnAutherSecondary"
            android:background="@drawable/bg_card_auther_cta_secondary"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:gravity="center"
            android:id="@+id/btnAutherPrimary"
            android:background="@drawable/bg_card_auther_cta"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
