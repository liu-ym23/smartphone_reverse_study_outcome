<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootInput"
    android:background="@drawable/bg_input_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.agentframework.chatui.view.NestedScrollableHost
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_input_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </com.stepos.agentframework.chatui.view.NestedScrollableHost>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_edit"
        android:background="@drawable/bg_edit_hint"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit"/>
        <TextView
            android:textColor="@color/agent_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在修改消息"
            android:layout_marginStart="8dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_exit_edit"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dialog_close"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tv_voice_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="iv_voice_input,iv_keyboard"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="15sp"
                android:textColor="@color/agent_text_primary"
                android:textColorHint="@color/agent_text_hint"
                android:gravity="center_vertical"
                android:id="@+id/et_message"
                android:background="@null"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="输入消息..."
                android:maxLines="5"
                android:layout_weight="1"
                android:paddingEnd="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_voice_input"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="12dp"
                android:src="@drawable/icon_voice_input"
                app:layout_constraintEnd_toEndOf="@+id/et_message"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_keyboard"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="12dp"
                android:src="@drawable/icon_keyboard"
                app:layout_constraintEnd_toEndOf="@+id/et_message"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_voice_output"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/barrier_end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:background="@drawable/bg_circle_r20"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:textSize="20sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/selector_round_button"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/btn_send"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_send"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/btn_cancel"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_cancel"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_think"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="20dp">
        <CheckedTextView
            android:textSize="12sp"
            android:textColor="@color/color_agent_type_selector"
            android:gravity="center"
            android:id="@+id/tv_deep_think"
            android:background="@drawable/bg_agent_param_selector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="深度思考"
            android:drawableStart="@drawable/ic_deep_think"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:drawableTint="@color/color_agent_type_selector"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/ll_bottom_options"
        android:padding="12dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llPickImg"
            android:background="@drawable/image_button_bg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/agent_surface_card">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chat_gallery"
                android:layout_marginHorizontal="16dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/agent_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="相册"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llPickFile"
            android:background="@drawable/image_button_bg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/agent_surface_card">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_file"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chat_file"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/agent_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="文件"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
