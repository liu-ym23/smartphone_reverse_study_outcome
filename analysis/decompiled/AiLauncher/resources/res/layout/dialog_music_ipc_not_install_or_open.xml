<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_dialog_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_music_ipc_dialog"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_install_app_title"
            android:paddingHorizontal="16dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#3d4454"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dialog_install_app_message"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_app_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:src="@drawable/ic_music_ipc_dialog_app"
            android:contentDescription="@string/dialog_app_name_label"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#3d4454"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/dialog_app_name_label"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#3d4454"
            android:gravity="center"
            android:id="@+id/tv_developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/dialog_app_developer_label"/>
        <Button
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/btn_control"
            android:background="@drawable/shape_btn_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="30dp"
            android:text="@string/dialog_open_app_button"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
