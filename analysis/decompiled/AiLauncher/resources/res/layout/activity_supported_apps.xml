<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/view_setting_top_bar"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/chat_color_on_surface_variant"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/supported_apps_subtitle"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/supportedAppsCard"
        android:background="@drawable/bg_voice_setting_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:clipToOutline="true"/>
</LinearLayout>
