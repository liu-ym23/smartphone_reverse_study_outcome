<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDidiCarTypeRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/card_didi_text_tertiary"
        android:id="@+id/tvDidiDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/llDidiEstimate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/card_price_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预估"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_price_text"
                    android:id="@+id/tvDidiEstimateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/card_price_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="元起"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/card_didi_text_tertiary"
                android:id="@+id/tvDidiSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btnDidiCarSelectCta"
            android:background="@drawable/bg_card_didi_cta"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
