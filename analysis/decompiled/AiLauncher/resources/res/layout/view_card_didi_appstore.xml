<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivDidiAppIcon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/ic_card_didi_app"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvDidiAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvDidiAppSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/card_didi_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/tvDidiAppExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flDidiInstall"
        android:background="@drawable/bg_card_didi_cta"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:minWidth="60dp"
        android:layout_marginStart="10dp"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvDidiInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="600"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivDidiInstallLoading"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_card_didi_loading_spin"
            android:contentDescription="@null"/>
    </FrameLayout>
</LinearLayout>
