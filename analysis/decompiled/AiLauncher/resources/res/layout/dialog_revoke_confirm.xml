<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_rename_dialog"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <ScrollView
        android:id="@+id/revoke_content_scroll"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/chat_color_on_surface"
                android:gravity="center"
                android:id="@+id/tv_revoke_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_detail_revoke_second_title"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/chat_color_on_surface_variant"
                android:id="@+id/tv_revoke_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/privacy_detail_revoke_second_message"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/chat_color_on_surface_variant"
                android:id="@+id/tv_revoke_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1564ed"
            android:gravity="center"
            android:id="@+id/btn_revoke_cancel"
            android:background="@drawable/bg_btn_revoke_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/privacy_detail_revoke_second_cancel"
            android:layout_weight="1"
            android:paddingVertical="8dp"/>
        <View
            android:layout_width="12dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1564ed"
            android:gravity="center"
            android:id="@+id/btn_revoke_confirm"
            android:background="@drawable/bg_btn_dialog_confirm_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/privacy_detail_revoke_second_agree"
            android:layout_weight="1"
            android:paddingVertical="8dp"/>
    </LinearLayout>
</LinearLayout>
