<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_task_result_file_compact_row"
    android:paddingTop="@dimen/task_result_file_compact_row_padding_v"
    android:paddingBottom="@dimen/task_result_file_compact_row_padding_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="middle"
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:lineSpacingExtra="4sp"
        android:layout_marginStart="8dp"/>
    <ImageView
        android:id="@+id/iv_file_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_taskstore_arrow_next_right"
        android:contentDescription="@null"/>
</LinearLayout>
