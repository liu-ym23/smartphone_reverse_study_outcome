<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_rename"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="150dp"
    android:elevation="16dp"
    android:paddingVertical="8dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/popup_rename_item_text"
        android:gravity="center_vertical"
        android:id="@+id/tv_rename_title"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/session_menu_rename"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_chat_edit"
        android:drawableTint="@color/popup_rename_item_text"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#e7000c"
        android:gravity="center_vertical"
        android:id="@+id/tv_delete"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/common_delete"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_chat_del"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"/>
</LinearLayout>
