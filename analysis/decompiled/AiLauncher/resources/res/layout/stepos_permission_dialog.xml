<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/permission_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/stepos_permission_checkbox_pack"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <stepos.support.v7.widget.CenterIfNeedTextView
            android:textSize="17sp"
            android:textColor="#ff000000"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/stepos_permission_dialog_title"
            android:paddingLeft="@dimen/stepos_alert_dialog_normal_margin_start"
            android:paddingTop="38dp"
            android:paddingRight="@dimen/stepos_alert_dialog_normal_margin_start"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <com.stepos.common.scrollview.StepOSNestedScrollView
            android:id="@+id/stepos_permission_dialog_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/stepos_permission_dialog_title">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/stepos_permission_dialog_item_text_normal"
                    android:gravity="start"
                    android:id="@+id/stepos_permission_dialog_terms"
                    android:paddingBottom="@dimen/policy_sdk_permission_dialog_terms_descender_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
                    android:layout_marginEnd="@dimen/stepos_alert_dialog_normal_margin_end"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/stepos_permission_dialog_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="23dp"
                    android:layout_weight="1">
                    <View
                        android:id="@+id/stepos_permission_dialog_scroll_indicator_up"
                        android:background="#0d000000"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="2px"/>
                    <stepos.support.v7.widget.PermissionScrollView
                        android:id="@+id/stepos_permission_dialog_scroll_view"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="ifContentScrolls">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/stepos_permission_dialog_content_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </stepos.support.v7.widget.PermissionScrollView>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/stepos_permission_dialog_item_text_normal"
                        android:gravity="start"
                        android:id="@+id/stepos_permission_dialog_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/stepos_alert_dialog_normal_margin_start"
                        android:layout_marginTop="21dp"
                        android:layout_marginRight="@dimen/stepos_alert_dialog_normal_margin_end"
                        android:includeFontPadding="false"/>
                    <View
                        android:id="@+id/stepos_permission_dialog_scroll_indicator_down"
                        android:background="#0d000000"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="2px"/>
                </LinearLayout>
            </LinearLayout>
        </com.stepos.common.scrollview.StepOSNestedScrollView>
        <com.stepos.common.scrollbarview.StepOSScrollBarView
            android:id="@+id/stepos_permission_dialog_scrollbarview_vertical"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:scrollBarFadeEnable="false"
            app:scrollBarThumbTint="@color/stepos_permission_dialog_scroll_bar_color"
            style="@style/Widget.StepOS.ScrollBarView.PermissionDialog"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/stepos_permission_checkbox_pack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_relative_layout"
        app:layout_constraintVertical_bias="1">
        <CheckBox
            android:textSize="14sp"
            android:textColor="@color/stepos_permission_dialog_item_text_normal"
            android:id="@+id/stepos_permission_dialog_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:checked="false"
            android:button="@drawable/stepos_btn_check_button_brand_on_layer_mini"
            android:text="@string/stepos_permission_almost_deny"
            android:paddingStart="8dp"
            android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
            android:layout_marginEnd="@dimen/stepos_alert_dialog_normal_margin_end"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/stepos_checkbox_layout_first"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
            android:layout_marginEnd="@dimen/stepos_alert_dialog_normal_margin_end">
            <CheckBox
                android:textSize="14sp"
                android:textColor="@color/stepos_permission_dialog_item_text_normal"
                android:id="@+id/stepos_permission_dialog_checkbox_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/stepos_btn_check_button_brand_on_layer_mini"
                android:paddingStart="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/stepos_permission_dialog_item_text_normal"
                android:id="@+id/stepos_permission_dialog_tv_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/stepos_checkbox_layout_second"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
            android:layout_marginEnd="@dimen/stepos_alert_dialog_normal_margin_end">
            <CheckBox
                android:textSize="14sp"
                android:textColor="@color/stepos_permission_dialog_item_text_normal"
                android:id="@+id/stepos_permission_dialog_checkbox_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/stepos_btn_check_button_brand_on_layer_mini"
                android:paddingStart="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/stepos_permission_dialog_item_text_normal"
                android:id="@+id/stepos_permission_dialog_tv_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
