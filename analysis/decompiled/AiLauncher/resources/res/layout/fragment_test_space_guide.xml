<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_repair_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:paddingTop="68dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_repair_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="true">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#e6ffffff"
                    android:id="@+id/tvStep1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="420"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tvStep1Desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textFontWeight="340"/>
                <View
                    android:background="#08ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#e6ffffff"
                    android:id="@+id/tvStep2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="420"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tvStep2Desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textFontWeight="340"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/promptCard"
                    android:background="@drawable/bg_test_space_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tvPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/test_space_guide_prompt"
                        android:lineSpacingMultiplier="1.3"
                        android:textFontWeight="340"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#66ffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/test_space_guide_bottom_note"
                android:lineSpacingMultiplier="1.3"
                android:textFontWeight="340"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btnBack"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_test_space_back"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:includeFontPadding="false"
            android:textFontWeight="580"/>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
</FrameLayout>
