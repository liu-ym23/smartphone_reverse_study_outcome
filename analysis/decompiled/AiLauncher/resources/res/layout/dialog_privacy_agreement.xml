<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flPrivacyOverlay"
    android:background="#33000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llPrivacyCard"
        android:background="@drawable/bg_card_white_round16"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_dialog_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#8a000000"
            android:gravity="start"
            android:id="@+id/tvPrivacyMessage"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_dialog_message"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_sms_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_sms_desc"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_contacts_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_contacts_desc"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_call_log_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_call_log_desc"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1f1f1f"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_storage_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_assistant_privacy_perm_storage_desc"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff3b30"
                android:gravity="center"
                android:id="@+id/tvPrivacyReject"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/step_assistant_privacy_reject"
                android:layout_weight="1"/>
            <View
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#1677ff"
                android:gravity="center"
                android:id="@+id/tvPrivacyAgree"
                android:background="@drawable/bg_btn_dialog_confirm"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/step_assistant_privacy_agree"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
