<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pkg_conflict_card"
        android:layout_width="352dp"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_pkg_conflict_drag_indicator"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="13dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="19sp"
                android:textColor="#eeeeee"
                android:id="@+id/tv_pkg_conflict_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="9dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#cceeeeee"
                android:id="@+id/btn_pkg_conflict_confirm"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pkg_conflict_btn_confirm"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"/>
            <View
                android:background="#0dffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#cceeeeee"
                android:id="@+id/btn_pkg_conflict_cancel"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pkg_conflict_btn_cancel"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
