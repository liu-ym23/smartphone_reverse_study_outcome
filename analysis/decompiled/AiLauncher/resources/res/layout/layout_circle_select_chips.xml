<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/circle_chips_scroll"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/circle_chips_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/chip_what_is_this"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/circle_select_what_is_this"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_circle_select_quill"
            android:fontFamily="sans-serif-light-medium"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/chip_describe_image"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/circle_select_image_describe"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_circle_select_quill"
            android:fontFamily="sans-serif-light-medium"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/chip_caption"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/circle_select_image_caption"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_circle_select_quill"
            android:fontFamily="sans-serif-light-medium"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
</HorizontalScrollView>
