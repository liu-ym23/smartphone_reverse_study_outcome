<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_overlay"
    android:background="#10000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_card"
        android:background="@drawable/bg_delete_dialog_card"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sidebar_agent_disconnect_dialog_title"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffff"
            android:gravity="start"
            android:id="@+id/tv_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/sidebar_agent_disconnect_dialog_desc"
            android:lineSpacingExtra="4dp"
            android:alpha="0.8"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="#1564ed"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/bg_delete_dialog_cancel"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sidebar_agent_disconnect_dialog_cancel"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#e7000c"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/bg_delete_dialog_confirm"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sidebar_agent_disconnect_dialog_confirm"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
