<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_amoo_entry_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/feishu_text_primary"
                android:id="@+id/tv_rec_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="24sp"
                android:textFontWeight="500"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/feishu_ok"
                android:id="@+id/tv_rec_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feishu_cli_connected_recommend_badge"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/feishu_text_secondary"
            android:id="@+id/tv_rec_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/mz_btn_copy_next_page"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"/>
</LinearLayout>
