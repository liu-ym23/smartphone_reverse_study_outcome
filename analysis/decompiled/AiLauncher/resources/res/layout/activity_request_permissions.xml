<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_request_permission_dialog"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:id="@+id/tv_request_permissions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="隐私权限开启"
        app:layout_constraintBottom_toTopOf="@+id/tv_request_permissions_des"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/tv_request_permissions_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="为保障任务成功执行，需要向您申请如下权限"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toTopOf="@+id/rv_permission_request"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_permission_request"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/dp_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btn_request_permission_finish"
        app:layout_constraintDimensionRatio="1:1"/>
    <Button
        android:enabled="false"
        android:textSize="18sp"
        android:id="@+id/btn_request_permission_finish"
        android:background="@drawable/btn_selector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="完成"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/tv_skip_permission"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳过"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
