<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_mcp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/chat_tool_call_text"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_mcp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="272dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textFontWeight="400"/>
        <ImageView
            android:id="@+id/iv_tool_expand"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_mcp_collapsed"
            app:tint="@color/chat_tool_item_expand_icon"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tool_detail_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/chat_tool_text"
            android:id="@+id/tool_params_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_tool_params"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/chat_tool_text"
            android:layout_gravity="start"
            android:id="@+id/tool_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/chat_tool_text"
            android:id="@+id/tool_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/chat_tool_result"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/chat_tool_text"
            android:layout_gravity="start"
            android:id="@+id/tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</LinearLayout>
