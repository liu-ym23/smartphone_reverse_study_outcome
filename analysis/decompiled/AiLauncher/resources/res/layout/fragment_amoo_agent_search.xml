<?xml version="1.0" encoding="utf-8"?>
<com.stepos.ailauncher.chat.view.ImeDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:background="@color/amoo_store_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/searchTopBar"
            android:background="@color/amoo_store_page_bg"
            android:paddingTop="@dimen/ail_sheet_title_padding_top"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:translationZ="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ail_sheet_title_text_height"
                android:text="@string/amoo_store_search_title"
                android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/searchContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/searchResultScroll"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearchResults"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:clipToOutline="true"/>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/searchHints"
                android:paddingBottom="48dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/searchInitialHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_amoo_search"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/amoo_agent_search_initial_hint"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/searchEmptyHint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amoo_agent_search_empty_title"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#80ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/amoo_store_search_empty_subtitle"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/bg_amoo_bottom_bar_fade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/searchBottomBar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="40dp"
                android:translationZ="2dp"
                android:layout_marginHorizontal="20dp">
                <FrameLayout
                    android:id="@+id/searchInputContainer"
                    android:background="@drawable/bg_amoo_search_input"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_amoo_search"
                        android:contentDescription="@null"
                        android:layout_marginStart="8dp"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="#ffffffff"
                        android:textColorHint="#66ffffff"
                        android:id="@+id/etSearch"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/amoo_store_agent_search_hint"
                        android:maxLines="1"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:paddingStart="36dp"
                        android:paddingEnd="40dp"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/btnSearchClear"
                        android:background="@drawable/bg_amoo_search_clear"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_amoo_close"
                        android:contentDescription="@null"
                        android:layout_marginEnd="8dp"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/btnSearchClose"
                    android:background="@drawable/bg_amoo_search_input"
                    android:padding="11dp"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_amoo_close"
                    android:contentDescription="@null"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.stepos.ailauncher.chat.view.ImeDismissFrameLayout>
