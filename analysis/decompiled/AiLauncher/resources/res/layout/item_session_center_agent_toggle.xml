<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:paddingHorizontal="28dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/session_center_on_glass_secondary"
        android:id="@+id/tv_agent_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sidebar_agent_expand"/>
    <ImageView
        android:id="@+id/iv_agent_toggle_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_history_agent_arrow"
        android:contentDescription="@null"
        android:layout_marginStart="2dp"/>
</LinearLayout>
