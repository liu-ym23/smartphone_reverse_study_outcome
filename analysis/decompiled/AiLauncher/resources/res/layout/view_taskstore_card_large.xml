<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_taskstore_card"
    android:padding="@dimen/taskstore_card_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/taskstoreLargeIconWrap"
            android:background="@drawable/bg_taskstore_icon_circle"
            android:layout_width="@dimen/taskstore_card_icon_size"
            android:layout_height="@dimen/taskstore_card_icon_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/taskstoreLargeIcon"
                android:layout_width="@dimen/taskstore_card_icon_inner"
                android:layout_height="@dimen/taskstore_card_icon_inner"
                android:src="@drawable/ic_taskstore_card_default"
                android:contentDescription="@null"
                app:tint="@color/taskstore_card_icon_tint"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="@dimen/taskstore_card_title_size"
                android:textStyle="bold"
                android:textColor="@color/taskstore_card_title"
                android:ellipsize="end"
                android:id="@+id/taskstoreLargeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/taskstore_card_subtitle_size"
                android:textColor="@color/taskstore_card_status_normal"
                android:ellipsize="end"
                android:id="@+id/taskstoreLargeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/taskstoreLargeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/taskstoreLargeActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="@dimen/taskstore_card_action_size"
            android:textColor="@color/taskstore_action_secondary_text"
            android:gravity="center"
            android:id="@+id/taskstoreLargeActionSecondary"
            android:background="@drawable/bg_taskstore_action_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/taskstore_card_action_height"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/taskstore_card_action_size"
            android:textStyle="bold"
            android:textColor="@color/taskstore_action_primary_text"
            android:gravity="center"
            android:id="@+id/taskstoreLargeActionPrimary"
            android:background="@drawable/bg_taskstore_action_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/taskstore_card_action_height"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
