<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wakeword_root"
    android:background="@color/oobe_dark_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:paddingTop="@dimen/stepos_titlebar_collapsed_height"
        android:paddingBottom="120dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="36sp"
                android:textColor="@color/oobe_agreement_text_primary"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="46dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oobe_wakeword_title"
                android:paddingHorizontal="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_oobe_tip_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="46dp"
                    android:minHeight="74dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_tip_quiet"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_wakeword_tip1"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:lineHeight="22sp"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_oobe_tip_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="74dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_tip_network"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_wakeword_tip2"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:lineHeight="22sp"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_oobe_tip_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="74dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="20dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_tip_speak"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/oobe_agreement_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/oobe_wakeword_tip3"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:lineHeight="22sp"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:layout_gravity="top"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Oobe.TitleBar"/>
    <com.stepos.widget.glass.StepOSGlassPanel
        android:layout_gravity="bottom"
        android:id="@+id/footer_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:steposGlassBlurUniform="true"
        app:steposGlassCornerRadius="0dp"
        app:steposGlassScope="inWindow"
        app:steposGlassScrim="@drawable/bg_agreement_footer_scrim"
        style="@style/StepOSWidget.GlassPanel">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/footer_content"
            android:paddingTop="36dp"
            android:paddingBottom="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="36dp">
            <com.stepos.widget.button.StepOSButton
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stepos_button_height"
                android:text="@string/oobe_continue"
                style="@style/Oobe.Button"/>
        </LinearLayout>
    </com.stepos.widget.glass.StepOSGlassPanel>
</FrameLayout>
