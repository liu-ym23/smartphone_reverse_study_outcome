<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/delete_confirm_root"
    android:background="@drawable/bg_delete_confirm_dialog"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="25dp"
    android:layout_marginHorizontal="12dp"
    android:paddingHorizontal="20dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/agent_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_delete_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/chat_delete_message_text"
        android:gravity="start"
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/chat_delete_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/chat_delete_cancel_text"
        android:gravity="center"
        android:id="@+id/btn_delete_cancel"
        android:background="@drawable/bg_btn_delete_cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/chat_btn_cancel"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_delete_confirm"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_message"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/chat_delete_confirm_text"
        android:gravity="center"
        android:id="@+id/btn_delete_confirm"
        android:background="@drawable/bg_btn_delete_confirm"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/chat_btn_delete"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_delete_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_delete_cancel"
        app:layout_constraintTop_toTopOf="@+id/btn_delete_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
