<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/agent_space_content"
        android:background="#060606"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stepos.ailauncher.chat.view.ChatView
                android:id="@+id/agentChatView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <View
            android:id="@+id/top_bar_fade_mask"
            android:background="@drawable/bg_top_bar_fade_mask"
            android:layout_width="match_parent"
            android:layout_height="124dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/content_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="150dp"
            android:layout_marginHorizontal="32dp">
            <com.stepos.agentsprite.view.AgentView
                android:id="@+id/agent"
                android:layout_width="312dp"
                android:layout_height="240dp"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_task_home_greet_text"
                android:textFontWeight="700"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ll_suggestions"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="16dp">
            <ImageView
                android:id="@+id/iv_menu"
                android:padding="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/bg_assistant_icon_left"/>
            <View
                android:id="@+id/iv_menu_right_spacer"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_top_bar_title"
                android:layout_weight="1"
                android:fontFamily="@font/fusion_pixel"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/title_dropdown_area"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="6dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/color_with_wallpaper_main"
                        android:id="@+id/tv_title_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistant_name"/>
                    <ImageView
                        android:id="@+id/iv_title_dropdown"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_dropdown_arrow"
                        android:layout_marginStart="4dp"
                        app:contentDescription="@null"
                        app:tint="?attr/color_with_wallpaper_main"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="?attr/color_with_wallpaper_main"
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/right_btn_group"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:paddingHorizontal="10dp">
                <ImageView
                    android:id="@+id/btn_new_session"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="24dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_chrome_new_chat"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:layout_marginEnd="13dp"/>
                <ImageView
                    android:id="@+id/iv_more"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_top_bar_more"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/content_recommend_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="160dp"
            android:layout_marginHorizontal="24dp">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/tv_recommend_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_recommend_greeting"
                android:lineSpacingExtra="4dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recommend_cards"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_marginTop="24dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/page_indicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="166dp">
            <View
                android:background="@drawable/bg_assistant_indicator_inactive"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"/>
            <View
                android:background="@drawable/bg_assistant_indicator_active"
                android:layout_width="10dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"/>
            <View
                android:background="@drawable/bg_assistant_indicator_inactive"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_container2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="12dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp">
                <TextView
                    android:id="@+id/tv_action_ai_clip"
                    android:text="@string/home_action_ai_clip"
                    style="@style/AssistantBottomAction"/>
                <TextView
                    android:id="@+id/tv_action_shoot_guide"
                    android:text="@string/home_action_shoot_guide"
                    style="@style/AssistantBottomAction"/>
                <TextView
                    android:id="@+id/tv_action_deep_research"
                    android:text="@string/home_action_deep_research"
                    style="@style/AssistantBottomAction"/>
                <TextView
                    android:id="@+id/tv_action_hot_topic"
                    android:text="@string/home_action_hot_topic"
                    style="@style/AssistantBottomAction"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/input_bar_placeholder"
                android:background="@drawable/bg_assistant_input_bar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ccffffff"
                    android:id="@+id/tv_input_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/input_hint_send_message_or_hold"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_keyboard"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_email"
                    android:layout_marginEnd="8dp"
                    app:tint="#ffffff"/>
                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="#ffffff"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/v_recording_touch_blocker_host"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <include
        android:layout_gravity="start"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        layout="@layout/layout_slide_panel"/>
</merge>
