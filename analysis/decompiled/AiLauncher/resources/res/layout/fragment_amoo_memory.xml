<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/amoo_memory_title"
            android:includeFontPadding="false"
            android:textFontWeight="580"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_session_close"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_memory_share"
                android:background="@drawable/bg_memory_share_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true">
                <ImageView
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_memory_share"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amoo_memory_share_title"
                        android:lineHeight="20sp"
                        android:textFontWeight="500"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#80ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/amoo_memory_share_subtitle"
                        android:lineHeight="16sp"/>
                </LinearLayout>
                <com.stepos.ailauncher.chat.widget.FigmaSwitch
                    android:id="@+id/switch_memory_share"
                    android:layout_width="40dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_agent_config_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToOutline="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_about_me"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:padding="4dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_memory_about_me"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/amoo_memory_about_me"
                            android:lineHeight="20sp"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#80ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/amoo_memory_about_me_subtitle"
                            android:lineHeight="16sp"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_repair_arrow_right"
                        android:contentDescription="@null"
                        android:layout_marginStart="20dp"/>
                </LinearLayout>
                <View
                    android:background="#0dffffff"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_communication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <ImageView
                        android:padding="4dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_memory_communication"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/amoo_memory_communication"
                            android:lineHeight="20sp"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#80ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/amoo_memory_communication_subtitle"
                            android:lineHeight="16sp"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_repair_arrow_right"
                        android:contentDescription="@null"
                        android:layout_marginStart="20dp"/>
                </LinearLayout>
                <View
                    android:background="#0dffffff"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_memo"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:padding="4dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_memory_memo"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/amoo_memory_memo"
                            android:lineHeight="20sp"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#80ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/amoo_memory_memo_subtitle"
                            android:lineHeight="16sp"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_repair_arrow_right"
                        android:contentDescription="@null"
                        android:layout_marginStart="20dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
