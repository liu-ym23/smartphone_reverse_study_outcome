<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_task_result_file_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_task_result_file_row"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_file_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:ellipsize="middle"
            android:id="@+id/tv_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:lineSpacingExtra="4sp"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:id="@+id/iv_file_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_taskstore_arrow_next_right"
            android:contentDescription="@null"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_file_preview"
        android:background="@drawable/bg_task_result_file_preview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/task_result_file_preview_height"
        android:layout_marginBottom="@dimen/task_result_file_preview_inset"
        android:layout_marginStart="@dimen/task_result_file_preview_inset"
        android:layout_marginEnd="@dimen/task_result_file_preview_inset"
        android:clipToOutline="true">
        <com.stepos.ailauncher.taskstore.widget.HalftoneShaderView
            android:id="@+id/shader_file_preview_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/iv_file_preview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
    </FrameLayout>
</LinearLayout>
