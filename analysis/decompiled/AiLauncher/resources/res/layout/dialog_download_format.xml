<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="46dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sheetPanel"
        android:background="@drawable/bg_bottom_sheet"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textSize="18sp"
                android:textColor="#e6ffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_detail_download_as"
                android:fontFamily="sans-serif-medium"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivClose"
                android:background="@drawable/bg_download_format_close"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_download_format_close"
                android:scaleType="fitCenter"
                android:contentDescription="@android:string/cancel"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/formatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="86dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#e6000000"
            android:gravity="center"
            android:id="@+id/btnDownload"
            android:background="@drawable/bg_download_format_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/task_detail_download"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
