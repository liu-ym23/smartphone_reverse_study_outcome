<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/test_zone_entry"
        layout="@layout/item_skill_test_zone"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/skill_root"
        android:background="@drawable/skill_card_compress_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_bar"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/skill_text_hint"
                    android:textColorHint="@color/skill_text_hint"
                    android:id="@+id/et_search"
                    android:background="@drawable/bg_search_input"
                    android:longClickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:hint="@string/skill_search_hint"
                    android:maxLines="1"
                    android:drawableLeft="@drawable/ic_search"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:hapticFeedbackEnabled="false"
                    android:imeOptions="actionSearch"
                    android:textIsSelectable="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="40dp"
                    android:drawableTint="@color/white"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/iv_clear_search"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_search_clear"
                    android:contentDescription="@string/skill_search_clear"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/iv_settings"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/mz_titlebar_ic_download"
                android:contentDescription="@string/skill_settings"/>
        </LinearLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_skills"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:splitMotionEvents="false"/>
                <FrameLayout
                    android:id="@+id/empty_slot"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/skill_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/installed_skill_empty_main"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/skill_text_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/installed_skill_empty_sub"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</LinearLayout>
