<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/bg_skill_detail_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="@dimen/ail_sheet_title_bar_total_height"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/hero_row"
                android:paddingTop="16dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <FrameLayout
                    android:id="@+id/icon_placeholder"
                    android:background="@drawable/bg_skill_detail_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="26sp"
                        android:textColor="@color/skill_icon_text"
                        android:gravity="center"
                        android:id="@+id/tv_skill_icon_char"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"/>
                    <ImageView
                        android:id="@+id/iv_skill_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/sd_hero_title"
                        android:ellipsize="end"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_author_row"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/sd_text_meta"
                            android:id="@+id/tv_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/sd_text_secondary"
                        android:id="@+id/tv_third_party_tag"
                        android:background="@drawable/bg_skill_detail_third_party_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/skill_detail_third_party_tag"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/action_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_update_banner"
                android:background="@drawable/bg_skill_detail_update_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sd_text_primary"
                    android:id="@+id/tv_update_banner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/sd_text_secondary"
                    android:id="@+id/tv_update_banner_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/sd_text_primary"
                    android:id="@+id/tv_update_banner_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/fl_description_wrap"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/sd_text_meta"
                    android:ellipsize="end"
                    android:id="@+id/tv_description"
                    android:paddingTop="0dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:lineHeight="19sp"
                    android:textFontWeight="400"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="end|bottom"
                    android:orientation="horizontal"
                    android:id="@+id/ll_description_toggle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="12dp">
                    <View
                        android:id="@+id/v_description_fade"
                        android:background="@drawable/bg_skill_detail_desc_fade"
                        android:layout_width="40dp"
                        android:layout_height="18dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/tv_description_toggle"
                        android:background="@color/sd_page_bg"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/skill_detail_desc_expand"
                        android:paddingHorizontal="4dp"/>
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/tv_readme_section_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/skill_detail_section_readme"
                android:paddingHorizontal="20dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_readme"
                android:background="@drawable/bg_skill_detail_card"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/sd_text_primary"
                    android:id="@+id/tv_readme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:paddingHorizontal="20dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/btn_readme_view_full"
                    android:background="@drawable/bg_skill_detail_view_full"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/skill_detail_view_full_readme"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_asset_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/skill_detail_section_assets"
                    android:paddingHorizontal="20dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_skill_detail_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingVertical="4dp">
                    <include
                        android:id="@+id/row_version"
                        layout="@layout/item_skill_detail_meta_row"/>
                    <View
                        android:background="@color/sd_card_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"/>
                    <include
                        android:id="@+id/row_category"
                        layout="@layout/item_skill_detail_meta_row"/>
                    <View
                        android:background="@color/sd_card_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"/>
                    <include
                        android:id="@+id/row_created"
                        layout="@layout/item_skill_detail_meta_row"/>
                    <View
                        android:background="@color/sd_card_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"/>
                    <include
                        android:id="@+id/row_updated"
                        layout="@layout/item_skill_detail_meta_row"/>
                    <View
                        android:background="@color/sd_card_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"/>
                    <include
                        android:id="@+id/row_download"
                        layout="@layout/item_skill_detail_meta_row"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/v_top_fade"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/bg_agent_detail_icon_btn"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_agent_detail_back"
            android:contentDescription="@null"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/btn_top_uninstall"
            android:background="@drawable/bg_agent_detail_icon_btn"
            android:visibility="gone"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_top_uninstall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_ellipsis_horizontal"
                android:contentDescription="@null"/>
            <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                android:layout_gravity="center"
                android:id="@+id/pb_top_uninstall"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_bottom_blur"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/footer_container"
        android:paddingTop="12dp"
        android:paddingBottom="46dp"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#1c1c1e"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_bottom_update"
            android:background="@drawable/bg_skill_detail_footer_button"
            android:layout_width="274dp"
            android:layout_height="46dp"
            android:textFontWeight="500"/>
        <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
            android:layout_gravity="center"
            android:id="@+id/pb_bottom_update"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
    </FrameLayout>
</FrameLayout>
