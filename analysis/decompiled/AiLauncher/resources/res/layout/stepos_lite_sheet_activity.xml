<?xml version="1.0" encoding="utf-8"?>
<com.stepos.widget.panel.StepOSLiteSheetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stepos_lite_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/stepos_lite_sheet_scrim"
        android:background="@color/stepos_lite_sheet_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <com.stepos.widget.panel.StepOSLiteSheetSurface
        android:id="@+id/stepos_lite_sheet_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/stepos_lite_sheet_grabber"
                android:paddingTop="@dimen/stepos_lite_sheet_grabber_padding"
                android:paddingBottom="@dimen/stepos_lite_sheet_grabber_bottom_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/stepos_lite_sheet_grabber"
                    android:layout_width="@dimen/stepos_lite_sheet_grabber_width"
                    android:layout_height="@dimen/stepos_lite_sheet_grabber_height"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <com.stepos.widget.toolbar.StepOSTitleBar
                android:id="@+id/stepos_lite_sheet_title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/StepOSWidget.TitleBar.Compact.Sheet"/>
            <FrameLayout
                android:id="@+id/stepos_lite_sheet_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="@dimen/stepos_lite_sheet_content_padding_horizontal"
                android:paddingEnd="@dimen/stepos_lite_sheet_content_padding_horizontal"/>
        </LinearLayout>
    </com.stepos.widget.panel.StepOSLiteSheetSurface>
</com.stepos.widget.panel.StepOSLiteSheetLayout>
