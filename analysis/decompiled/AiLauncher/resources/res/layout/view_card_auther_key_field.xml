<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/card_text_secondary"
        android:id="@+id/tvKeyFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llKeyFieldRow"
        android:background="@drawable/bg_card_auther_key_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">
        <EditText
            android:textSize="15sp"
            android:textColor="@color/card_text_primary"
            android:textColorHint="@color/card_text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/etKeyFieldValue"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:longClickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:cursorVisible="false"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:importantForAutofill="no"/>
        <ImageView
            android:id="@+id/ivKeyFieldEye"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_card_auther_eye_off"/>
    </LinearLayout>
</LinearLayout>
