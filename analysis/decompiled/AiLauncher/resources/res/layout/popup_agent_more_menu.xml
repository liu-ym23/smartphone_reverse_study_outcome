<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="166dp"
    android:elevation="4dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_menu_artifacts"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_artifact"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agent_menu_artifacts"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_menu_auto_read"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <ImageView
            android:id="@+id/iv_menu_auto_read"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/bg_assistant_icon_right"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agent_menu_auto_read"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</LinearLayout>
