<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storeRoot"
    android:background="@color/amoo_store_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/storeTopBar"
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <FrameLayout
            android:id="@+id/tabBar"
            android:background="@drawable/bg_amoo_store_tabbar"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/btnStoreClose"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="270dp">
            <View
                android:id="@+id/tabIndicator"
                android:background="@drawable/bg_amoo_store_tab_selected"
                android:layout_width="0dp"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tabOptions"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabSkill"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/amoo_store_tab_skill"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabAgent"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/amoo_store_tab_agent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabApp"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/amoo_store_tab_app"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/btnStoreClose"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_close"
            android:contentDescription="@string/common_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/agentContent"
            android:paddingTop="84dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="96dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/cellConnect"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:padding="4dp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_amoo_connect"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/amoo_store_connect_remote"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_amoo_chevron"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amoo_store_market_section"
                        android:textFontWeight="600"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardMarket"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMarket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/skillContent"
            android:paddingTop="84dp"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="124dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/headerMustHaves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amoo_store_skill_must_haves"
                        android:includeFontPadding="false"
                        android:textFontWeight="600"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_amoo_arrow_more"
                        android:contentDescription="@null"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardMustHaves"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_must_haves"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/headerCommunityWorks"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amoo_store_skill_community_works"
                        android:includeFontPadding="false"
                        android:textFontWeight="600"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_amoo_arrow_more"
                        android:contentDescription="@null"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardCommunityWorks"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_community_works"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/headerOtherSkills"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/amoo_store_skill_other"
                    android:includeFontPadding="false"
                    android:paddingStart="16dp"
                    android:textFontWeight="600"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardOtherSkills"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_other_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/appContent"
            android:paddingTop="84dp"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="96dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardAiApps"
                    android:background="@drawable/bg_amoo_entry_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:clipToOutline="true">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAiApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/emptyStateStore"
            android:paddingTop="84dp"
            android:paddingBottom="96dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="@drawable/bg_list_empty_icon"
                android:layout_width="60dp"
                android:layout_height="60dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_list_empty"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/list_page_empty"
                android:textFontWeight="600"/>
        </LinearLayout>
        <View
            android:layout_gravity="top"
            android:id="@+id/storeTopBlur"
            android:layout_width="match_parent"
            android:layout_height="76dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/storeBottomBlur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="108dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/skillBottomBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="40dp"
            android:translationZ="2dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/skillSearchContainer"
                android:background="@drawable/bg_amoo_search_field"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:paddingStart="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_amoo_search"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#66ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amoo_store_skill_search_hint"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp">
                <ImageView
                    android:id="@+id/btnInstalledSkills"
                    android:background="@drawable/bg_amoo_search_field"
                    android:padding="16dp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_amoo_archive"
                    android:contentDescription="@string/amoo_store_installed_skills"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/dotInstalledSkillsUnread"
                    android:background="@drawable/dot_amoo_store_unread_red"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/appBottomBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="40dp"
            android:translationZ="2dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/appSearchContainer"
                android:background="@drawable/bg_amoo_search_field"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:paddingStart="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_amoo_search"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#66ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amoo_store_app_search_hint"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btnInstalledApps"
                android:background="@drawable/bg_amoo_search_field"
                android:padding="16dp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_amoo_archive"
                android:contentDescription="@string/amoo_installed_apps_title"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/agentBottomBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="40dp"
            android:translationZ="2dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/agentSearchContainer"
                android:background="@drawable/bg_amoo_search_field"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:paddingStart="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_amoo_search"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#66ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amoo_store_agent_search_hint"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btnInstalledAgents"
                android:background="@drawable/bg_amoo_search_field"
                android:padding="16dp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_amoo_archive"
                android:contentDescription="@string/amoo_store_my_agent"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_store_search_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="3dp"/>
</FrameLayout>
