<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_tool_group_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/chat_tool_call_text"
            android:ellipsize="end"
            android:id="@+id/tv_tool_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="272dp"
            android:text="@string/chat_loading_thinking"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_tool_separator"
            android:id="@+id/tv_tool_group_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/chat_tool_call_text"
            android:ellipsize="end"
            android:id="@+id/tv_tool_group_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="272dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textFontWeight="400"/>
        <ImageView
            android:id="@+id/iv_tool_group_expand"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_tool_group_chevron"
            android:tint="@color/chat_tool_call_text"
            android:layout_marginStart="6dp"
            android:tintMode="src_in"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_tool_group_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_tool_group_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
