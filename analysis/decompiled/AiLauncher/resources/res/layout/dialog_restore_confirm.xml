<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_overlay"
    android:background="#33000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ll_card"
        android:background="@drawable/bg_dialog_rounded"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="24dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="#ffeeeeee"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/repair_restore_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#73ebebf5"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/repair_restore_message"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="#ff1564ed"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/repair_dialog_cancel"
                android:layout_weight="1"/>
            <View
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#ffe7000c"
                android:gravity="center"
                android:id="@+id/btn_confirm"
                android:background="@drawable/bg_btn_dialog_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/repair_dialog_confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
