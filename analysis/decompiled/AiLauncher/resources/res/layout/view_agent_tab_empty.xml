<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="4dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_agent_cards_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/card_step_agent"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">
            <ImageView
                android:background="@drawable/bg_agent_icon_circle"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_agent_step_face"
                android:contentDescription="@null"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#f5ede6"
                    android:id="@+id/tv_step_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_tab_card_step_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:id="@+id/tv_step_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/agent_tab_card_step_desc"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <View
            android:background="@drawable/divider_agent_card"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/card_other_agent"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">
            <ImageView
                android:background="@drawable/bg_agent_icon_circle"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_agent_other"
                android:contentDescription="@null"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#f5ede6"
                    android:id="@+id/tv_other_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_tab_card_other_title"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99ffffff"
                    android:id="@+id/tv_other_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/agent_tab_card_other_desc"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
