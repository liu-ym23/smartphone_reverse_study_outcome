<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vChatBottomBg"
        android:background="@drawable/bg_chat_bottom_main"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="392:150"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.stepos.ailauncher.chat.view.LauncherChatLayout
                android:id="@+id/aclChat"
                android:paddingBottom="33dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:btnToBottomBackground="@drawable/bg_btn_to_bottom"
                app:btnToBottomHeight="40dp"
                app:btnToBottomMargin="12dp"
                app:btnToBottomScaleType="centerInside"
                app:btnToBottomSrc="@drawable/ic_btn_to_bottom"
                app:btnToBottomWidth="40dp"
                app:defaultInputLayoutEnable="false"
                app:defaultToolBarLayoutEnable="false"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/bottom_fade_mask"
                android:background="@drawable/bg_chat_bottom_fade_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:translationY="30dp"/>
            <FrameLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/btn_apps"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:stateListAnimator="@animator/anim_press_scale">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btn_apps_pill"
                    android:layout_width="60dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_home_space_empty_apps"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#99ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_space_apps"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/chat_input_slot"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.stepos.ailauncher.chat.view.MainInputView
                android:id="@+id/iVInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:id="@+id/chat_ai_key_waiting_bar"
                android:background="@drawable/bg_float_input_box"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="12dp"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:id="@+id/chat_ai_key_waiting_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chat_agent"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:ellipsize="end"
                    android:id="@+id/chat_ai_key_waiting_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/wake_asr_finalizing"
                    android:maxLines="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/chat_ai_key_waiting_stop"
                    app:layout_constraintStart_toEndOf="@+id/chat_ai_key_waiting_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/chat_ai_key_waiting_stop"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_stop_reply"
                    android:contentDescription="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="#73ebebf5"
            android:layout_gravity="center"
            android:id="@+id/ai_declare"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:text="@string/chat_ai_generated_content"/>
    </LinearLayout>
    <View
        android:id="@+id/v_speech_bg"
        android:background="@drawable/bg_speech_window"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="392:180"/>
</androidx.constraintlayout.widget.ConstraintLayout>
