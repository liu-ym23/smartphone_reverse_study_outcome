<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/task_detail_page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/contentHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp">
        <ViewStub
            android:id="@+id/stubResultContent"
            android:layout="@layout/stub_task_detail_result"
            android:inflatedId="@+id/resultContentRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/topScrim"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="108dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottomScrim"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="108dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/rl_top"
        android:paddingTop="@dimen/artifact_detail_topbar_padding_top"
        android:paddingBottom="@dimen/artifact_detail_topbar_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:minHeight="44dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_left_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/version_btn_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_btn_group"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivPartPrev"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_part_prev"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_part_prev"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:id="@+id/ivPartNext"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_part_next"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_part_next"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/action_btn_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivFullscreen"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_fullscreen"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_fullscreen"/>
            <ImageView
                android:id="@+id/ivMore"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_top_bar_more"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_more"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/ivDownload"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_task_detail_download"
                android:scaleType="fitCenter"
                android:contentDescription="@string/task_detail_download"
                android:layout_marginStart="16dp"
                app:tint="@color/white"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/sheetScrim"
        android:background="#000000"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/chatPanel"
        android:background="@drawable/bg_task_chat_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:elevation="8dp"
        android:clipToOutline="true">
        <FrameLayout
            android:id="@+id/drawerHandleArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/bg_taskdetail_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"/>
        </FrameLayout>
        <com.stepos.ailauncher.chat.view.LauncherChatLayout
            android:id="@+id/taskChatLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:btnToBottomBackground="@drawable/bg_btn_to_bottom"
            app:btnToBottomHeight="40dp"
            app:btnToBottomMargin="12dp"
            app:btnToBottomScaleType="centerInside"
            app:btnToBottomSrc="@drawable/ic_btn_to_bottom"
            app:btnToBottomWidth="40dp"
            app:defaultInputLayoutEnable="false"
            app:defaultToolBarLayoutEnable="false"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_speech_bg"
        android:background="@drawable/bg_speech_window"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="147dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="9dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/ll_current_status"
            android:background="@drawable/bg_task_status_pill"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/chip_lottie"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_diffuse_anim"/>
            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chip_done"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_current_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                style="@style/TaskDetailCurrentStatus"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_floatcard_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp">
            <com.stepos.ailauncher.task.chat.TaskInputView
                android:id="@+id/input_view_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
