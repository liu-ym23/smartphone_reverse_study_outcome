<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_shell_translucent"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivBrandIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_alipy_ab"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支付宝阿宝"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp">
        <ImageView
            android:id="@+id/ivServiceIcon"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvServiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:id="@+id/btnView"
            android:background="@drawable/bg_card_cta_white_pill"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="查看"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="9dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
