<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_sources_panel"
    android:layout_width="match_parent"
    android:layout_height="424dp"
    android:elevation="8dp">
    <FrameLayout
        android:id="@+id/fl_sources_panel_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/tv_sources_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="231dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_sources_panel_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_source_close"
            android:scaleType="fitCenter"
            android:contentDescription="关闭"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sources_list"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"/>
</LinearLayout>
