<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_taskstore_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingHorizontal="@dimen/taskstore_card_padding"
    android:paddingVertical="12dp">
    <FrameLayout
        android:id="@+id/taskstoreSmallIconWrap"
        android:background="@drawable/bg_taskstore_icon_circle"
        android:layout_width="@dimen/taskstore_card_icon_size"
        android:layout_height="@dimen/taskstore_card_icon_size">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/taskstoreSmallIcon"
            android:layout_width="@dimen/taskstore_card_icon_inner"
            android:layout_height="@dimen/taskstore_card_icon_inner"
            android:src="@drawable/ic_taskstore_card_default"
            android:contentDescription="@null"
            app:tint="@color/taskstore_card_icon_tint"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="@dimen/taskstore_card_title_size"
            android:textStyle="bold"
            android:textColor="@color/taskstore_card_title"
            android:ellipsize="end"
            android:id="@+id/taskstoreSmallTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/taskstore_card_subtitle_size"
            android:textColor="@color/taskstore_card_status_normal"
            android:ellipsize="end"
            android:id="@+id/taskstoreSmallSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
