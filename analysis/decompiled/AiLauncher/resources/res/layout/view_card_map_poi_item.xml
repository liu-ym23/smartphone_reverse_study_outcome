<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingVertical="8dp">
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/card_text_primary"
        android:gravity="center"
        android:id="@+id/tvPoiMarker"
        android:background="@drawable/bg_card_map_waypoint_dot"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvPoiItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvPoiItemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivPoiItemChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_card_map_chevron_right"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="8dp"/>
</LinearLayout>
