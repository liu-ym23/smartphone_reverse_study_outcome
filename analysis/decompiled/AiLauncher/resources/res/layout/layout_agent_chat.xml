<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/agent_tool_bar"
        android:layout="@layout/view_stub_toolbar"
        android:inflatedId="@+id/agent_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/content_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/agent_tool_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:id="@+id/chat_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.stepos.agentframework.chatui.view.ChatRecycleView
                    android:id="@+id/chat_list"
                    android:paddingTop="14dp"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="12dp"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:requiresFadingEdge="vertical"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/empty_show"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/chat_list_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/chat_list_container"/>
            <ImageView
                android:id="@+id/btn_to_bottom"
                android:background="@drawable/bg_white_oval"
                android:visibility="invisible"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="16dp"
                android:src="@drawable/ic_scroll_to_bottom"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@+id/chat_list_container"
                app:layout_constraintEnd_toEndOf="@+id/chat_list_container"
                app:layout_constraintStart_toStartOf="parent"
                app:useCompatPadding="false"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ViewStub
            android:id="@+id/local_view_host_layout"
            android:layout="@layout/local_view_stub_app_ui_host"
            android:inflatedId="@+id/local_view_host_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/remote_view_host_layout"
            android:layout="@layout/remote_view_stub_app_ui_host"
            android:inflatedId="@+id/remote_view_host_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/input_layout"
            android:layout="@layout/view_stub_input"
            android:inflatedId="@+id/input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
