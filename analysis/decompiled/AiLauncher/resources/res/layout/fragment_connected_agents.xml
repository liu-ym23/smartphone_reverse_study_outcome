<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sd_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@drawable/bg_agent_detail_icon_btn"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_agent_detail_back"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:text="@string/connected_agents_title"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:textFontWeight="580"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_container"
        android:paddingTop="@dimen/ail_sheet_title_bar_total_height"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/top_chrome_blur"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/btn_add_agent"
        android:background="@drawable/bg_add_agent_pill"
        android:visibility="gone"
        android:layout_width="274dp"
        android:layout_height="46dp"
        android:layout_marginBottom="52dp"
        android:translationZ="2dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_white"
            android:tint="#e6ffffff"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_agent_add_agent"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</FrameLayout>
