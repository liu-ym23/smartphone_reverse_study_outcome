<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <include
        android:id="@+id/layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/stepos_action_bar_search_layout_height"
        android:layout_marginLeft="@dimen/mc_search_layout_padding_left"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/mc_search_layout_padding_left"
        layout="@layout/mc_search_layout"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mc_tv_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="?android:attr/actionMenuTextAppearance"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            android:id="@+id/mc_cancel_textView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@android:string/cancel"
            style="?attr/steposSearchButtonStyle"/>
    </LinearLayout>
</LinearLayout>
