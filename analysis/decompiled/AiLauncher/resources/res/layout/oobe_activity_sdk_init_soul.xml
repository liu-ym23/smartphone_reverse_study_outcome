<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oobe_dark_bg"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/option_scroll"
        android:paddingTop="@dimen/stepos_titlebar_collapsed_height"
        android:paddingBottom="118dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="32sp"
                android:textColor="@color/oobe_agreement_text_primary"
                android:gravity="center"
                android:id="@+id/tv_question"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oobe_sdk_init_soul_question"
                android:paddingHorizontal="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/option_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp">
                <FrameLayout
                    android:id="@+id/create_block"
                    android:layout_width="match_parent"
                    android:layout_height="52dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/btn_create"
                        android:background="@drawable/bg_oobe_soul_create"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/oobe_step_text"
                            android:id="@+id/tv_create"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/oobe_soul_create"
                            android:lineHeight="22sp"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_oobe_quill"
                            android:contentDescription="@null"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/custom_edit_row"
                        android:background="@drawable/bg_oobe_name_input"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp">
                        <EditText
                            android:textSize="15sp"
                            android:textColor="@color/oobe_agreement_text_primary"
                            android:textColorHint="@color/oobe_soul_input_hint"
                            android:gravity="center_vertical"
                            android:id="@+id/et_custom"
                            android:background="@null"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:hint="@string/oobe_soul_custom_hint"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:textCursorDrawable="@drawable/oobe_name_system_cursor"
                            android:paddingEnd="8dp"
                            android:importantForAutofill="no"
                            android:lineHeight="22sp"/>
                        <ImageButton
                            android:id="@+id/btn_custom_submit"
                            android:background="@null"
                            android:padding="0dp"
                            android:visibility="gone"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_oobe_soul_submit"
                            android:scaleType="fitXY"
                            android:minWidth="36dp"
                            android:minHeight="36dp"
                            android:contentDescription="@string/oobe_next"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/custom_option_row"
                        android:background="@drawable/bg_oobe_soul_option"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="20dp"
                        android:paddingEnd="16dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/oobe_agreement_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_custom_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:lineHeight="22sp"/>
                            <ImageView
                                android:id="@+id/iv_custom_quill"
                                android:padding="8dp"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_oobe_quill_on"
                                android:contentDescription="@string/oobe_soul_edit"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/iv_custom_check"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_oobe_soul_checked"
                            android:contentDescription="@null"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:background="@color/oobe_dark_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:steposBackdropBlurEnabled="true"
        app:steposBackdropScrimColor="@color/oobe_dark_bg"
        app:steposTitle="@string/oobe_sdk_init_soul_step"
        app:steposTitleTextColor="@color/oobe_step_text"
        style="@style/Oobe.TitleBar.Text"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_compact_title"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/stepos_titlebar_collapsed_height"
        android:text="@string/oobe_sdk_init_soul_question"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="76dp"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="@+id/title_bar"
        app:layout_constraintStart_toStartOf="@+id/title_bar"
        app:layout_constraintTop_toTopOf="@+id/title_bar"/>
    <ImageButton
        android:id="@+id/btn_next"
        android:background="@drawable/bg_oobe_next_circle"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/oobe_name_next_margin_idle"
        android:src="@drawable/ic_oobe_next_chevron"
        android:scaleType="center"
        android:contentDescription="@string/oobe_next"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
