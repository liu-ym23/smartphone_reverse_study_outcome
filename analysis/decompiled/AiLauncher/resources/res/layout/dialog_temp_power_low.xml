<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/temp_power_low_scrim"
    android:background="#99000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/temp_power_low_card"
        android:background="@drawable/bg_temp_power_low_card"
        android:paddingTop="38dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#eeeeee"
            android:gravity="center"
            android:id="@+id/temp_power_low_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#73ebebf5"
            android:gravity="center"
            android:id="@+id/temp_power_low_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1564ed"
            android:gravity="center"
            android:id="@+id/temp_power_low_confirm"
            android:background="@drawable/bg_temp_power_low_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="38dp"
            android:text="@string/oobe_configuring_got_it"/>
    </LinearLayout>
</FrameLayout>
