<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stepos_password_pad_display"
        android:paddingBottom="@dimen/stepos_password_display_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Subtitle.L"
            android:textColor="@color/stepos_password_tip"
            android:gravity="center"
            android:id="@+id/stepos_password_pad_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.Body.M"
            android:textColor="@color/stepos_password_tip2"
            android:gravity="center"
            android:id="@+id/stepos_password_pad_tip2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stepos_password_tip2_margin_top"
            android:includeFontPadding="false"/>
        <RelativeLayout
            android:id="@+id/stepos_password_pad_dots_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stepos_password_dots_margin_top"
            android:minHeight="@dimen/stepos_password_action_size">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/stepos_password_pad_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/stepos_password_pad_input_button"
                android:padding="@dimen/stepos_password_action_padding"
                android:visibility="gone"
                android:layout_width="@dimen/stepos_password_action_size"
                android:layout_height="@dimen/stepos_password_action_size"
                android:foreground="@drawable/stepos_ripple_password_action"
                android:src="@drawable/stepos_icon_close"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:contentDescription="@string/stepos_password_key_delete_content_description"
                android:layout_marginStart="@dimen/stepos_password_action_margin_start"
                android:layout_toEndOf="@+id/stepos_password_pad_dots"/>
        </RelativeLayout>
    </LinearLayout>
    <EditText
        android:textAppearance="@style/StepOSTextAppearance.Subtitle.M"
        android:textColor="@color/stepos_password_edit_text"
        android:gravity="center"
        android:id="@+id/stepos_password_pad_edit"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stepos_password_edit_margin_top"
        android:hint="@string/stepos_password_edit_hint"
        android:singleLine="true"
        android:inputType="textPassword"
        android:layout_marginStart="@dimen/stepos_password_edit_margin_horizontal"
        android:layout_marginEnd="@dimen/stepos_password_edit_margin_horizontal"
        android:importantForAutofill="no"/>
    <GridLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/stepos_password_pad_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="true">
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="1"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="2"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="3"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="4"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="5"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="6"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="7"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="8"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="9"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:id="@+id/stepos_password_pad_key_left"
            android:visibility="invisible"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:text="0"
            style="@style/StepOSWidget.CircleButton.Centered"/>
        <com.stepos.widget.circlebutton.StepOSCircleButton
            android:layout_gravity="center_vertical"
            android:id="@+id/stepos_password_pad_key_right"
            android:visibility="invisible"
            style="@style/StepOSWidget.CircleButton.Centered"/>
    </GridLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/stepos_password_pad_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stepos_password_bottom_margin_top"/>
</merge>
