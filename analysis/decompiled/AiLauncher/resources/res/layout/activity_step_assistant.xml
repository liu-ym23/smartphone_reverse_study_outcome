<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/chat_color_surface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/settingsScroll"
        android:paddingTop="@dimen/stepos_titlebar_collapsed_height"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_voice_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:divider="@drawable/divider_setting_list"
                android:showDividers="middle"
                android:dividerPadding="14dp"
                android:clipToOutline="true">
                <include
                    android:id="@+id/itemMainSwitch"
                    layout="@layout/item_voice_setting_switch"/>
                <include
                    android:id="@+id/itemAmooSpace"
                    layout="@layout/item_voice_setting_switch"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="24dp"
                    android:text="@string/step_assistant_section_voice"
                    android:layout_marginStart="16dp"
                    android:lineHeight="20sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemVoiceWakeup"
                        layout="@layout/item_voice_setting_arrow"/>
                    <include
                        android:id="@+id/itemNavigationKey"
                        layout="@layout/item_voice_setting_switch"/>
                    <include
                        android:id="@+id/itemHeadsetKey"
                        layout="@layout/item_voice_setting_switch"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="24dp"
                    android:text="@string/step_assistant_section_express"
                    android:layout_marginStart="16dp"
                    android:lineHeight="20sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemAmooExpress"
                        layout="@layout/item_voice_setting_switch"/>
                    <include
                        android:id="@+id/itemAmooExpressSupportedApps"
                        layout="@layout/item_voice_setting_arrow"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemSound"
                        layout="@layout/item_voice_setting_arrow"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="24dp"
                    android:text="@string/step_assistant_section_safety"
                    android:layout_marginStart="16dp"
                    android:lineHeight="20sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemAiSafety"
                        layout="@layout/item_voice_setting_arrow"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="24dp"
                    android:text="@string/step_assistant_section_privacy"
                    android:layout_marginStart="16dp"
                    android:lineHeight="20sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemPrivacySetting"
                        layout="@layout/item_voice_setting_arrow"/>
                    <include
                        android:id="@+id/itemPersonalInfoList"
                        layout="@layout/item_voice_setting_arrow"/>
                    <include
                        android:id="@+id/itemThirdPartyShare"
                        layout="@layout/item_voice_setting_arrow"/>
                    <include
                        android:id="@+id/itemImproveAssistant"
                        layout="@layout/item_voice_setting_switch"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="24dp"
                    android:text="@string/step_assistant_section_other"
                    android:layout_marginStart="16dp"
                    android:lineHeight="20sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_voice_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_setting_list"
                    android:showDividers="middle"
                    android:dividerPadding="14dp"
                    android:clipToOutline="true">
                    <include
                        android:id="@+id/itemCheckUpdate"
                        layout="@layout/item_voice_setting_arrow"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/chat_color_setting_summary"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tvFooterIcp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/step_assistant_icp"
                    android:drawablePadding="4dp"
                    android:drawableEnd="@drawable/ic_arrow_right_gray"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_setting_top_bar"/>
</FrameLayout>
