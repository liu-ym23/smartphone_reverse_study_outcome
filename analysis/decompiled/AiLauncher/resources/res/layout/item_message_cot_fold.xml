<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_cot_fold_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_tool_text"
            android:id="@+id/tv_cot_fold_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_cot_completed"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
        <ImageView
            android:id="@+id/iv_cot_fold_expand"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_cot_fold_chevron"
            android:tint="@color/chat_tool_text"
            android:layout_marginStart="6dp"
            android:tintMode="src_in"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_cot_fold_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingVertical="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_cot_fold_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
