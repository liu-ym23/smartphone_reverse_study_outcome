<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="45dp"
        android:contentDescription="@null"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stepos.agentsprite.view.AgentView
            android:id="@+id/agent"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ccffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fusion_pixel"
            android:layout_marginStart="2dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ccffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/bubble_weather"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fusion_pixel"
            android:layout_marginStart="2dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bubble_weather_open"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#1564ed"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_space_weather_privacy_hint"
                android:fontFamily="@font/fusion_pixel"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/tv_task_expand"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:minHeight="36dp"
        android:layout_marginStart="20dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_mascot"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/img_mascot_connecting"
        android:contentDescription="@null"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_date"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff1a1a1a"
            android:gravity="center"
            android:id="@+id/tv_week_day"
            android:background="@drawable/bg_home_space_day_circle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_date"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="#66ffffff"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_week_day"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ff8a8a8a"
            android:id="@+id/tv_year"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_date"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="34sp"
        android:textStyle="normal"
        android:textColor="#ff474747"
        android:id="@+id/tv_greeting_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/home_space_greeting_title"
        android:fontWeight="400"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_mascot"/>
    <TextView
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#ff141414"
        android:id="@+id/tv_greeting_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/home_space_greeting_subtitle"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_greeting_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_task_cards_collapsed"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        android:elevation="6dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_date"/>
    <include
        android:id="@+id/layout_home_space_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_space_card_height_empty"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_date"
        layout="@layout/view_home_space_empty"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_layout_input"
        android:paddingBottom="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.stepos.ailauncher.chat.view.HomeInputView
            android:id="@+id/layout_input_bar_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_input_thinking_bar"
            android:background="@drawable/bg_float_input_box"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="12dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_input_bar_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/home_input_thinking_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_chat_agent"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/home_input_thinking_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wake_asr_finalizing"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/home_input_thinking_stop"
                app:layout_constraintStart_toEndOf="@+id/home_input_thinking_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/home_input_thinking_stop"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_stop_reply"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/btn_apps"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:layout_marginBottom="7dp"
        android:stateListAnimator="@animator/anim_press_scale"
        app:layout_constraintBottom_toTopOf="@+id/con_layout_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_apps_pill"
            android:background="@drawable/bg_home_space_empty_apps_button"
            android:layout_width="60dp"
            android:layout_height="28dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_home_space_empty_apps"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_space_empty_apps"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
