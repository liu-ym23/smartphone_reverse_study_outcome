<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_toolbar_back_arrow_light"
        app:title="@string/voice_setting_title"
        app:titleTextColor="#1f1f1f"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/groupWakeup"
                android:background="@drawable/bg_voice_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToOutline="true">
                <include
                    android:id="@+id/itemVoiceWakeup"
                    layout="@layout/item_voice_setting_arrow"/>
                <View
                    android:background="#14000000"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <include
                    android:id="@+id/itemNavigationKey"
                    layout="@layout/item_voice_setting_switch"/>
                <View
                    android:background="#14000000"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <include
                    android:id="@+id/itemHeadsetKey"
                    layout="@layout/item_voice_setting_switch"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/groupFeedback"
                android:background="@drawable/bg_voice_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToOutline="true">
                <include
                    android:id="@+id/itemSound"
                    layout="@layout/item_voice_setting_arrow"/>
                <View
                    android:background="#14000000"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <include
                    android:id="@+id/itemVolume"
                    layout="@layout/item_voice_setting_volume"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/groupAssistant"
                android:background="@drawable/bg_voice_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToOutline="true">
                <include
                    android:id="@+id/itemCallAssistant"
                    layout="@layout/item_voice_setting_arrow"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
