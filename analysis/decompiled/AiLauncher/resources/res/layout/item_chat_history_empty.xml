<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_chat_history_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.agentsprite.view.AgentView
        android:id="@+id/agent_empty_sprite"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="70dp"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="70dp"
        android:src="@mipmap/iv_session_list_empty"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_history_empty_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/chat_history_empty_subtitle"/>
</LinearLayout>
