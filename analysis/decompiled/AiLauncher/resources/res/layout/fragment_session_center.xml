<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_session_center_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stepos.ailauncher.chat.view.ViewportFadeRecyclerView
            android:id="@+id/rv_session_center"
            android:paddingTop="80dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llTopContainer"
        android:paddingTop="@dimen/ail_sheet_pager_page_top_inset"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_session_center_store"
            android:background="@drawable/bg_chrome_action_pill"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="131dp"
            android:paddingHorizontal="10dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_session_amoo_store_2"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/session_center_on_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_center_store"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
            <ImageView
                android:id="@+id/iv_session_center_store_badge"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="center"
                android:contentDescription="@null"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/btn_session_center_settings"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_session_setting"
            android:contentDescription="@string/session_center_settings"/>
        <ImageView
            android:id="@+id/btn_session_center_close"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_session_close"
            android:tint="@color/session_center_on_glass"
            android:contentDescription="@string/session_center_close"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llBottomContainer"
        android:paddingTop="6dp"
        android:paddingBottom="@dimen/chat_session_bottom_bar_padding"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_session_center_search"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat_history_search"
                android:tint="@color/session_center_on_glass_secondary"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/session_center_on_glass_secondary"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/session_center_search_hint"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btn_session_center_new_chat"
            android:background="@drawable/bg_new_session_circle"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_session_chat_new"
            android:scaleType="fitCenter"
            android:contentDescription="@string/session_center_new_chat"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_session_center_search_host"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
