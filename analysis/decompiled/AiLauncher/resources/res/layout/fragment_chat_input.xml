<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recommend_chips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_recommend_1"
            android:background="@drawable/bg_recommend_chip"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_recommend_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_recommend_schedule"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_recommend_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_chip_schedule"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_recommend_2"
            android:background="@drawable/bg_recommend_chip"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_recommend_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_recommend_bills"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_recommend_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_chip_bills"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_recommend_3"
            android:background="@drawable/bg_recommend_chip"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_recommend_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_recommend_trips"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_recommend_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_chip_trips"
                android:maxLines="2"
                android:fontFamily="sans-serif-light-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/circle_select_chip_host"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <FrameLayout
        android:id="@+id/chat_input_slot"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stepos.ailauncher.chat.view.FloatInputView
            android:id="@+id/chat_input_view"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_gravity="bottom"
            android:id="@+id/chat_input_waiting_bar"
            android:background="@drawable/bg_float_input_box"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="12dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/chat_input_waiting_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chat_agent"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/chat_input_waiting_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wake_asr_finalizing"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/chat_input_waiting_stop"
                app:layout_constraintStart_toEndOf="@+id/chat_input_waiting_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/chat_input_waiting_stop"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_stop_reply"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</LinearLayout>
