<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homebarGuideRoot"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/homebarGuideHostBlur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="282dp"
        android:minHeight="540dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/homebarGuideScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="282dp"
        android:minHeight="540dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homebarGuideGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_ignoreDisabledSystemAnimations="true"
        app:lottie_loop="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/homebarGuideCapsule"
        android:background="@drawable/bg_homebar_longpress_capsule"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/homebar_longpress_guide_tip"
        android:alpha="0"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/homebarGuideThinking"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_amoo_thinking"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e6ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homebar_longpress_guide_tip"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/homebarGuideIllustration"
        android:layout_width="210dp"
        android:layout_height="260dp"
        android:layout_marginTop="468dp"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_ignoreDisabledSystemAnimations="true"
        app:lottie_loop="true"
        app:lottie_repeatMode="restart"/>
    <ImageView
        android:id="@+id/homebarGuideStill"
        android:layout_width="210dp"
        android:layout_height="260dp"
        android:layout_marginTop="468dp"
        android:src="@drawable/homebar_guide_still"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:elevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/homebarGuideTapExit"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@+id/homebarGuideIllustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
