<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <ImageView
        android:id="@+id/agent_logo"
        android:visibility="invisible"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/agent_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/agent_text_primary"
        android:ellipsize="end"
        android:id="@+id/agent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="160dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_newchat"
        android:padding="8dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_chat_new_session"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/agent_icon_primary"/>
    <ImageView
        android:id="@+id/iv_audio_call"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_audio_call"
        app:layout_constraintBottom_toBottomOf="@+id/iv_newchat"
        app:layout_constraintEnd_toStartOf="@+id/iv_newchat"
        app:layout_constraintTop_toTopOf="@+id/iv_newchat"/>
    <ImageView
        android:id="@+id/tts_sound"
        android:padding="8dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_sound_play"
        app:layout_constraintBottom_toBottomOf="@+id/iv_newchat"
        app:layout_constraintEnd_toStartOf="@+id/iv_audio_call"
        app:layout_constraintTop_toTopOf="@+id/iv_newchat"
        app:tint="@color/agent_icon_primary"/>
    <ImageView
        android:id="@+id/iv_clear_context"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_clear_context"
        app:layout_constraintBottom_toBottomOf="@+id/iv_newchat"
        app:layout_constraintEnd_toStartOf="@+id/tts_sound"
        app:layout_constraintTop_toTopOf="@+id/iv_newchat"/>
    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_chat_menu"
        android:paddingEnd="5dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/agent_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/agent_title"
        app:tint="@color/agent_icon_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
