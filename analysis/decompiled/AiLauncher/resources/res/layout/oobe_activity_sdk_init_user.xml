<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oobe_dark_bg"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:steposTitle="@string/oobe_sdk_init_user_step"
        app:steposTitleTextColor="@color/oobe_step_text"
        style="@style/Oobe.TitleBar.Text"/>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/oobe_agreement_text_primary"
        android:gravity="center"
        android:id="@+id/tv_question"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/oobe_sdk_init_user_question"
        android:paddingHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <FrameLayout
        android:id="@+id/input_block"
        android:layout_width="0dp"
        android:layout_height="@dimen/oobe_user_input_block_height"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_question">
        <EditText
            android:textSize="15sp"
            android:textColor="@color/oobe_agreement_text_primary"
            android:gravity="center"
            android:id="@+id/et_user"
            android:background="@drawable/bg_oobe_name_input"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/oobe_user_input_max_height"
            android:minHeight="@dimen/oobe_user_input_min_height"
            android:maxLines="3"
            android:scrollHorizontally="false"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls"
            android:textCursorDrawable="@drawable/oobe_name_system_cursor"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:importantForAutofill="no"
            android:lineHeight="22sp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/oobe_step_text"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="22dp"/>
    </FrameLayout>
    <ImageButton
        android:id="@+id/btn_next"
        android:background="@drawable/bg_oobe_next_circle"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/oobe_name_next_margin_idle"
        android:src="@drawable/ic_oobe_next_chevron"
        android:scaleType="center"
        android:contentDescription="@string/oobe_next"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
