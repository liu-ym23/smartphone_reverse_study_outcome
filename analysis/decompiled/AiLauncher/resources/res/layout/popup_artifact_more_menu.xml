<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="166dp"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_menu_preview"
        android:layout_width="126dp"
        android:layout_height="42dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/task_detail_menu_preview"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_menu_preview_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_voice_selected_check"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            app:tint="#eeeeee"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_menu_code"
        android:layout_width="126dp"
        android:layout_height="42dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/task_detail_menu_code"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_menu_code_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_voice_selected_check"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            app:tint="#eeeeee"/>
    </LinearLayout>
    <View
        android:background="#1affffff"
        android:layout_width="124dp"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_menu_download"
        android:layout_width="126dp"
        android:layout_height="42dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/task_detail_download"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_task_detail_download"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            app:tint="#eeeeee"/>
    </LinearLayout>
</LinearLayout>
