<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/three_tile_greeting"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif-ultralight"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_suggestions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_suggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="89dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/con_layout_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_1"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_schedule"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_schedule"
                android:maxLines="2"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_2"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_bills"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_bills"
                android:maxLines="2"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip_suggest_3"
            android:background="@drawable/bg_three_tile_suggest_chip"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_suggest_trips"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d9ffffff"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_tile_suggest_trips"
                android:maxLines="2"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_all_tasks"
        android:background="@drawable/bg_three_tile_all_tasks"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginBottom="94dp"
        android:minWidth="55dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="#b3ffffff"
            android:id="@+id/tv_all_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/three_tile_all_tasks"
            android:includeFontPadding="false"
            android:layout_marginEnd="-1dp"/>
        <ImageView
            android:id="@+id/iv_all_tasks_chevron"
            android:layout_width="10dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_all_tasks_chevron_up"
            android:scaleType="center"
            android:contentDescription="@null"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/con_layout_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_float_input_box"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"
            android:layout_marginHorizontal="20dp">
            <ImageView
                android:background="@drawable/bg_input_icon_circle"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_voice_start"
                android:scaleType="fitCenter"
                android:tint="@color/chat_color_on_surface"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/chat_color_on_surface_variant"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/input_hint_send_or_hold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textFontWeight="340"/>
            <ImageView
                android:background="@drawable/bg_input_icon_circle"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_chat_more"
                android:scaleType="fitCenter"
                android:tint="@color/chat_color_on_surface"
                android:contentDescription="@null"
                android:layout_marginEnd="5dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
