<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/task_space_page_padding_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/task_space_page_padding_horizontal"
        android:paddingEnd="@dimen/task_space_page_padding_horizontal">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/task_space_title_bar_height">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/taskTitleBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/task_space_page_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/task_space_title"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/task_space_page_text_secondary"
                    android:gravity="center"
                    android:id="@+id/taskSweepTextLabEntry"
                    android:background="@drawable/bg_taskspace_empty_chip"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="52dp"
                    android:text="@string/task_sweep_text_lab_entry"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="6dp"/>
                <ImageButton
                    android:id="@+id/taskBlurLabEntry"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_task_debug_bug"
                    android:contentDescription="@string/task_space_blur_lab_entry"
                    android:layout_marginEnd="6dp"/>
                <ImageButton
                    android:id="@+id/taskDebugEntry"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_task_debug_bug"
                    android:contentDescription="@string/task_debug_entry"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/taskBatchSelectionBar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/task_space_primary_blue"
                    android:gravity="center_vertical"
                    android:id="@+id/taskBatchCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/task_space_batch_cancel"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/task_space_page_text_primary"
                    android:gravity="center"
                    android:id="@+id/taskBatchTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/task_space_primary_blue"
                    android:gravity="center_vertical"
                    android:id="@+id/taskBatchSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/task_space_batch_select_all"/>
            </LinearLayout>
        </FrameLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/taskSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/task_space_list_top_margin"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/taskSpaceRecycler"
                    android:paddingBottom="@dimen/task_space_list_bottom_padding"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="top"
                    android:id="@+id/taskTopFade"
                    android:background="@drawable/bg_taskspace_top_fade"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/task_space_top_fade_height"/>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/task_space_page_text_tertiary"
            android:gravity="center"
            android:id="@+id/taskLoadMoreHint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="@string/task_space_no_more_tasks"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/taskSpaceStateContainer"
        android:visibility="gone"
        android:layout_width="312dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/taskSpaceStateAvatar"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_taskspace_empty_agent"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/task_space_empty_text"
            android:gravity="center"
            android:id="@+id/taskSpaceStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/task_space_empty_text"
            android:gravity="center"
            android:id="@+id/taskSpaceStateSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/taskSpaceEmptySuggestions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/task_space_empty_text"
                android:gravity="center"
                android:id="@+id/taskSpaceEmptySuggestionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_space_empty_suggestion_label"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/task_space_empty_text"
                android:gravity="center"
                android:id="@+id/taskSpaceEmptySuggestionAiNews"
                android:background="@drawable/bg_taskspace_empty_chip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/task_space_empty_chip_height"
                android:layout_marginTop="12dp"
                android:minWidth="190dp"
                android:text="@string/task_space_empty_suggestion_ai_news"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/task_space_empty_text"
                android:gravity="center"
                android:id="@+id/taskSpaceEmptySuggestionGame"
                android:background="@drawable/bg_taskspace_empty_chip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/task_space_empty_chip_height"
                android:layout_marginTop="8dp"
                android:text="@string/task_space_empty_suggestion_game"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/task_space_empty_text"
                android:gravity="center"
                android:id="@+id/taskSpaceEmptySuggestionFeishuCli"
                android:background="@drawable/bg_taskspace_empty_chip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/task_space_empty_chip_height"
                android:layout_marginTop="8dp"
                android:text="@string/task_space_empty_suggestion_feishu_cli"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/taskSearchBar"
        android:background="@android:color/transparent"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/task_space_search_bar_margin_bottom"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/task_space_search_bar_margin_horizontal"
        android:paddingEnd="@dimen/task_space_search_bar_margin_horizontal">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_taskspace_search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/task_space_search_bar_height"
            android:paddingStart="@dimen/task_space_search_bar_inner_padding"
            android:paddingEnd="@dimen/task_space_search_bar_inner_padding">
            <FrameLayout
                android:padding="@dimen/task_space_search_icon_padding"
                android:layout_width="@dimen/task_space_search_clear_tap_size"
                android:layout_height="@dimen/task_space_search_clear_tap_size">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/task_space_search_icon_graphic_size"
                    android:layout_height="@dimen/task_space_search_icon_graphic_size"
                    android:src="@drawable/ic_taskspace_search"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/task_space_search_text"
                android:textColorHint="@color/task_space_search_hint"
                android:gravity="center_vertical"
                android:id="@+id/taskSearchInput"
                android:background="@null"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:longClickable="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/task_space_search_hint"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="text"
                android:hapticFeedbackEnabled="false"
                android:imeOptions="actionSearch"
                android:textIsSelectable="false"
                android:layout_marginStart="4dp"/>
            <FrameLayout
                android:padding="@dimen/task_space_search_icon_padding"
                android:layout_width="@dimen/task_space_search_clear_tap_size"
                android:layout_height="@dimen/task_space_search_clear_tap_size">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/taskSearchClear"
                    android:visibility="invisible"
                    android:layout_width="@dimen/task_space_search_clear_size"
                    android:layout_height="@dimen/task_space_search_clear_size"
                    android:src="@drawable/ic_taskspace_search_clear"
                    android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/taskDeleteSnackbar"
        android:background="@drawable/bg_taskspace_snackbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/task_space_snackbar_height"
        android:layout_marginBottom="@dimen/task_space_snackbar_margin_bottom"
        android:paddingStart="@dimen/task_space_snackbar_padding_horizontal"
        android:paddingEnd="@dimen/task_space_snackbar_padding_horizontal"
        android:layout_marginStart="@dimen/task_space_snackbar_margin_horizontal"
        android:layout_marginEnd="@dimen/task_space_snackbar_margin_horizontal"
        android:elevation="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/task_space_operation_text"
            android:ellipsize="end"
            android:id="@+id/taskDeleteSnackbarMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/task_space_delete_failed_restored"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/task_space_primary_blue"
            android:gravity="center"
            android:id="@+id/taskDeleteSnackbarAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/task_space_snackbar_retry"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/task_space_snackbar_action_gap"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/taskBatchToolbar"
        android:background="#cc000000"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/taskBatchDelete"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/task_space_batch_toolbar_height"
            android:paddingHorizontal="24dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_taskspace_batch_delete"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/task_space_page_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/task_space_action_delete"
                android:includeFontPadding="false"
                android:fontFamily="Flyme Sans VF"
                android:fontWeight="500"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
