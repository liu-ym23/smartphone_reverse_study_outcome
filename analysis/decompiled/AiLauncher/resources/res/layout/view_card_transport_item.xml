<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_shell_translucent"
    android:paddingTop="14dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivTransportIcon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary_trip"
            android:id="@+id/tvTransportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llTransportSubtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary_trip"
                android:ellipsize="end"
                android:id="@+id/tvTransportCabin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <View
                android:id="@+id/vTransportSubtitleDivider"
                android:background="@color/card_divider_subtle"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="6dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary_trip"
                android:ellipsize="end"
                android:id="@+id/tvTransportStop"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary_trip"
            android:id="@+id/tvTransportDiscount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/card_text_secondary"
        android:id="@+id/tvTransportTags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/card_text_primary"
                android:id="@+id/tvDepTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivTransportIllustration"
                    android:layout_width="95dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_card_transport_plane"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_text_primary"
                    android:gravity="top"
                    android:id="@+id/tvArrTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/card_text_secondary_trip"
                    android:id="@+id/tvArrDaySpan"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary_trip"
                android:ellipsize="end"
                android:id="@+id/tvDepPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary_trip"
                android:gravity="bottom"
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary_trip"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tvArrPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/card_divider_subtle"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="true">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/llTransportPriceGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/card_price_text"
                android:id="@+id/tvTransportCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥"
                android:textFontWeight="500"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/card_price_text"
                android:id="@+id/tvTransportPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/card_price_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="起"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:id="@+id/btnTransportAction"
            android:background="@drawable/bg_card_cta_small"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="预定"
            android:paddingHorizontal="16dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
