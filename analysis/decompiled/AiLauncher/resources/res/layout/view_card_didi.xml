<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llDidiStoreHeader"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_card_didi_app_store"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:id="@+id/tvDidiStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDidiShell"
        android:background="@drawable/bg_card_didi_shell"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ViewStub
            android:id="@+id/stubDidiAppStore"
            android:layout="@layout/view_card_didi_appstore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDidiAuthHeader"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivDidiAuthIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tvDidiAuthTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/card_didi_auth_subtitle"
                    android:id="@+id/tvDidiAuthSubtitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDidiTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/card_text_primary"
                android:ellipsize="end"
                android:id="@+id/tvDidiTitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <com.stepos.ailauncher.foundation.appui.card.provider.didi.DidiLoopMarqueeTextView
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="@color/card_didi_matching_hint"
                android:gravity="center_vertical"
                android:id="@+id/tvDidiTitleTrailing"
                android:visibility="gone"
                android:fadingEdgeLength="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="true"
                android:requiresFadingEdge="horizontal"
                android:layout_marginStart="8dp"
                android:letterSpacing="0"
                android:lineHeight="16sp"
                android:textFontWeight="260"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/card_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvDidiRoute"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDidiPlate"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.stepos.ailauncher.foundation.appui.card.provider.didi.DidiLoopMarqueeTextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tvDidiPlateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/card_text_secondary"
                    android:ellipsize="end"
                    android:id="@+id/tvDidiPlateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivDidiPlateCar"
                android:layout_width="116dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_card_didi_car_model"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <com.stepos.ailauncher.foundation.appui.card.provider.didi.DidiLoopMarqueeTextView
            android:textSize="14sp"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvDidiSummary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:lineSpacingExtra="6dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:id="@+id/tvDidiNote"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <ViewStub
            android:id="@+id/stubDidiCarType"
            android:layout="@layout/view_card_didi_cartype_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llDidiInfoRows"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <View
            android:id="@+id/vDidiPillDivider"
            android:background="@color/card_divider_subtle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDidiPillCta"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <ImageView
                android:id="@+id/ivDidiDriverAvatar"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_card_didi_driver"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary"
                android:gravity="center_vertical"
                android:id="@+id/tvDidiCtaRowLabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llDidiCtaRowValue"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:layout_marginStart="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/card_text_primary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvDidiCtaAmountSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="true"
                    android:textAlignment="viewEnd"
                    android:letterSpacing="0"
                    android:lineHeight="18sp"
                    android:textFontWeight="500"/>
                <TextView
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textColor="@color/card_text_primary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvDidiCtaAmountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="true"
                    android:fontFamily="FZVariableYJHr L2"
                    android:textAlignment="viewEnd"
                    android:letterSpacing="0"
                    android:lineHeight="33sp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/btnDidiPillCta"
                android:background="@drawable/bg_card_didi_cta"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:id="@+id/tvDidiPillLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llDidiButtons"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/btnDidiSecondary"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/btnDidiPrimary"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/card_text_secondary"
        android:id="@+id/tvDidiAuthSuccess"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
