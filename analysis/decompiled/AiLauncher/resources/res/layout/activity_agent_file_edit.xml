<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:id="@+id/btn_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_repair_arrow_left"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#e6ffffff"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:letterSpacing="0.05"/>
        <ImageView
            android:id="@+id/btn_restore"
            android:background="@drawable/bg_btn_toolbar_icon"
            android:padding="8dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_agent_file_restore"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/btn_save"
            android:background="@drawable/bg_save_button"
            android:layout_width="62dp"
            android:layout_height="32dp"
            android:text="@string/file_edit_save"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#99ffffff"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingVertical="8dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginHorizontal="20dp">
        <EditText
            android:textSize="13sp"
            android:textColor="#e6ffffff"
            android:textColorHint="#4dffffff"
            android:gravity="start|top"
            android:id="@+id/et_content"
            android:background="@drawable/bg_agent_config_list"
            android:paddingTop="16dp"
            android:paddingBottom="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:inputType="textMultiLine"
            android:paddingHorizontal="16dp"
            android:importantForAutofill="no"/>
    </ScrollView>
</LinearLayout>
