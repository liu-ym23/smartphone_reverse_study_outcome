<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlay_scrim"
        android:background="@color/oobe_overlay_scrim"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_sheet_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.23"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sheet"
        android:background="@drawable/bg_oobe_wake_sheet"
        android:paddingBottom="16dp"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_sheet_top">
        <com.stepos.widget.toolbar.StepOSTitleBar
            android:id="@+id/title_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:steposBackdropBlurEnabled="false"
            style="@style/Oobe.TitleBar"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/oobe_wake_anywhere_title"
            android:includeFontPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/page_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="340dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintVertical_bias="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:id="@+id/dot_voice"
                android:background="@drawable/bg_oobe_wake_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:alpha="0.9"/>
            <View
                android:id="@+id/dot_keyboard"
                android:background="@drawable/bg_oobe_wake_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:alpha="0.3"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/oobe_wake_caption"
            android:gravity="center"
            android:id="@+id/tv_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="42dp"
            android:text="@string/oobe_wake_anywhere_caption_voice"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="33dp"
            android:textFontWeight="400"
            app:layout_constraintBottom_toTopOf="@+id/btn_got_it"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.stepos.widget.button.StepOSButton
            android:textColor="@color/oobe_overlay_got_it_text"
            android:id="@+id/btn_got_it"
            android:background="@drawable/bg_oobe_got_it"
            android:layout_width="0dp"
            android:layout_height="@dimen/stepos_button_bar_height"
            android:text="@string/oobe_got_it"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:steposGlassEffect="clear"
            app:steposGlassEnabled="true"
            style="@style/StepOSWidget.Button.Secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/side_key_bar"
        android:background="@drawable/bg_oobe_wake_side_key"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="48dp"
        android:translationY="@dimen/oobe_wake_side_key_offset_down"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.47"/>
</androidx.constraintlayout.widget.ConstraintLayout>
