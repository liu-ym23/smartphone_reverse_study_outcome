<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/v_agent_section"
    android:background="@drawable/bg_side_panel_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Agent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/btn_agent_add"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_agent_add_plus"
            android:tint="#e6ffffff"
            android:contentDescription="@null"/>
    </LinearLayout>
    <View
        android:background="#0dffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.stepos.ailauncher.chat.view.AgentDevicesScrollView
        android:id="@+id/sv_agent_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_agent_devices"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"/>
    </com.stepos.ailauncher.chat.view.AgentDevicesScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/btn_agent_expand"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:id="@+id/tv_agent_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sidebar_agent_expand"/>
        <ImageView
            android:id="@+id/iv_agent_toggle_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_history_agent_arrow"
            android:contentDescription="@null"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</LinearLayout>
