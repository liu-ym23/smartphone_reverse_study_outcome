<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_voice_setting_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/ivVoiceAvatar"
        android:background="@drawable/bg_voice_avatar_placeholder"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:round="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/chat_color_setting_title"
            android:id="@+id/tvVoiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_color_setting_summary"
            android:id="@+id/tvVoiceDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineHeight="20sp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivVoiceSelected"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_voice_selected_check"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"/>
</LinearLayout>
