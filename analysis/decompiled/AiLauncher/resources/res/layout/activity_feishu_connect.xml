<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@drawable/bg_feishu_connect_dim"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/top_bar"
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@drawable/bg_new_session_circle"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_feishu_back"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/feishu_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:text="@string/feishu_cli_top_title"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:textFontWeight="580"/>
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_top_uninstall"
            android:background="@drawable/bg_new_session_circle"
            android:visibility="gone"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_top_uninstall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_agent_detail_delete"
                android:contentDescription="@null"/>
            <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                android:layout_gravity="center"
                android:id="@+id/pb_top_uninstall"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
    </FrameLayout>
    <ScrollView
        android:id="@+id/group_idle"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ail_sheet_title_bar_total_height"
        android:layout_marginBottom="80dp"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="64dp"
                android:layout_height="64dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/feishu_logo"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/feishu_text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/feishu_cli_idle_benefit1_desc"
                android:lineHeight="24sp"
                android:textFontWeight="400"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:text="@string/feishu_cli_idle_steps_title"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingVertical="8dp"
                android:lineHeight="20sp"
                android:textFontWeight="580"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_amoo_entry_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:padding="6dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_cli_step1_download"
                        android:tint="#ffffffff"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feishu_cli_idle_step1_title"
                            android:includeFontPadding="false"
                            android:textFontWeight="580"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/feishu_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/feishu_cli_idle_step1_desc"
                            android:lineHeight="16sp"
                            android:textFontWeight="340"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="#08ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:padding="6dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_cli_step2_robot"
                        android:tint="#ffffffff"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feishu_cli_idle_step2_title"
                            android:includeFontPadding="false"
                            android:textFontWeight="580"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/feishu_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/feishu_cli_idle_step2_desc"
                            android:lineHeight="16sp"
                            android:textFontWeight="340"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="#08ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:padding="6dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_cli_step3_shield"
                        android:tint="#ffffffff"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#ffffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feishu_cli_idle_step3_title"
                            android:includeFontPadding="false"
                            android:textFontWeight="580"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/feishu_text_tertiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/feishu_cli_idle_step3_desc"
                            android:lineHeight="16sp"
                            android:textFontWeight="340"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/feishu_text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/feishu_cli_idle_risk_desc"
                android:textFontWeight="500"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_connect"
        android:background="@drawable/bg_feishu_cta_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:text="@string/feishu_cli_idle_cta"
        android:layout_marginHorizontal="32dp"
        android:textFontWeight="580"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/group_installing"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ail_sheet_title_bar_total_height"
        android:layout_marginBottom="88dp"
        android:paddingHorizontal="40dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <FrameLayout
                android:id="@+id/dot_step_1"
                android:layout_width="24dp"
                android:layout_height="24dp">
                <View
                    android:id="@+id/dot_step_1_bg"
                    android:background="@drawable/bg_feishu_step_dot_finished"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/dot_step_1_check"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_feishu_step_check"
                    android:contentDescription="@null"/>
                <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                    android:id="@+id/dot_step_1_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <View
                android:id="@+id/line_1_2"
                android:background="@drawable/bg_feishu_step_line"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="4dp"/>
            <FrameLayout
                android:id="@+id/dot_step_2"
                android:layout_width="24dp"
                android:layout_height="24dp">
                <View
                    android:id="@+id/dot_step_2_bg"
                    android:background="@drawable/bg_feishu_step_dot_pending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/dot_step_2_check"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_feishu_step_check"
                    android:contentDescription="@null"/>
                <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                    android:id="@+id/dot_step_2_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <View
                android:id="@+id/line_2_3"
                android:background="@drawable/bg_feishu_step_line"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="4dp"/>
            <FrameLayout
                android:id="@+id/dot_step_3"
                android:layout_width="24dp"
                android:layout_height="24dp">
                <View
                    android:id="@+id/dot_step_3_bg"
                    android:background="@drawable/bg_feishu_step_dot_pending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/dot_step_3_check"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_feishu_step_check"
                    android:contentDescription="@null"/>
                <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                    android:id="@+id/dot_step_3_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <View
                android:id="@+id/line_3_4"
                android:background="@drawable/bg_feishu_step_line"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="4dp"/>
            <FrameLayout
                android:id="@+id/dot_step_4"
                android:layout_width="24dp"
                android:layout_height="24dp">
                <View
                    android:id="@+id/dot_step_4_bg"
                    android:background="@drawable/bg_feishu_step_dot_pending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/dot_step_4_check"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_feishu_step_check"
                    android:contentDescription="@null"/>
                <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
                    android:id="@+id/dot_step_4_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
        <FrameLayout
            android:id="@+id/install_hero"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="80dp"
            android:layout_height="80dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iv_install_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/feishu_logo"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/tv_install_done_badge"
                android:background="@drawable/bg_feishu_install_done_badge"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="-6dp"
                android:src="@drawable/ic_feishu_step_check"
                android:tint="#ffffffff"
                android:contentDescription="@null"
                android:layout_marginEnd="-6dp"/>
            <ImageView
                android:id="@+id/iv_authorize_badge"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_feishu_authorize_badge"
                android:contentDescription="@null"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_authorize_hero"
            android:visibility="gone"
            android:layout_width="172dp"
            android:layout_height="116dp"
            android:src="@drawable/ic_feishu_authorize_hero"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/feishu_text_primary"
            android:id="@+id/tv_install_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/feishu_cli_install_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/feishu_text_secondary"
            android:gravity="center"
            android:id="@+id/tv_install_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/feishu_cli_install_subtitle"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_install_next"
        android:background="@drawable/bg_feishu_cta_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:text="@string/feishu_cli_install_next_cta"
        android:layout_marginHorizontal="32dp"
        android:textFontWeight="580"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_authorize"
        android:background="@drawable/bg_feishu_cta_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:text="@string/feishu_cli_authorize_cta"
        android:layout_marginHorizontal="32dp"
        android:textFontWeight="580"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_back_to_ai_space"
        android:background="@drawable/bg_feishu_cta_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:text="@string/feishu_cli_review_back_cta"
        android:layout_marginHorizontal="32dp"
        android:textFontWeight="580"/>
    <ScrollView
        android:id="@+id/group_connected"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ail_sheet_title_bar_total_height"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_amoo_entry_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/feishu_logo"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/feishu_text_primary"
                    android:id="@+id/tv_connected_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/feishu_cli_connected_title"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textFontWeight="500"/>
                <FrameLayout
                    android:id="@+id/connected_action_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/feishu_text_primary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/feishu_cli_connected_recommend_title"
                android:lineHeight="24sp"
                android:textFontWeight="400"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/feishu_text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/feishu_cli_connected_recommend_subtitle"
                android:textFontWeight="400"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recommended_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/group_failed"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ail_sheet_title_bar_total_height"
        android:layout_marginBottom="88dp"
        android:paddingHorizontal="40dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="80dp"
            android:layout_height="80dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/feishu_logo"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/badge_fail_red"
                android:background="@drawable/ic_feishu_fail_badge"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="-6dp"
                android:layout_marginEnd="-6dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✕"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/badge_fail_warn"
                android:background="@drawable/ic_feishu_warn_badge"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="-6dp"
                android:layout_marginEnd="-6dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="!"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/feishu_text_primary"
            android:id="@+id/tv_fail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/feishu_cli_fail_install_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/feishu_text_secondary"
            android:gravity="center"
            android:id="@+id/tv_fail_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/feishu_cli_fail_install_reason"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_retry"
        android:background="@drawable/bg_feishu_cta_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:text="@string/feishu_cli_retry_install"
        android:layout_marginHorizontal="32dp"
        android:textFontWeight="580"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/btn_abort_link"
        android:background="@drawable/bg_feishu_cta_secondary"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="44dp"
        android:layout_marginHorizontal="32dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/tv_abort_link"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/feishu_cli_abort_link"
            android:textFontWeight="340"/>
        <com.stepos.ailauncher.agent.skill.widget.IndeterminateSpinnerView
            android:layout_gravity="center"
            android:id="@+id/pb_abort_link"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_debug_log_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_marginBottom="92dp"
        android:layout_marginHorizontal="16dp">
        <ScrollView
            android:id="@+id/sv_debug_log"
            android:background="#88000000"
            android:padding="8dp"
            android:paddingTop="32dp"
            android:scrollbars="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <HorizontalScrollView
                android:id="@+id/hsv_debug_log"
                android:scrollbars="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#80ff80"
                    android:id="@+id/tv_debug_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"/>
            </HorizontalScrollView>
        </ScrollView>
        <LinearLayout
            android:layout_gravity="end|top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp">
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_debug_log_clear"
                android:background="#aa000000"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="清空"
                android:paddingHorizontal="10dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_debug_log_close"
                android:background="#aa000000"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="×"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/btn_debug_log_toggle"
        android:background="#66000000"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="DEBUG"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"/>
</FrameLayout>
