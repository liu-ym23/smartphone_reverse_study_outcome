<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0d000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/auth_panel"
        android:background="@drawable/bg_agent_dark_dialog"
        android:paddingTop="38dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="#ffeeeeee"
            android:gravity="center"
            android:id="@+id/tv_auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ScrollView
            android:id="@+id/scroll_auth_content"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:overScrollMode="never">
            <TextView
                android:textSize="15sp"
                android:textColor="#73ebebf5"
                android:id="@+id/tv_auth_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="#ff1564ed"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/agent_auth_cancel"
                android:layout_weight="1"/>
            <View
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#ff1564ed"
                android:gravity="center"
                android:id="@+id/btn_confirm"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/agent_auth_confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
