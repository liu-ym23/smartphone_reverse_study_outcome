<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/stepos_list_category_partition_content_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/category_partition_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/stepos_text_view_color_black_alpha_40"
            android:gravity="center"
            android:id="@+id/category_partition_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/stepos_list_category_partition_content_padding_left"
            android:layout_marginEnd="@dimen/stepos_list_category_partition_content_padding_left"
            android:layout_alignParentStart="true"
            style="@style/Widget.StepOS.Light.TextView.Little.Medium"/>
        <TextView
            android:gravity="center"
            android:id="@+id/category_partition_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/stepos_list_category_partition_content_padding_right"
            android:layout_marginEnd="@dimen/stepos_list_category_partition_content_padding_right"
            android:layout_alignParentEnd="true"
            style="@style/Widget.StepOS.Light.TextView.Little.Medium"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/card_partition_divider"
        android:background="@drawable/stepos_card_new_list_divider"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stepos_list_card_partition_content_padding_bottom"
        android:layout_below="@+id/category_partition_text"
        android:layout_marginStart="@dimen/stepos_list_category_partition_divider_padding_left"
        android:layout_marginEnd="@dimen/stepos_list_category_partition_divider_padding_right"/>
</RelativeLayout>
