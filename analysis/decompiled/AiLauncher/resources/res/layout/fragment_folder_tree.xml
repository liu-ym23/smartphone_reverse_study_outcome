<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="26dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_folder_back"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_new"
            android:scaleType="fitCenter"
            android:contentDescription="@string/chat_sheet_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_folder_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:id="@+id/iv_folder_close"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_chrome_close"
            android:scaleType="fitCenter"
            android:contentDescription="@string/chat_sheet_back"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_folder_nodes"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"/>
</LinearLayout>
