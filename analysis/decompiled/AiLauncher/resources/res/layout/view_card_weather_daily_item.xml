<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="80dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/weather_text_primary"
                android:id="@+id/tvDailyWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/weather_text_primary"
                android:id="@+id/tvDailyDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="42.5dp">
            <ImageView
                android:id="@+id/ivDailyIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/weather_pop_cyan"
                android:gravity="center"
                android:id="@+id/tvDailyPop"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/weather_text_on_surface"
            android:ellipsize="end"
            android:id="@+id/tvDailyCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="7dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/weather_text_on_surface"
            android:id="@+id/tvDailyTempRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/vDailyDivider"
        android:background="@color/weather_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
