<?xml version="1.0" encoding="utf-8"?>
<stepos.support.v7.widget.StepOSMultiLinesCheckLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/multi_line_parent"
    android:background="@drawable/stepos_alert_dialog_listview_item_bg_radius"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:choiceMode="multipleChoice"
    android:paddingStart="20dp"
    android:paddingEnd="0dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="?android:attr/textAppearance"
            android:textStyle="normal"
            android:id="@+id/alert_title_multi_line_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            style="@style/TextAppearance.StepOS.Label.Large"/>
        <TextView
            android:id="@+id/alert_detail_multi_line_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            style="@style/TextAppearance.StepOS.Body.Mini"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/alert_title_multi_line_check_box"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:button="@drawable/stepos_btn_check_two_state"/>
</stepos.support.v7.widget.StepOSMultiLinesCheckLayout>
