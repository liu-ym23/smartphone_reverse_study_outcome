<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_card"
    android:background="@drawable/bg_feishu_need_install_card"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_wecom_logo"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/feishu_text_primary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/wecom_cli_need_install_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/feishu_text_secondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/wecom_cli_need_install_desc"
        android:lineSpacingExtra="4dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/feishu_brand"
        android:gravity="center"
        android:id="@+id/btn_later"
        android:background="@drawable/bg_feishu_dialog_btn_glass"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/wecom_cli_need_install_later"
        android:textFontWeight="500"/>
</LinearLayout>
