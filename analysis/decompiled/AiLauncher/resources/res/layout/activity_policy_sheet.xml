<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_close"
            android:contentDescription="@null"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:id="@+id/tv_content"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/error_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载失败，请检查网络后重试"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/btn_retry"
                android:background="@drawable/bg_amoo_store_icon_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="重试"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
