<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_drawer_title_normal"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="1dp"
    android:paddingHorizontal="12dp">
    <ImageView
        android:id="@+id/iv_agent_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffffff"
        android:ellipsize="end"
        android:id="@+id/tv_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"/>
    <View
        android:id="@+id/divider_agent_offline"
        android:background="#1affffff"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99ffffff"
        android:id="@+id/tv_agent_offline"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_external_agent_subtitle_offline"
        android:maxLines="1"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99ffffff"
        android:id="@+id/tv_last_message_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"/>
    <com.stepos.ailauncher.chat.view.IndeterminateSpinnerView
        android:id="@+id/spinner_agent_uninstalling"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"/>
</LinearLayout>
