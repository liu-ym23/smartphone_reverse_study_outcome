<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slide_panel_container"
    android:background="@drawable/bg_slide_panel"
    android:paddingTop="43dp"
    android:paddingBottom="20dp"
    android:layout_width="350dp"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/slide_panel_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/slide_panel_search_box"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:paddingHorizontal="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chat_history_search"
                    android:contentDescription="@null"/>
                <EditText
                    android:textSize="15sp"
                    android:textColor="@color/search_input_text"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:id="@+id/et_slide_panel_search"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/panel_search_hint"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:layout_marginStart="8dp"
                    android:importantForAutofill="no"/>
                <ImageView
                    android:id="@+id/iv_slide_panel_search_clear"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_clear"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btn_panel_new_session"
                android:background="@drawable/bg_new_session_circle"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chat_new_session"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:scaleX="-1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#eeeeee"
                android:gravity="center"
                android:id="@+id/tv_slide_panel_search_cancel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/common_cancel"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stepos.ailauncher.chat.view.ChatHistoryView
                android:id="@+id/v_slide_chat_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_slide_panel_search_results"
                android:paddingBottom="105dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty_search_result"
                android:paddingBottom="150dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_chat_history_search"
                    android:contentDescription="@null"
                    android:alpha="0.4"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/panel_search_empty"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/btn_slide_panel_new_chat"
        android:background="@drawable/bg_new_chat_pill"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="51dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_drawer_new_topic_outline"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_new_chat"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</FrameLayout>
