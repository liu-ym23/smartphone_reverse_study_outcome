<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_taskstore_card_tti_image_round"
    android:layout_width="@dimen/taskstore_card_tti_multi_item_size"
    android:layout_height="@dimen/taskstore_card_tti_multi_item_size"
    android:clipToOutline="true">
    <com.stepos.ailauncher.taskstore.widget.HalftoneShaderView
        android:id="@+id/shader_tti_item_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_tti_item_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/layout_tti_item_generating_overlay"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/taskstore_card_tti_progress_text_size_multi"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/tv_tti_item_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_tti_item_fail_overlay"
        android:background="@drawable/bg_taskstore_card_tti_fail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_tti_item_fail_icon"
            android:layout_width="@dimen/taskstore_card_tti_fail_icon_size"
            android:layout_height="@dimen/taskstore_card_tti_fail_icon_size"
            android:src="@drawable/ic_taskstore_tti_fail"
            android:contentDescription="@null"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_tti_item_expired_overlay"
        android:background="@drawable/bg_taskstore_card_tti_fail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/taskstore_card_tti_expired_text_size"
            android:textColor="@color/taskstore_card_tti_expired_text"
            android:layout_gravity="center"
            android:id="@+id/tv_tti_item_expired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taskstore_tti_expired_or_missing"
            android:includeFontPadding="false"/>
    </FrameLayout>
</FrameLayout>
