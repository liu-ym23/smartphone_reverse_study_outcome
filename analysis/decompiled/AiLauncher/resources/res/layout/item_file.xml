<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_chat_input_image_border"
    android:layout_width="180dp"
    android:layout_height="66dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="8dp">
    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="32dp"
        android:lineHeight="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_file_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/tv_file_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        android:lineHeight="16sp"
        app:layout_constraintStart_toEndOf="@+id/iv_file_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/tv_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="4dp"
        android:lineHeight="16sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_file_type"
        app:layout_constraintStart_toEndOf="@+id/tv_file_type"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/tv_file_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:lineHeight="16sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_file_type"
        app:layout_constraintStart_toEndOf="@+id/tv_dot"/>
    <View
        android:id="@+id/iv_file_mask"
        android:background="@drawable/fg_uploading_file"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:max="100"
        android:indeterminate="false"
        app:indicatorColor="@color/white"
        app:indicatorSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="#33ffffff"
        app:trackThickness="2dp"/>
    <ImageButton
        android:id="@+id/btn_retry_upload"
        android:background="@android:color/transparent"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_retry_upload"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/btn_delete"
        android:background="@color/transparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/common_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="end|top"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_chat_attachment_delete"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
