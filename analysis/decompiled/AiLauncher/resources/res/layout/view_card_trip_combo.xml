<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llComboTransport"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/card_text_primary"
                android:id="@+id/tvComboTransportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/card_text_secondary"
                android:id="@+id/tvComboTransportSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/card_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:alpha="0.5"/>
    </LinearLayout>
    <View
        android:background="@color/card_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0.5"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llComboHotel"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/card_text_primary"
                android:id="@+id/tvComboHotelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/card_text_secondary"
                android:id="@+id/tvComboHotelSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/card_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:alpha="0.5"/>
    </LinearLayout>
    <View
        android:background="@color/card_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0.5"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/card_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总价"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:id="@+id/tvComboTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:id="@+id/btnComboAction"
            android:background="@drawable/bg_card_cta_small"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="预定"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="12dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
