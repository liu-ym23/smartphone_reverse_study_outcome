<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_page_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_title_row"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/float_card_title"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/tv_risk_badge"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/float_card_risk_high_text"
                android:id="@+id/tv_risk_badge"
                android:background="@drawable/bg_float_card_risk_high"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_skip_inline"
                app:layout_constraintStart_toEndOf="@+id/tv_title"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/float_card_text_secondary_60"
                android:id="@+id/tv_skip_inline"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/float_card_skip"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_risk_badge"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/float_card_text_muted"
            android:id="@+id/tv_subtitle"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/float_card_horizontal_padding"/>
        <com.stepos.agentframework.floatcard.view.MaxHeightScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/float_card_scrollbar_thumb"
            android:id="@+id/scroll_options"
            android:scrollbars="vertical"
            android:fadingEdgeLength="32dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            app:floatCardMaxHeight="@dimen/float_card_options_max_height">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_options"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.stepos.agentframework.floatcard.view.MaxHeightScrollView>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/float_card_confirm_disabled_text"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/bg_float_card_confirm_disabled"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/float_card_confirm_height"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/float_card_confirm"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/float_card_horizontal_padding"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/float_card_text_secondary"
            android:id="@+id/tv_description"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/float_card_horizontal_padding"/>
    </LinearLayout>
</FrameLayout>
