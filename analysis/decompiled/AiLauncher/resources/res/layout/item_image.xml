<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="66dp"
    android:layout_height="66dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    android:foreground="@drawable/bg_chat_input_image_border"
    android:layout_marginEnd="8dp">
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/iv_image_mask"
        android:background="@drawable/fg_uploading_file"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:max="100"
        android:indeterminate="false"
        app:indicatorColor="@color/white"
        app:indicatorSize="18dp"
        app:trackColor="#33ffffff"
        app:trackThickness="2dp"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/btn_retry_upload"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_retry_upload"
        android:scaleType="centerInside"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/btn_delete"
        android:background="@color/transparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/common_delete">
        <ImageView
            android:layout_gravity="end|top"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_chat_attachment_delete"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
</FrameLayout>
