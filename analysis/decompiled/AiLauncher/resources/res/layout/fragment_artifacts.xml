<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_artifacts"
        android:paddingTop="74dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/v_artifacts_top_fade"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/ll_artifacts_top"
        android:paddingTop="26dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:translationZ="2dp"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/iv_artifacts_back"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_new"
            android:scaleType="fitCenter"
            android:contentDescription="@string/chat_sheet_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_artifacts_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/chat_artifacts_title"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:id="@+id/iv_artifacts_close"
            android:background="@drawable/bg_chat_host_chrome_pill"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_chrome_close"
            android:scaleType="fitCenter"
            android:contentDescription="@string/chat_sheet_back"/>
    </LinearLayout>
</merge>
