<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/task_robot_root"
    android:background="@drawable/bg_tool_group"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <ImageView
        android:id="@+id/iv_execute_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|bottom"
        android:id="@+id/tv_execute_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_execute_state"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow_right"
        app:layout_constraintStart_toEndOf="@+id/iv_execute_state"
        app:layout_constraintTop_toTopOf="@+id/iv_execute_state"/>
    <ImageView
        android:id="@+id/iv_arrow_right"
        android:padding="10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_arrow_right_white"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_execute_state"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_execute_state"/>
    <View
        android:id="@+id/line"
        android:background="#0dffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_execute_status"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99ffffff"
        android:gravity="start"
        android:id="@+id/tv_execute_step"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cl_preview_area"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#40000000"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_thumbnail_timeline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_execute_step"
        app:layout_goneMarginTop="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/execute_image_viewpager"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/robot_container"
                android:background="#ff393a3e"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_executing_actions"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_preview_area">
        <TextView
            android:textSize="13sp"
            android:textColor="#ccffffff"
            android:gravity="center"
            android:id="@+id/btn_stop"
            android:background="@drawable/bg_task_robot_stop_action"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="终止任务"
            android:layout_weight="1"/>
        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_takeover"
            android:background="@drawable/bg_task_robot_takeover_action"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="接管任务"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_thumbnail_timeline"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_preview_area">
        <com.stepos.agentframework.chatui.view.NestedScrollableHost
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
        </com.stepos.agentframework.chatui.view.NestedScrollableHost>
        <View
            android:layout_gravity="center"
            android:id="@+id/view_timeline_indicator"
            android:background="#ccffffff"
            android:layout_width="2dp"
            android:layout_height="44dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
