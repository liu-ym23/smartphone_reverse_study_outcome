<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_task_result_code_card"
    android:background="@drawable/bg_task_result_code_card"
    android:padding="@dimen/task_result_code_card_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_code_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/task_result_code_header_icon">
        <ImageView
            android:id="@+id/iv_code_icon"
            android:layout_width="@dimen/task_result_code_header_icon"
            android:layout_height="@dimen/task_result_code_header_icon"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="@dimen/task_result_code_title_size"
            android:textColor="@android:color/white"
            android:ellipsize="middle"
            android:id="@+id/tv_code_filename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:id="@+id/iv_code_arrow"
            android:layout_width="@dimen/task_result_code_header_icon"
            android:layout_height="@dimen/task_result_code_header_icon"
            android:src="@drawable/ic_taskstore_arrow_next_right"
            android:contentDescription="@null"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/fl_code_preview"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/task_result_code_fade_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/task_result_code_section_gap"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical">
        <TextView
            android:textSize="@dimen/task_result_code_body_size"
            android:textColor="@color/code_syntax_default"
            android:id="@+id/tv_code_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineHeight="@dimen/task_result_code_line_height"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_code_view_full"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/task_result_code_section_gap">
        <TextView
            android:textSize="@dimen/task_result_code_view_full_size"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taskstore_code_expand"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:id="@+id/iv_code_view_full_arrow"
            android:visibility="gone"
            android:layout_width="@dimen/task_result_code_view_full_icon"
            android:layout_height="@dimen/task_result_code_view_full_icon"
            android:src="@drawable/ic_taskstore_code_view_full_chevron"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
