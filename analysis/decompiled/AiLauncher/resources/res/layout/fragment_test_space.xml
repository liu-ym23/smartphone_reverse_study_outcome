<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_repair_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/skillContent"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="136dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/guideCardSkill"
                android:background="@drawable/bg_repair_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipToOutline="true">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/test_space_guide_skill"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textFontWeight="500"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_repair_arrow_right"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/loadingSkill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="32dp">
                <ImageView
                    android:id="@+id/ivLoadingSkill"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_repair_loading_spinner"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/test_space_loading"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSkills"
                android:background="@drawable/bg_repair_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:clipToOutline="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/agentContent"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="136dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/guideCardAgent"
                android:background="@drawable/bg_repair_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipToOutline="true">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/test_space_guide_agent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textFontWeight="500"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_repair_arrow_right"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/loadingAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="32dp">
                <ImageView
                    android:id="@+id/ivLoadingAgent"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_repair_loading_spinner"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/test_space_loading"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAgents"
                android:background="@drawable/bg_repair_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:clipToOutline="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/appContent"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="136dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/loadingApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="32dp">
                <ImageView
                    android:id="@+id/ivLoadingApp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_repair_loading_spinner"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/test_space_loading"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:background="@drawable/bg_repair_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:clipToOutline="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/emptyState"
        android:paddingTop="56dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@drawable/bg_list_empty_icon"
            android:layout_width="60dp"
            android:layout_height="60dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_list_empty"
                android:contentDescription="@null"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/test_space_empty"
            android:textFontWeight="600"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="2dp">
        <FrameLayout
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/btnBack"
                android:background="@drawable/bg_new_session_circle"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_test_space_back"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/test_space_title"
                android:includeFontPadding="false"
                android:textFontWeight="700"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/tabBar"
            android:background="@drawable/bg_amoo_store_tabbar"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="20dp">
            <View
                android:id="@+id/tabIndicator"
                android:background="@drawable/bg_amoo_store_tab_selected"
                android:layout_width="0dp"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabSkill"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/test_space_tab_skill"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabAgent"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/test_space_tab_agent"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tabApp"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/test_space_tab_app"
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="124dp"/>
</FrameLayout>
