<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_map_shell"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <FrameLayout
        android:id="@+id/flMapSlot"
        android:background="@color/card_map_shell_night_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_map_route_slot_height"
        android:layout_marginTop="-12dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp">
        <ImageView
            android:id="@+id/ivRouteMap"
            android:background="@drawable/bg_map_slot_top_rounded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <com.stepos.agentframework.uikit.IndeterminateSpinnerView
            android:layout_gravity="center"
            android:id="@+id/vRouteMapLoading"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:elevation="24dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llModeTabs"
        android:background="@drawable/bg_card_map_tab_track"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/card_text_primary"
        android:id="@+id/tvRouteOrigin"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:id="@+id/tvRouteDuration"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/card_map_route_distance"
            android:id="@+id/tvRouteSummaryDot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/card_map_route_distance"
            android:id="@+id/tvRouteDistance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/scrollRouteTags"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llRouteTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llWaypoints"
            android:paddingBottom="24dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/btnRouteAction"
            android:background="@drawable/bg_card_cta_small"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始导航"
            android:paddingHorizontal="20dp"
            android:paddingVertical="9dp"/>
    </LinearLayout>
</LinearLayout>
