<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolCallHeader"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/toolCallStatusAnim"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_blue_anim"/>
        <ImageView
            android:id="@+id/toolCallStatusIcon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/task_detail_on_surface"
            android:ellipsize="end"
            android:id="@+id/toolCallName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/task_detail_on_surface_variant"
            android:id="@+id/toolCallDots"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…"/>
        <ImageView
            android:id="@+id/toolCallExpand"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/task_detail_on_surface_variant"
        android:id="@+id/toolCallResult"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</merge>
