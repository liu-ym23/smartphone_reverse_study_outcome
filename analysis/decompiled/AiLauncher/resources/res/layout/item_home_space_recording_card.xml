<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/card_root"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_space_card_height"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="2dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardUseCompatPadding="false">
    <FrameLayout
        android:id="@+id/layout_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_card_blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/view_card_base_bg"
            android:background="@drawable/bg_home_space_card_blur_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/view_card_overlay"
            android:background="@drawable/bg_home_space_card_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.stepos.ailauncher.task.space.RecordingGlowView
            android:id="@+id/view_recording_glow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_summary_decoration"
            android:visibility="gone"
            android:layout_width="412dp"
            android:layout_height="324dp"
            android:layout_marginBottom="70dp"
            android:src="@drawable/ic_home_space_transcribing_decoration"
            android:scaleType="fitEnd"
            android:contentDescription="@null"
            android:rotation="-11"
            android:layout_marginEnd="-70dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="36dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/bg_home_space_recording_icon_chip"
                    android:layout_width="44dp"
                    android:layout_height="44dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_task_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tasktype_audio"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_task_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_space_recording_title"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#ff9a9a9a"
                android:id="@+id/tv_recording_status_top"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_summary_preview"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:rotation="-11"
                android:layout_marginStart="66dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="#ffffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_summary_preview_title"
                    android:background="@drawable/bg_home_space_summary_pill"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="12dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_summary_time_row"
                    android:background="@drawable/bg_home_space_summary_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_home_space_summary_time"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#99ffffff"
                        android:ellipsize="end"
                        android:id="@+id/tv_summary_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_summary_person_row"
                    android:background="@drawable/bg_home_space_summary_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_home_space_summary_person"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#99ffffff"
                        android:ellipsize="end"
                        android:id="@+id/tv_summary_participants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/layout_recording_active"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="52sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/tv_recording_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.01"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tv_recording_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_space_recording_phase_recording"
                    android:includeFontPadding="false"/>
                <com.stepos.ailauncher.task.space.RecordingWaveformView
                    android:id="@+id/view_recording_waveform"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="32dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffff6e6e"
                    android:gravity="center"
                    android:id="@+id/tv_recording_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_recording_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/btn_recording_pause"
                    android:background="@drawable/bg_home_space_recording_round_button"
                    android:padding="20dp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_home_space_recording_pause"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/home_space_recording_pause"/>
                <ImageView
                    android:id="@+id/btn_recording_stop"
                    android:background="@drawable/bg_home_space_recording_round_button"
                    android:padding="18dp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_home_space_recording_complete"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/home_space_recording_stop"
                    android:layout_marginStart="32dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffff7a1e"
            android:layout_gravity="start|bottom"
            android:id="@+id/tv_summary_recording_duration"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:id="@+id/btn_recording_view_detail"
            android:background="@drawable/bg_home_space_action_primary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:text="@string/home_space_recording_view"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="20dp"
            android:paddingHorizontal="32dp"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
