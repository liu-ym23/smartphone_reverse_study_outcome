<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llAlipayShell"
        android:background="@drawable/bg_card_alipay_shell"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llAlipayStoreHeader"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_card_alipay_app_store"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary"
                android:id="@+id/tvAlipayStoreName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <ViewStub
            android:id="@+id/stubAlipayAppStore"
            android:layout="@layout/view_card_alipay_appstore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llAlipayAuthHeader"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivAlipayAuthIcon"
                android:background="@drawable/bg_card_alipay_icon_auth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_card_alipay_abao"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:clipToOutline="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/card_alipay_auth_title"
                    android:ellipsize="end"
                    android:id="@+id/tvAlipayAuthTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:lineHeight="25sp"
                    android:textFontWeight="500"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/card_alipay_auth_subtitle"
                    android:ellipsize="end"
                    android:id="@+id/tvAlipayAuthSubtitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    android:lineHeight="21sp"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/card_alipay_cta_text"
                android:gravity="center"
                android:id="@+id/btnAlipaySingleCta"
                android:background="@drawable/bg_card_alipay_cta"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="12dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llAlipayButtons"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/btnAlipaySecondary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="12dp"
                android:lineHeight="24sp"
                android:textFontWeight="400"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/btnAlipayPrimary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineHeight="24sp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivAlipayChannelLogo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:maxHeight="20dp"
            android:contentDescription="@null"/>
    </LinearLayout>
    <View
        android:id="@+id/vAlipayDimScrim"
        android:background="@drawable/bg_card_alipay_dimmed_scrim"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
