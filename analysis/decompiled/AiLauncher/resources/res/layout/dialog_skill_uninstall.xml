<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_skill_dialog"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <TextView
        android:textSize="19sp"
        android:textColor="@color/sd_dialog_title"
        android:gravity="center"
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/installed_skill_uninstall_confirm_title"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/sd_dialog_desc"
        android:gravity="center"
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="38dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/sd_dialog_btn_neutral_text"
            android:gravity="center"
            android:id="@+id/btn_dialog_cancel"
            android:background="@drawable/bg_skill_dialog_btn_neutral"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/installed_skill_uninstall_dialog_cancel"
            android:layout_weight="1"/>
        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/sd_dialog_btn_destructive_text"
            android:gravity="center"
            android:id="@+id/btn_dialog_confirm"
            android:background="@drawable/bg_skill_dialog_btn_destructive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/installed_skill_action_uninstall"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
