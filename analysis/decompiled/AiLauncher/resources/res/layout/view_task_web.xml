<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/webviewContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stepos.ailauncher.task.detail.NoFocusScrollNestedScrollView
        android:id="@+id/scrollView"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.stepos.agentframework.uikit.AIMDTextView
                android:id="@+id/tvMarkdown"
                android:background="@android:color/transparent"
                android:paddingTop="0dp"
                android:paddingBottom="@dimen/artifact_detail_markdown_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/artifact_detail_markdown_padding_horizontal"/>
        </LinearLayout>
    </com.stepos.ailauncher.task.detail.NoFocusScrollNestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
