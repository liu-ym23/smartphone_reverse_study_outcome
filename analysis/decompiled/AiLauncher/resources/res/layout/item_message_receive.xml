<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/receive_root_layout"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPlaySound"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chat_star"
                android:scaleType="fitXY"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivPlaySound"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sound_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_deep_think_result"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_deepthinking"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_deep_thinking"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@+id/ll_deep_thinking"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ll_deep_thinking"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_deep_thinking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@+id/iv_deepthinking"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/agent_text_primary"
                    android:id="@+id/tv_deep_thinking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="深度思考"
                    android:fontFamily="sans-serif"/>
                <ImageView
                    android:id="@+id/iv_expand"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_mcp_expanded"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="2dp"
                    app:layout_constraintDimensionRatio="1"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/agent_text_primary"
                android:id="@+id/tv_deepthink_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:lineSpacingExtra="4sp"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.06"
                app:layout_constraintStart_toEndOf="@+id/iv_deepthinking"
                app:layout_constraintTop_toBottomOf="@+id/ll_deep_thinking"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stepos.agentframework.chatui.view.ChatLoadingView
            android:id="@+id/loading_animation_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <com.stepos.agentframework.chatui.view.MessageContentContainer
            android:id="@+id/message_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/chat_error_message_text"
            android:id="@+id/error_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:letterSpacing="0.07"
            android:paddingVertical="12dp"/>
    </LinearLayout>
</FrameLayout>
