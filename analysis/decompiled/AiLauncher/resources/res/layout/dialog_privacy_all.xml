<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_privacy_all_overlay"
    android:background="@color/privacy_all_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_gravity="bottom|center_horizontal"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="41dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_privacy_all_card"
            android:background="@drawable/bg_privacy_all_dialog"
            android:paddingTop="38dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/privacy_all_title"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_all_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/privacy_all_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/privacy_all_desc"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/privacy_all_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/privacy_all_perm1_desc"
                android:lineSpacingExtra="2dp"
                android:alpha="0.8"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <CheckBox
                    android:id="@+id/cb_user_agreement"
                    android:text="@string/privacy_all_perm1_consent"
                    style="@style/PrivacyAllConsentCheckbox"/>
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/overlay_cb_user_agreement"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="34dp"
                    android:layout_height="34dp"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/privacy_all_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/privacy_all_perm2_desc"
                android:lineSpacingExtra="2dp"
                android:alpha="0.8"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <CheckBox
                    android:id="@+id/cb_voiceprint"
                    android:text="@string/privacy_all_perm2_consent"
                    style="@style/PrivacyAllConsentCheckbox"/>
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/overlay_cb_voiceprint"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="34dp"
                    android:layout_height="34dp"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/privacy_all_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/privacy_all_perm3_desc"
                android:lineSpacingExtra="2dp"
                android:alpha="0.8"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <CheckBox
                    android:id="@+id/cb_improvement"
                    android:text="@string/privacy_all_perm3_consent"
                    style="@style/PrivacyAllConsentCheckbox"/>
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/overlay_cb_improvement"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="34dp"
                    android:layout_height="34dp"/>
            </FrameLayout>
            <CheckBox
                android:layout_gravity="center_horizontal"
                android:id="@+id/cb_agree_all"
                android:layout_marginTop="3dp"
                android:text="@string/privacy_all_agree_all"
                style="@style/PrivacyAllAgreeAllCheckbox"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="38dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/privacy_all_link"
                    android:gravity="center"
                    android:id="@+id/tv_cancel"
                    android:background="@drawable/bg_privacy_all_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/common_cancel"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="12dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/privacy_all_link"
                    android:gravity="center"
                    android:id="@+id/tv_confirm"
                    android:background="@drawable/bg_privacy_all_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/privacy_all_confirm"
                    android:layout_weight="1"
                    android:alpha="0.25"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
