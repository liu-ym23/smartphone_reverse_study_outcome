<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_title_padding_top"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/iv_back"
            android:background="@drawable/bg_agent_detail_icon_btn"
            android:padding="@dimen/ail_sheet_title_icon_padding"
            android:layout_width="@dimen/ail_sheet_title_icon_size"
            android:layout_height="@dimen/ail_sheet_title_icon_size"
            android:src="@drawable/ic_amoo_back"
            app:tint="@color/white"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ail_sheet_title_text_height"
            android:text="@string/installed_skill_title"
            android:paddingHorizontal="@dimen/ail_sheet_title_text_padding_h"
            android:textFontWeight="580"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/skill_text_hint"
                android:textColorHint="@color/skill_text_hint"
                android:id="@+id/et_search"
                android:background="@drawable/bg_search_input"
                android:longClickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/installed_skill_search_hint"
                android:maxLines="1"
                android:drawableLeft="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:inputType="text"
                android:hapticFeedbackEnabled="false"
                android:imeOptions="actionSearch"
                android:textIsSelectable="false"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:drawableTint="@color/white"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_search_clear_inline"
                android:background="@drawable/bg_search_clear_chip"
                android:padding="3dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close_x_round"
                android:contentDescription="@string/installed_skill_clear"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_clear"
            android:background="@drawable/bg_search_clear_glass"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close_x_round"
            android:contentDescription="@string/installed_skill_clear"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_skill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/skill_btn_install_bg"
                android:id="@+id/tv_tab_skills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/indicator_skills"
                android:background="@color/skill_tab_active_value"
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_cli"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/skill_tab_active_value"
                android:id="@+id/tv_tab_cli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/indicator_cli"
                android:background="@color/skill_tab_active_value"
                android:visibility="invisible"
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_installed"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_installed"
                android:background="@drawable/bg_amoo_entry_card"
                android:visibility="gone"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:clipToOutline="true"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty_view"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:background="@drawable/bg_skill_icon_placeholder"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/skill_text_description"
                android:id="@+id/tv_empty_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/skill_text_description"
                android:id="@+id/tv_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
