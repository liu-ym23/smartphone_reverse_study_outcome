<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_delete_confirm_overlay"
    android:background="@color/task_space_dialog_dim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_delete_confirm_card"
        android:background="@drawable/bg_task_warning_card"
        android:paddingTop="38dp"
        android:paddingBottom="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="356dp">
        <TextView
            android:textSize="19sp"
            android:textColor="@color/fd_sys_color_on_surface_default"
            android:gravity="center"
            android:id="@+id/tv_delete_confirm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_space_delete_confirm_title"
            android:includeFontPadding="false"
            android:fontFamily="Flyme Sans VF"
            android:letterSpacing="0"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/fd_sys_color_on_surface_variant_default"
            android:gravity="center"
            android:id="@+id/tv_delete_confirm_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:includeFontPadding="false"
            android:fontFamily="Flyme Sans VF"
            android:letterSpacing="0"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/fd_sys_color_on_surface_variant_default"
            android:gravity="start"
            android:id="@+id/tv_delete_confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/task_space_delete_unsaved_file_message"
            android:includeFontPadding="false"
            android:fontFamily="Flyme Sans VF"
            android:letterSpacing="0"
            android:textFontWeight="400"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/fd_sys_color_brand"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_delete_confirm_cancel"
                android:background="@drawable/bg_task_warning_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/task_space_delete_confirm_cancel"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="Flyme Sans VF"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:letterSpacing="0"
                android:textFontWeight="500"/>
            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/fd_sys_color_error_default"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_delete_confirm_positive"
                android:background="@drawable/bg_task_warning_btn_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/task_space_delete_confirm_positive"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="Flyme Sans VF"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:letterSpacing="0"
                android:textFontWeight="500"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
