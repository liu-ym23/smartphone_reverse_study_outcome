<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_repair_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back"
            android:background="@drawable/bg_top_bar_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_left_arrow"
            android:layout_centerVertical="true"
            android:contentDescription="返回"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amoo_memory_title"
            android:layout_centerInParent="true"
            android:textFontWeight="580"/>
        <ImageView
            android:id="@+id/btn_add"
            android:background="@drawable/bg_top_bar_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_memory_add"
            android:layout_centerVertical="true"
            android:contentDescription="添加"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        app:tabBackground="@drawable/bg_memory_detail_tab_pill"
        app:tabGravity="start"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="76dp"
        app:tabMode="scrollable"
        app:tabPaddingBottom="0dp"
        app:tabPaddingEnd="20dp"
        app:tabPaddingStart="20dp"
        app:tabPaddingTop="0dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextAppearance="@style/MemoryDetailTabTextAppearance"
        app:tabTextAppearance="@style/MemoryDetailTabTextAppearance"
        app:tabTextColor="@color/memory_detail_tab_text_color"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"/>
</LinearLayout>
