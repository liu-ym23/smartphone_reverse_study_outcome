<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.stepos.ailauncher.agent.aispace.connect.ScanMaskOverlay
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/nav_bar"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back_24dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/connect_page_back"
            app:tint="#ffffffff"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr_title"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/scan_frame"
        android:layout_width="264dp"
        android:layout_height="264dp"
        android:layout_marginBottom="20dp">
        <ImageView
            android:layout_gravity="start|top"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null"/>
        <ImageView
            android:layout_gravity="end|top"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null"
            android:rotation="90"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null"
            android:rotation="180"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null"
            android:rotation="270"/>
        <View
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/scan_line"
            android:background="@drawable/scan_line_gradient"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="12dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_bar"
        android:background="#000000"
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="196dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_scan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr_hint_body"
            android:lineSpacingExtra="4dp"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffff4d4f"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_scan_mismatch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_qr_agent_mismatch"/>
</FrameLayout>
