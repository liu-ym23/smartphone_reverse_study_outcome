<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/ivDidiCarTypeImage"
        android:layout_width="116dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_card_didi_car_model"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/card_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvDidiCarTypeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:id="@+id/tvDidiCarTypePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/card_didi_text_tertiary"
            android:id="@+id/tvDidiCarTypeOriginPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbDidiCarType"
        android:padding="0dp"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/bg_card_didi_checkbox"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginStart="12dp"/>
</LinearLayout>
