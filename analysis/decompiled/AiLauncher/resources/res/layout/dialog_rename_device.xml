<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/rename_panel"
        android:background="@drawable/bg_skill_dialog"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="18dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="@color/sd_dialog_title"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rename_dialog_title"/>
        <FrameLayout
            android:background="@drawable/bg_rename_dialog_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <EditText
                android:textSize="15sp"
                android:textColor="#eeeeee"
                android:textColorHint="#33eeeeee"
                android:id="@+id/et_rename"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/rename_dialog_hint"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/rename_dialog_cursor"
                android:paddingStart="14dp"
                android:paddingEnd="40dp"/>
            <ImageButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/btn_clear"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_input_clear"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:layout_marginEnd="10dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/sd_dialog_btn_neutral_text"
                android:gravity="center"
                android:id="@+id/btn_rename_cancel"
                android:background="@drawable/bg_skill_dialog_btn_neutral"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/disconnect_dialog_cancel"
                android:layout_weight="1"/>
            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/sd_dialog_btn_neutral_text"
                android:gravity="center"
                android:id="@+id/btn_rename_confirm"
                android:background="@drawable/bg_rename_dialog_btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/rename_dialog_confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
