<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/action_layout"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_copy"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_popup_copy"/>
    <ImageView
        android:id="@+id/iv_like"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_action_like"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/iv_dislike"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_popup_dislike"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/iv_refresh"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chat_refresh"
        android:contentDescription="@string/chat_variant_regenerate"
        android:layout_marginStart="4dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp">
        <ImageView
            android:id="@+id/iv_read"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_sound_on"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieTtsPlaying"
            android:padding="4dp"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/iv_read"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_read"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_share"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chat_share"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/iv_channel_logo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/chat_action_icon_default"
        android:id="@+id/tv_channel_support"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="支持"
        android:layout_marginStart="4dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/variant_pager"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">
        <ImageView
            android:id="@+id/iv_variant_prev"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_variant_prev"
            android:contentDescription="@string/chat_variant_prev"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_variant_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="28dp"/>
        <ImageView
            android:id="@+id/iv_variant_next"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_variant_next"
            android:contentDescription="@string/chat_variant_next"/>
    </LinearLayout>
</LinearLayout>
