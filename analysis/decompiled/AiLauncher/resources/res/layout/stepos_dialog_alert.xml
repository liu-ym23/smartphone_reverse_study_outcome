<?xml version="1.0" encoding="utf-8"?>
<com.stepos.widget.dialog.StepOSAlertDialogLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/stepos_dialog_parent_panel"
    android:paddingTop="@dimen/stepos_dialog_padding_top"
    android:paddingBottom="@dimen/stepos_dialog_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/stepos_dialog_padding_horizontal"
    android:paddingEnd="@dimen/stepos_dialog_padding_horizontal">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/stepos_dialog_top_panel"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stepos_dialog_title_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/stepos_dialog_header_inset"
            android:layout_marginEnd="@dimen/stepos_dialog_header_inset">
            <FrameLayout
                android:id="@+id/stepos_dialog_icon_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="start|top"
                    android:id="@+id/stepos_dialog_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/stepos_dialog_title_icon_size"
                    android:layout_height="@dimen/stepos_dialog_title_icon_size"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <ImageView
                    android:layout_gravity="start|top"
                    android:id="@+id/stepos_dialog_icon_badge"
                    android:visibility="gone"
                    android:layout_width="@dimen/stepos_dialog_icon_badge_size"
                    android:layout_height="@dimen/stepos_dialog_icon_badge_size"
                    android:layout_marginTop="@dimen/stepos_dialog_icon_badge_offset_top"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/stepos_dialog_icon_badge_offset_start"/>
            </FrameLayout>
            <TextView
                android:textAppearance="@style/StepOSTextAppearance.Dialog.Title"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/stepos_dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:accessibilityHeading="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stepos_dialog_icon_group"/>
            <TextView
                android:textAppearance="@style/StepOSTextAppearance.Dialog.Message"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/stepos_dialog_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stepos_dialog_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/stepos_dialog_middle_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/stepos_dialog_content_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/stepos_dialog_scroll_view"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/stepos_dialog_custom_panel"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never">
            <FrameLayout
                android:id="@+id/stepos_dialog_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include layout="@layout/stepos_dialog_button_bar"/>
</com.stepos.widget.dialog.StepOSAlertDialogLayout>
