<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/layout_home_space_empty_root"
    android:background="@drawable/bg_home_space_empty_card"
    android:paddingTop="52dp"
    android:paddingBottom="70dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp">
    <TextView
        android:textSize="20sp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/tv_empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_space_empty_title"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#d9ffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_empty_suggestion_1"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_space_empty_suggestion_1"
            android:includeFontPadding="false"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_home_space_empty_chevron_left"
            android:drawableEnd="@drawable/ic_home_space_empty_chevron_right"
            android:layout_marginVertical="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#d9ffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_empty_suggestion_2"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_space_empty_suggestion_2"
            android:includeFontPadding="false"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_home_space_empty_chevron_left"
            android:drawableEnd="@drawable/ic_home_space_empty_chevron_right"
            android:layout_marginVertical="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#d9ffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_empty_suggestion_3"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_space_empty_suggestion_3"
            android:includeFontPadding="false"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_home_space_empty_chevron_left"
            android:drawableEnd="@drawable/ic_home_space_empty_chevron_right"
            android:layout_marginVertical="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#d9ffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_empty_suggestion_4"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_space_empty_suggestion_4"
            android:includeFontPadding="false"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_home_space_empty_chevron_left"
            android:drawableEnd="@drawable/ic_home_space_empty_chevron_right"
            android:layout_marginVertical="10dp"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/btn_empty_send"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:src="@drawable/ic_home_space_empty_send_arrow"
        android:scaleType="centerInside"
        android:contentDescription="@string/home_space_empty_send_desc"/>
</LinearLayout>
