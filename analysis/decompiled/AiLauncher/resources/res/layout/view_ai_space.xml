<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="40dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <com.google.android.material.tabs.TabLayout
            android:layout_gravity="center"
            android:id="@+id/ai_space_tab_layout"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            app:tabBackground="@android:color/transparent"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMinWidth="0dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabPaddingTop="0dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabTextAppearance="@style/AiSpaceTabTextAppearance"
            app:tabTextColor="@color/aispace_tab_text_color"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_ai_space_setting"
            android:background="@drawable/bg_top_bar_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_aispace_menu"
            android:scaleType="centerInside"
            android:contentDescription="@string/aispace_setting_btn_desc"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <RelativeLayout
            android:layout_gravity="center"
            android:layout_width="304dp"
            android:layout_height="96dp">
            <com.stepos.agentsprite.view.SceneView
                android:id="@+id/scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.stepos.agentsprite.view.AgentView
                    android:id="@+id/agent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.stepos.agentsprite.view.SceneView>
            <TextView
                android:textSize="14sp"
                android:textColor="#818181"
                android:id="@+id/bubble"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/fusion_pixel"/>
        </RelativeLayout>
    </FrameLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ai_space_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#99000000"
        android:gravity="center"
        android:id="@+id/ai_space_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="暂无可用空间"
        android:layout_weight="1"/>
</LinearLayout>
