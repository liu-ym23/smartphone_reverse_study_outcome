<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_card_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_drag_handle"
            android:background="@drawable/bg_float_card_drag_handle"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_toolbar"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/float_card_horizontal_padding">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_pagination"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_page_prev"
                    android:padding="4dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_float_card_chevron_left"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/float_card_text_secondary_60"
                    android:id="@+id/tv_pagination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="6dp"/>
                <ImageView
                    android:id="@+id/iv_page_next"
                    android:padding="4dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_float_card_chevron_right"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/float_card_text_secondary_60"
                android:gravity="center_vertical"
                android:id="@+id/tv_skip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/float_card_skip"
                android:includeFontPadding="false"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/float_card_error"
            android:id="@+id/tv_error"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/float_card_horizontal_padding"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_loading"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
</FrameLayout>
