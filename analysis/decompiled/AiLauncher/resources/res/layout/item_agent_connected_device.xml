<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/item_root"
    android:background="@drawable/bg_agent_connected_cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="72dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/iv_agent_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/tv_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <View
                android:id="@+id/dot_status"
                android:background="@drawable/dot_status_online"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#4dffffff"
                android:ellipsize="end"
                android:id="@+id/tv_device_dir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ImageButton
        android:id="@+id/btn_more"
        android:background="@null"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_my_agent_more"
        android:tint="#e6ffffff"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="-4dp"/>
</LinearLayout>
