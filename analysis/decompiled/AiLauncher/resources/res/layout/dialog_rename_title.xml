<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_overlay"
    android:background="#10000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_length_toast"
        android:background="@drawable/bg_rename_length_toast"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_card"
        android:background="@drawable/bg_rename_dialog_card"
        android:paddingTop="38dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="38dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="19sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rename_dialog_title"
            android:fontFamily="sans-serif-medium"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="38dp">
            <EditText
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:textColorHint="#4dffffff"
                android:id="@+id/et_title_input"
                android:background="@drawable/bg_input_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@null"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingEnd="44dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_clear_input"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chat_rename_clear"
                android:contentDescription="@string/rename_dialog_clear"
                android:layout_marginEnd="12dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="38dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/rename_btn_cancel_text"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/bg_rename_dialog_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_cancel"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/rename_btn_confirm_text"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/bg_rename_dialog_btn_confirm"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_confirm"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
