<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_aispace_popup_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="168dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_installed"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_aispace_menu_installed"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aispace_menu_installed"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_repair"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:paddingHorizontal="18dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_aispace_menu_repair"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aispace_menu_repair"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
