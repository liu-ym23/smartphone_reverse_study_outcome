<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/skill_bg_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/iv_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back_24dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingVertical="12dp"
            app:tint="@color/white"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/skill_text_primary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/installed_skill_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <EditText
            android:textColor="@color/skill_text_hint"
            android:textColorHint="@color/skill_text_hint"
            android:id="@+id/et_search"
            android:background="@drawable/bg_search_input"
            android:longClickable="false"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:hint="@string/installed_skill_search_hint"
            android:maxLines="1"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:inputType="text"
            android:hapticFeedbackEnabled="false"
            android:imeOptions="actionSearch"
            android:textIsSelectable="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:drawableTint="@color/white"/>
        <ImageView
            android:id="@+id/iv_clear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search_clear"
            android:contentDescription="@string/installed_skill_clear"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_skill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/skill_btn_install_bg"
                android:id="@+id/tv_tab_skills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/indicator_skills"
                android:background="@color/skill_tab_active_value"
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_cli"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/skill_tab_active_value"
                android:id="@+id/tv_tab_cli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/indicator_cli"
                android:background="@color/skill_tab_active_value"
                android:visibility="invisible"
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/skill_card_compress_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_installed"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty_view"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:background="@drawable/bg_skill_icon_placeholder"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/skill_text_description"
                android:id="@+id/tv_empty_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/skill_text_description"
                android:id="@+id/tv_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
