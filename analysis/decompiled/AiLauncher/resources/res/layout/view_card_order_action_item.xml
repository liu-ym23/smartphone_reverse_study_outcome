<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_shell_translucent"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingHorizontal="14dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/card_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvOrderTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textFontWeight="580"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/card_text_secondary_meituan"
        android:id="@+id/tvOrderSubtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/card_text_secondary_meituan"
        android:id="@+id/tvOrderHint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llOrderFields"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <View
        android:id="@+id/divOrderAction"
        android:background="@color/card_divider_subtle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llOrderActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/llOrderPriceGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/card_text_secondary_meituan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应付"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/card_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/card_text_primary"
                android:id="@+id/tvOrderAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:id="@+id/btnOrderAction"
            android:background="@drawable/bg_card_cta_white_pill"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="确认下单"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="9dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
