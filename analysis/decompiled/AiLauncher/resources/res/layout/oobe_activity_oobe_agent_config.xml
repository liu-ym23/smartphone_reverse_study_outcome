<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_root"
    android:background="@color/oobe_dark_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Oobe.TitleBar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_bias="0.38">
        <FrameLayout
            android:layout_width="164.4dp"
            android:layout_height="208.8dp">
            <WebView
                android:layout_gravity="center"
                android:id="@+id/video_mascot"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/oobe_agreement_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/oobe_configuring_title"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/oobe_step_text"
            android:gravity="center"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/oobe_configuring_desc"
            android:lineHeight="22sp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_anchor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tv_time,footer_panel"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/oobe_step_text"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="@string/oobe_configuring_time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.stepos.widget.glass.StepOSGlassPanel
        android:id="@+id/footer_panel"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:steposGlassBlurUniform="true"
        app:steposGlassCornerRadius="0dp"
        app:steposGlassScope="inWindow"
        app:steposGlassScrim="@drawable/bg_agreement_footer_scrim"
        style="@style/StepOSWidget.GlassPanel">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/footer_content"
            android:paddingTop="36dp"
            android:paddingBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="36dp">
            <com.stepos.widget.button.StepOSButton
                android:id="@+id/btn_finish"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stepos_button_height"
                android:text="@string/oobe_continue"
                style="@style/Oobe.Button"/>
        </LinearLayout>
    </com.stepos.widget.glass.StepOSGlassPanel>
</androidx.constraintlayout.widget.ConstraintLayout>
