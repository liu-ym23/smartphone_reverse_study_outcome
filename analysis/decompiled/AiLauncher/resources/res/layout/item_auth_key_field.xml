<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="#80ffffff"
        android:ellipsize="end"
        android:id="@+id/tv_key_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineHeight="20dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_key_field"
        android:background="@drawable/bg_auth_key_field"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/tv_masked_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:lineHeight="20dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:textColorHint="#66ffffff"
            android:id="@+id/et_key_input"
            android:background="@null"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/third_party_auth_detail_auth_key"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:lineHeight="20dp"/>
        <ImageView
            android:id="@+id/btn_toggle_key"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_auth_key_hidden"
            android:contentDescription="@string/third_party_auth_detail_toggle_key"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
