<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/llWeatherCard"
    android:paddingTop="24dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/groupWeatherSingleHeader"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/weather_text_primary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tvWeatherLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="28dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/ivWeatherIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/groupWeatherSingleBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <TextView
                    android:textSize="40sp"
                    android:textStyle="normal"
                    android:textColor="@color/weather_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tvWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0"
                    android:lineHeight="40sp"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/weather_text_primary"
                    android:layout_gravity="top"
                    android:id="@+id/tvWeatherTempUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°C"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/weather_text_primary"
                android:layout_gravity="bottom"
                android:id="@+id/tvWeatherCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/weather_text_primary"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvWeatherMeta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:letterSpacing="0"
                android:lineHeight="12sp"
                android:textFontWeight="340"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/weather_text_primary"
                android:gravity="end|center_vertical"
                android:id="@+id/tvWeatherTempRange"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="8dp"
                android:letterSpacing="0"
                android:lineHeight="12sp"
                android:textFontWeight="340"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/groupWeatherDailyHeader"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/weather_text_daily_header"
            android:ellipsize="end"
            android:id="@+id/tvWeatherDailyLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/weather_text_daily_header"
            android:id="@+id/tvWeatherDayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View
        android:id="@+id/vWeatherDailyHeaderDivider"
        android:background="@color/weather_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llWeatherDaily"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/vWeatherHourlyDivider"
        android:background="@color/weather_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.stepos.ailauncher.foundation.appui.card.widget.NestedHorizontalScrollView
        android:id="@+id/hsvWeatherHourly"
        android:visibility="gone"
        android:scrollbars="none"
        android:fadingEdgeLength="33dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:requiresFadingEdge="horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llWeatherHourly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.stepos.ailauncher.foundation.appui.card.widget.NestedHorizontalScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/groupWeatherUvSingle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/weather_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/weather_text_primary"
            android:id="@+id/tvWeatherUvTipSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/weather_text_primary"
        android:id="@+id/tvWeatherUvTipDaily"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/vWeatherBottomSpacer"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
