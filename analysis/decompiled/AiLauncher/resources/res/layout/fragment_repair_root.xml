<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sv_repair_content"
        android:paddingTop="68dp"
        android:paddingBottom="76dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <com.stepos.ailauncher.task.space.RepairTabView
            android:id="@+id/repair_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/ll_repair_top"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/repair_root_title"
            android:includeFontPadding="false"
            android:textFontWeight="580"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_session_close"/>
    </FrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_repair_bottom_fade"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:importantForAccessibility="no"/>
</FrameLayout>
