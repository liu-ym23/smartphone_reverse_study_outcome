<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="168dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_add_menu_camera"
        android:background="@drawable/bg_add_menu_item_ripple"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingHorizontal="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_menu_camera"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/input_camera"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"
            android:lineHeight="24sp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_add_menu_album"
        android:background="@drawable/bg_add_menu_item_ripple"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_menu_album"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/input_album"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"
            android:lineHeight="24sp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_add_menu_file"
        android:background="@drawable/bg_add_menu_item_ripple"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add_menu_file"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#eeeeee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/input_file"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"
            android:lineHeight="24sp"/>
    </LinearLayout>
</LinearLayout>
