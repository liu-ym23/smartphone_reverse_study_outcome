<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/demoMainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/demoInputBar"
            android:background="@drawable/bg_float_input_box"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="6dp"
            android:layout_marginHorizontal="8dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#99ffffff"
                android:id="@+id/demoInputHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_sheet_demo_input_hint"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/demoInputSend"
                android:background="#ff1b4332"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/chat_sheet_demo_input_send"
                android:paddingHorizontal="18dp"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/demoScroll"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/chat_sheet_secondary_btn_text"
                    android:background="#221b4332"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_sheet_demo_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"/>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/chat_sheet_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_sheet_desc_text"
                    android:id="@+id/demoDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/chat_sheet_demo_desc"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/chat_sheet_desc_text"
                    android:id="@+id/demoState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btnPreviewPortrait"
                    android:background="#ff1b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/chat_sheet_demo_preview"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btnPreviewRotate"
                    android:background="#ff1b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_preview_rotate"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/chat_sheet_secondary_btn_text"
                    android:gravity="center"
                    android:id="@+id/btnSettleHalf"
                    android:background="#221b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_to_half"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/chat_sheet_secondary_btn_text"
                    android:gravity="center"
                    android:id="@+id/btnSettleFull"
                    android:background="#221b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_to_full"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/chat_sheet_secondary_btn_text"
                    android:gravity="center"
                    android:id="@+id/btnSettleMinify"
                    android:background="#221b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_to_minify"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/chat_sheet_secondary_btn_text"
                    android:gravity="center"
                    android:id="@+id/btnDismiss"
                    android:background="#221b4332"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/chat_sheet_demo_dismiss"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/demoPreviewOverlay"
        android:background="#ff000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="#33ffffff"
                android:layout_width="180dp"
                android:layout_height="240dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/demoPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/chat_sheet_demo_preview_hint"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/btnClosePreview"
            android:background="#33ffffff"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="24dp"
            android:text="@string/chat_sheet_demo_close_preview"/>
    </FrameLayout>
</FrameLayout>
