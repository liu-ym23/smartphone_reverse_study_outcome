<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.ailauncher.chat.view.LauncherChatLayout
            android:id="@+id/aclChat"
            android:paddingBottom="72dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            app:btnToBottomScaleType="centerInside"
            app:defaultInputLayoutEnable="false"
            app:defaultToolBarLayoutEnable="false"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/unified_agent_empty_block"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="72dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffffff"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/unified_agent_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/unified_agent_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <View
                    android:id="@+id/unified_agent_status_dot"
                    android:background="@drawable/dot_status_online_chat"
                    android:layout_width="4dp"
                    android:layout_height="4dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#b3ffffff"
                    android:id="@+id/unified_agent_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textFontWeight="260"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/unified_agent_offline_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#b3ffffff"
                    android:id="@+id/unified_agent_offline_hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_reconnect_prompt_agent_offline"
                    android:textFontWeight="260"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/chat_reconnect_retry_text"
                    android:id="@+id/unified_agent_offline_reconnect"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_reconnect_retry_reconnect"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/v_chat_top_fade"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:importantForAccessibility="no"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_chat_bottom_fade"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/ll_chat_top_fade"
        android:paddingTop="@dimen/ail_sheet_pager_page_top_inset"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:translationZ="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/unified_chrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="20dp">
            <ImageView
                android:id="@+id/unified_btn_sidebar"
                android:background="@drawable/bg_new_session_circle"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chrome_sidebar"
                android:scaleType="fitCenter"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/unified_chrome_title_block"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#e6ffffff"
                    android:ellipsize="end"
                    android:id="@+id/unified_chrome_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/unified_chrome_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <View
                        android:id="@+id/unified_chrome_status_dot"
                        android:background="@drawable/dot_status_online_chat"
                        android:layout_width="4dp"
                        android:layout_height="4dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#b3ffffff"
                        android:id="@+id/unified_chrome_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="4dp"
                        android:textFontWeight="260"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/unified_chrome_actions"
                android:background="@drawable/bg_chrome_action_pill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="11dp">
                <ImageView
                    android:id="@+id/unified_btn_new_session"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_chrome_new_chat"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="16dp"/>
                <ImageView
                    android:id="@+id/unified_btn_more"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_chrome_more"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/unified_btn_close"
                android:background="@drawable/bg_new_session_circle"
                android:padding="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chrome_close"
                android:scaleType="fitCenter"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
</merge>
