<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.ailauncher.chat.view.ActionView
        android:id="@+id/actionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/voice_status_tip"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/llInputMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/voice_status_tip">
        <ViewStub
            android:id="@+id/vsInfoCard"
            android:layout="@layout/layout_floating_card_container"
            android:inflatedId="@+id/vsInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llDynamicFormContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/vsInfoCard"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imgRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/llDynamicFormContainer"/>
        <com.stepos.ailauncher.chat.view.InputMotionLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:currentState="@+id/state_compact_single_row"
            app:layoutDescription="@xml/scene_input_container_float"
            app:layout_constraintTop_toBottomOf="@+id/imgRecyclerView">
            <RelativeLayout
                android:id="@+id/layout_btn_voice"
                android:background="@drawable/bg_input_icon_circle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/btn_voice_start"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_voice_start"
                    android:tint="?attr/colorOnSurface"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/btn_voice_on"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_keyboard"
                    android:tint="?attr/colorOnSurface"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/btn_camera"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_camera"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_more"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/btn_more"
                android:background="@drawable/bg_input_icon_circle"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_chat_more"
                android:scaleType="fitCenter"
                android:tint="?attr/colorOnSurface"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_text_send"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_text_send"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_txt_send"
                android:paddingStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/bg_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_more"
                app:layout_constraintStart_toEndOf="@+id/layout_btn_voice"
                app:layout_constraintTop_toTopOf="parent">
                <EditText
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:id="@+id/et_input_bar"
                    android:background="#00ffffff"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="140dp"
                    android:minHeight="36dp"
                    android:hint="@string/input_hint_send_or_hold_short"
                    android:maxLines="3"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionSend"
                    android:textCursorDrawable="@drawable/cursor_white"
                    android:fontFamily="sans-serif"
                    android:paddingStart="0dp"
                    android:paddingVertical="6dp"
                    android:textFontWeight="340"/>
            </FrameLayout>
            <TextView
                android:textSize="17sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:id="@+id/longPressTxtView"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_more"
                app:layout_constraintStart_toEndOf="@+id/layout_btn_voice"/>
            <com.stepos.ailauncher.speech.view.DotWaveVoiceView
                android:id="@+id/voiceRecordingView"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_more"
                app:layout_constraintStart_toEndOf="@+id/layout_btn_voice"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/voice_finalizing_content"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:alpha="0"
                android:paddingStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/voice_finalizing_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_voice_finalizing_dots"
                        android:scaleType="center"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#b3ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wake_asr_finalizing"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/voice_finalizing_stop"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_stop_reply"
                    android:contentDescription="@string/voice_finalizing_stop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.stepos.ailauncher.chat.view.InputMotionLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
