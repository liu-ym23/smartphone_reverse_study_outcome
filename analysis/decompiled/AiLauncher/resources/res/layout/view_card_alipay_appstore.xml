<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivAlipayAppIcon"
        android:background="@drawable/bg_card_alipay_icon_install"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/ic_card_alipay_app"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:clipToOutline="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvAlipayAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tvAlipayAppSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/card_alipay_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/tvAlipayAppExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flAlipayInstall"
        android:background="@drawable/bg_card_alipay_cta"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:minHeight="32dp"
        android:layout_marginStart="10dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/card_cta_text"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvAlipayInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivAlipayInstallLoading"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_card_alipay_loading_spin"
            android:contentDescription="@null"/>
    </FrameLayout>
</LinearLayout>
