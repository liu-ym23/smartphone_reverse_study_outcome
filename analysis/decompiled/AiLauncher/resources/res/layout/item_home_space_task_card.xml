<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/card_root"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_space_card_height"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="2dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardUseCompatPadding="false">
    <FrameLayout
        android:id="@+id/layout_card_bg"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_card_blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/view_card_base_bg"
            android:background="@drawable/bg_home_space_card_blur_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/view_card_overlay"
            android:background="@drawable/bg_home_space_card_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_caption_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">
                <FrameLayout
                    android:background="@drawable/bg_home_space_task_card_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_task_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home_space_tasktype_others"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_task_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:paddingHorizontal="20dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="20dp">
                <com.stepos.ailauncher.common.widget.SweepTextView
                    android:textSize="20sp"
                    android:textColor="#99ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_task_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    app:sweepEnabled="false"/>
                <View
                    android:id="@+id/v_state_dot"
                    android:background="@drawable/bg_home_space_state_dot_orange"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#99ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_task_toolcall_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/fl_card_decoration_wrapper"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToOutline="true">
                <FrameLayout
                    android:id="@+id/fl_card_decoration_host"
                    android:clipChildren="true"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="32dp"
                    android:paddingHorizontal="20dp"
                    android:clipToOutline="true">
                    <ImageView
                        android:id="@+id/iv_card_decoration"
                        android:layout_width="match_parent"
                        android:layout_height="176dp"
                        android:src="@drawable/ic_home_space_task_card_decoration_loading"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/fl_gui_host_container"
                    android:background="@drawable/bg_home_space_gui_host"
                    android:padding="24dp"
                    android:visibility="gone"
                    android:clipChildren="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    android:layout_marginHorizontal="20dp"
                    android:clipToOutline="true">
                    <com.stepos.agentframework.chatui.appui.taskrobot.RobotAppUIHostView
                        android:layout_gravity="center"
                        android:id="@+id/robot_app_ui_host"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/layout_artifact_chip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="46dp"
            android:paddingHorizontal="20dp">
            <FrameLayout
                android:id="@+id/layout_artifact_badge"
                android:layout_width="40dp"
                android:layout_height="46dp">
                <ImageView
                    android:id="@+id/iv_artifact_badge_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_home_space_artifact_badge_document"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#ffcd5e2b"
                    android:id="@+id/tv_artifact_badge_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_artifact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#80ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_artifact_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:id="@+id/btn_artifact_view"
                android:background="@drawable/bg_home_space_artifact_button"
                android:layout_width="80dp"
                android:layout_height="44dp"
                android:text="@string/home_space_artifact_view"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/layout_action_panel"
            android:background="@drawable/bg_home_space_action_panel"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#ccffffff"
                android:ellipsize="end"
                android:id="@+id/tv_action_title"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="20dp"/>
            <FrameLayout
                android:id="@+id/layout_action_container"
                android:paddingBottom="44dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp">
                <LinearLayout
                    android:layout_gravity="end|bottom"
                    android:orientation="horizontal"
                    android:id="@+id/layout_action_single"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_single"
                        android:background="@drawable/bg_home_space_action_primary"
                        android:layout_width="148dp"
                        android:layout_height="44dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/layout_action_double"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#99ffffff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_double_primary"
                        android:background="@drawable/bg_home_space_action_secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_double_secondary"
                        android:background="@drawable/bg_home_space_action_primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/layout_action_triple"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#e6ffffff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_triple_primary"
                        android:background="@drawable/bg_home_space_action_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#e6ffffff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_triple_secondary"
                        android:background="@drawable/bg_home_space_action_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#e6ffffff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/btn_action_triple_tertiary"
                        android:background="@drawable/bg_home_space_action_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:textSize="9sp"
            android:textColor="#66ffffff"
            android:layout_gravity="start|bottom"
            android:id="@+id/tv_ai_generated"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/home_space_ai_generated"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="20dp"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
