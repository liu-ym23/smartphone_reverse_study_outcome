<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/express_auth_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_gravity="bottom|center_horizontal"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="41dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/express_auth_card"
            android:background="@drawable/bg_express_auth_dialog"
            android:paddingTop="38dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/express_auth_title_text"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/express_auth_title"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/express_auth_body_text"
                android:id="@+id/express_auth_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/express_auth_intro"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/express_auth_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/express_auth_perm_screen_title"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/express_auth_body_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/express_auth_perm_screen_desc"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/express_auth_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/express_auth_perm_mic_title"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/express_auth_body_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/express_auth_perm_mic_desc"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:baselineAligned="false">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/express_auth_btn_text"
                    android:gravity="center"
                    android:id="@+id/express_auth_refuse"
                    android:background="@drawable/bg_express_auth_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/express_auth_refuse"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp"/>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/express_auth_btn_text"
                    android:gravity="center"
                    android:id="@+id/express_auth_agree"
                    android:background="@drawable/bg_express_auth_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/express_auth_agree"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
