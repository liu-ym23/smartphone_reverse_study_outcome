<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_tti_card_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/bg_taskstore_card_medium_icon"
            android:layout_width="@dimen/taskstore_card_medium_icon_chip"
            android:layout_height="@dimen/taskstore_card_medium_icon_chip">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_tti_card_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_taskstore_tasktype_image"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_tti_card_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="@dimen/taskstore_card_medium_title_size"
                android:textColor="@color/taskstore_card_medium_title"
                android:ellipsize="end"
                android:id="@+id/tv_tti_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_tti_card_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.stepos.ailauncher.common.widget.SweepTextView
                    android:textSize="@dimen/taskstore_card_medium_subtitle_size"
                    android:textColor="@color/taskstore_card_status_success"
                    android:ellipsize="end"
                    android:id="@+id/tv_tti_card_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    app:sweepEnabled="false"/>
                <TextView
                    android:textSize="@dimen/taskstore_card_medium_subtitle_size"
                    android:textColor="@color/taskstore_card_medium_subtitle"
                    android:ellipsize="end"
                    android:id="@+id/tv_tti_card_toolcall_name"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tti_card_visual"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stepos.agentframework.chatui.view.NestedScrollableHost
            android:id="@+id/layout_tti_card_single_image"
            android:visibility="visible"
            android:layout_width="@dimen/taskstore_card_tti_multi_item_size"
            android:layout_height="@dimen/taskstore_card_tti_multi_item_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:background="@drawable/bg_taskstore_card_tti_image_round"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToOutline="true">
                <com.stepos.ailauncher.taskstore.widget.HalftoneShaderView
                    android:id="@+id/shader_tti_card_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/iv_tti_card_result_image"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"/>
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/layout_tti_card_generating_overlay"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/taskstore_card_tti_progress_text_size"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_tti_card_generating_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/layout_tti_card_fail_overlay"
                    android:background="@drawable/bg_taskstore_card_tti_fail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_tti_card_fail_icon"
                        android:layout_width="@dimen/taskstore_card_tti_fail_icon_size"
                        android:layout_height="@dimen/taskstore_card_tti_fail_icon_size"
                        android:src="@drawable/ic_taskstore_tti_fail"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/layout_tti_card_expired_overlay"
                    android:background="@drawable/bg_taskstore_card_tti_fail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/taskstore_card_tti_expired_text_size"
                        android:textColor="@color/taskstore_card_tti_expired_text"
                        android:layout_gravity="center"
                        android:id="@+id/tv_tti_card_expired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/taskstore_tti_expired_or_missing"
                        android:includeFontPadding="false"/>
                </FrameLayout>
            </FrameLayout>
        </com.stepos.agentframework.chatui.view.NestedScrollableHost>
        <com.stepos.agentframework.chatui.view.NestedScrollableHost
            android:id="@+id/host_tti_card_multi_image"
            android:background="@drawable/bg_taskstore_card_tti_multi_container_start_round"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/taskstore_card_tti_multi_item_size"
            android:clipToOutline="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tti_card_multi_image"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.stepos.agentframework.chatui.view.NestedScrollableHost>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_tti_card_action_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/taskstore_card_action_height"
        android:layout_marginTop="@dimen/taskstore_card_medium_failed_action_gap">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:gravity="center"
            android:id="@+id/btn_tti_card_action"
            android:background="@drawable/bg_taskstore_action_pill_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
