<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oobe_dark_bg"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:steposTitle="@string/oobe_sdk_init_name_step"
        app:steposTitleTextColor="@color/oobe_step_text"
        style="@style/Oobe.TitleBar.Text"/>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/oobe_agreement_text_primary"
        android:gravity="center"
        android:id="@+id/tv_question"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/oobe_sdk_init_name_question"
        android:paddingHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/oobe_agreement_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/et_name"
        android:background="@drawable/bg_oobe_name_input"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/oobe_name_system_cursor"
        android:layout_marginHorizontal="40dp"
        android:paddingHorizontal="16dp"
        android:importantForAutofill="no"
        android:lineHeight="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_question"/>
    <ImageButton
        android:id="@+id/btn_next"
        android:background="@drawable/bg_oobe_next_circle"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="42dp"
        android:src="@drawable/ic_oobe_next_chevron"
        android:scaleType="center"
        android:contentDescription="@string/oobe_next"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
