<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_taskstore_card_medium"
    android:paddingTop="@dimen/taskstore_card_medium_padding"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/taskstore_card_medium_padding"
    android:paddingEnd="@dimen/taskstore_card_medium_padding"
    android:clipToOutline="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_medium_card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="@dimen/taskstore_card_medium_icon_chip"
            android:layout_height="@dimen/taskstore_card_medium_icon_chip">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_medium_card_icon"
                android:layout_width="@dimen/taskstore_card_medium_icon_chip"
                android:layout_height="@dimen/taskstore_card_medium_icon_chip"
                android:src="@drawable/ic_taskstore_tasktype_loading"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_medium_card_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="@dimen/taskstore_card_medium_title_size"
                android:textColor="@color/taskstore_card_medium_title"
                android:ellipsize="end"
                android:id="@+id/tv_medium_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_medium_card_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.stepos.ailauncher.common.widget.SweepTextView
                    android:textSize="@dimen/taskstore_card_medium_subtitle_size"
                    android:textColor="@color/taskstore_card_status_success"
                    android:ellipsize="end"
                    android:id="@+id/tv_medium_card_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    app:sweepEnabled="false"/>
                <TextView
                    android:textSize="@dimen/taskstore_card_medium_subtitle_size"
                    android:textColor="@color/taskstore_card_medium_subtitle"
                    android:ellipsize="end"
                    android:id="@+id/tv_medium_card_toolcall_name"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_medium_card_visual"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/taskstore_card_medium_visual_height"
        android:layout_marginTop="8dp">
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_medium_card_decoration"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/taskstore_card_medium_decoration_width"
            android:layout_height="@dimen/taskstore_card_medium_decoration_height"
            android:src="@drawable/ic_taskstore_task_card_decoration_loading"
            android:scaleType="fitEnd"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_medium_card_action_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/taskstore_card_action_height"
        android:layout_marginTop="@dimen/taskstore_card_medium_failed_action_gap"
        android:layout_marginBottom="16dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:gravity="center"
            android:id="@+id/btn_medium_card_action"
            android:background="@drawable/bg_taskstore_action_pill_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_medium_card_actions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taskstore_card_medium_action_gap"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_medium_card_action_single"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_single"
                android:background="@drawable/bg_taskstore_action_pill_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_medium_card_action_double"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_double_primary"
                android:background="@drawable/bg_taskstore_action_pill_secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_double_secondary"
                android:background="@drawable/bg_taskstore_action_pill_primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_medium_card_action_triple"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_triple_primary"
                android:background="@drawable/bg_taskstore_action_pill_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_triple_secondary"
                android:background="@drawable/bg_taskstore_action_pill_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_medium_card_action_triple_tertiary"
                android:background="@drawable/bg_taskstore_action_pill_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/taskstore_card_action_height"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
