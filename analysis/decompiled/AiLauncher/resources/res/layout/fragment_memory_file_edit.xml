<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_repair_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back"
            android:background="@drawable/bg_top_bar_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_left_arrow"
            android:layout_centerVertical="true"
            android:contentDescription="返回"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textFontWeight="580"/>
        <ImageView
            android:id="@+id/btn_more"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_ellipsis_horizontal"
            android:layout_centerVertical="true"
            android:contentDescription="更多"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layout_marginHorizontal="20dp">
        <EditText
            android:textSize="15sp"
            android:textColor="#e6ffffff"
            android:textColorHint="#4dffffff"
            android:gravity="start|top"
            android:id="@+id/et_content"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:lineSpacingMultiplier="1.5"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"/>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#4dffffff"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/500"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_save"
            android:background="@drawable/bg_memory_save_button"
            android:layout_width="89dp"
            android:layout_height="44dp"
            android:text="@string/memory_edit_save"
            android:textFontWeight="500"/>
    </FrameLayout>
</LinearLayout>
