<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_session_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingTop="@dimen/ail_sheet_pager_page_top_inset"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_session_search_back"
            android:background="@drawable/bg_new_session_circle"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_new"
            android:scaleType="fitCenter"
            android:tint="@color/session_center_on_glass"
            android:contentDescription="@string/common_back"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/session_center_on_glass"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_session_search_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/session_search_result_title"
            android:textFontWeight="580"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_session_search"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty_session_search"
            android:paddingBottom="48dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_session_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chat_history_search"
                android:tint="@color/session_center_on_glass_third"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/session_center_on_glass_third"
                android:id="@+id/tv_session_search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/session_search_empty"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_session_search_bottom_bar"
        android:paddingTop="6dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/session_search_content"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat_history_search"
                android:tint="@color/session_center_on_glass_secondary"
                android:contentDescription="@null"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/session_center_on_glass"
                android:textColorHint="@color/session_center_on_glass_secondary"
                android:gravity="center_vertical"
                android:id="@+id/et_session_search"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/session_center_search_hint"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/cursor_session_search"
                android:layout_marginStart="4dp"
                android:importantForAutofill="no"/>
            <ImageView
                android:id="@+id/btn_session_search_clear"
                android:background="@drawable/bg_session_search_close_circle"
                android:padding="3dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_session_close"
                android:tint="@color/session_center_on_glass_secondary"
                android:contentDescription="@string/common_clear"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btn_session_search_close"
            android:background="@drawable/bg_new_session_circle"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_session_close"
            android:scaleType="fitCenter"
            android:contentDescription="@string/common_close"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</LinearLayout>
