<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_sent_file"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/doc_card_header"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">
        <ImageView
            android:id="@+id/iv_doc_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder_line_code"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_file_title"
            android:ellipsize="middle"
            android:id="@+id/tv_doc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/iv_doc_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_folder_chevron"
            android:contentDescription="@null"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/doc_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_doc_view_full"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_doc_view_full"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="10dp"/>
</LinearLayout>
