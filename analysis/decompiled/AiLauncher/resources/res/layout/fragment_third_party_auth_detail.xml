<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_repair_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:paddingTop="68dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <FrameLayout
                        android:background="@drawable/bg_auth_app_icon_tile"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:clipToOutline="true">
                        <ImageView
                            android:id="@+id/iv_app_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#fff5ede6"
                        android:id="@+id/tv_app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_auth_status_dot"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/third_party_auth_green_primary"
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/third_party_auth_status_authorized"
                            android:layout_marginStart="2dp"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="16dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_auth_detail_card"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#80ffffff"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/third_party_auth_detail_auth_time"
                            android:layout_weight="1"
                            android:lineHeight="20dp"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#e6ffffff"
                            android:id="@+id/tv_auth_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:lineHeight="20dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_key_section"
                        android:background="@drawable/bg_auth_detail_card"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#80ffffff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/third_party_auth_detail_auth_key"
                            android:lineHeight="20dp"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/layout_key_fields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_auth_notices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="16dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/btn_save_key"
                android:background="@drawable/bg_auth_save_pill"
                android:visibility="gone"
                android:layout_width="274dp"
                android:layout_height="46dp"
                android:layout_marginBottom="12dp"
                android:text="@string/third_party_auth_detail_save_key"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/btn_revoke"
                android:background="@drawable/bg_auth_revoke_pill"
                android:layout_width="274dp"
                android:layout_height="46dp"
                android:text="@string/third_party_auth_revoke_btn"
                android:textFontWeight="400"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="2dp"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btn_back"
            android:background="@drawable/bg_top_bar_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_left_arrow"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#e5ffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/third_party_auth_detail_title"
            android:textFontWeight="580"/>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/topChromeBlur"
        android:layout_width="match_parent"
        android:layout_height="76dp"/>
</FrameLayout>
