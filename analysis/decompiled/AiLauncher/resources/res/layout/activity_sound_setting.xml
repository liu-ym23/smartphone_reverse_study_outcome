<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/chat_color_surface"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/view_setting_top_bar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/chat_color_setting_summary"
        android:id="@+id/tvSoundHeader"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sound_setting_header"
        android:paddingHorizontal="32dp"
        android:lineHeight="20sp"/>
    <FrameLayout
        android:background="@drawable/bg_voice_setting_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:clipToOutline="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVoiceList"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingVertical="4dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pbVoiceLoading"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_color_on_surface_variant"
            android:layout_gravity="center"
            android:id="@+id/tvVoiceErrorState"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"/>
    </FrameLayout>
</LinearLayout>
