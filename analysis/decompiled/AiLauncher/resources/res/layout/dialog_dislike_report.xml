<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.agentframework.chatui.dialog.FeedbackDragDismissLayout
        android:id="@+id/dislike_content_root"
        android:background="@drawable/bg_dislike_feedback_dialog"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:forceDarkAllowed="false">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/agent_text_primary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_dislike_feedback_title"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_close"/>
        <View
            android:id="@+id/header_drag_zone"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/scroll_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_close"
            android:background="@drawable/bg_dislike_close"
            android:padding="11dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_close_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_reasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
                <com.stepos.agentframework.chatui.dialog.FeedbackInputScrollView
                    android:scrollbarSize="2dp"
                    android:scrollbarThumbVertical="@drawable/feedback_input_scrollbar_thumb"
                    android:scrollbarStyle="insideOverlay"
                    android:id="@+id/feedback_input_scroll"
                    android:background="@drawable/bg_input_dislike_feedback"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="vertical"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:fillViewport="true"
                    android:fadeScrollbars="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingEnd="4dp"
                    android:clipToOutline="true">
                    <EditText
                        android:textSize="16sp"
                        android:textColor="@color/agent_text_primary"
                        android:textColorHint="@color/agent_text_hint"
                        android:gravity="start|top"
                        android:id="@+id/et_feedback"
                        android:background="@null"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/report_hint"
                        android:inputType="textMultiLine"
                        android:fontFamily="sans-serif"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"/>
                </com.stepos.agentframework.chatui.dialog.FeedbackInputScrollView>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/dislike_submit_text"
                    android:gravity="center"
                    android:id="@+id/btn_submit"
                    android:background="@drawable/bg_btn_submit_selector"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/chat_dislike_feedback_submit"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/top_fade"
            android:background="@drawable/bg_scroll_top_fade"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            app:layout_constraintEnd_toEndOf="@+id/scroll_content"
            app:layout_constraintStart_toStartOf="@+id/scroll_content"
            app:layout_constraintTop_toTopOf="@+id/scroll_content"/>
    </com.stepos.agentframework.chatui.dialog.FeedbackDragDismissLayout>
</FrameLayout>
