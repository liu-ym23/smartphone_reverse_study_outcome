<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_layout"
    android:paddingBottom="@dimen/stepos_list_category_header_icon_margin_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/stepos_list_category_header_icon_height"
    android:paddingStart="@dimen/stepos_list_publish_padding"
    android:paddingEnd="@dimen/stepos_list_category_header_normal_padding_end">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.H11.Medium"
        android:textColor="?attr/steposThemeColorMoreClick"
        android:gravity="bottom"
        android:id="@android:id/text2"
        android:paddingTop="@dimen/stepos_list_category_header_normal_H4_more_padding_vertical"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/stepos_list_category_header_icon_height"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/stepos_list_category_header_normal_H4_more_padding_horizontal"
        android:paddingEnd="@dimen/stepos_list_category_header_normal_H4_more_padding_horizontal"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.list.Category.Title"
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="5dp"
        android:layout_toStartOf="@android:id/text2"
        android:layout_toEndOf="@+id/icon"/>
</RelativeLayout>
