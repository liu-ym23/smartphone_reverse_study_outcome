<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/result_viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.ailauncher.task.detail.TaskWebView
            android:id="@+id/result_web"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/result_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <ScrollView
            android:id="@+id/result_fallback_scroll"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/result_fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>
        <ScrollView
            android:id="@+id/result_folder_scroll"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/result_folder_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <FrameLayout
            android:id="@+id/result_invalid"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/result_invalid_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_artifact_invalid_warning"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#80ffffff"
                    android:gravity="center"
                    android:id="@+id/result_invalid_reason"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:gravity="center"
                    android:id="@+id/result_invalid_retry"
                    android:background="@drawable/bg_artifact_invalid_retry"
                    android:layout_width="96dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/task_detail_retry"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/result_render_mask"
            android:background="@color/artifact_detail_panel_bg"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/result_render_mask_snapshot"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/result_render_mask_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.stepos.ailauncher.common.widget.SweepTextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_detail_preview_loading"
                    app:sweepEnabled="true"/>
            </LinearLayout>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/result_render_mask_progress"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="#ffffffff"
                style="?android:attr/progressBarStyle"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
