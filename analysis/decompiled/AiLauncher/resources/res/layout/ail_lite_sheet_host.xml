<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ail_sheet_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ail_dim_view"
        android:background="@color/ail_dim_scrim"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.stepos.ailauncher.sheet.widget.DraggableSheetLayout
        android:id="@+id/ail_sheet_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ail_sheet_panel"
            android:background="@drawable/ail_bg_sheet"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="8dp"
            android:clipToOutline="true">
            <FrameLayout
                android:id="@+id/ail_content_container"
                android:paddingTop="@dimen/ail_sheet_content_top_inset"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ail_sheet_hint_text"
                android:gravity="center"
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/ail_settle_hint"
                android:paddingTop="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <FrameLayout
                android:layout_gravity="top"
                android:id="@+id/ail_drag_handle"
                android:focusable="true"
                android:clickable="true"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ail_sheet_pager_page_top_inset"
                android:alpha="0.34"
                android:importantForAccessibility="no"
                android:translationZ="24dp"
                android:outlineProvider="none">
                <View
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/ail_bg_handle"
                    android:clickable="false"
                    android:layout_width="@dimen/ail_sheet_handle_width"
                    android:layout_height="@dimen/ail_sheet_handle_height"
                    android:layout_marginTop="@dimen/ail_sheet_top_padding"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>
    </com.stepos.ailauncher.sheet.widget.DraggableSheetLayout>
</FrameLayout>
