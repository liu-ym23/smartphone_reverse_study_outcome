<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_file"
    android:background="@drawable/bg_sent_file"
    android:layout_width="200dp"
    android:layout_height="72dp"
    android:paddingHorizontal="12dp">
    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_folder_line_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/chat_file_title"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_file_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_file_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_file_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/chat_file_subtitle"
        android:id="@+id/tv_file_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_file_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_file_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/chat_file_subtitle"
        android:id="@+id/tv_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_file_type"
        app:layout_constraintStart_toEndOf="@+id/tv_file_type"
        app:layout_constraintTop_toTopOf="@+id/tv_file_type"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/chat_file_subtitle"
        android:id="@+id/tv_file_size"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_file_type"
        app:layout_constraintStart_toEndOf="@+id/tv_dot"
        app:layout_constraintTop_toTopOf="@+id/tv_file_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
