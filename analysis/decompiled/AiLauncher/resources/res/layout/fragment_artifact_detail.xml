<?xml version="1.0" encoding="utf-8"?>
<com.stepos.ailauncher.chat.view.ImeDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.ailauncher.task.detail.render.ArtifactContentView
        android:id="@+id/artifact_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0.5dp"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/topScrim"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/artifact_detail_top_scrim_height"
        android:alpha="0"
        android:importantForAccessibility="no"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottomScrim"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/artifact_detail_bottom_scrim_height"
        android:alpha="0"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/savedSnackbar"
        android:background="@drawable/bg_artifact_detail_snackbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/artifact_detail_snackbar_height"
        android:layout_marginBottom="@dimen/artifact_detail_snackbar_margin_bottom"
        android:paddingStart="@dimen/artifact_detail_snackbar_padding_horizontal"
        android:paddingEnd="@dimen/artifact_detail_snackbar_padding_horizontal"
        android:layout_marginStart="@dimen/artifact_detail_snackbar_margin_horizontal"
        android:layout_marginEnd="@dimen/artifact_detail_snackbar_margin_horizontal"
        android:elevation="4dp"
        android:outlineSpotShadowColor="@color/artifact_detail_snackbar_shadow"
        android:outlineAmbientShadowColor="@color/artifact_detail_snackbar_shadow">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/artifact_detail_snackbar_message"
            android:ellipsize="end"
            android:id="@+id/savedSnackbarMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_detail_saved"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/artifact_detail_snackbar_action"
            android:gravity="center"
            android:id="@+id/savedSnackbarAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/task_space_action_view"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/artifact_detail_snackbar_action_gap"
            android:textFontWeight="500"/>
    </LinearLayout>
    <com.stepos.ailauncher.task.detail.chrome.ArtifactDetailTopBar
        android:layout_gravity="top"
        android:id="@+id/artifact_topbar"
        android:paddingTop="@dimen/artifact_detail_topbar_padding_top"
        android:paddingBottom="@dimen/artifact_detail_topbar_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingHorizontal="@dimen/artifact_detail_topbar_padding_horizontal"/>
    <com.stepos.ailauncher.common.widget.SweepTextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:ellipsize="end"
        android:layout_gravity="start|bottom"
        android:id="@+id/tv_chip_status"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/artifact_detail_chip_margin_bottom"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="10dp"
        android:lineHeight="24sp"
        app:sweepEnabled="false"/>
    <FrameLayout
        android:id="@+id/downloadOverlay"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleLarge"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/task_detail_downloading"/>
        </LinearLayout>
    </FrameLayout>
</com.stepos.ailauncher.chat.view.ImeDismissFrameLayout>
