<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/title_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/stepos_list_category_header_normal_large_height"
        android:paddingStart="@dimen/stepos_list_publish_padding"
        android:paddingEnd="@dimen/stepos_list_category_header_normal_padding_end">
        <TextView
            android:textAppearance="@style/TextAppearance.StepOS.H11.Medium"
            android:textColor="?attr/colorPrimary"
            android:gravity="bottom"
            android:id="@android:id/text2"
            android:paddingTop="@dimen/stepos_list_category_header_normal_H4_more_padding_vertical"
            android:paddingBottom="@dimen/stepos_list_category_header_normal_H4_more_padding_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/stepos_list_category_header_normal_large_height"
            android:includeFontPadding="true"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/stepos_list_category_header_normal_H4_more_padding_horizontal"
            android:paddingEnd="@dimen/stepos_list_category_header_normal_H4_more_padding_horizontal"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.StepOS.list.Category.Title.Large"
            android:id="@android:id/text1"
            android:paddingTop="@dimen/stepos_list_category_header_normal_bold_margin_bottom"
            android:paddingBottom="@dimen/stepos_list_category_header_normal_bold_margin_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="true"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@android:id/text2"/>
    </RelativeLayout>
    <ImageView
        android:gravity="bottom"
        android:id="@android:id/background"
        android:background="@drawable/stepos_card_new_list_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_group_interval_header_divider_height"
        android:layout_marginStart="@dimen/stepos_list_publish_padding"
        android:layout_marginEnd="@dimen/stepos_list_publish_padding"/>
</LinearLayout>
