<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/Widget.StepOS.Shadow.Large">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/stepos_complete_toast_background_padding"
        android:paddingBottom="@dimen/stepos_complete_toast_background_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="144dp"
        android:paddingStart="@dimen/stepos_complete_toast_text_margin_horizontal"
        android:paddingEnd="@dimen/stepos_complete_toast_text_margin_horizontal">
        <ImageView
            android:id="@+id/toast_complete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="@dimen/stepos_complete_toast_icon_margin_bottom"
            android:src="@drawable/stepos_btn_check_button_square_on_toast"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="142dp"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
