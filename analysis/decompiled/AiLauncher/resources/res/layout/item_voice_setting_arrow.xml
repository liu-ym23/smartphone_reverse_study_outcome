<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_voice_setting_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/chat_color_setting_title"
            android:gravity="center_vertical"
            android:id="@+id/tvSettingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:lineHeight="28sp"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/chat_color_setting_summary"
            android:id="@+id/tvSettingSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineHeight="20sp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivArrowRight"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right_gray"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"/>
</LinearLayout>
