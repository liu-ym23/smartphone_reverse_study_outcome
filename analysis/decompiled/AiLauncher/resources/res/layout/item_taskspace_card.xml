<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/task_space_card_height">
    <View
        android:id="@+id/taskSpaceCardBlurBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/taskSpaceCardBaseBg"
        android:background="@drawable/bg_taskspace_card_blur_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/bg_taskspace_card_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/task_space_card_padding_vertical"
        android:paddingBottom="@dimen/task_space_card_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/task_space_card_padding_horizontal"
        android:paddingEnd="@dimen/task_space_card_padding_horizontal">
        <FrameLayout
            android:background="@drawable/bg_taskspace_card_icon"
            android:layout_width="@dimen/task_space_card_icon_container_size"
            android:layout_height="@dimen/task_space_card_icon_container_size">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/taskSpaceCardIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_taskspace_type_graph"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:maxWidth="@dimen/task_space_card_icon_size"
                android:maxHeight="@dimen/task_space_card_icon_size"
                android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/task_space_card_icon_gap">
            <TextView
                android:textSize="@dimen/task_space_card_title_text_size"
                android:textColor="@color/task_space_page_text_primary"
                android:ellipsize="end"
                android:id="@+id/taskSpaceCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">
                <com.stepos.ailauncher.common.widget.SweepTextView
                    android:textSize="@dimen/task_space_card_status_text_size"
                    android:id="@+id/taskSpaceCardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    app:sweepEnabled="false"/>
                <TextView
                    android:textSize="@dimen/task_space_card_status_text_size"
                    android:textColor="@color/task_space_page_text_status_desc"
                    android:ellipsize="end"
                    android:id="@+id/taskSpaceCardDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/task_space_status_desc_gap"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/taskSpaceCardCheckboxSlot"
            android:visibility="gone"
            android:layout_width="@dimen/task_space_checkbox_slot_size"
            android:layout_height="@dimen/task_space_checkbox_slot_size"
            android:layout_marginStart="@dimen/task_space_checkbox_margin_start">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/taskSpaceCardCheckbox"
                android:layout_width="@dimen/task_space_checkbox_selected_size"
                android:layout_height="@dimen/task_space_checkbox_selected_size"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
        </FrameLayout>
        <TextView
            android:id="@+id/taskSpaceCardAction"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </LinearLayout>
</FrameLayout>
