<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="1dp"
    android:paddingHorizontal="16dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_drawer_item_content"
        android:background="@drawable/bg_drawer_title_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">
        <com.stepos.ailauncher.chat.view.ShimmerTextView
            android:textSize="16sp"
            android:textColor="@color/session_center_on_glass"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:lineHeight="24sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/v_agent_label_divider"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.StepOS.IconList.Title.Multiple"/>
        <View
            android:id="@+id/v_agent_label_divider"
            android:background="#1affffff"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_agent_label"
            app:layout_constraintStart_toEndOf="@android:id/text1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/session_center_on_glass_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_agent_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_session_status"
            app:layout_constraintStart_toEndOf="@+id/v_agent_label_divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_session_status"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
