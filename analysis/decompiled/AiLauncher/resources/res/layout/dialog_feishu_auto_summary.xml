<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_overlay"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_card"
        android:background="@drawable/bg_feishu_auto_summary_dialog"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/feishu_logo"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/feishu_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/feishu_cli_auto_summary_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/feishu_text_secondary"
            android:gravity="center"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/feishu_cli_auto_summary_desc"
            android:lineSpacingExtra="4dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/feishu_text_primary"
                android:gravity="center"
                android:id="@+id/btn_later"
                android:background="@drawable/bg_feishu_dialog_btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/feishu_cli_auto_summary_later"
                android:layout_weight="1"/>
            <View
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_try_now"
                android:background="@drawable/bg_feishu_dialog_btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/feishu_cli_auto_summary_try_now"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
