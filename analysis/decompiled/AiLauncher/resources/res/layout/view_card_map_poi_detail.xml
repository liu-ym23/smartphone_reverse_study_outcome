<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_card_map_shell"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPoiDetail"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/flGallery"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_map_poi_detail_gallery_height">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/llGalleryDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <ImageView
                    android:layout_gravity="end|top"
                    android:id="@+id/ivGalleryClose"
                    android:background="@drawable/bg_card_map_close"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="12dp"
                    android:src="@drawable/ic_card_map_close"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/card_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tvPoiName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/card_map_poi_meta"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tvPoiMeta"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:id="@+id/tvPoiRating"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <TextView
                    android:id="@+id/tvPoiReviewCount"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llPoiInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rowPoiAddress"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_poi_detail_pin"
                            android:tint="@color/card_text_primary"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/card_text_primary"
                            android:id="@+id/tvPoiAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rowPoiHours"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_poi_detail_clock"
                            android:tint="@color/card_text_primary"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/card_text_primary"
                            android:id="@+id/tvPoiHours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rowPoiPrice"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_poi_detail_price"
                            android:tint="@color/card_text_primary"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/card_text_primary"
                            android:id="@+id/tvPoiPrice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rowPoiTip"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_poi_detail_crowd"
                            android:tint="@color/card_text_primary"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/card_text_primary"
                            android:id="@+id/tvPoiTip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowPoiDistance"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp">
                        <TextView
                            android:id="@+id/tvPoiDistance"
                            android:layout_width="0dp"
                            android:layout_height="0dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/rowPoiStatus"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp">
                        <TextView
                            android:id="@+id/tvPoiStatus"
                            android:layout_width="0dp"
                            android:layout_height="0dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/card_text_secondary"
                    android:id="@+id/tvPoiDescription"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/vPoiBottomFade"
        android:background="@drawable/bg_poi_detail_bottom_fade"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="160dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/flPoiFooter"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#ff1c1c1e"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btnPoiAction"
            android:background="@drawable/bg_poi_detail_footer_button"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="开始导航"
            android:paddingHorizontal="30dp"
            android:textFontWeight="500"/>
    </FrameLayout>
</FrameLayout>
