<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center_vertical"
        android:height="@dimen/stepos_seekbar_height">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/stepos_seekbar_radius"/>
            <solid android:color="@color/stepos_seekbar_background_color"/>
        </shape>
    </item>
    <item
        android:gravity="start|center_vertical"
        android:height="@dimen/stepos_seekbar_height"
        android:width="12dp">
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="@dimen/stepos_seekbar_radius"
                android:bottomRightRadius="@dimen/stepos_seekbar_radius"/>
            <solid android:color="@color/stepos_seekbar_thumb_state_color"/>
        </shape>
    </item>
</layer-list>
