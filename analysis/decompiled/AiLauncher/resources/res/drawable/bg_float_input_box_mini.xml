<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80ffa060"
                android:endColor="#80ffa060"
                android:angle="0"
                android:type="linear"
                android:centerColor="#33a0b0ff"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#121212"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0affffff"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</layer-list>
