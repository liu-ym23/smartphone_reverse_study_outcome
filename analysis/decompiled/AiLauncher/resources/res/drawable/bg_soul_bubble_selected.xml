<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1a35c44f"/>
            <stroke
                android:width="1dp"
                android:color="#3335c44f"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#00000000"
                android:endColor="#2635c44f"
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.35"
                android:gradientRadius="55dp"/>
        </shape>
    </item>
</layer-list>
