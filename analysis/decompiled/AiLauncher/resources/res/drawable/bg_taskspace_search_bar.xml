<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/task_space_search_bar_bg"/>
            <corners android:radius="@dimen/task_space_search_bar_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/task_space_search_bar_overlay"/>
            <corners android:radius="@dimen/task_space_search_bar_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/task_space_search_bar_radius"/>
            <stroke
                android:width="1dp"
                android:color="@color/task_space_search_bar_stroke"/>
        </shape>
    </item>
</layer-list>
