<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26ffffff">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/float_card_option_corner"/>
                    <solid android:color="@color/float_card_option_bg_selected"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/float_card_option_corner"/>
                    <solid android:color="@color/float_card_option_bg_default"/>
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/float_card_option_corner"/>
            <solid android:color="#ffffffff"/>
        </shape>
    </item>
</ripple>
