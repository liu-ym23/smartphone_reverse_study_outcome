<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <stepos.support.v7.widget.OverScrollLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.familyguard.ui.widget.MyRecyclerView
            android:id="@+id/recycler_view"
            android:paddingBottom="@dimen/fg_navigation_bar_top"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </stepos.support.v7.widget.OverScrollLayout>
    <RelativeLayout
        android:id="@+id/loadingViewLayout"
        android:background="@color/stepos_comp_background_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.common.widget.LoadingView
            android:id="@+id/loading_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/Widget.StepOSCommon.LoadingView.Light"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/us_loading"
            android:layout_below="@+id/loading_view"
            android:layout_centerHorizontal="true"
            style="@style/LoadingViewTextStyle.Light"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/mask"
        android:background="@color/stepos_comp_background_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aicy_request_layer"
        android:background="@color/stepos_comp_background_primary"
        android:paddingBottom="@dimen/fg_action_bar_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="19sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/aicy_request_layer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/us_enable_this_service"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toTopOf="@+id/aicy_request_layer_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:gravity="center"
            android:id="@+id/aicy_request_layer_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="19dp"
            android:text="@string/us_aicy_engine_request_message"
            android:layout_marginHorizontal="48dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/aicy_request_layer_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/aicy_request_layer_title"/>
        <com.stepos.common.widget.StepOSButton
            android:id="@+id/aicy_request_layer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fg_to_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/aicy_request_layer_message"
            style="@style/Widget.DeviceDefault.Light.Button.LightColor.Color.Blue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
