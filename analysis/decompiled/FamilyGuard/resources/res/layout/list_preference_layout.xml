<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        style="@style/Widget.StepOS.Preference.Immersive">
        <com.stepos.common.widget.SmoothCornerView
            android:id="@android:id/icon_frame"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/stepos_preference_icon_margin_horizontal"
            app:steposCornerRadius="@dimen/stepos_list_icon_item_icon_corner_radius"
            style="@style/Widget.StepOS.Preference.Icon">
            <ImageView
                android:id="@android:id/icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                style="@style/Widget.StepOS.Preference.Icon"/>
        </com.stepos.common.widget.SmoothCornerView>
        <TextView
            android:textAppearance="@style/TextAppearance.US.ListItem.Title"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:maxLines="3"
            android:layout_weight="1"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            style="@style/Widget.StepOS.Preference.Title"/>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.ListItem.Value"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@android:id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:maxLines="4"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@android:id/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/row_divider"
        android:background="?attr/colorOutlineVariant"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/us_stepos_list_item_padding"
        android:layout_marginEnd="@dimen/us_stepos_list_item_padding"/>
</FrameLayout>
