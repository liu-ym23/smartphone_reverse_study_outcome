<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="?attr/colorSurfaceBright"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="?attr/marginExtraHeavy"
        android:layout_marginBottom="24dp"
        android:src="@drawable/stepos_avastar_person_00"
        android:contentDescription="@string/mm_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="28sp"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="276dp"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"
        style="@style/TextAppearance.FG.HeadLine.14"/>
    <ImageView
        android:id="@+id/btn_edit_name"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/stepos_titlebar_ic_edit"
        android:alpha="0.2"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/name"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="@+id/name"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/layout_birth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/name">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_birth_type"
            android:background="@drawable/fg_immersive_item_bkg_head"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="@dimen/common_hori_margin">
            <TextView
                android:id="@+id/txt_birth_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mm_type_birth_date"
                android:layout_weight="1"
                style="@style/TextAppearance.FG.HeadLine.17"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/down_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_birth_value"
            android:background="@drawable/fg_immersive_item_bkg_foot"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="@dimen/common_hori_margin">
            <TextView
                android:id="@+id/txt_birth_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextAppearance.FG.HeadLine.17"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/down_arrow"/>
        </LinearLayout>
    </LinearLayout>
    <com.stepos.widget.button.StepOSButton
        android:id="@+id/btn_save"
        android:layout_width="288dp"
        android:layout_height="@dimen/stepos_button_height"
        android:layout_marginBottom="@dimen/common_bottom_margin"
        android:text="@string/mm_add_minor_confirm"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/StepOSWidget.Button.Blue"/>
</androidx.constraintlayout.widget.ConstraintLayout>
