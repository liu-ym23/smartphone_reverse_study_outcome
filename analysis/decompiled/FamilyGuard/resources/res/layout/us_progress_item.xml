<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/us_stepos_list_item_padding"
    android:paddingEnd="@dimen/us_stepos_list_item_padding">
    <com.stepos.familyguard.ui.widget.RoundedImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/us_progress_item_image_size"
        android:layout_height="@dimen/us_progress_item_image_size"
        android:layout_marginTop="19dp"
        android:layout_marginBottom="19dp"
        app:enable_border="true"
        app:img_border_color="?attr/colorOutlineVariant"
        app:img_border_width="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.US.ListItem.Title"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/us_progress_item_margin_v"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="?attr/marginSmall"
        app:layout_constraintEnd_toStartOf="@+id/limit"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.US.List.Label"
        android:id="@+id/limit"
        android:background="@drawable/us_progress_item_limit_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/us_limited"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="?attr/marginMini"
        android:paddingVertical="?attr/marginExtraMini"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginExtraMini"
        android:layout_marginBottom="@dimen/us_progress_item_margin_v"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0">
        <com.stepos.familyguard.ui.widget.ProgressBar
            android:id="@+id/progress"
            android:background="@drawable/us_progressbar_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/us_progress_item_progress_bar_height"
            android:maxWidth="@dimen/us_progress_max_width"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="@style/StepOSTextAppearance.ListItem.Subtitle"
            android:ellipsize="none"
            android:gravity="start"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="?attr/marginSmall"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="@dimen/stepos_list_item_accessory_size"
        android:layout_height="@dimen/stepos_list_item_accessory_size"
        android:src="@drawable/stepos_icon_arrow_right"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
