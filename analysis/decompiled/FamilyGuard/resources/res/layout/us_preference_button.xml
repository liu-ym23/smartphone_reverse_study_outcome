<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.StepOS.Preference.Immersive">
    <TextView
        android:textAppearance="@style/TextAppearance.US.ListItem.Title"
        android:textColor="@color/fg_text_click_theme"
        android:layout_gravity="start|center_vertical"
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/us_category_item_text_size"
        android:textColor="@color/us_preference_category_text_color"
        android:layout_gravity="end|center_vertical"
        android:id="@android:id/summary"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <ImageView
        android:id="@android:id/summary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</FrameLayout>
