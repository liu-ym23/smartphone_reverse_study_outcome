<?xml version="1.0" encoding="utf-8"?>
<com.stepos.familyguard.ui.widget.TimeDisplayView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:baselineAlignedChildIndex="2">
    <TextView
        android:id="@+id/digit_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/us_widget_digit_gap"
        style="@style/TextAppearance.US.Digital"/>
    <TextView
        android:id="@+id/digit_1_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/us_widget_digit_gap"
        style="@style/TextAppearance.US.Digital.Label"/>
    <TextView
        android:id="@+id/digit_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/us_widget_digit_gap"
        style="@style/TextAppearance.US.Digital"/>
    <TextView
        android:id="@+id/digit_2_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/us_widget_digit_gap"
        style="@style/TextAppearance.US.Digital.Label"/>
    <TextView
        android:id="@+id/digit_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/us_widget_digit_gap"
        style="@style/TextAppearance.US.Digital"/>
    <TextView
        android:id="@+id/digit_3_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.US.Digital.Label"/>
</com.stepos.familyguard.ui.widget.TimeDisplayView>
