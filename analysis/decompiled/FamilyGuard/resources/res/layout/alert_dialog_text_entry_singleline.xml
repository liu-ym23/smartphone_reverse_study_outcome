<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stepos.common.widget.StepOSEditInputView
        android:id="@+id/stepos_edit_input_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mm_input_minor_name"
        android:inputType="text"
        android:layout_marginHorizontal="20dp"
        app:contentLayout="@layout/native_edit_input_layout2"
        app:editPaddingEnd="50dp"
        app:editPaddingStart="12dp"
        app:inputContentPaddingEnd="3dp"
        app:showCleanIcon="true"
        style="@style/StepOSEditInputView"/>
</LinearLayout>
