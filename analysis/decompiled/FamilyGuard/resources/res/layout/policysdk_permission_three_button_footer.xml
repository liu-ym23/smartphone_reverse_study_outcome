<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/policysdk_three_button_footer"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/policysdk_three_btn_horizontal_margin"
    android:paddingEnd="@dimen/policysdk_three_btn_horizontal_margin">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/policy_sdk_three_btn_primary_text"
        android:gravity="center"
        android:id="@+id/policysdk_btn_full_agree"
        android:background="@drawable/policysdk_three_btn_primary_bg"
        android:paddingTop="@dimen/policysdk_three_btn_vertical_padding"
        android:paddingBottom="@dimen/policysdk_three_btn_vertical_padding"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/policysdk_three_btn_min_height"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorBrand"
        android:gravity="center"
        android:id="@+id/policysdk_btn_basic_only"
        android:background="@drawable/policysdk_three_btn_secondary_bg"
        android:paddingTop="@dimen/policysdk_three_btn_vertical_padding"
        android:paddingBottom="@dimen/policysdk_three_btn_vertical_padding"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/policysdk_three_btn_spacing"
        android:minHeight="@dimen/policysdk_three_btn_min_height"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorBrand"
        android:gravity="center"
        android:id="@+id/policysdk_btn_reject"
        android:background="@drawable/policysdk_three_btn_tertiary_bg"
        android:paddingTop="@dimen/policysdk_three_btn_vertical_padding"
        android:paddingBottom="@dimen/policysdk_three_btn_vertical_padding"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/policysdk_three_btn_spacing"
        android:minHeight="@dimen/policysdk_three_btn_min_height"/>
</LinearLayout>
