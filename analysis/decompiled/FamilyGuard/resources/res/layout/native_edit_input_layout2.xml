<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="@dimen/text_input_text_size"
        android:id="@+id/stepos_edit_content"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:minHeight="52dp"
        android:hint="@string/mm_title_minor_name"
        android:autofillHints="name"/>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/stepos_edit_clean"
        android:background="@drawable/stepos_text_input_layout_ic_clear"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
