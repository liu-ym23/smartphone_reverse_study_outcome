<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager_guide_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/guide_view_viewpager_margin_left"
        android:layout_marginEnd="@dimen/guide_view_viewpager_margin_right"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.guidepager.CirclePageIndicator
            android:id="@+id/indicator_guide_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/guide_view_indicator_bottom_margin"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="@dimen/guide_view_btn_text_size"
            android:gravity="center"
            android:id="@+id/tv_guide_view_cancel"
            android:layout_width="@dimen/guide_view_btn_width"
            android:layout_height="@dimen/guide_view_btn_height"
            android:layout_marginBottom="@dimen/guide_view_btn_bottom_margin"
            android:text="@string/guide_view_btn_cancel_text"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/Guide.pager.btn.DeviceDefault.Light.Button.Stroke"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/guide_view_skip_text_size"
        android:textColor="#b0000000"
        android:layout_gravity="end"
        android:id="@+id/guide_skip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/guide_text_view_skip_margin_top"
        android:text="@string/guide_view__text_skip"
        android:alpha="0.4"
        android:layout_marginEnd="@dimen/guide_text_view_skip_margin_right"
        style="@style/Widget.StepOS.Light.TextView.Normal.Medium"/>
</FrameLayout>
