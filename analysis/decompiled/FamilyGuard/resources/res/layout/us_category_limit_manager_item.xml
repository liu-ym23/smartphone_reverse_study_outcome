<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/us_stepos_list_item_padding"
    android:paddingEnd="@dimen/us_stepos_list_item_padding"
    app:layout_constrainedHeight="true">
    <com.stepos.familyguard.ui.widget.RoundedImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/us_progress_item_image_size"
        android:layout_height="@dimen/us_progress_item_image_size"
        android:contentDescription="@string/fg_add_icon"
        app:enable_border="true"
        app:img_border_color="?attr/colorOutlineVariant"
        app:img_border_width="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.US.ListItem.Title"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/limit"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextAppearance.US.ListItem.Subtitle"
        android:ellipsize="end"
        android:id="@+id/limit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginExtraMini"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="@dimen/stepos_list_item_accessory_size"
        android:layout_height="@dimen/stepos_list_item_accessory_size"
        android:src="@drawable/stepos_icon_arrow_right"
        android:scaleType="fitCenter"
        android:contentDescription="@string/fg_add_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/row_divider"
        android:background="?attr/colorOutlineVariant"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
