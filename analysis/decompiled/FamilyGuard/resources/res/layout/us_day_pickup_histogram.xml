<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="?attr/marginLarge"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/us_stepos_list_item_padding">
    <com.stepos.familyguard.ui.widget.chart.histogram.BalloonHistogramView
        android:id="@+id/day_histogram_view"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="242dp"
        app:averageColor="@color/us_pickup_average_color"
        app:averageStrokeWidth="1dp"
        app:averageText="@string/us_average"
        app:averageTextColor="@color/us_pickup_text_average_color"
        app:balloonLineColor="@color/us_balloon_line_color_pickup"
        app:dimensionAtStart="true"
        app:histogramStateColors="@array/us_pickup_state_colors"
        app:histogramWidth="?attr/marginSmall"
        app:hoverable="true"
        app:needAverage="true"
        app:selectable="false"
        app:topspace="82dp"
        app:xDimensionAlignType="dimension_align_center"
        app:xSegmentSize="4"
        app:yDimensionAlignType="dimension_align_center"
        app:ySegmentSize="2"
        style="@style/BalloonHistogram"/>
</FrameLayout>
