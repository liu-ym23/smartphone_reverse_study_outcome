<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_minor"
        android:background="@drawable/fg_immersive_item_bkg_alone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:minHeight="98dp"
        android:layout_marginHorizontal="@dimen/common_hori_margin"
        android:paddingVertical="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/stepos_avastar_person_00"
                android:contentDescription="@string/mm_avatar"
                android:layout_marginStart="@dimen/common_hori_margin"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/txt_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="欣欣"
                    android:maxLines="2"
                    style="@style/TextAppearance.FG.HeadLine.17"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/txt_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5 岁"
                    android:maxLines="1"
                    style="@style/TextAppearance.FG.HeadLine.14.DESC"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/btn_switch"
            android:padding="@dimen/common_hori_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:layout_gravity="center"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="@string/mm_switch_minor"
                style="@style/Theme.StepOS.AppCompat.Light.Color.Blue.WhiteTitleBar"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_use_duration"
        android:background="@drawable/fg_immersive_item_bkg_head"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="@dimen/common_top_margin"
        android:layout_marginHorizontal="@dimen/common_hori_margin">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_use_duration_title"
                style="@style/TextAppearance.FG.HeadLine.17"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_use_duration_desc"
                style="@style/TextAppearance.FG.HeadLine.14.DESC"/>
        </LinearLayout>
        <com.stepos.common.widget.ImageFontCompatView
            android:layout_gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fontTextColor="?attr/colorSurfaceContainerHighest"
            app:textResName="@string/icon_font_arrow_next"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_app_manage"
        android:background="@drawable/fg_immersive_item_bkg_middle"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginHorizontal="@dimen/common_hori_margin">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_app_manage_title"
                style="@style/TextAppearance.FG.HeadLine.17"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_app_manage_desc"
                style="@style/TextAppearance.FG.HeadLine.14.DESC"/>
        </LinearLayout>
        <com.stepos.common.widget.ImageFontCompatView
            android:layout_gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fontTextColor="?attr/colorSurfaceContainerHighest"
            app:textResName="@string/icon_font_arrow_next"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_whitelist"
        android:background="@drawable/fg_immersive_item_bkg_foot"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginHorizontal="@dimen/common_hori_margin">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_whitelist_title"
                style="@style/TextAppearance.FG.HeadLine.17"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_minor_whitelist_desc"
                style="@style/TextAppearance.FG.HeadLine.14.DESC"/>
        </LinearLayout>
        <com.stepos.common.widget.ImageFontCompatView
            android:layout_gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fontTextColor="?attr/colorSurfaceContainerHighest"
            app:textResName="@string/icon_font_arrow_next"/>
    </FrameLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.stepos.widget.button.StepOSButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_turn_off"
        android:layout_width="288dp"
        android:layout_height="@dimen/stepos_button_height"
        android:layout_marginBottom="@dimen/common_bottom_margin"
        android:text="@string/mm_turn_off_minor_mode"
        style="@style/StepOSWidget.Button.Secondary.Destructive"/>
</LinearLayout>
