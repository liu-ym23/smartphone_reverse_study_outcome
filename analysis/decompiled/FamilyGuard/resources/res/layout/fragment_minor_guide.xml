<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_start"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/mm_guide_fragment_margin_h"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_end"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/mm_guide_fragment_margin_h"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginHeavy"
        android:text="@string/fg_minor_title"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_end"
        app:layout_constraintStart_toStartOf="@+id/guide_line_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.FG.HeadLine"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/title_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginSmall"
        android:layout_marginBottom="24dp"
        android:text="@string/fg_minor_title_description"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_end"
        app:layout_constraintStart_toStartOf="@+id/guide_line_start"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/title_des_barrier_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="24dp"
        app:constraint_referenced_ids="title_des"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/content_barrier_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="48dp"
        app:constraint_referenced_ids="title_des_barrier_bottom"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Label.Large"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/content_usage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/fg_minor_title_duration_management"
        android:layout_marginStart="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/content_usage_icon"
        app:layout_constraintTop_toBottomOf="@+id/content_barrier_top"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/content_usage_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:text="@string/fg_minor_title_duration_management_description"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/content_app_title"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/content_usage_title"
        app:layout_constraintTop_toBottomOf="@+id/content_usage_title"/>
    <ImageView
        android:id="@+id/content_usage_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/svg_minor_duration"
        android:contentDescription="@string/mm_age_suffix"
        app:layout_constraintBottom_toBottomOf="@+id/content_usage_des"
        app:layout_constraintStart_toEndOf="@+id/guide_line_start"
        app:layout_constraintTop_toTopOf="@+id/content_usage_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Label.Large"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/content_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/fg_minor_title_Application_management"
        android:layout_marginStart="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/content_usage_icon"
        app:layout_constraintTop_toBottomOf="@+id/content_usage_des"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/content_app_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:text="@string/fg_minor_title_Application_management_description"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/content_app_title"
        app:layout_constraintTop_toBottomOf="@+id/content_app_title"/>
    <ImageView
        android:id="@+id/content_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/svg_minor_apply"
        android:contentDescription="@string/mm_age_suffix"
        app:layout_constraintBottom_toBottomOf="@+id/content_app_des"
        app:layout_constraintStart_toEndOf="@+id/guide_line_start"
        app:layout_constraintTop_toTopOf="@+id/content_app_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Label.Large"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/content_recommend_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/fg_minor_title_Content_recommendations"
        android:layout_marginStart="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/content_recommend_icon"
        app:layout_constraintTop_toBottomOf="@+id/content_app_des"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/content_recommend_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:text="@string/fg_minor_title_Content_recommendations_description"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/guide_line_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/content_recommend_title"
        app:layout_constraintTop_toBottomOf="@+id/content_recommend_title"/>
    <ImageView
        android:id="@+id/content_recommend_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/svg_minor_content_recommend"
        android:contentDescription="@string/mm_age_suffix"
        app:layout_constraintBottom_toBottomOf="@+id/content_recommend_des"
        app:layout_constraintStart_toEndOf="@+id/guide_line_start"
        app:layout_constraintTop_toTopOf="@+id/content_recommend_title"/>
    <com.stepos.widget.button.StepOSButton
        android:id="@+id/btn_try_it_now"
        android:layout_width="0dp"
        android:layout_height="@dimen/stepos_button_height"
        android:layout_marginBottom="80dp"
        android:text="@string/fg_minor_Try_it_now"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_end"
        app:layout_constraintStart_toStartOf="@+id/guide_line_start"
        style="@style/StepOSWidget.Button.Blue"/>
    <TextView
        android:textAppearance="@style/TextAppearance.FG.Des"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/tv_instructions_for_minors"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/marginMedium"
        android:text="@string/fg_minor_hint"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_try_it_now"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_end"
        app:layout_constraintStart_toStartOf="@+id/guide_line_start"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StepOS.Label.Large"
        android:textColor="?attr/colorPrimary"
        android:id="@+id/cancel_btn"
        android:padding="20dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mc_cancel"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
