<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/stepos_comp_background_primary"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_compact_height"
        app:steposTitle="@string/us_usage_limit"
        app:steposTitleGravity="center"
        style="@style/StepOSWidget.TitleBar.DigitalHealth"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tab_row"
        android:background="@drawable/us_limit_manager_tab_group_background"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/us_stepos_page_content_gap"
        android:layout_marginBottom="@dimen/us_stepos_page_content_gap"
        android:layout_marginHorizontal="@dimen/us_stepos_list_card_inset">
        <TextView
            android:textAppearance="@style/TextAppearance.US.Tab"
            android:textColor="@color/us_action_bar_capsule_tab_text_color"
            android:gravity="center"
            android:id="@+id/tab_app"
            android:background="@drawable/us_limit_manager_tab_background"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="@string/us_app"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="@style/TextAppearance.US.Tab"
            android:textColor="@color/us_action_bar_capsule_tab_text_color"
            android:gravity="center"
            android:id="@+id/tab_category"
            android:background="@drawable/us_limit_manager_tab_background"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="@string/us_category"
            android:layout_weight="1"/>
    </LinearLayout>
    <stepos.support.v4.view.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
