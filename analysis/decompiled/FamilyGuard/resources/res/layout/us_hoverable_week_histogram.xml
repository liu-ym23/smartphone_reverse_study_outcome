<?xml version="1.0" encoding="utf-8"?>
<com.stepos.familyguard.ui.widget.chart.histogram.BalloonHistogramView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/histogram_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:averageStrokeWidth="1dp"
    app:averageText="@string/us_average"
    app:balloonLineColor="@color/us_balloon_line_color_usage"
    app:histogramWidth="?attr/marginLarge"
    app:hoverable="true"
    app:hoveredDimensionTextColor="?attr/colorPrimary"
    app:minHistogramHeight="6dp"
    app:needAverage="true"
    app:roundRadio="3dp"
    app:selectable="false"
    app:topspace="@dimen/us_hoverable_histogram_balloon_top_space"
    app:xDimensionAlignType="dimension_align_center_between_tow_divider"
    app:xSegmentSize="7"
    app:yDimensionAlignType="dimension_align_center"
    app:ySegmentSize="1"
    style="@style/BalloonHistogram"/>
