<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/us_stepos_list_item_padding">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/date_container"
        android:paddingTop="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/marginSmall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            style="@style/StepOSTextAppearance.ListItem.Subtitle"/>
        <TextView
            android:id="@+id/week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/StepOSTextAppearance.ListItem.Subtitle"/>
    </LinearLayout>
    <include
        android:id="@+id/digit_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginSmall"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/des"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date_container"
        layout="@layout/us_digit_container"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/marginSmall"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/digit_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/digit_container"
        style="@style/TextAppearance.US.Des"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginTop="?attr/marginSmall"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/digit_container"/>
    <com.stepos.common.widget.PageIndicator
        android:layout_gravity="center_horizontal"
        android:id="@+id/horizontalPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginMedium"
        android:layout_marginBottom="?attr/marginLarge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_pager"/>
</androidx.constraintlayout.widget.ConstraintLayout>
