<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceBright"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_compact_height"
        app:steposTitleGravity="center"
        style="@style/StepOSWidget.TitleBar.DigitalHealth"/>
    <ScrollView
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.FG.HeadLine"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_title_large_margin"
                android:text="@string/fg_login_title"
                android:layout_marginStart="@dimen/login_title_large_margin"
                android:layout_marginEnd="@dimen/login_title_large_margin"/>
            <TextView
                android:textSize="@dimen/login_sub_title_size"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/marginMini"
                android:text="@string/fg_login_sub_title"
                android:layout_marginStart="@dimen/login_title_large_margin"
                android:layout_marginEnd="@dimen/login_title_large_margin"/>
            <com.stepos.common.widget.StepOSEditInputView
                android:id="@+id/input_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:hint="@string/mm_phone_number"
                android:inputType="phone"
                android:layout_marginHorizontal="?attr/marginLarge"
                app:contentLayout="@layout/fg_edit_text_layout_with_title"
                app:editPaddingEnd="@dimen/fg_edit_padding_medium"
                app:editPaddingStart="@dimen/fg_edit_padding_large"
                app:inputContentPaddingEnd="3dp"
                app:inputContentPaddingStart="?attr/marginRegular"
                app:showCleanIcon="true"
                app:title="+86"
                style="@style/StepOSEditInputView"/>
            <com.stepos.common.widget.StepOSEditInputView
                android:id="@+id/input_verify_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/marginExtraHeavy"
                android:hint="@string/mm_verify_code"
                android:inputType="number"
                android:layout_marginHorizontal="?attr/marginLarge"
                app:contentLayout="@layout/fg_edit_text_layout_with_get_verify_code"
                app:editPaddingEnd="@dimen/fg_edit_padding_large"
                app:editPaddingStart="?attr/marginRegular"
                app:inputContentPaddingEnd="?attr/marginRegular"
                app:inputContentPaddingStart="?attr/marginRegular"
                style="@style/StepOSEditInputView"/>
            <com.stepos.widget.button.StepOSButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/verify"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stepos_button_height"
                android:layout_marginTop="77dp"
                android:text="@string/fg_login"
                android:layout_marginStart="?attr/marginLarge"
                android:layout_marginEnd="?attr/marginLarge"
                style="@style/StepOSWidget.Button.Blue"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
