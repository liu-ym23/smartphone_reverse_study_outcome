<?xml version="1.0" encoding="utf-8"?>
<com.stepos.familyguard.ui.widget.chart.histogram.BalloonHistogramView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/day_histogram_view"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="228dp"
    android:layout_marginHorizontal="?attr/marginMedium"
    app:averageColor="?attr/usingTimeStateAverageColor"
    app:averageStrokeWidth="1dp"
    app:averageText="@string/us_average"
    app:averageTextColor="?attr/usingTimeStateAverageTextColor"
    app:balloonLineColor="?attr/usingTimeStateBalloonLineColor"
    app:balloonMarginBottom="3dp"
    app:categorical="false"
    app:dimensionAtStart="true"
    app:histogramStateColors="?attr/usingTimeStateColors"
    app:histogramWidth="?attr/marginLarge"
    app:hoverable="true"
    app:hoveredDimensionTextColor="?attr/usingTimeStateHoveredTextColor"
    app:needAverage="true"
    app:roundRadio="3dp"
    app:selectable="false"
    app:topspace="68dp"
    app:xDimensionAlignType="dimension_align_center_between_tow_divider"
    app:xSegmentSize="7"
    app:yDimensionAlignType="dimension_align_center"
    app:ySegmentSize="2"
    style="@style/BalloonHistogram"/>
