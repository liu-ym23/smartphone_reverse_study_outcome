<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/category_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/category_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/category_1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="?attr/marginSmall"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/category_1_color_indicator"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepOSTextAppearance.ListItem.Subtitle"/>
        <View
            android:id="@+id/category_1_color_indicator"
            android:background="@drawable/us_category_1_color_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/category_1_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/category_1_name"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/category_1_usage_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/marginMini"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@+id/category_1_name"
            app:layout_constraintTop_toBottomOf="@+id/category_1_name"
            style="@style/TextAppearance.US.Widget.Des.Small"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/category_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/marginSmall"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/category_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/category_1"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/category_2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="?attr/marginSmall"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/category_2_color_indicator"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepOSTextAppearance.ListItem.Subtitle"/>
        <View
            android:id="@+id/category_2_color_indicator"
            android:background="@drawable/us_category_2_color_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/category_2_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/category_2_name"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/category_2_usage_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/marginMini"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@+id/category_2_name"
            app:layout_constraintTop_toBottomOf="@+id/category_2_name"
            style="@style/TextAppearance.US.Widget.Des.Small"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/category_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/marginSmall"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/category_2"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/category_3_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="?attr/marginSmall"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/category_3_color_indicator"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepOSTextAppearance.ListItem.Subtitle"/>
        <View
            android:id="@+id/category_3_color_indicator"
            android:background="@drawable/us_category_3_color_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/category_3_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/category_3_name"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/category_3_usage_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/marginMini"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@+id/category_3_name"
            app:layout_constraintTop_toBottomOf="@+id/category_3_name"
            style="@style/TextAppearance.US.Widget.Des.Small"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
