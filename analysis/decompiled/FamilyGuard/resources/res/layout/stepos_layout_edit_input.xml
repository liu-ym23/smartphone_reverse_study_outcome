<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.textinputlayout.TextInputLayout
        android:textColorHint="@color/stepos_text_input_hint_color"
        android:id="@+id/stepos_edit_text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:alignEditContent="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:textSize="@dimen/text_input_text_size"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/stepos_edit_content"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"/>
    </com.stepos.textinputlayout.TextInputLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/stepos_edit_item_group"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#000000"
            android:id="@+id/stepos_edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/stepos_edit_space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/stepos_edit_clean"
            android:padding="12dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/stepos_text_input_layout_ic_clear"
            android:scaleType="fitXY"/>
        <View
            android:id="@+id/edit_divide0"
            android:background="?attr/colorOutlineVariant"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="3dp"/>
        <ImageView
            android:id="@+id/stepos_edit_password"
            android:padding="12dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/mc_edit_password_switch_background"
            android:scaleType="fitXY"/>
    </LinearLayout>
</FrameLayout>
