<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/us_using_stats_balloon_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/marginRegular"
    android:paddingVertical="?attr/marginSmall">
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/text2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.US.Digital.Balloon.Label"/>
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/marginMini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.US.Digital.Balloon.Label"/>
    <include
        android:id="@+id/usage_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/marginExtraMini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1"
        layout="@layout/us_balloon_digit_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
