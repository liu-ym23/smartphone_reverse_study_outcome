<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.textinputlayout.TextInputLayout
        android:textColorHint="@color/stepos_text_input_hint_color"
        android:id="@+id/stepos_edit_text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:alignEditContent="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:textSize="@dimen/text_input_text_size"
            android:id="@+id/stepos_edit_content"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            android:inputType="number"
            android:importantForAutofill="no"/>
    </com.stepos.textinputlayout.TextInputLayout>
    <FrameLayout
        android:id="@+id/stepos_edit_item_group"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textAppearance="@style/TextAppearance.StepOS.Body.Medium"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/stepos_edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</FrameLayout>
