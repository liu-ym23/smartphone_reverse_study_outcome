<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/stepos_recyclerview_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="66.6dp"
    android:paddingStart="@dimen/us_stepos_list_item_padding"
    android:paddingEnd="@dimen/us_stepos_list_item_padding">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/us_app_item_icon_size"
        android:layout_height="@dimen/us_app_item_icon_size"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/us_app_item_icon_margin_right"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/mask"
        android:layout_width="@dimen/us_app_item_icon_size"
        android:layout_height="@dimen/us_app_item_icon_size"
        android:src="@drawable/us_image_bg_radius_6"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/us_app_item_icon_margin_right"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="@dimen/stepos_list_item_accessory_size"
        android:layout_height="@dimen/stepos_list_item_accessory_size"
        android:src="@drawable/stepos_icon_arrow_right"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/arrow"
        android:layout_toEndOf="@+id/icon">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/us_app_item_primary_text_margin_bottom">
            <TextView
                android:textAppearance="@style/TextAppearance.US.ListItem.Title"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"/>
            <TextView
                android:textAppearance="@style/TextAppearance.US.List.Label"
                android:id="@+id/limit"
                android:background="@drawable/us_progress_item_limit_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_limited"
                android:layout_marginStart="?attr/marginSmall"
                android:paddingHorizontal="?attr/marginMini"
                android:paddingVertical="?attr/marginExtraMini"/>
            <View
                android:id="@+id/space"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/us_app_item_progressbar_description_margin_left">
            <com.stepos.familyguard.ui.widget.ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/progress"
                android:background="@drawable/us_usage_progressbar_drawable"
                android:layout_width="0dp"
                android:layout_height="@dimen/us_app_item_progressbar_height"
                android:layout_weight="1"/>
            <TextView
                android:textAppearance="@style/StepOSTextAppearance.ListItem.Subtitle"
                android:id="@+id/des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_marginStart="@dimen/us_app_item_progressbar_description_margin_left"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
