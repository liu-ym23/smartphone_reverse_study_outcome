<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/stepos_password_bottom_margin_horizontal"
    android:layout_marginEnd="@dimen/stepos_password_bottom_margin_horizontal">
    <com.stepos.widget.button.StepOSButton
        android:id="@+id/stepos_password_pad_left_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/stepos_button_bar_height"
        android:text="@android:string/cancel"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/stepos_password_bottom_button_gap"
        style="@style/StepOSWidget.Button.Secondary"/>
    <com.stepos.widget.button.StepOSButton
        android:id="@+id/stepos_password_pad_right_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/stepos_button_bar_height"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/stepos_password_bottom_button_gap"
        style="@style/StepOSWidget.Button.Secondary"/>
</LinearLayout>
