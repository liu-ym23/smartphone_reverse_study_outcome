<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.familyguard.ui.widget.MyRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:needDefaultFooter="true"
        app:needDefaultHeader="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_layer"
        android:background="@color/stepos_comp_background_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.82"/>
        <com.stepos.common.widget.StepOSPAGEmptyLayout
            android:layout_gravity="center"
            android:id="@+id/empty_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonDarkBackground="@drawable/mc_btn_corner_disable_pressed"
            app:buttonLightBackground="@drawable/mc_btn_corner_disable_pressed"
            app:hintText="@string/fg_no_search_result"
            app:path="assets://no_search_result.pag"
            app:showButton="false"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
