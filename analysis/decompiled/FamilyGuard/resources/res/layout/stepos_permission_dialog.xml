<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/permission_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/stepos_permission_dialog_checkbox"
        app:layout_constraintTop_toTopOf="parent">
        <stepos.support.v7.widget.CenterIfNeedTextView
            android:textSize="17sp"
            android:textColor="#ff000000"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/stepos_permission_dialog_title"
            android:paddingLeft="@dimen/stepos_alert_dialog_normal_margin_start"
            android:paddingTop="38dp"
            android:paddingRight="@dimen/stepos_alert_dialog_normal_margin_start"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <com.stepos.common.scrollview.StepOSNestedScrollView
            android:id="@+id/stepos_permission_dialog_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/stepos_permission_dialog_item_text_normal"
                    android:gravity="start"
                    android:id="@+id/stepos_permission_dialog_terms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
                    android:layout_marginEnd="@dimen/stepos_alert_dialog_normal_margin_end"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/stepos_permission_dialog_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="23dp"
                    android:layout_weight="1">
                    <View
                        android:id="@+id/stepos_permission_dialog_scroll_indicator_up"
                        android:background="#0d000000"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="2px"/>
                    <stepos.support.v7.widget.PermissionScrollView
                        android:id="@+id/stepos_permission_dialog_scroll_view"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="ifContentScrolls">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/stepos_permission_dialog_content_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </stepos.support.v7.widget.PermissionScrollView>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/stepos_permission_dialog_item_text_normal"
                        android:gravity="start"
                        android:id="@+id/stepos_permission_dialog_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/stepos_alert_dialog_normal_margin_start"
                        android:layout_marginTop="21dp"
                        android:layout_marginRight="@dimen/stepos_alert_dialog_normal_margin_end"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="5dp"/>
                    <View
                        android:id="@+id/stepos_permission_dialog_scroll_indicator_down"
                        android:background="#0d000000"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="2px"/>
                </LinearLayout>
            </LinearLayout>
        </com.stepos.common.scrollview.StepOSNestedScrollView>
        <com.stepos.common.scrollbarview.StepOSScrollBarView
            android:id="@+id/stepos_permission_dialog_scrollbarview_vertical"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:scrollBarThumbTint="@color/stepos_permission_dialog_scroll_bar_color"
            style="@style/Widget.StepOS.ScrollBarView.PermissionDialog"/>
    </RelativeLayout>
    <CheckBox
        android:textSize="15sp"
        android:textColor="@color/stepos_secondary_text_light"
        android:id="@+id/stepos_permission_dialog_checkbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:checked="false"
        android:button="@drawable/stepos_btn_check_button_brand_on_layer_mini"
        android:text="@string/stepos_permission_almost_deny"
        android:layout_marginStart="@dimen/stepos_alert_dialog_normal_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/permission_relative_layout"
        app:layout_constraintStart_toStartOf="@+id/permission_relative_layout"
        app:layout_constraintWidth_default="spread"
        style="@style/TextAppearance.StepOS.Body.Small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
