<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.FamilyGuard.AppWidget.Container">
    <RelativeLayout
        android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
        android:id="@+id/data_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/Widget.FamilyGuard.AppWidget.Container">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/total_usage_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_2x2_widget_margin_top_small_grid"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/us_2x2_widget_margin_start_small_grid"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/us_widget_digit_text_size_small_grid"
                android:id="@+id/hour_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:textSize="@dimen/us_widget_title_text_size_small_grid"
                android:id="@+id/hour_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_hour"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
            <TextView
                android:textSize="@dimen/us_widget_digit_text_size_small_grid"
                android:id="@+id/minute_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:textSize="@dimen/us_widget_title_text_size_small_grid"
                android:id="@+id/minute_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_minute"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
            <TextView
                android:textSize="@dimen/us_widget_digit_text_size_small_grid"
                android:id="@+id/second_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:textSize="@dimen/us_widget_title_text_size_small_grid"
                android:id="@+id/second_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_second"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/histogram_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_2x2_widget_histogram_img_margin_top"
            android:layout_marginBottom="@dimen/us_2x2_widget_margin_top_small_grid"
            android:scaleType="centerInside"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/add_widget"
            android:layout_marginStart="@dimen/us_2x2_widget_margin_start_small_grid"
            android:layout_marginEnd="@dimen/us_2x2_widget_margin_start_small_grid"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/error_layer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/us_widget_need_permission_text_color"
            android:layout_gravity="center"
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/us_widget_need_allow_permission"
            android:layout_marginHorizontal="@dimen/us_request_permission_text_margin_h"
            style="@style/TextAppearance.US.Widget.Label"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/empty_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/us_2x2_widget_histogram_empty"
            android:scaleType="matrix"
            android:contentDescription="@string/us_every_week"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:background="@drawable/us_empty_text_container_background"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.US.Widget.Message"
            android:gravity="center"
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:maxLines="2"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="62dp"
            android:src="@drawable/us_widget_empty_icon"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/us_every_week"/>
    </RelativeLayout>
</FrameLayout>
