<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/stepos_comp_background_primary"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stepos.familyguard.ui.widget.MyRecyclerView
            android:id="@+id/recycler_view"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:needDefaultFooter="true"
            app:needDefaultHeader="false"/>
        <View
            android:id="@+id/mask"
            android:background="@color/stepos_comp_background_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.StepOS.HeadLine.Small"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:id="@+id/aicy_request_layer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/us_enable_this_service"
            app:layout_constraintBottom_toTopOf="@+id/aicy_request_layer_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textAppearance="@style/TextAppearance.StepOS.Body.Mini"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:id="@+id/aicy_request_layer_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="19dp"
            android:text="@string/us_aicy_engine_request_message"
            android:layout_marginHorizontal="48dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/aicy_request_layer_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/aicy_request_layer_title"/>
        <com.stepos.common.widget.StepOSButton
            android:id="@+id/aicy_request_layer_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fg_to_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/aicy_request_layer_message"
            style="@style/Widget.DeviceDefault.Light.Button.LightColor.Color.Blue"/>
        <com.stepos.common.widget.LoadingView
            android:id="@+id/loading_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/loading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Widget.StepOSCommon.LoadingView.Light"/>
        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/us_loading"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_view"
            style="@style/LoadingViewTextStyle.Light"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/aicy_group"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="aicy_request_layer_title,         aicy_request_layer_message,         aicy_request_layer_btn,         mask"/>
        <FrameLayout
            android:id="@+id/balloonFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="?attr/marginExtraHeavy"
            android:layout_marginEnd="?attr/marginExtraHeavy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/loading_group"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="loading_view,loading_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:layout_gravity="top"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_compact_height"
        app:steposBackdropBlurEnabled="true"
        app:steposTitle="@string/us_usage_statistics"
        app:steposTitleGravity="center"
        style="@style/StepOSWidget.TitleBar.DigitalHealth"/>
</FrameLayout>
