<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/stepos_comp_background_primary"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stepos.widget.toolbar.StepOSTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stepos_titlebar_compact_height"
        app:steposTitle="@string/fg_settings"
        app:steposTitleGravity="center"
        style="@style/StepOSWidget.TitleBar.DigitalHealth"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.stepos.widget.list.StepOSListGroup
            android:id="@+id/settings_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_stepos_page_content_gap"
            android:layout_marginHorizontal="@dimen/us_stepos_list_card_inset"
            app:steposListGroupColor="@color/stepos_comp_background_list_card">
            <com.stepos.widget.list.StepOSListItem
                android:id="@+id/item_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:steposListItemTitle="@string/fg_privacy_settings_title"/>
            <com.stepos.widget.list.StepOSListItem
                android:id="@+id/item_close_digital_wellbeing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:steposListItemTitle="@string/us_close_digital_wellbeing"/>
        </com.stepos.widget.list.StepOSListGroup>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="12sp"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="@string/fg_app_icp"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/stepos_icon_arrow_right"
        android:textAlignment="center"
        android:layout_marginHorizontal="24dp"/>
</LinearLayout>
