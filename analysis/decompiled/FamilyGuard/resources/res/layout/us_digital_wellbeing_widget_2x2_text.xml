<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.FamilyGuard.AppWidget.Container">
    <RelativeLayout
        android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
        android:id="@+id/data_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/Widget.FamilyGuard.AppWidget.Container">
        <TextView
            android:id="@+id/usage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_2x2_widget_margin_top"
            android:text="@string/us_usage_time"
            android:layout_alignParentTop="true"
            android:layout_marginStart="?attr/marginMedium"
            android:layout_alignParentStart="true"
            style="@style/TextAppearance.US.Widget.Des"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/total_usage_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/marginMini"
            android:layout_below="@+id/usage_title"
            android:layout_marginStart="?attr/marginMedium"
            android:layout_alignParentStart="true">
            <TextView
                android:id="@+id/hour_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_marginEnd="?attr/marginExtraMini"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/hour_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_hour"
                android:layout_marginEnd="?attr/marginExtraMini"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
            <TextView
                android:id="@+id/minute_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="?attr/marginExtraMini"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/minute_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_minute"
                android:layout_marginEnd="?attr/marginExtraMini"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
            <TextView
                android:id="@+id/second_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="?attr/marginExtraMini"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/second_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_second"
                style="@style/TextAppearance.US.Widget.Label.Number.Small"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/progress_img"
            android:layout_width="match_parent"
            android:layout_height="@dimen/us_2x2_text_widget_categorical_bar_view_height"
            android:layout_marginTop="@dimen/us_2x2_text_widget_categorical_bar_margin_top"
            android:layout_below="@+id/total_usage_label"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="?attr/marginMedium"/>
        <RelativeLayout
            android:id="@+id/pickup_times_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/us_2x2_text_widget_stats_row_height"
            android:layout_marginBottom="@dimen/us_2x2_text_widget_stats_row_gap"
            android:layout_above="@+id/notify_times_container"
            android:layout_marginStart="?attr/marginMedium"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/us_2x2_text_widget_stats_digit_text_size"
                android:gravity="center"
                android:id="@+id/pickup_times_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:textSize="@dimen/us_2x2_text_small_widget_label_text_size"
                android:id="@+id/pickup_times_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_widget_times"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/us_2x2_label_margin_top"
                android:layout_toEndOf="@+id/pickup_times_digit"
                style="@style/TextAppearance.US.Widget.Label.Number"/>
            <TextView
                android:textSize="@dimen/us_2x2_text_small_widget_label_text_size"
                android:id="@+id/pickup_times_des"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_take_up_phone"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/us_2x2_label_margin_top"
                android:layout_toEndOf="@+id/pickup_times_digit"
                style="@style/TextAppearance.US.Widget.Des"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/notify_times_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/us_2x2_text_widget_stats_row_height"
            android:layout_marginBottom="?attr/marginMedium"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="?attr/marginMedium"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/us_2x2_text_widget_stats_digit_text_size"
                android:gravity="center"
                android:id="@+id/notify_times_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:textSize="@dimen/us_2x2_text_small_widget_label_text_size"
                android:id="@+id/notify_times_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_widget_notification_label"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/us_2x2_label_margin_top"
                android:layout_toEndOf="@+id/notify_times_digit"
                style="@style/TextAppearance.US.Widget.Label.Number"/>
            <TextView
                android:textSize="@dimen/us_2x2_text_small_widget_label_text_size"
                android:id="@+id/notify_times_des"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_receive_notification"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/us_2x2_label_margin_top"
                android:layout_toEndOf="@+id/notify_times_digit"
                style="@style/TextAppearance.US.Widget.Des"/>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/error_layer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/us_widget_need_permission_text_color"
            android:layout_gravity="center"
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/us_widget_need_allow_permission"
            android:layout_marginHorizontal="@dimen/us_request_permission_text_margin_h"
            style="@style/TextAppearance.US.Widget.Label"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/empty_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/us_2x2_widget_histogram_empty"
            android:scaleType="matrix"
            android:contentDescription="@string/us_every_week"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:background="@drawable/us_empty_text_container_background"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.US.Widget.Message"
            android:gravity="center"
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:maxLines="2"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="62dp"
            android:src="@drawable/us_widget_empty_icon"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/us_every_week"/>
    </RelativeLayout>
</FrameLayout>
