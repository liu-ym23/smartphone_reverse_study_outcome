<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/stepos_button_pressed_overlay"/>
            <corners android:radius="@dimen/stepos_radius_full"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stepos_comp_background_transparent"/>
            <corners android:radius="@dimen/stepos_radius_full"/>
        </shape>
    </item>
</selector>
