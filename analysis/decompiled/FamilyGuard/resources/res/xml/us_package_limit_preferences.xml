<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:layout="@layout/us_preference_category_item_layout"
        android:title="@string/us_admin_info"
        android:key="@string/us_limit_admin_info_key"/>
    <PreferenceCategory
        android:layout="@layout/us_preference_category_item_layout"
        android:title="@string/us_limit_usage_category"
        android:key="@string/us_usage_limit_category_key"/>
    <com.stepos.familyguard.ui.widget.SwitchPreference
        android:persistent="false"
        android:title="@string/us_limit_usage"
        android:key="@string/us_limit_enable_key"
        android:summary="@string/us_addiction_prevention_des"/>
    <com.stepos.familyguard.ui.widget.ListPreference
        android:entries="@array/us_package_limit_time_array"
        android:title="@string/us_work_day"
        android:key="@string/us_work_day_limit_key"
        android:defaultValue="-1"
        android:entryValues="@array/us_package_limit_time_value"
        style="@style/ListPreferenceStyle"/>
    <com.stepos.familyguard.ui.widget.ListPreference
        android:entries="@array/us_package_limit_time_array"
        android:title="@string/us_off_day"
        android:key="@string/us_off_day_limit_key"
        android:defaultValue="-1"
        android:entryValues="@array/us_package_limit_time_value"
        style="@style/ListPreferenceStyle"/>
    <PreferenceCategory
        android:layout="@layout/us_preference_category_item_layout"
        android:title="@string/us_limit_period_category"
        android:key="@string/us_limit_period_category_key">
        <com.stepos.familyguard.ui.widget.SwitchPreference
            android:persistent="false"
            android:title="@string/us_limit_period"
            android:key="@string/us_period_limit_enable_key"
            android:summary="@string/us_limit_app_period"/>
    </PreferenceCategory>
    <Preference
        android:layout="@layout/us_preference_button"
        android:title="@string/us_add_period"
        android:key="@string/us_add_period_key"/>
    <PreferenceCategory
        android:layout="@layout/us_preference_category_item_layout"
        android:title="@string/us_limit_how_to_limit"
        android:key="@string/us_limit_how_to_limit_key">
        <com.stepos.familyguard.ui.widget.ListPreference
            android:entries="@array/us_limit_over_array"
            android:title="@string/us_limit_over"
            android:key="@string/us_limit_over_key"
            android:entryValues="@array/us_limit_over_value"
            style="@style/ListPreferenceStyle"/>
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
