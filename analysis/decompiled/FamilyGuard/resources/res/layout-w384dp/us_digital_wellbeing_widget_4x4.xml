<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.FamilyGuard.AppWidget.Container">
    <RelativeLayout
        android:theme="@style/FamilyGuardAppTheme.AppWidgetContainer"
        android:id="@+id/data_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/Widget.FamilyGuard.AppWidget.Container">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/total_usage_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_4x4_widget_title_container_margin_top"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/us_4x4_widget_title_container_margin_start"
            android:layout_alignParentStart="true">
            <TextView
                android:id="@+id/hour_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/hour_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_hour"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Label.Number"/>
            <TextView
                android:id="@+id/minute_digit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/minute_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_minute"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Label.Number"/>
            <TextView
                android:id="@+id/second_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="@dimen/us_widget_digit_gap"
                style="@style/TextAppearance.US.Widget.Number"/>
            <TextView
                android:id="@+id/second_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/us_second"
                style="@style/TextAppearance.US.Widget.Label.Number"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/histogram_img"
            android:layout_width="@dimen/us_4x4_widget_histogram_view_width"
            android:layout_height="@dimen/us_4x4_widget_histogram_view_height"
            android:layout_marginTop="@dimen/us_4x4_widget_histogram_img_margin_top"
            android:scaleType="fitStart"
            android:layout_above="@+id/category_usage_container"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/add_widget"
            android:layout_marginHorizontal="@dimen/us_4x4_widget_histogram_margin_h"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/category_usage_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/us_4x4_widget_category_container_margin_top_1_line"
            android:baselineAligned="false"
            android:layout_above="@+id/divider"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="?attr/marginMedium">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="@dimen/us_4x4_widget_category_item_height_1_line"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_1_icon"
                        android:background="@drawable/us_category_1_color_indicator"
                        android:layout_width="@dimen/us_4x4_widget_category_item_icon_size"
                        android:layout_height="@dimen/us_4x4_widget_category_item_icon_size"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/us_4x4_widget_category_item_icon_margin_end"/>
                    <TextView
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_1_name"
                        android:background="@drawable/us_widget_text_empty_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.US.Widget.Label"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/category_1_usage_time"
                    android:background="@drawable/us_widget_des_1_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/us_4x4_widget_category_des_text_margin_start"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="@dimen/us_4x4_widget_category_item_gap"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="@dimen/us_4x4_widget_category_item_height_1_line"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_2_icon"
                        android:background="@drawable/us_category_2_color_indicator"
                        android:layout_width="@dimen/us_4x4_widget_category_item_icon_size"
                        android:layout_height="@dimen/us_4x4_widget_category_item_icon_size"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/us_4x4_widget_category_item_icon_margin_end"/>
                    <TextView
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_2_name"
                        android:background="@drawable/us_widget_text_empty_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.US.Widget.Label"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/category_2_usage_time"
                    android:background="@drawable/us_widget_des_1_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/us_4x4_widget_category_des_text_margin_start"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="@dimen/us_4x4_widget_category_item_gap"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="@dimen/us_4x4_widget_category_item_height_1_line"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_3_icon"
                        android:background="@drawable/us_category_3_color_indicator"
                        android:layout_width="@dimen/us_4x4_widget_category_item_icon_size"
                        android:layout_height="@dimen/us_4x4_widget_category_item_icon_size"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/us_4x4_widget_category_item_icon_margin_end"/>
                    <TextView
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/category_3_name"
                        android:background="@drawable/us_widget_text_empty_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/TextAppearance.US.Widget.Label"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/category_3_usage_time"
                    android:background="@drawable/us_widget_des_1_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/us_4x4_widget_category_des_text_margin_start"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/divider"
            android:background="@color/us_widget_divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/us_4x4_widget_category_divider_line_height"
            android:layout_marginTop="@dimen/us_4x4_widget_category_divider_line_margin_top"
            android:layout_above="@+id/app_container"
            android:layout_marginHorizontal="@dimen/us_4x4_widget_app_margin_h"/>
        <RelativeLayout
            android:id="@+id/app_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/us_4x4_widget_app_container_height"
            android:layout_marginTop="@dimen/us_4x4_widget_app_container_margin_top"
            android:layout_marginBottom="?attr/marginLarge"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/us_4x4_widget_app_margin_h">
            <RelativeLayout
                android:layout_width="@dimen/us_4x4_widget_app_item_width"
                android:layout_height="@dimen/us_4x4_widget_app_item_height"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@+id/app_1_icon"
                    android:layout_width="@dimen/us_4x4_widget_app_icon_size"
                    android:layout_height="@dimen/us_4x4_widget_app_icon_size"
                    android:src="@drawable/us_app_icon_default_icon"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/us_4x4_widget_app_icon_margin_end"/>
                <TextView
                    android:id="@+id/app_1_name"
                    android:background="@drawable/us_widget_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/app_1_icon"
                    style="@style/TextAppearance.US.Widget.Label"/>
                <TextView
                    android:id="@+id/app_1_usage"
                    android:background="@drawable/us_widget_des_2_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@+id/app_1_icon"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="@dimen/us_4x4_widget_app_item_width"
                android:layout_height="@dimen/us_4x4_widget_app_item_height"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/app_2_icon"
                    android:layout_width="@dimen/us_4x4_widget_app_icon_size"
                    android:layout_height="@dimen/us_4x4_widget_app_icon_size"
                    android:src="@drawable/us_app_icon_default_icon"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/us_4x4_widget_app_icon_margin_end"/>
                <TextView
                    android:id="@+id/app_2_name"
                    android:background="@drawable/us_widget_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/app_2_icon"
                    style="@style/TextAppearance.US.Widget.Label"/>
                <TextView
                    android:id="@+id/app_2_usage"
                    android:background="@drawable/us_widget_des_2_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@+id/app_2_icon"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="@dimen/us_4x4_widget_app_item_width"
                android:layout_height="@dimen/us_4x4_widget_app_item_height"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@+id/app_3_icon"
                    android:layout_width="@dimen/us_4x4_widget_app_icon_size"
                    android:layout_height="@dimen/us_4x4_widget_app_icon_size"
                    android:src="@drawable/us_app_icon_default_icon"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/us_4x4_widget_app_icon_margin_end"/>
                <TextView
                    android:id="@+id/app_3_name"
                    android:background="@drawable/us_widget_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/app_3_icon"
                    style="@style/TextAppearance.US.Widget.Label"/>
                <TextView
                    android:id="@+id/app_3_usage"
                    android:background="@drawable/us_widget_des_2_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@+id/app_3_icon"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="@dimen/us_4x4_widget_app_item_width"
                android:layout_height="@dimen/us_4x4_widget_app_item_height"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/app_4_icon"
                    android:layout_width="@dimen/us_4x4_widget_app_icon_size"
                    android:layout_height="@dimen/us_4x4_widget_app_icon_size"
                    android:src="@drawable/us_app_icon_default_icon"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/us_4x4_widget_app_icon_margin_end"/>
                <TextView
                    android:id="@+id/app_4_name"
                    android:background="@drawable/us_widget_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/app_4_icon"
                    style="@style/TextAppearance.US.Widget.Label"/>
                <TextView
                    android:id="@+id/app_4_usage"
                    android:background="@drawable/us_widget_des_2_text_empty_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@+id/app_4_icon"
                    style="@style/TextAppearance.US.Widget.Des.Small"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/error_layer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/us_widget_need_permission_text_color"
            android:layout_gravity="center"
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/us_widget_need_allow_permission"
            android:layout_marginHorizontal="@dimen/us_request_permission_text_margin_h"
            style="@style/TextAppearance.US.Widget.Label"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/empty_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/us_4x4_widget_empty"
            android:scaleType="matrix"
            android:contentDescription="@string/us_every_week"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:background="@drawable/us_empty_text_container_background"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.US.Widget.Message"
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:maxLines="2"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/empty_icon"/>
        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/us_widget_empty_icon"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/us_every_week"
            android:layout_marginStart="12dp"/>
    </RelativeLayout>
</FrameLayout>
