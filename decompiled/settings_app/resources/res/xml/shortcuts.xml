<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@drawable/shortcut_wifi"
        android:enabled="true"
        android:shortcutId="wifi_settings"
        android:shortcutShortLabel="@string/wifi_settings"
        android:shortcutLongLabel="@string/wifi_settings"
        android:shortcutDisabledMessage="@string/disabled">
        <intent
            android:targetPackage="com.android.settings"
            android:action="android.intent.action.VIEW"
            android:targetClass="com.android.settings.wifi.WifiSettingsActivity">
            <extra
                android:name="back_text_res_name"
                android:value="settings_label"/>
        </intent>
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_bluetooth"
        android:enabled="true"
        android:shortcutId="bluetooth"
        android:shortcutShortLabel="@string/bluetooth"
        android:shortcutLongLabel="@string/bluetooth"
        android:shortcutDisabledMessage="@string/disabled">
        <intent
            android:targetPackage="com.android.settings"
            android:action="android.intent.action.VIEW"
            android:targetClass="com.android.settings.bluetooth.BluetoothSettingsActivity">
            <extra
                android:name="back_text_res_name"
                android:value="settings_label"/>
        </intent>
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_data_usage"
        android:enabled="true"
        android:shortcutId="data_usage"
        android:shortcutShortLabel="@string/data_usage_summary_title"
        android:shortcutLongLabel="@string/data_usage_summary_title"
        android:shortcutDisabledMessage="@string/disabled">
        <intent
            android:targetPackage="com.android.phone"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.phone.settings.settings.mobilenetwork.MobileNetworkSettings">
            <extra
                android:name="back_text_res_name"
                android:value="settings"/>
            <extra
                android:name="start_above_setting"
                android:value="true"/>
        </intent>
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_search"
        android:enabled="true"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search_setting_items"
        android:shortcutLongLabel="@string/search_setting_items"
        android:shortcutDisabledMessage="@string/disabled">
        <intent
            android:targetPackage="com.android.settings"
            android:action="android.intent.action.VIEW"
            android:targetClass="com.android.settings.Settings$SearchSettingsActivity"/>
    </shortcut>
</shortcuts>
