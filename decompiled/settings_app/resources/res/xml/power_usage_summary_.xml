<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/power_usage_summary_title"
    settings:keywords="@string/keywords_battery">
    <com.android.settings.fuelgauge.BatterySaverPreference
        android:enabled="false"
        android:title="@string/battery_saver"
        android:fragment="com.android.settings.fuelgauge.BatterySaverSettings"/>
    <SwitchPreference
        android:persistent="false"
        android:title="@string/show_battery_percentage"
        android:key="battery_pct"
        android:summary="@string/show_battery_percentage_summary"/>
    <com.android.settings.fuelgauge.BatteryHistoryPreference_ android:key="battery_history"/>
    <PreferenceCategory
        android:title="@string/power_usage_list_summary"
        android:key="app_list"/>
</PreferenceScreen>
