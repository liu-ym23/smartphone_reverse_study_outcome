<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" android:title="@string/radio_controls_title">
    <SwitchPreference
        android:title="@string/airplane_mode"
        android:key="toggle_airplane"
        android:disableDependentsState="true"/>
    <SwitchPreference
        android:title="@string/nfc_quick_toggle_title"
        android:key="toggle_nfc"
        android:summary="@string/nfc_quick_toggle_summary"/>
    <PreferenceScreen
        android:title="@string/wifi_calling_settings_title"
        android:key="wifi_calling_settings"
        android:fragment="com.android.settings.WifiCallingSettings"
        settings:keywords="@string/keywords_wifi_calling"/>
    <PreferenceScreen
        android:persistent="false"
        android:title="@string/wifi_calling_settings_title"
        android:key="wifi_calling_enhanced_settings"
        android:summaryOn="@null"
        android:summaryOff="@null">
        <intent
            android:targetPackage="com.qualcomm.qti.wfcservice"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.qualcomm.qti.wfcservice.WifiCallingEnhancedSettings"/>
    </PreferenceScreen>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/android_beam_settings_title"
        android:key="android_beam_settings"
        android:fragment="com.android.settings.nfc.AndroidBeam"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/vpn_settings_title"
        android:key="vpn_settings"
        android:fragment="com.android.settings.vpn2.VpnSettings"
        settings:useAdminDisabledSummary="true"
        settings:userRestriction="no_config_vpn"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/network_settings_title"
        android:key="mobile_network_settings"
        android:dependency="toggle_airplane"
        settings:keywords="@string/keywords_more_mobile_networks"
        settings:useAdminDisabledSummary="true"
        settings:userRestriction="no_config_mobile_networks">
        <intent
            android:targetPackage="com.android.phone"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.phone.settings.settings.mobilenetwork.MobileNetworkSettings"/>
    </com.android.settingslib.RestrictedPreference>
    <com.android.settingslib.RestrictedPreference
        android:persistent="false"
        android:title="@string/manage_mobile_plan_title"
        android:key="manage_mobile_plan"
        settings:useAdminDisabledSummary="true"
        settings:userRestriction="no_config_mobile_networks"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/wimax_settings"
        android:key="wimax_settings"
        settings:useAdminDisabledSummary="true"
        settings:userRestriction="no_config_mobile_networks">
        <intent
            android:targetPackage="com.android.settings.wimax"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.wimax.WimaxSettings"/>
    </com.android.settingslib.RestrictedPreference>
    <PreferenceScreen
        android:title="@string/proxy_settings_title"
        android:key="proxy_settings"
        android:fragment="com.android.settings.ProxySelector"/>
    <SwitchPreference
        android:title="@string/voice_over_lte"
        android:key="voice_over_lte"/>
</PreferenceScreen>
