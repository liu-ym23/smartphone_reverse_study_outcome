<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_setting_sub_item_bg_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13.5sp"
        android:textColor="@color/setting_item_text_color"
        android:gravity="center"
        android:id="@+id/power_usage_today"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/power_usage_cycle_today"
        android:layout_weight="1"
        android:drawableEnd="@drawable/power_usage_cycle_view_gap"/>
    <TextView
        android:textSize="13.5sp"
        android:textColor="@color/setting_item_text_color"
        android:gravity="center"
        android:id="@+id/power_usage_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/power_usage_cycle_week"
        android:layout_weight="1"
        android:drawableEnd="@drawable/power_usage_cycle_view_gap"/>
    <TextView
        android:textSize="13.5sp"
        android:textColor="@color/setting_item_text_color"
        android:gravity="center"
        android:id="@+id/power_usage_month"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/power_usage_cycle_month"
        android:layout_weight="1"/>
</LinearLayout>
