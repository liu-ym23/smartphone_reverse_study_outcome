<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/tnt_sound_settings_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/list_item_maximum_width"
            android:layout_height="match_parent">
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/mute_enable_switch"
                    android:title="@string/mute_enable_title"
                    style="@style/SettingSubItemTopStyle"/>
                <obric.widget.ListContentItemCustom
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SettingSubItemBottomStyle">
                    <com.android.settings.widget.VolumeSeekBar
                        android:id="@+id/system_volume_seek_bar"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        app:left_icon_src="@drawable/vol_setting_clock_min"
                        app:right_icon_src="@drawable/vol_setting_clock_max"/>
                </obric.widget.ListContentItemCustom>
            </LinearLayout>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/item_id_output_device_tip"
                android:text="@string/sound_settings_output_device_header"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemCheck
                android:icon="@drawable/icn_audio_external"
                android:id="@+id/item_id_output_device_check"
                android:visibility="gone"
                app:itemTitle="@string/external_device_title"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemCheck
                android:icon="@drawable/icn_audio_internal"
                android:id="@+id/item_id_device_check"
                android:visibility="gone"
                style="@style/SettingSubItemBottomStyle"/>
            <view
                android:id="@+id/sound_devices"
                android:overScrollMode="never"
                class="com.android.settings.revone.TNTSoundSettingsFragment$SoundDeviceListView"
                style="@style/ListViewGeneralStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/microphone_pickup_mode_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/item_bottom_shadow_layout"/>
                <TextView
                    android:id="@+id/item_id_microphone_pickup_mode"
                    android:text="@string/sound_settings_microphone_pickup_mode_title"
                    style="@style/SettingItemTitleStyle"/>
                <obric.widget.SettingItemCheck
                    android:icon="@drawable/icn_single_capture"
                    android:id="@+id/item_id_single_pickup_mode"
                    app:itemTitle="@string/sound_settings_single_pickup_mode"
                    style="@style/SettingSubItemTopStyle"/>
                <obric.widget.SettingItemCheck
                    android:icon="@drawable/icn_multi_capture"
                    android:id="@+id/item_id_multi_pickup_mode"
                    app:itemTitle="@string/sound_settings_multi_pickup_mode"
                    style="@style/SettingSubItemBottomStyle"/>
                <TextView
                    android:text="@string/sound_settings_microphone_pickup_mode_tips"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
