<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:id="@+id/page_scrollview"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:overScrollMode="always">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/page_container"
                android:paddingTop="@dimen/main_settings_first_item_card_gap"
                android:paddingBottom="@dimen/settings_container_bottom_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/id_smart_screen_protection_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/smart_screen_enabled_tips"
                        style="@style/SettingItemTipsStyle"/>
                    <TextView
                        android:textColor="@color/link_text_color"
                        android:id="@+id/id_go_to_setting"
                        android:text="@string/go_to_setting"
                        style="@style/SettingItemTipsStyle"/>
                </LinearLayout>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_navbar_mode_switch"
                    app:ocardlistitem_subTitle="@string/navbar_gesture_mode_summary"
                    app:ocardlistitem_title="@string/navbar_virtual_keys_mode"
                    style="@style/OCardListItemSwitchSingle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/nav_layout_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/title"
                        android:layout_marginTop="@dimen/dimen_20"
                        android:text="@string/navigation_bar_layout_option"
                        style="@style/SettingItemTitleStyle"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/o_background_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/SettingItemSingleStyle">
                        <com.android.settings.widget.CustomNavbarStyleView
                            android:id="@+id/nav_layout_right"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"/>
                        <com.android.settings.widget.CustomNavbarStyleView
                            android:id="@+id/nav_layout_left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/gesture_support_layout"
                    layout="@layout/navbar_mode_gesure_layout"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/hide_nav_handle"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    app:ocardlistitem_title="@string/hide_navigation_handle"
                    style="@style/OCardListItemSwitchSingle"/>
                <com.android.settings.widget.SettingsBottomExtraView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_centerTitle="@string/system_navigation_mode"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
