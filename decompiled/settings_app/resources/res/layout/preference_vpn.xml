<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/layout_gap_top"
        android:layout_width="wrap_content"
        android:layout_height="8dp"/>
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:id="@+id/list_item_subtitle"
        android:visibility="gone"
        android:layout_marginHorizontal="32dp"
        style="@style/OSectionTitleBar.S"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/list_item_container"
        app:ocardlistitem_icon="@drawable/loading"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_subTitle="@string/vpn_type"
        app:ocardlistitem_tailIcon="@drawable/ic_vpn_info"
        app:ocardlistitem_title="@string/vpn_type"
        style="@style/OCardListItemTextSingle"/>
    <View
        android:id="@+id/layout_gap_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="8dp"/>
    <include
        android:id="@+id/layout_bottom"
        android:visibility="gone"
        layout="@layout/item_bottom_shadow_layout2"/>
</LinearLayout>
