<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/homepage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_label"
            android:maxLines="1"
            android:layout_centerInParent="true"
            style="@style/Title_Display"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/homepage_title_mid"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_label"
            android:maxLines="1"
            android:layout_centerInParent="true"
            style="@style/Title_Headline"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/homepage_title_last"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_label"
            android:maxLines="1"
            android:layout_centerInParent="true"
            style="@style/Title_Title_M_Thick"/>
    </RelativeLayout>
</LinearLayout>
