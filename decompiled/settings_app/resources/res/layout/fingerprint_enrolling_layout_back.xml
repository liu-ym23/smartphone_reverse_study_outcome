<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/enroll_fingerprint"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/find_sensor_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_marginBottom="@dimen/item_block_gap"
        android:layout_below="@+id/view_title">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/setting_fp_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fingerprint_enroll_progress_margin_top"
            android:layout_marginBottom="60dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#99000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_find_sensor_tips"
            android:paddingLeft="@dimen/fingerprint_tips_horizontal_padding"
            android:paddingRight="@dimen/fingerprint_tips_horizontal_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_sensor_tips"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/enrolling_layout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_marginBottom="@dimen/item_block_gap"
        android:layout_below="@+id/view_title">
        <com.obric.oui.button.OButton
            android:id="@+id/finger_add_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nextbutton_top_margin"
            android:layout_marginBottom="4dp"
            android:text="@string/done"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/LongButton.Highlight"/>
        <FrameLayout
            android:id="@+id/fp_illustration"
            android:layout_width="@dimen/fingerprint_enroll_progress_width"
            android:layout_height="@dimen/fingerprint_enroll_progress_height"
            android:layout_marginTop="@dimen/fingerprint_enroll_progress_margin_top"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.android.settings.widget.BackFingerprintAnimView
                android:id="@+id/fp_anim_view"
                android:paddingTop="@dimen/fingerprint_progress_padding_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/fp_anim_finish_view"
                android:paddingTop="@dimen/fingerprint_progress_padding_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/fp_result_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="37dp"
                android:layout_marginBottom="49dp"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/tips_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_above="@+id/finger_add_completed"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/fingerprint_enrolling_tips_normal_color"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tips_text"
                android:paddingLeft="@dimen/fingerprint_tips_horizontal_padding"
                android:paddingRight="@dimen/fingerprint_tips_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/enroll_fingerprint_tips"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/bottom_link_tv_color"
                android:gravity="center_horizontal"
                android:id="@+id/add_another_finger_tv"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/add_another_finger"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/setting_item_summary_text_color"
                android:id="@+id/setup_for_payment"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:maxWidth="336dp"
                android:layout_below="@+id/add_another_finger_tv"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="20sp"
            android:textColor="#99000000"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/put_finger_on_sensor"
            android:layout_above="@+id/tips_view"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
