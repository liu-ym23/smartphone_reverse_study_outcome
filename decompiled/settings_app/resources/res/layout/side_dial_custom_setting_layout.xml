<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/side_dial_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/side_dial_details_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/side_dial_custom_mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/side_dial_custom_power_screen"
                    style="@style/SettingItemTitleStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_screen_rotation"
                    android:title="@string/side_dial_custom_auto_rotation"
                    style="@style/SettingItemTopStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_auto_brightness"
                    android:title="@string/side_dial_custom_brightness_auto_switch"
                    style="@style/SettingItemMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_always_on_screen"
                    android:title="@string/side_dial_screen_always_on"
                    style="@style/SettingItemMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_protect_eyes"
                    android:title="@string/side_dial_custom_protect_eyes"
                    style="@style/SettingItemMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_read_mode"
                    android:title="@string/side_dial_custom_read_mode"
                    style="@style/SettingItemBottomStyle"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
                <TextView
                    android:text="@string/sound_settings"
                    style="@style/SettingItemTitleStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_mute"
                    android:title="@string/side_dial_mute_title"
                    style="@style/SettingItemTopStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_telephony_vibrate"
                    android:title="@string/side_dial_custom_telephony_vibrate"
                    style="@style/SettingItemMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_feedback_vibration"
                    android:visibility="gone"
                    android:title="@string/side_dial_custom_navigationbar_gesture_vibration"
                    style="@style/SettingItemMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/custom_mode_global_vibrate"
                    android:title="@string/global_vibrate_title"
                    style="@style/SettingItemBottomStyle"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
