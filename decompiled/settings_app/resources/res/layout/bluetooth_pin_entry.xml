<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="24dp"
        style="@style/Body_M"/>
    <com.obric.oui.forms.OInputLayout
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:inputType="text"
        android:layout_marginHorizontal="@dimen/oui_p_list_item_1"
        app:oinput_hint="@string/please_input_pin"
        app:oinput_showInputBackground="true"
        app:oinput_showLabel="false"/>
    <TextView
        android:textColor="@color/oui_text_3"
        android:id="@+id/pin_values_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/bluetooth_pin_values_hint"
        android:layout_marginHorizontal="16dp"
        style="@style/Label_M_Thin"/>
</LinearLayout>
