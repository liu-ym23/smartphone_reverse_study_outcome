<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIConstraintLayout
        android:background="@drawable/o_background_list_item"
        android:padding="@dimen/dimen_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_12">
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/ring_mode_container"
            android:paddingTop="@dimen/dimen_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_4dp"
            android:minWidth="@dimen/dimen_104"
            app:layout_constraintEnd_toStartOf="@+id/vibration_mode_container"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:src="@drawable/vol_setting_call_min"/>
            <com.obric.oui.text.OTextView
                android:textSize="16sp"
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:text="@string/ring_mode_title"/>
            <com.obric.oui.checkbox.OCheckBox
                android:layout_gravity="center"
                android:id="@+id/ring_mode_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_7"
                app:oui_checkedState="checked"/>
        </com.obric.oui.layout.OUILinearLayout>
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/vibration_mode_container"
            android:paddingTop="@dimen/dimen_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_4dp"
            android:minWidth="@dimen/dimen_104"
            app:layout_constraintEnd_toStartOf="@+id/silence_mode_container"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/ring_mode_container">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:src="@drawable/o_ic_phone_vibration_fill"/>
            <com.obric.oui.text.OTextView
                android:textSize="16sp"
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:text="@string/vibration_mode_title"/>
            <com.obric.oui.checkbox.OCheckBox
                android:layout_gravity="center"
                android:id="@+id/vibration_mode_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_7"
                app:oui_checkedState="unchecked"/>
        </com.obric.oui.layout.OUILinearLayout>
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/silence_mode_container"
            android:paddingTop="@dimen/dimen_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_104"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/vibration_mode_container">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:src="@drawable/vol_setting_call_mute"/>
            <com.obric.oui.text.OTextView
                android:textSize="16sp"
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_4dp"
                android:text="@string/silent_mode"/>
            <com.obric.oui.checkbox.OCheckBox
                android:layout_gravity="center"
                android:id="@+id/silence_mode_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_7"
                app:oui_checkedState="unchecked"/>
        </com.obric.oui.layout.OUILinearLayout>
    </com.obric.oui.layout.OUIConstraintLayout>
</FrameLayout>
