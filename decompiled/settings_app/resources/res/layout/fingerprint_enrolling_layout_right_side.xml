<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/enroll_fingerprint"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/find_sensor_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_marginBottom="@dimen/item_block_gap"
        android:layout_below="@+id/view_title">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="318dp"
            android:layout_height="318dp"
            android:layout_marginTop="@dimen/fingerprint_enroll_progress_margin_top"
            android:layout_marginBottom="60dp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/illustration_lottie"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="318dp"
                android:layout_height="318dp"
                android:scaleType="centerInside"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_speed="0.85"/>
        </FrameLayout>
        <TextView
            android:textSize="20sp"
            android:textColor="#99000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_find_sensor_tips"
            android:paddingLeft="@dimen/fingerprint_tips_horizontal_padding"
            android:paddingRight="@dimen/fingerprint_tips_horizontal_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_sensor_tips"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/enrolling_layout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_marginBottom="@dimen/item_block_gap"
        android:layout_below="@+id/view_title">
        <RelativeLayout
            android:id="@+id/buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="@dimen/nextbutton_top_margin"
            android:layout_marginRight="12dp"
            android:layout_alignParentBottom="true">
            <com.obric.oui.button.OButton
                android:id="@+id/enroll_next_finger"
                android:layout_width="162dp"
                android:layout_marginBottom="4dp"
                android:text="@string/add_another_finger"
                android:layout_alignParentLeft="true"
                style="@style/OButton.L1.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/goto_face_enroll"
                android:layout_width="162dp"
                android:layout_marginBottom="4dp"
                android:text="@string/enroll_face_data"
                android:layout_alignParentRight="true"
                style="@style/OButton.L1.Standard.Primary"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/fp_illustration"
            android:layout_width="@dimen/fingerprint_enroll_progress_width"
            android:layout_height="@dimen/fingerprint_enroll_progress_height"
            android:layout_marginTop="@dimen/fingerprint_enroll_progress_margin_top"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.android.settings.widget.FrontFingerprintAnimView
                android:id="@+id/fp_anim_view"
                android:paddingTop="@dimen/fingerprint_progress_padding_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/fp_anim_finish_view"
                android:paddingTop="@dimen/fingerprint_progress_padding_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/fp_result_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="37dp"
                android:layout_marginBottom="49dp"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/tips_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_above="@+id/buttons_layout"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/fingerprint_enrolling_tips_normal_color"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tips_text"
                android:paddingLeft="@dimen/fingerprint_tips_horizontal_padding"
                android:paddingRight="@dimen/fingerprint_tips_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/enroll_fingerprint_tips"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/setting_item_summary_text_color"
                android:id="@+id/setup_for_payment"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:maxWidth="336dp"
                android:layout_below="@+id/tips_text"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="20sp"
            android:textColor="#99000000"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/put_finger_on_sensor"
            android:layout_above="@+id/tips_view"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include layout="@layout/title_bar_shadow"/>
    <FrameLayout
        android:id="@+id/fp_pulse_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="230dp"
        android:layout_alignParentEnd="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fp_pulse"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/sfps_pulse"/>
    </FrameLayout>
</RelativeLayout>
