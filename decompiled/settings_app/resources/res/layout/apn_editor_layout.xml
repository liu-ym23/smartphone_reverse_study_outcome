                app:titlesummaryitem_type="edit"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_auth_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/apn_auth_type"
                app:titlesummaryitem_entries="@array/apn_auth_entries"
                app:titlesummaryitem_entryValues="@array/apn_auth_values"
                app:titlesummaryitem_type="list"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_apn_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/apn_type"
                app:titlesummaryitem_inputMethodType="text"
                app:titlesummaryitem_type="edit"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_protocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/apn_protocol"
                app:titlesummaryitem_entries="@array/apn_protocol_entries"
                app:titlesummaryitem_entryValues="@array/apn_protocol_values"
                app:titlesummaryitem_type="list"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_roaming_protocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/apn_roaming_protocol"
                app:titlesummaryitem_entries="@array/apn_protocol_entries"
                app:titlesummaryitem_entryValues="@array/apn_protocol_values"
                app:titlesummaryitem_type="list"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_carrier_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/carrier_enabled"
                app:titlesummaryitem_type="oswitch"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/item_bearer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/bearer"
                app:titlesummaryitem_entries="@array/bearer_entries"
                app:titlesummaryitem_entryValues="@array/bearer_values"
                app:titlesummaryitem_type="list"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/mvno_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/mvno_type"
                app:titlesummaryitem_entries="@array/mvno_type_entries"
                app:titlesummaryitem_entryValues="@array/mvno_type_values"
                app:titlesummaryitem_type="list"/>
            <com.android.settings.TitleSummaryItem
                android:id="@+id/mvno_match_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/mvno_match_data"
                app:titlesummaryitem_inputMethodType="text"
                app:titlesummaryitem_type="edit"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/apn_deitor_title_new"
        app:oFloatingTitleBar_endButtonGroupStyle="@style/OFloatingTitleBar.Action.PrimaryLight.Icon"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
