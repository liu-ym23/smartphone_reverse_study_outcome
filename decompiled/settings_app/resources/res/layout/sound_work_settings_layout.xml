<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/work_use_personal_sounds_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/work_use_personal_sounds_summary"
                app:ocardlistitem_title="@string/work_use_personal_sounds_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/work_ringtone_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/work_ringtone_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/work_notification_ringtone_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/work_notification_ringtone_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/work_alarm_ringtone_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/work_alarm_ringtone_title"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fake_status_bar"
        app:oFloatingTitleBar_centerTitle="@string/sound_work_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
