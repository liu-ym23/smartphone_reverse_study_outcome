<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIRelativeLayout
        android:background="@drawable/setting_item_backgroud_card"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        app:oui_radius="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/trailing_container"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true">
            <TextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Title_Title_M"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_content_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/trailing_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_state_on"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                android:lineHeight="20dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_forward_list_item"/>
        </LinearLayout>
    </com.obric.oui.layout.OUIRelativeLayout>
</RelativeLayout>
