<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/data_usage_header_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/data_usage_header_view"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sim_guide_layout_stub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/sim_guide_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </LinearLayout>
            <obric.widget.ListContentItemSwitch
                android:id="@+id/data_usage_alarm_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/data_usage_alarm"
                style="@style/ListContentItemStyle.Top"/>
            <obric.widget.ListContentItemText
                android:id="@+id/data_usage_limit_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/data_usage_limit"
                app:smtTitle="@string/data_usage_limit_unset"
                style="@style/ListContentItemStyle.Bottom"/>
            <TextView
                android:id="@+id/data_usage_limit_tips_stub"
                android:layout_marginTop="6dp"
                android:text="@string/data_usage_limit_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/card_info_province"
                android:visibility="gone"
                android:title="@string/select_province"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/card_info_city"
                android:visibility="gone"
                android:title="@string/select_city"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/card_info_carry"
                android:visibility="gone"
                android:title="@string/select_carry"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/card_info_branch"
                android:visibility="gone"
                android:title="@string/select_brand"
                style="@style/SettingSubItemBottomStyle"/>
            <View
                android:id="@+id/div"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@+id/card_info_branch"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.bouncelayout.OListView
        android:id="@android:id/list"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:smoothScrollbar="false"
        style="@style/ListViewGeneralStyle"/>
    <include
        android:id="@+id/empty_view"
        layout="@layout/loading_view"/>
</LinearLayout>
