<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.android.settings.widget.HorizontalOptionCheckView
        android:id="@+id/id_home_long_press"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        settings:optionsCount="3"
        settings:title="@string/long_press_home_key"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <com.android.settings.widget.HorizontalOptionCheckView
        android:id="@+id/access_text_recognition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        settings:title="@string/accessibility_text_title"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <com.android.settings.widget.HorizontalOptionCheckView
        android:id="@+id/access_text_voice_command"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        settings:optionsCount="3"
        settings:title="@string/accessibility_voice_title"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
</LinearLayout>
