<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_container"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.obric.oui.button.OButton
            android:id="@+id/done_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_marginBottom="12dp"
            android:minWidth="162dp"
            android:text="@string/done"
            android:layout_marginHorizontal="24dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.button.OButton
            android:id="@+id/enroll_next_finger"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:minWidth="162dp"
            android:text="@string/add_another_finger"
            android:layout_marginHorizontal="24dp"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:id="@+id/goto_face_enroll"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:minWidth="162dp"
            android:text="@string/enroll_face_data"
            android:layout_marginHorizontal="24dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/enroll_ai_powered_fingerprint"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
