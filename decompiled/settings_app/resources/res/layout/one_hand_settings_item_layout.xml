<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/text_item_title"
        style="@style/SettingItemTitleStyle"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="172dp">
            <LinearLayout
                android:id="@+id/one_hand_preview"
                style="@style/SettingPreviewStyle">
                <com.android.settings.PreviewSettingItemView
                    android:id="@+id/item_preview_left"
                    setting:previewNormalDrawable="@drawable/selector_one_hand_left"
                    setting:previewTitle="@null"
                    style="@style/SettingPreviewItemStyle"/>
                <include layout="@layout/divider_line_vertical"/>
                <com.android.settings.PreviewSettingItemView
                    android:id="@+id/item_preview_right"
                    setting:previewNormalDrawable="@drawable/selector_one_hand_right"
                    setting:previewTitle="@null"
                    style="@style/SettingPreviewItemStyle"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <include layout="@layout/scrollview_bottom_gap_layout"/>
    <com.android.settings.widget.SettingsBottomExtraView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
