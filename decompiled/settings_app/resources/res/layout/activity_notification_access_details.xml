<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/notification_access_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/notification_access_detail_switch"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/header_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Label_M"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sub_switch_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/type_filter_ongoing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_type_ongoing_summary"
                    app:ocardlistitem_title="@string/notif_type_ongoing"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/type_filter_conversation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_type_conversation_summary"
                    app:ocardlistitem_title="@string/notif_type_conversation"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/type_filter_alerting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_type_alerting_summary"
                    app:ocardlistitem_title="@string/notif_type_alerting"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/type_filter_silent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_type_silent_summary"
                    app:ocardlistitem_title="@string/notif_type_silent"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/bridged_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_listener_excluded_app_summary"
                    app:ocardlistitem_title="@string/notif_listener_excluded_app_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/more_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/notif_listener_more_settings_desc"
                    app:ocardlistitem_title="@string/notif_listener_more_settings"/>
            </LinearLayout>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/notif_listener_not_migrated"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:title="@string/notif_listener_not_migrated"
                android:layout_marginHorizontal="32dp"
                style="@style/Subtitle_2_Regular"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:layout_constraintTop_toBottomOf="@+id/fake_status_bar"
        app:oFloatingTitleBar_centerTitle="@string/data_saver_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
