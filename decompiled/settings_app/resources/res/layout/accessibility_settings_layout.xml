<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/bytedance_desktop_left_screen"
                android:visibility="gone"
                app:ocardlistitem_title="@string/left_screen_setting"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/bytedance_desktop_left_screen_gap"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/trigger_smart_screen_mode"
                android:visibility="gone"
                app:ocardlistitem_title="@string/trigger_smart_screen_mode"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/shadow_below_trigger_smart_screen_mode"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_font_scale"
                android:visibility="gone"
                app:ocardlistitem_title="@string/font_size"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/item_font_scale_gap_below"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <include
                android:id="@+id/shadow_below_color_mode"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/backcover_caribrition"
                android:visibility="gone"
                app:ocardlistitem_title="@string/backcover_calibration"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/gap"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/headset_caribrition"
                android:visibility="gone"
                app:ocardlistitem_title="@string/headset_calibration_title"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/shadow_below_headset_caribrition"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/smart_denoise"
                app:ocardlistitem_title="@string/smart_denoise"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/shadow_below_smart_denoise"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/id_accessibility_expertise_settings"
                app:ocardlistitem_title="@string/accessibility_expertise_settings_title"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/shadow_below_accessibility"
                layout="@layout/item_bottom_shadow_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sensor_switcher_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_pocket_mode"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/pocket_mode_tips"
                    app:ocardlistitem_title="@string/pocket_mode"
                    style="@style/OCardListItemSwitchSingle"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_scheduled_power_on_and_off"
                    android:layout_marginTop="@dimen/setting_item_gap"
                    app:ocardlistitem_title="@string/title_scheduled_power_on_and_off"
                    style="@style/OCardListItemTextSingle"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_earthquake_warning"
                    android:layout_marginTop="@dimen/setting_item_gap"
                    app:ocardlistitem_title="@string/title_earthquake_warning"
                    style="@style/OCardListItemTextSingle"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/prevent_wrong_touch"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_title="@string/prevent_locked_screen_wrong_touch"
                style="@style/OCardListItemSwitchSingle"/>
            <TextView
                android:id="@+id/prevent_wrong_touch_tips"
                android:text="@string/prevent_locked_screen_wrong_touch_tips"
                style="@style/OCardListShows"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/tts_settings"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_title="@string/tts_settings_title"
                style="@style/OCardListItemTextSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/accessibility_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_titleText="@string/accessibility_services_title"
                    style="@style/OSectionTitleBar.S"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/services_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ue_switch"
                android:visibility="visible"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/ue_title"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/item_ue_licence"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/user_analytics_des"
                style="@style/OSectionTitleBar.S"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_assistant"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
