<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/app_power_usage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:layout_marginHorizontal="16dp"
        app:sectionTitle_showCustomEnd="false"
        app:sectionTitle_titleText="@string/power_usage"
        style="@style/OSectionTitleBar.S"/>
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/today"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                app:oui_list_item_show_divider="true"
                app:oui_list_item_title="@string/data_usage_cycle_today"
                style="@style/SettingSubItemSingleStyleNoBackground"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/week"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                app:oui_list_item_show_divider="true"
                app:oui_list_item_title="@string/data_usage_cycle_week"
                style="@style/SettingSubItemSingleStyleNoBackground"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/month"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                app:oui_list_item_show_divider="true"
                app:oui_list_item_title="@string/data_usage_cycle_month"
                style="@style/SettingSubItemSingleStyleNoBackground"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/percent"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                app:oui_list_item_title="@string/data_usage_cycle_percent"
                style="@style/SettingSubItemSingleStyleNoBackground"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
