<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:obric="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.MenuDialogTitleBar
        android:id="@+id/menu_dialog_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        obric:show_divider="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentPanel"
        android:background="#f5f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/content_list"
            android:paddingLeft="@dimen/menu_dialog_horizontal_distance"
            android:paddingTop="24dp"
            android:paddingRight="@dimen/menu_dialog_horizontal_distance"
            android:paddingBottom="24dp"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:listSelector="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="18dp"
            android:overScrollMode="never"/>
        <obric.widget.ShadowButton
            android:id="@+id/btn_ok"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/menu_dialog_horizontal_distance"
            android:layout_marginTop="24dp"
            android:layout_marginRight="@dimen/menu_dialog_horizontal_distance"
            android:layout_marginBottom="24dp"
            android:singleLine="true"
            style="@style/LongButton.Shrink.Highlight.Red"/>
    </LinearLayout>
</LinearLayout>
