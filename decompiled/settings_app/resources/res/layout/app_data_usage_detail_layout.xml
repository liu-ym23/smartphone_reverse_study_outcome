<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <include
                android:id="@+id/app_snippet"
                layout="@layout/manage_applications_item"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_titleText="@string/phone_data_usage_summary"
                style="@style/OSectionTitleBar.S"/>
            <FrameLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/today"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_top"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/data_usage_cycle_today"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/data_usage_cycle_week"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/month"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_bottom"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/data_usage_cycle_month"/>
                </LinearLayout>
            </FrameLayout>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/id_perm_settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_data_permision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/allow_data_permission"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_use_data_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/power_usage_background_network_regulator_tips"
                    app:ocardlistitem_title="@string/allow_data_connection_in_background"/>
                <include layout="@layout/item_bottom_shadow_layout2"/>
            </LinearLayout>
            <include layout="@layout/item_bottom_shadow_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/data_usage_summary_info"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
