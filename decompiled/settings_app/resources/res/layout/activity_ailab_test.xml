<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title">
        <com.obric.oui.bouncelayout.OScrollView
            android:id="@+id/scroll_content"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/test_item_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"/>
        </com.obric.oui.bouncelayout.OScrollView>
        <com.obric.oui.button.OButton
            android:id="@+id/apply_btn"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/oui_p_container_2"
            android:layout_marginBottom="32dp"
            android:text="@string/ailab_settings_submit"
            android:layout_marginHorizontal="@dimen/oui_p_container_large_2"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
