<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="20dp"
    style="@style/Biometrics">
    <com.obric.oui.text.OTextView
        android:text="@string/biometrics_fingerprint_welcome"
        style="@style/Biometrics.Text"/>
    <com.obric.oui.text.OTextView
        android:text="@string/biometrics_fingerprint_about_title"
        style="@style/Biometrics.Text.Title"/>
    <LinearLayout style="@style/Biometrics.Horizontal">
        <com.obric.oui.text.OTextView style="@style/Biometrics.Text.Index"/>
        <com.obric.oui.text.OTextView
            android:text="@string/biometrics_fingerprint_about_content"
            style="@style/Biometrics.Text.Content.Bottom"/>
    </LinearLayout>
    <com.obric.oui.text.OTextView
        android:text="@string/biometrics_fingerprint_notice_title"
        style="@style/Biometrics.Text.Title"/>
    <LinearLayout style="@style/Biometrics.Horizontal">
        <com.obric.oui.text.OTextView style="@style/Biometrics.Text.Index"/>
        <com.obric.oui.text.OTextView
            android:text="@string/biometrics_fingerprint_notice_1_content"
            style="@style/Biometrics.Text.Content"/>
    </LinearLayout>
    <LinearLayout style="@style/Biometrics.Horizontal">
        <com.obric.oui.text.OTextView style="@style/Biometrics.Text.Index"/>
        <com.obric.oui.text.OTextView
            android:text="@string/biometrics_fingerprint_notice_2_content"
            style="@style/Biometrics.Text.Content.Bottom"/>
    </LinearLayout>
    <com.obric.oui.text.OTextView
        android:text="@string/biometrics_fingerprint_privacy_title"
        style="@style/Biometrics.Text.Title"/>
    <LinearLayout style="@style/Biometrics.Horizontal">
        <com.obric.oui.text.OTextView style="@style/Biometrics.Text.Index"/>
        <com.obric.oui.text.OTextView
            android:text="@string/biometrics_fingerprint_privacy_1_content"
            style="@style/Biometrics.Text.Content"/>
    </LinearLayout>
    <LinearLayout style="@style/Biometrics.Horizontal">
        <com.obric.oui.text.OTextView style="@style/Biometrics.Text.Index"/>
        <com.obric.oui.text.OTextView
            android:text="@string/biometrics_fingerprint_privacy_2_content"
            style="@style/Biometrics.Text.Content.Bottom"/>
    </LinearLayout>
</LinearLayout>
