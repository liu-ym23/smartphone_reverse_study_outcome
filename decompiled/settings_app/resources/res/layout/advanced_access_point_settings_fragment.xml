<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:paddingTop="112dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/proxy_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/proxy_setting_label_proxy"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/proxy_setting_auto_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/proxy_setting_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/proxy_setting_label_pac"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/proxy_setting_manual_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/proxy_hostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/proxy_hostname_label"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/proxy_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/proxy_port_label"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/proxy_exclusionlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/proxy_exclusionlist_label"/>
            </LinearLayout>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/proxy_warning_limited_support"
                style="@style/OSectionTitleBar.S"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/static_ip_address_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/static_ip_address"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_ip_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_advanced_ip_address_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_gateway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_gateway"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_network_prefix_len"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_network_prefix_length"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_dns1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_dns1"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_dns2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_dns2"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/wifi_advanced_options"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
