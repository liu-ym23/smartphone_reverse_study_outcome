<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/anim_layer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/guide_anim_view"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:lottie_rawRes="@raw/lottie_fingerprint_enroll_guide_loop_light"
            app:lottie_repeatCount="-1"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/init_layer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_normal_state"
            android:layout_width="@dimen/pacific_fingerprint_press_w_mm"
            android:layout_height="@dimen/pacific_fingerprint_press_h_mm"
            android:src="@drawable/fingerprint_normal_state"
            android:scaleType="fitCenter"/>
    </FrameLayout>
</RelativeLayout>
