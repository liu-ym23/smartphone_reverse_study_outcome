<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="always">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/main_settings_first_item_card_gap">
                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/settings_item_horizontal_padding"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:id="@+id/tv_explanation"
                    android:visibility="gone"
                    android:layout_marginHorizontal="32dp"
                    app:layout_constraintBottom_toTopOf="@+id/card_container"
                    app:layout_constraintEnd_toEndOf="@+id/frameLayout"
                    app:layout_constraintStart_toStartOf="@+id/frameLayout"
                    app:layout_constraintTop_toBottomOf="@+id/frameLayout"
                    app:section_des_text="@string/right_explanation_content"
                    style="@style/OSectionTitleBar.S"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_explanation"
                    app:layout_goneMarginTop="0dp">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/official_phone"
                        android:visibility="gone"
                        app:ocardlistitem_showSubTitle="true"
                        app:ocardlistitem_title="@string/official_phone"
                        app:oui_list_item_trailing_image="@drawable/phone_icon"
                        style="@style/OCardListItemTextTop"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/official_email"
                        android:visibility="gone"
                        app:ocardlistitem_title="@string/official_email"
                        app:oui_list_item_trailing_image="@drawable/email_icon"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/official_website"
                        android:visibility="gone"
                        app:ocardlistitem_title="@string/official_website"
                        app:oui_list_item_trailing_image="@drawable/website_icon"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/doubao_community"
                        android:visibility="gone"
                        app:oui_list_item_trailing_image="@drawable/website_icon"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/wechat"
                        android:visibility="gone"
                        app:oui_list_item_trailing_image="@drawable/website_icon"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/doubao_forum"
                        android:visibility="gone"
                        app:oui_list_item_trailing_image="@drawable/website_icon"
                        style="@style/OCardListItemTextBottom"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.obric.oui.bouncelayout.OScrollView>
    </LinearLayout>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/loading_cl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.progress.ODownloadProgressView
            android:id="@+id/loading_progress_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/loading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:oui_progress_view_size="large"
            app:oui_progressing_action_color="@color/oui_basic_text_1"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_license_activity_loading"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/loading_progress_large"
            app:layout_constraintStart_toStartOf="@+id/loading_progress_large"
            app:layout_constraintTop_toBottomOf="@+id/loading_progress_large"
            app:layout_goneMarginTop="0dp"
            style="@style/Title_1_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/network_error_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/network_error_new"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_3_Medium"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/guarantee_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
