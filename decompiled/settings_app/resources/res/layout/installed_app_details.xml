<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_width="match_parent"
                android:layout_height="104dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/app_snippet"
                    layout="@layout/manage_applications_item"/>
                <FrameLayout
                    android:id="@+id/frame_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="12dp"/>
                <com.obric.oui.button.OButton
                    android:textStyle="bold"
                    android:textColor="@color/oui_accent_fg"
                    android:id="@+id/special_disable_button"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="@dimen/item_block_gap"
                    android:layout_marginHorizontal="12dp"
                    style="@style/OButton.ListItem.Center"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/app_notifications_switch_label"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_notification_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/setting_application_system_layer_icon"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_more_title"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_storage_item"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/secletor_storage_item_icon"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/storage_label"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_battery_manager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/secletor_battery_item_icon"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/battery_manager_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_perm_manager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/secletor_perm_item_icon"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/permission_management"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_data_usage_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/secletor_data_usage_icon"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/data_usage_summary_info"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/unused_apps_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/unused_apps_switch_v2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/clear_activities_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                app:ocardlistitem_showCustomStart="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/auto_launch"
                android:layout_marginBottom="@dimen/dimen_32"
                android:layout_marginHorizontal="@dimen/dimen_32"
                style="@style/OSectionTitleBar.S"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/screen_compatibility_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/screen_compatibility_label"
                    android:layout_marginHorizontal="20dp"
                    style="@style/Subtitle_2_Medium"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/ask_compatibility_cb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/ask_compatibility"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/enable_compatibility_cb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/enable_compatibility"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/screen_compatibility_text"
                    android:layout_marginHorizontal="20dp"
                    style="@style/Subtitle_2_Medium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/permissions_section"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_label"
                    android:layout_marginHorizontal="20dp"
                    style="@style/Subtitle_2_Medium"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/security_settings_billing_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/security_settings_premium_sms_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_single"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_icon="@drawable/setting_application_system_layer_icon"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/security_settings_premium_sms_desc"/>
                    <TextView
                        android:id="@+id/security_settings_billing_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/security_settings_billing_desc"
                        android:layout_marginHorizontal="20dp"
                        style="@style/Subtitle_2_Regular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/security_section"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/setting_item_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/security_settings_desc"
                        android:paddingLeft="@dimen/settings_item_title_left_margin"
                        android:paddingTop="12dp"
                        android:paddingRight="@dimen/settings_item_title_right_margin"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_settings_desc"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/security_settings_list"
                        android:paddingLeft="@dimen/app_info_item_margin_left"
                        android:paddingRight="@dimen/app_info_item_margin_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp">
        <TextView
            android:id="@+id/cts_services_summary_item"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="@string/cts_services_summary"/>
        <TextView
            android:id="@+id/cts_all_services_item"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="@string/cts_all_services"/>
    </LinearLayout>
</RelativeLayout>
