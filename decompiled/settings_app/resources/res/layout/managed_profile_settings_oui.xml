<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/view_title_container"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_alignParentTop="true"
            app:oFloatingTitleBar_centerTitle="@string/managed_profile_settings_title"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"
            style="@style/TitleStyle"/>
    </FrameLayout>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title_container"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/work_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/work_mode_summary"
                app:ocardlistitem_title="@string/work_mode_label"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/contacts_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/managed_profile_contact_search_summary"
                app:ocardlistitem_title="@string/managed_profile_contact_search_title"
                style="@style/OCardListItemSwitchSingle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
