<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:layout_marginTop="@dimen/setting_item_gap"
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:sectionTitle_titleText="@string/conversation_notifs_category"
        style="@style/OSectionTitleBar.S"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/item_conversation"
        android:visibility="gone"
        app:ocardlistitem_title="@string/conversations_category_title"
        style="@style/OCardListItemTextTop"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/item_bubble"
        app:ocardlistitem_title="@string/bubbles_app_toggle_title"
        style="@style/OCardListItemTextSingle"/>
</LinearLayout>
