<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:id="@+id/scroll_content"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ai_lab_screen_memory_large_logo"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/oui_text_1"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ailab_settings_screen_memory"
                    android:textFontWeight="500"/>
                <TextView
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/ailab_settings_screen_memory_desc2"
                    android:layout_marginHorizontal="32dp"
                    style="@style/Label_L_Thin"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp">
                    <com.obric.oui.lisitem.OCardListItem
                        app:ocardlistitem_showSubTitle="true"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_subTitle="@string/ailab_settings_screen_doubao_desc"
                        app:ocardlistitem_title="@string/ailab_settings_screen_doubao_title"
                        style="@style/OCardListItemTextTop"/>
                    <com.obric.oui.lisitem.OCardListItem
                        app:ocardlistitem_showSubTitle="true"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_subTitle="@string/ailab_settings_screen_notification_desc"
                        app:ocardlistitem_title="@string/ailab_settings_screen_notification_title"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        app:ocardlistitem_showSubTitle="true"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_subTitle="@string/ailab_settings_screen_ai_diary_desc"
                        app:ocardlistitem_title="@string/ailab_settings_screen_ai_diary_title"
                        style="@style/OCardListItemTextMid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        app:ocardlistitem_showSubTitle="true"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_subTitle="@string/ailab_settings_screen_personal_info_desc"
                        app:ocardlistitem_title="@string/ailab_settings_screen_personal_info_title"
                        style="@style/OCardListItemTextBottom"/>
                </LinearLayout>
            </LinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
        <com.obric.oui.button.OButton
            android:id="@+id/apply_btn"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/oui_p_container_2"
            android:layout_marginBottom="32dp"
            android:text="@string/ailab_settings_start_apply"
            android:layout_marginHorizontal="@dimen/oui_p_container_large_2"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
