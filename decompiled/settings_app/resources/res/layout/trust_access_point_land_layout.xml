<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.ListContentItemCustom
        android:id="@+id/list_item_container"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/remove_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/item_remove_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:src="@drawable/ic_remove"
                android:contentDescription="@string/delete"/>
        </LinearLayout>
        <obric.widget.SwitchEx
            android:id="@+id/item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_toLeftOf="@+id/item_switch"
            android:layout_toRightOf="@+id/remove_layout"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_summary_text_color"
                android:id="@+id/currently_connected_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/settings_item_right_widget_margin"
                android:text="@string/currently_connected_network_text"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/title_layout_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/currently_connected_text">
                <TextView
                    android:textSize="@dimen/primary_text_size"
                    android:id="@android:id/title"
                    android:paddingRight="@dimen/settings_item_horizontal_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ListContentItemPrimaryText"/>
                <TextView
                    android:textSize="@dimen/tertiary_text_size"
                    android:id="@android:id/summary"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ListContentItemSecondaryText"/>
            </LinearLayout>
        </RelativeLayout>
    </obric.widget.ListContentItemCustom>
</LinearLayout>
