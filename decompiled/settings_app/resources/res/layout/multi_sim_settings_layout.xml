<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container_rl"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/sim_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_icon="@drawable/multi_sim_sim1_icon"
                app:ocardlistitem_showIcon="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/multi_sim_sub_1_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/sim_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_icon="@drawable/multi_sim_sim2_icon"
                app:ocardlistitem_showIcon="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/multi_sim_sub_2_title"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/multi_sim_default_sim"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/dial_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/multi_sim_dial_settings_tips"
                app:ocardlistitem_title="@string/multi_sim_dial_setting"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/mms_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/multi_sim_mms_settings_tips"
                app:ocardlistitem_title="@string/multi_sim_sms_setting"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/network_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/choose_data_sim_card"
                app:ocardlistitem_title="@string/multi_sim_network_setting"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/net_on_non_data_sim"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/net_on_non_data_sim_tips"
                app:ocardlistitem_title="@string/net_on_non_data_sim"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/net_intelligent_dual_sim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/net_intelligent_dual_sim_sub_title"
                app:ocardlistitem_title="@string/net_intelligent_dual_sim_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sim_pin_settings"/>
            <TextView
                android:visibility="gone"
                android:text="@string/multi_sim_using_habit"
                style="@style/SettingItemTitleStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/habit_dual_sim"
                android:visibility="gone"
                app:oui_list_item_title="@string/using_dual_sim_mostly"
                style="@style/SettingSubItemNoBottomStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/habit_single_sim"
                android:visibility="gone"
                app:oui_list_item_title="@string/using_single_sim_mostly"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.ListContentItemCustom
                android:visibility="gone"
                app:customMidView="@layout/sim_settings_habit_item_layout"
                style="@style/SettingSubItemBottomStyle"/>
            <TextView
                android:id="@+id/multi_sim_using_habit_tips"
                android:visibility="gone"
                android:text="@string/multi_sim_using_habit_tips"
                style="@style/SettingItemTipsStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/multi_sim_settings_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
