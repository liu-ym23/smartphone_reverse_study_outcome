<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OListView
        android:id="@+id/search_listview"
        android:scrollbars="none"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_below="@+id/search_bar_container"
        android:overScrollMode="always"/>
    <TextView
        android:textColor="@color/oui_text_3"
        android:gravity="center_horizontal"
        android:id="@+id/search_empty_view"
        android:background="@color/oui_bg_base_1"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="284dp"
        android:text="@string/no_search_result"
        android:layout_below="@+id/search_bar_container"
        style="@style/Title_3_Medium"/>
    <RelativeLayout
        android:id="@+id/tips_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_bar_container">
        <com.obric.oui.status.OPageStatus
            android:gravity="center"
            android:id="@+id/blankview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="284dp"
            app:opagestatus_title="@string/notification_search_prompt"
            app:opagestatus_type="status_content"/>
    </RelativeLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="false"
        app:oui_widgetBlurType="2">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/view_title1"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp">
                <com.obric.oui.searchbar.v2.OSearchBar
                    android:id="@+id/search_field_bar"
                    android:layout_width="0dp"
                    android:hint="@string/search"
                    android:layout_weight="1"
                    style="@style/OStyleV2.OSearchBar.Default.S"/>
                <com.obric.oui.button.OIconButtonFloating
                    android:id="@+id/search_cancel_button"
                    android:visibility="visible"
                    android:layout_marginLeft="8dp"
                    app:oui_widgetIcon="@drawable/oui_icon_xmark"
                    style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
</RelativeLayout>
