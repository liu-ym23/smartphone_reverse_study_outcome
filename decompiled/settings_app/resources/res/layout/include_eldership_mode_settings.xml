<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/eldership_all_settings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/eldership_mode_tips"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/eldership_mode_tips"
        style="@style/SettingItemTipsStyle"/>
    <TextView
        android:visibility="gone"
        android:text="@string/display_settings"
        style="@style/SettingItemTitleStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_launcher_grids"
        android:visibility="gone"
        app:oui_list_item_title="@string/launcher_grids"
        style="@style/SettingSubItemNoBottomStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_font_size"
        android:visibility="gone"
        app:oui_list_item_title="@string/font_size"
        style="@style/SettingSubItemSingleStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_screen_zoom"
        android:visibility="gone"
        app:oui_list_item_title="@string/screen_zoom_title"
        style="@style/SettingSubItemSingleStyle"/>
    <include
        android:visibility="gone"
        layout="@layout/item_bottom_shadow_layout"/>
    <TextView
        android:text="@string/eldership_mode_sound_settings"
        style="@style/SettingItemTitleStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_ringtone"
        app:oui_list_item_title="@string/sound_settings_text_phone_ring"
        style="@style/SettingSubItemSingleStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_switch_mute_double_check"
        android:visibility="gone"
        app:oui_list_item_title="@string/mute_double_check"
        style="@style/SettingSubItemSingleStyle"/>
    <TextView
        android:visibility="gone"
        android:text="@string/mute_double_check_tips"
        style="@style/SettingItemTipsStyle"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_hand_in_hand"
        app:oui_list_item_title="@string/hand_in_hand"
        style="@style/SettingSubItemNoBottomStyle"/>
    <TextView
        android:id="@+id/shortcut_contacts_tips"
        android:text="@string/shortcut_contacts_tips"
        style="@style/SettingItemTipsStyle"/>
    <TextView
        android:visibility="gone"
        android:text="@string/other_settings"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.SettingItemSwitch
        android:id="@+id/item_switch_text_boom"
        android:visibility="gone"
        app:smtTitle="@string/text_boom"
        style="@style/SettingSubItemTopStyle"/>
    <obric.widget.SettingItemSwitch
        android:id="@+id/item_switch_one_step"
        android:visibility="gone"
        app:smtTitle="@string/one_step_settings"
        style="@style/SettingSubItemMidStyle"/>
    <obric.widget.SettingItemSwitch
        android:id="@+id/item_switch_idea_pills"
        android:visibility="gone"
        app:smtTitle="@string/global_idea_pills"
        style="@style/SettingSubItemBottomStyle"/>
    <include layout="@layout/scrollview_bottom_gap_layout"/>
    <com.android.settings.widget.SettingsBottomExtraView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
