<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/device_admin_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_device_manager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/security_item_device_manager"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_trust_agent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/manage_trust_agents"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/package_installer_settings_title"/>
            <include
                android:id="@+id/item_id_source_gap"
                layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/item_id_crypt_keeper_encrypt_tips"
                android:layout_marginTop="0dp"
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/crypt_keeper_settings_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_crypt_keeper_encrypt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/crypt_keeper_encrypt_title"/>
            <include
                android:id="@+id/item_id_encrypt_gap"
                layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/credentials_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_certificate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/trusted_credentials"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                app:ocardlistitem_showCustomStart="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:textColor="@color/oui_basic_text_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/install_sdcard_certificate_tips"
                style="@style/Subtitle_2_Regular"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                app:ocardlistitem_showCustomStart="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/security_advanced_options"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
