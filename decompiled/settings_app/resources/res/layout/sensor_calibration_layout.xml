<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title">
        <FrameLayout
            android:id="@+id/sensor_calibration_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_item_top_bottom_margin">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_text_color_disabled"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sensor_calibration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/sensor_calibration_progress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/sensor_calibration_progressbar_anim"/>
        </FrameLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/sensor_calibrate_button"
            android:paddingTop="@dimen/calibrate_button_padding_top"
            android:paddingBottom="@dimen/calibrate_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/sensor_button_item_marginTop"
            android:text="@string/sensor_calibrate_button_init"
            style="@style/LongButton.Highlight"/>
        <TextView
            android:id="@+id/sensor_calibration_tips"
            android:text="@string/sensor_calibration_tips_content"
            style="@style/SettingItemTipsStyle"/>
        <com.obric.oui.button.OButton
            android:id="@+id/psensor_calibrate_button"
            android:paddingTop="@dimen/calibrate_button_padding_top"
            android:paddingBottom="@dimen/calibrate_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/sensor_button_item_marginTop"
            android:text="@string/psensor_low_noise_tip"
            android:singleLine="false"
            style="@style/LongButton.Highlight"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:id="@+id/psensor_low_noise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/psensor_low_noise"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:id="@+id/psensor_near"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/psensor_near_threshold"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:id="@+id/psensor_far"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/psensor_far_threshold"/>
    </LinearLayout>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
