<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/developing_function_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemText
                android:id="@+id/dev_app"
                app:smtTitle="@string/dev_app_label"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/tablet_settings"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/tablet_settings"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/multi_user"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/user_settings_title"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/zoom_mode"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/zoom_mode"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/font_size"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/font_size"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/dp_lane"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/dp_lane"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/phone_voice_water_drop"
                android:visibility="gone"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/phone_voice_water_drop"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/allow_drag_windows"
                android:visibility="visible"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/allow_drag_windows"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/swap_feature"
                android:visibility="gone"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/memory_swap_feature"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/mm_send_by_enter_feature"
                android:visibility="visible"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/mm_send_by_enter_feature"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/mm_send_by_enter_selection"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/mm_send_by_enter_selection"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/allow_move_task_directly"
                android:visibility="visible"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/allow_move_task_directly"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/screen_scale"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/adjust_screen_scale"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/big_bang_text_settings"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/big_bang_trgger_area_for_text"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/force_touch_settings"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/force_touch_settings_title"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/big_bang_ocr_settings"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/big_bang_trgger_area_for_ocr"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_navigation_bar_vibration_strength"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/vibration_setting"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/leak_canary"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/leak_canary"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/status_bar_mode"
                android:visibility="gone"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                app:smtTitle="@string/status_bar_style_title"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/multi_block_tips"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                android:text="@string/developing_tips"
                style="@style/SettingItemTipsStyle"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
