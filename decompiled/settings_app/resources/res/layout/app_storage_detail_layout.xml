<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="104dp"/>
            <include
                android:id="@+id/app_snippet"
                layout="@layout/manage_applications_item"/>
            <FrameLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/total_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_top"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/total_size_label"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/application_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/application_size_label"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/external_code_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/external_code_size_label"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/info_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/data_size_label"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/external_data_size_prefix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showDivider="false"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="false"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/external_data_size_label"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/left_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_cardType="type_container"
                    app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                    app:ocardlistitem_showCardBg="true"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/right_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_container"
                    app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                    app:ocardlistitem_showCardBg="true"/>
            </LinearLayout>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/cache_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/cache_size_label"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/clear_cache_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                app:ocardlistitem_showCardBg="true"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include
        android:visibility="gone"
        layout="@layout/bottom_tips_layout"/>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/storage_label"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
