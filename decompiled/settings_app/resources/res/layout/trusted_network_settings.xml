<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_layout"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/settings_item_tips_text_size"
                android:textColor="@color/setting_item_tips_color"
                android:paddingLeft="@dimen/settings_item_title_left_margin"
                android:paddingTop="10dp"
                android:paddingRight="@dimen/settings_item_title_left_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trusted_network_finded"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/setting_item_tips_color"
                android:id="@+id/access_point_name"
                android:paddingLeft="@dimen/settings_item_title_left_margin"
                android:paddingRight="@dimen/settings_item_title_left_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13.5dp"
                android:layout_marginBottom="11.5dp"/>
            <TextView
                android:textSize="@dimen/settings_item_tips_text_size"
                android:textColor="@color/setting_item_tips_color"
                android:id="@+id/description"
                android:paddingLeft="@dimen/settings_item_title_left_margin"
                android:paddingRight="@dimen/settings_item_title_left_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.5dp"
                android:text="@string/trusted_network_description"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/btn_set"
                app:oui_list_item_title="@string/trusted_network_set_btn"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/btn_unset"
                app:oui_list_item_title="@string/trusted_network_unset_btn"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:layout_marginTop="1.5dp"
                android:text="@string/trusted_network_modificable_tips"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.obric.oui.button.OButton
            android:id="@+id/no_notify"
            android:clickable="true"
            android:layout_height="@dimen/oui_h_l2"
            android:text="@string/trusted_network_no_more_notify"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/OButton.ListItem.Center"/>
        <include layout="@layout/item_bottom_shadow_layout"/>
    </LinearLayout>
</RelativeLayout>
