<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/hidden_packages_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_icon="@drawable/setting_application_system_layer_icon"
        app:ocardlistitem_showCustomEnd="false"
        app:ocardlistitem_showDivider="false"
        app:ocardlistitem_showIcon="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/hidden_packages"/>
    <RelativeLayout
        android:id="@+id/locked_packages_view"
        android:background="@drawable/app_list_item_bg_selector"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/locked_packages_icon"
            android:background="@drawable/setting_application_lock"
            android:duplicateParentState="true"
            android:layout_width="@dimen/settings_list_item_icon_size"
            android:layout_height="@dimen/settings_list_item_icon_size"
            android:layout_marginLeft="@dimen/manager_app_list_item_margin_left"
            android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:id="@+id/locked_packages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="270dp"
            android:text="@string/locked_packages"
            android:singleLine="true"
            android:layout_toRightOf="@+id/locked_packages_icon"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_list_item_gap_right"
            android:src="@drawable/secletor_setting_item_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
