<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@null"
    android:paddingLeft="@dimen/pop_up_dialog_horizontal_margin"
    android:paddingRight="@dimen/pop_up_dialog_horizontal_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/transparent_view"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:background="@drawable/popup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <TextView
            android:textSize="@dimen/popup_airplane_info_text_size"
            android:textColor="#888888"
            android:id="@+id/popup_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="@dimen/airplane_tips_margin_top"
            android:layout_marginBottom="@dimen/airplane_tips_margin_bottom"
            android:lineSpacingExtra="13dp"/>
    </FrameLayout>
</LinearLayout>
