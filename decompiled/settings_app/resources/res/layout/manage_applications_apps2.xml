<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/empty_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        settings:layout_constraintBottom_toBottomOf="parent"
        settings:layout_constraintTop_toTopOf="@+id/content_layout">
        <com.obric.oui.status.OPageStatus
            android:layout_gravity="center"
            android:id="@+id/manager_status_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            settings:opagestatus_type="status_content"/>
    </FrameLayout>
    <include
        settings:layout_constraintBottom_toBottomOf="parent"
        settings:layout_constraintTop_toBottomOf="@+id/pinned_header"
        layout="@layout/loading_container"/>
    <FrameLayout
        android:id="@+id/pinned_header"
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        settings:layout_constraintBottom_toTopOf="@+id/apps_list"
        settings:layout_constraintTop_toBottomOf="@+id/view_title"
        settings:layout_constraintVertical_bias="0"
        settings:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        settings:layout_constraintLeft_toLeftOf="parent"
        settings:layout_constraintRight_toRightOf="parent"
        settings:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/apps_list"
            android:visibility="visible"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            settings:fastScrollEnabled="false"
            settings:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            settings:layout_constraintLeft_toLeftOf="parent"
            settings:layout_constraintRight_toRightOf="parent"
            settings:layout_constraintTop_toBottomOf="@+id/settings_premission_header"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        settings:layout_constraintTop_toTopOf="parent"
        settings:oFloatingTitleBar_centerTitle="@string/special_access"
        settings:oFloatingTitleBar_maskBlurRadius="8"
        settings:oFloatingTitleBar_statusBarImmersion="true"/>
    <FrameLayout
        android:id="@+id/cts_item_container"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="200dp"
        settings:layout_constraintLeft_toLeftOf="parent"
        settings:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/cts_item_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/external_source_switch_title"/>
        <com.obric.oui.oswitch.OSwitch
            android:id="@+id/cts_item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
