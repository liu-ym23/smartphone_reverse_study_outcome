<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="73.5dp"
        android:layout_centerInParent="true"
        android:splitMotionEvents="true"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp">
        <View
            android:id="@+id/bottom_gap"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_alignParentBottom="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_gap"
            android:splitMotionEvents="true">
            <Button
                android:enabled="false"
                android:id="@+id/easy_password_keyboard_blank"
                android:background="@color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButton"/>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_0"
                    style="@style/PinKeyboardNumber"/>
            </LinearLayout>
            <com.obric.oui.button.OButton
                android:id="@+id/pinDel"
                android:background="@color/oui_basic_bg_base_1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/delete"
                app:icon="@drawable/easy_password_keyboard_delete"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OStyleV2.OIconButton.M.Standard.HighLight"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/row_4"
            android:splitMotionEvents="true">
            <LinearLayout
                android:id="@+id/easy_password_keyboard_7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_7"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_7"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_8"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_8"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_9"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_9"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_9"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/row_3"
            android:splitMotionEvents="true">
            <LinearLayout
                android:id="@+id/easy_password_keyboard_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_4"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_4"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_5"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_5"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_6"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_6"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_above="@+id/row_2"
            android:splitMotionEvents="true">
            <LinearLayout
                android:id="@+id/easy_password_keyboard_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_1"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_2"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_2"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/easy_password_keyboard_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PinKeyboardButtonStyle">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/choose_lock_password_3"
                    style="@style/PinKeyboardNumber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_lock_password_letter_3"
                    style="@style/PinKeyboardLetter"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="13.5sp"
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/switch_digit"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/password_selection"
            android:singleLine="true"
            android:drawableRight="@drawable/arrow"
            android:drawablePadding="7dp"
            android:layout_above="@+id/row_1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#5c89f2"
            android:id="@+id/use_smiling_unlock"
            android:visibility="gone"
            android:text="@string/security_use_cloud_unlock"
            android:drawableRight="@drawable/arrow_blue"
            android:layout_above="@+id/row_1"
            style="@style/PrivacyKeyboardTextStyle"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#4d000000"
            android:id="@+id/forget_password"
            android:visibility="gone"
            android:text="@string/forgetPwd"
            android:drawableRight="@drawable/arrow"
            android:layout_above="@+id/row_1"
            style="@style/PrivacyKeyboardTextStyle"/>
    </RelativeLayout>
</FrameLayout>
