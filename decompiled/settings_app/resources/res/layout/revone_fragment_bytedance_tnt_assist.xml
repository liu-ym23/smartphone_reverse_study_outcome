<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        app:oui_title_text="@string/bytedance_tnt"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.ListContentItemText
                android:id="@+id/tnt_default_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/tnt_default_display_mode"
                style="@style/ListContentItemStyle.Single"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.ListContentItemText
                android:id="@+id/wifi_tnt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/wifi_tnt_settings_title"
                style="@style/ListContentItemStyle.Single"/>
            <TextView
                android:id="@+id/wifi_tnt_tips"
                android:visibility="gone"
                android:text="@string/wifi_tnt_settings_tips"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:id="@+id/wifi_tnt_gap_layout"
                layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.android.settings.widget.SettingItemImage
                android:id="@+id/wifi_tnt_item_image"
                android:src="@drawable/revone_phone_connect_tnt"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:text="@string/phone_connect_tnt_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:text="@string/connection_hint"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemImage
                android:id="@+id/connect_tnt_item_image"
                android:src="@drawable/revone_connection_hint"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:text="@string/connection_hint_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:text="@string/controls_hint"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemImage
                android:id="@+id/controls_tnt_item_image"
                android:src="@drawable/revone_operation_method"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/controls_hint_tips"
                android:paddingBottom="2dp"
                android:clipToPadding="false"
                android:layout_marginBottom="12dp"
                android:text="@string/controls_hint_tips"
                android:lineSpacingMultiplier="1.2"
                style="@style/SettingItemTipsStyle"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
