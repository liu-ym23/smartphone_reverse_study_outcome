<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/wifi_display_switch"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_title="@string/wifi_display_settings_title"/>
    <com.obric.oui.sectiontitlebar.OSectionSupportiveText
        android:id="@+id/wifi_display_switch_supportive_text_tips"
        android:layout_marginBottom="@dimen/dimen_16"
        android:layout_below="@+id/wifi_display_switch"
        android:layout_marginHorizontal="32dp"
        app:section_des_text="@string/font_scale_tips"
        style="@style/OSectionTitleBar.S"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/wifi_display_empty_tips_real_time_subtitles"
        android:paddingLeft="@dimen/emptyview_margin_left_right"
        android:visibility="gone"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        android:layout_below="@+id/wifi_display_switch_supportive_text_tips"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="5sp"
            android:textColor="@color/tips_or_section_title_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tip_point_margin_left_right"
            android:layout_marginRight="@dimen/tip_point_margin_left_right"
            android:text="●"/>
        <TextView
            android:textSize="@dimen/semi_small_text_size"
            android:textColor="@color/tips_or_section_title_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tip_point_margin_left_right"
            android:text="@string/wifi_display_empty_tips_real_time_subtitles"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/wifi_display_empty_tips_screen_video"
        android:paddingLeft="@dimen/emptyview_margin_left_right"
        android:visibility="gone"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        android:layout_below="@+id/wifi_display_empty_tips_real_time_subtitles"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="5sp"
            android:textColor="@color/tips_or_section_title_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tip_point_margin_left_right"
            android:layout_marginRight="@dimen/tip_point_margin_left_right"
            android:text="●"/>
        <TextView
            android:textSize="@dimen/semi_small_text_size"
            android:textColor="@color/tips_or_section_title_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tip_point_margin_left_right"
            android:text="@string/wifi_display_empty_tips_screen_video"/>
    </LinearLayout>
</RelativeLayout>
