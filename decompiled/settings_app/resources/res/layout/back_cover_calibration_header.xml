<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:paddingTop="@dimen/settings_item_top_bottom_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:text="@string/backcover_calibration_title"
        style="@style/SettingItemTitleStyle"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_cover"
        android:background="@drawable/sub_item_back_ground_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
