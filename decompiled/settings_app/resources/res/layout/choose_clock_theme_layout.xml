<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_centerTitle="@string/nuts_clock_theme"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/scrollview_bottom_gap_layout"/>
            <obric.widget.ListContentItemCustom
                android:id="@+id/first_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                isPressable="false"
                style="@style/SettingSubItemTopStyle">
                <ImageView
                    android:id="@+id/first_preview"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_preview_top_bottom_padding"
                    android:layout_marginBottom="@dimen/clock_theme_preview_top_bottom_padding"
                    android:src="@drawable/setting_clock_demo_01"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/first_check_icon"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_check_icon_margin_top"
                    android:layout_marginRight="@dimen/clock_theme_check_icon_margin_right"
                    android:src="@drawable/vertical_option_check_bg"
                    android:layout_alignParentRight="true"/>
            </obric.widget.ListContentItemCustom>
            <obric.widget.ListContentItemCustom
                android:id="@+id/second_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                isPressable="false"
                style="@style/SettingSubItemMidStyle">
                <ImageView
                    android:id="@+id/second_preview"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_preview_top_bottom_padding"
                    android:layout_marginBottom="@dimen/clock_theme_preview_top_bottom_padding"
                    android:src="@drawable/setting_clock_demo_02"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/second_check_icon"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_check_icon_margin_top"
                    android:layout_marginRight="@dimen/clock_theme_check_icon_margin_right"
                    android:src="@drawable/vertical_option_check_bg"
                    android:layout_alignParentRight="true"/>
            </obric.widget.ListContentItemCustom>
            <obric.widget.ListContentItemCustom
                android:id="@+id/third_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                isPressable="false"
                style="@style/SettingSubItemMidStyle">
                <ImageView
                    android:id="@+id/third_preview"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_preview_top_bottom_padding"
                    android:layout_marginBottom="@dimen/clock_theme_preview_top_bottom_padding"
                    android:src="@drawable/setting_clock_demo_03"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/third_check_icon"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_check_icon_margin_top"
                    android:layout_marginRight="@dimen/clock_theme_check_icon_margin_right"
                    android:src="@drawable/vertical_option_check_bg"
                    android:layout_alignParentRight="true"/>
            </obric.widget.ListContentItemCustom>
            <obric.widget.ListContentItemCustom
                android:id="@+id/fourth_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                isPressable="false"
                style="@style/ListContentItemStyle.Bottom">
                <ImageView
                    android:id="@+id/fourth_preview"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_preview_top_bottom_padding"
                    android:layout_marginBottom="@dimen/clock_theme_preview_top_bottom_padding"
                    android:src="@drawable/setting_clock_demo_04"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/fourth_check_icon"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clock_theme_check_icon_margin_top"
                    android:layout_marginRight="@dimen/clock_theme_check_icon_margin_right"
                    android:src="@drawable/vertical_option_check_bg"
                    android:layout_alignParentRight="true"/>
            </obric.widget.ListContentItemCustom>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
