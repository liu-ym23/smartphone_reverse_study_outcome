<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/pr_iv_arrow"
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/o_ic_refresh_arrow_down"/>
        <ImageView
            android:id="@+id/pr_iv_success"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/o_ic_refresh_success"/>
        <com.obric.oui.progress.ODownloadProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/pr_progress"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:oui_progress_background_color="@color/oui_basic_line_2"
            app:oui_progress_color="@color/oui_basic_text_1"
            app:oui_progress_view_size="small"
            app:oui_progressing_action_color="@color/oui_basic_text_1"/>
        <TextView
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/pr_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            style="@style/Label_L_Thin"/>
    </LinearLayout>
</FrameLayout>
