<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/setting_stylus"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/list_item_vertical_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <obric.widget.SettingItemSwitch
                android:id="@+id/bluetooth_switch"
                android:title="@string/bluetooth_settings_title"
                style="@style/SettingItemSingleStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/location_switch"
                android:title="@string/location_settings_title"
                style="@style/SettingItemSingleStyle"/>
            <TextView
                android:id="@+id/bt_tips"
                android:text="@string/bluetooth_and_location_switch_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.ListContentItemCustom
                android:id="@+id/movie_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ListContentItemStyle.Single">
                <com.android.settings.widget.MovieView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/movie_view_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/stylus_movie_margin"
                    android:layout_marginRight="@dimen/stylus_movie_margin"
                    app:mask_src="@drawable/stylus_overview"/>
            </obric.widget.ListContentItemCustom>
            <TextView
                android:id="@+id/stylus_movie_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stylus_video_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:id="@+id/avalaible_device"
                android:text="@string/avalaible_device"
                style="@style/SettingItemTitleStyle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stylus_listView"
                style="@style/ListViewGeneralStyle"/>
            <include
                android:id="@+id/stylus_listView_gap"
                layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/key_tips"
                android:visibility="gone"
                android:text="@string/key_event_tips"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/one_click_item"
                android:visibility="gone"
                android:title="@string/one_click"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/double_click_item"
                android:visibility="gone"
                android:title="@string/double_click"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/long_press_item"
                android:visibility="gone"
                android:title="@string/long_press"
                style="@style/SettingSubItemBottomStyle"/>
            <include
                android:id="@+id/id_pointer_gap"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/id_pointer"
                android:visibility="gone"
                android:title="@string/stylus_show_pointer"
                style="@style/SettingItemSingleStyle"/>
            <TextView
                android:id="@+id/pointer_tips"
                android:visibility="gone"
                android:text="@string/stylus_show_pointer_tips"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
