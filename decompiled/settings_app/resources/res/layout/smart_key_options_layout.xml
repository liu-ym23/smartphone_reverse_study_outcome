<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/smart_key_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/header_text"
                android:layout_width="wrap_content"
                android:layout_marginRight="@dimen/settings_item_title_left_margin"
                android:text="@string/smart_key_function_for"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/id_item_option_none"
                app:itemTitle="@string/undefined"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/id_item_option_cmel"
                android:visibility="gone"
                app:itemTitle="@string/cmel_esport_community"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/id_item_option_idea_pills"
                app:itemTitle="@string/open_create_idea_pills"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/id_item_option_one_step"
                app:itemTitle="@string/short_launch_one_step"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/double_click_header_text"
                android:layout_width="wrap_content"
                android:layout_marginRight="@dimen/settings_item_title_left_margin"
                android:text="@string/smart_key_double_function"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/double_click_option_none"
                app:itemTitle="@string/undefined"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/double_click_live_subtitles"
                app:itemTitle="@string/hearing_aid_name"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/double_click_wallet"
                app:itemTitle="@string/card_package_name"
                style="@style/SettingSubItemBottomStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
