<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_root"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/doubao_assistant_first_item_card_gap"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/system_intelligent_hero"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_20"
                    android:text="@string/system_intelligent_title"
                    style="@style/Title_4_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:text="@string/system_intelligent_tag"
                    style="@style/Body_1_Regular"/>
            </LinearLayout>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:background="@color/oui_fill_list_item_card"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                app:oui_radius="@dimen/dimen_20">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/icon_star"
                        android:layout_width="@dimen/dimen_16"
                        android:layout_height="@dimen/dimen_16"
                        android:src="@drawable/system_intelligent_star"/>
                    <com.obric.oui.text.OTextView
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/system_intelligent_statement_2_1"
                        android:layout_marginStart="8dp"
                        style="@style/Subtitle_2_Regular"/>
                </LinearLayout>
                <com.obric.oui.text.OTextView
                    android:textSize="16sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/system_intelligent_statement_2_2"
                    android:lineHeight="22dp"
                    android:textFontWeight="@integer/oui_font_weight_medium"/>
                <com.obric.oui.text.OTextView
                    android:textSize="9sp"
                    android:textColor="@color/oui_basic_text_3b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/system_intelligent_statement_tips"
                    android:lineSpacingMultiplier="1.26"
                    android:textFontWeight="300"/>
            </com.obric.oui.layout.OUILinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_switch"
                android:visibility="gone"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_enable"
                android:visibility="gone"
                android:layout_height="64dp"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_showCustomEnd="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                style="@style/OCardListItemTextSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/assistant_sub_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/doubao_settings"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/doubao_settings_summary"
                    app:ocardlistitem_title="@string/doubao_settings"
                    style="@style/OCardListItemTextTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/doubao_devices"
                    app:ocardlistitem_title="@string/doubao_settings_devices"
                    style="@style/OCardListItemTextBottom"/>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_activation"
                app:ocardlistitem_title="@string/assistant_activation"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_memory"
                android:visibility="visible"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/assistant_memory_summary"
                app:ocardlistitem_title="@string/assistant_memory"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_call_forwarding"
                app:ocardlistitem_title="@string/assistant_call_forwarding"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_high_priority_notification"
                app:ocardlistitem_title="@string/assistant_high_priority_notification"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/assistant_recording_summary"
                app:ocardlistitem_title="@string/assistant_recording_summary"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ai_lab"
                android:visibility="visible"
                app:ocardlistitem_title="@string/ailab_settings"
                style="@style/OCardListItemTextBottom"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle=""
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
