<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:paddingTop="13dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <obric.widget.ListContentItemText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Single">
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/power_usage_summary"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="153dp">
            <ImageView
                android:id="@+id/battery_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#878c96"
                android:id="@+id/battery_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"/>
        </LinearLayout>
    </obric.widget.ListContentItemText>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <obric.widget.ListContentItemText
        android:id="@+id/power_usage_cycle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/power_usage_save_mode"
        style="@style/ListContentItemStyle.Single"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/power_usage_battery_use_optimization"
        style="@style/GroupListSectionTitleStyle"/>
    <obric.widget.ListContentItemText
        android:id="@+id/app_battery_use_optimization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/power_usage_app_battery_use_optimization_title"
        app:arrow="@string/always_allow_bind_appwidgets_text"
        style="@style/ListContentItemStyle.Single"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <obric.widget.ListContentItemText
        android:id="@+id/dynamic_resolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/dynamic_resolution"
        style="@style/ListContentItemStyle.Single"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/network_background_control_title"
        style="@style/GroupListSectionTitleStyle"/>
    <obric.widget.ListContentItemSwitch
        android:id="@+id/network_optimization_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:smtTitle="@string/network_background_control"
        style="@style/ListContentItemStyle.Top"/>
    <obric.widget.ListContentItemText
        android:id="@+id/network_optimization_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/network_background_detail_settings"
        style="@style/ListContentItemStyle.Bottom"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <TextView
        android:id="@+id/power_usage_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/battery_usage_ranking"
        style="@style/GroupListSectionTitleStyle"/>
    <obric.widget.ListContentItemText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Top">
        <com.android.settings.widget.PowerUsageCycleView
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cycle_view"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_today"
                android:background="@drawable/power_usage_cycle_view_normal_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_today"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_week"
                android:background="@drawable/power_usage_cycle_view_normal_mid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_week"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_month"
                android:background="@drawable/power_usage_cycle_view_normal_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_month"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
        </com.android.settings.widget.PowerUsageCycleView>
    </obric.widget.ListContentItemText>
</LinearLayout>
