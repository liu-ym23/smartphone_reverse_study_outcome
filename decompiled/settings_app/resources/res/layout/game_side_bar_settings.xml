<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:dslv="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:id="@+id/parent"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/side_bar_menu"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/view_title">
            <obric.widget.SettingItemSwitch
                android:id="@+id/game_side_bar"
                android:title="@string/side_bar_menu"
                style="@style/SettingItemTopStyle"/>
            <com.android.settings.widget.SettingItemImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/gamemode_sidebar_intro"
                android:scaleType="centerInside"
                style="@style/SettingSubItemBottomStyle"/>
            <TextView
                android:id="@+id/game_side_bar_tips"
                android:text="@string/side_bar_menu_tips"
                style="@style/SettingItemTipsStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/float_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/float_app"
                    android:layout_marginBottom="6dp"
                    android:text="@string/float_app"
                    style="@style/SettingItemTitleStyle"/>
                <com.android.settings.widget.SettingItemImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/float_app_sketch_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/gamemode_floatapp_intro"
                    android:scaleType="centerInside"
                    style="@style/SettingSubItemSingleStyle"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
                <TextView
                    android:id="@+id/float_enabled_tips"
                    android:layout_marginBottom="6dp"
                    android:text="@string/enabled_float_app_tips"
                    style="@style/SettingItemTitleStyle"/>
                <include
                    android:id="@+id/float_list_item_bottom_shadow_layout"
                    layout="@layout/item_bottom_shadow_layout"/>
                <TextView
                    android:id="@+id/float_disabled_tips"
                    android:layout_marginBottom="6dp"
                    android:text="@string/disabled_float_app_tips"
                    style="@style/SettingItemTitleStyle"/>
                <com.obric.oui.bouncelayout.OListView
                    android:id="@+id/disabled_float_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="#00000000"
                    android:divider="@null"
                    android:minHeight="@dimen/float_list_item_height"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/scroll_view">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_safetylegal_activity_loading"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
