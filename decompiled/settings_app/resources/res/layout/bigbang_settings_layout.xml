<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/text_boom_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <obric.widget.SettingItemSwitch
                android:id="@+id/text_boom_switch"
                android:title="@string/text_boom"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.ListContentItemCustom
                android:id="@+id/gif_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SettingSubItemBottomStyle">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/preload_gif_img"
                    android:background="@drawable/bigbang_anim_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bigbang_anim_margin_common"
                    android:layout_marginBottom="@dimen/bigbang_anim_margin_common"
                    android:foreground="@drawable/middle"
                    android:src="@drawable/context"
                    android:scaleType="centerInside"
                    android:foregroundGravity="center"/>
                <ViewStub
                    android:id="@+id/gif_view_stub"
                    android:layout="@layout/bigbang_anim_layout_stub"
                    android:inflatedId="@+id/gif_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </obric.widget.ListContentItemCustom>
            <TextView
                android:id="@+id/id_big_bang_tips"
                android:text="@string/big_bang_tips"
                style="@style/SettingItemTipsStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sub_settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/ocr_switch"
                    android:title="@string/ocr_title_v2"
                    style="@style/SettingSubItemTopStyle"/>
                <obric.widget.SettingItemText
                    android:id="@+id/id_ocr_detail"
                    android:title="@string/ocr_detail_setting_title"
                    style="@style/SettingSubItemBottomStyle"/>
                <TextView
                    android:id="@+id/id_ocr_tips_v2"
                    android:layout_marginBottom="1dp"
                    android:text="@string/ocr_title_v2_tips"
                    style="@style/SettingItemTipsStyle"/>
                <TextView
                    android:id="@+id/id_audio_tips1"
                    android:text="@string/ocr_audio_privacy_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/ocr_game_switch"
                    android:title="@string/ocr_in_game_title"
                    style="@style/SettingSubItemTopStyle"/>
                <obric.widget.SettingItemText
                    android:id="@+id/ocr_app_sublist"
                    android:title="@string/ocr_in_app_title"
                    style="@style/SettingSubItemBottomStyle"/>
                <TextView
                    android:id="@+id/id_ocr_in_app_tips"
                    android:text="@string/ocr_in_app_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemText
                    android:id="@+id/textboom_trigger_area_options"
                    android:title="@string/thumb_trigger_area"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:text="@string/thumb_trigger_area_tips"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/intro_video_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.android.settings.widget.SettingItemImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/video_intro"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/setting_video_bigbang"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/usage_video_title"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:text="@string/usage_video_title"
                    style="@style/SettingItemTipsStyle"/>
                <com.android.settings.widget.SettingsBottomExtraView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
