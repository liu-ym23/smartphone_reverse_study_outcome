<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUILinearLayout
        android:orientation="vertical"
        android:id="@+id/bannerLayout"
        android:background="@color/oui_fill_list_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding"
        app:oui_radius="@dimen/dimen_20">
        <com.obric.oui.banner.OBanner
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:oui_banner_proportion="1.1056"
            style="@style/OBanner.Indent.Medium"/>
        <FrameLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <com.obric.oui.indicator.OCarouselIndicator
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/view_pager_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dimen_2dp"
                app:oui_dotsColor="@color/oui_text_4"
                app:oui_dotsCornerRadius="99dp"
                app:oui_dotsHeight="4dp"
                app:oui_dotsSpacing="2dp"
                app:oui_dotsStrokeWidth="0dp"
                app:oui_dotsWidth="4dp"
                app:oui_selectedDotColor="@color/oui_text_1"
                app:oui_type="normal"/>
        </FrameLayout>
    </com.obric.oui.layout.OUILinearLayout>
</FrameLayout>
