<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:obric="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.MenuDialogTitleBar
        android:id="@+id/menu_dialog_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        obric:show_divider="true"/>
    <FrameLayout
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="228dp">
        <RelativeLayout
            android:orientation="vertical"
            android:background="@color/pop_win_bg_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <obric.view.ViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/view_pager_margin_left"
                android:layout_marginTop="@dimen/view_pager_margin_top"
                android:layout_marginRight="@dimen/view_pager_margin_left"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <obric.app.IndicatorView
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/view_pager_margin_left"
                android:layout_marginTop="6dp"
                android:layout_marginRight="@dimen/view_pager_margin_left"
                android:layout_marginBottom="18dp"
                android:layout_below="@+id/viewPager"
                obric:radius="3dp"/>
            <ImageView
                android:id="@+id/border"
                android:background="@drawable/resolver_line_bg"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/dragTip"/>
            <TextView
                android:textSize="13.5sp"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/dragTip"
                android:focusable="false"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="48.5dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text="@string/set_default"
                android:layout_alignParentBottom="true"
                android:alpha="0.3"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/confirmPage"
            android:background="@drawable/share_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/resolver_text_color"
                android:gravity="center"
                android:id="@+id/confirmText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="146dp"
                android:text="@string/set_default_confirm"
                android:layout_alignParentTop="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/confirmZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:translationY="@dimen/confirm_zone_height">
                <View
                    android:background="#14000000"
                    android:layout_width="match_parent"
                    android:layout_height="0.67dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/resolver_text_color"
                        android:id="@+id/confirmCancel"
                        android:background="@drawable/resolver_confirm_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@android:string/cancel"
                        android:layout_weight="1"/>
                    <View
                        android:background="#14000000"
                        android:layout_width="0.67dp"
                        android:layout_height="match_parent"/>
                    <Button
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="#3965cc"
                        android:id="@+id/confirmOk"
                        android:background="@drawable/resolver_confirm_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@android:string/ok"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/floatView"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:transformPivotX="20dp"
            android:transformPivotY="20dp"/>
    </FrameLayout>
</LinearLayout>
