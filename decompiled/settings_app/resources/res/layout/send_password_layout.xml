<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:id="@+id/root_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/find_password_by_email_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/keyboard_observer_layout"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.settings.widget.SettingItemImage
                android:layout_gravity="center_horizontal"
                android:src="@drawable/password_sent_to_mailbox"
                android:scaleType="centerInside"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/email_address"
                android:title="@string/email_address"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.ListContentItemCustom style="@style/SettingSubItemSingleStyle">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:paddingLeft="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:textColorHint="#cacaca"
                        android:id="@+id/captcha_input"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/loginVerificationCode"
                        android:singleLine="true"
                        android:maxLength="10"
                        android:layout_weight="5"/>
                    <ImageView
                        android:id="@+id/catpcha"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.65"/>
                    <ImageView
                        android:id="@+id/refresh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/refresh"
                        android:layout_weight="1.4"/>
                </LinearLayout>
            </obric.widget.ListContentItemCustom>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.widget.SettingItemButton
                android:enabled="false"
                android:id="@+id/send_btn"
                android:text="@string/send_btn"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
