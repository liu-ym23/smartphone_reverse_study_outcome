<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemText
        android:id="@+id/icon_chooser_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Single">
        <com.android.settings.applications.ApplicationItemIconView
            android:id="@+id/official_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_settings_icon_margin_left"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <com.android.settings.applications.ApplicationItemIconView
            android:id="@+id/unofficial_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/official_icon_layout"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/author_info_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_settings_author_margin_left"
            android:layout_toLeftOf="@+id/arrow"
            android:layout_toRightOf="@+id/unofficial_icon_layout"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_text_colorlist"
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:layout_marginBottom="1dp"
                android:maxWidth="120dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/settings_item_sub_title_size"
                android:textColor="@color/icon_settings_summary_colorlist"
                android:gravity="center_vertical"
                android:layout_gravity="top"
                android:id="@+id/icon_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxWidth="120dp"
                android:singleLine="true"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:src="@drawable/secletor_setting_item_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </obric.widget.ListContentItemText>
    <include
        android:id="@+id/item_shadow_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_vertical_gap"
        android:layout_below="@+id/icon_chooser_layout"
        layout="@layout/item_bottom_shadow_layout"/>
</RelativeLayout>
