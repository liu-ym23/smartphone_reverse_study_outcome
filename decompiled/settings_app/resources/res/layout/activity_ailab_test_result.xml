<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ailab_test_result_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="219dp"
            android:src="@drawable/ai_lab_test_finish"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/oui_basic_text_3"
            android:layout_gravity="center"
            android:id="@+id/ailab_test_result_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ailab_settings_submit_finish"
            android:layout_marginHorizontal="32dp"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:layout_gravity="center"
            android:id="@+id/ailab_test_result_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ailab_settings_submit_wrong_tips"
            android:textFontWeight="400"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.obric.oui.button.OButton
            android:id="@+id/apply_again_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_marginBottom="12dp"
            android:text="@string/ailab_settings_submit_again"
            android:layout_marginHorizontal="@dimen/oui_p_container_large_2"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.button.OButton
            android:id="@+id/finish_btn"
            android:layout_width="match_parent"
            android:layout_marginBottom="32dp"
            android:text="@string/finish_button"
            android:layout_marginHorizontal="@dimen/oui_p_container_large_2"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:paddingTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/ailab_settings_screen_memory_submit"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
