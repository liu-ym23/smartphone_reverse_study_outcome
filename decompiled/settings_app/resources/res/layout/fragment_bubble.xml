<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_bubble"
                app:ocardlistitem_title="@string/notifications_bubble_setting_title"
                style="@style/OCardListItemSwitchSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_app_bubble"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_check_all"
                    app:ocardlistitem_title="@string/bubble_app_setting_all"
                    style="@style/OCardListItemCheckTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_check_selected"
                    app:ocardlistitem_title="@string/bubble_app_setting_selected"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_check_none"
                    app:ocardlistitem_title="@string/bubble_app_setting_none"
                    style="@style/OCardListItemCheckBottom"/>
            </LinearLayout>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                app:section_des_text="@string/notifications_bubble_setting_description"
                style="@style/OSectionSupportive.Text"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/bubbles_app_toggle_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
