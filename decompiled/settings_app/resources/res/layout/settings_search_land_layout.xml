<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.SearchBar
        android:id="@+id/id_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:focusableInit="true"
        app:hasCancelButton="true"
        app:hasRightIcon="false"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_item_top_bottom_margin"
        android:layout_below="@+id/id_search_bar"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        layout="@layout/searchview"/>
    <RelativeLayout
        android:id="@+id/history_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true">
        <obric.widget.BlankView
            android:textColor="#4c000000"
            android:gravity="center"
            android:id="@+id/notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_item_horizontal_padding"
            android:layout_marginTop="@dimen/search_empty_view_margin_top"
            android:layout_marginRight="@dimen/settings_item_horizontal_padding"
            android:layout_centerHorizontal="true"
            app:emptyDrawable="@drawable/search_empty_magnifier"
            app:primaryHint="@string/search_prompt"/>
        <com.obric.oui.bouncelayout.OListView
            android:id="@+id/search_history_view"
            android:background="@color/oui_bg_base_1"
            android:scrollbars="none"
            android:overScrollMode="always"
            style="@style/ListViewGeneralStyle"/>
    </RelativeLayout>
</RelativeLayout>
