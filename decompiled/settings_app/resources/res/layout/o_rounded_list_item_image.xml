<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIRelativeLayout
        android:background="@color/oui_fill_list_item_card"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_radius="16dp">
        <FrameLayout
            android:id="@+id/icon_container"
            android:duplicateParentState="true"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_content_img"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@color/transparent"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/trailing_switch"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true">
            <TextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Title_Title_M"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_content_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
        <ImageView
            android:textColor="@color/oui_text_2"
            android:id="@+id/trailing_image"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </com.obric.oui.layout.OUIRelativeLayout>
</merge>
