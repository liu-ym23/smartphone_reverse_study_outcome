<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/preview_container"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="186dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="120dp">
        <ImageView
            android:id="@+id/face_enroll_done_preview_img"
            android:background="@color/oui_green_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/check_confirm_rounded"
            android:scaleType="centerInside"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/face_done_lottie_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_loop="false"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/face_enrolling_lottie_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_fileName="face/lottie_face_enrollment_progress.json"
            app:lottie_repeatCount="-1"
            app:lottie_repeatMode="restart"/>
    </com.obric.oui.layout.OUIFrameLayout>
    <com.obric.oui.text.OTextView
        android:id="@+id/face_enroll_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="102dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_container"
        style="@style/Title_3_Medium"/>
    <com.obric.oui.text.OTextView
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/face_enroll_progress"
        style="@style/Body_1_Regular"/>
    <com.obric.oui.button.OButton
        android:id="@+id/enroll_finish"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_marginBottom="24dp"
        android:text="@string/finish_button"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.obric.oui.button.OButton
            android:id="@+id/goto_next"
            android:layout_width="match_parent"
            android:text="@string/finish_button"
            android:layout_marginHorizontal="24dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fake_status_bar"
        app:oFloatingTitleBar_centerTitle="@string/face_enroll_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
