<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/about_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="20dp">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/about_logo"
                    android:background="@drawable/o_ic_placeholder_image"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_text_3"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/os_name"
                    android:lineHeight="20dp"/>
                <TextView
                    android:textSize="12.5sp"
                    android:textColor="@color/oui_text_3"
                    android:gravity="center"
                    android:id="@+id/about_logo_os_vertion"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineHeight="16dp"/>
                <TextView
                    android:textSize="@dimen/about_logo_os_version_text_size"
                    android:textColor="@color/icon_settings_summary_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/about_logo_os_vertion_land"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_device_status"
                android:layout_marginBottom="4dp"
                app:oui_list_item_title="@string/about_item_title_device_status"
                style="@style/SettingSubItemSingleStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_device_name"
                android:layout_marginBottom="4dp"
                app:oui_list_item_title="@string/about_item_device_name"
                style="@style/SettingSubItemSingleStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_law_info"
                android:layout_marginBottom="4dp"
                app:oui_list_item_title="@string/about_item_title_law_info"
                style="@style/SettingSubItemSingleStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_warranty"
                android:layout_marginBottom="4dp"
                app:oui_list_item_title="@string/about_item_title_warranty"
                style="@style/SettingSubItemSingleStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_user_feedback"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">
                <com.android.settings.AboutStaticItem
                    android:id="@+id/device_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/model_number"/>
                <ViewStub
                    android:id="@+id/special_version_vs"
                    android:layout="@layout/about_static_item_vs_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <ViewStub
                    android:id="@+id/device_version_vs"
                    android:layout="@layout/about_static_item_vs_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/firmware_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/firmware_version"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/baseband_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/baseband_version"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/kernel_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/kernel_version"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/device_cpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/cpu_info"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/device_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/device_info_default"
                    app:title="@string/mem_info"/>
                <ViewStub
                    android:id="@+id/hw_version_vs"
                    android:layout="@layout/about_static_item_vs_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/mod_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/mod_version_default"
                    app:title="@string/mod_version"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/build_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:summary="@string/build_date_default"
                    app:title="@string/build_date"/>
                <include layout="@layout/item_sub_settings_padding_layout"/>
                <com.android.settings.widget.SettingsBottomExtraView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
