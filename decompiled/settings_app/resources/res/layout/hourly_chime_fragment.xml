<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/accessibility_hourly_chime"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemSwitch
                android:id="@+id/id_accessibility_hourly_chime_switch"
                android:title="@string/accessibility_hourly_chime"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_accessibility_hourly_chime_report_frequency"
                android:title="@string/accessibility_hourly_chime_frequency"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                android:text="@string/accessibility_hourly_chime_report_type"
                android:contentDescription="@string/accessibility_hourly_chime_report_type"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.ListContentItemCustom
                android:id="@+id/id_accessibility_hourly_chime_in_voice"
                style="@style/SettingSubItemTopStyle">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/accessibility_hourly_chime_in_voice">
                    <RadioButton
                        android:enabled="false"
                        android:id="@+id/id_accessibility_hourly_chime_in_voice_radio"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/setting_item_margin_left_normal"
                        android:button="@drawable/selector_check_icon_common"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/settings_item_title_size"
                        android:textColor="@color/setting_item_text_colorlist"
                        android:id="@android:id/title"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_hourly_chime_in_voice"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                </LinearLayout>
            </obric.widget.ListContentItemCustom>
            <obric.widget.ListContentItemCustom
                android:id="@+id/id_accessibility_hourly_chime_in_ring"
                style="@style/SettingSubItemMidStyle">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/accessibility_hourly_chime_in_ringtone">
                    <RadioButton
                        android:enabled="false"
                        android:id="@+id/id_accessibility_hourly_chime_in_ring_radio"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/setting_item_margin_left_normal"
                        android:button="@drawable/selector_check_icon_common"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/settings_item_title_size"
                        android:textColor="@color/setting_item_text_colorlist"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_hourly_chime_in_ringtone"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                    <ImageView
                        android:id="@+id/id_accessibility_hourly_chime_in_ring_setting"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/setting_item_margin_right_arrow_button"
                        android:src="@drawable/selector_arrow_button"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/accessibility_hourly_chime_report_ringtone_content_description"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                </LinearLayout>
            </obric.widget.ListContentItemCustom>
            <obric.widget.ListContentItemCustom
                android:id="@+id/id_accessibility_hourly_chime_in_vibration"
                style="@style/SettingSubItemBottomStyle">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/accessibility_hourly_chime_in_vibration">
                    <RadioButton
                        android:enabled="false"
                        android:id="@+id/id_accessibility_hourly_chime_in_vibration_radio"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/setting_item_margin_left_normal"
                        android:button="@drawable/selector_check_icon_common"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/settings_item_title_size"
                        android:textColor="@color/setting_item_text_colorlist"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accessibility_hourly_chime_in_vibration"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                </LinearLayout>
            </obric.widget.ListContentItemCustom>
            <TextView
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                android:text="@string/accessibility_hourly_chime_start_end"
                android:contentDescription="@string/accessibility_hourly_chime_start_end"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_accessibility_hourly_chime_start"
                android:title="@string/accessibility_hourly_chime_start"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_accessibility_hourly_chime_end"
                android:title="@string/accessibility_hourly_chime_end"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
