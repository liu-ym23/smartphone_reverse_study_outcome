<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/settings_list_item_icon_size"
        android:layout_height="@dimen/settings_list_item_icon_size"
        android:layout_marginLeft="@dimen/setting_item_margin_left_normal"
        android:layout_marginRight="8dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <CheckBox
        android:id="@+id/checkbox"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/setting_item_margin_right_normal"
        android:button="@drawable/selector_check_icon_bytedance"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/checkbox"
        android:layout_toRightOf="@+id/icon"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:id="@+id/description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="4"
            android:layout_below="@+id/name"
            android:layout_alignStart="@+id/name"/>
    </RelativeLayout>
</RelativeLayout>
