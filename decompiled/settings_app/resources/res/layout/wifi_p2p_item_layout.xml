<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/list_item_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_showIcon="true"
            app:ocardlistitem_showSubTitle="true"
            app:ocardlistitem_subTitle="@string/wifi_display_status_connected"
            app:ocardlistitem_title="@string/wifi_wapi_psk_type"/>
    </LinearLayout>
</RelativeLayout>
