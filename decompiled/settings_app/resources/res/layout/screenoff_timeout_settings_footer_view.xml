<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.sectiontitlebar.OSectionSupportiveText
        android:layout_marginHorizontal="@dimen/dimen_32"
        app:section_des_text="@string/security_auto_lock_time_tips"
        style="@style/OSectionTitleBar.S"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/stay_awake_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setting_item_gap"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/stay_awake_when_battery_plugged"/>
    <TextView
        android:id="@+id/id_wireless_charging_tips"
        android:visibility="gone"
        android:text="@string/wireless_charging_tips"
        style="@style/SettingItemTipsStyle"/>
</LinearLayout>
