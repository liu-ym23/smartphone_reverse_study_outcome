<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/transparent"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fake_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/titlebar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:layout_below="@+id/fake_status_bar">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/title_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/unlock_method_icon"
                android:contentDescription="@string/app_name"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/titlebar_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_centerInParent="true"
                style="@style/Title_4_Medium"/>
        </LinearLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/titlebar_right_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="12dp"
            android:text="@string/button_skip"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            style="@style/OButton.M1.Trans.Neutral"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_above="@+id/bottom_action_bar"
        android:layout_below="@+id/titlebar_container"/>
    <RelativeLayout
        android:id="@+id/bottom_action_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.obric.oui.button.OButton
            android:id="@+id/bottom_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/next_step"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="20dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.text.OTextView
            android:textSize="14dp"
            android:textColor="@color/later_settings_textview_color"
            android:id="@+id/later_setting"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="46dp"
            android:text="@string/text_later_settings"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/Button_1_Medium"/>
    </RelativeLayout>
</RelativeLayout>
