<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_nfc"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/nfc_setting_title"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nfc_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_id_wallet"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/nfc_wallet_subtitle"
                    app:ocardlistitem_title="@string/nfc_wallet_title"
                    style="@style/OCardListItemTextTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_id_nfc_reader"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/nfc_reader_main_switch_title_tip"
                    app:ocardlistitem_title="@string/nfc_reader_main_switch_title"
                    style="@style/OCardListItemSwitchBottom"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_id_android_beam"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_title="@string/android_beam_title"
                    style="@style/OCardListItemSwitchMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/default_payment_service"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_title="@string/default_payment_service"
                    style="@style/OCardListItemTextSingle"/>
            </LinearLayout>
            <obric.widget.ListContentItemText
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/setting_item_gap"
                style="@style/ListContentItemStyle.Bottom">
                <ImageView
                    android:background="@drawable/preview_nfc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </obric.widget.ListContentItemText>
            <TextView
                android:id="@+id/multi_block_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nfc_setting_tips"
                style="@style/GroupListTipsViewStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/nfc_repair_item"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/nfc_one_click_repair_sub_title"
                app:ocardlistitem_title="@string/nfc_one_click_repair"
                style="@style/OCardListItemTextSingle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_centerTitle="@string/nfc_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
