<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:id="@+id/scroll_content"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraint_root_view"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <FrameLayout
                        android:id="@+id/header_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="24dp"
                        app:layout_constraintDimensionRatio="1:0.598"
                        app:layout_constraintTop_toTopOf="parent"
                        app:oui_layout_borderColor="#0f3051f2"/>
                    <ImageView
                        android:id="@+id/logo_img"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ai_lab_settings_logo"
                        app:layout_constraintLeft_toLeftOf="@+id/header_bg"
                        app:layout_constraintRight_toRightOf="@+id/header_bg"
                        app:layout_constraintTop_toTopOf="@+id/header_bg"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/oui_text_1"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/ailab_settings_info"
                        android:textFontWeight="600"
                        app:layout_constraintLeft_toLeftOf="@+id/header_bg"
                        app:layout_constraintRight_toRightOf="@+id/header_bg"
                        app:layout_constraintTop_toBottomOf="@+id/logo_img"/>
                    <TextView
                        android:textColor="@color/oui_basic_text_1"
                        android:id="@+id/sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ailab_settings_sub_info"
                        app:layout_constraintLeft_toLeftOf="@+id/header_bg"
                        app:layout_constraintRight_toRightOf="@+id/header_bg"
                        app:layout_constraintTop_toBottomOf="@+id/title"
                        style="@style/Label_M"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ailab_settings_tips"
                        android:layout_marginHorizontal="16dp"
                        android:textFontWeight="400"
                        app:layout_constraintLeft_toLeftOf="@+id/header_bg"
                        app:layout_constraintRight_toRightOf="@+id/header_bg"
                        app:layout_constraintTop_toBottomOf="@+id/sub_title"
                        style="@style/TextViewStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/screen_memory_item"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/ailab_settings_screen_memory_desc"
                    app:ocardlistitem_title="@string/ailab_settings_screen_memory"
                    style="@style/OCardListItemSwitchTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/voice_memory_item"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/ailab_settings_voice_memory_desc"
                    app:ocardlistitem_title="@string/ailab_settings_voice_memory"
                    style="@style/OCardListItemSwitchBottom"/>
                <com.obric.oui.lisitem.OListItemGeneral
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="8dp"
                    app:oui_list_item_content_image="@drawable/ai_lab_doubao_lock_logo"
                    app:oui_list_item_show_background="false"
                    app:oui_list_item_subtitle="@string/ailab_settings_doubao_use_lock_desc"
                    app:oui_list_item_title="@string/ailab_settings_doubao_use_lock"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/ailab_settings_note_title"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:textFontWeight="480"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ailab_settings_note_1"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:textFontWeight="480"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ailab_settings_note_2"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:textFontWeight="480"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ailab_settings_note_3"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:textFontWeight="480"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ailab_settings_note_4"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:textFontWeight="480"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:gravity="center_horizontal"
                    android:id="@+id/ailab_systeminfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:paddingHorizontal="@dimen/oui_p_list_item_3"
                    android:paddingVertical="4dp"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </LinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
        <View
            android:id="@+id/ailab_bottom_line"
            android:background="@color/oui_line_2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
