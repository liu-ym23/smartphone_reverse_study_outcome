<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_anim_view_size">
    <ImageView
        android:id="@+id/outer_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/range_m"
        android:layout_centerInParent="true"
        android:scaleX="1.1"
        android:scaleY="1.1"/>
    <ImageView
        android:id="@+id/inner_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/range_halo_normal"
        android:layout_centerInParent="true"
        android:scaleX="0.5"
        android:scaleY="0.5"/>
    <ImageView
        android:id="@+id/radiation_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/range_halo_spark"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/touch_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/range_halo_pressed"
        android:layout_centerInParent="true"/>
</RelativeLayout>
