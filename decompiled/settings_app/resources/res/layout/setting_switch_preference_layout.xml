<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@android:id/icon"
        android:layout_width="@dimen/settings_list_item_icon_size"
        android:layout_height="@dimen/settings_list_item_icon_size"
        android:layout_marginLeft="@dimen/settings_list_item_gap"
        android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/notification_item_title_layout_margin_left"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_color"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:ellipsize="end"
            android:id="@android:id/text1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@android:id/title"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:ellipsize="end"
            android:id="@android:id/summary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_list_item_gap_right"
            android:singleLine="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <obric.widget.SwitchEx
        android:layout_gravity="center_vertical"
        android:id="@+id/item_switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/settings_item_right_widget_margin"/>
</LinearLayout>
