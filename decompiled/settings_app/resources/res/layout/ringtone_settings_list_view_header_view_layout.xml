<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/custom_header_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vibration_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:layout_marginHorizontal="@dimen/dimen_32"
            app:sectionTitle_titleText="@string/vibration_tips"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/vibration_card_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultTailIcon="tail_chevron"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/volume_ring_only_description"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ring_switch_container"
        android:paddingTop="@dimen/setting_item_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/same_to_sms1_card_list_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_switch"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/ringtone_same_to_sub1"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/ringtone_switch_card_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_switch"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/volume_ring_only_description"/>
    </LinearLayout>
</LinearLayout>
