<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/main_settings_first_app_icon_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_header"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_32"
                android:paddingEnd="@dimen/dimen_32">
                <ImageView
                    android:id="@+id/app_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="fitCenter"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    style="@style/Title_4_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Body_1_Regular"/>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_vpn_always_on"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/vpn_always_on_prompt"
                app:ocardlistitem_title="@string/vpn_always_on"
                style="@style/OCardListItemSwitchTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lockdown_vpn"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_title="@string/vpn_require_connection"
                style="@style/OCardListItemSwitchBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.button.OButton
                android:textColor="@color/oui_red_6"
                android:id="@+id/cancel_vpn"
                android:visibility="visible"
                android:clickable="true"
                android:layout_height="@dimen/oui_h_l3"
                android:layout_marginBottom="20dp"
                android:text="@string/vpn_cancel_button_text"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding"
                style="@style/OCardListItemCenterItem"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
