<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemCustom
        android:id="@+id/list_item"
        isPressable="false"
        style="@style/SettingSubItemSingleStyle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/top_div"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/setting_item_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="7dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/icon_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginRight="11dp"
            android:layout_below="@+id/top_div">
            <FrameLayout
                android:id="@+id/icon_1_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="0dp"
                android:layout_weight="1"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_1_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/redraw_icon_max_size"
                    android:maxHeight="@dimen/redraw_icon_max_size"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_1_selected"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_selected"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/icon_2_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_weight="1"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_2_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/redraw_icon_max_size"
                    android:maxHeight="@dimen/redraw_icon_max_size"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_2_selected"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_selected"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/icon_3_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_weight="1"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_3_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_bg"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/redraw_icon_max_size"
                    android:maxHeight="@dimen/redraw_icon_max_size"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon_3_selected"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/common_icon_frame_selected"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_div"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_below="@+id/icon_layout">
            <LinearLayout
                android:background="#ededed"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"/>
        </LinearLayout>
    </obric.widget.ListContentItemCustom>
    <LinearLayout
        android:id="@+id/primary_part_gap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_block_gap"/>
</LinearLayout>
