<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/accessibility_speech_reading"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemSwitch
                android:id="@+id/id_accessibility_speech_reading"
                android:title="@string/accessibility_speech_reading"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:text="@string/accessibility_speech_reading_enable_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:text="@string/accessibility_speech_reading_disable_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_trigger_talk_back"
                android:title="@string/accessibility_talk_back"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_trigger_voice_command"
                android:title="@string/voice_command"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:id="@+id/shadow_below_voice_command"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/id_trigger_global_ocr"
                android:title="@string/accessibility_global_ocr"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/global_ocr_tips_view"
                android:text="@string/accessibility_global_ocr_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_trigger_accessibility_report_punctually"
                android:title="@string/accessibility_report_punctually"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/tts_settings"
                android:layout_marginBottom="@dimen/item_block_gap"
                android:title="@string/tts_settings"
                style="@style/SettingSubItemSingleStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/id_accessibility_speaker_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemText
                    android:id="@+id/id_trigger_accessibility_speaker"
                    android:title="@string/accessibility_speaker"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/id_speaker_copyright"
                    android:text="@string/accessibility_speaker_copyright"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/id_screen_reader_services_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
