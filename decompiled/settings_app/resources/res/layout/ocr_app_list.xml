<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/ocr_all_app_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <obric.widget.SearchBar
        android:id="@+id/searchbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title"
        app:hasShadow="false"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/searchbar">
        <com.android.settings.widget.SlideListView
            android:id="@+id/listView"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            settings:slider_checkbox_id="@+id/item_checkbox"
            settings:slider_enabled="true"
            style="@style/ListViewFullWidthStyle"/>
        <obric.widget.letters.QuickBarEx
            android:layout_gravity="right"
            android:id="@+id/quickbar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:id="@+id/view_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/application_manager_empty_view_text"
            style="@style/SettingItemTextShadowStyle"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/searchbar"
            layout="@layout/searchview"/>
        <include
            android:id="@+id/search_bar_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/searchbar"
            layout="@layout/title_secondary_bar_shadow"/>
    </FrameLayout>
</RelativeLayout>
