<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg"
        android:background="@drawable/center_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.progress.ODownloadProgressView
        android:layout_gravity="center_vertical"
        android:id="@+id/loading_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_progress_view_size="medium"
        app:oui_progressing_action_color="@color/oui_basic_text_1"/>
    <ImageView
        android:id="@+id/main_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/loading_view"
        app:layout_constraintEnd_toEndOf="@+id/loading_view"
        app:layout_constraintStart_toStartOf="@+id/loading_view"
        app:layout_constraintTop_toTopOf="@+id/loading_view"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loading_view"
        style="@style/Title_Title_M"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/message"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_title"
        style="@style/Body_M"/>
    <com.obric.oui.button.OButton
        android:gravity="center"
        android:id="@+id/action_btn"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message"
        style="@style/OButton.L1.Standard.Neutral"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
