<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/group_title"
            style="@style/SettingItemTitleStyle"/>
        <RelativeLayout
            android:id="@+id/gesture_item_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touchpad_gesture_item_height"
            android:layout_marginStart="@dimen/setting_item_padding_start"
            android:layout_marginEnd="@dimen/setting_item_padding_start">
            <FrameLayout
                android:id="@+id/video_layout"
                android:background="@drawable/list_gesture_right_single"
                android:paddingTop="@dimen/gesture_video_padding_top"
                android:paddingBottom="@dimen/gesture_video_padding_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:paddingStart="@dimen/gesture_video_padding_left"
                android:paddingEnd="@dimen/gesture_video_padding_left">
                <VideoView
                    android:layout_gravity="center"
                    android:id="@+id/video"
                    android:layout_width="@dimen/touchpad_video_width"
                    android:layout_height="@dimen/touchpad_video_height"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/video_background"
                    android:background="@android:color/white"
                    android:layout_width="@dimen/touchpad_video_width"
                    android:layout_height="@dimen/touchpad_video_height"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:indeterminateDrawable="@drawable/sensor_calibration_progressbar_anim"/>
            </FrameLayout>
            <View
                android:id="@+id/divider"
                android:background="@color/divider_line"
                android:layout_width="0.67dp"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/video_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/gesture_items"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/divider"/>
        </RelativeLayout>
        <include layout="@layout/group_list_item_vertical_gap_layout"/>
    </LinearLayout>
</RelativeLayout>
