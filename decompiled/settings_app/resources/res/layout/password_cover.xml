<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/password_container"
    android:layout_width="@dimen/list_item_maximum_width"
    android:layout_height="wrap_content"
    android:layout_marginTop="55dp"
    android:layout_below="@+id/headerText"
    android:layout_centerInParent="true"
    android:layout_centerHorizontal="true">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_1"
        android:paddingLeft="1px"
        android:paddingRight="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_2"
        android:paddingLeft="@dimen/choose_lock_pwd_cover_dot_padding"
        android:paddingRight="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_3"
        android:paddingLeft="@dimen/choose_lock_pwd_cover_dot_padding"
        android:paddingRight="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_4"
        android:paddingLeft="@dimen/choose_lock_pwd_cover_dot_padding"
        android:paddingRight="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_5"
        android:paddingLeft="@dimen/choose_lock_pwd_cover_dot_padding"
        android:paddingRight="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/easy_password_no_6"
        android:paddingLeft="@dimen/choose_lock_pwd_cover_dot_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/easy_password_dot_empty"/>
</LinearLayout>
