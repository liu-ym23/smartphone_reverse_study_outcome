<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_width="match_parent"
                android:layout_height="112dp"/>
            <include
                android:id="@+id/app_snippet"
                layout="@layout/manage_applications_item"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/enabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_enabled"/>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:id="@+id/notification_tips"
                    android:layout_marginHorizontal="@dimen/dimen_32"
                    app:section_des_text="@string/notification_tips"
                    style="@style/OSectionTitleBar.S"/>
                <include layout="@layout/item_sub_settings_padding_layout"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:id="@+id/notification_more_text"
                    android:layout_marginHorizontal="@dimen/dimen_32"
                    app:sectionTitle_titleText="@string/notification_more_title"
                    style="@style/OSectionTitleBar.S"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_silent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/subtitle_notification_silent"
                    app:ocardlistitem_title="@string/title_notification_silent"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_ringtone_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_ringtone_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/switch_heads_up"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_heads_up"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_ringtone_vibrate"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_ringtone_vibrate"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/switch_lighten_screen"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_lighten_enabled"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/pop_up_dialog_notification"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/pop_up_dialog_notification_text"/>
                <include
                    android:id="@+id/notification_detail_gap_view"
                    android:visibility="gone"
                    layout="@layout/item_bottom_shadow_layout"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_detail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_detail"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/allow_smart_notification"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_allow_smart_notification"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/channel_settings"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.sectiontitlebar.OSectionTitleBar
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="@dimen/dimen_32"
                        app:sectionTitle_titleText="@string/notification_channel_title"
                        style="@style/OSectionTitleBar.S"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/listView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:headerDividersEnabled="false"
                        android:footerDividersEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:fitsSystemWindows="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
