<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/dimen_32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/multi_wifi_acceleration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/multi_wifi_acceleration"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/main_wifi_title"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_marginStart="32dp"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/multi_wifi_acceleration"
                app:sectionTitle_titleText="@string/main_wifi"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/main_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/main_wifi_title"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="true"
                app:ocardlistitem_showSubTitle="true"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/sub_wifi_title"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_marginStart="32dp"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/main_wifi"
                app:sectionTitle_titleText="@string/sub_wifi"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_accent_6_bg"
                android:gravity="center"
                android:id="@+id/refresh_btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/sub_wifi_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sub_wifi_title"
                style="@style/Subtitle_2_Medium"/>
            <com.obric.oui.progress.ODownloadProgressView
                android:layout_gravity="center_vertical"
                android:id="@+id/refresh_loading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/sub_wifi_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sub_wifi_title"
                app:oui_progress_view_size="small"
                app:oui_progressing_action_color="@color/oui_basic_text_1"/>
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/wifi_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sub_wifi_title"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/multi_wifi_group"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="main_wifi_title,main_wifi,sub_wifi_title,refresh_btn,wifi_list,refresh_loading"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/sub_wifi_group"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="sub_wifi_title,refresh_btn,wifi_list,refresh_loading"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="multi_wifi_acceleration,main_wifi_title,main_wifi,sub_wifi_title,refresh_btn,wifi_list,refresh_loading"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/bottom_tips"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrier"
                app:section_des_text="@string/multi_wifi_acceleration_bottom_tips"
                style="@style/OSectionTitleBar.S"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/multi_wifi_acceleration"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
