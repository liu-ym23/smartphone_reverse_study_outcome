<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_16"
    android:layout_marginBottom="@dimen/dimen_8"
    android:layout_marginHorizontal="@dimen/dimen_16">
    <com.obric.oui.button.OIconButton
        android:id="@+id/btn_negative"
        android:layout_width="@dimen/dimen_40"
        android:layout_height="@dimen/dimen_40"
        android:src="@drawable/time_picker_header_view_cancel_btn"
        android:layout_alignParentLeft="true"/>
    <com.obric.oui.text.OTextView
        android:textSize="16sp"
        android:textColor="#d9000000"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/obric_doze_display_policy_scheduled_start"
        android:layout_centerInParent="true"
        android:paddingHorizontal="@dimen/dimen_8"
        android:paddingVertical="@dimen/dimen_9"
        android:textFontWeight="500"/>
    <com.obric.oui.button.OIconButton
        android:id="@+id/btn_positive"
        android:layout_width="@dimen/dimen_40"
        android:layout_height="@dimen/dimen_40"
        android:src="@drawable/time_picker_header_view_confirm_btn"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
