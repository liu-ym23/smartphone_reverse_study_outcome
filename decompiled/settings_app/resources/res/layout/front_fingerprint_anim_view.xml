<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/progress_layer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <com.android.settings.widget.FingerprintEnrollProgressLottieView
            android:id="@+id/udfps_progress_lottie"
            android:visibility="visible"
            android:layout_width="200dp"
            android:layout_height="280dp"
            android:layout_marginTop="70dp"
            android:importantForAccessibility="no"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/init_layer"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.android.settings.widget.FingerprintEnrollIntroductionImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/init_base_bg"
            android:layout_width="360dp"
            android:layout_height="420dp"
            android:scaleType="fitCenter"/>
    </FrameLayout>
</RelativeLayout>
