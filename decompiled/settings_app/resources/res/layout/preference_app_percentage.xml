<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:paddingLeft="@dimen/powerusage_listitem_padding_left_right"
    android:paddingRight="@dimen/powerusage_listitem_padding_left_right"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.ListContentItemText
        android:id="@+id/list_content_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/empty_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="14dp"/>
</LinearLayout>
