<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_centerTitle="@string/fingerprint_enroll"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
        <obric.widget.ShadowFrameLayout
            android:id="@+id/next_step_btn_group"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            app:bottom_type="true">
            <com.obric.oui.button.OButton
                android:layout_gravity="center"
                android:id="@+id/next_step_btn"
                android:layout_width="@dimen/next_step_button_width"
                android:layout_height="@dimen/next_step_button_height"
                android:text="@string/button_next_step"
                style="@style/LongButton.Shrink.Highlight"/>
        </obric.widget.ShadowFrameLayout>
        <com.obric.oui.bouncelayout.OScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/bottom_line_bottom_margin"
            android:layout_below="@+id/view_title"
            android:overScrollMode="always">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/wizard_fp"
                    style="@style/IntroImageStyle"/>
                <TextView
                    android:id="@+id/fingerprint_setup_tips"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/fingerprint_enroll_wizard_tips"
                    style="@style/SettingItemTipsStyle"/>
                <TextView
                    android:id="@+id/fingerprint_film_tips"
                    android:visibility="gone"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/fingerprint_tip_phone_film"
                    style="@style/SettingItemTipsStyle"/>
                <TextView
                    android:id="@+id/fingerprint_law_tips"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/fingerprint_tip_phone_law"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
        <include layout="@layout/title_bar_shadow"/>
    </RelativeLayout>
</FrameLayout>
