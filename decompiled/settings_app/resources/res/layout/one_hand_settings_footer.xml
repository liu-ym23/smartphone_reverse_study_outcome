<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.android.settings.widget.VerticalOptionsCheckView
        android:id="@+id/id_navigation_layout_one_hand_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.android.settings.widget.VerticalOptionsCheckView
        android:id="@+id/id_launcher_docker_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/id_thumb_pull_screen_down_title"
        android:visibility="gone"
        android:text="@string/thumb_pull_screen_down_title"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.SettingItemSwitch
        android:id="@+id/thumb_push_down_switch"
        android:visibility="gone"
        android:title="@string/thumb_pull_screen_down_title"
        style="@style/SettingSubItemTopStyle"/>
    <FrameLayout
        android:id="@+id/id_thumb_dropdown"
        android:background="@drawable/thumb_dropdown"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/id_thumb_trigger_switch_tips"
        android:visibility="gone"
        android:text="@string/thumb_trigger_switch_tips"
        style="@style/SettingItemTipsStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/thumb_trigger_area_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <obric.widget.SettingItemSwitch
            android:id="@+id/item_id_pulldown_wallpaper_enable"
            android:layout_marginBottom="@dimen/item_block_gap"
            android:title="@string/thumb_pulldown_wallpaper_title"
            style="@style/SettingSubItemSwitchSingleStyle"/>
        <obric.widget.SettingItemText
            android:id="@+id/thumb_trigger_area_options"
            android:title="@string/one_hand_thumb_trigger_area"
            style="@style/SettingSubItemSingleStyle"/>
        <TextView
            android:text="@string/thumb_trigger_area_tips"
            style="@style/SettingItemTipsStyle"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/one_hand_settings_item_layout"/>
</LinearLayout>
