<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_oaid"
                app:ocardlistitem_title="@string/oaid_title"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_push_receive"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/push_business_receive"
                style="@style/OCardListItemSwitchSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/shows_push_receive"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/push_business_receive_lawf"
                style="@style/OSectionTitleBar.S"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/ad_service_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
