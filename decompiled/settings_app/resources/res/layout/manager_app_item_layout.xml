<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/item_icon"
            android:duplicateParentState="true"
            android:layout_width="@dimen/settings_list_item_icon_size"
            android:layout_height="@dimen/settings_list_item_icon_size"
            android:layout_marginLeft="@dimen/manager_app_list_item_margin_left"
            android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/item_check"
            android:visibility="invisible"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_list_item_gap"
            android:src="@drawable/icon_check_confirm_rounded"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:id="@+id/item_subtitle"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="#33000000"
            android:shadowDy="-1"
            android:shadowRadius="0"
            android:layout_toLeftOf="@+id/item_check"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_toLeftOf="@+id/item_subtitle"
            android:layout_toRightOf="@+id/item_icon"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_text_colorlist"
                android:id="@+id/item_title"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/settings_item_sub_title_size"
                android:textColor="@color/setting_item_summary_text_colorlist"
                android:id="@+id/item_summary"
                android:visibility="gone"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/item_title"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
