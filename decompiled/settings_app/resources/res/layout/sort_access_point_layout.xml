<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/all_view_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/item_remove_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_item_title_right_margin"
            android:src="@drawable/ic_remove"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/delete"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:background="@drawable/preference_settings_item_edit_seletor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_item_right_widget_margin"
            android:layout_weight="0"
            android:layout_alignParentRight="true"/>
        <View
            android:id="@+id/title_blank_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/item_remove_view"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_toLeftOf="@+id/item_switch"
            android:layout_toRightOf="@+id/title_blank_view"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_summary_text_colorlist"
                android:id="@+id/currently_connected_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/settings_item_right_widget_margin"
                android:text="@string/currently_connected_network_text"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/title_layout_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/currently_connected_text">
                <TextView
                    android:textSize="@dimen/settings_item_title_size"
                    android:textColor="#cc000000"
                    android:id="@+id/title"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="280dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/settings_item_sub_title_size"
                    android:textColor="#62000000"
                    android:id="@+id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
