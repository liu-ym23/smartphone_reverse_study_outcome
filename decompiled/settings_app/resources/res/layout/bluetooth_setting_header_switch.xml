<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/item_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_switch"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_title="@string/bluetooth_settings_title"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/btn_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/setting_item_gap"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/about_item_device_name"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/btn_show_received_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/setting_item_gap"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/bluetooth_show_received_files"/>
    </LinearLayout>
</RelativeLayout>
