<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.SettingItemTextVertical
                android:id="@+id/item_id_system_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wallpaper_settings_item_height"
                setting:arrow="@drawable/secletor_setting_item_arrow"
                setting:icon="@drawable/preview_classic"
                setting:iconFrame="@drawable/thumbnail_bg"
                setting:singleLine="false"
                setting:title="@string/system_wallpaper_title"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.SettingItemTextVertical
                android:id="@+id/item_id_online_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wallpaper_settings_item_height"
                setting:arrow="@drawable/secletor_setting_item_arrow"
                setting:icon="@drawable/preview_network"
                setting:iconFrame="@drawable/thumbnail_bg"
                setting:singleLine="false"
                setting:title="@string/community_lockscreen_title"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.SettingItemTextVertical
                android:id="@+id/item_id_history_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wallpaper_settings_item_height"
                setting:arrow="@drawable/secletor_setting_item_arrow"
                setting:icon="@drawable/preview_customize"
                setting:iconFrame="@drawable/thumbnail_bg"
                setting:singleLine="false"
                setting:title="@string/customize_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_four_fingers_change_lockscreen"
                setting:smtTitle="@string/four_fingers_change_lockscreen"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/item_four_fingers_change_lockscreen_tips"
                android:text="@string/tips_for_four_fingers_change_lockscreen"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/original_launcher_wallpaper_blur"
                setting:smtTitle="@string/original_launcher_blur_switch_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:id="@+id/original_launcher_wallpaper_blur_shadow"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_auto_switch_lock_screen_wallpaper"
                setting:smtTitle="@string/auto_switch_lockscreen_wallpaper"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/item_id_auto_switch_lock_screen_wallpaper_tips"
                android:text="@string/auto_switch_lockscreen_wallpaper_tips"
                style="@style/SettingItemTipsStyle"/>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/item_id_auto_switch_wallpaper_frequency_container"
                    android:paddingBottom="13dp"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginRight="13dp">
                    <TextView
                        android:layout_marginLeft="17dp"
                        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                        android:text="@string/auto_switch_lockscreen_wallpaper_frequency_title"
                        android:contentDescription="@string/accessibility_hourly_chime_report_type"
                        style="@style/SettingItemTitleStyle"/>
                </LinearLayout>
            </FrameLayout>
            <include
                android:id="@+id/tiktok_on_keyguard"
                layout="@layout/tiktok_on_keyguard"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
