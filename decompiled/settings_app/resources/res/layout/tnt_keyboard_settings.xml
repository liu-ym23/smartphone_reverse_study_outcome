<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/keyboard_label"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/keyboard_preference"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/keyboard_preference_windows"
                android:text="@string/keyboard_preference_windows"
                settings:showArrow="true"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/keyboard_preference_mac"
                android:text="@string/keyboard_preference_mac"
                settings:showArrow="true"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/f_functional_keys"
                android:title="@string/f_functional_keys"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:id="@+id/f_functional_keys_gap_layout"
                layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/keyboard_repeat_interval"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.TickMarkView
                android:id="@+id/keyboard_repeat_interval"
                style="@style/TickMarkViewStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/keyboard_repeat_delay"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.TickMarkView
                android:id="@+id/keyboard_repeat_delay"
                style="@style/TickMarkViewStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/soft_keyboard_settings"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/virtual_keyboard_popup_switch"
                android:title="@string/popup_virtual_keyboard"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_keyboard_dialog_default_location_setting"
                android:title="@string/keyboarddialog_default_location"
                style="@style/SettingSubItemBottomStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/keyboard_style"
                android:visibility="gone"
                android:title="@string/keyboard_default_style"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/traditional_chinese_input"
                android:visibility="gone"
                android:title="@string/traditional_chinese_input"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/recognize_language"
                android:visibility="gone"
                android:title="@string/recognize_language"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/keyboard_inputmethod_title"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/id_security_keyboard"
                android:title="@string/security_keyboard"
                style="@style/SettingItemSingleStyle"/>
            <include
                android:id="@+id/id_security_keyboard_gap"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_keyboard_inputmethod_bytedance"
                android:title="@string/keyboard_inputmethod_bytedance"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:visibility="gone"
                android:text="@string/custom_keyboard_settings"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/item_check_close_screen"
                android:visibility="gone"
                android:text="@string/lock_screen_title"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/item_check_start_app"
                android:visibility="gone"
                android:text="@string/keyboard_custom_key_start_app"
                settings:showArrow="true"
                style="@style/SettingSubItemMidStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/item_check_none"
                android:visibility="gone"
                android:text="@string/undefined"
                style="@style/SettingSubItemBottomStyle"/>
            <include
                android:visibility="gone"
                layout="@layout/group_list_item_vertical_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
