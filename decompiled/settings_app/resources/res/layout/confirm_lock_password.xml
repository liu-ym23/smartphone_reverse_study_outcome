<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lockscreen_mode_item_password_title"
        style="@style/Title_4_Bold"/>
    <TextView
        android:textSize="@dimen/choose_lock_pwd_header_text_text_size"
        android:gravity="center"
        android:id="@+id/headerText"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        style="@style/Subtitle_1_Regular"/>
    <obric.view.SecurityEditorText
        android:textSize="14sp"
        android:textColor="@color/oui_text_1"
        android:textColorHint="@color/oui_text_4"
        android:gravity="center"
        android:id="@+id/passwordEntry"
        android:background="@drawable/confirm_lock_password_entry_background"
        android:layout_width="@dimen/password_edittext_width"
        android:layout_height="40dp"
        android:layout_marginTop="55dp"
        android:password="true"
        android:singleLine="true"
        android:layout_below="@+id/headerText"
        android:layout_centerHorizontal="true"
        android:inputType="textPassword"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/o_form_default_cursor"
        android:lineHeight="14dp"/>
    <include layout="@layout/password_cover"/>
    <FrameLayout
        android:id="@+id/pin_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/xts_enterprise_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:src="@drawable/ic_enterprise"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fake_status_bar"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
