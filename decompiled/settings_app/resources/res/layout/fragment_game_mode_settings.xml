<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/game_mode"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_switch_game_mode"
                android:title="@string/game_mode"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/game_mode_tips"
                android:text="@string/game_mode_tips"
                style="@style/SettingItemTipsStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_sub_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemText
                    android:id="@+id/side_bar_menu"
                    android:title="@string/side_bar_menu"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/side_bar_menu_tips"
                    android:text="@string/side_bar_menu_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemText
                    android:id="@+id/game_network_acceleration"
                    android:title="@string/game_network_acceleration"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/game_network_acceleration_tips"
                    android:text="@string/game_network_acceleration_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/network_protection"
                    android:visibility="gone"
                    android:title="@string/network_protection"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/network_protection_tips"
                    android:visibility="gone"
                    android:text="@string/network_protection_tips"
                    style="@style/SettingItemTipsStyle"/>
                <TextView
                    android:id="@+id/performance"
                    android:visibility="gone"
                    android:text="@string/performance"
                    style="@style/SettingItemTitleStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/high_performance_mode"
                    android:visibility="gone"
                    android:title="@string/high_performance_mode"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/high_performance_mode_tips"
                    android:visibility="gone"
                    android:text="@string/high_performance_mode_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/message_barrage_notification"
                    android:title="@string/message_barrage_notification"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/message_barrage_notification_tips"
                    android:text="@string/message_barrage_notification_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/shielded_status_bar_notification"
                    android:title="@string/shielded_status_bar_notification"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/shielded_status_bar_notification_tips"
                    android:text="@string/shielded_status_bar_notification_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemText
                    android:id="@+id/reject_calls_menu"
                    android:title="@string/reject_calls"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/reject_calls_tips"
                    android:text="@string/reject_calls_tips"
                    style="@style/SettingItemTipsStyle"/>
                <TextView
                    android:id="@+id/improvement_options_title"
                    android:text="@string/improvement_options"
                    style="@style/SettingItemTitleStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_switch_game_mode_accelerate"
                    android:title="@string/game_mode_accelerate"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/game_mode_accelerate_tips"
                    android:text="@string/game_mode_accelerate_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_switch_game_mode_no_disturb"
                    android:visibility="gone"
                    android:title="@string/game_mode_no_disturb"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/item_switch_game_mode_no_disturb_tips"
                    android:visibility="gone"
                    android:text="@string/game_mode_no_disturb_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_switch_game_mode_lock_auto_brightness"
                    android:title="@string/game_mode_lock_auto_brightness"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/game_mode_lock_auto_brightness_tips"
                    android:text="@string/game_mode_lock_auto_brightness_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_switch_game_mode_nav_bar_btn_forbidden"
                    android:title="@string/game_mode_nav_bar_btn_forbidden"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/game_mode_nav_bar_btn_forbidden_tips"
                    android:text="@string/game_mode_nav_bar_btn_forbidden_tips"
                    style="@style/SettingItemTipsStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_switch_game_mode_shortcut_key_forbidden"
                    android:title="@string/game_mode_shortcut_key_forbidden"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/item_switch_game_mode_shortcut_key_forbidden_tip"
                    android:text="@string/game_mode_shortcut_key_forbidden_tips"
                    style="@style/SettingItemTipsStyle"/>
                <com.android.settings.widget.SettingsBottomExtraView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
