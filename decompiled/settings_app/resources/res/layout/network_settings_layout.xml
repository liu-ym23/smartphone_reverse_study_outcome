<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/personal_app"
                app:ocardlistitem_title="@string/mobile_network_ap"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_cbs"
                android:visibility="gone"
                app:ocardlistitem_title="@string/cellbroadcast"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_vpn"
                app:ocardlistitem_title="@string/advanced_item_vpn"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/nfc_setting"
                app:ocardlistitem_title="@string/nfc_setting_title"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_usb_tether_config"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_title="@string/select_usb_config_title"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_usb_tether_switch"
                app:ocardlistitem_subTitle="@string/usb_tethering_unavailable_subtext"
                app:ocardlistitem_title="@string/tether_settings_title_usb"
                style="@style/OCardListItemSwitchBottom"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_nubia_share"
                android:layout_marginTop="16dp"
                app:ocardlistitem_title="@string/nubia_share"
                style="@style/OCardListItemTextSingle"/>
            <TextView
                android:id="@+id/item_fast_transfer_tips"
                android:visibility="gone"
                android:text="@string/fast_transfer_subtext"
                style="@style/SettingItemTipsStyle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/charge_button"
                android:visibility="gone"
                app:ocardlistitem_title="@string/phone_charge"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/voip_setting_entry"
                android:visibility="gone"
                app:ocardlistitem_title="@string/free_call"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/voip_setting_entry_bottom"
                android:visibility="gone"
                layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_otg_switch"
                app:ocardlistitem_subTitle="@string/otg_text_subtext"
                app:ocardlistitem_title="@string/otg_text"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/print"
                android:visibility="visible"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/add_manage_print_device"
                app:ocardlistitem_title="@string/system_print"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/more_network_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
