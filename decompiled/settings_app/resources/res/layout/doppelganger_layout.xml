<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_o_section_title_bar_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/doppelganger_desc"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/doppelganger_description"
                style="@style/OSectionTitleBar.S"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/open_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_titleText="@string/settings_state_on"
                    style="@style/OSectionTitleBar.S"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/open_list_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/close_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_titleText="@string/dopperlganger_status_off"
                    style="@style/OSectionTitleBar.S"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/close_list_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
        <com.obric.oui.text.OTextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_safetylegal_activity_loading"
            android:singleLine="true"/>
    </LinearLayout>
    <com.obric.oui.status.OPageStatus
        android:gravity="center"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:opagestatus_title="@string/has_not_app_supported_doppelganger"
        app:opagestatus_type="status_content"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/doppelganger_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
