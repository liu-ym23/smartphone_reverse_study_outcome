<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <TextView
        android:textSize="@dimen/choose_lock_pwd_header_text_text_size"
        android:textColor="@color/lock_screen_header_normal_text_color"
        android:gravity="center"
        android:id="@+id/headerText"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/choose_lock_pwd_fake_header_text_margin_top"
        android:layout_centerHorizontal="true"/>
    <obric.view.SecurityEditorText
        android:textSize="@dimen/choose_lock_pwd_pin_entry_text_size"
        android:textColor="@color/oui_text_1"
        android:textColorHint="@color/oui_text_4"
        android:gravity="center"
        android:id="@+id/passwordEntry"
        android:background="@drawable/password_input_text_bg"
        android:saveEnabled="false"
        android:layout_width="@dimen/password_edittext_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pwd_entry_padding_top"
        android:password="true"
        android:singleLine="true"
        android:layout_below="@+id/headerText"
        android:layout_centerHorizontal="true"
        android:inputType="textPassword"
        android:textCursorDrawable="@drawable/o_form_default_cursor"/>
    <include
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="43dp"
        android:layout_alignTop="@+id/passwordEntry"
        android:layout_centerHorizontal="true"
        layout="@layout/password_cover"/>
    <FrameLayout
        android:id="@+id/pin_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
