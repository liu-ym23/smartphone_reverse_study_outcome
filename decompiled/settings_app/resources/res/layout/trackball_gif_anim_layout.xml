<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/trackball_anim_area_width"
    android:layout_height="@dimen/trackball_anim_area_height"
    android:layout_marginTop="@dimen/trackball_anim_area_top_margin"
    android:layout_marginBottom="@dimen/trackball_anim_area_bottom_margin"
    android:layout_centerInParent="true">
    <ImageView
        android:id="@+id/trackball_page_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball_page_home"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/trackball_msg_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball_page_msg_list"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/trackball_msg_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball_page_msg_edit"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/trackball"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball"/>
    <ImageView
        android:id="@+id/trackball_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball_light"/>
    <ImageView
        android:id="@+id/trackball_hand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/trackball_hand"
        android:layout_centerInParent="true"/>
</RelativeLayout>
