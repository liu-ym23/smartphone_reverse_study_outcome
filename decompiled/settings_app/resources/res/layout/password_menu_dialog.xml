<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.dialog.base.DialogRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/root_view"
    android:background="@color/oui_bg_base_2_1_low_elevation"
    android:layout_width="@dimen/oui_w_sheet"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:oui_cornerRadiusLeftBottom="@dimen/oui_r_l1"
    app:oui_cornerRadiusLeftTop="@dimen/oui_r_l1"
    app:oui_cornerRadiusRightBottom="@dimen/oui_r_l1"
    app:oui_cornerRadiusRightTop="@dimen/oui_r_l1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/menu_dialog_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/contentPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.bouncelayout.OListView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/content_list"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="18dp"
                android:overScrollMode="never"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="24dp"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/btn_ok"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</com.obric.oui.dialog.base.DialogRootView>
