<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemText
        android:id="@+id/system_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/system_app"
        style="@style/ListContentItemStyle.Bottom"/>
    <View
        android:id="@+id/empty_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="14dp"/>
</LinearLayout>
