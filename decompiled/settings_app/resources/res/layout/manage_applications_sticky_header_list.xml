<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/whole_view"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/search_or_option_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title_container"
        android:layout_centerHorizontal="true">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/oc_searchbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            bytedanceos:oFloatingTitleBar_maskBlurRadius="8"
            bytedanceos:oFloatingTitleBar_statusBarImmersion="true"
            bytedanceos:oui_useBackIcon="false"/>
        <RelativeLayout
            android:id="@+id/option_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="28dp">
                <com.obric.oui.checkbox.OCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/checkbox_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/select_all"
                    android:layout_marginHorizontal="7dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_text_2"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/option_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="2dp"
                    android:text="@string/select_all"
                    android:lineHeight="20dp"/>
            </LinearLayout>
        </RelativeLayout>
        <com.obric.oui.button.OButton
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:visibility="gone"
            android:text="@string/btn_cancel"
            android:layout_marginEnd="20dp"
            style="@style/OButton.M1.Standard.Neutral"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/page_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:id="@+id/main_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.settings.widget.SlideListView
                android:scrollbarStyle="outsideInset"
                android:id="@+id/listView"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@android:color/transparent"
                android:dividerHeight="0dp"
                android:headerDividersEnabled="false"
                android:footerDividersEnabled="false"
                bytedanceos:slider_checkbox_id="@+id/item_checkbox"
                bytedanceos:slider_enabled="true"/>
            <com.obric.oui.indexscrollbar.OIndexScrollbar
                android:id="@+id/index_scrollbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/oui_basic_text_3"
                android:gravity="center"
                android:id="@+id/view_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/application_manager_empty_view_text"/>
        </FrameLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/search_or_option_bar"
            layout="@layout/searchview2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/view_title_container"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_alignParentTop="true"
            bytedanceos:oFloatingTitleBar_centerTitle="@string/advanced_item_application"
            bytedanceos:oFloatingTitleBar_maskBlurRadius="8"
            bytedanceos:oFloatingTitleBar_statusBarImmersion="true"
            style="@style/TitleStyle"/>
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="right"
                android:orientation="horizontal"
                android:id="@+id/search_bar_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp">
                <com.obric.oui.searchbar.v2.OSearchBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_field_bar"
                    android:visibility="invisible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_marginRight="8dp"
                    android:hint="@string/search"
                    android:layout_weight="1"
                    style="@style/OStyleV2.OSearchBar.Float.S"/>
                <com.obric.oui.button.OButtonGroup
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_cancel_button"
                    android:visibility="invisible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    style="@style/OStyleV2.OButtonGroup.S"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/profile_tabs_container"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title_container">
        <com.obric.oui.segmentedtab.OTabSegmentedLayout
            android:id="@+id/profile_tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_m2"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="12dp"
            bytedanceos:bar_color="@color/oui_fill_sunken_variable"
            bytedanceos:bar_stroke_color="@color/Transparent"
            bytedanceos:indicator_anim_enable="true"
            bytedanceos:indicator_color="@color/oui_bg_base_3_high_elevation"
            bytedanceos:indicator_corner_radius="@dimen/oui_r_m1"
            bytedanceos:indicator_height="@dimen/oui_h_m1"
            bytedanceos:indicator_spacing="4dp"
            bytedanceos:tab_textBold="SELECT"
            bytedanceos:tab_textSelectColor="@color/oui_text_1"
            bytedanceos:tab_textSize="14dp"
            bytedanceos:tab_textUnselectColor="@color/oui_text_3"/>
    </LinearLayout>
</RelativeLayout>
