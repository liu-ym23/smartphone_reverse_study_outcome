<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/gesture_support_layout"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setting_item_gap">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            app:sectionTitle_titleText="@string/back_to_launcher_and_multi_task"
            style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_list_item"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="4dp"
            style="@style/SettingItemSingleStyle">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:src="@drawable/bg_navigation_home"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setting_item_gap">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            app:sectionTitle_titleText="@string/back_to_last_page"
            style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_list_item"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="4dp"
            style="@style/SettingItemSingleStyle">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:src="@drawable/bg_navigation_back"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
