<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/preview_image"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_item_preview_image_margin_top"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/preview_title_text_colorlist"
        android:gravity="center_horizontal"
        android:id="@+id/preview_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:singleLine="true"
        android:layout_below="@+id/preview_image"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/checked_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/preview_picture_check_selector"
        android:layout_alignRight="@+id/preview_image"
        android:layout_alignParentTop="true"/>
</RelativeLayout>
