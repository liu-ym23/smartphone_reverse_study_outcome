<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/face_recognition_enroll_dialog_tips"
            style="@style/Body_1_Regular"/>
        <include layout="@layout/item_bottom_shadow_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. "
                style="@style/Body_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/note_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/face_recognition_enroll_dialog_msg_1"
                android:layout_weight="1"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
        <include layout="@layout/item_bottom_shadow_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. "
                style="@style/Body_1_Regular"/>
            <TextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/note_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/face_recognition_enroll_dialog_msg_2"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
        <include layout="@layout/item_bottom_shadow_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. "
                style="@style/Body_1_Regular"/>
            <TextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/face_recognition_enroll_dialog_msg_3"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
        <include layout="@layout/item_bottom_shadow_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. "
                style="@style/Body_1_Regular"/>
            <TextView
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/face_recognition_enroll_dialog_msg_4"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
    </LinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
