<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_fill_list_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:oui_radius="@dimen/oui_r_l3_rect">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/scroll_del_btn"
        android:layout_width="44dp"
        android:layout_height="32dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/scroll_del_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/uninstall_text"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/scroll_handle_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/app_layout"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="-2dp">
            <com.obric.oui.checkbox.OCheckBoxSecurity
                android:layout_gravity="center_vertical"
                android:id="@+id/item_checkbox"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="19dp"
                android:layout_marginRight="7dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/select_all"/>
            <FrameLayout
                android:id="@+id/icon_container"
                android:duplicateParentState="true"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_toRightOf="@+id/item_checkbox"
                android:layout_centerVertical="true">
                <com.obric.oui.button.OIconButton
                    android:layout_gravity="center"
                    android:id="@+id/item_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@color/AssistColor0"
                    android:adjustViewBounds="true"
                    app:oui_layout_borderColor="@color/oui_line_2"
                    app:oui_layout_borderWidth="0dp"
                    app:oui_radius="0dp"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/iv_doppleganger_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="11dp"
                    android:src="@color/transparent"
                    android:layout_marginEnd="11dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/item_check"
                android:visibility="invisible"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/settings_list_item_gap"
                android:src="@drawable/icon_check_confirm_rounded"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/item_subtitle"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/Label_M_Thin"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_toLeftOf="@+id/item_subtitle"
                android:layout_toRightOf="@+id/icon_container"
                android:layout_centerVertical="true">
                <TextView
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/item_title"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/Title_Title_M"/>
                <TextView
                    android:textSize="@dimen/settings_item_sub_title_size"
                    android:textColor="@color/application_setting_item_summary_text_colorlist"
                    android:id="@+id/item_summary"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_below="@+id/item_title"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</merge>
