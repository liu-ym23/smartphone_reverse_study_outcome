<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/revone_bigbang_anim_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="316dp"
        android:minHeight="248.7dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_magnifier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="57dp"
            android:src="@drawable/revone_bigbang_anim_magnifier"
            android:layout_alignParentBottom="true"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/iv_circle_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="99dp"
            android:layout_marginTop="191dp"
            android:src="@drawable/revone_bigbang_anim_circle_icon"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/iv_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/revone_bigbang_anim_mask"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/iv_circle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="137dp"
            android:layout_marginTop="102dp"
            android:src="@drawable/revone_bigbang_anim_circle_text"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/iv_small_window"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="200dp"
            android:src="@drawable/revone_bigbang_anim_small_window"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"/>
    </RelativeLayout>
</merge>
