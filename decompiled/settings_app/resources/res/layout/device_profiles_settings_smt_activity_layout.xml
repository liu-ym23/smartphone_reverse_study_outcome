<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:paddingTop="112dp"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/device_rename"
                app:ocardlistitem_title="@string/device_name_new"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <TextView
                android:id="@+id/profiles_header_title"
                android:visibility="gone"
                android:text="@string/bluetooth_device_advanced_profile_header_title"
                style="@style/OCardListSubTitle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/profiles_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/profiles_bottom_view"
                layout="@layout/item_sub_settings_padding_layout2"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/auto_disconnect_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/connection_timer"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_title="@string/bluetooth_connection_timer"
                    style="@style/OCardListItemTextSingle"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/codec_item"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/setting_item_gap"
                app:ocardlistitem_title="@string/codec_item"
                style="@style/OCardListItemSwitchSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/advanced_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/advanced_setting"
                    app:ocardlistitem_title="@string/bluetooth_advanced_settings"
                    style="@style/OCardListItemTextSingle"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/btnLayoutRecordVoicePrint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding">
                <com.obric.oui.button.OButton
                    android:textColor="@color/oui_accent_7_fg"
                    android:id="@+id/btn_record_voice_print"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:text="@string/bluetooth_record_voice_print"
                    app:oui_radius="20dp"
                    style="@style/OStyleV2.OButton.L.Trans.Primary"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/btnLayoutTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding">
                <com.obric.oui.button.OButton
                    android:textColor="@color/oui_accent_7_fg"
                    android:id="@+id/disconnect_btn"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:text="@string/bluetooth_device_context_disconnect"
                    app:oui_radius="20dp"
                    style="@style/OStyleV2.OButton.L.Trans.Primary"/>
                <com.obric.oui.progress.ODownloadProgressView
                    android:layout_gravity="center"
                    android:id="@+id/loading_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:oui_progress_view_size="small"
                    app:oui_progressing_action_color="@color/oui_basic_text_1"/>
            </FrameLayout>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/btnLayoutBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding">
                <com.obric.oui.button.OButton
                    android:textColor="@color/oui_red_6"
                    android:id="@+id/unpair_btn"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:text="@string/bluetooth_device_context_unpair"
                    app:oui_radius="20dp"
                    style="@style/OStyleV2.OButton.L.Trans.Primary"/>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fake_status_bar"
        app:oFloatingTitleBar_centerTitle="@string/bluetooth_device_advanced_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        app:shadowVisible="true"/>
</RelativeLayout>
