<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUILinearLayoutDisableChildren
        android:orientation="vertical"
        android:id="@+id/launch_app"
        android:background="@drawable/o_background_list_item"
        android:layout_width="@dimen/app_info_button_width"
        android:layout_height="72dp"
        android:layout_alignParentStart="true"
        app:oui_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/settings_oic_arrow_up_right_circle"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/open_app"
            style="@style/Label_M"/>
    </com.obric.oui.layout.OUILinearLayoutDisableChildren>
    <com.obric.oui.layout.OUILinearLayoutDisableChildren
        android:orientation="vertical"
        android:id="@+id/force_stop_app"
        android:background="@drawable/o_background_list_item"
        android:layout_width="@dimen/app_info_button_width"
        android:layout_height="72dp"
        android:layout_centerHorizontal="true"
        app:oui_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/settings_oic_minus_circle"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/force_stop"
            style="@style/Label_M"/>
    </com.obric.oui.layout.OUILinearLayoutDisableChildren>
    <com.obric.oui.layout.OUILinearLayoutDisableChildren
        android:orientation="vertical"
        android:id="@+id/uninstall_app"
        android:background="@drawable/o_background_list_item"
        android:layout_width="@dimen/app_info_button_width"
        android:layout_height="72dp"
        android:layout_alignParentEnd="true"
        app:oui_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/settings_oic_trashcan_24"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/uninstall_app_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/uninstall_text"
            style="@style/Label_M"/>
    </com.obric.oui.layout.OUILinearLayoutDisableChildren>
</RelativeLayout>
