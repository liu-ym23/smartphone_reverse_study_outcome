<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/method_finger_print"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_large"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_icon="@drawable/unlock_fingerprint"
            app:ocardlistitem_showIcon="true"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/enroll_fingerprint_data"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/method_face"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_middle"
            app:ocardlistitem_cardType="type_large"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_icon="@drawable/unlock_face"
            app:ocardlistitem_showIcon="true"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/enroll_face_data"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/method_simplepwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_large"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_icon="@drawable/unlock_simplepwd"
            app:ocardlistitem_showIcon="true"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/setup_lockscreen_title"/>
    </LinearLayout>
</RelativeLayout>
