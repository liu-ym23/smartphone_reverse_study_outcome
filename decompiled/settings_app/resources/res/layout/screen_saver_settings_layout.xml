<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/screensaver_main_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/screensaver_settings_toggle_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/screensaver_when_to_dream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/screensaver_settings_when_to_dream"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/screensaver_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/dream_preview_button_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/screensaver_customize"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/screensaver_settings_customize"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/screensaver_picker_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/dream_picker_category"
                style="@style/OSectionTitleBar.S"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/screensaver_dream_list"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/screensaver_additional_info_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/screensaver_complications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/dream_complications_toggle_summary"
                    app:ocardlistitem_title="@string/dream_complications_toggle_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/screensaver_home_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/dream_home_controls_toggle_summary"
                    app:ocardlistitem_title="@string/dream_home_controls_toggle_title"/>
            </LinearLayout>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/screensaver_settings_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
