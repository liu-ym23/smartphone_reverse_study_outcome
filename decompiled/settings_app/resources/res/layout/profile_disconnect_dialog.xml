<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="14dp">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_1"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/bluetooth_disable_profile_title"
        style="@style/Title_Title_M"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/des_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bluetooth_disable_profile_name"
        style="@style/Body_M"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/des_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Body_M_Thick"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/desc_title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bluetooth_disable_profile_from"
        style="@style/Body_M"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/des_name2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        style="@style/Body_M_Thick"/>
</LinearLayout>
