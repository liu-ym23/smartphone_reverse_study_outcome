<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/app_item_icon"
        android:layout_width="@dimen/settings_list_item_icon_size"
        android:layout_height="@dimen/settings_list_item_icon_size"
        android:layout_marginLeft="@dimen/settings_list_item_gap"
        android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/settings_item_title_size"
        android:textColor="@color/setting_item_text_colorlist"
        android:ellipsize="end"
        android:id="@+id/app_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/power_usage_background_network_control_item_max_width"
        android:singleLine="true"
        android:layout_toRightOf="@+id/app_item_icon"
        android:layout_centerVertical="true"/>
    <obric.widget.SwitchEx
        android:id="@+id/app_switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/settings_item_right_widget_margin"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
