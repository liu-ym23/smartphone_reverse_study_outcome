<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/btnLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/oui_h_list_item_settings"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding">
                <com.obric.oui.button.OButton
                    android:textAppearance="@style/Title_1_Medium"
                    android:textColor="@color/oui_red_6"
                    android:layout_gravity="center"
                    android:id="@+id/initiate_master_clear"
                    android:layout_width="match_parent"
                    android:text="@string/master_clear_btn_text"
                    app:oui_radius="20dp"
                    style="@style/OStyleV2.OButton.L.Trans.Primary"/>
            </FrameLayout>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/master_clear_warning_tips"
                app:section_des_text="@string/master_clear_warning_tips"
                style="@style/OSectionSupportive.Text"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/warning_red"
                android:id="@+id/device_owner_disable_tips"
                android:text="@string/master_clear_device_owner_disable_tips"
                style="@style/OCardListShows"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:textColor="@color/warning_red"
                android:id="@+id/battery_lower_tips"
                app:section_des_text="@string/master_clear_battery_lower_tips"
                style="@style/OSectionSupportive.Text"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/oui_text_1"
                android:id="@+id/work_policy_info_text"
                android:layout_width="1px"
                android:layout_height="1px"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_restore"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
