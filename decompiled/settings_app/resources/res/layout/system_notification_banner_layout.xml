<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/system_notification_banner"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_land_container_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/video_layout"
                android:paddingTop="@dimen/tutorial_video_padding"
                android:paddingBottom="@dimen/tutorial_video_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/tutorial_video_padding"
                android:paddingEnd="@dimen/tutorial_video_padding"
                style="@style/SettingSubItemSingleStyle">
                <VideoView
                    android:layout_gravity="center"
                    android:id="@+id/video_view"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/system_notification_banner_height"/>
                <View
                    android:id="@+id/video_background"
                    android:background="@android:color/white"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/system_notification_banner_height"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/video_default"
                    android:background="@drawable/window_tutorial_background"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/system_notification_banner_height"/>
            </FrameLayout>
            <TextView
                android:id="@+id/system_notification_tips"
                android:text="@string/system_notification_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/storage_full_switch"
                android:visibility="visible"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                android:title="@string/system_notification_storage_full"
                style="@style/SettingSubItemSwitchTopStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/printer_switch"
                android:visibility="visible"
                android:title="@string/system_notification_printer"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/debug_mode_switch"
                android:visibility="visible"
                android:title="@string/system_notification_debug_mode"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/personal_hotspot_switch"
                android:visibility="visible"
                android:title="@string/system_notification_personal_hotspot"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/eye_protection_mode_plan_switch"
                android:visibility="gone"
                android:title="@string/system_notification_eye_protection_mode_plan"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/picture_in_picture_switch"
                android:visibility="visible"
                android:title="@string/system_notification_picture_in_picture"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/driving_mode_switch"
                android:visibility="visible"
                android:title="@string/system_notification_driving_mode"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/bluetooth_transport_switch"
                android:visibility="visible"
                android:title="@string/system_notification_bluetooth_transport"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/contact_import_and_export_switch"
                android:visibility="visible"
                android:title="@string/system_notification_contact_import_and_export"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/screen_light_switch"
                android:visibility="visible"
                android:title="@string/system_notification_screen_light"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/screen_recording_switch"
                android:visibility="visible"
                android:title="@string/system_notification_screen_recording"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/upload_download_switch"
                android:visibility="visible"
                android:title="@string/system_notification_upload_download"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/sim_card_unavailable_switch"
                android:visibility="visible"
                android:title="@string/system_notification_sim_card_unavailable"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/tnt_mode_switch"
                android:visibility="visible"
                android:title="@string/system_notification_tnt_mode"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/virtual_memory_switch"
                android:visibility="visible"
                android:title="@string/system_notification_virtual_memory"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/usb_device_connection_switch"
                android:visibility="visible"
                android:title="@string/system_notification_usb_device_connection"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/vpn_switch"
                android:visibility="visible"
                android:title="@string/system_notification_vpn"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/call_missed_switch"
                android:visibility="visible"
                android:title="@string/system_notification_call_missed"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/virtual_touch_pad_switch"
                android:visibility="visible"
                android:title="@string/system_notification_virtual_touch_pad"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/game_speed_up_switch"
                android:visibility="visible"
                android:title="@string/system_notification_game_speed_up"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/voice_mailbox_switch"
                android:visibility="visible"
                android:title="@string/system_notification_voice_mailbox"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/reading_mode_switch"
                android:visibility="visible"
                android:title="@string/system_notification_reading_mode"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/positioning_switch"
                android:visibility="visible"
                android:title="@string/system_notification_positioning"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
