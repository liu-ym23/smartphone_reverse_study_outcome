<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_centerTitle="@string/choose_theme"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
        <obric.widget.ShadowFrameLayout
            android:id="@+id/next_step_btn_group"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            app:bottom_type="true">
            <com.obric.oui.button.OButton
                android:layout_gravity="center"
                android:id="@+id/next_step_btn"
                android:layout_width="240dp"
                android:layout_height="40dp"
                style="@style/LongButton.Shrink.Highlight"/>
        </obric.widget.ShadowFrameLayout>
        <com.android.settings.widget.SelectOptionsView
            android:gravity="center_horizontal"
            android:id="@+id/select_options_view"
            android:background="@drawable/preview_slider_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/next_step_btn_group"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/select_options_view"
            android:layout_below="@+id/view_title">
            <FrameLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/launcher_preview_margin_bottom"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/preview_image"
                    android:layout_width="@dimen/launcher_preview_image_width"
                    android:layout_height="@dimen/launcher_preview_image_height"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/phone_frame"
                    android:layout_width="@dimen/launcher_preview_phone_frame_width"
                    android:layout_height="@dimen/launcher_preview_phone_frame_height"
                    android:src="@drawable/page_animations_preview_phone"/>
            </FrameLayout>
        </RelativeLayout>
        <include layout="@layout/title_bar_shadow"/>
    </RelativeLayout>
</FrameLayout>
