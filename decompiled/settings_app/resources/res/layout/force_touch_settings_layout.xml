<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/force_touch_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/force_touch_title"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.ListContentItemCustom
                isPressable="false"
                style="@style/SettingItemSingleStyle">
                <com.android.settings.widget.ForceTouchGifAnimView
                    android:gravity="center"
                    android:id="@+id/gif_view"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </obric.widget.ListContentItemCustom>
            <TextView
                android:id="@+id/id_phone_case_video_intro_tips"
                android:text="@string/force_touch_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:text="@string/force_touch_shortcut_title"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_lock_screen_shortcut"
                android:visibility="gone"
                android:title="@string/lock_screen_shortcut"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_text_shortcut"
                android:title="@string/force_touch_shortcut_text"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_image_shortcut"
                android:title="@string/force_touch_shortcut_image"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_track_ball_shortcut"
                android:title="@string/nav_track_ball"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_quick_pushpin_shortcut"
                android:title="@string/force_touch_quick_pushpin"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.widget.SettingPreviewSeekBar
                android:id="@+id/id_force_touch_pressure"
                android:paddingBottom="@dimen/settings_item_top_bottom_margin"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressDrawable="@drawable/selector_force_touch_sensitivity_tracker"
                android:thumb="@drawable/color_seekbar_thumb_selector"
                setting:defaultIndex="0"
                setting:previewMode="SIMPLE_ITEM"
                setting:tips="@string/force_touch_sensitivity_tips"
                setting:title="@string/force_touch_sensitivity"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
