<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_open_source_license"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:ocardlistitem_title="@string/title_open_source_license"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_google_legal_info"
                android:visibility="visible"
                android:layout_marginBottom="16dp"
                app:ocardlistitem_title="@string/title_google_legal_info"
                style="@style/OCardListItemTextSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_google"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_legal_notice"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:ocardlistitem_title="@string/title_legal_notice"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_safety_information"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:ocardlistitem_title="@string/settings_safetylegal_title"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_nation_license"
                app:ocardlistitem_title="@string/title_national_certification"
                style="@style/OCardListItemTextSingle"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_user_license"
                app:ocardlistitem_title="@string/title_user_license_argeement"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_privacy_policy"
                app:ocardlistitem_title="@string/title_privacy_policy"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_settings_privacy_policy"
                app:ocardlistitem_title="@string/title_settings_privacy_policy"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_settings_open_source"
                app:ocardlistitem_title="@string/title_settings_open_source"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_settings_app_open_source"
                app:ocardlistitem_title="@string/title_settings_app_open_source"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_settings_app_other_law"
                app:ocardlistitem_title="@string/title_settings_app_other_law"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_bottom_shadow_layout2"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/tv_law_model"
                android:background="@color/oui_bg_base_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="44dp"
                app:section_des_text="@string/law_info_model"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/about_item_title_law_info"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
