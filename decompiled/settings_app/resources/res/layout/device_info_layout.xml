<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@null"
    android:paddingLeft="@dimen/pop_up_dialog_horizontal_margin"
    android:paddingTop="20dp"
    android:paddingRight="@dimen/pop_up_dialog_horizontal_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/device_info_title_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_model_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_number"/>
        <TextView
            android:textSize="@dimen/device_info_summary_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_model_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/device_info_title_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_storage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/storage_capacity"/>
        <TextView
            android:textSize="@dimen/device_info_summary_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_storage_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/device_info_title_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_imei_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/status_imei"/>
        <TextView
            android:textSize="@dimen/device_info_summary_text_size"
            android:textColor="@color/setting_item_summary_text_color"
            android:id="@+id/id_imei_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/transparent_view"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
