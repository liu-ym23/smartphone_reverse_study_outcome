<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/ten_shortcut_btn"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <obric.widget.ListContentItemText
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ListContentItemStyle.Top">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/revone_shortcut_intro"
                    android:layout_centerInParent="true"/>
            </obric.widget.ListContentItemText>
            <obric.widget.SettingItemSwitch
                android:id="@+id/global_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:title="@string/ten_shortcut_btn"
                style="@style/ListContentItemStyle.Bottom"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/switch_list_views"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_l1"
                    android:title="@string/my_search"
                    style="@style/SettingSubItemSwitchTopStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_l2"
                    android:title="@string/internet_search"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_l3"
                    android:title="@string/local_search"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_l4"
                    android:title="@string/create_thinkboost"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_l5"
                    android:title="@string/send_bullet_mms"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_r1"
                    android:title="@string/gallery"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_r2"
                    android:title="@string/file_manager"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_r3"
                    android:title="@string/quick_phrase_and_clipboard"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_r4"
                    android:title="@string/thinkboost_list"
                    style="@style/SettingSubItemSwitchMidStyle"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/btn_r5"
                    android:title="@string/shortcut_screenshot"
                    style="@style/SettingSubItemSwitchBottomStyle"/>
            </LinearLayout>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
