<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/color_profiles_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <obric.widget.ListContentItemCustom
                android:id="@+id/id_color_profile_overview"
                android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                style="@style/SettingSubItemSingleStyle">
                <TextView
                    android:textSize="18sp"
                    android:id="@+id/color_profiles_warm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/brightness_icon_left_margin"
                    android:text="@string/color_profiles_warm"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="18sp"
                    android:id="@+id/color_profiles_cold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/brightness_icon_right_margin"
                    android:text="@string/color_profiles_cold"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <SeekBar
                    android:id="@+id/calibration_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/selector_color_temp_tracker"
                    android:thumb="@drawable/color_seekbar_thumb_selector"
                    android:layout_toLeftOf="@+id/color_profiles_cold"
                    android:layout_toRightOf="@+id/color_profiles_warm"
                    android:layout_centerVertical="true"/>
            </obric.widget.ListContentItemCustom>
            <obric.widget.SettingItemSwitch
                android:id="@+id/switch_auto_color_profile"
                android:background="@drawable/selector_setting_sub_item_bg_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:smtTitle="@string/color_profiles_auto_switch"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/id_tips_color_profiles"
                android:text="@string/color_profiles_info"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:gravity="left"
                android:id="@+id/id_color_profiles_eye_protection"
                android:text="@string/color_profiles_info_under_eye_protection"
                style="@style/SettingItemTipsStyle"/>
            <com.android.settings.widget.SettingItemButton
                android:layout_gravity="center"
                android:id="@+id/reset_btn"
                android:text="@string/color_profiles_reset"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
