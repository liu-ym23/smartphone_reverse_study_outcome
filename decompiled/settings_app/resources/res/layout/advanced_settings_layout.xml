<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/dimen_32"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/swap_ai_and_power_key"
                android:visibility="gone"
                app:ocardlistitem_title="@string/swap_ai_and_power_key"
                style="@style/OCardListItemSwitchSingle"/>
            <include
                android:id="@+id/swap_ai_and_power_key_bottom_gap"
                android:visibility="gone"
                layout="@layout/scrollview_bottom_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ime_settings"
                app:ocardlistitem_title="@string/language_settings"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/navbar_settings"
                app:ocardlistitem_title="@string/system_navigation_mode"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/accessibility_settings"
                app:ocardlistitem_title="@string/accessibility_expertise_settings_title"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/date_time_settings"
                    app:ocardlistitem_title="@string/date_time_temperature_title"
                    style="@style/OCardListItemTextTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/eldership_mode"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/eldership_mode_settings_title"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_assisant"
                    app:ocardlistitem_title="@string/advanced_item_assistant"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_zte_backup"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/advanced_item_zte_backup"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_account"
                    app:ocardlistitem_title="@string/advanced_item_account"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_user"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/item_user"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_storage"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/advanced_item_storate"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_restore"
                    app:ocardlistitem_title="@string/advanced_item_restore"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_backup"
                    app:ocardlistitem_title="@string/data_backup"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_data_transfer"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/transfer_data_to_new_phone"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_led_brightness"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/led_brightness_settings"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_camera_location"
                    app:ocardlistitem_title="@string/record_camera_location"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_notification_custom"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/notification_custom"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_third_party"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/third_party_app_customize"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/id_screen_rotation"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/screen_rotation_manual"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_google_settings"
                    android:visibility="gone"
                    app:ocardlistitem_title="@string/google_service_title"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_development"
                    app:ocardlistitem_title="@string/advanced_item_development"
                    style="@style/OCardListItemTextBottom"/>
            </LinearLayout>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/search_settings"
                app:ocardlistitem_title="@string/search_in_settings"
                style="@style/OCardListItemTextSingle"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/advanced_settings_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
