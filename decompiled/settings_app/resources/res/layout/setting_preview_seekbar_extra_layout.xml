<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/force_touch_preview_seekbar_anim_text_size"
        android:textColor="@color/setting_item_text_color"
        android:id="@+id/tips_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/force_touch_pressure_text_text"
        android:layout_centerInParent="true"/>
    <com.android.settings.widget.ForceTouchSensitivityAnimView
        android:id="@+id/force_touch_anim_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
