<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/enabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/notification_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/notification_enabled"/>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/selection_title"
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_titleText="@string/notification_more_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/high_importance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/notification_importance_high_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/switch_notification_ringtone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/notification_ringtone_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/switch_notification_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/notification_ringtone_vibrate"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/switch_notification_visible"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/app_notification_visibility_override_title"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
