<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/oui_bg_base_1"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <obric.widget.ListContentItemCustom
            android:id="@+id/widget_container"
            android:paddingTop="@dimen/tnt_settings_item_top_bottom_padding"
            android:paddingBottom="@dimen/tnt_settings_item_top_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
            android:layout_centerHorizontal="true"
            style="@style/SettingSubItemSingleStyle">
            <View
                android:id="@+id/item_bottom_shadow_view"
                android:background="@color/divider_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tnt_dividing_line_height"
                android:layout_marginTop="@dimen/tnt_settings_item_top_bottom_padding"
                android:layout_marginBottom="@dimen/tnt_settings_item_top_bottom_padding"/>
            <com.android.settings.widget.GridViewForScrollView
                android:id="@+id/candidate_container"
                android:paddingLeft="@dimen/tnt_settings_item_left_right_padding"
                android:paddingRight="@dimen/tnt_settings_item_left_right_padding"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@android:color/transparent"
                android:stretchMode="columnWidth"
                android:columnWidth="@dimen/tnt_drag_grid_view_column_width"
                android:numColumns="4"
                android:layout_below="@+id/item_bottom_shadow_view"/>
        </obric.widget.ListContentItemCustom>
        <TextView
            android:textSize="@dimen/settings_item_tips_text_size"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:text="@string/custom_notification_tips"
            style="@style/SettingItemTipsStyle"/>
    </LinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
