<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:gravity="top"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="300dp"
    android:overScrollMode="always">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/capabilities_header"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/OSectionTitleBar.S"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/capabilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
