<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_noDisturb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/nodisturb_header_title"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/voice_mode_tips"
                style="@style/OSectionTitleBar.S"/>
            <FrameLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/vibration_tips"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/vibrate_on_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/vibrate_on_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/vibration_intensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/vibration_intensity"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/volume_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:id="@+id/volume_container"
                android:background="@drawable/o_background_list_item"
                android:padding="@dimen/dimen_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_12"
                app:oui_radius="@dimen/oui_r_l3_rect">
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dimen_12"
                    android:paddingVertical="@dimen/dimen_10">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="358dp"
                            android:text="@string/volume_media_title"
                            android:maxLines="1"
                            style="@style/Title_1_Regular"/>
                        <com.android.settings.widget.VolumeSeekBar
                            android:layout_gravity="center_vertical"
                            android:id="@+id/media_volume"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_6"
                            app:oui_slider_left_icon="@drawable/vol_setting_media_min"
                            app:seekbarHeight="6dp"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:id="@+id/doubao_volume_bar_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"
                    android:paddingHorizontal="@dimen/dimen_12"
                    android:paddingVertical="@dimen/dimen_10">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="358dp"
                            android:text="@string/volume_assistant_title"
                            android:maxLines="1"
                            style="@style/Title_1_Regular"/>
                        <com.android.settings.widget.VolumeSeekBar
                            android:layout_gravity="center_vertical"
                            android:id="@+id/assistant_volume"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_6"
                            app:oui_slider_left_icon="@drawable/vol_setting_assistant_min"
                            app:seekbarHeight="6dp"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"
                    android:paddingHorizontal="@dimen/dimen_12"
                    android:paddingVertical="@dimen/dimen_10">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="358dp"
                            android:text="@string/volume_ringtone_title"
                            android:maxLines="1"
                            style="@style/Title_1_Regular"/>
                        <com.android.settings.widget.VolumeSeekBar
                            android:layout_gravity="center_vertical"
                            android:id="@+id/ringtone_volume"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_6"
                            app:oui_slider_left_icon="@drawable/vol_setting_call_min"
                            app:seekbarHeight="6dp"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"
                    android:paddingHorizontal="@dimen/dimen_12"
                    android:paddingVertical="@dimen/dimen_10">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="358dp"
                            android:text="@string/volume_notification_title"
                            android:maxLines="1"
                            style="@style/Title_1_Regular"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_3"
                            android:id="@+id/notification_tips"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/volume_notification_new_tips"
                            style="@style/Label_M_Thin"/>
                        <com.android.settings.widget.VolumeSeekBar
                            android:id="@+id/notification_volume"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_6"
                            app:oui_slider_left_icon="@drawable/vol_setting_notification_min"
                            app:seekbarHeight="6dp"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"
                    android:paddingHorizontal="@dimen/dimen_12"
                    android:paddingVertical="@dimen/dimen_10">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="358dp"
                            android:text="@string/volume_clock_title"
                            android:maxLines="1"
                            style="@style/Title_1_Regular"/>
                        <com.android.settings.widget.VolumeSeekBar
                            android:layout_gravity="center_vertical"
                            android:id="@+id/clock_volume"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_6"
                            app:oui_slider_left_icon="@drawable/vol_setting_clock_min"
                            app:seekbarHeight="6dp"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/volume_button_tips"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/volume_button_default_control_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/volume_button_default_control_tips"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/doubao_volume_bar_display_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/doubao_volume_bar_display_switch_title"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/ringtone_option_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_phone_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_phone_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_phone_ring_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_phone_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_sms_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_sms_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_sms_ring_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_sms_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_notification_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_default_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_alarm_ring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_text_alarm_ring"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/other_alert_tone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_settings_other_alert_tone"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/haptic_feedback_tips"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/haptic_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/haptic_feedback_intensity_tips"
                app:ocardlistitem_title="@string/haptic_feedback"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/input_method_haptic_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/input_method_haptic_feedback"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/dts_sound_effect_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/dts_sound_effect_subtitle"
                app:ocardlistitem_title="@string/dts_sound_effect_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/sound_work_settings_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/sound_work_settings"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fake_status_bar"
        app:oFloatingTitleBar_centerTitle="@string/sound_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
