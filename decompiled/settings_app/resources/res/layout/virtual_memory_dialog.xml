<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/parentPanel"
    android:background="@drawable/dialog_full_bytedanceos_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/title_template"
            android:background="@drawable/dialog_title_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="53dp">
            <ImageView
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@null"
                android:paddingEnd="8dp"/>
            <com.android.internal.widget.DialogTitle
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/alertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/virtual_memory_dialog_title"
                android:singleLine="true"
                style="?android:attr/windowTitleStyle"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="#9a000000"
            android:gravity="center"
            android:id="@+id/message"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:text="@string/virtual_memory_dialog_msg"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="20dp"
            android:paddingEnd="18dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/checkbox_layout"
            android:paddingBottom="23dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp">
            <CheckBox
                android:id="@+id/checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#9a000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/virtual_memory_dialog_checkbox"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonPanel"
        android:tag="bytedanceos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:showDividers="beginning"
        android:dividerPadding="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:divider="@drawable/dialog_line_bytedanceos"
            android:showDividers="middle"
            android:layoutDirection="locale">
            <Button
                android:textSize="13.5dp"
                android:textStyle="bold"
                android:textColor="#9a000000"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/disable"
                android:background="@drawable/dialog_button_background_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:text="@string/virtual_memory_dialog_negative_button"
                android:maxLines="2"
                android:layout_weight="1"/>
            <Button
                android:textSize="13.5dp"
                android:textStyle="bold"
                android:textColor="#3965cc"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/enable"
                android:background="@drawable/dialog_button_background_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:text="@string/virtual_memory_dialog_positive_button"
                android:maxLines="2"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
