<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/constraint_root_view"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/color_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/screen_color_mode"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/adaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/adaptive_color_mode"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/standard_color_mode"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/professional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/professional_color_mode"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/adaptive_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/adaptive_temperature"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/color_temperature_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginBottom="@dimen/dimen_32">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:id="@+id/color_temperature_title"
                    android:layout_marginHorizontal="@dimen/dimen_32"
                    app:sectionTitle_titleText="@string/screen_color_temperature"
                    style="@style/OSectionTitleBar.S"/>
                <com.android.settings.display.color.ScreenTemperatureView
                    android:id="@+id/color_temperature_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_12"/>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:id="@+id/eye_protected_tips"
                    android:visibility="gone"
                    android:layout_marginHorizontal="@dimen/dimen_32"
                    app:section_des_text="@string/eye_protected_tips"
                    style="@style/OSectionTitleBar.S"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/screen_color_and_temperature"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
