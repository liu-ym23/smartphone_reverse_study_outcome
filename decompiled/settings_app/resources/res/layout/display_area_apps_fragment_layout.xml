<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/application_status_bar_display_mode"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <obric.widget.SearchBar
        android:id="@+id/id_search_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title"
        app:hasRightIcon="false"
        app:hasShadow="false"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/id_search_bar">
        <com.android.settings.stickylistheaders.StickyListHeadersListView
            android:id="@+id/id_app_list"
            android:layout_below="@+id/id_search_bar"
            style="@style/ListViewGeneralStyle"/>
        <obric.widget.letters.QuickBarEx
            android:layout_gravity="right"
            android:id="@+id/quickbar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:id="@+id/view_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/application_manager_empty_view_text"
            style="@style/SettingItemTextShadowStyle"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/searchview"/>
        <include
            android:id="@+id/search_bar_shadow"
            layout="@layout/title_secondary_bar_shadow"/>
    </FrameLayout>
</RelativeLayout>
