<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title">
        <FrameLayout
            android:id="@+id/laser_calibration_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_item_top_bottom_margin">
            <TextView
                android:textSize="@dimen/settings_item_title_size"
                android:textColor="@color/setting_item_text_color_disabled"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/laser_calibration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/laser_calibration_progress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/laser_calibration_progressbar_anim"/>
        </FrameLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/laser_calibrate_button_10"
            android:paddingTop="@dimen/calibrate_button_padding_top"
            android:paddingBottom="@dimen/calibrate_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/laser_button_item_marginTop"
            android:text="@string/laser_calibrate_button_10"
            style="@style/LongButton.Highlight"/>
        <com.obric.oui.button.OButton
            android:id="@+id/laser_calibrate_button_60"
            android:paddingTop="@dimen/calibrate_button_padding_top"
            android:paddingBottom="@dimen/calibrate_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/laser_button_item_marginTop"
            style="@style/LongButton.Highlight"/>
        <com.obric.oui.button.OButton
            android:id="@+id/laser_button"
            android:paddingTop="@dimen/calibrate_button_padding_top"
            android:paddingBottom="@dimen/calibrate_button_padding_bottom"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/laser_button_item_marginTop"
            android:text="@string/laser_button"
            style="@style/LongButton.Highlight"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_color_disabled"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/laser_calibration_hint"
            android:paddingLeft="@dimen/common_horizontal_padding"
            android:paddingTop="60dp"
            android:paddingRight="@dimen/common_horizontal_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
