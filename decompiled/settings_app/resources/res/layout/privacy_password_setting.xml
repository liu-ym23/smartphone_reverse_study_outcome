<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/security_password"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/security_privacy_module"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_plate_lock"
                android:title="@string/security_desktop_plate_lock"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_application_lock"
                android:title="@string/security_application_lock"
                style="@style/SettingSubItemBottomStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_origin_application_lock"
                android:visibility="gone"
                android:title="@string/security_application_lock"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:text="@string/security_privacy_setting"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_change_password"
                android:title="@string/security_change_password"
                style="@style/SettingSubItemSingleStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <RelativeLayout
        android:id="@+id/btnLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/btnLayout_marginBottom"
        android:layout_alignParentBottom="true">
        <com.obric.oui.button.OButton
            android:id="@+id/close_password"
            android:layout_width="match_parent"
            android:text="@string/security_close_password"
            style="@style/LongButton.Highlight.Red"/>
    </RelativeLayout>
</RelativeLayout>
