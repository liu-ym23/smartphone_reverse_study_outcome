<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/list_item_maximum_width">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="60dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_96"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_2"
                    android:id="@+id/certification_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/certification_country"
                    android:includeFontPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Title_Title_M"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_2"
                    android:id="@+id/cmiit_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/certification_country"
                    style="@style/Title_Title_M"/>
                <ImageView
                    android:id="@+id/main_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:src="@drawable/certification_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cmiit_id"/>
                <com.obric.oui.text.OTextView
                    android:textSize="24dp"
                    android:id="@+id/brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="23dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/hycusong_caict"
                    app:layout_constraintBottom_toBottomOf="@+id/main_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:id="@+id/cmmiit_id_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/hycusong_caict"
                    app:layout_constraintBottom_toBottomOf="@+id/main_content"
                    app:layout_constraintEnd_toEndOf="@+id/main_content"
                    app:layout_constraintStart_toStartOf="@+id/main_content"/>
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/certification_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/main_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="60dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/phone_substances"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_text_3b"
                    android:id="@+id/manufacturer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上海申启纪元智能终端有限责任公司"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/Title_Title_L"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_2"
                    android:id="@+id/desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="5G 数字移动电话机"
                    app:layout_constraintBottom_toTopOf="@+id/manufacturer"
                    app:layout_constraintEnd_toStartOf="@+id/desc_band"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/Title_Title_M"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_2"
                    android:id="@+id/desc_band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/desc"
                    app:layout_constraintTop_toTopOf="@+id/desc"
                    style="@style/Title_Title_M"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_centerTitle="@string/title_national_certification"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
