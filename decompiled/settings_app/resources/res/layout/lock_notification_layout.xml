<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/doze_enable_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/system_notification_lighting_screen_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/keep_lock_screen_notification_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/system_notification_keep_lock_screen_notification_summary"
                app:ocardlistitem_title="@string/system_notification_keep_lock_screen_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lock_screen_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/system_notification_lock_screen_notification"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/lock_notification_themes_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.layout.OUILinearLayout
                android:background="@drawable/radius_20_white"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle"
                android:layout_marginHorizontal="12dp"
                app:oui_radius="@dimen/dimen_20">
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/list_theme"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/lock_notification_list_img"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <com.obric.oui.checkbox.OCheckBox
                            android:layout_gravity="center"
                            android:id="@+id/list_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:oui_checkedState="checked"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_notification_list"
                            android:layout_marginStart="9dp"
                            style="@style/Button_1_Regular"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/count_theme"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/lock_notification_count_img"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <com.obric.oui.checkbox.OCheckBox
                            android:layout_gravity="center"
                            android:id="@+id/count_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:oui_checkedState="checked"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_notification_number"
                            android:layout_marginStart="9dp"
                            style="@style/Button_1_Regular"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/lock_notification_ai_display_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.layout.OUILinearLayout
                android:background="@drawable/radius_20_white"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle"
                android:layout_marginHorizontal="12dp"
                app:oui_radius="@dimen/dimen_20">
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ai_space_expanded_display"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/lock_notification_ai_expanded_img"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <com.obric.oui.checkbox.OCheckBox
                            android:layout_gravity="center"
                            android:id="@+id/ai_space_expanded_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:oui_checkedState="checked"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_notification_ai_expanded_display"
                            android:layout_marginStart="9dp"
                            style="@style/Button_1_Regular"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/notification_expanded_display"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/lock_notification_normal_expanded_img"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <com.obric.oui.checkbox.OCheckBox
                            android:layout_gravity="center"
                            android:id="@+id/notification_expanded_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:oui_checkedState="checked"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_notification_normal_expanded_display"
                            android:layout_marginStart="9dp"
                            style="@style/Button_1_Regular"/>
                    </LinearLayout>
                </com.obric.oui.layout.OUILinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <include layout="@layout/item_bottom_shadow_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/lock_notification"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
