<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="8dp">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/question_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/question_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textFontWeight="500"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option_layout_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <com.obric.oui.checkbox.OCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/option_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_checkedState="unchecked"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/option_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option_layout_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <com.obric.oui.checkbox.OCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/option_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_checkedState="unchecked"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/option_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option_layout_3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <com.obric.oui.checkbox.OCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/option_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_checkedState="unchecked"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/option_text_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option_layout_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <com.obric.oui.checkbox.OCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/option_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_checkedState="unchecked"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/option_text_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/oui_basic_line_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
