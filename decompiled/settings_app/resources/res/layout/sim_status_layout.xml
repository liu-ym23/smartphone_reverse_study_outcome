<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.settings.AboutStaticItem
        android:id="@+id/operator_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:cardPosition="top"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_operator"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/signal_strength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_signal_strength"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/network_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_network_type"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/volte_state"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/radioInfo_data_disconnected"
        setting:title="@string/volte_state"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/service_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_service_state"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/roaming_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_roaming"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/data_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_data_state"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/unknown_number"
        setting:title="@string/status_number"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/min_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_min_number"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/prl_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_prl_version"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/meid_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_meid_number"/>
    <com.android.settings.AboutStaticItem
        android:id="@+id/icc_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        setting:cardPosition="bottom"
        setting:summary="@string/device_info_not_available"
        setting:title="@string/status_icc_id"/>
</LinearLayout>
