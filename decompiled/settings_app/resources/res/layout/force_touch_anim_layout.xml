<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/force_touch_layer_1"
    android:padding="2px"
    android:layout_width="@dimen/bigbang_anim_area_width"
    android:layout_height="@dimen/bigbang_anim_area_height"
    android:layout_marginTop="@dimen/bigbang_anim_margin_common"
    android:layout_marginBottom="@dimen/bigbang_anim_margin_common">
    <ImageView
        android:id="@+id/layer_1"
        android:background="@drawable/bigbang_anim_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/layer_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_layer_2"/>
        <ImageView
            android:id="@+id/circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_circle"/>
        <ImageView
            android:id="@+id/tool_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_tool_1"/>
        <ImageView
            android:id="@+id/tool_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_tool_2"/>
        <ImageView
            android:id="@+id/tool_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_tool_3"/>
        <ImageView
            android:id="@+id/tool_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_tool_4"/>
        <ImageView
            android:id="@+id/tool_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_tool_5"/>
        <ImageView
            android:id="@+id/hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/force_touch_hand"/>
    </RelativeLayout>
</RelativeLayout>
