<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/about_item_title_device_status"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/status_container"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:paddingBottom="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.settings.AboutStaticItem
                android:id="@+id/battery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/battery_status_title"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/battery_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/battery_level_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sim_status_entrance_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.android.settings.AboutStaticItem
                    android:id="@+id/sim_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    setting:show_arrow="true"
                    setting:summary="@string/unknown_number"
                    setting:summaryColor="@color/setting_item_summary_text_colorlist"
                    setting:title="@string/multi_sim_sub_1_title"
                    setting:titleColor="@color/setting_item_text_colorlist"/>
                <com.android.settings.AboutStaticItem
                    android:id="@+id/sim_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    setting:show_arrow="true"
                    setting:summary="@string/unknown_number"
                    setting:summaryColor="@color/setting_item_summary_text_colorlist"
                    setting:title="@string/multi_sim_sub_2_title"
                    setting:titleColor="@color/setting_item_text_colorlist"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/sim_status_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/imei"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/status_imei"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/imei_sv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/status_imei_sv"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/fcc_id"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/title_fcc_id"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/cmiit_id"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/title_cmiit_id"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/wifi_ip_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available_ip"
                setting:title="@string/wifi_advanced_ip_address_title"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/wifi_mac_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available_mac"
                setting:title="@string/status_wifi_mac_address"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/bt_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available_bt"
                setting:title="@string/status_bt_address"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/serial_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/status_serial_number"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/up_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/status_up_time"/>
            <com.android.settings.AboutStaticItem
                android:id="@+id/wimax_mac_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                setting:summary="@string/device_info_not_available"
                setting:title="@string/status_wimax_mac_address"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
