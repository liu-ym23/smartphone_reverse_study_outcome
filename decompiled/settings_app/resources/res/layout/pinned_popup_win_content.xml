<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:background="@drawable/bytedance_floating_popup_window"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmallInverse"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/text"
            android:background="@drawable/bytedance_floating_popup_menu_text_bg"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:fitsSystemWindows="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#4d000000"
            android:shadowDy="-2"
            android:shadowRadius="0.1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:src="@drawable/bytedance_floating_popup_menu_bottom_arrow"/>
</FrameLayout>
