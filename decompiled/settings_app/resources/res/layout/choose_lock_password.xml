<?xml version="1.0" encoding="utf-8"?>
<com.obric.widget.SizeChangedRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/size_changed_layout"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lockscreen_mode_item_password_title"
        style="@style/Title_4_Bold"/>
    <com.obric.oui.text.OTextView
        android:gravity="center"
        android:id="@+id/headerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_below="@+id/title"
        style="@style/Subtitle_2_Regular"/>
    <com.obric.oui.forms.OInputLayout
        android:id="@+id/passwordEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:maxLines="1"
        android:layout_below="@+id/headerText"
        android:inputType="textPassword"
        android:layout_marginHorizontal="16dp"
        app:oinput_minHeight="48dp"
        app:oinput_showEyes="true"
        app:oinput_showInputBackground="true"
        app:oinput_type="0"/>
    <include layout="@layout/password_cover"/>
    <FrameLayout
        android:id="@+id/pin_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fake_status_bar"
        app:oFloatingTitleBar_endButtonGroupStyle="@style/OStyleV2.OButtonFloating.S.Standard.Icon"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</com.obric.widget.SizeChangedRelativeLayout>
