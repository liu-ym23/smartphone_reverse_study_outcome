<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <TextView
        android:id="@+id/id_tts_engine_status"
        android:layout_marginBottom="14dp"
        android:text="@string/tts_install_data_summary"
        style="@style/SettingItemTipsStyle"/>
    <com.android.settings.widget.SettingCommonSeekBar
        android:id="@+id/id_tts_speech_rate"
        setting:leftDesc="@string/tts_speech_rate_slower"
        setting:rightDesc="@string/tts_speech_rate_faster"
        setting:tips="@string/tts_reset_speech_rate_summary"
        setting:title="@string/tts_speech_rate_title"
        style="@style/Seekbar"/>
    <com.android.settings.widget.SettingCommonSeekBar
        android:id="@+id/id_tts_speech_pitch"
        setting:leftDesc="@string/tts_speech_pitch_lower"
        setting:rightDesc="@string/tts_speech_pitch_higher"
        setting:tips="@string/tts_reset_speech_pitch_summary"
        setting:title="@string/tts_speech_pitch_title"
        style="@style/Seekbar"/>
    <obric.widget.ListContentItemCustom
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Single">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/setting_item_text_colorlist"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/settings_item_title_left_margin"
            android:text="@string/tts_play_example_title"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/id_tts_example_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_item_right_widget_margin"
            android:src="@drawable/play_state_bg"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/audition"/>
    </obric.widget.ListContentItemCustom>
    <TextView
        android:text="@string/tts_play_example_summary"
        style="@style/SettingItemTipsStyle"/>
</LinearLayout>
