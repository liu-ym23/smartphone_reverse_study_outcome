<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.obric.oui.progress.ODownloadProgressView
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress_view_processing_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:oui_progress_view_size="large"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/oui_text_3b"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_processing_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/provision_device_activating"
                android:lineHeight="22dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
