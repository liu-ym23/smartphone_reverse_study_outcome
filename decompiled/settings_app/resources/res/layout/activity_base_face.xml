<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:paddingTop="40dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/titlebar_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_alignParentTop="true">
        <com.obric.oui.button.OIconButton
            android:id="@+id/titlebar_back_btn"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_margin="12dp"
            android:src="@drawable/oui_ic_back_24_24"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            style="@style/OIconButton.M1.Trans.Neutral"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:gravity="center"
            android:id="@+id/titlebar_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_centerInParent="true"
            style="@style/Title_Display"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/oui_text_1"
            android:id="@+id/titlebar_right_btn"
            android:visibility="gone"
            android:layout_margin="12dp"
            android:text="@string/button_skip"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            style="@style/OButton.M1.Standard.Neutral"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_action_bar"
        android:layout_below="@+id/titlebar_container">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/assistant_img"
                    android:layout_width="328dp"
                    android:layout_height="292dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/provision_face_enroll"
                    android:scaleType="centerInside"
                    android:layout_marginHorizontal="16dp"/>
                <TextView
                    android:textColor="@color/oui_text_1"
                    android:gravity="center_horizontal"
                    android:id="@+id/assistant_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/provision_face_enroll_title"
                    android:singleLine="true"
                    style="@style/Title_Title_M"/>
                <FrameLayout
                    android:id="@+id/assistant_subtitle_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginHorizontal="32dp">
                    <TextView
                        android:textColor="@color/oui_text_3"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/assistant_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provision_face_enroll_subtitle"
                        android:maxLines="2"
                        style="@style/Label_M_Thin"/>
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp">
            <com.obric.oui.button.OButton
                android:id="@+id/bottom_button"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:text="@string/next_step"
                style="@style/OButton.L1.Standard.Primary"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
