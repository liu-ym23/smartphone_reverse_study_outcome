<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/id_seekbar_title"
        style="@style/SettingItemTitleStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/id_preview_mode_simple_item"
        android:paddingBottom="@dimen/settings_item_top_bottom_margin"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/id_seekbar_title">
        <obric.widget.SettingItemCheck
            android:id="@+id/id_force_touch_pressure_light"
            app:itemTitle="@string/force_touch_pressure_light"
            style="@style/SettingSubItemTopStyle"/>
        <obric.widget.SettingItemCheck
            android:id="@+id/id_force_touch_pressure_standard"
            app:itemTitle="@string/force_touch_pressure_standard"
            style="@style/SettingSubItemMidStyle"/>
        <obric.widget.SettingItemCheck
            android:id="@+id/id_force_touch_pressure_heavy"
            app:itemTitle="@string/force_touch_pressure_heavy"
            style="@style/SettingSubItemBottomStyle"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/id_preview_mode_progress"
        android:background="@drawable/selector_setting_sub_item_bg_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/force_touch_preview_seekbar_height"
        android:layout_below="@+id/id_preview_mode_simple_item">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/force_touch_seekbar_tips_tv_color"
            android:id="@+id/id_seekbar_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/force_touch_preview_seekbar_tv_hor_margin"
            android:layout_marginTop="@dimen/force_touch_preview_seekbar_tv_top_margin"
            android:layout_alignLeft="@+id/id_seekbar"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/force_touch_seekbar_tips_center_tv_color"
            android:id="@+id/id_seekbar_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/force_touch_preview_seekbar_tv_top_margin"
            android:text="@string/force_touch_pressure_standard"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/force_touch_seekbar_tips_tv_color"
            android:id="@+id/id_seekbar_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/force_touch_preview_seekbar_tv_top_margin"
            android:layout_marginRight="@dimen/force_touch_preview_seekbar_tv_hor_margin"
            android:layout_alignRight="@+id/id_seekbar"
            android:layout_alignParentTop="true"/>
        <SeekBar
            android:id="@+id/id_seekbar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="@dimen/force_touch_preview_seekbar_left_margin"
            android:layout_marginTop="@dimen/force_touch_preview_seekbar_top_margin"
            android:layout_marginRight="@dimen/force_touch_preview_seekbar_right_margin"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/id_seekbar_tips"
        android:layout_marginTop="-11dp"
        android:layout_below="@+id/id_preview_mode_simple_item"
        style="@style/SettingItemTipsStyle"/>
    <obric.widget.ListContentItemCustom
        android:layout_below="@+id/id_seekbar_tips"
        style="@style/SettingSubItemSingleStyle">
        <RelativeLayout
            android:id="@+id/anim_anchor_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/force_touch_preview_seekbar_anim_height">
            <TextView
                android:textSize="@dimen/force_touch_preview_seekbar_anim_text_size"
                android:textColor="@color/setting_item_text_color"
                android:id="@+id/anim_tips_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_item_title_left_margin"
                android:layout_marginRight="@dimen/settings_item_title_left_margin"
                android:text="@string/force_touch_pressure_text_text"
                android:layout_centerInParent="true"/>
            <com.android.settings.widget.ForceTouchSensitivityAnimView
                android:id="@+id/force_touch_anim_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </obric.widget.ListContentItemCustom>
</merge>
