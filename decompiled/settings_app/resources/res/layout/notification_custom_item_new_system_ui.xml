<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/grey_board"
    android:layout_width="73.3dp"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/notification_custom_widget_item_min_height">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/notification_custom_widget_name_text_size"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="@dimen/notification_custom_widget_name_margin_top"
        android:layout_marginRight="9dp"
        android:singleLine="true"/>
</LinearLayout>
