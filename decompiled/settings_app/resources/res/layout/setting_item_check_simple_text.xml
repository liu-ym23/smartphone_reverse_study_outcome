<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/item_check"
        android:visibility="invisible"
        android:layout_width="@dimen/settings_item_width_margin"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_check_confirm_rounded"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_item_margin_top_and_bottom"
        android:layout_marginBottom="@dimen/settings_item_margin_top_and_bottom"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_item_right_widget_margin"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/settings_item_summary_text_size"
            android:id="@+id/item_summary"
            android:visibility="gone"
            android:layout_marginTop="@dimen/settings_item_summary_margin_top"
            android:maxLines="5"
            style="@style/ListContentItemSummaryStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/settings_item_sub_title_size"
        android:textColor="@color/setting_item_summary_text_colorlist"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/item_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/setting_item_text_subtitle_margin_left"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/item_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/settings_item_right_widget_margin"
        android:src="@drawable/selector_start"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/goto_setup"/>
</LinearLayout>
