<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemCustom
        android:id="@+id/list_content_item"
        style="@style/SettingItemGeneralStyle">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_item_title_left_margin"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="@dimen/settings_item_title_size"
                    android:textColor="@color/setting_item_text_colorlist"
                    android:gravity="center_vertical"
                    android:id="@android:id/title"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/settings_item_sub_title_size"
                    android:textColor="@color/setting_item_summary_text_colorlist"
                    android:gravity="center_vertical"
                    android:id="@android:id/summary"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#33000000"
                    android:shadowDy="-1"
                    android:shadowRadius="0"/>
            </LinearLayout>
            <CheckBox
                android:id="@android:id/checkbox"
                android:focusable="false"
                android:clickable="false"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="18dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </obric.widget.ListContentItemCustom>
</RelativeLayout>
