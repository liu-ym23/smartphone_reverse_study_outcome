<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:paddingLeft="@dimen/list_item_left_right_margin"
    android:paddingRight="@dimen/list_item_left_right_margin"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemText
        android:id="@+id/processes_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.settings.applications.MyCheckedTextView
            android:id="@+id/processes_item_cb"
            android:background="@drawable/checktextview_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:button="@null"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/task_persist"
            android:background="@drawable/ic_pin_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/processes_item_cb"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/process_item_gap"
            android:background="@drawable/process_item_gap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="55dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/settings_list_item_icon_size"
            android:layout_height="@dimen/settings_list_item_icon_size"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
            android:scaleType="centerInside"
            android:layout_toRightOf="@+id/process_item_gap"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="@dimen/primary_text_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/memory_clean_item_persist_max_width"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:ellipsize="end"
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_list_item_icon_margin_right"
            android:layout_marginRight="12dp"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </obric.widget.ListContentItemText>
</LinearLayout>
