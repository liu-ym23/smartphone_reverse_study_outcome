<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/storage_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_top_margin">
            <obric.widget.SettingItemCheck
                android:id="@+id/popup_internal_storage"
                app:itemTitle="@string/path_internal_storage"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/popup_external_storage"
                app:itemTitle="@string/path_external_storage"
                style="@style/SettingSubItemBottomStyle"/>
            <TextView
                android:id="@+id/preferred_item_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:id="@+id/sd_preferred_item_tip"
                android:text="@string/storage_path_tips"
                style="@style/SettingItemTipsStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
