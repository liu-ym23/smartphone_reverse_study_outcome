<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/sim_card_name"
                android:layout_marginHorizontal="16dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/unknown_number"
                style="@style/OSectionTitleBar.S"/>
            <obric.widget.ListContentItemText
                android:id="@+id/head_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ListContentItemStyle.Single">
                <TextView
                    android:textSize="@dimen/settings_item_sub_title_size"
                    android:textColor="@color/selected_text_color"
                    android:id="@+id/selected_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/datausage_left_text"/>
                <TextView
                    android:textSize="@dimen/settings_item_sub_title_size"
                    android:textColor="@color/fingerprint_enrolling_tips_normal_color"
                    android:id="@+id/correct_time"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/data_usage_month_title"
                    android:layout_alignParentRight="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/selected_size"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="27dp"
                    android:layout_below="@+id/selected_text"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="40sp"
                        android:textColor="@color/selected_size_color"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/no_data"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="@color/selected_size_color"
                        android:id="@+id/scanning_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/selected_size_color"
                        android:id="@+id/scanning_size_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/data_usage_line"
                    android:background="@drawable/datausage_divide_line"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/selected_size"
                    android:layout_centerHorizontal="true"/>
                <RelativeLayout
                    android:id="@+id/data_usage_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:layout_marginBottom="26dp"
                    android:layout_below="@+id/data_usage_line">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/common_data_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="20dp">
                        <RelativeLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/today_used_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/today_used_view_data_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/data_usage_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/today_used"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/data_usage_unit_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/today_used_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/selected_text_color"
                                android:id="@+id/today_used_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxWidth="80dp"
                                android:text="@string/data_usage_today_title"
                                android:maxLines="2"
                                android:layout_below="@+id/today_used_view_data_line"
                                android:layout_alignLeft="@+id/today_used_view_data_line"/>
                        </RelativeLayout>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/datausage_devide_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <RelativeLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@+id/month_used_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/month_used_view_data_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/data_usage_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/month_used"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/data_usage_unit_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/month_used_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/selected_text_color"
                                android:id="@+id/month_used_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxWidth="80dp"
                                android:text="@string/data_usage_month_title"
                                android:maxLines="2"
                                android:layout_below="@+id/month_used_view_data_line"
                                android:layout_alignLeft="@+id/month_used_view_data_line"/>
                        </RelativeLayout>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/datausage_devide_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <RelativeLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@+id/day_to_settlement_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/day_to_settlement_data_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/data_usage_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/day_to_settlement"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/data_usage_unit_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/day_to_settlement_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"
                                    android:text="@string/data_usage_settlement_unit_title"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/selected_text_color"
                                android:id="@+id/day_to_settlement_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxWidth="80dp"
                                android:text="@string/data_usage_settlement_title"
                                android:maxLines="2"
                                android:layout_below="@+id/day_to_settlement_data_line"
                                android:layout_alignLeft="@+id/day_to_settlement_data_line"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/extra_data_line"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:layout_below="@+id/common_data_line"
                        android:layout_centerHorizontal="true">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/data_usage_4G_left_view"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/data_usage_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/data_usage_4G_left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/data_usage_unit_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/data_usage_4G_left_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/selected_text_color"
                                android:id="@+id/data_4G_left_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:maxWidth="90dp"
                                android:text="@string/data_4G_left_title"
                                android:maxLines="2"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/spare_time_left_view"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/data_usage_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/spare_time_left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/data_usage_unit_font_size_3"
                                    android:textStyle="bold"
                                    android:textColor="@color/selected_text_color"
                                    android:id="@+id/spare_time_left_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="@color/selected_text_color"
                                android:id="@+id/data_spare_time_left_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:maxWidth="90dp"
                                android:text="@string/data_spare_time_left_title"
                                android:maxLines="2"/>
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </obric.widget.ListContentItemText>
            <TextView
                android:textSize="18sp"
                android:gravity="center"
                android:id="@+id/item_datausage_correcting"
                android:visibility="gone"
                android:text="@string/datausage_correcting_title"
                android:layout_below="@+id/head_area"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.ListContentItemText
                android:id="@+id/item_recharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:title="@string/btn_recharge_flow"
                style="@style/ListContentItemStyle.Top"/>
            <obric.widget.ListContentItemText
                android:id="@+id/item_data_usage_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/data_usage_alarm"
                style="@style/ListContentItemStyle.Mid"/>
            <obric.widget.ListContentItemText
                android:id="@+id/item_data_usage_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/datausage_sort_title"
                style="@style/ListContentItemStyle.Bottom"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.ListContentItemSwitch
                android:id="@+id/network_optimization_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:smtTitle="@string/network_background_control"
                style="@style/ListContentItemStyle.Top"/>
            <obric.widget.ListContentItemText
                android:id="@+id/network_optimization_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/network_background_detail_settings"
                style="@style/ListContentItemStyle.Bottom"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</LinearLayout>
