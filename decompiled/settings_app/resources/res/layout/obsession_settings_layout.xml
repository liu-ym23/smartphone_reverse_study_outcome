<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/obsession_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_id_display_power"
                app:oui_list_item_title="@string/accessibility_item_battery_percentage"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_display_charge_time"
                android:visibility="gone"
                app:smtTitle="@string/obsession_display_charge_remain_time"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_display_large_battery"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/item_block_gap"
                app:smtTitle="@string/display_large_battery_in_lockscreen"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/show_network_speed"
                android:visibility="gone"
                app:smtTitle="@string/show_network_speed"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:id="@+id/show_network_speed_gap_below"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_hide_label"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/item_block_gap"
                app:smtTitle="@string/obsession_hide_lable"
                style="@style/SettingSubItemSingleStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/hide_badge_setting_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_id_hide_badge"
                    app:smtTitle="@string/obsession_hide_badge"
                    style="@style/SettingSubItemTopStyle"/>
                <ImageView
                    android:id="@+id/illustration_hide_badge_img"
                    android:background="@drawable/illustration_hide_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/badge_swipe_clean_setting_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/item_id_badge_swipe_clean"
                    app:smtTitle="@string/obsession_badge_swipe_clean"
                    style="@style/SettingSubItemTopStyle"/>
                <ImageView
                    android:id="@+id/illustration_badge_swipe_clean_img"
                    android:background="@drawable/illustration_badge_swipe_clean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </LinearLayout>
            <include layout="@layout/one_hand_settings_item_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_id_hide_axis"
                android:visibility="gone"
                app:oui_list_item_title="@string/player_axis_enabled"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
