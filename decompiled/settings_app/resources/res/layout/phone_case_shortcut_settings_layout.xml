<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/phone_case_key_setting_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.widget.CustomExpandableLinearLayout
                android:id="@+id/id_shortcut_tool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:expandType="1"
                setting:title="@string/phone_case_shortcut_tools_title"/>
            <com.android.settings.widget.CustomExpandableLinearLayout
                android:id="@+id/id_shortcut_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:title="@string/phone_case_shortcut_operations_title"/>
            <com.android.settings.widget.CustomExpandableLinearLayout
                android:id="@+id/id_shortcut_accessibility"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:title="@string/phone_case_shortcut_accessibility_title"/>
            <com.android.settings.widget.CustomExpandableLinearLayout
                android:id="@+id/id_shortcut_application"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:expandType="2"
                setting:title="@string/phone_case_shortcut_applications_title"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
