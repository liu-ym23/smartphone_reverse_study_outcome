<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/search_bar_with_line_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="13.5sp"
        android:textColor="@color/topbar_text_color"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/activate_dlg_negative"
        android:layout_alignParentRight="true"/>
    <TextView
        android:id="@+id/searchbar_left_tv"
        android:background="@drawable/searchbar_left"
        android:layout_width="180dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/searchbar_right_tv"
        android:background="@drawable/searchbar_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/searchbar_left_tv"/>
    <LinearLayout
        android:id="@+id/searchbar_edit_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="39dp">
        <EditText
            android:textSize="13.5sp"
            android:textColor="@color/setting_item_text_color"
            android:gravity="center_vertical"
            android:id="@+id/edit"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:saveEnabled="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:cursorVisible="false"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/edittext_cursor_bbackground"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_edit_clear"
            android:background="@drawable/search_clear"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"/>
    </LinearLayout>
</RelativeLayout>
