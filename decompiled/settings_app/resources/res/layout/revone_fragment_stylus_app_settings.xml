<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/launch_specified_app"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <RelativeLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/list_item_vertical_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/options_list"
                style="@style/ListViewGeneralStyle"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
        </RelativeLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/setting_item_tips_color"
        android:gravity="center"
        android:id="@+id/view_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/application_manager_empty_view_text"
        android:layout_below="@+id/view_title"
        style="@style/SettingItemTextShadowStyle"/>
</RelativeLayout>
