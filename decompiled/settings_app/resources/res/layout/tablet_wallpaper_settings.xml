<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/wallpaper_pager_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.SettingItemTextVertical
                android:id="@+id/item_id_origin_launcher_wp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/wallpaper_settings_item_height"
                setting:arrow="@drawable/secletor_setting_item_arrow"
                setting:icon="@drawable/revone_preview_classic"
                setting:iconFrame="@drawable/revone_thumbnail_bg"
                setting:singleLine="false"
                setting:subTitle="@string/launcher_system_wallpaper_subtitle"
                setting:title="@string/system_wallpaper_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.SettingItemTextVertical
                android:id="@+id/item_id_history_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/wallpaper_settings_item_height"
                setting:arrow="@drawable/secletor_setting_item_arrow"
                setting:icon="@drawable/revone_preview_customize"
                setting:iconFrame="@drawable/revone_thumbnail_bg"
                setting:singleLine="false"
                setting:subTitle="@string/history_launcher_wallpaper_subtitle"
                setting:title="@string/customize_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/switch_wallpaper"
                android:title="@string/slide_desktop_change_wallpaper_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
