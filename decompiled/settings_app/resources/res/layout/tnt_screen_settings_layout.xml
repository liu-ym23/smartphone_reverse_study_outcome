<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/screen_pager_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.ListContentItemCustom
                android:id="@+id/brightness_seek_bar_custom_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SettingSubItemSingleStyle">
                <obric.widget.SliderWithIcons
                    android:id="@+id/brightness_seekbar"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:left_icon_src="@drawable/brightness_min"
                    app:right_icon_src="@drawable/brightness_max"/>
            </obric.widget.ListContentItemCustom>
            <include
                android:id="@+id/brightness_gap"
                android:visibility="gone"
                layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/item_auto_lock_screen_time"
                app:oui_list_item_title="@string/security_auto_lock_time"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_screen_color"
                android:visibility="gone"
                android:title="@string/color_profiles_title"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_protect_eyes"
                android:title="@string/protect_eyes_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include
                android:id="@+id/protect_eyes_vertical_gap_layout"
                layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/switch_read_mode"
                android:visibility="gone"
                android:title="@string/read_mode_title"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/switch_read_mode_tips"
                android:visibility="gone"
                android:text="@string/read_mode_tips"
                style="@style/SettingItemTipsStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_font_scale"
                android:visibility="gone"
                android:title="@string/font_size"
                style="@style/SettingSubItemSingleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/item_dpi_settings"
                android:title="@string/dpi_settings_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:id="@+id/id_2k_display_title"
                android:visibility="gone"
                android:text="@string/two_thousand_resolution_display"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.ListContentItemCheck
                android:id="@+id/id_2k_display_1080p"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/resolution_display_one_thousand"
                style="@style/ListContentItemStyle.Top"/>
            <obric.widget.ListContentItemCheck
                android:id="@+id/id_2k_display_2k"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/resolution_display_two_thousand"
                style="@style/ListContentItemStyle.Bottom"/>
            <include
                android:id="@+id/id_2k_display_gap"
                android:visibility="gone"
                layout="@layout/group_list_item_vertical_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
