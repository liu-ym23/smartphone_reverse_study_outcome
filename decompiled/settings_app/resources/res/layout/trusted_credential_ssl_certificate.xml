<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/Transparent"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:layout_marginHorizontal="32dp"
            app:sectionTitle_titleText="@string/issued_to"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/to_common_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/common_name"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/to_org_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_middle"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/org_name"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/to_org_unit_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_middle"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/org_unit"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/serial_number_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/serial_number"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="32dp"
            app:sectionTitle_titleText="@string/issued_by"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/by_common_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/common_name"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/by_org_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_middle"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/org_name"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/by_org_unit_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/org_unit"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="32dp"
            app:sectionTitle_titleText="@string/validity_period"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/issued_on_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/issued_on"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/expires_on_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/expires_on"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/fingerprints"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="32dp"
            app:sectionTitle_titleText="@string/fingerprints"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/sha256_fingerprint_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/sha256_fingerprint"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/sha1_fingerprint_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_defaultCustomEnd="end_detail"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_showDivider="false"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/sha1_fingerprint"/>
    </LinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
