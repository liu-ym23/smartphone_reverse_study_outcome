<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.settings.wifi.scanner.ScannerContainerView
        android:id="@+id/scanner_page"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.settings.wifi.scanner.AutoFitSurfaceView
            android:id="@+id/barcode_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.settings.wifi.scanner.ScannerMaskView
            android:id="@+id/scanner_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:capture_height="248dp"
            app:capture_left="56dp"
            app:capture_top="240dp"
            app:capture_width="248dp"
            app:real_capture_height="360dp"
            app:real_capture_left="0dp"
            app:real_capture_top="180dp"
            app:real_capture_width="360dp"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_on_dark_text_1"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/barcode_scan_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="284dp"
            android:text="@string/barcode_scan_hint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ScannerHintText"/>
        <com.obric.oui.button.OIconButtonFloating
            android:layout_gravity="end|top"
            android:id="@+id/exit_barcode_scan"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="@dimen/dimen_12"
            app:oui_widgetIcon="@drawable/osui_ic_cross"
            style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oui_title_bar_height"
            android:paddingStart="@dimen/dimen_48"
            android:paddingEnd="@dimen/dimen_48"/>
    </com.android.settings.wifi.scanner.ScannerContainerView>
    <com.android.settings.wifi.scanner.ScannerContainerView
        android:id="@+id/inactive_page"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12.5sp"
            android:textColor="@color/oui_on_dark_text_1"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wake_up_screen"
            android:drawablePadding="28dp"
            android:textAlignment="center"
            app:drawableTopCompat="@drawable/osui_ic_scan_inactive"/>
    </com.android.settings.wifi.scanner.ScannerContainerView>
</androidx.constraintlayout.widget.ConstraintLayout>
