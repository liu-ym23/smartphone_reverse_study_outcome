<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/anim_layer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/guide_anim_view"
            android:layout_width="60dp"
            android:layout_height="100dp"
            app:lottie_rawRes="@raw/lottie_ai_button_fingerprint_enroll_guide"
            app:lottie_repeatCount="-1"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/init_layer"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <ImageView
            android:id="@+id/intro_view"
            android:layout_width="5dp"
            android:layout_height="60dp"
            android:src="@drawable/ai_key_guide_introduction_icon"/>
    </FrameLayout>
</RelativeLayout>
