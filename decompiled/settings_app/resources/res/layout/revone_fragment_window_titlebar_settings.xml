<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/window_pager_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.ListContentItemSwitch
                android:id="@+id/id_window_title_bar_mode_auto"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/window_title_bar_mode_auto"
                style="@style/ListContentItemStyle.Single"/>
            <TextView
                android:id="@+id/id_mode_auto_tips_view"
                android:visibility="gone"
                android:text="@string/window_title_bar_style_auto_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:id="@+id/id_window_title_bar_mode_manual"
                android:text="@string/window_title_bar_style"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.ListContentItemCheck
                android:id="@+id/id_style_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/window_title_bar_style_top"
                style="@style/ListContentItemStyle.Top"/>
            <obric.widget.ListContentItemCheck
                android:id="@+id/id_style_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/window_title_bar_style_bottom"
                style="@style/ListContentItemStyle.Bottom"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:id="@+id/id_window_title_bar_video_intro"
                android:text="@string/window_title_bar_video_intro"
                style="@style/SettingItemTitleStyle"/>
            <FrameLayout
                android:id="@+id/video_layout"
                android:paddingTop="@dimen/tutorial_video_padding"
                android:paddingBottom="@dimen/tutorial_video_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/tutorial_video_padding"
                android:paddingEnd="@dimen/tutorial_video_padding"
                style="@style/SettingSubItemSingleStyle">
                <VideoView
                    android:layout_gravity="center"
                    android:id="@+id/video_view"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"/>
                <View
                    android:id="@+id/video_background"
                    android:background="@android:color/white"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/video_default"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"
                    android:src="@drawable/window_tutorial_background"/>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
