<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/speech_reading"
                android:visibility="gone"
                app:oui_list_item_title="@string/accessibility_speech_reading"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/speech_tips"
                android:visibility="gone"
                android:text="@string/accessibility_speech_reading_enable_tips"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/screen_magnification"
                app:ocardlistitem_title="@string/accessibility_screen_magnification"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/large_pointer_icon"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/accessibility_large_pointer_icon"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/color_correction"
                app:ocardlistitem_title="@string/accessibility_color_correction"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/text_high_contrast"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_subTitle="@string/accessibility_text_high_contrast_summary"
                app:ocardlistitem_title="@string/accessibility_text_high_contrast"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/color_inversion"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_subTitle="@string/accessibility_color_inversion_summary"
                app:ocardlistitem_title="@string/accessibility_color_inversion"
                style="@style/OCardListItemSwitchSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/speak_password"
                android:visibility="gone"
                app:ocardlistitem_title="@string/accessibility_speak_password"
                style="@style/OCardListItemTextMid"/>
            <include
                android:id="@+id/shadow_below_speak_password"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/accessibility_blind_mode"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
