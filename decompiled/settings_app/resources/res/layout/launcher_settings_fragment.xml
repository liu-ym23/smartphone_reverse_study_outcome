<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemText
                android:id="@+id/bytedance_desktop_enable"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                setting:smtTitle="@string/bytedance_desktop_enable"
                style="@style/SettingItemSingleStyle"/>
            <TextView
                android:id="@+id/bytedance_launcher_mode_title"
                android:text="@string/launcher_mode_summary"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.LauncherPreview
                android:id="@+id/id_launcher_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_block_gap"/>
            <include
                android:id="@+id/multi_block_viewstub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/launcher_multi_block_options"/>
            <include
                android:id="@+id/laucher_theme_viewstub"
                layout="@layout/launcher_settings_theme"/>
            <include
                android:id="@+id/launcher_theme_bottom_gap"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_icon_illumination"
                android:visibility="gone"
                setting:smtTitle="@string/icon_illumination"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/icon_illumination_tips"
                android:visibility="gone"
                android:text="@string/icon_illumination_tips"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/original_launcher_blur_switch"
                android:visibility="gone"
                android:layout_marginTop="@dimen/item_block_gap"
                setting:smtTitle="@string/original_launcher_blur_switch_title"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/item_id_hide_lable"
                setting:smtTitle="@string/obsession_hide_lable"
                style="@style/SettingSubItemTopStyle"/>
            <include
                android:id="@+id/hide_lable_bottom_gap"
                layout="@layout/item_bottom_shadow_layout"/>
            <include
                android:id="@+id/launcher_settings_switcher_viewstub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/launcher_settings_switcher_layout"/>
            <com.android.settings.widget.VerticalOptionsCheckView
                android:id="@+id/id_launcher_setting_docker_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</LinearLayout>
