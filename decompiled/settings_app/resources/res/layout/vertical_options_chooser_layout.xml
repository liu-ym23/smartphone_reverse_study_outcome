<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dock_flip_view"
    android:paddingBottom="@dimen/settings_item_top_bottom_margin"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/title"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.ListContentItemCustom
        android:id="@+id/top_option"
        android:layout_width="match_parent"
        android:layout_height="243.3dp"
        isPressable="false"
        style="@style/SettingSubItemTopStyle">
        <ImageView
            android:id="@+id/top_preview"
            android:duplicateParentState="true"
            android:layout_width="@dimen/launcher_dock_slide_image_width"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/top_check_icon"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginRight="23.3dp"
            android:src="@drawable/vertical_option_check_bg"
            android:layout_alignTop="@+id/top_preview"
            android:layout_alignParentRight="true"/>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom
        android:id="@+id/middle_option"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="243.3dp"
        isPressable="false"
        style="@style/SettingSubItemMidStyle">
        <ImageView
            android:id="@+id/middle_preview"
            android:duplicateParentState="true"
            android:layout_width="@dimen/launcher_dock_slide_image_width"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/middle_check_icon"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginRight="23.3dp"
            android:src="@drawable/vertical_option_check_bg"
            android:layout_alignTop="@+id/middle_preview"
            android:layout_alignParentRight="true"/>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom
        android:id="@+id/bottom_option"
        android:layout_width="match_parent"
        android:layout_height="243.3dp"
        isPressable="false"
        style="@style/SettingSubItemBottomStyle">
        <ImageView
            android:id="@+id/bottom_preview"
            android:duplicateParentState="true"
            android:layout_width="@dimen/launcher_dock_slide_image_width"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/bottom_check_icon"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginRight="23.3dp"
            android:src="@drawable/vertical_option_check_bg"
            android:layout_alignTop="@+id/bottom_preview"
            android:layout_alignParentRight="true"/>
    </obric.widget.ListContentItemCustom>
</LinearLayout>
