<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:paddingTop="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sim_guide_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/sim_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/item_bottom_shadow_layout"/>
    </LinearLayout>
    <obric.widget.ListContentItemSwitch
        android:id="@+id/data_usage_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:smtTitle="@string/data_usage_alarm"
        style="@style/ListContentItemStyle.Top"/>
    <obric.widget.ListContentItemText
        android:id="@+id/data_usage_limit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/data_usage_limit"
        app:smtTitle="@string/data_usage_limit_unset"
        style="@style/ListContentItemStyle.Bottom"/>
    <TextView
        android:id="@+id/data_usage_limit_tips"
        android:layout_marginTop="6dp"
        android:text="@string/data_usage_limit_tips"
        style="@style/SettingItemTipsStyle"/>
    <TextView
        android:id="@android:id/empty"
        android:text="@string/application_manager_empty_view_text"
        style="@style/SettingItemTipsStyle"/>
    <obric.widget.ListContentItemText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Top">
        <com.android.settings.widget.DataUsageCycleView
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cycle_view"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_today"
                android:background="@drawable/power_usage_cycle_view_normal_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_today"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_week"
                android:background="@drawable/power_usage_cycle_view_normal_mid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_week"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/lock_screen_header_normal_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_month"
                android:background="@drawable/power_usage_cycle_view_normal_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_month"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
        </com.android.settings.widget.DataUsageCycleView>
    </obric.widget.ListContentItemText>
</LinearLayout>
