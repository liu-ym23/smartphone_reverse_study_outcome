<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:id="@+id/head_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemText
        android:layout_width="match_parent"
        android:layout_height="120.8dp"
        android:layout_marginTop="12.5dp"
        style="@style/ListContentItemStyle.Single">
        <TextView
            android:textSize="13.5sp"
            android:textColor="@color/security_header_selected_text_color"
            android:id="@+id/selected_text_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="12dp"
            android:text="@string/running_process_has_selected"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/selected_size_contain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/selected_text_tip"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/security_header_selected_size_color"
                android:id="@+id/selected_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/security_header_selected_size_color"
                android:id="@+id/selected_size_unit"
                android:paddingLeft="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/clean_done_contain"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/security_header_selected_size_color"
                android:layout_gravity="center"
                android:id="@+id/clean_done_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="31dp"
                android:src="@drawable/clean_accomplish"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/security_header_selected_text_color"
                android:layout_gravity="center"
                android:id="@+id/clean_done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/clean_processes_done"/>
        </LinearLayout>
    </obric.widget.ListContentItemText>
    <TextView
        android:gravity="center"
        android:id="@+id/used_total_size"
        android:paddingLeft="28.5dp"
        android:paddingTop="3dp"
        android:paddingRight="28.5dp"
        android:layout_marginBottom="20dp"
        android:text="@string/running_processes_header_memory_free_prefix"
        android:maxLines="1"
        style="@style/SettingItemTipsStyle"/>
</LinearLayout>
