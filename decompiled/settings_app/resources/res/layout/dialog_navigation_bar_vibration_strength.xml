<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="@dimen/settings_item_top_bottom_margin"
    android:paddingRight="8dp"
    android:paddingBottom="@dimen/settings_item_top_bottom_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_duration_min"/>
        <TextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/vibration_duration_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vibration_duration"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_duration_max"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_duration_short"/>
        <SeekBar
            android:id="@+id/vibration_duration_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_duration_long"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_strength_min"/>
        <TextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/vibration_strength_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vibration_strength"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_strength_max"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_weak"/>
        <SeekBar
            android:id="@+id/vibration_strength_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_strong"/>
    </LinearLayout>
</LinearLayout>
