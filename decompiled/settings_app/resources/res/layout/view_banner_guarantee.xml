<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/main_bg"
        android:background="@drawable/guarantee_state_out_bg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="20dp"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_1"
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/guarantee_card"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="@+id/main_bg"
        app:layout_constraintTop_toTopOf="@+id/main_bg"
        style="@style/Title_3_Medium"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_3"
        android:id="@+id/device_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/card"
        app:layout_constraintTop_toBottomOf="@+id/card"
        style="@style/Label_M_Thin"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_1"
        android:id="@+id/imei_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_bg"
        app:layout_constraintEnd_toEndOf="@+id/main_bg"
        style="@style/Subtitle_3_Medium"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_3"
        android:id="@+id/imei_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="IMEI"
        app:layout_constraintBottom_toTopOf="@+id/imei_tv"
        app:layout_constraintStart_toStartOf="@+id/imei_tv"
        style="@style/Subtitle_2_Regular"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_1"
        android:id="@+id/expired_date"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/main_bg"
        app:layout_constraintStart_toStartOf="@+id/card"
        style="@style/Subtitle_3_Medium"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_3"
        android:id="@+id/expired_date_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/expired_date_title"
        app:layout_constraintBottom_toTopOf="@+id/expired_date"
        app:layout_constraintStart_toStartOf="@+id/expired_date"
        style="@style/Subtitle_2_Regular"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_dark_basic_text_3"
        android:gravity="center"
        android:id="@+id/state_tv"
        android:background="@drawable/expired_state_text_on_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="@+id/main_bg"
        app:layout_constraintTop_toTopOf="@+id/main_bg"
        style="@style/Subtitle_2_Regular"/>
    <com.obric.oui.progress.ODownloadProgressView
        android:id="@+id/loading_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_bg"
        app:layout_constraintStart_toStartOf="@+id/main_bg"
        app:oui_progress_view_size="small"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/error_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/network_error_new"
        app:layout_constraintBottom_toBottomOf="@+id/main_bg"
        app:layout_constraintStart_toStartOf="@+id/main_bg"
        style="@style/Label_L"/>
</androidx.constraintlayout.widget.ConstraintLayout>
