<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="112dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/see_messages_section_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/enterprise_privacy_exposure_category"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_exposure_category"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_enterprise_data"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_apps"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_installed_packages"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_usage_stats"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_usage_stats"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_network_logs"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_network_logs"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_bug_reports"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_bug_reports"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_security_logs"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_security_logs"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/exposure_changes_section_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/enterprise_privacy_exposure_changes_category"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_installed_packages"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/enterprise_privacy_enterprise_installed_packages"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_location_access"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/enterprise_privacy_location_access"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_microphone_access"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/enterprise_privacy_microphone_access"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_camera_access"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/enterprise_privacy_camera_access"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_set_default_apps"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_enterprise_set_default_apps"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_vpn_always_on_personal"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_always_on_vpn_personal"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_vpn_always_on_work"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_always_on_vpn_work"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_input_method"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_input_method"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_global_http_proxy"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_global_http_proxy"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_ca_certs_personal"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_ca_certs_personal"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_ca_certs_work"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_ca_certs_work"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/device_access_section_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/enterprise_privacy_device_access_category"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_lock_device"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_lock_device"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_wipe_device"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_wipe_device"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_failed_password_wipe_device"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_failed_password_wipe_device"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_failed_password_wipe_work"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/enterprise_privacy_failed_password_wipe_work"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/header_section_title"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:section_des_text="@string/enterprise_privacy_header"
                style="@style/OSectionSupportive.Text"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/enterprise_privacy_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
