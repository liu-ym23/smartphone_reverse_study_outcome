<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@drawable/setting_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/bingding_clound_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/cloud_binding_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/smiling_cloud_margin_top"
        android:layout_below="@+id/bingding_clound_title"
        android:layout_centerHorizontal="true">
        <obric.widget.ListContentItemCustom
            android:gravity="center"
            android:id="@+id/cloud_logo_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ListContentItemStyle.Single">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/cloud_logo"
                    android:background="@drawable/cloud_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/description_unlogin_text_size"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/login_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="173dp"
                    android:layout_alignTop="@+id/cloud_logo"/>
            </RelativeLayout>
        </obric.widget.ListContentItemCustom>
        <TextView
            android:textSize="@dimen/description_text_size_small"
            android:textColor="@color/cloud_binding_color"
            android:gravity="left"
            android:id="@+id/cloud_binding_des"
            android:paddingLeft="@dimen/description_text_left"
            android:paddingRight="@dimen/description_text_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/image_margin_top"
            android:text="@string/cloud_description_content"
            android:maxLines="5"
            android:layout_below="@+id/cloud_logo_image"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="@dimen/description_text_line_space"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/btnLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/btnLayout_marginBottom"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.obric.oui.button.OButton
            android:id="@+id/binding_clound"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/register_btn_padding_top"
            android:text="@string/cloud_binding_button"
            style="@style/LongButton.Highlight"/>
    </RelativeLayout>
</RelativeLayout>
