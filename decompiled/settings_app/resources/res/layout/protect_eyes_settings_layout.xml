<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/protect_eyes_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/protect_eyes_summary_off"
                app:ocardlistitem_title="@string/protect_eyes_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/auto_turn_on_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/auto_turn_on_off_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/rhythmic_eye_protection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/rhythmic_eye_protection_tips"
                app:ocardlistitem_title="@string/rhythmic_eye_protection_title"/>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:id="@+id/temperature_container"
                android:background="@drawable/radius_20_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_12"
                android:paddingVertical="@dimen/dimen_8"
                app:oui_radius="@dimen/dimen_20">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/main_title_element"
                    android:paddingTop="@dimen/dimen_12"
                    android:paddingBottom="@dimen/dimen_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <RelativeLayout
                        android:paddingLeft="@dimen/dimen_20"
                        android:paddingRight="@dimen/dimen_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.text.OTextView
                            android:textStyle="bold"
                            android:textColor="@color/oui_text_1"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_content_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:text="@string/color_temperature_adjustment_title"
                            android:layout_alignParentLeft="true"
                            android:layout_toStartOf="@+id/btn_default"
                            android:layout_marginVertical="@dimen/dimen_5dp"
                            style="@style/Title_1_Regular"/>
                        <com.obric.oui.button.OButton
                            android:id="@+id/btn_default"
                            android:layout_marginLeft="@dimen/dimen_8"
                            android:text="@string/color_temperature_default_btn"
                            android:layout_alignParentRight="true"
                            style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
                    </RelativeLayout>
                    <com.obric.oui.slider.SeekBarFloatCompat
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/color_temperature_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="@dimen/dimen_6"
                        android:progressDrawable="@drawable/ic_colorful_seekbar_background"
                        android:layout_marginHorizontal="@dimen/dimen_8"/>
                </LinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/protect_eyes_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
