<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/id_navbar_mode_setting_title"
        android:text="@string/phone_case_shortcut_keys_layout"
        style="@style/SettingItemTitleStyle"/>
    <RelativeLayout
        android:id="@+id/id_phone_case_showing"
        android:background="@drawable/sub_item_back_ground_single"
        android:layout_width="match_parent"
        android:layout_height="296.5938dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/id_phone_case_preview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:layout_width="@dimen/phone_case_button_text_container_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true">
            <TextView
                android:id="@+id/id_test_tv_1"
                android:text="@string/phone_case_shortcut_bullet_sms"
                style="@style/PhoneCaseButtonTextStyle"/>
            <TextView
                android:id="@+id/id_test_tv_2"
                android:layout_marginTop="1dp"
                android:text="@string/phone_case_shortcut_idea_pills"
                style="@style/PhoneCaseButtonTextStyle"/>
            <TextView
                android:id="@+id/id_test_tv_3"
                android:layout_marginTop="1dp"
                android:text="@string/phone_case_shortcut_search"
                style="@style/PhoneCaseButtonTextStyle"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
