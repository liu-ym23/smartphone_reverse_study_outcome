<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fp_illustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.widget.FrontFingerprintAnimView
                android:layout_gravity="center"
                android:id="@+id/fp_anim_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/tip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tips_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enrolling_ai_powered_fp_introduction"
                style="@style/Title_1_Bold"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/introduction_sub_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen_8"
                android:text="@string/enrolling_ai_powered_fp_introduction_sub_title"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textColor="@color/oui_accent_7_fg"
        android:id="@+id/license_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:text="@string/biometrics_fingerprint_license"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:lineHeight="20sp"
        style="@style/Subtitle_3_Medium"/>
    <com.android.settings.widget.AIPoweredFingerprintGuideAnimView
        android:id="@+id/ai_key_guide_anim_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="382dp"
        android:layout_marginRight="8dp"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
