<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/sd_manage"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/external_storage_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_top_margin">
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:paddingLeft="33dp"
                android:paddingTop="26dp"
                android:paddingRight="36dp"
                android:paddingBottom="28dp"
                style="@style/SettingSubItemTopStyle">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/memory_manage_total"
                    android:id="@+id/external_storage_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/memory_manage_total_size_width"
                    android:text="@string/memory_size"
                    android:singleLine="true"
                    android:layout_alignParentLeft="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/memory_manage_total_size"
                    android:id="@+id/external_storage_total_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/memory_manage_total_size_width"
                    android:text="@string/memory_init_size"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/external_storage_total"
                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/memory_manage_total"
                    android:id="@+id/external_storage_free"
                    android:paddingLeft="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/memory_manage_total_size_width"
                    android:text="@string/memory_available"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/external_storage_free_size"
                    android:layout_marginEnd="@dimen/memory_manage_total_margin_right"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/memory_manage_total_size"
                    android:ellipsize="end"
                    android:id="@+id/external_storage_free_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/memory_manage_total_size_width"
                    android:text="@string/memory_init_size"
                    android:singleLine="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                <com.android.settings.deviceinfo.StorageProgressBar
                    android:id="@+id/storage_progess_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:layout_below="@+id/external_storage_total_size"/>
            </RelativeLayout>
            <obric.widget.SettingItemText
                android:id="@+id/sd_file_storage_detail"
                android:title="@string/sd_file_manage"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.android.settings.widget.DisableTipsButton
                android:gravity="center"
                android:id="@+id/unmount_external_storage"
                android:background="@drawable/selector_setting_sub_item_bg_top"
                android:text="@string/unmount_external_storage"
                style="@style/ButtonGeneralStyle"/>
            <com.android.settings.widget.DisableTipsButton
                android:gravity="center"
                android:id="@+id/erase_external_storage"
                android:background="@drawable/selector_setting_sub_item_bg_bottom"
                android:text="@string/format_external_storage"
                style="@style/ButtonGeneralStyle"/>
            <include
                android:id="@+id/gap"
                layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/phone_desktop_connect"
                android:visibility="gone"
                android:text="@string/phone_desktop_connect"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/default_storage_path"
                android:title="@string/default_storage_path_settings"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:text="@string/default_storage_path_settings_tips"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
