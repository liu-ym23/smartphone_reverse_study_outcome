<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/wifi_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/activate_wifi"
        style="@style/GroupListSectionTitleStyle"/>
    <TextView
        android:id="@+id/wifi_state_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/GroupListTipsViewStyle"/>
    <TextView
        android:textColor="@color/oui_text_1"
        android:gravity="center"
        android:id="@+id/titlebar_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="92dp"
        android:text="@string/app_name"
        style="@style/Title_Display"/>
</LinearLayout>
