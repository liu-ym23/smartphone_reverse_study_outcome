<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/list_item_land_container_width"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/high_priority_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/system_notification_high_priority_notification_tips"
                app:ocardlistitem_title="@string/system_notification_high_priority_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lock_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/lock_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lock_show_sensitive_notification"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/system_notification_show_sensitive_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lock_screen_message_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/owner_info_settings_summary"
                app:ocardlistitem_title="@string/owner_info_settings_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/lockscreen_trivial_controls_switch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/lockscreen_trivial_controls_summary"
                app:ocardlistitem_title="@string/lockscreen_trivial_controls_setting_toggle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/launcher_badge_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/system_notification_launcher_badge_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/status_bar_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/status_bar_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/game_time_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/game_time_notification"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/notification_launch_freeform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/notification_launch_freeform_summary"
                app:ocardlistitem_title="@string/notification_launch_freeform_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/system_notification_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/system_notification_banner"/>
            <FrameLayout
                android:id="@+id/conversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:sectionTitle_titleText="@string/system_notification_app_notification_configuration"
                style="@style/OSectionTitleBar.S"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
