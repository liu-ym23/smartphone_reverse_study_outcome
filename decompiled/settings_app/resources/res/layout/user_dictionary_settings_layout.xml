<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OListView
        android:id="@+id/user_dictionary_list"
        android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
        android:layout_below="@+id/view_title"
        style="@style/ListViewGeneralStyle"/>
    <TextView
        android:textSize="@dimen/list_empty_view_summary_text_size"
        android:textColor="@color/list_empty_view_text_color"
        android:gravity="center"
        android:id="@android:id/empty"
        android:paddingLeft="@dimen/common_horizontal_padding"
        android:paddingRight="@dimen/common_horizontal_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/user_dict_empty_tips"
        android:layout_below="@+id/view_title"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/language_keyboard_item_text_user_dictionary"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
