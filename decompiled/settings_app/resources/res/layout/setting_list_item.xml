<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/setting_item"
    android:background="@drawable/setting_item_backgroud_card"
    android:paddingRight="@dimen/oui_g_list_item_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    app:oui_radius="@dimen/oui_r_l3_rect">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/fl_content_element"
        android:visibility="visible"
        android:layout_width="36dp"
        android:layout_height="64dp"
        android:layout_marginEnd="14dp"
        android:layout_marginVertical="@dimen/oui_g_list_item_2">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/iv_content_img_background"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_content_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_view"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="56dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="358dp"
                android:maxLines="1"
                style="@style/Title_Title_M"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_content_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_title_info_img"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_info_button"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tail_contail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_content_tailtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label_L_Thin"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/trailingTips"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/badge_bg"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_content_info_img"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_forward_list_item"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_switch_contain"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.obric.oui.oswitch.OSwitch
            android:layout_gravity="center_vertical"
            android:id="@+id/item_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"/>
    </LinearLayout>
</LinearLayout>
