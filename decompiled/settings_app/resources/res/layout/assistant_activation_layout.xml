<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/frame_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_fingerprint"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/doubao_assistant_menu_fingerprint"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/item_fingerprint_padding"
                layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_ai_key_sensitivity"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/ai_key_sensitivity"
                style="@style/OCardListItemTextSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/wifi_ap_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/ai_key_sensitivity_tips"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                app:sectionTitle_titleText="@string/doubao_assistant_key_sub_title"
                style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_single_click"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/one_click"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_double_click"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/double_click"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ai_key_when_screen_off"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_title="@string/doubao_assistant_key_enable_ai_key_when_screen_off"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_bottom_shadow_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/assistant_activation"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
