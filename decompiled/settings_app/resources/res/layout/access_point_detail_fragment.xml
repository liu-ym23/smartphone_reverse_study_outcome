<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:paddingTop="112dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/auto_connect_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/list_item_vertical_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_auto_connect_needLogin_network"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/auto_login_network"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/list_item_vertical_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_auto_authorize_needLogin_network"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/priorit_connect_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_priorit_connect_network"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/priorit_connect_network_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/wifi_priorit_connect_tips"/>
            <View
                android:id="@+id/priorit_connect_network_divider"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_16"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_status_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_status"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_signal_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_signal"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_connection_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_speed"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_security"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_ip_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_ip_address"/>
            <include layout="@layout/group_list_item_vertical_20_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_privacy"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/mac_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_title="@string/wifi_mac_address"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trust_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/ap_trust_network"
                    app:oui_list_item_title="@string/wifi_trust_network"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/ap_trust_network_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_trust_network_tips"
                    style="@style/GroupListTipsViewStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/ap_advanced_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_advanced_options"/>
            <View
                android:id="@+id/ap_advanced_options_divider"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/list_item_vertical_20_gap"/>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:id="@+id/ap_network_sharing"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_1"
                app:oui_radius="20dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/o_background_list_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="24dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/network_sharing_qrcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                    <TextView
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/wifi_network_sharing_tips"
                        android:layout_below="@+id/network_sharing_qrcode"
                        android:layout_marginHorizontal="@dimen/dimen_20"
                        style="@style/Subtitle_2_Regular"/>
                </LinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/disconnect_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/disconnect_btn"
                    app:oui_list_item_title="@string/wifi_menu_disconnect"
                    style="@style/SettingSubItemSingleStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/modify_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/modify_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/apn_edit"/>
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/forget_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.button.OButton
                    android:textColor="@color/oui_functional_red_6"
                    android:id="@+id/forget_btn"
                    android:background="@color/oui_fill_list_item_card"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="@string/wifi_menu_forget"
                    android:layout_marginHorizontal="12dp"
                    app:oui_buttonTextStyle="@style/Button_Password"
                    app:oui_radius="20dp"
                    style="@style/OStyleV2.OButton.S.Standard.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/wifi_dpp_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="86dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
