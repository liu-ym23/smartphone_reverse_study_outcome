<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/perm_icon"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="fitCenter"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/permission_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Title_Title_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:layout_gravity="center_vertical"
            android:id="@+id/permission_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label_M_Thin"/>
        <View
            android:id="@+id/permission_list_divider"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
    </LinearLayout>
</RelativeLayout>
