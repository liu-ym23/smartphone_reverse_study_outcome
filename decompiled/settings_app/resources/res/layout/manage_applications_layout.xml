<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.settings.widget.SettingsListView
        android:id="@+id/listView"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        style="@style/ListViewGeneralStyle"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_application"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/setting_item_tips_color"
        android:gravity="center"
        android:id="@+id/view_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/application_manager_empty_view_text"
        style="@style/SettingItemTextShadowStyle"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/preferred_empty"
        android:visibility="gone"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/settings_item_title_left_margin"
        android:layout_marginRight="@dimen/settings_item_title_left_margin"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/list_empty_view_title_text_size"
            android:textColor="@color/list_empty_view_text_color"
            android:gravity="center"
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preferred_app_empty_title"/>
        <TextView
            android:textSize="@dimen/list_empty_view_summary_text_size"
            android:textColor="@color/list_empty_view_text_color"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            android:text="@string/preferred_app_empty_summary"
            android:layout_below="@+id/empty_title"/>
    </RelativeLayout>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
