<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:paddingTop="112dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/type"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_16"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_cardType="type_container"
                    app:ocardlistitem_customStart="@layout/layout_normal_input_card"
                    app:ocardlistitem_showCustomEnd="false"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/security"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_chevron"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_title="@string/wifi_security"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/security_fields"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/eap"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_title="@string/wifi_eap_method"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/l_sim_card_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/l_sim_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_bottom"
                            app:ocardlistitem_cardType="type_normal"
                            app:ocardlistitem_defaultCustomEnd="end_detail"
                            app:ocardlistitem_defaultTailIcon="tail_chevron"
                            app:ocardlistitem_showCustomEnd="true"
                            app:ocardlistitem_showTailIcon="true"
                            app:ocardlistitem_title="@string/select_sim_card"/>
                        <include layout="@layout/group_list_item_vertical_gap_layout_small"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/phase2_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/phase2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_normal"
                            app:ocardlistitem_defaultCustomEnd="end_detail"
                            app:ocardlistitem_defaultTailIcon="tail_chevron"
                            app:ocardlistitem_showCustomEnd="true"
                            app:ocardlistitem_showTailIcon="true"
                            app:ocardlistitem_title="@string/please_select_phase2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ca_cert_container"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/ca_cert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_normal"
                            app:ocardlistitem_defaultCustomEnd="end_detail"
                            app:ocardlistitem_defaultTailIcon="tail_chevron"
                            app:ocardlistitem_showCustomEnd="true"
                            app:ocardlistitem_showTailIcon="true"
                            app:ocardlistitem_title="@string/wifi_eap_ca_cert"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/no_ca_cert_warning"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/red"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_do_not_validate_eap_server_warning"
                            style="@style/GroupListTipsViewStyle"/>
                        <include layout="@layout/group_list_item_vertical_gap_layout"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/user_cert_container"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/user_cert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_normal"
                            app:ocardlistitem_defaultCustomEnd="end_detail"
                            app:ocardlistitem_defaultTailIcon="tail_chevron"
                            app:ocardlistitem_showCustomEnd="true"
                            app:ocardlistitem_showTailIcon="true"
                            app:ocardlistitem_title="@string/wifi_eap_user_cert"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/l_domain"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/domain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_container"
                            app:ocardlistitem_customStart="@layout/layout_normal_input_card"
                            app:ocardlistitem_showCustomEnd="false"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/no_domain_warning"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/red"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_no_domain_warning"
                            style="@style/GroupListTipsViewStyle"/>
                        <include layout="@layout/group_list_item_vertical_gap_layout_small"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/l_identity"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/identity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_container"
                            app:ocardlistitem_customStart="@layout/layout_normal_input_card"
                            app:ocardlistitem_showCustomEnd="false"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/l_anonymous"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/anonymous"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_container"
                            app:ocardlistitem_customStart="@layout/layout_normal_input_card"
                            app:ocardlistitem_showCustomEnd="false"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/wep_key_index_container"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/wep_key_index"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_title="@string/key_index"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/wapi_psk_type_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/wapi_psk_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_middle"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_title="@string/wifi_wapi_psk_type"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/wapi_cert"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OListItemSettings
                        android:id="@+id/wapi_as_cert"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp"
                        app:oui_list_item_title="@string/wifi_wapi_as_certificate"
                        style="@style/SettingSubItemSingleStyle"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/wapi_user_cert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_bottom"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_title="@string/wifi_wapi_user_certificate"/>
                </LinearLayout>
                <com.obric.widget.SizeChangedLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/password_editor_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_bottom"
                        app:ocardlistitem_cardType="type_container"
                        app:ocardlistitem_customStart="@layout/layout_normal_input_card"
                        app:ocardlistitem_showCustomEnd="false"/>
                </com.obric.widget.SizeChangedLinearLayout>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_privacy"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/wifi_advanced_togglebox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/wifi_advanced_options"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
