<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/title_template"
        android:layout_width="match_parent"
        android:layout_height="@dimen/revone_popupwindow_dialog_title_height"
        android:divider="@drawable/revone_button_dialog_horizontal_divider"
        android:showDividers="end">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/revone_popupwindow_dialog_icon"
            android:paddingTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@null"
            android:paddingEnd="10dp"/>
        <com.android.internal.widget.DialogTitle
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/revone_popupwindow_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/revone_popupwindow_dialog_layout_content"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/revone_popupwindow_dialog_button_height"
        android:divider="@drawable/revone_button_dialog_horizontal_divider"
        android:showDividers="beginning">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/revone_button_dialog_vertical_divider"
            android:measureWithLargestChild="true"
            android:showDividers="middle"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/leftSpacer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"/>
            <Button
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_gravity="start"
                android:id="@+id/revone_popupwindow_dialog_button1"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:id="@+id/revone_popupwindow_dialog_button3"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:id="@+id/revone_popupwindow_dialog_button2"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/rightSpacer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
