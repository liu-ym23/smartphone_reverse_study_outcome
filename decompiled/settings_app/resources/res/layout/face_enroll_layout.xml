<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/face_enroll_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_title">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <SurfaceView
                android:id="@+id/surface_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.android.settings.widget.FaceEnrollProgressView
                android:id="@+id/face_enroll_progress_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"/>
            <ImageView
                android:id="@+id/face_enroll_finish"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="192dp"
                android:src="@drawable/face_enroll_finish"/>
        </RelativeLayout>
        <com.obric.oui.text.OTextView
            android:textStyle="normal"
            android:textColor="@color/oui_text_1"
            android:gravity="center"
            android:id="@+id/face_enroll_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="64dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="16dp"
            android:textFontWeight="500"
            style="@style/Title_Display_S"/>
        <com.obric.oui.text.OTextView
            android:textStyle="normal"
            android:textColor="@color/oui_text_2"
            android:gravity="center"
            android:id="@+id/face_enroll_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="8dp"
            android:textFontWeight="500"
            style="@style/Title_Title_M"/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:textColor="#b3000000"
            android:gravity="center"
            android:id="@+id/face_enroll_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:lineHeight="22dp"/>
    </LinearLayout>
    <com.obric.oui.button.OButton
        android:id="@+id/enroll_finish"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="200dp"
        android:layout_marginBottom="12dp"
        android:text="@string/finish_button"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/OButton.L1.Standard.Primary"/>
</RelativeLayout>
