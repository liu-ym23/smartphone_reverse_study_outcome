<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/dock_pager_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/dock_title_left"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_global_search"
                setting:title="@string/dock_bar_tools_global_search"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_multi_tasks"
                setting:title="@string/dock_bar_tools_multi_tasks"
                style="@style/SettingSubItemBottomStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_recent_files"
                android:visibility="gone"
                setting:title="@string/dock_bar_tools_recent_used"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:text="@string/dock_title_right"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_bing_bang"
                android:visibility="gone"
                setting:title="@string/dock_bar_tools_bing_bang"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_screenshot"
                setting:title="@string/dock_bar_tools_screenshot"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckbox
                android:id="@+id/id_dock_bar_tools_white_pad"
                setting:title="@string/dock_bar_tools_white_pad"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <TextView
                android:id="@+id/id_dock_title_bar_video_intro"
                android:text="@string/dock_title_bar_video_intro"
                style="@style/SettingItemTitleStyle"/>
            <FrameLayout
                android:id="@+id/video_layout"
                android:paddingTop="@dimen/tutorial_video_padding"
                android:paddingBottom="@dimen/tutorial_video_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/tutorial_video_padding"
                android:paddingEnd="@dimen/tutorial_video_padding"
                style="@style/SettingSubItemSingleStyle">
                <VideoView
                    android:layout_gravity="center"
                    android:id="@+id/video_view"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"/>
                <View
                    android:id="@+id/video_background"
                    android:background="@android:color/white"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/video_default"
                    android:layout_width="@dimen/tutorial_video_width"
                    android:layout_height="@dimen/tutorial_video_height"/>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
