<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:background="@drawable/bigbang_anim_bg"
        android:layout_width="@dimen/bigbang_anim_area_width"
        android:layout_height="@dimen/bigbang_anim_area_height"
        android:layout_marginTop="@dimen/bigbang_anim_margin_common"
        android:layout_marginBottom="@dimen/bigbang_anim_margin_common">
        <ImageView
            android:id="@+id/text_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/context"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/middle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/middle"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/circle"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/bigbang_result"
            android:background="@drawable/bigbang_anim_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/square"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gesture"/>
        <ImageView
            android:id="@+id/fore_bg"
            android:background="@drawable/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</merge>
