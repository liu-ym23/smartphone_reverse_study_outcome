<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/settings_list_item_icon_size"
            android:layout_height="@dimen/settings_list_item_icon_size"
            android:layout_marginLeft="@dimen/settings_list_item_gap"
            android:layout_marginRight="@dimen/settings_list_item_icon_margin_right"
            android:scaleType="centerInside"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@android:id/text1"
            android:layout_toRightOf="@android:id/icon"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:ellipsize="end"
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_list_item_icon_margin_right"
            android:layout_marginRight="@dimen/settings_list_item_gap_right"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:ellipsize="end"
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/settings_list_item_gap_right"
            android:singleLine="true"
            android:layout_below="@android:id/title"
            android:layout_alignLeft="@android:id/title"/>
    </RelativeLayout>
</RelativeLayout>
