<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/global_assistant_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/top_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_record_voice_keyphrase"
                android:visibility="gone"
                app:oui_list_item_subtitle="@string/assistant_record_voice_print_summary"
                app:oui_list_item_title="@string/assistant_record_voice_print"
                style="@style/OListItemSettingsStyle"/> /&gt; 
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_voice_wakeup"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                app:oui_list_item_subtitle="@string/assistant_voice_wakeup_summary"
                app:oui_list_item_title="@string/assistant_voice_wakeup"
                style="@style/OListItemSettingsStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_voiceprint_wakeup"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                app:oui_list_item_subtitle="@string/assistant_beta"
                app:oui_list_item_title="@string/assistant_voiceprint_wakeup"
                style="@style/OListItemSettingsStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_voiceprint_recognition"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                app:oui_list_item_subtitle="@string/assistant_beta"
                app:oui_list_item_title="@string/assistant_voiceprint_recognition"
                style="@style/OListItemSettingsStyle"/>
            <TextView
                android:id="@+id/assistant_voiceprint_recognition_tips"
                android:visibility="gone"
                android:text="@string/assistant_voiceprint_recognition_summary"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.ListContentItemText
                android:id="@+id/face_eye_wakeup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/face_eye_wakeup"
                style="@style/ListContentItemStyle.Single"/>
            <obric.widget.ListContentItemSwitch
                android:id="@+id/double_click_wakeup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/double_click_wakeup"
                style="@style/ListContentItemStyle.Single"/>
            <TextView
                android:id="@+id/double_click_wakeup_tips"
                android:visibility="gone"
                android:text="@string/double_click_wakeup_summary"
                style="@style/SettingItemTipsStyle"/>
            <obric.widget.ListContentItemSwitch
                android:id="@+id/fingerprint_wakeup_key"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/fingerprint_wakeup_title"
                style="@style/ListContentItemStyle.Single"/>
            <TextView
                android:id="@+id/fingerprint_wakeup_key_tips"
                android:visibility="gone"
                android:text="@string/fingerprint_wakeup_summary"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_select_model_type_key"
                android:visibility="gone"
                app:oui_list_item_title="@string/assistant_select_model_type_title"
                style="@style/OListItemSettingsStyle"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/idle_exit_key"
                android:visibility="gone"
                app:oui_list_item_title="@string/idle_exit"
                style="@style/OListItemSettingsStyle"/>
            <TextView
                android:visibility="gone"
                android:text="@string/idle_exit_summary"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/assistant_auto_recognition_label"
                android:visibility="gone"
                android:layout_marginTop="20dp"
                app:oui_list_item_title="@string/assistant_auto_recognition_label"
                style="@style/OListItemSettingsStyle"/>
            <TextView
                android:visibility="gone"
                android:text="@string/assistant_auto_recognition_label_subtitle"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/play_preference"
                android:visibility="gone"
                app:oui_list_item_title="@string/play_preference"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/choose_bot_id_key"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:oui_list_item_title="@string/choose_bot_id"
                style="@style/SettingSubItemSingleStyle"/>
            <com.android.settings.widget.SettingsBottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
