<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:paddingBottom="@dimen/fragment_default_bottom_height"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_storate"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.settings.deviceinfo.StorageVolumeView
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="34dp"
                    android:paddingTop="19dp"
                    android:paddingRight="35dp"
                    android:paddingBottom="27dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/settings_item_top_bottom_margin"
                    style="@style/SettingSubItemTopStyle">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/memory_manage_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/internal_storage"
                        android:singleLine="true"
                        android:layout_alignParentLeft="true"/>
                    <FrameLayout
                        android:background="@drawable/memory_manage_empty_bar"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_marginTop="13dp">
                        <View
                            android:id="@+id/view_used"
                            android:background="@drawable/memory_manage_used"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_progressbar"
                            android:layout_width="match_parent"
                            android:layout_height="25dp">
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_app"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_pic"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_music"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_download"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_cache"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                            <com.android.settings.deviceinfo.StorageProgressBarItem
                                android:id="@+id/view_other"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="25dp"/>
                        </LinearLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="19dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_free"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_grey_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_free"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_available"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_free"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"
                                    android:accessibilityTraversalBefore="@+id/tv_free_size"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="9dp">
                                <ImageView
                                    android:id="@+id/iv_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_black_dot"
                                    android:layout_centerVertical="true"/>
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="@color/memory_manage_total"
                                    android:id="@+id/total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="80dp"
                                    android:text="@string/memory_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_total"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"
                                    android:accessibilityTraversalBefore="@+id/total_size"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp">
                            <TextView
                                android:ellipsize="end"
                                android:id="@+id/tv_free_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="@dimen/memory_manage_total_size_width"
                                android:text="@string/memory_calculating_size"
                                android:singleLine="true"
                                android:layout_weight="1"
                                android:accessibilityTraversalBefore="@+id/total"/>
                            <TextView
                                android:ellipsize="end"
                                android:id="@+id/total_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="20dp"
                                android:maxWidth="@dimen/memory_manage_total_size_width"
                                android:text="@string/memory_calculating_size"
                                android:singleLine="true"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="21dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_pic"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_yellow_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_pic"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_dcim_usage"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_pic"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_pic_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_pic"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="9dp">
                                <ImageView
                                    android:id="@+id/iv_app"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_green_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_app"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_apps_usage"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_app"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_app_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_app"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="19dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_download"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_purple_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_download"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_downloads_usage"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_download"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_download_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_download"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="9dp">
                                <ImageView
                                    android:id="@+id/iv_music"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_red_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_music"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_music_usage"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_music"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_music_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_music"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="19dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_other"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_white_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_other"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/memory_media_misc_usage"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_other"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_other_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_other"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="9dp">
                                <ImageView
                                    android:id="@+id/iv_cache"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/memory_manage_blue_dot"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_system"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/system_battery_sipper"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/iv_cache"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"/>
                                <TextView
                                    android:textSize="@dimen/memory_manage_total_text_size"
                                    android:textColor="@color/memory_manage_total_size"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_system_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="@dimen/memory_manage_total_maxwidth"
                                    android:text="@string/memory_calculating_size"
                                    android:singleLine="true"
                                    android:layout_toRightOf="@+id/tv_system"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="@dimen/memory_manage_total_margin_right"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <obric.widget.SettingItemText
                    android:id="@+id/file_storage_detail"
                    android:title="@string/file_storage_detail_view"
                    style="@style/SettingSubItemBottomStyle"/>
                <include layout="@layout/item_bottom_shadow_layout"/>
            </com.android.settings.deviceinfo.StorageVolumeView>
            <include
                android:id="@+id/external_storage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/install_manage_storage"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/memory_file_cleanup"/>
            <include
                android:id="@+id/portable_storage_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/portable_storage_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
