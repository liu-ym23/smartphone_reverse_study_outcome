<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemCustom
        android:layout_gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:minHeight="180dp"
        style="@style/SettingSubItemSingleStyle">
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/setting_item_text_color"
            android:gravity="center_horizontal"
            android:id="@+id/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_label"
            android:layout_below="@+id/app_icon"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/icon_settings_summary_color"
            android:gravity="center_horizontal"
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_label"
            android:layout_below="@+id/app_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/icon_settings_summary_color"
            android:gravity="center_horizontal"
            android:id="@+id/tips"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/icon_setting_sub_text"
            android:layout_below="@+id/app_version"/>
    </obric.widget.ListContentItemCustom>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <obric.widget.ListContentItemCustom
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:minHeight="180dp"
        style="@style/SettingSubItemSingleStyle">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/setting_item_tips_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/common_icon_list_empty_text"
            style="@style/SettingItemTextShadowStyle"/>
    </obric.widget.ListContentItemCustom>
</LinearLayout>
