<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/side_dial_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/side_dial_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/side_dial_options_title"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_dial_mute"
                android:text="@string/side_dial_mute_title"
                style="@style/SettingSubItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_dial_creative_capsule"
                android:text="@string/side_dial_creative_capsule_title"
                style="@style/SettingSubItemMidStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_dial_clean_mode"
                android:visibility="gone"
                android:text="@string/side_dial_clean_mode_title"
                settings:showArrow="true"
                style="@style/SettingSubItemMidStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_dial_wireless_mode"
                android:text="@string/side_dial_wireless_mode_title"
                style="@style/SettingSubItemMidStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_dial_car_mode"
                android:text="@string/side_dial_car_mode_title"
                settings:showArrow="true"
                style="@style/SettingSubItemMidStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/id_side_custom"
                settings:showArrow="true"
                style="@style/SettingSubItemBottomStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
