<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/password_settings_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_showCustomEnd="false"
                    app:sectionTitle_titleText="@string/password_panel_title"
                    style="@style/OSectionTitleBar.S"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_lock_screen_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/lock_screen_password"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_work_profile_unified_lock"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_switch"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/lock_screen_unified_challenge_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_privacy_password"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/privacy_password"/>
                <TextView
                    android:id="@+id/item_privacy_password_tips"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_password_tips"
                    android:layout_marginHorizontal="32dp"
                    style="@style/Subtitle_2_Regular"/>
                <include layout="@layout/item_sub_settings_padding_layout"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/biometrics_settings_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_showCustomEnd="false"
                    app:sectionTitle_titleText="@string/biometrics_panel_title"
                    style="@style/OSectionTitleBar.S"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/manage_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/enroll_fingerprint_data"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/manage_face_data"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/enroll_face_data"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_enroll_face_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/enroll_face_data"/>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:id="@+id/fingerprint_law_tips"
                    android:layout_marginHorizontal="32dp"
                    app:section_des_text="@string/biometrics_license_tips"
                    style="@style/OSectionTitleBar.S"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_password_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/password_book_summary"
                app:ocardlistitem_title="@string/password_book"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/adsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_ad_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_single"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/ad_service_header_title"/>
            </LinearLayout>
            <include
                android:id="@+id/item_oaid_shadow"
                layout="@layout/item_sub_settings_padding_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_advance_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/security_advanced_options"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_trust_agents"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/manage_trust_agents"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_work_settings"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                app:ocardlistitem_title="@string/unlock_set_unlock_launch_picker_title_profile"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/lock_screen_header_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
