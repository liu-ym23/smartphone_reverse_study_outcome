<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/preferred_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50.5dp">
        <TextView
            android:textSize="@dimen/list_empty_view_title_text_size"
            android:textColor="@color/list_empty_view_text_color"
            android:gravity="center"
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_permission_status_app"/>
        <TextView
            android:textSize="@dimen/list_empty_view_summary_text_size"
            android:textColor="@color/list_empty_view_text_color"
            android:gravity="center"
            android:paddingLeft="@dimen/common_horizontal_padding"
            android:paddingRight="@dimen/common_horizontal_padding"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            android:text="@string/vpn_list_empty_summary"
            android:layout_below="@+id/empty_title"/>
    </RelativeLayout>
</RelativeLayout>
