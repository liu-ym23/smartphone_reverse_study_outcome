<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="none"
    android:fadingEdge="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:gravity="left"
            android:id="@+id/exit_notice_for_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="13dp"
            android:text="@string/logout_smiling_account_desc"
            android:lineSpacingMultiplier="1.1"/>
        <obric.widget.PasswordEditText
            android:id="@+id/input_pwd_edittext_for_dialog"
            android:background="@drawable/edit_text"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:hint="@string/cloud_service_password"
            android:layout_below="@+id/exit_notice_for_dialog"
            style="@style/passwordEditTextStyle"/>
        <Button
            android:textColor="@drawable/forget_pwd_btn_color"
            android:id="@+id/find_forget_pwd_for_dialog"
            android:background="@null"
            android:text="@string/forgetPwd"
            android:layout_below="@+id/input_pwd_edittext_for_dialog"
            style="@style/findForgetPasswordStyle"/>
        <RelativeLayout
            android:id="@+id/bottom_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/find_forget_pwd_for_dialog"/>
    </RelativeLayout>
</com.obric.oui.bouncelayout.OScrollView>
