<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/headset_calibration_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_maximum_width"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/top_gap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:id="@+id/ap_network_sharing"
                android:paddingLeft="@dimen/oui_p_list_item_2"
                android:paddingRight="@dimen/oui_p_list_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oui_radius="@dimen/oui_r_l3_rect">
                <FrameLayout
                    android:orientation="vertical"
                    android:background="@drawable/o_background_list_item"
                    android:layout_width="match_parent"
                    android:layout_height="143dp"
                    android:paddingVertical="@dimen/oui_g_list_item_2">
                    <ImageView
                        android:background="@drawable/headset_illustration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="true"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="-1dp">
                        <com.android.settings.widget.CalibrationAnimtedView
                            android:id="@+id/cal_down_key"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"/>
                        <com.android.settings.widget.CalibrationAnimtedView
                            android:id="@+id/place_holder"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"/>
                        <com.android.settings.widget.CalibrationAnimtedView
                            android:id="@+id/cal_up_key"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#454a5c"
                        android:gravity="center_horizontal"
                        android:id="@+id/calibrate_done_tips"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="39.5dp"
                        android:text="@string/headset_calibration_done_tips"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#454a5c"
                        android:id="@+id/calibrating_tips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="130.5dp"/>
                </FrameLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <TextView
                android:text="@string/headset_calibration_unsupport_tip"
                style="@style/SettingItemTipsStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.button.OButton
                android:id="@+id/none"
                android:clickable="true"
                android:layout_height="@dimen/oui_h_l2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/OButton.ListItem.Center"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.button.OButton
                android:id="@+id/pressed"
                android:clickable="true"
                android:layout_height="@dimen/oui_h_l2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/OButton.ListItem.Center"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.button.OButton
                android:id="@+id/done"
                android:clickable="true"
                android:layout_height="@dimen/oui_h_l2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/OButton.ListItem.Center"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
