<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/top_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_see_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/see_list_title"
                    android:layout_marginTop="0dp"
                    android:text="@string/app_type_see"
                    style="@style/SettingItemTitleStyle"/>
                <view
                    android:id="@+id/see_list"
                    android:overScrollMode="never"
                    class="com.android.settings.applications.PreferredActivityChooserExtendFragment$ExtendListView"
                    style="@style/ListViewGeneralStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_send_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/send_list_title"
                    android:text="@string/app_type_send"
                    style="@style/SettingItemTitleStyle"/>
                <view
                    android:id="@+id/send_list"
                    android:overScrollMode="never"
                    class="com.android.settings.applications.PreferredActivityChooserExtendFragment$ExtendListView"
                    style="@style/ListViewGeneralStyle"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tips"
                android:text="@string/preferred_app_list_tips"
                style="@style/SettingItemTipsStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/setting_item_tips_color"
                android:gravity="center"
                android:id="@+id/view_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/application_manager_empty_view_text"
                style="@style/SettingItemTextShadowStyle"/>
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/preferred_empty"
                android:visibility="gone"
                android:layout_width="@dimen/list_item_maximum_width"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/settings_item_title_left_margin"
                android:layout_marginRight="@dimen/settings_item_title_left_margin">
                <TextView
                    android:textSize="@dimen/list_empty_view_title_text_size"
                    android:textColor="@color/list_empty_view_text_color"
                    android:gravity="center"
                    android:id="@+id/empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preferred_none_choose_app"/>
            </RelativeLayout>
            <include layout="@layout/title_bar_shadow"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_application"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
