<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.layout.OUIFrameLayout
                android:background="@color/oui_fill_list_item_card"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding"
                app:oui_radius="20dp">
                <com.obric.oui.forms.OInputLayout
                    android:id="@+id/ssid"
                    android:inputType="textUri"
                    app:oinput_hint="@string/wifi_ssid"
                    app:oinput_label="@string/wifi_ssid"
                    app:oinput_showInputBackground="false"
                    style="@style/OInputLayout.Label"/>
            </com.obric.oui.layout.OUIFrameLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/security"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/wifi_security"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/choose_band"
                android:visibility="visible"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/wifi_ap_band_config"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/use_owe"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/wifi_ap_use_wifi7_tips"
                app:ocardlistitem_title="@string/wifi_ap_use_wifi7"
                style="@style/OCardListItemSwitchSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fields"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
                <com.obric.oui.layout.OUIFrameLayout
                    android:background="@color/oui_fill_list_item_card"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/settings_container_item_horizontal_padding"
                    app:oui_radius="20dp">
                    <com.obric.oui.forms.OInputLayout
                        android:id="@+id/password"
                        android:inputType="textPassword"
                        app:oinput_hint="@string/wifi_password"
                        app:oinput_label="@string/wifi_password"
                        app:oinput_limitCount="64"
                        app:oinput_showClear="false"
                        app:oinput_showEyes="true"
                        style="@style/OInputLayout.Label"/>
                </com.obric.oui.layout.OUIFrameLayout>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:layout_marginHorizontal="32dp"
                    app:section_des_text="@string/credentials_password_too_short"
                    style="@style/OSectionTitleBar.S"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/wifi_tether_configure_ap_text"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
