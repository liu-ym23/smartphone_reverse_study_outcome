<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/admin_support_icon"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:src="@drawable/ic_lock_closed"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textColor="@color/transparent"
            android:gravity="center_horizontal"
            android:id="@+id/admin_support_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disabled_by_policy_title"/>
    </LinearLayout>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/transparent"
                android:gravity="center_horizontal"
                android:autoLink="phone|email|web"
                android:id="@+id/admin_support_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="200"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@android:id/button1"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:text="@string/okay"/>
                <Button
                    android:id="@android:id/button2"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:text="@string/okay"/>
                <Button
                    android:id="@android:id/button3"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:text="@string/okay"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</LinearLayout>
