<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center_horizontal"
        android:background="@drawable/wifi_trust_network_disable_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/trust_network_list_image_margin_top"/>
    <TextView
        android:textSize="@dimen/trust_network_list_first_line_textsize"
        android:textColor="#26000000"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/emptyview_margin_left_right"
        android:layout_marginTop="@dimen/trust_network_list_first_line_margin_top"
        android:layout_marginRight="@dimen/emptyview_margin_left_right"
        android:text="@string/trusted_network_list_forbidden_tips_1"/>
    <TextView
        android:textSize="@dimen/trust_network_list_second_line_textsize"
        android:textColor="#26000000"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/emptyview_margin_left_right"
        android:layout_marginTop="@dimen/trust_network_list_second_line_margin_top"
        android:layout_marginRight="@dimen/emptyview_margin_left_right"
        android:text="@string/trusted_network_list_forbidden_tips_2"/>
</LinearLayout>
