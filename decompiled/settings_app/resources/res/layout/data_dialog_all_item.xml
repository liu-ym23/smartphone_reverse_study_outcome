<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:background="@drawable/time_picker_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:layout_gravity="left"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="101.7dp"
            android:text="@string/cancel"
            android:singleLine="true"
            style="@style/SmallButton.Standard"/>
        <TextView
            android:textSize="@dimen/time_picker_button_size"
            android:textStyle="bold"
            android:textColor="#585858"
            android:layout_gravity="center"
            android:id="@+id/chose_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="166dp"
            android:text="@string/bluetooth_setting_stop_time"
            android:singleLine="true"/>
        <Button
            android:layout_gravity="right"
            android:id="@+id/confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="101.7dp"
            android:text="@string/edit_submit"
            android:singleLine="true"
            style="@style/SmallButton.Standard"/>
    </FrameLayout>
    <RelativeLayout
        android:background="@drawable/time_picker_widget_bg"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="208dp">
        <com.android.settings.bluetooth.BluetoothNumberPicker
            android:id="@+id/number_picker"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:background="@drawable/time_picker_widget_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
