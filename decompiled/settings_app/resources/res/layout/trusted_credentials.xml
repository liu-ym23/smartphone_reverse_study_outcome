<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/system_tab"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true">
        <com.obric.oui.progress.OProgressView
            android:id="@+id/system_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:paddingHorizontal="8dp"/>
        <com.obric.oui.bouncelayout.OListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/system_list"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="always"/>
        <ExpandableListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/system_expandable_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:childDivider="@color/transparent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/user_tab"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true">
        <com.obric.oui.progress.OProgressView
            android:layout_gravity="center"
            android:id="@+id/user_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:indeterminateDrawable="@drawable/progress_item"/>
        <com.obric.oui.bouncelayout.OListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/user_list"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingHorizontal="8dp"/>
        <ExpandableListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/user_expandable_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:childDivider="@color/transparent"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"/>
    </FrameLayout>
    <com.obric.oui.tab.OTabLayout
        android:id="@+id/tabLayout"
        android:background="@drawable/tablayout_no_material_bg"
        android:layout_width="match_parent"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="@dimen/oui_p_list_item_1"
        app:bar_color="@color/oui_fill_element_3"
        app:tabGravity="fill"
        style="@style/OTabTextV2.Background.Gray">
        <com.obric.oui.tab.OTabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trusted_credentials_system_tab"/>
        <com.obric.oui.tab.OTabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trusted_credentials_user_tab"/>
    </com.obric.oui.tab.OTabLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/trusted_credentials"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
