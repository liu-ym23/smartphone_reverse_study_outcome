<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:text="@string/motion_delay_commit_tip"
        style="@style/SettingItemTitleStyle"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <obric.widget.editor.SimpleEditor
        android:id="@+id/commit_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/motion_delay_commit_hint"
        style="@style/EditorStyle.Single"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <com.obric.oui.button.OButton
        android:enabled="false"
        android:id="@+id/btn_commit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/motion_delay_commit"
        style="@style/LongButton.Highlight"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
</LinearLayout>
