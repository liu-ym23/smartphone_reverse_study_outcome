<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/f_functional_keys"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_title_bar_switch"
                android:title="@string/key_title_bar_switch"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_close_window"
                android:title="@string/key_close_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_close_other_window"
                android:title="@string/key_close_other_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_close_all"
                android:title="@string/key_close_all"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_screen_shot_full"
                android:title="@string/key_screen_shot_full"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_screen_shot"
                android:title="@string/key_screen_shot"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_multi_tasks"
                android:title="@string/key_multi_tasks"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_multi_tasks_within_app"
                android:title="@string/key_multi_tasks_within_app"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_fullscreen"
                android:title="@string/key_fullscreen"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_lock"
                android:title="@string/key_lock"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_exit_app"
                android:title="@string/key_exit_app"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_scrapbook_drawer"
                android:title="@string/key_scrapbook_drawer"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_quick_switch_center"
                android:title="@string/key_quick_switch_center"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_notification_center"
                android:title="@string/key_notification_center"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_file_drawer"
                android:title="@string/key_file_drawer"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_album_drawer"
                android:title="@string/key_album_drawer"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_desktop"
                android:title="@string/key_desktop"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_fullscreen_to_the_right"
                android:title="@string/key_fullscreen_to_the_right"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_fullscreen_to_the_left"
                android:title="@string/key_fullscreen_to_the_left"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_open_new_file_manager_window"
                android:title="@string/key_open_new_file_manager_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_hide_app_all_windows"
                android:title="@string/key_hide_app_all_windows"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_hide_other_app_window"
                android:title="@string/key_hide_other_app_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_organize_small_window"
                android:title="@string/key_organize_small_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_app_drawer"
                android:title="@string/dock_bar_tools_all_apps"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_resume_window"
                android:title="@string/key_resume_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_minimize_current_window"
                android:title="@string/key_minimize_current_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_key_minimize_other_window"
                android:visibility="gone"
                android:title="@string/key_minimize_other_window"
                app:show_arrow="true"
                app:smtTitle="@string/key_none"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_reset_all_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_all_keys"
                style="@style/LongButton.Highlight.White"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
