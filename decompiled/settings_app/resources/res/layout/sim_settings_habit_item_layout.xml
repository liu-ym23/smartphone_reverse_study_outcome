<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:paddingTop="@dimen/sim_settings_item_title_padding_top_or_bottom"
        android:paddingBottom="@dimen/sim_settings_item_title_padding_top_or_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_sim_setting_sms"
            android:paddingLeft="@dimen/sim_settings_item_preview_image_padding_left_or_right"
            android:paddingRight="@dimen/sim_settings_item_preview_image_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sim_settings_child_picture_margin_top"
            android:src="@drawable/sim_card_b_message"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sim_settings_item_child_title_size"
            android:textColor="@color/setting_item_text_color"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sim_settings_child_text_margin_top"
            android:text="@string/sim_settings_sms"
            android:singleLine="true"
            android:layout_below="@+id/iv_sim_setting_sms"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include layout="@layout/divider_line_vertical"/>
    <RelativeLayout
        android:paddingTop="@dimen/sim_settings_item_title_padding_top_or_bottom"
        android:paddingBottom="@dimen/sim_settings_item_title_padding_top_or_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_sim_setting_dial_pad"
            android:paddingLeft="@dimen/sim_settings_item_preview_image_padding_left_or_right"
            android:paddingRight="@dimen/sim_settings_item_preview_image_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sim_settings_child_picture_margin_top"
            android:src="@drawable/sim_card_b_classic"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sim_settings_item_child_title_size"
            android:textColor="@color/setting_item_text_color"
            android:gravity="center_horizontal"
            android:id="@+id/label_of_dial_pad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sim_settings_child_text_margin_top"
            android:text="@string/sim_settings_dialpad_symmetry"
            android:singleLine="true"
            android:layout_below="@+id/iv_sim_setting_dial_pad"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
