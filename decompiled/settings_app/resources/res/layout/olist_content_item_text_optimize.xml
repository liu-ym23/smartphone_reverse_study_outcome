<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIRelativeLayout
        android:background="@drawable/setting_item_backgroud_card"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        app:oui_radius="16dp">
        <FrameLayout
            android:id="@+id/icon_container"
            android:duplicateParentState="true"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_content_img"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/setting_application_system_layer_icon"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"/>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/iv_doppleganger_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="11dp"
                android:src="@color/transparent"
                android:layout_marginEnd="11dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/trailing_container"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true">
            <TextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Title_Title_M"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_content_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/trailing_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_state_on"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                android:lineHeight="20dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_forward_list_item"/>
        </LinearLayout>
    </com.obric.oui.layout.OUIRelativeLayout>
</RelativeLayout>
