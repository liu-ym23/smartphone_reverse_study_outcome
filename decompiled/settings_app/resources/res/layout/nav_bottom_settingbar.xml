<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_bar"
    android:background="@drawable/nav_settingbar_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tablet_bottombar_height">
    <View
        android:id="@+id/divider"
        android:background="@color/alpha_14_black_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tablet_divider_line_width"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/setting_btns_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="11dp">
        <ImageView
            android:id="@+id/add_btn"
            android:layout_width="@dimen/tablet_setting_btn_width"
            android:layout_height="@dimen/tablet_setting_btn_width"
            android:src="@drawable/nav_btn_add_selector"
            android:scaleType="centerInside"
            android:contentDescription="@string/add_btn"/>
        <ImageView
            android:id="@+id/delete_btn"
            android:layout_width="@dimen/tablet_setting_btn_width"
            android:layout_height="@dimen/tablet_setting_btn_width"
            android:src="@drawable/nav_btn_delete_selector"
            android:scaleType="centerInside"
            android:contentDescription="@string/delete_btn"
            android:layout_marginStart="15dp"/>
        <ImageView
            android:id="@+id/more_btn"
            android:layout_width="@dimen/tablet_setting_btn_width"
            android:layout_height="@dimen/tablet_setting_btn_width"
            android:src="@drawable/nav_btn_more_selector"
            android:scaleType="centerInside"
            android:contentDescription="@string/more_btn"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/setting_btn"
        android:layout_width="@dimen/tablet_setting_btn_width"
        android:layout_height="@dimen/tablet_setting_btn_width"
        android:src="@drawable/nav_btn_setting_selector"
        android:scaleType="centerInside"
        android:layout_centerInParent="true"
        android:contentDescription="@string/settings_btn"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"/>
</RelativeLayout>
