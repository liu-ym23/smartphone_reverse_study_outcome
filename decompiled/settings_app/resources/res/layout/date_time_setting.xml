<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/wizard_setup_image"
                android:background="@drawable/wizard_date"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/date_time_setting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="@dimen/settings_item_horizontal_padding"
                app:sectionTitle_titleText="@string/date_time_title"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/switch_date_time_auto_set"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_title="@string/date_time_auto_set"
                style="@style/OCardListItemSwitchSingle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_date_set"
                    app:ocardlistitem_title="@string/date_time_date"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_time_set"
                    app:ocardlistitem_title="@string/date_time_time"
                    style="@style/OCardListItemTextMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_zone_set"
                    app:ocardlistitem_title="@string/date_time_zone"
                    style="@style/OCardListItemTextBottom"/>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/double_timezone_settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/timezone_time_settings"
                    app:ocardlistitem_title="@string/show_timezone_time"
                    style="@style/OCardListItemTextSingle"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/switch_time_display_mode"
                app:ocardlistitem_title="@string/date_time_display_mode"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/temperature_unit_setting_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:id="@+id/temperature_unit_setting_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:layout_marginHorizontal="@dimen/settings_item_horizontal_padding"
                    app:sectionTitle_titleText="@string/temperature_unit_title"
                    style="@style/OSectionTitleBar.S"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/unit_celsius"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_title="@string/temperature_unit_celsius"
                    style="@style/OCardListItemTextTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/unit_fahrenheit"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_title="@string/temperature_unit_fahrenheit"
                    style="@style/OCardListItemTextBottom"/>
                <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:layout_marginHorizontal="@dimen/settings_item_horizontal_padding"
                    app:section_des_text="@string/temperature_unit_setting_tips"
                    style="@style/OSectionTitleBar.S"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/date_time_temperature_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <FrameLayout
        android:id="@+id/next_step_btn_group"
        android:background="#ffffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        app:bottom_type="true">
        <com.obric.oui.button.OButton
            android:layout_gravity="center"
            android:id="@+id/next_step_btn"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:text="@string/button_next_step"
            style="@style/LongButton.Shrink.Highlight"/>
    </FrameLayout>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
