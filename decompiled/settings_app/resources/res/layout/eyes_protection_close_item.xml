<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:paddingTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OListItemSettings
            android:id="@+id/close_today"
            android:layout_marginBottom="4dp"
            app:oui_list_item_title="@string/protect_eyes_close_today"
            style="@style/SettingSubItemSingleStyle"/>
        <com.obric.oui.lisitem.OListItemSettings
            android:id="@+id/close_totally"
            android:layout_marginBottom="16dp"
            app:oui_list_item_title="@string/protect_eyes_close_totally"
            style="@style/SettingSubItemSingleStyle"/>
    </LinearLayout>
</RelativeLayout>
