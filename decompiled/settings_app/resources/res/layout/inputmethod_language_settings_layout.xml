<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_language"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/language_keyboard_item_title_language"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_switch_spelling_check"
                app:ocardlistitem_title="@string/language_item_title_spellling_check"
                style="@style/OCardListItemTextTop"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_button_spelling_check"
                app:ocardlistitem_title="@string/language_item_title_spellling_check_settings"
                style="@style/OCardListItemTextBottom"/>
            <include
                android:id="@+id/id_spelling_check_gap"
                layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/autofill_service"
                android:visibility="gone"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/autofill_app"
                style="@style/OCardListItemTextSingle"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/id_text_input_method"
                app:sectionTitle_titleText="@string/language_item_title_inputmethod"
                style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/id_security_keyboard"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/security_keyboard_subtitle"
                app:ocardlistitem_title="@string/security_keyboard"
                style="@style/OCardListItemSwitchSingle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_user_dictionary"
                android:visibility="gone"
                app:ocardlistitem_title="@string/language_keyboard_item_text_user_dictionary"
                style="@style/OCardListItemTextMid"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_id_default_inputmethod"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_title="@string/language_item_title_set_default_inputmethod"
                app:subTitleFontSize="@dimen/settings_item_title_size"
                style="@style/OCardListItemTextBottom"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                app:sectionTitle_titleText="@string/language_item_title_available_inputmethod"
                style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/inputmethod_list"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/inputmethod_list_work_title"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                app:sectionTitle_titleText="@string/managed_profile_settings_title"
                style="@style/OSectionTitleBar.S.SectionTitleBarStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/inputmethod_list_work"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/language_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
