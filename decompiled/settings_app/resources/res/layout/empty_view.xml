<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/preferred_empty"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/settings_item_title_left_margin"
    android:layout_marginRight="@dimen/settings_item_title_left_margin">
    <TextView
        android:textSize="23sp"
        android:textColor="@color/list_empty_view_text_color"
        android:gravity="center"
        android:id="@+id/empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/list_empty_view_text_color"
        android:gravity="center"
        android:id="@+id/empty_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9.5dp"
        android:layout_below="@+id/empty_title"/>
</RelativeLayout>
