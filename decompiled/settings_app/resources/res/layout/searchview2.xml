<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seachresultview"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <TextView
        android:id="@+id/searchview_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <com.android.settings.widget.HorizontalScrollListView
        android:scrollbarStyle="outsideInset"
        android:id="@+id/search_listview"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:scrollbars="none"
        settings:left_btns_id="@+id/scroll_del_btn"
        settings:scroll_enabled="true"
        settings:scroll_handle_id="@+id/scroll_handle_layout"
        style="@style/ListViewGeneralStyle"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:gravity="center_horizontal"
        android:id="@+id/search_empty_view"
        android:paddingTop="@dimen/empty_search_result_padding_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/no_search_result"
        style="@style/Title_3_Medium"/>
</RelativeLayout>
