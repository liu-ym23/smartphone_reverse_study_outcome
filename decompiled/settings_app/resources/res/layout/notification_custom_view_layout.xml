<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/bottom_tips"
        android:background="@drawable/setting_notice_line"
        android:paddingLeft="@dimen/common_horizontal_padding"
        android:paddingRight="@dimen/common_horizontal_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_widget_tips_height"
        android:text="@string/custom_notification_tips"
        android:singleLine="true"
        android:layout_alignParentBottom="true"/>
    <HorizontalScrollView
        android:id="@+id/scroll_candidate"
        android:background="#fafafa"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_tips"
        android:importantForAccessibility="no">
        <LinearLayout
            android:id="@+id/candidate_container"
            android:background="#fafafa"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
    </HorizontalScrollView>
    <View
        android:id="@+id/view_separator"
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginTop="@dimen/widget_grid_margin_bottom"
        android:layout_above="@+id/scroll_candidate"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/drag_icon_for_sort_tips"
        android:singleLine="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
