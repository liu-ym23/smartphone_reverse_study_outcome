<?xml version="1.0" encoding="utf-8"?>
<com.android.settings.widget.SimulateMotionDelaySubTestView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#cc000000"
        android:id="@+id/sub_test_title"
        style="@style/SettingItemTitleStyle"/>
    <TextView
        android:id="@+id/sub_test_tips"
        android:lineSpacingExtra="5sp"
        style="@style/SettingItemTipsStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_test_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/motion_delay_sub_result_ques_1"
            style="@style/SettingItemTitleStyle"/>
        <include layout="@layout/group_list_item_vertical_gap_layout"/>
        <view
            android:id="@+id/overall_feel_list"
            android:overScrollMode="never"
            class="com.android.settings.widget.SimulateMotionDelaySubTestView$SubListView"
            style="@style/ListViewGeneralStyle"/>
        <include layout="@layout/group_list_item_vertical_gap_layout"/>
        <TextView
            android:text="@string/motion_delay_sub_result_ques_2"
            style="@style/SettingItemTitleStyle"/>
        <include layout="@layout/group_list_item_vertical_gap_layout"/>
        <view
            android:id="@+id/bad_case_list"
            android:overScrollMode="never"
            class="com.android.settings.widget.SimulateMotionDelaySubTestView$SubListView"
            style="@style/ListViewGeneralStyle"/>
    </LinearLayout>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
    <com.obric.oui.button.OButton
        android:enabled="false"
        android:id="@+id/btn_sub_result_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        style="@style/LongButton.Highlight"/>
    <include layout="@layout/group_list_item_vertical_gap_layout"/>
</com.android.settings.widget.SimulateMotionDelaySubTestView>
