<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/id_navbar_mode_setting_title"
        android:text="@string/navigation_bar_settings_mode"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.ListContentItemCustom
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="245dp"
        style="@style/SettingSubItemTopStyle">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/id_preview"
            android:layout_width="@dimen/launcher_mode_preview_width"
            android:layout_height="@dimen/launcher_mode_preview_height"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/id_frame"
            android:layout_width="@dimen/launcher_preview_shell_width"
            android:layout_height="@dimen/launcher_preview_shell_height"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/id_frame_disable"
            android:visibility="gone"
            android:layout_width="@dimen/launcher_preview_shell_width"
            android:layout_height="@dimen/launcher_preview_shell_height"
            android:src="@drawable/page_animations_preview_phone_osborn_disable"
            android:layout_centerInParent="true"/>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom
        android:id="@+id/middle_layout"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        style="@style/SettingSubItemMidStyle">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/settings_item_horizontal_padding"
            android:paddingRight="@dimen/settings_item_horizontal_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_navbar_narrow"
                android:paddingTop="9dp"
                android:paddingBottom="@dimen/navbar_preview_narrow_padding_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                app:title="@string/navigation_bar_auto_hide_mode"/>
            <ImageView
                android:id="@+id/div_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preview_options_line"
                android:scaleType="fitXY"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_navbar_classic"
                android:paddingTop="9dp"
                android:paddingBottom="@dimen/navbar_preview_narrow_padding_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:title="@string/navigation_bar_pin_mode"/>
        </LinearLayout>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom
        android:id="@+id/bottom_layout"
        style="@style/SettingSubItemBottomStyle">&gt; 
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/settings_item_horizontal_padding"
            android:paddingRight="@dimen/settings_item_horizontal_padding"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.widget.PreviewOptionItemView
                android:id="@+id/id_navbar_black_theme"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/navbar_black_theme_bg"
                app:selected_icon="@drawable/lock_check_bg"
                app:title="@string/navigation_bar_theme_black"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preview_options_line"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:id="@+id/id_navbar_gray_theme"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/navbar_gray_theme_bg"
                app:selected_icon="@drawable/lock_check_bg"
                app:title="@string/navigation_bar_theme_gray"/>
            <ImageView
                android:id="@+id/iv_line_left_of_wine_red"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preview_options_line"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:id="@+id/id_navbar_red_wine_theme"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/navbar_claret_theme_bg"
                app:selected_icon="@drawable/lock_check_bg"
                app:title="@string/navigation_bar_theme_red_wine"/>
        </LinearLayout>
    </obric.widget.ListContentItemCustom>
</merge>
