<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/print_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/print_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/print_space"
                android:layout_width="match_parent"
                android:layout_height="@dimen/main_settings_first_o_section_title_bar_item_card_gap"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/print_job_title"
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_titleText="@string/print_print_jobs"
                style="@style/OSectionTitleBar.S"/>
            <obric.widget.ExtendListView
                android:id="@+id/print_job_list"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@color/lock_pattern_background"
                android:divider="@null"
                android:overScrollMode="never"/>
            <obric.widget.ExtendListView
                android:id="@+id/print_list"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listSelector="@color/lock_pattern_background"
                android:divider="@null"
                android:overScrollMode="never"/>
            <View
                android:id="@+id/print_bottom_space"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_container_bottom_padding"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        app:oFloatingTitleBar_centerTitle="@string/system_print"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
</RelativeLayout>
