<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:paddingTop="@dimen/main_settings_first_o_section_title_bar_item_card_gap"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/under_display_fingerprint_ostb_text"
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/under_display_fingerprint_ostb_text"
                style="@style/OSectionTitleBar.S"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/udfps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/add_udfps_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
                app:ocardlistitem_showCardBg="true"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/udfps_unlock_screen_enable_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/udfps_unlock_screen_enable_text"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/udfps_unlock_screen_type_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/udfps_unlock_screen_type_text"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/ai_powered_fingerprint_ostb_text"
                android:layout_marginTop="@dimen/setting_item_gap"
                android:layout_marginHorizontal="32dp"
                app:sectionTitle_showCustomEnd="false"
                app:sectionTitle_titleText="@string/ai_powered_fingerprint_ostb_text"
                style="@style/OSectionTitleBar.S"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ai_powered_fps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/add_ai_powered_fps_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/settings_ai_powered_fps_more_btn_layout"
                app:ocardlistitem_showCardBg="true"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/ai_powered_fps_tips"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:section_des_text="@string/enroll_new_ai_powered_fingerprint_tips"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/fingerprint_udfps_display_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_chevron"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/obric_udfps_display_policy_title"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/policy_tips"
                android:layout_marginHorizontal="@dimen/dimen_32"
                app:section_des_text="@string/obric_doze_display_policy_tips"
                style="@style/OSectionTitleBar.S"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/fingerprint_animation_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/fingerprint_animation"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/start_app_via_fp_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/quick_pay_via_fingerprint"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/manage_fingerprint"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
