<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/id_seekbar_title"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.ListContentItemCustom
        android:id="@+id/id_seekbar_in_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Single">
        <TextView
            android:textSize="17sp"
            android:textColor="#cc000000"
            android:gravity="left"
            android:id="@+id/id_seekbar_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:minWidth="33dp"
            android:text="@string/color_profiles_warm"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#cc000000"
            android:gravity="right"
            android:id="@+id/id_seekbar_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30dp"
            android:minWidth="33dp"
            android:text="@string/color_profiles_cold"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <SeekBar
            android:id="@+id/id_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/thin_progress_horizontal_drawable_normal"
            android:thumb="@drawable/color_seekbar_thumb_selector"
            android:layout_toLeftOf="@+id/id_seekbar_right"
            android:layout_toRightOf="@+id/id_seekbar_left"
            android:layout_centerVertical="true"/>
    </obric.widget.ListContentItemCustom>
    <include
        android:id="@+id/id_gap_view"
        layout="@layout/group_list_item_vertical_gap_layout"/>
    <obric.widget.ListContentItemCustom
        android:id="@+id/id_button_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/ListContentItemStyle.Bottom">
        <Button
            android:gravity="center"
            android:id="@+id/id_seekbar_reset"
            android:background="@null"
            android:clickable="false"
            android:text="@string/color_profiles_reset"
            android:layout_centerInParent="true"
            style="@style/ButtonGeneralStyle"/>
    </obric.widget.ListContentItemCustom>
    <TextView
        android:id="@+id/id_seekbar_tips"
        style="@style/SettingItemTipsStyle"/>
</LinearLayout>
