<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/item_layout"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        app:oui_list_item_title="@string/apn_name"
        style="@style/SettingSubItemSingleStyle"/>
    <com.obric.oui.swipeaction.OSwipeLayout
        android:id="@+id/item_swipe"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="4dp"
        app:oui_bottomLeft_radius="@dimen/oui_r_l3_rect"
        app:oui_clickToClose="true"
        app:oui_leftEdgeSwipeOffset="100dp"
        app:oui_show_mode="pull_out"
        app:oui_topLeft_radius="@dimen/oui_r_l3_rect">
        <LinearLayout
            android:id="@+id/bottom_wrapper"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:weightSum="1">
            <com.obric.oui.button.OButton
                android:layout_gravity="center_vertical"
                android:id="@+id/delete_btn"
                android:background="@color/oui_red_6"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:onClick="showTips"
                app:icon="@drawable/ic_swipe_delete"
                app:oui_radius="@dimen/oui_r_l1_rect"/>
        </LinearLayout>
        <com.obric.oui.lisitem.OListItemSettings
            android:id="@+id/item_layout_with_delete_icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp"
            app:oui_list_item_title="@string/apn_name"/>
    </com.obric.oui.swipeaction.OSwipeLayout>
</RelativeLayout>
