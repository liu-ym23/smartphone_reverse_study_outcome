<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        layout="@layout/searchview_oui"/>
    <RelativeLayout
        android:id="@+id/history_layout"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true">
        <com.obric.oui.bouncelayout.OListView
            android:id="@+id/search_history_view"
            android:background="@color/oui_bg_base_1"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="always"/>
    </RelativeLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:background="@color/oui_bg_base_1"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="false"
        app:oui_widgetBlurType="2">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/view_title1"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp">
                <com.obric.oui.searchbar.v2.OSearchBar
                    android:id="@+id/id_search_bar"
                    android:layout_width="0dp"
                    android:hint="Search"
                    android:layout_weight="1"
                    style="@style/OStyleV2.OSearchBar.Float.S"/>
                <com.obric.oui.button.OIconButtonFloating
                    android:id="@+id/search_cancel_button"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_marginLeft="8dp"
                    app:oui_widgetIcon="@drawable/oui_icon_xmark"
                    style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
</RelativeLayout>
