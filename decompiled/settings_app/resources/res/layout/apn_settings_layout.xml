<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OListView
        android:id="@+id/view_list"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:paddingBottom="@dimen/dimen_96"
        style="@style/ListViewGeneralStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_96"
        android:layout_alignParentBottom="true">
        <com.obric.oui.button.OButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_apn_reset"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dimen_16"
            android:text="@string/apn_reset"
            android:layout_marginHorizontal="@dimen/dimen_20"
            style="@style/OStyleV2.OButton.L.Standard.Red_Light"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/mobile_network_vpn"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <include layout="@layout/title_bar_shadow"/>
    <com.android.settings.widget.SettingsBottomExtraView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</RelativeLayout>
