<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <obric.widget.ListContentItemCustom style="@style/SettingSubItemTopStyle">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="245dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/id_preview"
                android:layout_width="@dimen/launcher_mode_preview_width"
                android:layout_height="@dimen/launcher_mode_preview_height"
                android:src="@android:color/black"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/id_frame"
                android:layout_width="@dimen/launcher_preview_shell_width"
                android:layout_height="@dimen/launcher_preview_shell_height"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom style="@style/SettingSubItemMidStyle">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/middle_layout"
            android:paddingLeft="@dimen/settings_item_horizontal_padding"
            android:paddingRight="@dimen/settings_item_horizontal_padding"
            android:layout_width="match_parent"
            android:layout_height="102dp">
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_grid_9"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:title="@string/mode_bytedance_launcher_9_grids"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_grid_12"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:title="@string/mode_bytedance_launcher_12_grids"/>
            <ImageView
                android:id="@+id/div_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preview_options_line"
                android:scaleType="fitXY"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_grid_16"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:title="@string/mode_bytedance_launcher_16_grids"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:layout_gravity="center_vertical"
                android:id="@+id/id_grid_20"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:title="@string/mode_bytedance_launcher_20_grids"/>
        </LinearLayout>
    </obric.widget.ListContentItemCustom>
    <obric.widget.ListContentItemCustom style="@style/SettingSubItemBottomStyle">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_layout"
            android:paddingLeft="@dimen/settings_item_horizontal_padding"
            android:paddingRight="@dimen/settings_item_horizontal_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.settings.widget.PreviewOptionItemView
                android:id="@+id/id_classic"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:selected_icon="@drawable/lock_style_active"
                app:title="@string/material_theme"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preview_options_line"/>
            <com.android.settings.widget.PreviewOptionItemView
                android:id="@+id/id_transparent_theme"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:selected_icon="@drawable/lock_style_active"
                app:title="@string/transparent_theme"/>
        </LinearLayout>
    </obric.widget.ListContentItemCustom>
</merge>
