<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/search_voice_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/search_menu"
                app:oui_list_item_title="@string/search_settings_title"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/search_setting_title"
                android:visibility="gone"
                android:text="@string/search_title"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/allowed_search"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/allowed_search_project"
                app:subTitleFontSize="@dimen/settings_item_title_size"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/pinyin_fuzzy_tone_search_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:smtTitle="@string/pinyin_fuzzy_tone_search_settings"
                app:subTitleFontSize="@dimen/settings_item_title_size"
                style="@style/SettingSubItemBottomStyle"/>
            <TextView
                android:id="@+id/fuzzy_tone_tips_view"
                android:visibility="gone"
                android:text="@string/pinyin_fuzzy_tone_search_tips"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:id="@+id/id_searchable_item_gap"
                android:visibility="visible"
                layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/switch_application_suggestions"
                android:visibility="gone"
                app:smtTitle="@string/search_application_suggestions"
                style="@style/SettingItemTopStyle"/>
            <obric.widget.SettingItemSwitch
                android:id="@+id/switch_popular_information"
                android:visibility="gone"
                app:smtTitle="@string/search_popular_information"
                style="@style/SettingItemBottomStyle"/>
            <TextView
                android:id="@+id/global_suggestions_tips"
                android:visibility="gone"
                android:text="@string/search_global_suggestions_tips"
                style="@style/SettingItemTipsStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/id_slide_up_settings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/id_slide_up_launcher"
                    app:smtTitle="@string/trigger_search_via_slide_up_launcher"
                    style="@style/SettingSubItemTopStyle"/>
                <obric.widget.ListContentItemText
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    style="@style/ListContentItemStyle.Bottom">
                    <ImageView
                        android:id="@+id/iv_slide_up_launcher_intro"
                        android:background="@drawable/slide_up_launcher_intro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </obric.widget.ListContentItemText>
            </LinearLayout>
            <include
                android:id="@+id/id_voice_top_shadow"
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/id_header_voice_search"
                android:visibility="gone"
                android:text="@string/voice_title"
                style="@style/SettingItemTitleStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/menu_settings_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemSwitch
                    android:id="@+id/menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:smtTitle="@string/menu_mode"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:text="@string/menu_mode_tip_press"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
            <obric.widget.SettingItemText
                android:id="@+id/id_recognize_lang"
                android:visibility="gone"
                style="@style/SettingSubItemSingleStyle"/>
            <TextView
                android:id="@+id/recognition_language_tip"
                android:visibility="gone"
                style="@style/SettingItemTipsStyle"/>
            <include
                android:id="@+id/contact_voice_settings"
                android:visibility="gone"
                layout="@layout/contact_voice_setting_layout"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/id_global_search"
                app:oui_list_item_title="@string/global_search_category_title"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/id_image_search"
                android:visibility="gone"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
