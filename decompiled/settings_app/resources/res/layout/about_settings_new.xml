<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_root_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/header_bg"
                    android:background="@drawable/about_phone_header_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/main_settings_first_item_card_gap"
                    android:layout_marginHorizontal="@dimen/settings_item_horizontal_padding"
                    app:layout_constraintDimensionRatio="1:0.714"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="72dp"
                    android:minHeight="66dp"
                    app:layout_constraintEnd_toEndOf="@+id/header_bg"
                    app:layout_constraintStart_toStartOf="@+id/header_bg"
                    app:layout_constraintTop_toTopOf="@+id/header_bg">
                    <com.obric.oui.text.OTextView
                        android:textSize="48sp"
                        android:id="@+id/tv_product_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_name"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="8dp"
                        android:lineHeight="48dp"
                        android:textFontWeight="600"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="48sp"
                        android:id="@+id/tv_product_name_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_name_sub"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp"
                        android:lineHeight="48dp"
                        android:textFontWeight="320"/>
                </LinearLayout>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/white"
                    android:id="@+id/os_model_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/os_version_tv"
                    app:layout_constraintEnd_toEndOf="@+id/header_bg"
                    app:layout_constraintStart_toStartOf="@+id/header_bg"
                    style="@style/Body_2_Regular"/>
                <com.obric.oui.text.OTextView
                    android:id="@+id/os_version_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    app:layout_constraintBottom_toBottomOf="@+id/header_bg"
                    app:layout_constraintEnd_toEndOf="@+id/header_bg"
                    app:layout_constraintStart_toStartOf="@+id/header_bg"
                    style="@style/Title_2_Medium"/>
                <com.obric.oui.button.OButton
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/update_btn"
                    android:background="@drawable/update_btn_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/go_update"
                    android:drawableStart="@drawable/about_update_icon"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/header_bg"
                    app:layout_constraintStart_toStartOf="@+id/header_bg"
                    app:layout_constraintTop_toBottomOf="@+id/os_model_tv"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/item_container"
                    android:paddingBottom="@dimen/dimen_32"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_bg"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.obric.oui.bouncelayout.OScrollView>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/about_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
