<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <fragment
            android:name="com.android.settings.wfd.WifiDisplaySettings"
            android:id="@+id/wifi_display_settings_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_centerTitle="@string/wifi_display_settings_title"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
    </RelativeLayout>
</LinearLayout>
