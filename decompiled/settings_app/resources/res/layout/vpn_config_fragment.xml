<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/editor"
                android:paddingTop="@dimen/main_settings_first_item_card_gap"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/name"
                    style="@style/OCardListItemInput.Single"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/type"
                    app:ocardlistitem_defaultTailIcon="tail_chevron"
                    app:ocardlistitem_title="@string/vpn_type"
                    style="@style/OCardListItemTextSingle"/>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/server"
                    style="@style/OCardListItemInput.Top"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/user"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/username"
                        style="@style/OCardListItemInput.Mid"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/password"
                        style="@style/OCardListItemInput.Mid"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/save_login"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:visibility="gone"
                    android:layout_marginLeft="15dp"
                    android:text="@string/vpn_save_login"
                    android:singleLine="false"
                    style="@style/vpn_value"/>
                <CheckBox
                    android:id="@+id/mppe"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:visibility="gone"
                    android:layout_marginLeft="15dp"
                    android:text="@string/vpn_mppe"
                    android:singleLine="false"
                    style="@style/vpn_value"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/l2tp"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/l2tp_secret"
                        style="@style/OCardListItemInput.Mid"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/options_ipsec_identity"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/ipsec_identifier"
                        style="@style/OCardListItemInput.Bottom"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ipsec_psk"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/ipsec_secret"
                        style="@style/OCardListItemInput.Bottom"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ipsec_user"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/ipsec_user_cert"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_title="@string/vpn_ipsec_user_cert"
                        style="@style/OCardListItemTextBottom"/>
                </LinearLayout>
                <include layout="@layout/item_sub_settings_padding_layout2"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ipsec_peer"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/ipsec_ca_cert"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_title="@string/vpn_ipsec_ca_cert"
                        style="@style/OCardListItemTextTop"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/ipsec_server_cert"
                        app:ocardlistitem_defaultTailIcon="tail_chevron"
                        app:ocardlistitem_title="@string/vpn_ipsec_server_cert"
                        style="@style/OCardListItemTextBottom"/>
                </LinearLayout>
            </LinearLayout>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_vpn_always_on"
                app:ocardlistitem_title="@string/vpn_always_on"
                style="@style/OCardListItemSwitchSingle"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/tips_vpn_always_on_failed"
                android:layout_marginHorizontal="32dp"
                app:section_des_text="@string/vpn_always_on_failed_prompt_1"
                style="@style/OSectionTitleBar.S"/>
            <include layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/advanced_options"
                app:ocardlistitem_title="@string/vpn_advanced_options"
                style="@style/OCardListItemTextSingle"/>
            <include
                android:id="@+id/delete_btn_top_gap"
                layout="@layout/item_sub_settings_padding_layout2"/>
            <com.obric.oui.button.OButton
                android:textColor="@color/oui_red_6"
                android:id="@+id/delete_btn"
                android:visibility="visible"
                android:clickable="true"
                android:layout_height="@dimen/dimen_64"
                android:text="@string/vpn_menu_delete"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/dimen_12"
                style="@style/OCardListItemCenterItem"/>
            <include layout="@layout/item_bottom_shadow_layout2"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
