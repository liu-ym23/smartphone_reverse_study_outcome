<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/boston_settings"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemText
                android:icon="@drawable/icn_boston_update"
                android:id="@+id/ota"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/boston_ota_title"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                subTitle="@string/boston_ota_subTitle"/>
            <include
                android:id="@+id/ota_gap"
                android:visibility="gone"
                layout="@layout/group_list_item_vertical_gap_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/wireless_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <obric.widget.SettingItemText
                    android:id="@+id/wireless_tnt_auto"
                    android:title="@string/wireless_tnt_auto"
                    style="@style/SettingItemSingleStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
                <obric.widget.SettingItemSwitch
                    android:id="@+id/relay_mode"
                    android:visibility="gone"
                    android:title="@string/relay_mode"
                    style="@style/SettingSubItemSingleStyle"/>
                <TextView
                    android:id="@+id/relay_tips"
                    android:visibility="gone"
                    android:text="@string/relay_mode_tips"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
            <TextView
                android:text="@string/boston_charge_up_phone"
                style="@style/SettingItemTitleStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/charge_always"
                android:text="@string/boston_charge_mode_always"
                style="@style/SettingItemTopStyle"/>
            <com.android.settings.widget.SettingItemCheckSimpleText
                android:id="@+id/charge_custom"
                android:text="@string/boston_charge_mode_custom"
                settings:showArrow="true"
                style="@style/SettingItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/about_boston"
                android:title="@string/about_boston"
                style="@style/SettingItemSingleStyle"/>
            <include layout="@layout/group_list_item_vertical_gap_layout"/>
            <com.obric.oui.button.OButton
                android:id="@+id/reset"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boston_reset_title"
                style="@style/LongButton.Highlight.White"/>
            <TextView
                android:id="@+id/reset_tips"
                android:visibility="gone"
                android:text="@string/boston_reset_tips"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
