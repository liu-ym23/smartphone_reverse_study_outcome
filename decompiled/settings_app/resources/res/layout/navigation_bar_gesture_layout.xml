<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/navigation_bar_gesture_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:text="@string/back_to_launcher_and_multi_task"
        style="@style/OCardListItemLabel"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_navbar_item"
            android:layout_width="match_parent"
            android:layout_height="210dp">
            <com.android.settings.widget.MovieView
                android:layout_gravity="center"
                android:id="@+id/movie_view_overview"
                android:layout_width="281dp"
                android:layout_height="180dp"
                android:src="@raw/home"
                app:mask_src="@drawable/navbar_mode_mask"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:layout_marginTop="16dp"
        android:text="@string/back_to_last_page"
        style="@style/OCardListItemLabel"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_navbar_item"
            android:layout_width="match_parent"
            android:layout_height="210dp">
            <com.android.settings.widget.MovieView
                android:layout_gravity="center"
                android:id="@+id/movie_view_back"
                android:layout_width="match_parent"
                android:layout_height="201dp"
                android:src="@raw/back"
                app:mask_src="@drawable/navbar_mode_mask"/>
        </FrameLayout>
    </FrameLayout>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/hide_nav_handle"
        android:layout_marginTop="16dp"
        app:ocardlistitem_title="@string/hide_navigation_handle"
        style="@style/OCardListItemSwitchSingle"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/app_switch_view"
        android:visibility="gone"
        app:ocardlistitem_title="@string/switch_apps"
        style="@style/OCardListItemSwitchSingle"/>
    <FrameLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <FrameLayout
            android:orientation="vertical"
            android:background="@drawable/o_background_navbar_item"
            android:layout_width="match_parent"
            android:layout_height="210dp">
            <com.android.settings.widget.MovieView
                android:layout_gravity="center"
                android:id="@+id/movie_view_switch"
                android:layout_width="match_parent"
                android:layout_height="188dp"
                android:src="@raw/frame_switch_app"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
