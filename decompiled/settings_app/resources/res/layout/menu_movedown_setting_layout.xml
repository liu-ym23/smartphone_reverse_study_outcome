<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        app:oFloatingTitleBar_centerTitle="@string/menu_move_down_nc"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"
        style="@style/TitleStyle"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemSwitch
                android:id="@+id/move_down_nc"
                android:title="@string/menu_move_down_nc"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:text="@string/scope"
                style="@style/SettingItemTitleStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/move_down_always"
                app:itemTitle="@string/always"
                style="@style/SettingSubItemTopStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/move_down_when_in_launcher"
                app:itemTitle="@string/menu_move_down_when_at_launcher"
                style="@style/SettingSubItemMidStyle"/>
            <obric.widget.SettingItemCheck
                android:id="@+id/move_down_when_in_app"
                app:itemTitle="@string/menu_move_down_when_in_app"
                style="@style/SettingSubItemBottomStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
</RelativeLayout>
