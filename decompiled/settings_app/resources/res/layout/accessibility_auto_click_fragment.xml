<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:paddingBottom="@dimen/settings_container_bottom_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/auto_click"
                app:ocardlistitem_title="@string/accessibility_autoclick_start_service"
                style="@style/OCardListItemSwitchSingle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:layout_marginHorizontal="32dp"
                    app:sectionTitle_titleText="@string/accessibility_autoclick_delay_preference_title"
                    style="@style/OSectionTitleBar.S"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_200"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_200"
                    style="@style/OCardListItemCheckTop"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_300"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_300"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_400"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_400"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_500"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_500"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_600"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_600"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_700"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_700"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_800"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_800"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_900"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_900"
                    style="@style/OCardListItemCheckMid"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/click_delay_1000"
                    app:ocardlistitem_title="@string/accessibility_autoclick_delay_1000"
                    style="@style/OCardListItemCheckBottom"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/accessibility_autoclick_preference_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
