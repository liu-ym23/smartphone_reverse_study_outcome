<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:setting="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/page_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:visibility="gone"
                android:text="@string/unlock_via_face_data"
                style="@style/SettingItemTitleStyle"/>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/oui_p_list_item_2"
                android:paddingRight="@dimen/oui_p_list_item_2"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oui_radius="@dimen/oui_r_l3_rect">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/o_background_list_item"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.obric.oui.checkbox.OCheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/use_fc_in_lock_screen_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="19dp"/>
                    <com.obric.oui.text.OTextView
                        android:textStyle="bold"
                        android:textColor="@color/oui_text_1"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="19dp"
                        android:maxWidth="358dp"
                        android:text="@string/lock_screen"
                        android:maxLines="1"
                        style="@style/Title_Title_M"/>
                </LinearLayout>
            </com.obric.oui.layout.OUILinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/use_fc_in_privacy_password_setting"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/encrypted_launcher"/>
            <include
                android:visibility="gone"
                layout="@layout/item_bottom_shadow_layout"/>
            <TextView
                android:id="@+id/face_data_title_view"
                android:visibility="gone"
                android:text="@string/face_data_options_title"
                style="@style/SettingItemTitleStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/face_data_manage_switch_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/face_data_manage_switch_2"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/face_data_manage_switch_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/face_data_manage_switch_3"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
        </LinearLayout>
    </LinearLayout>
    <com.obric.oui.button.OButton
        android:textColor="#ff3333"
        android:id="@+id/remove_face_data"
        android:background="@drawable/o_background_list_item"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        android:text="@string/remove_face_data"
        android:layout_below="@+id/page_scrollview"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="12dp"
        style="@style/OButton.L1.Standard.Red"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/manage_face_data"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
