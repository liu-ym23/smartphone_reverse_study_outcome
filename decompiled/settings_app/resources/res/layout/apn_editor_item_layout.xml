<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:gravity="center_vertical"
            android:id="@+id/item_text_title"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_item_icon_left_margin"/>
        <TextView
            android:textSize="@dimen/settings_item_sub_title_size"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:gravity="center_vertical"
            android:id="@+id/item_text_sub_title"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_item_icon_left_margin"
            android:layout_marginRight="@dimen/settings_item_icon_right_margin"/>
    </LinearLayout>
</merge>
