<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/f_functional_keys"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/settings_item_top_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <obric.widget.SettingItemSwitch
                android:id="@+id/f_functional_keys"
                android:title="@string/f_functional_keys"
                style="@style/SettingSubItemSingleStyle"/>
            <include layout="@layout/item_bottom_shadow_layout"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f1"
                android:title="@string/f1"
                app:smtTitle="@string/my_search"
                isPressable="false"
                style="@style/SettingSubItemSwitchTopStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f2"
                android:title="@string/f2"
                app:smtTitle="@string/internet_search"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f3"
                android:title="@string/f3"
                app:smtTitle="@string/local_search"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f4"
                android:title="@string/f4"
                app:smtTitle="@string/create_thinkboost"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f5"
                android:title="@string/f5"
                app:smtTitle="@string/send_bullet_mms"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f6"
                android:title="@string/f6"
                app:smtTitle="@string/gallery"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f7"
                android:title="@string/f7"
                app:smtTitle="@string/file_manager"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f8"
                android:title="@string/f8"
                app:smtTitle="@string/quick_phrase_and_clipboard"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f9"
                android:title="@string/f9"
                app:smtTitle="@string/thinkboost_list"
                isPressable="false"
                style="@style/SettingSubItemSwitchMidStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f10"
                android:title="@string/f10"
                app:smtTitle="@string/shortcut_screenshot"
                isPressable="false"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f11"
                android:title="@string/f11"
                isPressable="false"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <obric.widget.SettingItemText
                android:id="@+id/btn_f12"
                android:title="@string/f12"
                isPressable="false"
                style="@style/SettingSubItemSwitchBottomStyle"/>
            <include layout="@layout/scrollview_bottom_gap_layout"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
