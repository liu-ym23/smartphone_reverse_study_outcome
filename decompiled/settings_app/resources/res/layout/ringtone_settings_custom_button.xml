<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/item_bottom_shadow_layout"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/text_make_ringtone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_container"
        app:ocardlistitem_customStart="@layout/layout_card_list_item_custom_start_center_tv_layout"
        app:ocardlistitem_showCardBg="true"/>
    <com.android.settings.widget.SettingItemButton
        android:id="@+id/custom_ringtone_record"
        android:visibility="gone"
        android:text="@string/custom_ringtone_record"
        style="@style/SettingItemButtonStyle.Bottom"/>
</LinearLayout>
