<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedanceos="http://schemas.android.com/apk/res/bytedanceos"
    android:orientation="vertical"
    android:id="@+id/sidekey_settings_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/side_key_header_view"
        android:text="@string/side_key_header"
        style="@style/SettingItemTitleStyle"/>
    <obric.widget.SettingItemText
        android:id="@+id/opposite_key"
        android:title="@string/side_key"
        style="@style/SettingSubItemTopStyle"/>
    <ImageView
        android:id="@+id/opposite_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <obric.widget.SettingItemText
        android:id="@+id/squeezing_key"
        android:title="@string/squeeze_side_buttons"
        style="@style/SettingSubItemTopStyle"/>
    <ImageView
        android:id="@+id/squeezing_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <obric.widget.SettingItemSwitch
        android:id="@+id/one_step_switcher"
        android:title="@string/sidekey_function"
        style="@style/SettingSubItemSingleStyle"/>
    <TextView
        android:id="@+id/one_step_tips"
        android:text="@string/sidekey_function_info"
        style="@style/SettingItemTipsStyle"/>
</LinearLayout>
