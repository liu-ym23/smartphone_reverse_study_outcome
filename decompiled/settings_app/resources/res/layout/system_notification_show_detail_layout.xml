<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:paddingTop="@dimen/main_settings_first_item_card_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/show_detail_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_top"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/lock_screen_notifications_summary_show"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/show_detail_hide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_middle"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/lock_screen_notifications_summary_hide"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/show_detail_disable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_bottom"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/lock_screen_notifications_summary_disable"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/system_notification_lock_screen_notification"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
