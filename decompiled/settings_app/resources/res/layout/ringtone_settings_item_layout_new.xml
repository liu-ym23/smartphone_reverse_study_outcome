<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/title"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginHorizontal="@dimen/dimen_32"
            app:sectionTitle_titleText="@string/volume_ring_only_description"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/ringtone_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_normal"
            app:ocardlistitem_showIcon="false"
            app:ocardlistitem_showTitle="true"
            app:ocardlistitem_title="@string/volume_ring_only_description"/>
    </LinearLayout>
</RelativeLayout>
