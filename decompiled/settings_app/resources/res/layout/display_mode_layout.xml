<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/page_scrollview"
        android:layout_width="@dimen/list_item_maximum_width"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/page_container"
            android:paddingTop="@dimen/main_settings_first_item_card_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/display_light_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_mark"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/display_light_mode"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/display_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_mark"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/display_dark_mode"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/set_time_open_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/time_to_open_dark_mode_tips"
                app:ocardlistitem_title="@string/time_to_open_dark_mode"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/time_open_dark_mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setting_item_gap">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/auto_close_sun_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_mark"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/display_mode_auto_with_sun_detail"
                    app:ocardlistitem_title="@string/display_mode_auto_with_sun"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/auto_close_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_mark"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_title="@string/protect_eyes_custom_title"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/auto_close_custom_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/setting_item_gap">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/display_mode_start_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_top"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_arrow"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/zen_mode_start_time"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/display_mode_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_bottom"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_detail"
                        app:ocardlistitem_defaultTailIcon="tail_arrow"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showIcon="false"
                        app:ocardlistitem_showSubTitle="false"
                        app:ocardlistitem_showTailIcon="true"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/zen_mode_end_time"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <include layout="@layout/title_bar_shadow"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/display_mode"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</RelativeLayout>
