<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="24dp"
                android:width="24dp"/>
            <solid android:color="#14000000"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <size
                android:height="18dp"
                android:width="18dp"/>
            <solid android:color="#ffffff"/>
        </shape>
    </item>
</layer-list>
