<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:drawable="@drawable/red_check_box"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:drawable="@drawable/red_check_box_off"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/red_check_box_disabled"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/red_check_box_off_disabled"/>
</selector>
