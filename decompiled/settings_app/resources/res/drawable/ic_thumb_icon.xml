<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <size
                android:height="20dp"
                android:width="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/oui_line_2"/>
            <size
                android:height="20dp"
                android:width="20dp"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/oui_bg_base_2_2_low_elevation"/>
            <size
                android:height="10dp"
                android:width="10dp"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</layer-list>
