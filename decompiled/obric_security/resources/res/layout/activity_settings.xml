<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/Transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/Transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/oic_bg_single_28"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.titlebar.optimize.OCTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            app:oui_title_text="@string/settings_application"
            app:oui_useBackIcon="false"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OListItemSettings
            android:id="@+id/privacy_policy_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_56"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:oui_list_item_title="@string/privacy_policy"/>
        <com.obric.oui.lisitem.OListItemSettings
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_56"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:oui_list_item_title="个人信息收集清单"/>
        <com.obric.oui.lisitem.OListItemSettings
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_56"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:oui_list_item_title="应用权限管理"/>
        <com.obric.oui.lisitem.OListItemSettings
            android:id="@+id/permission_note"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_56"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/dimen_16"
            app:oui_list_item_title="@string/permission_note"/>
    </LinearLayout>
</LinearLayout>
