<?xml version="1.0" encoding="utf-8"?>
<com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="@string/inner_row_root"
    android:background="@color/inner_common_list_row_c_base_bg_color"
    android:paddingLeft="@dimen/inner_common_list_row_c_base_left_padding"
    android:paddingRight="@dimen/inner_common_list_row_c_base_right_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/inner_common_list_row_c_base_height">
    <ImageView
        android:id="@+id/left_icon"
        android:tag="@string/inner_row_left_image"
        android:background="@drawable/inner_icon_arrow_selector1"
        android:layout_width="@dimen/inner_common_list_row_c_base_icon_width"
        android:layout_height="@dimen/inner_common_list_row_c_base_icon_height"
        android:layout_marginRight="@dimen/inner_common_list_row_c_base_first_text_margin_left"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="@dimen/inner_common_list_row_c_base_first_text_size"
        android:textColor="@color/inner_common_list_row_c_base_first_text_color"
        android:ellipsize="middle"
        android:id="@+id/first_text"
        android:tag="@string/inner_row_first_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/inner_common_list_row_c_base_first_text_margin_right"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/inner_common_list_row_c_base_right_text_size"
        android:textColor="@color/inner_common_list_row_c_base_first_text_color"
        android:gravity="center"
        android:id="@+id/middle_text"
        android:tag="@string/inner_row_third_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/inner_common_dimen_6dp"
        android:layout_weight="0.5"/>
    <TextView
        android:textSize="@dimen/inner_common_list_row_c_base_right_text_size"
        android:textColor="@color/inner_common_list_row_c_base_first_text_color"
        android:gravity="center_vertical"
        android:id="@+id/right_text"
        android:tag="@string/inner_row_right_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout>
