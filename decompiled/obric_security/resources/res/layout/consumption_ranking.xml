<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/consumption_ranking_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_32"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/consumption_ranking_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/inner_common_dimen_20dp"
            android:layout_marginTop="@dimen/dimen_8"
            android:minHeight="16dp"
            android:text="@string/power_rank_label"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.button.OButton
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/clear"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:text="@string/clean_power_high_apps"
            android:maxLines="1"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/consumption_ranking_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/OButtonM1Custom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/consumption_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraint"
        layout="@layout/app_battery_profile"/>
</androidx.constraintlayout.widget.ConstraintLayout>
