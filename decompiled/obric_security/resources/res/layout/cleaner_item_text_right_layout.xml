<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:duplicateParentState="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginRight="@dimen/dimen_12">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/right_text_container"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_text_2"
            android:ellipsize="end"
            android:id="@+id/right_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_marginRight="0dp"
            android:maxLines="1"
            android:lineHeight="20dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow"
            android:duplicateParentState="true"
            android:layout_width="10dp"
            android:layout_height="20dp"
            android:layout_margin="4dp"
            android:src="@drawable/oic_icon_chevron"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/right_btn_container"
        android:background="@drawable/security_item_btn_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="73.5dp"
        android:layout_height="31dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/clear_btn_text_colorlist"
            android:gravity="center"
            android:id="@+id/right_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/right_btn_warn"
            android:background="@drawable/dot_red"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="3dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
