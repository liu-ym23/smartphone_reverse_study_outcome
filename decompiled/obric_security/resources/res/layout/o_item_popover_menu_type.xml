<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.popover.menu.PopoverMenuLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/oui_popover_item_height">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/oui_p_list_item_1"
        android:paddingEnd="@dimen/oui_p_list_item_1">
        <ImageView
            android:id="@+id/iv_popover_action"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/oui_g_list_item_1"
            android:paddingBottom="@dimen/oui_g_list_item_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:ellipsize="end"
                android:id="@+id/tv_popover_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="6"
                style="@style/Title_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_3"
                android:ellipsize="end"
                android:id="@+id/tv_popover_action_sub"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="6"
                style="@style/Subtitle_2_Regular"/>
        </LinearLayout>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/tv_popover_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            style="@style/Label_L"/>
        <RelativeLayout
            android:id="@+id/popover_badge_default"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp">
            <com.obric.oui.badge.OBadgeView
                android:layout_centerInParent="true"
                style="@style/OBadgeView.S1.Default.Red"/>
        </RelativeLayout>
        <com.obric.oui.badge.OBadgeView
            android:id="@+id/popover_badge_number"
            android:visibility="gone"
            android:text="9"
            style="@style/OBadgeView.S1.Number.Red"/>
        <com.obric.oui.badge.OBadgeView
            android:id="@+id/popover_badge_ellipsis"
            android:visibility="gone"
            style="@style/OBadgeView.S1.Ellipsis.Red"/>
        <ImageView
            android:id="@+id/iv_popover_tail_image"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
    </LinearLayout>
</com.obric.oui.popover.menu.PopoverMenuLinearLayout>
