<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homepage_container"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/imagesRecyclerView"
        android:scrollbars="none"
        app:layout_behavior="com.obric.oui.behavior.HomepageAppBarScrollingViewBehavior"
        style="@style/ListViewGeneralStyle"/>
    <View
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="231dp"/>
    <View
        android:background="@drawable/main_gradient_top_to_bottom"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="231dp"
        android:layout_marginHorizontal="@dimen/dimen_16"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:touchscreenBlocksFocus="false"
        android:keyboardNavigationCluster="false">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="231dp"
            app:layout_scrollFlags="exitUntilCollapsed|scroll">
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/app_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax">
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/rotate_pannel_view_container"
                    android:layout_width="328dp"
                    android:layout_height="308dp"/>
            </FrameLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.obric.oui.button.OIconButtonFloating
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/settings"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12"
        android:layout_marginRight="@dimen/dimen_12"
        app:oui_widgetIcon="@drawable/ic_more_vertical"
        style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
