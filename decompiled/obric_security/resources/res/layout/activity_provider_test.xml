<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="40dp">
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:id="@+id/phone_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入手机号"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/insert_phone_db"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="手机号插入白名单表中"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/in_whitelist"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="判断是否在白名单中"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/whitelist_count"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="查询白名单总数"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/whitelist_record"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="查询白名单记录"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/black_count"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="查询黑名单总数"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/black_log_count_add"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="监听电话拦截总数变化"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/insert_blockedcalllog"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="插入一条被拦截的通话记录"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/query_blockedcalllog"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="查询被拦截的通话记录"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/delete_all"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="删除所有拦截的通话记录"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/sms_key_count"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="查询短信关键词拦截总数"/>
        <EditText
            android:id="@+id/id_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入_id"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/delete_by_id"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="删除指定_id的拦截记录"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/delete_by_ids"
            android:background="@color/purple_200"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="删除指定多个_id的拦截记录"/>
    </LinearLayout>
</ScrollView>
