<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/main_view"
        android:paddingTop="@dimen/inner_common_dimen_96dp"
        android:paddingBottom="40dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:paddingTop="16dp"
                style="@style/SettingItemTopStyle2">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/cleaner_scan_activity_head2"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/scan_cache_trash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/scan_uninstall_trash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/scan_ad_trash"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/scan_package_trash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/scan_system_trash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/clean_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">
                <obric.widget.TipsView
                    android:textSize="12.5sp"
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/supported_by"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/supported_by"
                    android:lineHeight="16dp"/>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/memory_junk_file_cleanup"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
