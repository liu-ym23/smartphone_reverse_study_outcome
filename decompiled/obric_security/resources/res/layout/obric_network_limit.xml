<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/obric_power_menu"
    android:background="@android:color/transparent"
    android:visibility="visible"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/obric_dialog_title_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/obric_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:minHeight="22dp"
        android:singleLine="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/obric_dialog_btn_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/obric_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/obric_dialog_red_color"
            android:id="@+id/obric_btn_data_usage_disabled"
            android:background="@drawable/obric_dialog_large_white_btn_bg"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/obric_continue_use_network"
            android:singleLine="true"
            android:outlineProvider="none"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/obric_dialog_btn_text_color"
            android:id="@+id/obric_btn_ok"
            android:background="@drawable/obric_dialog_large_white_btn_bg"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/obric_dialog_ok"
            android:singleLine="true"
            android:outlineProvider="none"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    </LinearLayout>
</LinearLayout>
