<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/item_title_summary_text_size"
        android:textStyle="bold"
        android:textColor="@color/item_title_summary_text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/phone_contact_permission_title"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_call_phone"
        android:onClick="onClick"
        app:oui_list_item_title="@string/call_phone"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_read_phone_state"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_read_phone_state"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_read_call_log"
        android:onClick="onClick"
        app:oui_list_item_title="@string/read_call_log"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_write_call_log"
        android:onClick="onClick"
        app:oui_list_item_title="@string/write_call_log"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_read_contacts"
        android:onClick="onClick"
        app:oui_list_item_title="@string/read_contacts"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_write_contacts"
        android:onClick="onClick"
        app:oui_list_item_title="@string/write_contacts"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_getaccounts"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_getaccounts"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_sip"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_sip"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_outgoing_call"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_outgoing_call"
        style="@style/OSettingItemNoIconStyle"/>
</merge>
