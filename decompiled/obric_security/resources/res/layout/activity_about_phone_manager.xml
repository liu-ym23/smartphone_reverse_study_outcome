<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_about_phone_manager"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/constraint_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_common_dimen_96dp"
                app:layout_constraintTop_toTopOf="parent">
                <com.obric.oui.image.OImageAppIcon
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_app_secure"
                    android:layout_width="@dimen/inner_common_dimen_72dp"
                    android:layout_height="@dimen/inner_common_dimen_72dp"
                    android:layout_marginTop="@dimen/inner_common_dimen_8dp"
                    android:src="@drawable/app_icon"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:gravity="center"
                    android:id="@+id/tv_security_manager"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="@dimen/inner_common_dimen_20dp"
                    android:text="@string/security_manager"
                    style="@style/Title_4_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:gravity="center"
                    android:id="@+id/tv_version"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:layout_marginTop="@dimen/inner_common_dimen_12dp"
                    android:layout_marginBottom="@dimen/inner_common_dimen_24dp"
                    android:text="@string/version_text"
                    style="@style/Body_1_Regular"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/privacy_policy_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/constraint_layout"
                app:ocardlistitem_title="@string/privacy_policy"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/permission_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/privacy_policy_text"
                app:ocardlistitem_title="@string/permission_note"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/third_party_SDK_dir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/permission_note"
                app:ocardlistitem_title="@string/third_party_SDK_dir"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/debug_setting_entry"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/third_party_SDK_dir"
                app:ocardlistitem_title="Debug Page"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
