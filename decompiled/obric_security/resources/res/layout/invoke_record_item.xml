<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/callee_icon"
        android:layout_width="@dimen/list_item_app_iconsize"
        android:layout_height="@dimen/list_item_app_iconsize"
        android:layout_marginLeft="@dimen/list_item_margin_right"
        android:layout_marginRight="@dimen/list_item_space"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/callee_icon"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/group_item_text_size"
            android:textColor="@color/text_color_group_item"
            android:ellipsize="end"
            android:id="@+id/invoke_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/list_item_margin_right"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_above_summary">
            <TextView
                android:textSize="@dimen/text_size_small_extra"
                android:textColor="@color/text_color_list_summary"
                android:ellipsize="end"
                android:id="@+id/invoke_date"
                android:layout_width="@dimen/invoke_date_width"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/text_size_small_extra"
                android:textColor="@color/text_color_list_summary"
                android:ellipsize="end"
                android:id="@+id/invoke_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/list_item_space"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/text_size_small_extra"
                android:textColor="@color/text_color_list_summary"
                android:ellipsize="end"
                android:id="@+id/invoke_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
