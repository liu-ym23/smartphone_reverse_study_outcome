<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_height="wrap_content"
        bytedance:oFloatingTitleBar_centerTitle="@string/data_usage_title"
        bytedance:oFloatingTitleBar_maskBlurRadius="8"
        bytedance:oui_widgetFitInsetTop="true"
        style="@style/TitleStyle"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:layout_gravity="center_horizontal"
            android:id="@+id/data_usage_header_scrollview"
            android:paddingTop="104dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="always">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/data_usage_header_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/data_usage_alarm_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bytedance:ocardlistitem_defaultCustomEnd="end_switch"
                    bytedance:ocardlistitem_subTitle="@string/data_usage_limit_tips2"
                    bytedance:ocardlistitem_title="@string/data_usage_alarm"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/data_usage_limit_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bytedance:ocardlistitem_endDetailText="@string/data_usage_limit_unset"
                    bytedance:ocardlistitem_title="@string/data_usage_limit"/>
            </LinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
        <com.obric.oui.bouncelayout.OListView
            android:id="@+id/data_usage_sort_list"
            android:paddingTop="104dp"
            android:paddingBottom="@dimen/inner_common_dimen_24dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:smoothScrollbar="false"
            style="@style/ListViewGeneralStyle"/>
        <include
            android:id="@+id/empty_view"
            layout="@layout/loading_view"/>
    </LinearLayout>
</RelativeLayout>
