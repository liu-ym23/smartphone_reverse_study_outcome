<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/fan_size"
        android:layout_height="@dimen/fan_size">
        <com.bytedanceos.rotateview.RotateFanView
            android:id="@+id/rotate_fan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/scanning_pie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/scanning_pie"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/scanning_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedanceos.rotateview.ScrollingNumbersView
                android:id="@+id/scanning_progress"
                android:paddingLeft="@dimen/scanning_number_horizontal_padding"
                android:paddingRight="@dimen/scanning_number_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/scanning_number_top_margin"
                android:alpha="0"
                bytedance:adjustSubTextThreshold="3"
                bytedance:alignment="center"
                bytedance:lineSpacingMultiplier="2"
                bytedance:maxDigits="3"
                bytedance:singleNumberWidthMultiplier="1.2"
                bytedance:subText="%"
                bytedance:subTextSize="@dimen/scanning_sub_size"
                bytedance:textColor="@android:color/black"
                bytedance:textSize="@dimen/scanning_number_size"
                bytedance:textStyle="bold"/>
            <TextView
                android:textSize="@dimen/scanning_text_size"
                android:textStyle="bold"
                android:id="@+id/scanning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/scanning_text_top_margin"
                android:text="@string/scaning"
                android:alpha="0"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/clean_done_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/clean_accomplish"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/score_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0">
            <com.bytedanceos.rotateview.ScrollingNumbersView
                android:id="@+id/score_number"
                android:paddingLeft="@dimen/score_number_horizontal_padding"
                android:paddingRight="@dimen/score_number_horizontal_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/score_number_top_margin"
                android:layout_marginBottom="@dimen/score_number_bottom_margin"
                bytedance:adjustSubTextThreshold="3"
                bytedance:alignment="center"
                bytedance:lineSpacingMultiplier="2"
                bytedance:maxDigits="3"
                bytedance:singleNumberWidthMultiplier="1.2"
                bytedance:subText="@string/unit_grad"
                bytedance:subTextSize="@dimen/score_sub_size"
                bytedance:textColor="@android:color/holo_red_light"
                bytedance:textSize="@dimen/score_number_size"
                bytedance:textStyle="bold"/>
            <TextView
                android:textSize="@dimen/score_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/holo_red_light"
                android:id="@+id/score_text"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/score_text_top_margin"
                android:text="@string/onestep_optimize"/>
        </LinearLayout>
    </FrameLayout>
</merge>
