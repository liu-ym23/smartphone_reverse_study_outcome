<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/security_no_disturb"/>
    <com.obric.oui.segmentedtab.OTabSegmentedLayout
        android:id="@+id/cycle_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_m2"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dimen_12"
        app:bar_color="@color/oui_fill_sunken_variable"
        app:bar_stroke_color="@color/Transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_bg_base_3_high_elevation"
        app:indicator_corner_radius="@dimen/oui_r_m1"
        app:indicator_height="@dimen/oui_h_m1"
        app:indicator_spacing="4dp"
        app:tab_textBold="SELECT"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textSize="14dp"
        app:tab_textUnselectColor="@color/oui_text_3"/>
    <FrameLayout
        android:id="@+id/id_fragment_disturb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cycle_view"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
