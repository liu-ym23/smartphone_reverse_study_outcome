<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/cache_item"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/list_item_app_iconsize"
        android:layout_height="@dimen/list_item_app_iconsize"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/list_item_margin_right"
        android:layout_marginEnd="@dimen/settings_list_item_icon_margin_right"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/icon">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/cache_text_max_width"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_size_small_extra"
            android:textColor="@color/setting_item_summary_text_color"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_above_summary"
            android:maxWidth="@dimen/cache_text_max_width"
            android:singleLine="true"/>
    </LinearLayout>
    <com.obric.oui.checkbox.OCheckBoxSecurity
        android:id="@+id/cache_item_cb"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginRight="19dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_text_3"
        android:ellipsize="end"
        android:id="@+id/size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/cache_item_cb"
        android:layout_centerVertical="true"/>
</RelativeLayout>
