<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/common_top_b1_root_view"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/inner_common_dimen_120dp">
        <TextView
            android:textSize="@dimen/inner_common_font_size_m"
            android:textColor="@color/inner_common_text_color_10"
            android:id="@+id/common_top_b1_size_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_common_dimen_42dp"/>
        <TextView
            android:textSize="@dimen/inner_common_font_size_e"
            android:textColor="@color/inner_common_text_color_10"
            android:gravity="center"
            android:id="@+id/common_top_b1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_common_dimen_6dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/inner_common_font_size_e"
            android:textColor="@color/inner_common_text_color_10"
            android:id="@+id/common_top_b1_size_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/inner_common_dimen_12dp"
            android:layout_toRightOf="@+id/common_top_b1_size_number"
            android:layout_alignTop="@+id/common_top_b1_size_number"/>
        <TextView
            android:textSize="@dimen/inner_common_font_size_e"
            android:textColor="@color/inner_common_text_color_10"
            android:id="@+id/common_top_b1_right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/inner_common_dimen_12dp"
            android:layout_toRightOf="@+id/common_top_b1_size_number"
            android:layout_alignBottom="@+id/common_top_b1_size_number"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/inner_common_font_size_f"
        android:textColor="@color/inner_common_text_color_10"
        android:gravity="center"
        android:id="@+id/common_top_b1_bottom_text_center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inner_common_dimen_30dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="@dimen/inner_common_font_size_f"
        android:textColor="@color/inner_common_text_color_10"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/common_top_b1_bottom_text_left"
        android:background="@color/inner_common_bg_color_2_a19"
        android:paddingLeft="@dimen/inner_common_dimen_18dp"
        android:paddingRight="@dimen/inner_common_dimen_18dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inner_common_dimen_30dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"/>
</merge>
