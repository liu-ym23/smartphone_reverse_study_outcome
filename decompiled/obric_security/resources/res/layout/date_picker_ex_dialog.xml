<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:obric="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.MenuDialogTitleBar
        android:id="@+id/menu_dialog_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        obric:show_divider="false"/>
    <obric.widget.DatePickerEx
        android:id="@+id/date_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
