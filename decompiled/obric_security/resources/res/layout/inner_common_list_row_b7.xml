<?xml version="1.0" encoding="utf-8"?>
<com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="@string/inner_row_root"
    android:background="@color/inner_common_list_row_b_base_bg_color"
    android:paddingLeft="@dimen/inner_common_list_row_b_base_left_padding"
    android:paddingRight="@dimen/inner_common_list_row_b_base_right_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/inner_common_list_row_b_base_height">
    <ImageView
        android:id="@+id/left_icon"
        android:tag="@string/inner_row_left_image"
        android:layout_width="@dimen/inner_common_list_row_b_base_icon_width"
        android:layout_height="@dimen/inner_common_list_row_b_base_icon_height"
        android:layout_marginRight="@dimen/inner_common_list_row_b_base_icon_margin_right"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/inner_common_list_row_b_base_first_text_size"
            android:textColor="@color/inner_common_list_row_b_base_first_text_color"
            android:ellipsize="middle"
            android:id="@+id/first_text"
            android:tag="@string/inner_row_first_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row_B7"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <ImageView
            android:ellipsize="middle"
            android:id="@+id/right_arrow"
            android:tag="@string/inner_row_arrow_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/inner_common_dimen_12dp"
            android:src="@drawable/inner_icon_arrow_selector2"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/inner_common_list_row_b_base_right_text_size"
        android:textColor="@drawable/inner_row_text_color_selector"
        android:gravity="center_vertical"
        android:id="@+id/right_text"
        android:tag="@string/inner_row_right_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/inner_common_list_row_b_base_right_padding_minus">
        <ImageView
            android:id="@+id/right_selected"
            android:tag="@string/inner_row_select_view"
            android:paddingLeft="@dimen/inner_common_list_row_b_base_right_text_margin"
            android:paddingRight="@dimen/inner_common_list_row_b_base_right_padding"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/inner_row_checkbox1_selector"
            android:layout_centerVertical="true"/>
        <ImageView
            android:tag="@string/inner_row_loading_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/inner_common_list_row_b_base_right_text_margin"
            android:src="@drawable/inner_common_icon_loading"
            android:layout_centerVertical="true"/>
        <View
            android:layout_width="@dimen/inner_common_list_row_b_base_right_padding"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout>
