<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/inner_common_dialog_base_content_center_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/inner_common_dialog_base_content_summary_size"
        android:textColor="@color/inner_common_dialog_base_content_text_color_summary_gray"
        android:id="@+id/common_dialog_center_text"
        android:paddingTop="@dimen/inner_common_dialog_base_content_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:layout_marginRight="@dimen/inner_common_dialog_base_text_left_right_padding"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/common_dialog_style_2_summary"
        android:paddingTop="@dimen/inner_common_dialog_base_content_center_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:layout_marginRight="@dimen/inner_common_dialog_base_text_left_right_padding">
        <TextView
            android:textSize="@dimen/common_dialog_base_content_suggest_size"
            android:textColor="@color/inner_common_dialog_base_content_text_color_summary_gray"
            android:ellipsize="middle"
            android:id="@+id/common_dialog_style_2_first_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/common_dialog_base_content_suggest_size"
            android:textColor="@color/inner_common_dialog_base_content_text_color_summary_gray"
            android:ellipsize="end"
            android:id="@+id/common_dialog_style_2_second_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_common_dimen_1dp"
            android:maxLines="3"/>
    </LinearLayout>
    <com.qihoo360.mobilesafe.common.ui.textview.CommonCheckBoxTextView
        android:id="@+id/common_dialog_style_2_check_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:layout_marginTop="@dimen/inner_common_dialog_base_content_center_padding"
        android:layout_marginRight="@dimen/inner_common_dialog_base_text_left_right_padding"
        app:checked_pref="false"/>
</LinearLayout>
