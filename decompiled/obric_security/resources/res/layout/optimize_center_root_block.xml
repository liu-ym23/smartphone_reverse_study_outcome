<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/optimize_scroll"
        android:paddingTop="112dp"
        android:paddingBottom="104dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <com.obric.oui.layout.OUILinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/optimize_content"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/optimize_panel_container"
                android:layout_width="match_parent"
                android:layout_height="232dp"
                android:layout_marginTop="8dp">
                <FrameLayout
                    android:id="@+id/optimize_rotate_panel_container"
                    android:layout_width="212dp"
                    android:layout_height="212dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/optimize_running_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/optimize_result_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.obric.oui.layout.OUILinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.actionbar.v2.OBottomActionBarNormalHorizontal
        android:layout_gravity="bottom"
        android:id="@+id/optimize_footer"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
