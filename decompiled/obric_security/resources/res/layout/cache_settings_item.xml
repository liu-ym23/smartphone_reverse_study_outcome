<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cache_item_relative"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/inner_common_dimen_64dp">
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:layout_width="@dimen/list_item_app_iconsize"
                android:layout_height="@dimen/list_item_app_iconsize"
                android:scaleType="centerInside"
                android:contentDescription="@null"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_1"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/inner_common_dimen_64dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title_Title_M"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_title_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/size"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/inner_common_dimen_64dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/apk_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon_container"
            style="@style/Title_Title_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="@dimen/cache_text_max_width"
            android:singleLine="true"
            style="@style/Label_M_Thin"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_text_3"
        android:ellipsize="end"
        android:id="@+id/size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/cache_item_cb"
        android:layout_centerVertical="true"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cache_item_cb"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.checkbox.OCheckBoxSecurity
        android:id="@+id/cache_item_cb"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="19dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
