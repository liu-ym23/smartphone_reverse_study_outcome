<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/risk_app_list_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/risk_control_list_card_top_margin"
        android:layout_alignParentBottom="true">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/risk_app_list_recycler_view"
            android:paddingTop="@dimen/risk_control_list_card_padding"
            android:paddingBottom="@dimen/risk_control_list_bottom_padding"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"
            android:nestedScrollingEnabled="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/risk_app_list_empty"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/risk_app_list_empty_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">
            <com.obric.oui.text.OTextView
                android:textSize="@dimen/risk_control_empty_title_size"
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/risk_app_list_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_controlled_apps"
                style="@style/Body_1_Medium"/>
            <com.obric.oui.text.OTextView
                android:textSize="@dimen/risk_control_empty_desc_size"
                android:textColor="@color/oui_text_3b"
                android:gravity="center"
                android:id="@+id/risk_app_list_empty_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/risk_control_empty_desc_margin_top"
                android:text="@string/controlled_apps_tip"
                style="@style/Body_2_Regular"/>
        </LinearLayout>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/controlled_risk_apps"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
