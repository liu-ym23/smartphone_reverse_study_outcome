<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/head_area"
    android:paddingLeft="@dimen/dimen_12"
    android:paddingTop="@dimen/inner_common_dimen_96dp"
    android:paddingRight="@dimen/dimen_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/memory_header_content"
        android:background="@drawable/oic_bg_single"
        android:padding="@dimen/inner_common_dimen_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginBottom="@dimen/dimen_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/scanning_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Display_2_Medium"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/tv_used_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" GB"
            app:layout_constraintBaseline_toBaselineOf="@+id/scanning_size"
            app:layout_constraintStart_toEndOf="@+id/scanning_size"
            style="@style/Subtitle_3_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/memory_available_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/memory_available"
            android:maxLines="1"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/scanning_size"
            app:layout_constraintEnd_toStartOf="@+id/tv_detail"
            app:layout_constraintStart_toEndOf="@+id/tv_used_unit"
            style="@style/Subtitle_3_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/tv_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@+id/scanning_size"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Subtitle_3_Regular"/>
        <com.bytedanceos.oui.MultiSegmentProgressBar
            android:id="@+id/storage_progress"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/inner_common_dimen_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scanning_size"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
