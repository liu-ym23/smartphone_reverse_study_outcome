<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/item_title_summary_text_size"
        android:textStyle="bold"
        android:textColor="@color/item_title_summary_text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/other_group_title"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_voicemail"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_voicemail"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_sensor"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_sensor"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_body"
        android:visibility="gone"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_body"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_install_unknown_app"
        android:onClick="onClick"
        app:oui_list_item_title="@string/install_unknown_app"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_write_settings"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_write_settings"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_manage_notification_access"
        android:onClick="onClick"
        app:oui_list_item_title="@string/manage_notification_access"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_notification_policy_access_settings"
        android:onClick="onClick"
        app:oui_list_item_title="@string/manage_zen_access_title"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_start_on_background"
        android:onClick="onClick"
        app:oui_list_item_title="@string/start_on_background"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_system_alert_window"
        android:onClick="onClick"
        app:oui_list_item_title="@string/system_alert_window"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_show_on_keyguard"
        android:onClick="onClick"
        app:oui_list_item_title="@string/show_on_keyguard"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_kill_background_processes"
        android:onClick="onClick"
        app:oui_list_item_title="@string/kill_background_processes"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_write_history_bookmarks"
        android:onClick="onClick"
        app:oui_list_item_title="@string/write_history_bookmarks"
        style="@style/OSettingItemNoIconStyle"/>
</merge>
