<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.ShadowFrameLayout
        android:id="@+id/clean_button_container"
        android:background="#ffffffff"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        bytedance:bottom_type="true">
        <obric.widget.ShadowButton
            android:layout_gravity="center"
            android:id="@+id/clean_button"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:text="@string/clear_text"
            style="@style/LongButton.Shrink.Highlight"/>
    </obric.widget.ShadowFrameLayout>
</RelativeLayout>
