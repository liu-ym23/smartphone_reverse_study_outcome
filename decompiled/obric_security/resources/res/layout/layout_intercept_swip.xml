<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/bottom_wrapper"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">
    <com.obric.oui.button.OIconButton
        android:id="@+id/scroll_unblock_btn"
        android:clickable="true"
        android:src="@drawable/icon_backcalllog"
        style="@style/OStyleV2.OIconButton.M.Standard.Neutral"/>
    <com.obric.oui.button.OIconButton
        android:id="@+id/scroll_del_btn"
        android:clickable="true"
        android:src="@drawable/oic_trashcan_red"
        android:layout_marginStart="8dp"
        style="@style/OStyleV2.OIconButton.M.Standard.Red_Light"/>
</LinearLayout>
