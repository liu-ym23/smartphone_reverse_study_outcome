<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="56dp"
    android:scrollbars="none"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/type_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="98dp">
            <FrameLayout
                android:id="@+id/junk_files_cleanup"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dimen_4"/>
            <FrameLayout
                android:id="@+id/memory_completely_cleanup"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginTop="@dimen/dimen_8">
            <FrameLayout
                android:id="@+id/battery_optimization"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dimen_4"/>
            <FrameLayout
                android:id="@+id/application_manager"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginTop="@dimen/dimen_8">
            <FrameLayout
                android:id="@+id/item_storage"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dimen_4"/>
            <FrameLayout
                android:id="@+id/prevent_disturb"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_4"/>
        </LinearLayout>
    </LinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
