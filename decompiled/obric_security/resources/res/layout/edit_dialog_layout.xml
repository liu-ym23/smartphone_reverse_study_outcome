<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_2"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Body_M"/>
    <com.obric.oui.forms.OInputView
        android:id="@+id/input_view"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:oui_inputHeight="120dp"
        app:oui_inputLabel="label"
        app:oui_inputMode="text"
        app:oui_showLabel="false"
        app:oui_showLabelIcon="false"/>
</LinearLayout>
