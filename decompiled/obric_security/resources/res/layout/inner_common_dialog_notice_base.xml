<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/common_dialog_bg"
    android:paddingLeft="@dimen/inner_common_dialog_base_bg_left_right_padding"
    android:paddingTop="@dimen/inner_common_dialog_base_bg_top_bottom_padding"
    android:paddingRight="@dimen/inner_common_dialog_base_bg_left_right_padding"
    android:paddingBottom="@dimen/inner_common_dialog_base_bg_top_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/inner_common_dialog_base_dialog_left_right_padding"
    android:layout_marginRight="@dimen/inner_common_dialog_base_dialog_left_right_padding"
    android:minWidth="324dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/common_dialog_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/common_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/inner_common_dialog_base_title_height">
            <TextView
                android:textSize="@dimen/inner_common_dialog_base_title_text_size"
                android:textColor="@color/common_dialog_base_content_text_color_blue"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:id="@+id/common_dialog_title_text"
                android:paddingLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
                android:paddingRight="@dimen/inner_common_dialog_base_text_left_right_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/inner_common_dimen_47dp"
                android:maxEms="15"
                android:singleLine="true"/>
            <ImageView
                android:id="@+id/common_dialog_title_right_top_close"
                android:paddingLeft="@dimen/inner_common_dialog_base_right_top_close_padding"
                android:paddingTop="@dimen/inner_common_dialog_base_right_top_close_padding"
                android:paddingRight="@dimen/inner_common_dialog_base_right_top_close_padding"
                android:paddingBottom="@dimen/inner_common_dialog_base_right_top_close_padding"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/inner_icon_close_selector"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:contentDescription="@string/common_close"/>
            <View
                android:background="@color/inner_common_dialog_base_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/inner_common_dialog_base_divider_view_padding"
                android:layout_marginRight="@dimen/inner_common_dialog_base_divider_view_padding"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/common_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/inner_common_dialog_base_button_height">
            <com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleButton
                android:textSize="@dimen/inner_common_dialog_base_button_text_size"
                android:textColor="@color/inner_common_dialog_base_button_text_color_gray"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/common_dialog_button_left"
                android:tag="@string/inner_dialog_btn_left_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_cancel"
                android:maxEms="7"
                android:singleLine="true"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/common_dialog_button_center_divider"
                android:background="@color/inner_common_dialog_base_divider_color"
                android:layout_width="1px"
                android:layout_height="@dimen/inner_common_dialog_base_bottom_center_divider_height"/>
            <com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleButton
                android:textSize="@dimen/inner_common_dialog_base_button_text_size"
                android:textColor="@color/inner_common_dialog_base_button_text_color_blue"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/common_dialog_button_right"
                android:tag="@string/inner_dialog_btn_right_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_confirm"
                android:maxEms="7"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/inner_common_dialog_base_remind_text_size"
        android:textColor="@color/inner_common_dialog_base_remind_text_color"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:id="@+id/common_dialog_remind_row"
        android:background="@color/inner_common_dialog_base_remind_bg_color"
        android:paddingLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inner_common_dialog_base_remind_view_height"
        android:layout_marginTop="34dp"
        android:singleLine="true"/>
</FrameLayout>
