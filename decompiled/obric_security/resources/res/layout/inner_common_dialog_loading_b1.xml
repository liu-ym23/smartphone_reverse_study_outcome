<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/common_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/inner_common_font_size_e"
        android:textColor="@color/inner_common_text_color_1"
        android:id="@+id/common_dialog_center_text"
        android:paddingTop="@dimen/inner_common_dialog_base_content_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:layout_marginRight="@dimen/inner_common_dialog_base_text_left_right_padding"
        android:layout_marginBottom="@dimen/inner_common_dimen_30dp"/>
    <com.qihoo360.mobilesafe.common.ui.loading.CommonHorizonLoading
        android:id="@+id/common_dialog_b1_loading_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inner_common_dimen_6dp"/>
</LinearLayout>
