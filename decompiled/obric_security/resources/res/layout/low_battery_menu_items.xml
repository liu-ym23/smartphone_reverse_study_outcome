<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:paddingTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/percent_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:oui_list_item_show_background="false"
            app:oui_list_item_show_divider="true"
            app:oui_list_item_title="10%"
            app:oui_list_item_trailing_image="@drawable/o_ic_confirm"/>
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/percent_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:oui_list_item_show_background="false"
            app:oui_list_item_show_divider="true"
            app:oui_list_item_title="20%"
            app:oui_list_item_trailing_image="@drawable/o_ic_confirm"/>
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/percent_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:oui_list_item_show_background="false"
            app:oui_list_item_show_divider="true"
            app:oui_list_item_title="30%"
            app:oui_list_item_trailing_image="@drawable/o_ic_confirm"/>
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/percent_40"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:oui_list_item_show_background="false"
            app:oui_list_item_show_divider="true"
            app:oui_list_item_title="40%"
            app:oui_list_item_trailing_image="@drawable/o_ic_confirm"/>
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/percent_50"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:oui_list_item_title="50%"
            app:oui_list_item_trailing_image="@drawable/o_ic_confirm"/>
    </LinearLayout>
</RelativeLayout>
