<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oui_title_text="@string/app_permission_detail"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/main_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/permissions_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/app_snippet"
                layout="@layout/manage_applications_item"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/security_settings_billing_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/security_settings_billing_desc"
                    android:text="@string/security_settings_billing_desc"
                    style="@style/SettingItemTipsStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_text_1"
                    android:gravity="center"
                    android:id="@+id/security_settings_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_settings_desc"
                    android:paddingStart="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/security_settings_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
