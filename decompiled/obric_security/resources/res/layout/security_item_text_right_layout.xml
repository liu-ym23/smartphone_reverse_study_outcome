<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:duplicateParentState="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/right_text_container"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="9dp"
        android:maxWidth="102dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/setting_item_summary_text_colorlist"
            android:ellipsize="end"
            android:id="@+id/right_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#33000000"
            android:shadowDy="-1"
            android:shadowRadius="0"/>
        <ImageView
            android:id="@+id/arrow"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_list_content_item_arrow"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/right_btn_container"
        android:paddingRight="12dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/right_btn"
            android:background="@drawable/security_item_btn_bg"
            android:duplicateParentState="true"
            android:layout_width="73.5dp"
            android:layout_height="31dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/clear_btn_normal_textcolor"
                android:gravity="center"
                android:id="@+id/right_btn_text"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <View
                android:id="@+id/right_btn_warn"
                android:background="@drawable/dot_red"
                android:visibility="gone"
                android:duplicateParentState="true"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="3dp"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/right_checkbox_container"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4.5dp">
        <obric.widget.SwitchEx
            android:id="@+id/switchex"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
