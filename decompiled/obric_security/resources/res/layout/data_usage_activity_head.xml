<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/top_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/oic_bg_single"
        android:padding="@dimen/inner_common_dimen_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_marginHorizontal="@dimen/dimen_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/inner_common_dimen_8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/inner_common_dimen_8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/data_usage_left_tv"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="--"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Display_2_Medium"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/tv_used_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GB"
                app:layout_constraintBaseline_toBaselineOf="@+id/data_usage_left_tv"
                app:layout_constraintStart_toEndOf="@+id/data_usage_left_tv"
                style="@style/Subtitle_3_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/memory_available_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/memory_available"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_used_unit"
                app:layout_constraintStart_toEndOf="@+id/tv_used_unit"
                style="@style/Subtitle_3_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- GB"
                app:layout_constraintBaseline_toBaselineOf="@+id/data_usage_left_tv"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Subtitle_3_Regular"/>
            <com.bytedanceos.oui.MultiSegmentProgressBar
                android:id="@+id/storage_progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginTop="@dimen/inner_common_dimen_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/data_usage_left_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.obric.oui.text.OTextView
            android:textSize="@dimen/inner_common_dimen_20dp"
            android:textColor="@color/oui_text_3"
            android:gravity="center"
            android:id="@+id/data_usage_no_card"
            android:layout_width="wrap_content"
            android:layout_height="348dp"
            android:text="@string/data_usage_no_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Display_1_Medium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_barChart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_month_used_label_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_common_dimen_10dp"
                android:text="@string/data_usage_month_title"
                android:layout_marginStart="@dimen/inner_common_dimen_8dp"
                android:lineHeight="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Subtitle_3_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/data_usage_left_tv_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_common_dimen_8dp"
                android:text="0 "
                app:layout_constraintStart_toStartOf="@+id/tv_month_used_label_chart"
                app:layout_constraintTop_toBottomOf="@+id/tv_month_used_label_chart"
                style="@style/Display_1_Medium"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:id="@+id/tv_used_unit_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B"
                android:layout_marginStart="2dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/data_usage_left_tv_chart"
                app:layout_constraintStart_toEndOf="@+id/data_usage_left_tv_chart"
                style="@style/Display_1_Medium"/>
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="244dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="@dimen/inner_common_dimen_10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/data_usage_left_tv_chart"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/data_usage_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/datausage_item_more_view"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/see_all"/>
    </LinearLayout>
</LinearLayout>
