<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/power_usage_battery_percentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_title="@string/power_usage_battery_percentage"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/power_saver_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_title="@string/power_usage_save_mode"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/auto_enable_saver_mode_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_title="@string/low_battery_auto_enable"/>
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="24dp"
        app:sectionTitle_titleText="@string/power_usage_battery_use_optimization"
        style="@style/OSectionTitleBar.S"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/smart_power_saving_5g"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_subTitle="@string/fiveg_optimize_tips"
        app:ocardlistitem_title="@string/fiveg_optimize"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/screen_power_optimize"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:ocardlistitem_title="@string/screen_power_optimize"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_text_3"
        android:id="@+id/screen_power_optimize_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginBottom="@dimen/dimen_4"
        android:text="@string/screen_power_optimize_tips2"
        android:layout_marginStart="@dimen/dimen_16"
        android:lineHeight="@dimen/dimen_16"
        android:textFontWeight="400"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/auto_sleep_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        app:ocardlistitem_title="@string/auto_sleep_mode"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_text_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginBottom="@dimen/inner_common_dimen_24dp"
        android:text="@string/auto_sleep_mode_tip2"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:lineHeight="@dimen/dimen_16"
        android:textFontWeight="400"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/battery_health_and_charging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:ocardlistitem_title="@string/battery_health_and_charging"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/app_network_control_settings"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20"
        android:layout_marginBottom="@dimen/dimen_20"
        app:ocardlistitem_title="@string/network_background_control_title"/>
</LinearLayout>
