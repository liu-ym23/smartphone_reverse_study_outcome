<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIRelativeLayout
        android:background="@color/oui_fill_list_item_card"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_radius="16dp">
        <FrameLayout
            android:id="@+id/icon_container"
            android:duplicateParentState="true"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <com.obric.oui.button.OIconButton
                android:layout_gravity="center"
                android:id="@+id/iv_content_img"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@color/transparent"
                android:scaleType="centerCrop"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                app:oui_layout_borderColor="@color/oui_line_2"
                app:oui_layout_borderWidth="0.6dp"
                app:oui_radius="18dp"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/iv_doppleganger_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="11dp"
                android:src="@color/transparent"
                android:layout_marginEnd="11dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/trailing_switch"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:ellipsize="end"
                android:id="@+id/tv_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="358dp"
                android:maxLines="1"
                style="@style/Title_Title_M"/>
            <TextView
                android:textSize="12.5sp"
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_content_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="16dp"/>
        </LinearLayout>
        <com.obric.oui.oswitch.OSwitch
            android:id="@+id/trailing_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </com.obric.oui.layout.OUIRelativeLayout>
</merge>
