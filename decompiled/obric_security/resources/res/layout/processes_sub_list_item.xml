<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/sub_item_head_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:id="@+id/processes_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:show_arrow="false">
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/oui_r_l1_rect"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@null"/>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/iv_doppleganger_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginBottom="14dp"
                android:src="@color/transparent"
                android:layout_marginEnd="14dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/memory_clean_item_persist_max_width"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon_container"
            android:layout_centerVertical="true"
            android:lineHeight="22dp"/>
        <FrameLayout
            android:id="@+id/button_contain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <com.obric.oui.checkbox.OCheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/processes_item_cb"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:layout_marginHorizontal="7dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/task_persist"
                android:background="@drawable/ic_pin_task"
                android:visibility="gone"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_alignLeft="@+id/processes_item_cb"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/button_contain"
            android:layout_centerVertical="true"
            android:lineHeight="20dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/sub_item_bottom_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>
