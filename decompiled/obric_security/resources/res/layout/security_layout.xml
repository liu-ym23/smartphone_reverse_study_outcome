<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        app:oui_title_text="@string/security_center"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/title_bar"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:paddingTop="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/list_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                style="@style/SettingItemSingleStyle2">
                <RelativeLayout
                    android:id="@+id/main_head"
                    android:layout_width="match_parent"
                    android:layout_height="308dp">
                    <com.obric.oui.animation.RotatePannelView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/main_rotate_pannel"
                        android:background="@color/oui_bg_base_1"
                        android:layout_width="328dp"
                        android:layout_height="308dp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/type_container"
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:layout_below="@+id/main_head">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/container_top"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:weightSum="4"
                        android:paddingHorizontal="4dp">
                        <LinearLayout
                            android:id="@+id/junk_files_cleanup"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_trashcan_xmark"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/clean_trash"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/memory_completely_cleanup"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_memorychip_fill"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/action_clean_memory"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/battery_optimization"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_battery_bolt_fill"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/power_optimization"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/application_manager"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_tray_app_fill"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/manager_application"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/container_bottom"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:weightSum="4"
                        android:paddingHorizontal="4dp">
                        <LinearLayout
                            android:id="@+id/item_storage"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_disk_fill"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/storage_manager"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prevent_disturb"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_demon_circle"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/security_no_disturb"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/item_data_usage"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_webscope_circle"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/network_manager"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/item_advanced"
                            style="@style/MainPageSubContainerStyle">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/oic_setting_fill"
                                android:scaleType="center"/>
                            <TextView
                                android:text="@string/security_advanced_options"
                                style="@style/MainPageSubTextStyle"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <com.bytedanceos.rotateview.BezierBubbleView
                    android:id="@+id/bezier_bubble_view1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:bubbleRadius="@dimen/bubble_radius"
                    app:bubbleRadiusRange="@dimen/bubble_radius_range"
                    app:bubbleSize="@dimen/bubble_size"
                    app:controlPointLocationRange="@dimen/bubble_location_range"/>
            </RelativeLayout>
            <com.obric.security.mainpage.view.OTAUpdateView
                android:id="@+id/ota_update"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <com.bytedanceos.security.widget.SecurityItemText2
                android:id="@+id/battery_status_low"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                app:oui_list_item_content_image="@drawable/oic_low_battery_ranking"
                app:oui_list_item_subtitle="@string/power_summary"
                app:oui_list_item_title="@string/power_usage_low_battery_mode"
                style="@style/SettingItemSingleStyle2"/>
            <com.bytedanceos.securitycenter.PowerRankView
                android:id="@+id/power_rank_status"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>
            <com.bytedanceos.security.widget.BottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
