<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/battery_power_root"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:paddingTop="112dp"
            android:paddingBottom="64dp"
            android:visibility="visible"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:id="@+id/bottom_delete_action"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_text"
        android:layout_alignParentBottom="true"
        app:oui_hasDivider="false"
        app:oui_widgetBlurRadius="0"
        app:oui_widgetFitInsetBottom="true"
        style="@style/OStyleV2.OBottomActionBar.Floating"/>
    <com.obric.oui.status.OPageStatus
        android:id="@+id/status_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:opagestatus_type="status_content"/>
    <com.obric.oui.status.OPageStatus
        android:id="@+id/status_loading_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:opagestatus_type="status_content"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/memory_big_file_cleanup"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
