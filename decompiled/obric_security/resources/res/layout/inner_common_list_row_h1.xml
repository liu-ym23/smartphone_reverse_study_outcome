<?xml version="1.0" encoding="utf-8"?>
<com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="@string/inner_row_root"
    android:background="@color/inner_common_list_row_h_base_bg_color"
    android:paddingLeft="@dimen/inner_common_list_row_h_base_left_padding"
    android:paddingRight="@dimen/inner_common_list_row_h_base_right_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/inner_common_list_row_h_base_height">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/inner_common_list_row_h_base_first_text_margin_left">
        <ImageView
            android:id="@+id/left_icon"
            android:tag="@string/inner_row_left_image"
            android:layout_width="@dimen/inner_common_list_row_h_base_icon_width"
            android:layout_height="@dimen/inner_common_list_row_h_base_icon_height"
            android:src="@drawable/inner_icon_video_play_selector"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:tag="@string/inner_row_left_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/inner_icon_video_play_selector"
            android:layout_centerInParent="true"/>
        <View
            android:background="#b2b2b2"
            android:layout_width="88dp"
            android:layout_height="1dp"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/left_icon"
            android:layout_centerHorizontal="true"/>
        <View
            android:background="#b2b2b2"
            android:layout_width="86dp"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/left_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/inner_common_list_row_h_base_first_text_size"
            android:textColor="@color/inner_common_list_row_h_base_first_text_color"
            android:ellipsize="middle"
            android:id="@+id/first_text"
            android:tag="@string/inner_row_first_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/inner_common_list_row_h_base_second_text_size"
            android:textColor="@color/inner_common_list_row_h_base_second_text_color"
            android:ellipsize="middle"
            android:id="@+id/second_text"
            android:tag="@string/inner_row_second_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_common_list_row_h_base_second_text_margin_top"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/inner_common_list_row_h_base_right_text_size"
        android:textColor="@color/inner_common_list_row_h_base_right_text_color"
        android:id="@+id/right_text"
        android:tag="@string/inner_row_right_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/inner_common_list_row_h_base_first_text_margin_right"
        android:includeFontPadding="false"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:tag="@string/inner_row_select_view"
        android:paddingLeft="@dimen/inner_common_list_row_h_base_right_select_margin_left"
        android:paddingRight="@dimen/inner_common_list_row_h_base_right_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/inner_common_list_row_h_base_right_padding_minus"
        android:src="@drawable/inner_common_icon_right_arrow"/>
</com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleLinearLayout>
