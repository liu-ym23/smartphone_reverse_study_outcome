<?xml version="1.0" encoding="utf-8"?>
<com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/popup_menu_item_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/common_row_leftimg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/inner_common_text_color_1"
        android:gravity="center"
        android:id="@+id/common_row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_toRightOf="@+id/common_row_leftimg"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/common_row_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.qihoo360.mobilesafe.common.ui.ripple.CommonRippleRelativeLayout>
