<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.button.OButton
        android:id="@+id/left_action_close"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="44dp"
        android:layout_marginTop="@dimen/oui_p_container_2"
        android:layout_marginStart="@dimen/oui_p_container_1"
        app:icon="@drawable/o_ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OButton.M1.Standard.Neutral"/>
    <TextView
        android:textColor="@color/oui_text_1"
        android:id="@+id/main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/left_action_close"
        style="@style/Title_Title_L"/>
    <TextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_title"
        style="@style/Body_M"/>
    <View
        android:id="@+id/placeholder_top"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"/>
    <com.obric.oui.lisitem.OListItemGeneral
        android:id="@+id/location_switch_olistitem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toTopOf="@+id/placeholder_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placeholder_top"
        app:oui_list_item_show_background="true"
        app:oui_list_item_show_divider="false"
        app:oui_list_item_subtitle="开启后应用将能使用你的具体位置，否则只能获取大致位置"
        app:oui_list_item_title="精确位置"/>
    <View
        android:id="@+id/placeholder_bottom"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/location_switch_olistitem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
