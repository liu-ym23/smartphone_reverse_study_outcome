<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/clear_dial_root"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/dial_layer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_base_bg"
            android:background="@drawable/oic_transparent_dial_base_bg"
            android:layout_width="212dp"
            android:layout_height="212dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_green_bg"
            android:layout_width="212dp"
            android:layout_height="212dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:alpha="0"/>
        <com.obric.security.mainpage.view.GlowDotRingProg
            android:layout_gravity="center"
            android:id="@+id/progress_bar"
            android:layout_width="212dp"
            android:layout_height="212dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_green_fg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:alpha="0"/>
        <com.obric.oui.SafeImageView
            android:layout_gravity="center"
            android:id="@+id/dial_particle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/inner_layer"
        android:layout_width="192dp"
        android:layout_height="192dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/inner_base_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/oic_inner_white_circle"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/scanning_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="53dp"
                android:layout_centerHorizontal="true">
                <com.obric.oui.animation.ScrollingNumbersView
                    android:id="@+id/inner_scanning_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:textAlignment="center"
                    android:paddingHorizontal="5dp"
                    android:lineHeight="79dp"
                    app:adjustSubTextThreshold="3"
                    app:alignment="center"
                    app:lineSpacingMultiplier="2"
                    app:maxDigits="3"
                    app:singleNumberWidthMultiplier="1.2"
                    app:subText="%"
                    app:subTextSize="16sp"
                    app:textColor="@color/oui_functional_green_6"
                    app:textSize="60sp"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/oui_functional_green_6"
                android:id="@+id/scanning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="120dp"
                android:text="@string/scaning"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:alpha="0"
                android:textAlignment="center"
                android:lineHeight="20dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/score_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="47dp"
                android:layout_centerHorizontal="true">
                <com.obric.oui.animation.ScrollingNumbersView
                    android:id="@+id/inner_score_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="19dp"
                    android:textAlignment="center"
                    android:paddingHorizontal="5dp"
                    android:lineHeight="79dp"
                    app:adjustSubTextThreshold="3"
                    app:alignment="center"
                    app:lineSpacingMultiplier="2"
                    app:maxDigits="3"
                    app:singleNumberWidthMultiplier="1.2"
                    app:subText="@string/unit_grad"
                    app:subTextSize="16sp"
                    app:textColor="@color/oui_functional_green_6"
                    app:textSize="60sp"/>
            </LinearLayout>
            <com.obric.oui.animation.ScrollingNumbersView
                android:gravity="center_horizontal"
                android:id="@+id/inner_score_number_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="19dp"
                android:layout_centerInParent="true"
                android:alpha="0"
                android:textAlignment="center"
                android:paddingHorizontal="5dp"
                android:lineHeight="79dp"
                app:adjustSubTextThreshold="3"
                app:alignment="center"
                app:lineSpacingMultiplier="2"
                app:maxDigits="3"
                app:singleNumberWidthMultiplier="1.2"
                app:subText="@string/unit_grad"
                app:subTextSize="16sp"
                app:textColor="@color/oui_functional_green_6"
                app:textSize="60sp"/>
            <com.obric.oui.button.OButton
                android:id="@+id/score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="117dp"
                android:text="@string/onestep_optimize"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"
                app:oui_radius="@dimen/oui_h_m1"
                style="@style/OStyleV2.OButton.S.Standard.Red_Light"/>
            <ImageView
                android:id="@+id/dial_clean_done"
                android:background="@drawable/oic_checkmark_circle_fill"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:alpha="0"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/oui_functional_green_6"
                android:id="@+id/cleaning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cleaning"
                android:singleLine="true"
                android:layout_centerInParent="true"
                android:alpha="0"
                android:textAlignment="center"
                android:lineHeight="20dp"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
