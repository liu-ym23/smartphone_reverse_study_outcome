<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.obric.oui.button.OIconButton
        android:id="@+id/battery_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:scaleType="centerInside"
        app:oui_layout_borderColor="@color/oui_line_2"
        app:oui_layout_borderWidth="0.6dp"
        app:oui_radius="18dp"/>
    <com.obric.oui.progress.OProgressView
        android:id="@+id/battery_item_progress"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/battery_item_icon"
        android:layout_alignParentBottom="true"
        app:oui_progress_color="@color/oui_functional_green_7"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/oui_text_1"
        android:id="@+id/battery_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="密码本"
        android:layout_toRightOf="@+id/battery_item_icon"
        android:layout_alignParentTop="true"
        android:lineHeight="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/oui_functional_green_7"
        android:id="@+id/battery_item_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:lineHeight="20dp"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"/>
</RelativeLayout>
