<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/loading_view"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/search_or_edit_bar"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/inner_common_dimen_24dp"
        android:layout_alignBottom="@+id/app_network_control_header_container"
        android:layout_centerHorizontal="true"
        android:elevation="@dimen/inner_common_dimen_10dp"
        android:paddingHorizontal="@dimen/inner_common_dimen_16dp"
        android:paddingVertical="8dp">
        <com.obric.oui.searchbar.v2.OSearchBar
            android:id="@+id/oc_searchbar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_m2"
            android:layout_weight="1"
            app:oui_useBackIcon="false"
            style="@style/OStyleV2.OSearchBar.Default.S"/>
        <com.obric.oui.button.OIconButtonFloating
            android:id="@+id/search_field_button"
            android:layout_marginLeft="8dp"
            app:oui_widgetIcon="@drawable/oui_icon_xmark"
            style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
        <ViewStub
            android:id="@+id/option_bar_vs"
            android:layout="@layout/layout_option_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedanceos.security.widget.stickylistheaders.StickyListHeadersListView
            android:id="@+id/listView"
            android:paddingTop="0dp"
            android:clipToPadding="false"
            android:divider="@color/transparent"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            slider_checkbox_id="@+id/checkBox"
            style="@style/ListViewGeneralStyle"/>
        <com.obric.oui.indexscrollbar.OIndexScrollbar
            android:id="@+id/index_scrollbar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/searchview"/>
    <include
        android:id="@+id/empty_view"
        layout="@layout/list_empty_view"/>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:id="@+id/net_list_control"
        android:paddingTop="84dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="152dp"
        android:layout_alignParentBottom="true"
        app:oui_widgetBlurRadius="36"
        style="@style/OStyleV2.OBottomActionBar.Floating">
        <com.obric.oui.button.OButtonFloating
            android:id="@+id/permission_status_allow"
            app:oui_widgetText="@string/background_network_allow"
            style="@style/OStyleV2.OButtonFloating.M.Standard.Text"/>
        <com.obric.oui.button.OButtonFloating
            android:id="@+id/permission_status_prompt"
            app:oui_widgetText="@string/background_network_reject_screen_off"
            style="@style/OStyleV2.OButtonFloating.M.Standard.Text"/>
    </com.obric.oui.actionbar.v2.OBottomActionBarFloating>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/app_network_control_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:elevation="@dimen/dimen_8"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="true">
        <RelativeLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oFloatingTitleBar_centerTitle="@string/network_background_control_title"
                app:oFloatingTitleBar_maskBlurRadius="0"/>
            <com.obric.oui.tab.OTabLayout
                android:id="@+id/cycle_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/oui_h_m2"
                android:layout_marginLeft="@dimen/oui_p_list_item_1"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/oui_p_list_item_1"
                android:layout_marginBottom="8dp"
                android:layout_below="@+id/title_bar"
                app:tabGravity="fill"
                app:tabMode="fixed"
                style="@style/OTabTextV2.Background.Light">
                <com.obric.oui.tab.OTabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_title_data_usage"/>
                <com.obric.oui.tab.OTabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_title_wlan"/>
            </com.obric.oui.tab.OTabLayout>
        </RelativeLayout>
    </com.obric.oui.blur.OBlurMaskView>
</RelativeLayout>
