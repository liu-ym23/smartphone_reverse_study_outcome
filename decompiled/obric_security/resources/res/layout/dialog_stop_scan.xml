<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/Transparent"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/oui_text_1"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/stop_virus_scan"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.button.OButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/oui_h_l1"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/oui_functional_blue_6"
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="@dimen/oui_h_l1"
            android:text="@string/stop"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    </LinearLayout>
</LinearLayout>
