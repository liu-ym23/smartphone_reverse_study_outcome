<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/security_progress_title_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/oui_text_1"
            android:id="@+id/item_title"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/oui_functional_green_7"
            android:id="@+id/item_progress_text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/id_progress"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_below="@+id/item_title"
            app:oui_progress_color="@color/oui_functional_green_7"/>
    </RelativeLayout>
    <View
        android:id="@+id/id_splite_view"
        android:background="@color/oui_line_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/setting_item_summary_text_colorlist"
        android:id="@+id/item_summary"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"/>
</RelativeLayout>
