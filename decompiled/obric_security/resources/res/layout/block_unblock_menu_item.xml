<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/option1"
            android:background="@color/oui_fill_element_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginBottom="@dimen/inner_common_dimen_12dp"
            android:text="@string/dialog_delete_conform"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/option2"
            android:background="@color/oui_fill_element_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginBottom="@dimen/inner_common_dimen_12dp"
            android:text="@string/dialog_delete_conform"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/option3"
            android:background="@color/oui_fill_element_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginTop="@dimen/dimen_12"
            android:text="@string/dialog_delete_conform"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    </LinearLayout>
</RelativeLayout>
