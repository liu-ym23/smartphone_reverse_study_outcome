<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/nav_list_item_selector"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_list_item_height"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/left_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:scaleType="centerInside"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_list_item_height"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">
        <TextView
            android:textSize="@dimen/nav_item_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/alpha_99_black_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <EditText
            android:textSize="@dimen/nav_item_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/alpha_99_black_color"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/content_edit"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/nav_item_sub_content_text_size"
        android:textStyle="bold"
        android:textColor="@color/alpha_66_black_color"
        android:ellipsize="marquee"
        android:gravity="end"
        android:id="@+id/sub_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingEnd="6dp"/>
    <obric.widget.SwitchEx
        android:gravity="end"
        android:id="@+id/id_switch_ex"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingEnd="6dp"/>
    <ImageView
        android:gravity="end"
        android:id="@+id/right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="6dp"/>
</LinearLayout>
