<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/risk_app_detail_scroll"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/risk_app_detail_content"
            android:paddingTop="@dimen/risk_control_detail_scroll_vertical_padding"
            android:paddingBottom="@dimen/risk_control_detail_footer_scroll_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <com.obric.oui.layout.OUIRelativeLayout
                android:gravity="center_horizontal"
                android:id="@+id/risk_app_detail_header_card"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/risk_control_detail_header_top_margin"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">
                <ImageView
                    android:id="@+id/risk_app_detail_icon"
                    android:background="@drawable/risk_control_icon_bg"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"
                    android:clipToOutline="true"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/risk_app_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:maxLines="1"
                    android:layout_below="@+id/risk_app_detail_icon"
                    style="@style/Title_4_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_3b"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/risk_app_detail_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxLines="1"
                    android:layout_below="@+id/risk_app_detail_title"
                    style="@style/Body_1_Regular"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_3b"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/risk_app_detail_install_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:layout_below="@+id/risk_app_detail_version"
                    style="@style/Body_1_Regular"/>
            </com.obric.oui.layout.OUIRelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/risk_app_detail_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:outlineProvider="background"
                android:clipToOutline="true">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_virus_type_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_title="@string/virus_type"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_virus_description_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_title="@string/virus_description"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/risk_app_detail_controls_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:outlineProvider="background"
                android:clipToOutline="true">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_switch_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/risk_control_network_desc"
                    app:ocardlistitem_title="@string/risk_control_item_network"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_switch_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/risk_control_sensitive_permission_desc"
                    app:ocardlistitem_title="@string/risk_control_item_permission"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_switch_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/risk_control_accessibility_desc"
                    app:ocardlistitem_title="@string/risk_control_item_accessibility"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/risk_app_detail_switch_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_subTitle="@string/risk_control_notification_desc"
                    app:ocardlistitem_title="@string/risk_control_item_notification"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/risk_app_detail_footer"
        android:background="@color/oui_bg_base_1"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/risk_app_detail_footer_divider"
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/risk_app_detail_control"
                android:background="@drawable/risk_control_button_secondary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/control"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                style="@style/Button_2_Medium"/>
            <com.obric.oui.text.OTextView
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/risk_app_detail_uninstall"
                android:background="@drawable/risk_control_button_primary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/risk_control_uninstall"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                style="@style/Button_2_Medium"/>
        </LinearLayout>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
