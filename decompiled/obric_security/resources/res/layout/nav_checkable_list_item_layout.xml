<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/nav_list_item_selector"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_list_item_height"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">
    <ImageView
        android:id="@+id/left_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <CheckBox
        android:id="@+id/right_icon"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_check_box_mini"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/nav_list_item_height"
        android:layout_toLeftOf="@+id/right_icon"
        android:layout_toRightOf="@+id/left_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">
        <TextView
            android:textSize="@dimen/nav_item_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/alpha_99_black_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <EditText
            android:textSize="@dimen/nav_item_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/alpha_99_black_color"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/content_edit"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </FrameLayout>
</RelativeLayout>
