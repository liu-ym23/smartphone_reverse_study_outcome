<?xml version="1.0" encoding="utf-8"?>
<com.bytedanceos.preventdisturb.widget.ConversationListItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/conversation_list_item"
    android:background="@drawable/conversation_list_item_slide_shadowlist"
    android:layout_width="match_parent"
    android:layout_height="@dimen/conversation_list_item_height">
    <LinearLayout
        android:id="@+id/scroll_btns_layout"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/conversation_list_item_height">
        <ImageView
            android:id="@+id/scroll_del_btn"
            android:src="@drawable/spam_delete_selector"
            style="@style/ConversationListItemScrollButton"/>
        <ImageView
            android:id="@+id/scroll_unblock_btn"
            android:src="@drawable/unblock_selector"
            style="@style/ConversationListItemScrollButton"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/scroll_handle_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/conversation_list_item_height"
        android:layout_marginLeft="-3dp">
        <View
            android:background="@drawable/conversation_list_item_background_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:layout_width="@dimen/conversation_list_item_height"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            layout="@layout/avatar_image_layout"/>
        <ImageView
            android:id="@+id/conversation_choice"
            android:layout_width="@dimen/conversation_list_item_height"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:src="@drawable/conversation_checkbox_image"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:alpha="0"/>
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="5.5dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/conversation_arrow"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/status_light"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54dp"
            android:src="@drawable/list_item_status_selector"
            android:scaleType="center"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:orientation="vertical"
            android:paddingLeft="9.375dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="65dp"
            android:layout_toLeftOf="@+id/arrow"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="13.5sp"
                android:textColor="@color/conversation_list_item_date_color"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_toLeftOf="@+id/date">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/conversation_list_item_from_color"
                    android:ellipsize="end"
                    android:id="@+id/from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/conversation_list_item_subject_color"
                    android:ellipsize="end"
                    android:id="@+id/subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    android:layout_alignParentLeft="true"
                    android:lineSpacingMultiplier="1.1"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</com.bytedanceos.preventdisturb.widget.ConversationListItem>
