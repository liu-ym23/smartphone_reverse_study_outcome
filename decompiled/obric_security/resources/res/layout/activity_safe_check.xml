<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/safe_check_container"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/safe_check_scroll"
        android:paddingTop="112dp"
        android:paddingBottom="100dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/safe_check_content"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/fl_panel_container"
                android:layout_width="match_parent"
                android:layout_height="242dp">
                <FrameLayout
                    android:id="@+id/rotate_panel_stable_container"
                    android:layout_width="212dp"
                    android:layout_height="212dp">
                    <com.obric.oui.text.OTextView
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/oui_functional_green_6"
                        android:layout_gravity="center"
                        android:id="@+id/scan_result_state_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_functional_green_6"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/subtitle_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_security_risk"
                android:textAlignment="center"
                android:layout_marginHorizontal="12dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/risk_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_subTitle="@string/safe_check_scan_preparing"
                app:ocardlistitem_title="@string/detect_risk_apps"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:gravity="center_vertical"
                android:id="@+id/risk_section_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:text="@string/uncontrolled_risk_apps"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="12dp"
                style="@style/Subtitle_2_Medium"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/risk_app_list_card"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="true">
                <com.obric.oui.NonScrollableRecyclerView
                    android:id="@+id/risk_app_recycler_view"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:id="@+id/safe_check_bottom_action_bar"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:oui_widgetBlurRadius="36"
        style="@style/OStyleV2.OBottomActionBar.Floating"/>
    <com.obric.oui.button.OButton
        android:textSize="16sp"
        android:textColor="@color/oui_text_1"
        android:id="@+id/btn_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/stop_scanning"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    <com.obric.oui.button.OButton
        android:textSize="16sp"
        android:id="@+id/btn_clean_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/one_key_clean"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimen_8"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_centerTitle="@string/safe_check"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
