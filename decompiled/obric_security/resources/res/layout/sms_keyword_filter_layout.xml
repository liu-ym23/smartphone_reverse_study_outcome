<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/keyword_list"
            android:paddingTop="112dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"/>
    </FrameLayout>
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/delete_bg"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/delete_btn"
        app:oui_layout_borderColor="@color/oui_basic_line_2"
        app:oui_layout_borderWidth="0.6dp"/>
    <com.obric.oui.button.OButton
        android:id="@+id/delete_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_l1"
        android:layout_marginBottom="56dp"
        android:text="@string/delete_btn"
        android:layout_marginHorizontal="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/OButton.L1.Standard.Red"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/delete_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="delete_btn,delete_bg"/>
    <com.obric.oui.text.OTextView
        android:textSize="20dp"
        android:textColor="@color/oui_text_3"
        android:id="@+id/empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/keyword_empty_title"
        android:layout_marginHorizontal="30dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/empty_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_3b"
        android:gravity="center"
        android:id="@+id/empty_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/keyword_empty_message"
        android:layout_marginHorizontal="30dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toTopOf="@+id/empty_add"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_title"
        style="@style/OTabText.Regular"/>
    <com.obric.oui.button.OButton
        android:id="@+id/empty_add"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:text="@string/keyword_empty_add"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_subtitle"
        style="@style/OButton.M2.Standard.Neutral"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/empty_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="empty_title,empty_subtitle,empty_add"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_centerTitle="@string/sms_keyword_filter_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
