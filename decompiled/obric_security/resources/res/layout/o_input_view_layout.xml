<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/input_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="8dp">
        <FrameLayout
            android:id="@+id/custom_start_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                style="@style/Subtitle_2_Regular"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/edit_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.forms.OEditText
                    android:scrollbarSize="3dp"
                    android:scrollbarThumbVertical="@drawable/o_scrollbar"
                    android:textColor="@color/oui_basic_text_1"
                    android:textColorHighlight="@color/oui_functional_red_2"
                    android:textColorHint="@color/oui_basic_text_3b"
                    android:gravity="center_vertical"
                    android:id="@+id/input"
                    android:scrollbars="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="22sp"
                    android:cursorVisible="true"
                    android:maxLines="1"
                    android:editable="true"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/o_input_cursor_blue"
                    style="@style/Title_1_Regular"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_4"
                    android:id="@+id/limit_single"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/Subtitle_1_Regular"/>
                <ImageView
                    android:id="@+id/clear"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/close_circle_filled"
                    android:layout_marginStart="8dp"/>
                <ImageView
                    android:id="@+id/eyes"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/o_input_view_eyes_close"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/custom_end_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/input_divider"
        android:background="@color/oui_basic_line_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="12dp"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/helper_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="5dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:layout_gravity="start"
            android:id="@+id/tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:layout_gravity="end"
            android:id="@+id/limit_multi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Subtitle_1_Regular"/>
    </FrameLayout>
</LinearLayout>
