<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_above="@+id/bottom_delete_action"
        android:layout_alignParentTop="true">
        <com.bytedanceos.security.widget.SlideListView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/list"
            android:paddingTop="112dp"
            android:drawSelectorOnTop="false"
            android:overScrollMode="always"
            bytedance:slider_checkbox_id="@+id/processes_item_cb"
            bytedance:slider_enabled="true"
            style="@style/ListViewGeneralStyle"/>
    </LinearLayout>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:id="@+id/bottom_delete_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/inner_common_dimen_24dp"
        android:layout_alignParentBottom="true"
        bytedance:oui_buttonLastPrimary="true"
        bytedance:oui_buttonStyle="l1-primary"
        bytedance:oui_hasDivider="false"
        style="@style/OStyleV2.OBottomActionBar.Floating"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        bytedance:oFloatingTitleBar_maskBlurRadius="8"
        bytedance:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
