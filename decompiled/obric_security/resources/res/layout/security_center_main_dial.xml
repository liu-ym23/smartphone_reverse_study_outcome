<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:security="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@color/oui_bg_base_1"
    android:layout_width="328dp"
    android:layout_height="308dp">
    <FrameLayout
        android:id="@+id/dial_layer"
        android:layout_width="288dp"
        android:layout_height="288dp"
        android:layout_centerInParent="true">
        <com.obric.oui.animation.PieProgressView
            android:layout_gravity="center"
            android:id="@+id/dial_pie_progress"
            android:layout_width="240dp"
            android:layout_height="240dp"/>
        <com.obric.oui.animation.PieProgressFullView
            android:layout_gravity="center"
            android:id="@+id/dial_pie_progress_full"
            android:visibility="gone"
            android:layout_width="240dp"
            android:layout_height="240dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_base_bg"
            android:background="@drawable/oic_transparent_dial_base_bg"
            android:layout_width="240dp"
            android:layout_height="240dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_green_bg"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/oic_transparent_dial_green_bg"
            android:alpha="0"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_mask"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/oic_transparent_dial_mask2"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_green_fg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/oic_transparent_dial_green_fg"
            android:alpha="0"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dial_particle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/inner_layer"
        android:layout_width="192dp"
        android:layout_height="192dp"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/inner_base_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/oic_inner_white_circle"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/scanning_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.obric.oui.animation.ScrollingNumbersView
                    android:id="@+id/inner_scanning_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="19dp"
                    android:alpha="0"
                    android:textAlignment="center"
                    android:paddingHorizontal="5dp"
                    android:lineHeight="79dp"
                    security:adjustSubTextThreshold="3"
                    security:alignment="center"
                    security:lineSpacingMultiplier="2"
                    security:maxDigits="3"
                    security:singleNumberWidthMultiplier="1.2"
                    security:subText="%"
                    security:subTextSize="16sp"
                    security:textColor="@color/oui_functional_green_6"
                    security:textSize="60sp"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/oui_functional_green_6"
                android:id="@+id/scanning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="124dp"
                android:text="@string/scaning"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:alpha="0"
                android:textAlignment="center"
                android:lineHeight="20dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/score_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.obric.oui.animation.ScrollingNumbersView
                    android:id="@+id/inner_score_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="19dp"
                    android:textAlignment="center"
                    android:paddingHorizontal="5dp"
                    android:lineHeight="79dp"
                    security:adjustSubTextThreshold="3"
                    security:alignment="center"
                    security:lineSpacingMultiplier="2"
                    security:maxDigits="3"
                    security:singleNumberWidthMultiplier="1.2"
                    security:subText="@string/unit_grad"
                    security:subTextSize="16sp"
                    security:textColor="@color/oui_functional_green_6"
                    security:textSize="60sp"/>
            </LinearLayout>
            <com.obric.oui.animation.ScrollingNumbersView
                android:gravity="center_horizontal"
                android:id="@+id/inner_score_number_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="19dp"
                android:layout_centerInParent="true"
                android:alpha="0"
                android:textAlignment="center"
                android:paddingHorizontal="5dp"
                android:lineHeight="79dp"
                security:adjustSubTextThreshold="3"
                security:alignment="center"
                security:lineSpacingMultiplier="2"
                security:maxDigits="3"
                security:singleNumberWidthMultiplier="1.2"
                security:subText="@string/unit_grad"
                security:subTextSize="16sp"
                security:textColor="@color/oui_functional_green_6"
                security:textSize="60sp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/oui_functional_green_6"
                android:id="@+id/score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="124dp"
                android:text="@string/onestep_optimize"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"
                android:lineHeight="20dp"/>
            <ImageView
                android:id="@+id/dial_clean_done"
                android:background="@drawable/oic_checkmark_circle_fill"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:alpha="0"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/oui_functional_green_6"
                android:id="@+id/cleaning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cleaning"
                android:singleLine="true"
                android:layout_centerInParent="true"
                android:alpha="0"
                android:textAlignment="center"
                android:lineHeight="20dp"/>
        </RelativeLayout>
    </FrameLayout>
</merge>
