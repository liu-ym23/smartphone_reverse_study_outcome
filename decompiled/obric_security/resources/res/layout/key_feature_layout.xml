<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/type_container"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="20dp"
    android:layout_marginHorizontal="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/container_top"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:weightSum="4"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/junk_files_cleanup"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_trashcan_xmark"
                android:scaleType="center"/>
            <TextView
                android:text="@string/clean_trash"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/memory_completely_cleanup"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_memorychip_fill"
                android:scaleType="center"/>
            <TextView
                android:text="@string/action_clean_memory"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/battery_optimization"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_battery_bolt_fill"
                android:scaleType="center"/>
            <TextView
                android:text="@string/power_optimization"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/application_manager"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_tray_app_fill"
                android:scaleType="center"/>
            <TextView
                android:text="@string/manager_application"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/container_bottom"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:weightSum="4"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/item_storage"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_disk_fill"
                android:scaleType="center"/>
            <TextView
                android:text="@string/storage_manager"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/prevent_disturb"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_demon_circle"
                android:scaleType="center"/>
            <TextView
                android:text="@string/security_no_disturb"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/item_data_usage"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_webscope_circle"
                android:scaleType="center"/>
            <TextView
                android:text="@string/network_manager"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/item_advanced"
            style="@style/MainPageSubContainerStyle">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/oic_setting_fill"
                android:scaleType="center"/>
            <TextView
                android:text="@string/security_advanced_options"
                style="@style/MainPageSubTextStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
