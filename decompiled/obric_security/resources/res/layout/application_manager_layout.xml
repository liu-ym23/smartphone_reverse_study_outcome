<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:paddingTop="@dimen/inner_common_dimen_96dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_permissions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/permission_management"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_doppelganger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/doppelganger_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_application_manage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/advanced_item_application"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_preferred_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/preferred_application"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/system_app_manager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/system_app_manager"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/system_app_install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/system_app_install"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/miit_anti_fraud_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_title="@string/miit_anti_fraud_update_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_power"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/power_optimization"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_storage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/advanced_item_storage"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/manager_application"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
