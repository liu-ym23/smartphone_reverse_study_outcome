<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <view
        android:id="@+id/running_processes"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        class="com.bytedanceos.clearmemory.RunningProcessesView"/>
    <include layout="@layout/loading_container"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        bytedance:oFloatingTitleBar_centerTitle="@string/action_clean_memory"
        bytedance:oFloatingTitleBar_maskBlurRadius="8"
        bytedance:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
