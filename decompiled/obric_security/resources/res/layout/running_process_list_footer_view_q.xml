<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="11dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/show_all_container"
        android:background="@drawable/oic_bg_middle_pure"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12"
        android:layout_marginEnd="@dimen/dimen_12">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_32"
            layout="@layout/expand_more"/>
    </FrameLayout>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/clear_process_bt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/careful_clean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/persist_clean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
