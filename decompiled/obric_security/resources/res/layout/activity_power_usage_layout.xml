<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oui_title_text="@string/power_optimization"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/main_view"
        android:visibility="visible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <RelativeLayout
                android:background="@drawable/oic_bg_single"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/head_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/oui_text_3"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginTop="22dp"
                            android:layout_marginBottom="2dp"
                            android:text="@string/battery_usage_left_title"
                            android:layout_marginHorizontal="16dp"
                            android:lineHeight="16dp"/>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp">
                            <TextView
                                android:textSize="40sp"
                                android:id="@+id/battery_usage_left_tv"
                                android:text="78"
                                android:letterSpacing="-0.02"
                                style="@style/StorageLeadTitleTextStyle"/>
                            <TextView
                                android:id="@+id/tv_free_size_unit"
                                android:text="%"
                                android:layout_toRightOf="@+id/battery_usage_left_tv"
                                style="@style/StorageLeadTitleUnitTextStyle"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="31dp">
                            <RelativeLayout
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="30dp"
                                android:layout_alignParentLeft="true">
                                <TextView
                                    android:id="@+id/used_time_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataTextStyle"/>
                                <TextView
                                    android:id="@+id/used_time_unit"
                                    android:layout_toRightOf="@+id/used_time_tv"
                                    style="@style/StorageSubDataUnitTextStyle"/>
                                <TextView
                                    android:text="@string/battery_usage_used_title"
                                    android:layout_below="@+id/used_time_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataNameTextStyle"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true">
                                <TextView
                                    android:id="@+id/remain_time_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataTextStyle"/>
                                <TextView
                                    android:id="@+id/remain_time_unit"
                                    android:layout_toRightOf="@+id/remain_time_tv"
                                    style="@style/StorageSubDataUnitTextStyle"/>
                                <TextView
                                    android:text="@string/battery_usage_remain_title"
                                    android:layout_below="@+id/remain_time_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataNameTextStyle"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="30dp"
                                android:layout_alignParentRight="true">
                                <TextView
                                    android:id="@+id/battery_temperature_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataTextStyle"/>
                                <TextView
                                    android:id="@+id/battery_temperature_unit"
                                    android:text="°C"
                                    android:layout_toRightOf="@+id/battery_temperature_tv"
                                    style="@style/StorageSubDataUnitTextStyle"/>
                                <TextView
                                    android:text="@string/battery_temperature_title"
                                    android:layout_below="@+id/battery_temperature_tv"
                                    android:layout_centerHorizontal="true"
                                    style="@style/StorageSubDataNameTextStyle"/>
                            </RelativeLayout>
                        </RelativeLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.obric.oui.divider.ODivider
                            android:layout_width="match_parent"
                            android:layout_height="0.6dp"/>
                        <TextView
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/oui_text_3"
                            android:id="@+id/power_used_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginTop="21dp"
                            android:layout_marginBottom="2dp"
                            android:text="@string/battery_usage_graph_title"
                            android:layout_marginHorizontal="16dp"
                            android:lineHeight="16dp"/>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true">
                                <com.bytedanceos.security.widget.CircleProgressBar
                                    android:id="@+id/software_circle_bar"
                                    android:layout_width="144dp"
                                    android:layout_height="144dp"
                                    android:layout_marginVertical="16dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true">
                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:id="@+id/soft_process_img"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:src="@drawable/process_red"/>
                                    <TextView
                                        android:textSize="@dimen/storage_sub_size_unit_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/storage_sub_size_text_color"
                                        android:ellipsize="end"
                                        android:id="@+id/soft_process_title"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:maxWidth="50dp"
                                        android:text="@string/software_power_graph_title"
                                        android:singleLine="true"
                                        android:layout_toRightOf="@+id/soft_process_img"/>
                                    <TextView
                                        android:textSize="@dimen/storage_sub_size_unit_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/storage_sub_size_text_color"
                                        android:id="@+id/soft_process_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:text="0%"
                                        android:layout_toRightOf="@+id/soft_process_img"
                                        android:layout_below="@+id/soft_process_title"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp">
                                    <ImageView
                                        android:id="@+id/hard_process_img"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:src="@drawable/process_green"/>
                                    <TextView
                                        android:textSize="@dimen/storage_sub_size_unit_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/storage_sub_size_text_color"
                                        android:ellipsize="end"
                                        android:id="@+id/hard_process_title"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:maxWidth="50dp"
                                        android:text="@string/hardware_power_graph_title"
                                        android:singleLine="true"
                                        android:layout_toRightOf="@+id/hard_process_img"/>
                                    <TextView
                                        android:textSize="@dimen/storage_sub_size_unit_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/storage_sub_size_text_color"
                                        android:id="@+id/hard_process_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:text="0%"
                                        android:layout_toRightOf="@+id/hard_process_img"
                                        android:layout_below="@+id/hard_process_title"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/power_usage_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.obric.oui.divider.ODivider
                            android:id="@+id/software_list_divider"
                            android:layout_width="match_parent"
                            android:layout_height="0.6dp"/>
                        <TextView
                            android:textSize="@dimen/storage_sub_size_name_text_size"
                            android:textStyle="bold"
                            android:textColor="@color/oui_text_3"
                            android:id="@+id/software_list_title"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/software_power_list_title"
                            android:layout_marginHorizontal="16dp"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/software_list_container"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.obric.oui.divider.ODivider
                            android:id="@+id/data_usage_line_4"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="0.6dp"/>
                        <TextView
                            android:textSize="@dimen/storage_sub_size_name_text_size"
                            android:textStyle="bold"
                            android:textColor="@color/oui_text_3"
                            android:id="@+id/hardware_list_title"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/hardware_power_list_title"
                            android:layout_marginHorizontal="16dp"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/hardware_list_container"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/head_area">
                <com.obric.oui.lisitem.OListItemSwitch
                    android:id="@+id/power_usage_battery_percentage"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/power_usage_battery_percentage"
                    style="@style/OSettingItemNoIconStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/power_usage_save_mode"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/power_usage_save_mode"
                    style="@style/OSettingItemNoIconStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <TextView
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/power_usage_battery_use_optimization"
                    android:layout_marginHorizontal="32dp"/>
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/app_optimization"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/app_optimization"
                    style="@style/OSettingItemNoIconStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/game_battery_use_optimization"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/dynamic_resolution"
                    style="@style/OSettingItemNoIconStyle"/>
                <include
                    android:id="@+id/game_battery_use_optimization_gap"
                    layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSwitch
                    android:id="@+id/screen_power_optimize"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/screen_power_optimize"
                    style="@style/OSettingItemNoIconStyle"/>
                <TextView
                    android:id="@+id/screen_power_optimize_tips"
                    android:text="@string/screen_power_optimize_tips"
                    style="@style/SettingItemTipsStyle"/>
                <include
                    android:id="@+id/screen_power_optimize_gap"
                    layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSwitch
                    android:id="@+id/fiveg_optimize"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/fiveg_optimize"
                    style="@style/OSettingItemNoIconStyle"/>
                <TextView
                    android:id="@+id/fiveg_optimize_tips"
                    android:text="@string/fiveg_optimize_tips"
                    style="@style/SettingItemTipsStyle"/>
                <include
                    android:id="@+id/fiveg_optimize_gap"
                    layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSwitch
                    android:id="@+id/auto_sleep_mode"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/auto_sleep_mode"
                    style="@style/OSettingItemNoIconStyle"/>
                <TextView
                    android:id="@+id/auto_sleep_mode_tips"
                    android:text="@string/auto_sleep_mode_tip"
                    style="@style/SettingItemTipsStyle"/>
                <include
                    android:id="@+id/auto_sleep_mode_gap"
                    layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <com.obric.oui.lisitem.OListItemSwitch
                    android:id="@+id/reverse_wireless_charging"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/reverse_wireless_charging"
                    style="@style/OSettingItemNoIconStyle"/>
                <TextView
                    android:id="@+id/reverse_wireless_charging_tips"
                    android:text="@string/reverse_wireless_charging_tips"
                    style="@style/SettingItemTipsStyle"/>
                <include
                    android:id="@+id/reverse_wireless_charging_gap"
                    layout="@layout/group_list_item_vertical_gap_layout_1"/>
                <TextView
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/network_background_control_title"
                    android:layout_marginHorizontal="32dp"/>
                <com.obric.oui.lisitem.OListItemSettings
                    android:id="@+id/network_optimization_settings"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_list_item_title="@string/network_background_control_title"
                    style="@style/OSettingItemNoIconStyle"/>
                <include layout="@layout/group_list_item_vertical_gap_layout_1"/>
            </LinearLayout>
            <com.bytedanceos.security.widget.BottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
