<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whole_view"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include layout="@layout/loading_view"/>
    <FrameLayout
        android:id="@+id/search_or_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_bar">
        <com.obric.oui.titlebar.OCTitleBar
            android:id="@+id/oc_searchbar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/option_bar_vs"
            android:layout="@layout/layout_option_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/net_list_control"
        android:layout_below="@+id/search_or_edit_bar">
        <com.bytedanceos.security.widget.stickylistheaders.StickyListHeadersListView
            android:id="@+id/listView"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            slider_checkbox_id="@+id/checkBox"
            style="@style/ListViewGeneralStyle"/>
        <com.bytedanceos.security.widget.QuickBarEx
            android:id="@+id/quickbar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginVertical="40dp"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_or_edit_bar"
        layout="@layout/searchview"/>
    <include
        android:id="@+id/empty_view"
        layout="@layout/list_empty_view"/>
    <include
        android:id="@+id/title_secondary_bar_shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/search_or_edit_bar"
        layout="@layout/title_secondary_bar_shadow"/>
    <RelativeLayout
        android:id="@+id/net_list_control"
        android:background="@color/oui_bg_base_2_1_low_elevation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true">
        <com.obric.oui.divider.ODivider
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_alignParentTop="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="12dp">
            <com.obric.oui.button.OButton
                android:id="@+id/permission_status_allow"
                android:layout_width="104dp"
                android:text="@string/permission_status_allow"
                android:layout_marginHorizontal="6dp"
                style="@style/OButton.M2.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/permission_status_prompt"
                android:layout_width="104dp"
                android:text="@string/permission_status_prompt"
                android:layout_marginHorizontal="6dp"
                style="@style/OButton.M2.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/permission_allow_in_use"
                android:visibility="gone"
                android:layout_width="104dp"
                android:text="@string/permission_allow_in_use"
                android:layout_marginHorizontal="6dp"
                style="@style/OButton.M2.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/permission_status_foreground_allow"
                android:visibility="gone"
                android:layout_width="104dp"
                android:text="@string/permission_status_foreground_allow"
                android:layout_marginHorizontal="6dp"
                style="@style/OButton.M2.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/permission_status_deny"
                android:layout_width="104dp"
                android:text="@string/permission_status_deny"
                android:layout_marginHorizontal="6dp"
                style="@style/OButton.M2.Standard.Neutral"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
