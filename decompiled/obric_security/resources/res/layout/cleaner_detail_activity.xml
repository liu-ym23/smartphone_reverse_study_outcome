<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sliderListView="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <com.bytedanceos.security.widget.SlideListView
        android:id="@+id/caches"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        android:layout_above="@+id/clean_button_container"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="16dp"
        sliderListView:slider_checkbox_id="@+id/cache_item_cb"
        sliderListView:slider_enabled="true"
        style="@style/ListViewGeneralStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyle"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:singleLine="true"/>
    </LinearLayout>
    <include
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/no_cache_empty_view"/>
    <RelativeLayout
        android:id="@+id/clean_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.obric.oui.actionbar.OBottomActionBar
            android:id="@+id/clean_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_text"
            android:layout_centerVertical="true"
            sliderListView:oui_buttonLastPrimary="true"
            sliderListView:oui_buttonStyle="l1-primary"/>
    </RelativeLayout>
</RelativeLayout>
