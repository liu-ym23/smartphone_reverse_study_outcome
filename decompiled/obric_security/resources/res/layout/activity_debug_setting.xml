<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:background="@color/oui_bg_base_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_centerTitle="@string/debug_settings"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/manage_settings_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/oui_p_container_2"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/oui_p_container_2"
                app:oui_list_item_title="@string/settings_manage"
                app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/risk_app_list_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/oui_p_container_2"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/oui_p_container_2"
                app:oui_list_item_title="@string/controlled_risk_apps"
                app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/inject_this_is_virus_risk_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/oui_p_container_2"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/oui_p_container_2"
                app:oui_list_item_title="测试：将 ThisIsVirus 标记为风险应用"
                app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/clear_this_is_virus_risk_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/oui_p_container_2"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/oui_p_container_2"
                app:oui_list_item_title="测试：清除 ThisIsVirus 风险标记"
                app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/test_safe_check_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/oui_p_container_2"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/oui_p_container_2"
                app:oui_list_item_title="@string/test_safe_check"
                app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
