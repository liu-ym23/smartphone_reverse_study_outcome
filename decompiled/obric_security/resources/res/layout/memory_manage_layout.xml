<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="@dimen/inner_common_dimen_96dp"
        android:paddingBottom="@dimen/inner_common_dimen_40dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedanceos.storage.StorageVolumeView
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/storage_detail_info"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    layout="@layout/memory_file_cleanup"/>
                <include
                    android:id="@+id/portable_storage_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    layout="@layout/portable_storage_layout"/>
            </com.bytedanceos.storage.StorageVolumeView>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/advanced_item_storage"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
