<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="13dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <obric.widget.ListContentItemText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        bytedance:show_arrow="false"
        style="@style/ListContentItemStyle.Top">
        <com.bytedanceos.security.widget.DataUsageCycleView
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cycle_view"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/selected_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_today"
                android:background="@drawable/power_usage_cycle_view_normal_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_today"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/selected_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_week"
                android:background="@drawable/power_usage_cycle_view_normal_mid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_week"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
            <RadioButton
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/selected_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/power_usage_month"
                android:background="@drawable/power_usage_cycle_view_normal_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power_usage_cycle_month"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_centerInParent="true"/>
        </com.bytedanceos.security.widget.DataUsageCycleView>
    </obric.widget.ListContentItemText>
    <com.bytedanceos.security.widget.BottomExtraView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
