<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="108dp"
                android:layout_height="108dp"
                app:cardBackgroundColor="@color/oui_functional_graphite_4"
                app:cardCornerRadius="99dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_content_img"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/black_list_demon2"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_centerVertical="true">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/tv_content_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="34dp"
                    style="@style/Title_4_Medium"/>
                <TextView
                    android:textSize="12.5sp"
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/tv_content_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineHeight="16dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/custom_title"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="24dp"
            app:sectionTitle_titleText="@string/intercept_history_text"
            style="@style/OSectionTitleBar.S"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/call_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_showCardBg="true"
                app:ocardlistitem_showDivider="true"
                app:ocardlistitem_title="@string/intercept_call_title_text"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/sms_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_showCardBg="true"
                app:ocardlistitem_showDivider="false"
                app:ocardlistitem_title="@string/intercept_sms_title_text"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
