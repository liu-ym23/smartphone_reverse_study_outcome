<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/common_dialog_layout_margin_left"
    android:paddingTop="16dp"
    android:paddingRight="@dimen/common_dialog_layout_margin_left"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/common_font_size_e"
        android:textColor="@color/common_font_color_dark"
        android:id="@+id/trash_wran_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/trash_meida_loading"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/trash_wran_info"
        layout="@layout/clear_sdk_trash_clear_dialog_media_loading"/>
    <RelativeLayout
        android:id="@+id/trash_media_layout"
        android:background="@drawable/checktextview_selector"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/trash_wran_info">
        <ImageView
            android:id="@+id/trash_media_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:src="@drawable/inner_common_icon_right_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/trash_media_arrow"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/media_img1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginRight="6dp"/>
            <ImageView
                android:id="@+id/media_img2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginRight="6dp"/>
            <ImageView
                android:id="@+id/media_img3"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginRight="6dp"/>
            <ImageView
                android:id="@+id/media_img4"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginRight="8dp"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/trash_media_layout_mp3"
        android:background="@drawable/checktextview_selector"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/trash_wran_info">
        <ImageView
            android:id="@+id/trash_media_arrow_mp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:src="@drawable/inner_common_icon_right_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/trash_media_arrow_mp3"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:textColor="#99a7b8"
                android:ellipsize="middle"
                android:id="@+id/media_mp3_one"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:singleLine="true"
                android:drawableLeft="@drawable/clear_sdk_icon_trash_media_file"
                android:drawablePadding="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99a7b8"
                android:ellipsize="middle"
                android:id="@+id/media_mp3_two"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:drawableLeft="@drawable/clear_sdk_icon_trash_media_file"
                android:drawablePadding="8dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
