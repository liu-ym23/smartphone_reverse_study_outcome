<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oui_title_text="@string/power_usage_save_mode"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"
        android:overScrollMode="always"
        android:importantForAccessibility="no">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:padding="16dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no">
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/power_usage_low_battery_mode"
                android:layout_marginBottom="0dp"
                app:oui_list_item_title="@string/power_usage_low_battery_mode"
                style="@style/OSettingItemNoIconStyle"/>
            <obric.widget.TipsView
                android:text="@string/power_usage_low_battery_tips"
                android:paddingHorizontal="16dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OListItemSwitch
                android:id="@+id/power_usage_feature_phone_mode"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                app:oui_list_item_title="@string/power_usage_feature_phone_mode"
                style="@style/OSettingItemNoIconStyle"/>
            <obric.widget.TipsView
                android:text="@string/power_usage_feature_phone_tips"
                android:paddingHorizontal="16dp"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
