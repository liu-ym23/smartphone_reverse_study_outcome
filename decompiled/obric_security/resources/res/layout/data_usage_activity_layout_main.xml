<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/main_view"
        android:paddingTop="96dp"
        android:paddingBottom="@dimen/inner_common_dimen_26dp"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/top_layout"
                layout="@layout/data_usage_activity_head"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_layout">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_recharge"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_title="@string/btn_recharge_flow"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/item_data_usage_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_title="@string/data_usage_alarm"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/global_roaming_recharge"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_title="@string/global_roaming_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/app_network_control_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_title="@string/network_background_control_title"/>
                <include layout="@layout/group_list_item_vertical_gap_layout"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        app:oFloatingTitleBar_centerTitle="@string/mobile_data_manager"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"
        style="@style/TitleStyle"/>
    <LinearLayout
        android:gravity="center"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inner_common_dimen_16dp"
        android:layout_alignTop="@+id/title_bar"
        android:layout_alignBottom="@+id/title_bar"
        android:layout_centerHorizontal="true"
        android:elevation="@dimen/inner_common_dimen_10dp">
        <com.obric.oui.tab.OTabLayout
            android:id="@+id/cycle_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/inner_common_dimen_40dp"
            app:tabGravity="center"
            app:tabMode="scrollable"
            style="@style/OTabTextV2.Background.Gray">
            <com.obric.oui.tab.OTabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_sim1_title"/>
            <com.obric.oui.tab.OTabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_sim2_title"/>
        </com.obric.oui.tab.OTabLayout>
    </LinearLayout>
</RelativeLayout>
