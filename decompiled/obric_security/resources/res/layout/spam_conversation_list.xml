<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:preventdisturb="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedanceos.preventdisturb.widget.HorizontalScrollListView
        android:id="@+id/system_list"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="4dp"
        android:layout_above="@+id/clear_bt_contain"
        android:overScrollMode="always"
        preventdisturb:left_btns_id="@+id/scroll_btns_layout"
        preventdisturb:scroll_handle_id="@+id/scroll_handle_layout"/>
    <FrameLayout
        android:id="@+id/clear_bt_contain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.obric.oui.actionbar.v2.OBottomActionBarFloating
            android:layout_gravity="bottom"
            android:id="@+id/clear_all_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preventdisturb:oui_hasDivider="false"
            style="@style/OStyleV2.OBottomActionBar.Floating"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/empty_status_root"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.obric.oui.status.OPageStatus
            android:layout_gravity="center"
            android:id="@+id/empty_status"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preventdisturb:opagestatus_type="status_content"/>
    </FrameLayout>
</RelativeLayout>
