<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.optimize.OCTitleBar
        android:id="@+id/oc_titlebar_permission_privacy"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_title_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_title_text="@string/permission_privacy_title"/>
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:id="@+id/oSectionTitleBar_key_permission_usage_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oc_titlebar_permission_privacy"/>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/layout_location"
        android:background="@color/oui_fill_list_item_card"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_l2"
        android:layout_marginLeft="@dimen/oui_p_container_2"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/oui_p_container_2"
        app:layout_constraintTop_toBottomOf="@+id/oSectionTitleBar_key_permission_usage_desc"
        app:oui_bottomDividerColor="@color/oui_line_2"
        app:oui_bottomDividerHeight="0.6dp"
        app:oui_bottomDividerInsetLeft="@dimen/oui_p_list_item_2"
        app:oui_bottomDividerInsetRight="@dimen/oui_p_list_item_2"
        app:oui_topLeft_radius="@dimen/oui_r_l3_rect"
        app:oui_topRight_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:id="@+id/iv_location_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/oui_p_list_item_2"
            android:src="@drawable/oic_location_fill"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/tv_location_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_location_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/tv_location_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/oui_p_list_item_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/layout_camera"
        android:background="@color/oui_fill_list_item_card"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_l2"
        android:layout_marginLeft="@dimen/oui_p_container_2"
        android:layout_marginRight="@dimen/oui_p_container_2"
        app:layout_constraintTop_toBottomOf="@+id/layout_location"
        app:oui_bottomDividerColor="@color/oui_line_2"
        app:oui_bottomDividerHeight="0.6dp"
        app:oui_bottomDividerInsetLeft="@dimen/oui_p_list_item_2"
        app:oui_bottomDividerInsetRight="@dimen/oui_p_list_item_2">
        <ImageView
            android:id="@+id/iv_camera_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/oui_p_list_item_2"
            android:src="@drawable/oic_camera_fill"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/tv_camera_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_camera_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/tv_camera_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/oui_p_list_item_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/layout_microphone"
        android:background="@color/oui_fill_list_item_card"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_l2"
        android:layout_marginLeft="@dimen/oui_p_container_2"
        android:layout_marginRight="@dimen/oui_p_container_2"
        app:layout_constraintTop_toBottomOf="@+id/layout_camera"
        app:oui_bottomLeft_radius="@dimen/oui_r_l3_rect"
        app:oui_bottomRight_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:id="@+id/iv_microphone_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/oui_p_list_item_2"
            android:src="@drawable/oic_microphone_fill"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/tv_microphone_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_microphone_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/tv_microphone_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/oui_p_list_item_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.lisitem.OListItemGeneral
        android:id="@+id/OListItemSettings_goto_app_behavior_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/oui_p_container_2"
        android:layout_marginTop="4dp"
        android:layout_marginRight="@dimen/oui_p_container_2"
        app:layout_constraintTop_toBottomOf="@+id/layout_microphone"
        app:oui_list_item_title="@string/all_app_behavior_records"
        app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
    <com.obric.oui.lisitem.OListItemGeneral
        android:id="@+id/OListItemSettings_goto_app_perm_manage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/oui_p_container_2"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/oui_p_container_2"
        app:layout_constraintTop_toBottomOf="@+id/OListItemSettings_goto_app_behavior_record"
        app:oui_list_item_title="@string/app_perm_manage"
        app:oui_list_item_trailing_image="@drawable/ic_arrow_forward"/>
</androidx.constraintlayout.widget.ConstraintLayout>
