<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/head_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/oic_bg_single"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp">
            <com.obric.oui.text.OTextView
                android:textSize="@dimen/inner_common_dimen_40dp"
                android:textColor="@color/oui_text_1"
                android:gravity="center_vertical"
                android:id="@+id/scanning_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Display_2_Medium"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/tv_used_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" GB"
                app:layout_constraintBaseline_toBaselineOf="@+id/scanning_size"
                app:layout_constraintStart_toEndOf="@+id/scanning_size"
                style="@style/Subtitle_3_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/tv_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/scanning_size"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Subtitle_3_Regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/process"
            android:background="@drawable/oic_space_distribution_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_32"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp">
            <com.bytedanceos.oui.MultiSegmentProgressBar
                android:id="@+id/storage_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/rl_app"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp">
            <com.obric.oui.badge.OBadgeView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_app"
                android:background="@color/oui_accent_7_fg"
                android:layout_width="@dimen/storage_circle_image_width"
                android:layout_height="@dimen/storage_circle_image_width"
                android:layout_margin="@dimen/dimen_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OBadgeView.S1.Default.Green"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_apps_usage"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_app"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Body_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_app_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_calculating_size"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Subtitle_2_Regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/rl_pic"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp">
            <com.obric.oui.badge.OBadgeView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_pic"
                android:background="@color/oui_functional_yellow_7"
                android:layout_width="@dimen/storage_circle_image_width"
                android:layout_height="@dimen/storage_circle_image_width"
                android:layout_margin="@dimen/dimen_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OBadgeView.S1.Default.Green"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_pic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_dcim_usage"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_pic"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Body_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_pic_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_calculating_size"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Subtitle_2_Regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/rl_music"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dimen_8"
            android:layout_marginHorizontal="16dp">
            <com.obric.oui.badge.OBadgeView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_music"
                android:background="@color/oui_functional_red_7"
                android:layout_width="@dimen/storage_circle_image_width"
                android:layout_height="@dimen/storage_circle_image_width"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OBadgeView.S1.Default.Green"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_music"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/memory_music_usage"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_music_size"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/iv_music"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"
                style="@style/Body_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_music_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_calculating_size"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Subtitle_2_Regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/rl_system"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dimen_8"
            android:layout_marginBottom="@dimen/dimen_16"
            android:layout_marginHorizontal="16dp">
            <com.obric.oui.badge.OBadgeView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_system"
                android:background="@color/oui_functional_graphite_6"
                android:layout_width="@dimen/storage_circle_image_width"
                android:layout_height="@dimen/storage_circle_image_width"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OBadgeView.S1.Default.Green"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_system"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/system_with_other"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_system_size"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/iv_system"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"
                style="@style/Body_1_Regular"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_system_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_calculating_size"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Subtitle_2_Regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
