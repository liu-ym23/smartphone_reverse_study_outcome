<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/head_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimen_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/oic_bg_single"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:gravity="center_vertical"
            android:id="@+id/tv_free_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="44dp"
            android:text="--"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Display_S"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:gravity="center_vertical"
            android:id="@+id/battery_value_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:text="@string/storage_free"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_free_size"
            style="@style/Label_M_Thin"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/oic_bg_radius_10"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/battery_value_label">
            <View
                android:id="@+id/divider1"
                android:background="@color/oui_line_1"
                android:layout_width="1dp"
                android:layout_height="@dimen/dimen_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/divider2"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider2"
                android:background="@color/oui_line_1"
                android:layout_width="1dp"
                android:layout_height="@dimen/dimen_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/divider1"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/storage_used_per"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:text="--"
                app:layout_constraintBottom_toTopOf="@+id/memory_unused_label"
                app:layout_constraintEnd_toEndOf="@+id/memory_unused_label"
                app:layout_constraintStart_toStartOf="@+id/memory_unused_label"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Title_Title_M"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/memory_unused_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="16dp"
                android:text="@string/used_per"
                android:maxLines="3"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/divider1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/storage_used_per"
                style="@style/Label_M_Thin"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/storage_hasuse_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:text="--"
                app:layout_constraintBottom_toTopOf="@+id/storage_hasuse_data_label"
                app:layout_constraintEnd_toStartOf="@+id/divider2"
                app:layout_constraintStart_toEndOf="@+id/divider1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Title_Title_M"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/storage_hasuse_data_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="16dp"
                android:text="@string/storage_hasuse"
                android:singleLine="true"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/divider2"
                app:layout_constraintStart_toEndOf="@+id/divider1"
                app:layout_constraintTop_toBottomOf="@+id/storage_hasuse_data"
                style="@style/Label_M_Thin"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_1"
                android:gravity="center"
                android:id="@+id/total_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:text="--"
                app:layout_constraintBottom_toTopOf="@+id/total_size_label"
                app:layout_constraintEnd_toEndOf="@+id/total_size_label"
                app:layout_constraintStart_toStartOf="@+id/total_size_label"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Title_Title_M"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/total_size_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="16dp"
                android:text="@string/memory_size"
                android:maxLines="3"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/divider2"
                app:layout_constraintTop_toBottomOf="@+id/total_size"
                style="@style/Label_M_Thin"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
