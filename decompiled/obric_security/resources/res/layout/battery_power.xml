<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/oic_bg_single"
    android:padding="@dimen/inner_common_dimen_8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/dimen_8"
        android:paddingBottom="@dimen/dimen_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inner_common_dimen_8dp"
        android:layout_marginStart="@dimen/dimen_8"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="@dimen/inner_common_dimen_40dp"
            android:textStyle="bold"
            android:textColor="@color/oui_text_1"
            android:id="@+id/battery_vaule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:gravity="center"
            android:id="@+id/tv_used_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" %"
            app:layout_constraintBaseline_toBaselineOf="@+id/battery_vaule"
            app:layout_constraintStart_toEndOf="@+id/battery_vaule"
            style="@style/Subtitle_3_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/remain_time_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/battery_vaule"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_used_unit"
            app:layout_constraintTop_toTopOf="@+id/battery_vaule"
            style="@style/Subtitle_3_Regular"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/battery_info_text_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="battery_vaule,remain_time_tv"/>
        <com.bytedanceos.oui.MultiSegmentProgressBar
            android:id="@+id/storage_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/inner_common_dimen_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/battery_info_text_bottom"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
