<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/item_title_summary_text_size"
        android:textStyle="bold"
        android:textColor="@color/item_title_summary_text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/media_group_title"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_camera"
        android:onClick="onClick"
        app:oui_list_item_title="@string/permission_camera"
        style="@style/OSettingItemNoIconStyle"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/permission_record_audio"
        android:onClick="onClick"
        app:oui_list_item_title="@string/record_audio"
        style="@style/OSettingItemNoIconStyle"/>
</merge>
