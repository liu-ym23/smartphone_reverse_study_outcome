<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        bytedance:oFloatingTitleBar_maskBlurRadius="8"
        bytedance:oui_title_text="@string/power_usage_low_battery_mode"
        bytedance:oui_widgetFitInsetTop="true"/>
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"
        android:overScrollMode="always"
        android:importantForAccessibility="no">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:padding="16dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no">
            <com.obric.oui.lisitem.OListItemSwitch
                android:id="@+id/low_battery_mode_switch"
                android:layout_marginBottom="0dp"
                bytedance:oui_list_item_title="@string/power_usage_low_battery_mode"
                style="@style/OSettingItemNoIconStyle"/>
            <TextView
                android:text="@string/low_battery_enable_tips"
                android:paddingHorizontal="16dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OListItemSwitch
                android:id="@+id/auto_enable_switch"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                bytedance:oui_list_item_title="@string/low_battery_auto_enable"
                style="@style/OSettingItemNoIconStyle"/>
            <TextView
                android:id="@+id/auto_enable_switch_tips"
                android:text="@string/low_battery_auto_enable_tips"
                android:paddingHorizontal="16dp"
                style="@style/SettingItemTipsStyle"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
</RelativeLayout>
