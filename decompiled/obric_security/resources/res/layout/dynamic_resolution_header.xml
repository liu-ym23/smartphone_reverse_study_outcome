<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/storage_margin_top"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <obric.widget.ListContentItemSwitch
        android:id="@+id/dynamic_resolution_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        bytedance:smtTitle="@string/dynamic_resolution"
        style="@style/ListContentItemStyle.Single"/>
    <include layout="@layout/item_bottom_shadow_layout"/>
    <RelativeLayout
        android:id="@+id/dynamic_resolution_smart"
        android:background="@drawable/selector_setting_sub_item_bg_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:gravity="center"
            android:id="@+id/dynamic_resolution_smart_text"
            android:paddingLeft="@dimen/settings_item_title_left_margin"
            android:paddingRight="45dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_resolution_smart"
            android:singleLine="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/dynamic_resolution_smart_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:src="@drawable/selector_check_icon"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/dynamic_resolution_always"
        android:background="@drawable/selector_setting_sub_item_bg_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/settings_item_title_size"
            android:textColor="@color/setting_item_text_colorlist"
            android:gravity="center"
            android:id="@+id/dynamic_resolution_always_text"
            android:paddingLeft="@dimen/settings_item_title_left_margin"
            android:paddingRight="45dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_resolution_always"
            android:singleLine="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/dynamic_resolution_always_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:src="@drawable/selector_check_icon"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <obric.widget.TipsView
        android:visibility="gone"
        android:text="@string/power_usage_resolution_smart_tips"
        style="@style/SettingItemTipsStyle"/>
    <TextView
        android:id="@+id/dynamic_resolution_game_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/dynamic_resolution_enable_app"
        style="@style/GroupListSectionTitleStyle"/>
    <obric.widget.ListContentItemText
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        bytedance:show_arrow="false"
        style="@style/SettingItemSingleStyle">
        <TextView
            android:textSize="13.5sp"
            android:textColor="@color/icon_settings_summary_color"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="186dp"
            android:text="@string/dynamic_resolution_empty_tip"/>
    </obric.widget.ListContentItemText>
</LinearLayout>
