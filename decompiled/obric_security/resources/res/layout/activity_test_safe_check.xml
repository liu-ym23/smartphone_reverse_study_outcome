<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="40dp">
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:id="@+id/phone_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入白名单手机号"/>
        <EditText
            android:id="@+id/black_phone_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入黑名单手机号"/>
        <EditText
            android:id="@+id/phone_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="设定时间，格式（2025-09-12）"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/insert_phone_db"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="手机号插入数据库"/>
        <EditText
            android:id="@+id/apk_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:hint="请输入apk白名单路径"/>
        <EditText
            android:id="@+id/apk_black_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入apk黑名单路径"/>
        <EditText
            android:id="@+id/apk_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="apk风险等级，输入（1，2，3），3为最高风险"/>
        <EditText
            android:id="@+id/apk_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="设定时间，格式（2025-09-12）"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/insert_apk_db"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="apk信息插入数据库"/>
        <EditText
            android:id="@+id/url_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:hint="请输入url 白名单"/>
        <EditText
            android:id="@+id/url_black_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入url 黑名单"/>
        <EditText
            android:id="@+id/url_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="apk风险等级，输入（1，2，3），3为最高风险"/>
        <EditText
            android:id="@+id/url_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="设定时间，格式（2025-09-12）"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/insert_url_db"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="url信息插入数据库"/>
        <EditText
            android:id="@+id/delete_time"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:hint="输入时间，删除指定日期之前的数据，格式（2025-09-12）"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/delete"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="删除数据库数据"/>
        <EditText
            android:id="@+id/fetch_time"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:hint="输入时间，拉取制定日期之后的数据，格式（2025-09-12）"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/fetch"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="拉取反诈数据"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/end_time"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="查看本地的end_time"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_dump_gxb_rules"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="查看国信办反诈规则表数据"/>
        <EditText
            android:id="@+id/gxb_installable_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="包名 (gxb_app_installable)"/>
        <EditText
            android:id="@+id/gxb_installable_app_md5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="app_md5 (可空)"/>
        <EditText
            android:id="@+id/gxb_installable_sign_md5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sign_md5 (可空)"/>
        <EditText
            android:id="@+id/gxb_installable_sign_sha1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sign_sha1 (可空)"/>
        <EditText
            android:id="@+id/gxb_installable_sign_sha256"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sign_sha256 (可空)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_gxb_installable"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="请求 gxb_app_installable"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="--- SafaCheckService 测试 ---"/>
        <EditText
            android:id="@+id/test_apk_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 APK 路径 (checkApk)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_check_apk"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="checkApk"/>
        <EditText
            android:id="@+id/test_apk_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="输入包名 (checkApkWithInfo)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_check_apk_with_info"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="checkApkWithInfo"/>
        <EditText
            android:id="@+id/test_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="输入 URL (checkUrl)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_check_url"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="checkUrl"/>
        <EditText
            android:id="@+id/test_phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="输入电话号码 (checkPhone)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_check_phone"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="checkPhone"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/tv_test_result"
            android:background="#f5f5f5"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="120dp"
            android:text="结果将显示在这里..."/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="--- APK 信息查询 ---"/>
        <EditText
            android:id="@+id/apk_info_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 APK 路径 (展示包名/文件MD5/签名MD5/SHA1/SHA256)"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_show_apk_info"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="查询 APK 信息"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/tv_apk_info_result"
            android:background="#f5f5f5"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="100dp"
            android:text="结果将显示在这里 (长按可复制)"
            android:textIsSelectable="true"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_copy_apk_info"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="复制全部 APK 信息"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="--- 手动插入 gxb_anti_fraud_rules ---"/>
        <EditText
            android:id="@+id/gxb_insert_apk_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 APK 路径 (自动取包名/签名)"/>
        <EditText
            android:id="@+id/gxb_insert_rule_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="rule_no (主键，必填，可手填随机串)"/>
        <EditText
            android:id="@+id/gxb_insert_rule_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="rule_type (1安装提醒 2禁止安装 3禁止运行 4禁止安装+禁止运行)"
            android:inputType="number"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/btn_gxb_insert_rule"
            android:background="@color/red_btn_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="插入到 gxb_anti_fraud_rules"/>
    </LinearLayout>
</ScrollView>
