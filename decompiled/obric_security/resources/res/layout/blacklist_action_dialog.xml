<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/btn_contacts"
            android:background="@color/oui_fill_element_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginBottom="12dp"
            android:text="@string/choose_from_contacts"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/btn_call_log"
            android:background="@color/oui_fill_element_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginBottom="12dp"
            android:text="@string/choose_from_call_log"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/btn_manual"
            android:background="@color/oui_fill_element_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:text="@string/input_by_hand"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:textSize="16sp"
            android:id="@+id/btn_cancel"
            android:background="@color/oui_fill_element_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_l1"
            android:layout_marginTop="24dp"
            android:text="@string/cancel"
            style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    </LinearLayout>
</RelativeLayout>
