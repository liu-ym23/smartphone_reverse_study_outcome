<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/battery_power_root"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/main_view"
        android:paddingTop="112dp"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/battery_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_subTitle="@string/battery_capacity_tip"
                app:ocardlistitem_title="@string/battery_capacity"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/battery_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_title="@string/battery_temperature_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/smart_charging_mode_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_subTitle="@string/smart_charging_mode_enabled_tip"
                app:ocardlistitem_title="@string/smart_charging_mode_enabled"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/reverse_wireless_charging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_subTitle="@string/reverse_wireless_charging_tips"
                app:ocardlistitem_title="@string/reverse_wireless_charging"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/bypass_charging"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_subTitle="@string/bypass_charging_tip"
                app:ocardlistitem_title="@string/bypass_charging"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/battery_health_and_charging"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
