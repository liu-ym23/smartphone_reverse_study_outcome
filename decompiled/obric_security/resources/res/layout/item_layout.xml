<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_app_info"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <com.obric.oui.button.OIconButton
            android:id="@+id/iconImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="32dp"
            android:src="@color/AssistColor0"
            android:layout_centerVertical="true"
            app:oui_layout_borderColor="@color/oui_line_2"
            app:oui_layout_borderWidth="0.6dp"
            app:oui_radius="12dp"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/nameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="App name"
            android:layout_toRightOf="@+id/iconImageView"
            android:layout_centerVertical="true"
            style="@style/Label_L"/>
        <ImageView
            android:id="@+id/iv_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="28dp"
            android:src="@drawable/ic_arrow_forward"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/descriptionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"/>
</LinearLayout>
