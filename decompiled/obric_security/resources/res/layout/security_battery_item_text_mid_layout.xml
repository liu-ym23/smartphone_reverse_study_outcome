<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/security_progress_title_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/security_item_text_colorlist"
            android:id="@+id/item_title"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.8"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <obric.widget.SwitchEx
                android:id="@+id/switchex"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginRight="6.5dp"/>
            <RelativeLayout
                android:id="@+id/right_btn_container"
                android:background="@drawable/security_item_btn_bg"
                android:visibility="gone"
                android:duplicateParentState="true"
                android:layout_width="55dp"
                android:layout_height="31dp"
                android:layout_marginTop="8.3dp"
                android:layout_marginRight="12dp">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/clear_btn_normal_textcolor"
                    android:gravity="center"
                    android:id="@+id/right_btn"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </FrameLayout>
    </RelativeLayout>
    <View
        android:id="@+id/id_splite_view"
        android:background="@drawable/security_progress_list_item_splite_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="1dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/setting_item_summary_text_colorlist"
        android:id="@+id/item_summary"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"/>
</RelativeLayout>
