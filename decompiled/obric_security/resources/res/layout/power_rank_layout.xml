<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:background="@drawable/oic_bg_single"
        android:layout_height="wrap_content"
        style="@style/SettingItemSingleStyle2">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/power_rank_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedanceos.security.widget.SecurityItemTextNeutral
                android:id="@+id/power_rank_total"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                app:oui_list_item_content_image="@drawable/low_battery_ranking"
                app:oui_list_item_show_background="false"
                app:oui_list_item_title="@string/power_rank"
                style="@style/SettingItemTopStyle2"/>
            <com.bytedanceos.security.widget.SecurityProgressItemText
                android:id="@+id/power_rank_top1"
                android:visibility="gone"
                android:layout_marginRight="12dp"
                style="@style/SecurityProgressItemMidStyle"/>
            <com.bytedanceos.security.widget.SecurityProgressItemText
                android:id="@+id/power_rank_top2"
                android:visibility="gone"
                android:layout_marginRight="12dp"
                style="@style/SecurityProgressItemMidStyle"/>
            <com.bytedanceos.security.widget.SecurityProgressItemText
                android:id="@+id/power_rank_top3"
                android:visibility="gone"
                android:layout_marginRight="12dp"
                style="@style/SecurityProgressItemBottomStyle"/>
        </LinearLayout>
    </RelativeLayout>
</merge>
