<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/card_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_app_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginHorizontal="@dimen/dimen_12">
        <com.obric.oui.checkbox.OCheckBox
            android:id="@+id/checkbox_app"
            android:layout_width="@dimen/dimen_32"
            android:layout_height="@dimen/dimen_32"
            android:layout_marginLeft="19dp"
            android:layout_centerVertical="true"/>
        <com.obric.oui.button.OIconButton
            android:id="@+id/iconImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="56dp"
            android:src="@color/AssistColor0"
            android:layout_centerVertical="true"
            app:oui_layout_borderColor="@color/oui_line_2"
            app:oui_layout_borderWidth="0dp"
            app:oui_radius="8dp"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/nameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="App name"
            android:layout_toLeftOf="@+id/app_size"
            android:layout_toRightOf="@+id/iconImageView"
            android:layout_centerVertical="true"
            style="@style/Title_1_Medium"/>
        <ImageView
            android:id="@+id/iv_go"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/next_page_arrow"
            android:layout_toRightOf="@+id/nameTextView"
            android:layout_centerVertical="true"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/app_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App name"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/inner_common_dimen_18dp"
            android:layout_alignParentEnd="true"
            style="@style/Subtitle_3_Regular"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
