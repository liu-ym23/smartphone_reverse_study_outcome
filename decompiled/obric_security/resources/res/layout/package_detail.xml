<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/app_snippet"
                layout="@layout/manage_applications_item"/>
            <TextView
                android:id="@+id/first_empty_view"
                android:layout_width="wrap_content"
                android:layout_height="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/detail_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OListItemSettings
                android:id="@+id/all_permission"
                style="@style/OSettingItemNoIconStyle"/>
            <com.bytedanceos.security.widget.BottomExtraView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</RelativeLayout>
