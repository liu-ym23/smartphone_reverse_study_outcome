<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@drawable/forcetouch_management_optimize"
        android:enabled="true"
        android:shortcutId="power_optimization"
        android:shortcutShortLabel="@string/power_optimization"
        android:shortcutLongLabel="@string/power_optimization"
        android:shortcutDisabledMessage="@string/power_optimization">
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.securitycenter.MainActivity"/>
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.powerusage.PowerUsageActivity"/>
    </shortcut>
    <shortcut
        android:icon="@drawable/forcetouch_management_permissions"
        android:enabled="true"
        android:shortcutId="permission_management"
        android:shortcutShortLabel="@string/security_permission_management"
        android:shortcutLongLabel="@string/security_permission_management"
        android:shortcutDisabledMessage="@string/security_permission_management">
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.securitycenter.MainActivity"/>
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.security.PermissionCategoryActivity"/>
    </shortcut>
    <shortcut
        android:icon="@drawable/forcetouch_management_memory"
        android:enabled="true"
        android:shortcutId="memeory_cleanup"
        android:shortcutShortLabel="@string/action_clean_memory"
        android:shortcutLongLabel="@string/action_clean_memory"
        android:shortcutDisabledMessage="@string/action_clean_memory">
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.securitycenter.MainActivity"/>
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.clearmemory.ManagerApplicationsRunningActivity"/>
    </shortcut>
    <shortcut
        android:icon="@drawable/forcetouch_management_clean"
        android:enabled="true"
        android:shortcutId="file_cleanup"
        android:shortcutShortLabel="@string/memory_junk_file_cleanup"
        android:shortcutLongLabel="@string/memory_junk_file_cleanup"
        android:shortcutDisabledMessage="@string/memory_junk_file_cleanup">
        <intent
            android:targetPackage="com.obric.security"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.bytedanceos.securitycenter.MainActivity"/>
        <intent
            android:targetPackage="com.obric.security"
            android:action="com.bytedanceos.shortcut.fileclean"
            android:targetClass="com.bytedanceos.cleaner.CleanerActivity"/>
    </shortcut>
