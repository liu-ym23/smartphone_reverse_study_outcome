<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Design.TabLayout" parent="@style/Base.Widget.Design.TabLayout">
        <item name="tabGravity">center</item>
        <item name="tabMode">fixed</item>
    </style>
    <style name="ttlive_live_record_preview_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@color/ttlive_transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/ttlive_right_dialog_anim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="ttlive_quality_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/ttlive_quality_dialog_anim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="ttlive_quality_dialog_anim" parent="">
        <item name="android:windowEnterAnimation">@anim/ttlive_slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/ttlive_slide_out_right</item>
    </style>
</resources>
