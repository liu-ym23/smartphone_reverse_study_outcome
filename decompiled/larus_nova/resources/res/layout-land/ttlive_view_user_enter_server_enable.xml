<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_user_entry_server_enable_big"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="184dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_center_img"
                android:layout_width="375dp"
                android:layout_height="184dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/iv_center_avatar"
                android:visibility="gone"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"/>
        </FrameLayout>
        <TextView
            android:textSize="16dp"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_center_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="230dp"
            android:layout_height="32dp"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom|left"
        android:id="@+id/fr_user_entry_server_enable_small"
        android:layout_width="240dp"
        android:layout_height="32dp"
        android:layout_marginBottom="167dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_small_enter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"/>
        <TextView
            android:textSize="14dp"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/tv_small_text"
            android:paddingLeft="40dp"
            android:paddingRight="42dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:textDirection="ltr"
            android:paddingStart="40dp"
            android:paddingEnd="42dp"/>
    </FrameLayout>
</FrameLayout>
