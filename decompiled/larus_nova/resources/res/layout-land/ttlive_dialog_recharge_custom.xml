<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/ttlive_bg_custom_recharge_dialog_land"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_view"/>
    <View
        android:background="@drawable/ttlive_bg_custom_recharge_dialog_bottom_grey_land"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/suggestion_deals_container"/>
    <View
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/custom_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <EditText
        android:textSize="14dp"
        android:textColor="@color/ttlive_recharge_diamond_color"
        android:textColorHint="@color/ttlive_custom_recahrge_text_hint"
        android:gravity="end|center_vertical"
        android:id="@+id/custom_input"
        android:background="@drawable/ttlive_bg_custom_recharge_input_container"
        android:paddingRight="31dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/ttlive_input_recharge_money_hint"
        android:maxLines="1"
        android:inputType="number"
        android:textCursorDrawable="@drawable/ttlive_cursor_custom_recharge_drawable"
        android:paddingEnd="31dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tip_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_custom_recahrge_text_input_title"
        android:gravity="center_vertical"
        android:id="@+id/money_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_input"
        app:layout_constraintStart_toStartOf="@+id/custom_input"
        app:layout_constraintTop_toTopOf="@+id/custom_input"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recharge_diamond_unit_color"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:text="@string/ttlive_recharge_diamond_price_unit"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_input"
        app:layout_constraintRight_toRightOf="@+id/custom_input"
        app:layout_constraintTop_toTopOf="@+id/custom_input"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_custom_recahrge_text_input_title"
        android:id="@+id/diamond_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_deals_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_custom_recahrge_text"
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_deals_container"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestion_deals_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/custom_keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.recharge.platform.core.keyboard.LiveRechargeKeyBoardView
        android:id="@+id/custom_keyboard"
        android:background="@color/ttlive_custom_recahrge_bg_grey"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#4d000000"
        android:id="@+id/protocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
