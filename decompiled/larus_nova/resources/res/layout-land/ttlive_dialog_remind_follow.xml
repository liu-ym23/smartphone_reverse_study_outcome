<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dismiss_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/follow_guide_container"
        android:layout_width="375dp"
        android:layout_height="224dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp">
        <View
            android:id="@+id/content_container"
            android:background="@drawable/ttlive_bg_land_remind_follow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="34dp"/>
        <View
            android:id="@+id/avatar_position"
            android:background="@drawable/ttlive_bg_avatar_border"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_position"
            app:layout_constraintEnd_toEndOf="@+id/avatar_position"
            app:layout_constraintStart_toStartOf="@+id/avatar_position"
            app:layout_constraintTop_toTopOf="@+id/avatar_position"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            app:layout_constraintEnd_toEndOf="@+id/content_container"
            app:layout_constraintStart_toStartOf="@+id/content_container"
            app:layout_constraintTop_toTopOf="@+id/content_container">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#404040"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="164dp"
                android:minHeight="22dp"
                android:maxLines="1"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/anchor_level"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                app:actualImageScaleType="fitXY"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#b0b0b0"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/description"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintTop_toBottomOf="@+id/name_container"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/follow"
            android:background="@drawable/ttlive_bg_live_remind_follow_btn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_follow_broadcaster_immediately"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/hotsoon_location_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/hotsoon_description"
            app:layout_constraintTop_toBottomOf="@+id/name_container">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/hotsoon_location_icon"
                android:background="@drawable/ttlive_ic_hotsoon_follow_guide_location"
                android:layout_width="9dp"
                android:layout_height="11dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#80161823"
                android:id="@+id/hotsoon_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/hotsoon_description"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_hotsoon_follow_guide_description"
            app:layout_constraintTop_toBottomOf="@+id/hotsoon_location_container"
            app:layout_goneMarginTop="8dp"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/hotsoon_follow"
            android:background="@drawable/ttlive_bg_live_remind_follow_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:text="@string/ttlive_follow_broadcaster_immediately"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hotsoon_description"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
