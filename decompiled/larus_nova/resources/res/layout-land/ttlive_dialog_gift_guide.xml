<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/container_guide"
        android:background="@drawable/ttlive_gift_guide_dialog_bg_land"
        android:layout_width="360dp"
        android:layout_height="80dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/ttlive_gift_guide_margin_left"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ttlive_gift_guide_margin_left"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/tv_send_gift"
            android:background="@drawable/ttlive_gift_guide_btn_bg"
            android:layout_width="@dimen/ttlive_gift_guide_btn_width"
            android:layout_height="@dimen/ttlive_gift_guide_btn_height"
            android:layout_marginRight="@dimen/ttlive_gift_guide_margin_right"
            android:text="@string/ttlive_send_gift_broadcaster_immediately"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/ttlive_gift_guide_margin_right"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/tv_send_gift"
            android:layout_toRightOf="@+id/iv_avatar"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@+id/tv_send_gift"
            android:layout_toEndOf="@+id/iv_avatar">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_gift_guide_title"
                android:ellipsize="marquee"
                android:id="@+id/tv_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_gift_guide_summary"
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ttlive_send_gift_tip"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/container_blank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/container_guide"/>
</RelativeLayout>
