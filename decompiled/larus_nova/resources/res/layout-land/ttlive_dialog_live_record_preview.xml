<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_live_record_preview_dialog"
    android:layout_width="375dp"
    android:layout_height="match_parent">
    <View
        android:id="@+id/finish_record_panel_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_line"
        android:background="#14ffffff"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="#e6ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_record_preview_title"
        app:layout_constraintBottom_toTopOf="@+id/top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="#73ffffff"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_record_preview_cancel"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/video_background"
        android:background="@drawable/ttlive_bg_live_record_preview_video"
        android:layout_width="249dp"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/save_draft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <SurfaceView
        android:layout_gravity="start|top"
        android:id="@+id/video"
        android:layout_width="245dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_background"
        app:layout_constraintEnd_toEndOf="@+id/video_background"
        app:layout_constraintStart_toStartOf="@+id/video_background"
        app:layout_constraintTop_toTopOf="@+id/video_background"/>
    <View
        android:id="@+id/first_frame"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/video"
        app:layout_constraintLeft_toLeftOf="@+id/video"
        app:layout_constraintRight_toRightOf="@+id/video"
        app:layout_constraintTop_toTopOf="@+id/video"/>
    <View
        android:id="@+id/video_player_btn"
        android:background="@drawable/ttlive_ic_record_preview_player_btn"
        android:layout_width="35dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/video"
        app:layout_constraintEnd_toEndOf="@+id/video"
        app:layout_constraintStart_toStartOf="@+id/video"
        app:layout_constraintTop_toTopOf="@+id/video"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#b3ffffff"
        android:id="@+id/video_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:shadowColor="#33000000"
        android:shadowRadius="1"
        app:layout_constraintBottom_toBottomOf="@+id/video_background"
        app:layout_constraintEnd_toEndOf="@+id/video_background"
        app:layout_constraintStart_toStartOf="@+id/video_background"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_draft"
        android:background="@drawable/ttlive_bg_live_record_preview_save_draft"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/save_local"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/save_local"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/save_draft_icon"
            android:background="@drawable/ttlive_ic_record_save_draft"
            android:layout_width="16dp"
            android:layout_height="14.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/save_draft_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:id="@+id/save_draft_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_record_save_draft"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/save_draft_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_local"
        android:background="@drawable/ttlive_bg_live_record_preview_publish_video"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/publish_video"
        app:layout_constraintLeft_toRightOf="@+id/save_draft"
        app:layout_constraintRight_toLeftOf="@+id/publish_video"
        app:layout_constraintStart_toEndOf="@+id/save_draft"
        app:layout_goneMarginEnd="16dp"
        app:layout_goneMarginLeft="16dp"
        app:layout_goneMarginRight="16dp"
        app:layout_goneMarginStart="16dp">
        <View
            android:id="@+id/save_local_icon"
            android:background="@drawable/ttlive_ic_record_save_local"
            android:layout_width="11.5dp"
            android:layout_height="14.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/save_local_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:id="@+id/save_local_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.33dp"
            android:text="@string/ttlive_record_save_local"
            android:layout_marginStart="8.33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/save_local_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/publish_video"
        android:background="@drawable/ttlive_bg_live_record_preview_publish_video"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/save_local"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toEndOf="@+id/save_local">
        <View
            android:id="@+id/publish_video_icon"
            android:background="@drawable/ttlive_ic_record_publish_video"
            android:layout_width="10.35dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/publish_video_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:id="@+id/publish_video_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.65dp"
            android:text="@string/ttlive_record_publish_video"
            android:layout_marginStart="10.65dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/publish_video_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
