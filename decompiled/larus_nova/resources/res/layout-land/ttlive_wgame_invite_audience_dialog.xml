<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_view_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/panel_view"
        android:background="@drawable/ttlive_gameinvite_dialog_bg"
        android:layout_width="409dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_bg"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="@+id/panel_view"
        app:layout_constraintTop_toTopOf="@+id/panel_view"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintLeft_toLeftOf="@+id/panel_view"
        app:layout_constraintRight_toRightOf="@+id/panel_view"
        app:layout_constraintTop_toTopOf="@+id/panel_view"/>
    <View
        android:background="#14ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_center_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="63dp"
        android:layout_marginRight="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="@+id/panel_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:id="@+id/tv_bottom_tip"
        android:paddingRight="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="7dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_bottom_tip_2"
        app:layout_constraintEnd_toEndOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="@+id/panel_view"
        app:layout_goneMarginBottom="42dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#b3ffffff"
        android:gravity="center"
        android:id="@+id/tv_bottom_tip_2"
        android:paddingRight="32dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_wgame_audience_inviting_tip_2"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_btns"
        app:layout_constraintLeft_toLeftOf="@+id/panel_view"
        app:layout_constraintRight_toRightOf="@+id/panel_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_btns"
        android:paddingRight="32dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="17dp"
        android:layout_marginBottom="30dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/panel_view"
        app:layout_constraintEnd_toEndOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="@+id/panel_view">
        <TextView
            android:textSize="15dp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/btn_single"
            android:background="@drawable/ttlive_wgame_nagative_btn_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
