<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_land_white_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/block_word_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:id="@+id/block_word_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_blockword_setting"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/block_word_red_dot"
                android:background="@drawable/ttlive_ic_red_point_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/block_word_title"
                android:layout_alignTop="@+id/block_word_title"/>
        </RelativeLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#80161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_blockword_instruction"
            android:lineSpacingExtra="3sp"
            android:translationY="-1.38sp"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/block_word_display_area"
            android:layout_width="match_parent"
            android:layout_height="37dp">
            <View
                android:layout_gravity="center"
                android:id="@+id/block_word_add"
                android:background="@drawable/ttlive_bg_block_word_btnadd"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/block_word_rv_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:id="@+id/block_word_rv_view_slider_start"
                    android:background="@drawable/ttlive_bg_blockword_rv_slider_start"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"/>
                <View
                    android:id="@+id/block_word_rv_view_slider_end"
                    android:background="@drawable/ttlive_bg_blockword_rv_slider_end"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/block_word_input_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <com.bytedance.android.live.core.widget.LiveEditText
                android:textSize="15sp"
                android:textColor="@color/ttlive_live_input_text_color"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/block_word_edit_text"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="14dp"
                android:lineSpacingExtra="5sp"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|actionSend"
                android:textCursorDrawable="@drawable/ttlive_edit_text_cursor_drawable"
                android:textAlignment="viewStart"
                android:layout_marginStart="16dp"/>
            <com.bytedance.android.live.core.widget.FitTextView
                android:textSize="15sp"
                android:textColor="#b0b0b0"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/block_word_edit_text_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="14dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:layout_marginStart="16dp"/>
            <View
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentTop="true"/>
            <View
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/action_container"
        android:background="@drawable/ttlive_land_white_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/fans_group_list"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:gravity="top"
                android:id="@+id/fans_group_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_live_profile_manage_fans_group_list"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0sp"
                android:translationY="-0.21sp"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/fans_group_red_dot"
                android:background="@drawable/ttlive_ic_red_point_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/fans_group_title"
                android:layout_alignTop="@+id/fans_group_title"/>
            <View
                android:background="@drawable/ttlive_live_profile_next"
                android:layout_width="6dp"
                android:layout_height="10dp"
                android:layout_marginRight="19dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="19dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/manager_list"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_live_profile_manage_manager_list"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0sp"
                android:translationY="-0.21sp"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <View
                android:background="@drawable/ttlive_live_profile_next"
                android:layout_width="6dp"
                android:layout_height="10dp"
                android:layout_marginRight="19dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="19dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mute_list"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_live_profile_manage_mute_list"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0sp"
                android:translationY="-0.21sp"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <View
                android:background="@drawable/ttlive_live_profile_next"
                android:layout_width="6dp"
                android:layout_height="10dp"
                android:layout_marginRight="19dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="19dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/kick_out_list"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_setting_block_list"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0sp"
                android:translationY="-0.21sp"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <View
                android:background="@drawable/ttlive_live_profile_next"
                android:layout_width="6dp"
                android:layout_height="10dp"
                android:layout_marginRight="19dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="19dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ban_user_profile"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textAppearance="@style/ttlive_LiveProfileSettingItem"
                android:gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_setting_open_user_profile"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="0sp"
                android:translationY="-0.21sp"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/switch_ban_user_profile"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_marginEnd="16dp"
                app:lsb_background="#1f161823"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/setting_broadcast_window"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="79dp">
            <RelativeLayout
                android:id="@+id/broadcast_window_text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_txt"
                    android:gravity="start|center_vertical"
                    android:id="@+id/broadcast_window_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_live_broadcast_window"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <ImageView
                    android:id="@+id/broadcast_window_red_dot"
                    android:background="@drawable/ttlive_ic_red_point_tip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/broadcast_window_text"
                    android:layout_alignTop="@+id/broadcast_window_text"/>
            </RelativeLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_prelive_setting_tips"
                android:id="@+id/broadcast_window_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"
                android:text="@string/ttlive_live_broadcast_window_tips"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/broadcast_window_text_layout"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/broadcast_window_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lsb_background="@color/ttlive_prelive_setting_switch_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/admin_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/manager"
            android:background="@color/ttlive_white"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_live_profile_manage_set_manager"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/kick_out"
            android:background="@color/ttlive_white"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_chat_block_him"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/mute"
            android:background="@color/ttlive_white"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_live_profile_manage_mute"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_cancel"
            style="@style/ttlive_LiveProfileManageItem"/>
    </LinearLayout>
</LinearLayout>
