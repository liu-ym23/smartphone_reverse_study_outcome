<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_behavior"
    android:background="@drawable/ttlive_land_white_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/room_manage_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/room_manage_list_content"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/room_manage_title_back"
                android:layout_width="52dp"
                android:layout_height="52dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_icon_titlebar_back"
                    android:scaleType="centerInside"/>
            </LinearLayout>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_manage_list_black"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/room_manage_list_title"
                android:layout_width="wrap_content"
                android:layout_height="52dp"/>
        </FrameLayout>
        <View
            android:background="#33161823"
            android:layout_width="match_parent"
            android:layout_height="0.7dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/room_manage_list_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/room_manage_title_container"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/room_manage_list_status_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/room_manage_list_content"
        app:layout_constraintTop_toTopOf="@+id/room_manage_list_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
