<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/old_profile_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/fullscreen_background_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:maxHeight="220dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/fullscreen_background_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:viewAspectRatio="1.5121"/>
            <FrameLayout
                android:id="@+id/live_profile_head"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ttlive_replay_profile_top_height">
                <View
                    android:id="@+id/profile_header_view"
                    android:background="@drawable/ttlive_replay_bg_live_profile_header"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="50dp"
                    android:importantForAccessibility="no"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/iv_avatar_white_border"
                    android:background="@drawable/ttlive_replay_bg_avatar_border"
                    android:visibility="gone"
                    android:layout_width="76dp"
                    android:layout_height="76dp"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/avatar"
                    android:background="@drawable/ttlive_replay_bg_avatar_white_border"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:actualImageScaleType="fitCenter"
                    app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/iv_avatar_border"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_marginTop="@dimen/ttlive_replay_profile_avatar_border_margin_top_land"/>
                <TextView
                    android:textSize="@dimen/ttlive_replay_profile_setting_text_size"
                    android:textColor="@color/ttlive_core_hs_g3"
                    android:id="@+id/debug_view"
                    android:paddingLeft="@dimen/ttlive_replay_profile_setting_padding_right"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ttlive_replay_profile_land_setting_margin_top"
                    android:text="@string/ttlive_live_profile_debug"
                    android:paddingStart="@dimen/ttlive_replay_profile_setting_padding_right"/>
                <LinearLayout
                    android:layout_gravity="end|top"
                    android:paddingRight="@dimen/ttlive_replay_profile_setting_padding_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ttlive_replay_profile_land_setting_margin_top"
                    android:paddingEnd="@dimen/ttlive_replay_profile_setting_padding_right">
                    <TextView
                        android:textSize="@dimen/ttlive_replay_profile_setting_text_size"
                        android:textColor="@color/ttlive_core_hs_g3"
                        android:id="@+id/manage"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:text="@string/ttlive_live_profile_manage"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textSize="@dimen/ttlive_replay_profile_setting_text_size"
                        android:textColor="@color/ttlive_core_hs_g3"
                        android:id="@+id/fans_club_setting"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_live_profile_setting"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/report"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.bytedance.android.live.core.widget.HSImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/report_icon"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="1dp"/>
                        <com.bytedance.android.live.core.widget.LiveTextView
                            android:textSize="@dimen/ttlive_replay_profile_setting_text_size"
                            android:textColor="@color/ttlive_replay_profile_report_text_color"
                            android:gravity="center"
                            android:id="@+id/report_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_replay_profile_report"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/silent_divider"
                        android:background="@color/ttlive_core_hs_s9"
                        android:visibility="gone"
                        android:layout_width="1dp"
                        android:layout_height="@dimen/ttlive_replay_profile_divider_height"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <com.bytedance.android.live.core.widget.LiveTextView
                        android:textSize="@dimen/ttlive_replay_profile_setting_text_size"
                        android:textColor="@color/ttlive_core_hs_g3"
                        android:gravity="center"
                        android:id="@+id/slient"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_anonymous_profile_slient"/>
                </LinearLayout>
            </FrameLayout>
            <include
                android:id="@+id/loading_view"
                android:visibility="visible"
                android:layout_width="375dp"
                android:layout_height="174dp"
                android:layout_centerInParent="true"
                layout="@layout/ttlive_replay_view_live_profile_loading"/>
            <FrameLayout
                android:id="@+id/profile_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ttlive_replay_profile_land_bottom_view_margin_top"
                android:layout_below="@+id/live_profile_head"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
