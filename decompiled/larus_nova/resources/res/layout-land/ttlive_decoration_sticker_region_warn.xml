<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_region_v"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="13dp"
        android:textColor="#ff4e33"
        android:layout_gravity="center_horizontal"
        android:id="@+id/delete_sticker_btn"
        android:background="@drawable/ttlive_live_bg_sticker_delete_btn"
        android:layout_width="122dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_live_sticker_drag_to_delete"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/delete_region_v"
        android:background="#51000000"
        android:layout_width="match_parent"
        android:layout_height="72dp"/>
    <View
        android:id="@+id/bottom_region_v"
        android:background="#51000000"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/message_region_v"
        android:background="#51000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_region_v"/>
    <View
        android:background="@drawable/ttlive_live_bg_border_dash_rect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layerType="software"
        app:layout_constraintBottom_toTopOf="@+id/message_region_v"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delete_region_v"/>
</androidx.constraintlayout.widget.ConstraintLayout>
