<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vs_cache_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/vs_cache_content"
        android:layout_toStartOf="@+id/vs_cache_content"/>
    <RelativeLayout
        android:id="@+id/vs_cache_content"
        android:layout_width="490dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/click_zone"
            android:layout_width="102dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vs_cache_real_land_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/click_zone"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/vs_cache_title"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="10dp"
                android:text="@string/ttlive_vs_cache_title"
                android:fontFamily="sans-serif-medium"/>
            <com.bytedance.android.livesdk.chatroom.replay.cache.ui.ReplayFadingEdgeRecyclerView
                android:id="@+id/vs_cache_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="34dp"
                android:layout_toRightOf="@+id/click_zone"
                android:layout_below="@+id/vs_cache_title"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vs_cache_error_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="66dp"
            android:layout_marginRight="34dp"
            android:layout_toRightOf="@+id/click_zone">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:src="@drawable/ttlive_bg_network_error"/>
            <TextView
                android:textColor="#80ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_error_tips"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/vs_cache_retry"
                android:background="@drawable/ttlive_bg_vs_cache_retry"
                android:layout_width="231dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_retry"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vs_cache_empty_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="88dp"
            android:layout_marginRight="34dp"
            android:layout_toRightOf="@+id/click_zone">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:src="@drawable/ttlive_empty_content_dark"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_host_empty"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:id="@+id/vs_cache_load_progress_icon"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="160dp"
            android:layout_marginTop="150dp"
            android:layout_toRightOf="@+id/click_zone"/>
    </RelativeLayout>
</RelativeLayout>
