<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gift_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_dialog_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gift_dialog_view"
        android:background="@drawable/ttlive_bg_gift_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="44dp"
        android:layout_marginRight="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gift_top_panel_container"/>
    <FrameLayout
        android:id="@+id/gift_top_panel_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/gift_guest_info_container"
        app:layout_constraintEnd_toStartOf="@+id/gift_panel_top_detail_container"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view">
        <FrameLayout
            android:id="@+id/gift_panel_honor_level_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_gift_level_honor_height"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/gift_panel_top_detail_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_level_honor_height"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_guest_info_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"/>
    <View
        android:id="@+id/top_view"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"
        app:layout_constraintTop_toTopOf="@+id/gift_dialog_view"/>
    <View
        android:id="@+id/bottom_bar_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_panel_bottom_height_land"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"/>
    <FrameLayout
        android:id="@+id/top_view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_dialog_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/dialog_size_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gift_top_panel_container"/>
    <FrameLayout
        android:id="@+id/gift_guest_info_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_type_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"/>
    <FrameLayout
        android:id="@+id/gift_panel_type_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_content_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"/>
    <FrameLayout
        android:id="@+id/gift_panel_content_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_panel_content_container_height_land"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"/>
    <FrameLayout
        android:id="@+id/gift_panel_send_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_dialog_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_dialog_view"
        app:layout_constraintStart_toStartOf="@+id/gift_dialog_view"
        app:layout_constraintTop_toTopOf="@+id/gift_dialog_view"/>
    <FrameLayout
        android:id="@+id/gift_panel_vigo_recharge_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_content_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
