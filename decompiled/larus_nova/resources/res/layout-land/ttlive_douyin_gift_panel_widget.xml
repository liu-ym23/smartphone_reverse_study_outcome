<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_view_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gift_banner_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/gift_banner_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="60dp"
        android:layout_marginStart="60dp"
        app:layout_constraintLeft_toLeftOf="@+id/gift_panel_container"
        app:layout_constraintTop_toTopOf="@+id/gift_panel_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_panel_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/gift_empty_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/gift_panel_Layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gift_panel_Layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="398dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/gift_panel_view"
                android:background="@drawable/ttlive_bg_gift_new_panel_land"
                android:layout_width="398dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.legacy.widget.Space
                android:id="@+id/space"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="@+id/top_operation_container"/>
            <FrameLayout
                android:id="@+id/forbiden_notice"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/space"/>
            <FrameLayout
                android:id="@+id/top_operation_container"
                android:layout_width="0dp"
                android:layout_height="59dp"
                app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
                app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
                app:layout_constraintTop_toTopOf="@+id/gift_panel_view"/>
            <FrameLayout
                android:id="@+id/gift_list_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bottom_bar_container"
                app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
                app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
                app:layout_constraintTop_toBottomOf="@+id/top_operation_container"/>
            <FrameLayout
                android:id="@+id/bottom_bar_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="67dp"
                app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
                app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
                app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
            <FrameLayout
                android:id="@+id/first_charge_tip_container"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginBottom="38dp"
                app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
                app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
                app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/gift_combo_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
