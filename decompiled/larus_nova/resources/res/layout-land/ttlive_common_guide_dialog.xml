<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_dialog_layout"
        android:background="@drawable/ttlive_common_guide_dialog_bg"
        android:layout_width="360dp"
        android:layout_height="80dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/guide_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_dialog_layout"
        app:layout_constraintStart_toStartOf="@+id/guide_dialog_layout"
        app:layout_constraintTop_toTopOf="@+id/guide_dialog_layout"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
    <TextView
        android:textSize="15dp"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/guide_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="19dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/guide_button_iv"
        app:layout_constraintStart_toEndOf="@+id/guide_icon"
        app:layout_constraintTop_toTopOf="@+id/guide_dialog_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/guide_subtitle_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/guide_button_iv"
        app:layout_constraintStart_toEndOf="@+id/guide_icon"
        app:layout_constraintTop_toBottomOf="@+id/guide_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/guide_button_iv"
        android:layout_width="80dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_button_tv"
        app:layout_constraintEnd_toEndOf="@+id/guide_button_tv"
        app:layout_constraintStart_toStartOf="@+id/guide_button_tv"
        app:layout_constraintTop_toTopOf="@+id/guide_button_tv"
        app:placeholderImage="@drawable/ttlive_common_guide_btn_default_bg"/>
    <TextView
        android:textSize="13dp"
        android:gravity="center"
        android:id="@+id/guide_button_tv"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_dialog_layout"
        app:layout_constraintEnd_toEndOf="@+id/guide_dialog_layout"
        app:layout_constraintTop_toTopOf="@+id/guide_dialog_layout"/>
    <View
        android:id="@+id/guide_dialog_blank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_dialog_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
