<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bottom_bg_view"
        android:background="@color/ttlive_new_gift_panel_bg"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_search_icon"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/gift_search_icon_iv"
            android:background="@drawable/ttlive_gift_search_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tab_list"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gift_search_icon"/>
    <View
        android:id="@+id/start_board"
        android:background="@drawable/ttlive_base_gift_bottom_board2"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_marginBottom="5.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gift_search_icon"/>
    <View
        android:id="@+id/end_board"
        android:background="@drawable/ttlive_base_gift_bottom_board"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_marginBottom="5.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tab_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
