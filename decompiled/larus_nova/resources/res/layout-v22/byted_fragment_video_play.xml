<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="@color/byted_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/return_back"
            android:padding="5dp"
            android:layout_width="21dp"
            android:layout_height="29dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/byted_return_white"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"/>
    </RelativeLayout>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/byted_white"
        android:id="@+id/tv_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/byted_video_record_check_tip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/byted_white"
        android:gravity="center"
        android:id="@+id/tv_prompt_context"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/byted_video_record_check_detail"
        android:paddingHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_prompt"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_video_player"
        android:background="@color/byted_black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom"
        app:layout_constraintTop_toBottomOf="@+id/tv_prompt_context">
        <VideoView
            android:id="@+id/video_play"
            android:background="@color/byted_transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/video_first_frame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="50dp"
        android:layout_height="74dp"
        android:src="@mipmap/byted_video_play"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <LinearLayout
        android:id="@+id/ll_bottom"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="15sp"
            android:textColor="@color/byted_white"
            android:id="@+id/bt_restart_record"
            android:background="@drawable/byted_white_button_broder_r8"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginRight="6dp"
            android:text="@string/byted_video_record_check_retry"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/byted_white"
            android:id="@+id/bt_upload_video"
            android:background="@drawable/byted_red_button_selector_r8"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="6dp"
            android:text="@string/byted_video_record_upload"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
