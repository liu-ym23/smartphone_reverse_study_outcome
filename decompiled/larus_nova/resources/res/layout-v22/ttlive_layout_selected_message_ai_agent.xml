<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_selected_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.chatroom.widget.LiveMessageRecyclerView
        android:id="@+id/selected_messages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#80ffffff"
        android:layout_gravity="center"
        android:id="@+id/empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_no_selected_msg_hint"/>
    <TextView
        android:layout_gravity="top|right"
        android:id="@+id/more_panel_entry"
        android:background="@drawable/ttlive_selected_message_more_panel_entry"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ai_agent_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ai_agent_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="11dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_ai_agent_empty_welcome_tip_color"
            android:ellipsize="end"
            android:id="@+id/ai_agent_empty_welcome_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="11.5dp"
            android:layout_marginRight="26dp"
            android:maxLines="1"
            app:layout_constraintLeft_toRightOf="@+id/ai_agent_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/ai_agent_quick_ability_top_container"
            android:fadingEdgeLength="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:requiresFadingEdge="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/ai_agent_quick_ability_bottom_container"
            android:fadingEdgeLength="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="10dp"
            android:requiresFadingEdge="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/ai_agent_zoom_out_butoon"
            android:padding="8dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ttlive_ai_agent_zoom_out"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/ai_agent_messages_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ai_agent_quick_ability_top_container"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_ai_agent_zoom_out_name_color"
            android:ellipsize="end"
            android:id="@+id/ai_agent_zoom_out_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="36dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ai_agent_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ai_agent_zoom_in_button"
            android:paddingLeft="10dp"
            android:paddingTop="14dp"
            android:paddingRight="12dp"
            android:paddingBottom="14dp"
            android:layout_width="34dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_ai_agent_zoom_in"
            android:paddingVertical="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
