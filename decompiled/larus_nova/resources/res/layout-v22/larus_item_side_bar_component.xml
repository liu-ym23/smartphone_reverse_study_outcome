<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_item_icon"
        android:padding="?attr/larus_dp_2"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_hint"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tv_item_hint"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iv_item_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/tv_item_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_tag_new"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_item_hint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_dp_11"
        android:textStyle="bold"
        android:textColor="@color/larus_primary_50"
        android:layout_gravity="end"
        android:id="@+id/tv_tag_new"
        android:background="@drawable/larus_bg_side_bar_tag_new"
        android:paddingLeft="?attr/larus_dp_5"
        android:paddingTop="?attr/larus_dp_3"
        android:paddingRight="?attr/larus_dp_5"
        android:paddingBottom="?attr/larus_dp_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_4"
        android:paddingHorizontal="?attr/larus_dp_5"
        android:paddingVertical="?attr/larus_dp_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_item_count"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/right_icon_container"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_tag_new"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/icon_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_dp_11"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/message_red_dot"
            android:background="@drawable/larus_red_dot_bg"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:includeFontPadding="false"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
