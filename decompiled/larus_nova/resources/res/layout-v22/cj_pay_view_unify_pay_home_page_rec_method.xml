<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_unify_rec_method_layout"
    android:background="@drawable/cj_pay_bg_r8_gray"
    android:paddingLeft="@dimen/cj_pay_padding_16"
    android:paddingTop="@dimen/cj_pay_padding_14"
    android:paddingRight="@dimen/cj_pay_padding_16"
    android:paddingBottom="@dimen/cj_pay_padding_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/cj_pay_padding_16"
    android:paddingVertical="@dimen/cj_pay_padding_14">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_cj_unify_rec_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_unify_tv_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_unify_rec_method_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_6">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_unify_iv_method_icon"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_font_size_18"
                android:layout_height="@dimen/cj_pay_font_size_18"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_unify_iv_method_icon_disable_mask"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_font_size_18"
                android:layout_height="@dimen/cj_pay_font_size_18"
                android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_unify_tv_rec_method_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_4"
            android:maxLines="1"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
        android:gravity="center"
        android:id="@+id/cj_unify_tv_rec_method_voucher"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_6"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/ll_cj_unify_rec_method"
        app:layout_constraintStart_toEndOf="@+id/ll_cj_unify_rec_method"
        app:layout_constraintTop_toTopOf="@+id/ll_cj_unify_rec_method"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="@color/cj_pay_color_blue_04498D"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/cj_unify_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ll_cj_unify_rec_method"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_cj_unify_rec_method"/>
    <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
        android:gravity="left"
        android:id="@+id/cj_unify_asset_voucher"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_6"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/cj_unify_use"
        app:layout_constraintTop_toBottomOf="@+id/ll_cj_unify_rec_method"/>
</androidx.constraintlayout.widget.ConstraintLayout>
