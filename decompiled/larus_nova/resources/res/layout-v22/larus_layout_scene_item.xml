<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_scene_item_dark"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_94"
    android:paddingStart="?attr/larus_dp_12">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/scene_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/scene_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_12"/>
        <FrameLayout
            android:id="@+id/scene_icon_area"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_34">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/scene_icon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginLeft="?attr/larus_dp_12"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_12"
                android:layout_marginHorizontal="?attr/larus_dp_12"
                app:actualImageScaleType="centerCrop"/>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/scene_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            android:indeterminateTint="@color/larus_static_black"
            style="@style/larus_LoadingProgressBar"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:ellipsize="end"
        android:id="@+id/scene_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:maxLines="3"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scene_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
