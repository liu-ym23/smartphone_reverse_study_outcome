<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraNovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_master_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_noti_v3_notification_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_broadcast_title_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.common_ui.widget.UrlSpanTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/dora_noti_v3_notification_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                android:textFontWeight="500"
                app:larus_linkColor="?attr/larus_neutral_100"
                app:larus_linkUnderLine="false"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="#993c3c43"
                android:id="@+id/dora_noti_v3_content_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:text="@string/larus_dora_broadcast_v3_content_section_title_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="500"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_content_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_social_message"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_social_message_title_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_service_notice"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_service_notification_title_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_app_management_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_notification_app_list_setting"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_app_management_title_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_custom_broadcast_rules_entrance"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_title_custom_broadcast_rules_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="#993c3c43"
                android:id="@+id/dora_noti_v3_behavior_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:text="@string/larus_dora_broadcast_v3_behavior_section_title_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="500"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_behavior_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_notification_freq"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_frequency_title_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_noti_v3_priority"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_conflict_title_cn"
                    android:textFontWeight="500"
                    app:larus_long_sub_text="true"/>
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_noti_v3_head_gesture_control_switch"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_head_action_broadcast_left_right_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_dora_broadcast_v3_head_gesture_desc_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="#993c3c43"
                android:id="@+id/dora_noti_v3_more_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:text="@string/larus_dora_broadcast_v3_more_section_title_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="500"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_more_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_noti_v3_wearing_remind"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_proactive_wear_broadcast_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_dora_proactive_wear_broadcast_subtitle_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_noti_v3_invalid_help_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.dora.impl.view.DoraItemTextArrowSubTitle
                    android:id="@+id/dora_noti_v3_invalid_help_entrance"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_troubleshoot_entry_title_cn"
                    android:textFontWeight="500"
                    app:larus_arrow_sub_text="@string/larus_dora_broadcast_v3_troubleshoot_entry_desc_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
