<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/account_bg_tips_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/account_main_text_color"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/account_main_text_color"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:lineSpacingExtra="3dp"
        android:layout_marginHorizontal="20dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <View
        android:id="@+id/vertical_divider"
        android:background="#f2f2f2"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:id="@+id/click_item_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="43dp">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/account_main_text_color"
            android:gravity="center"
            android:id="@+id/item_negative"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/horizontal_divider"
            android:background="#f2f2f2"
            android:visibility="gone"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/account_primary_color"
            android:gravity="center"
            android:id="@+id/item_positive"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
