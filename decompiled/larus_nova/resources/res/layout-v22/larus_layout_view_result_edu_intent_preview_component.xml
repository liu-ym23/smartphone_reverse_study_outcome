<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <FrameLayout
        android:id="@+id/edu_image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_static_white"
        android:id="@+id/intent_btn"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:drawablePadding="?attr/larus_dp_2"
        android:paddingStart="?attr/larus_dp_14"
        android:paddingEnd="?attr/larus_dp_10"
        android:paddingVertical="?attr/larus_dp_8"
        app:drawableEndCompat="@drawable/larus_ic_edu_intent_switch"
        app:layout_constraintBottom_toBottomOf="@+id/edu_image_container"
        app:layout_constraintEnd_toEndOf="@+id/edu_image_container"
        app:layout_constraintStart_toStartOf="@+id/edu_image_container"/>
    <com.larus.camera.impl.ui.component.result.edu.EduResultTabView
        android:id="@+id/edu_result_tab_view"
        app:layout_constraintBottom_toBottomOf="@+id/edu_image_container"
        app:layout_constraintEnd_toEndOf="@+id/edu_image_container"
        app:layout_constraintStart_toStartOf="@+id/edu_image_container"
        style="@style/Larus.EduResultTabView"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
</androidx.constraintlayout.widget.ConstraintLayout>
