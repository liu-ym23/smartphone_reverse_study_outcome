<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/larus_base_1_1"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_68"
    android:foreground="?android:attr/selectableItemBackground">
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_100"
        android:layout_gravity="center"
        android:id="@+id/load_more_failed_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_inapp_search_no_internet"
        android:drawableLeft="@drawable/drawable_ic_search_retry"
        android:drawablePadding="5dp"
        android:drawableTint="@color/larus_neutral_100"
        android:textFontWeight="400"/>
</FrameLayout>
