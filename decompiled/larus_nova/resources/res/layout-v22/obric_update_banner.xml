<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/obric_bg_banner_popup_window"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_112">
    <ImageView
        android:id="@+id/obric_update_banner_icon"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/obric_icon_banner_popup_window"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/neutral_100"
        android:id="@+id/obric_update_banner_hint"
        android:visibility="gone"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:textFontWeight="480"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/obric_update_banner_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/obric_update_banner_with_subtitle_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/obric_update_banner_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/neutral_100"
            android:id="@+id/obric_update_banner_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_update_banner_title_available"
            android:textFontWeight="480"
            app:layout_constraintBottom_toTopOf="@+id/obric_update_banner_sub_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="@color/neutral_50"
            android:id="@+id/obric_update_banner_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="130MB"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/obric_update_banner_main_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group_obric_banner_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/obric_banner_btn_add"
            android:background="@drawable/obric_banner_add_bg"
            android:paddingLeft="@dimen/dp_8"
            android:paddingTop="@dimen/dp_8"
            android:paddingRight="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:minWidth="@dimen/dp_56"
            android:text="@string/obric_update_banner_button_update"
            android:layout_marginEnd="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_8"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.obric.assistant.common.ui.progressbar.CustomUpdateCircleProgressBar
        android:id="@+id/obric_banner_btn_update_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/obric_banner_btn_continue"
        android:background="@drawable/obric_banner_add_bg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_36"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="@dimen/dp_14"
            android:layout_height="@dimen/dp_14"
            android:src="@drawable/ic_obric_download"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_continue_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/obric_banner_btn_continue_text"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:text="@string/obric_update_banner_button_continue_hint"
            android:layout_marginEnd="@dimen/dp_14"
            android:paddingVertical="@dimen/dp_8"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/obric_loading_page"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:indeterminateTint="@color/larus_neutral_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/obric_banner_btn_close"
        android:background="@drawable/obric_banner_close_selector"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/obric_banner_close"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
