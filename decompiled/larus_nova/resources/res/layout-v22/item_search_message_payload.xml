<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/larus_white_bg_item_middle"
    android:paddingTop="?attr/larus_dp_10"
    android:paddingBottom="?attr/larus_dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_68"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16"
    android:paddingVertical="?attr/larus_dp_10">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar_container"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_search_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/message_title_digest_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/text_search_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textFontWeight="400"/>
            <TextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/text_search_archived_label"
                android:background="@drawable/larus_bg_search_archive_tag"
                android:paddingLeft="?attr/larus_dp_5"
                android:paddingTop="?attr/larus_dp_2"
                android:paddingRight="?attr/larus_dp_5"
                android:paddingBottom="?attr/larus_dp_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_infra_archiveChat_navBar_filterOption_hidden"
                android:maxLines="1"
                android:fontFamily="PingFang SC"
                android:layout_marginStart="?attr/larus_dp_4"
                android:paddingHorizontal="?attr/larus_dp_5"
                android:paddingVertical="?attr/larus_dp_2"
                android:textFontWeight="400"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_tag_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/text_search_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:layout_gravity="bottom"
        android:id="@+id/text_search_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_16"/>
</LinearLayout>
