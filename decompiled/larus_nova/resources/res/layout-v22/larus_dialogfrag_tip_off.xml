<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_52"
        app:rv_backgroundColor="?attr/larus_base_3_overlay"
        app:rv_cornerRadius_TL="?attr/larus_dp_24"
        app:rv_cornerRadius_TR="?attr/larus_dp_24">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_18"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_feedback_submit_header"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_close"
                android:padding="?attr/larus_dp_6"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:src="?attr/larus_ic_close"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </FrameLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/larus_shape_nestscroll_bar"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginRight="?attr/larus_dp_16"
                android:layout_marginHorizontal="?attr/larus_dp_16">
                <com.larus.bmhome.chat.view.FlowTagLayout
                    android:id="@+id/flow_tag_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"/>
                <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                    android:id="@+id/input_container"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_140"
                    android:layout_marginTop="?attr/larus_dp_12"
                    app:rv_backgroundColor="?attr/larus_base_4"
                    app:rv_cornerRadius="?attr/larus_dp_16">
                    <com.larus.common_ui.widget.NestedScrollEditText
                        android:textSize="?attr/larus_dp_17"
                        android:gravity="start|top"
                        android:id="@+id/et_input"
                        android:background="@null"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="?attr/larus_dp_16"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:layout_marginRight="?attr/larus_dp_16"
                        android:layout_marginBottom="?attr/larus_dp_12"
                        android:maxLength="500"
                        android:overScrollMode="always"
                        android:layout_marginHorizontal="?attr/larus_dp_16"
                        android:layout_marginVertical="?attr/larus_dp_12"
                        android:textFontWeight="400"
                        style="@style/larus_EditTextStyle"/>
                </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:id="@+id/experience_plan_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginHorizontal="?attr/larus_dp_16"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:text="@string/larus_dislike_feedback_submit"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_16"/>
    </com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
</FrameLayout>
