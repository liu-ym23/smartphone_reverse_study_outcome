<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.locallife.dito.baseview.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/photo_container"
    android:background="@color/POIBgPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imageview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/photo_imageview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:background="@color/POISDQuaternary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/error_mask"
            android:background="#80ffffff"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <LinearLayout
            android:id="@+id/select_icon_view"
            android:padding="8dp"
            android:visibility="invisible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/select_icon"
                android:background="@drawable/poi_album_unselected_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/ConstTextInverse"
        android:ellipsize="end"
        android:id="@+id/photo_type"
        android:background="@drawable/bg_poi_album_page_photo_mask"
        android:paddingLeft="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignBottom="@+id/imageview_container"/>
</com.bytedance.locallife.dito.baseview.RoundRelativeLayout>
