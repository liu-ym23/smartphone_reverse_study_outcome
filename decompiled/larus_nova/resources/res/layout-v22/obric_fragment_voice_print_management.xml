<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/voice_print_management_scroll_view"
        android:paddingTop="96dp"
        android:paddingBottom="@dimen/dp_64"
        android:scrollbars="none"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_phone_voiceprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:showDividers="none"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_accessory_voiceprint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/obric_guide_text_3"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_setting_voice_print_management_accessory_title"
                    android:paddingStart="32dp"
                    android:paddingEnd="12dp"
                    android:textFontWeight="500"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/accessory_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:showDividers="none"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_current_device"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/obric_guide_text_3"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_setting_voice_print_management_current_device_title"
                    android:paddingStart="32dp"
                    android:paddingEnd="12dp"
                    android:textFontWeight="500"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/current_device_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:showDividers="none"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/obric_guide_text_3"
                    android:paddingTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_setting_voice_print_management_current_device_hint"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/obric_guide_text_3"
                android:id="@+id/tv_voiceprint_hint"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/obric_setting_voice_print_management_voice_hint"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_accessory_voiceprint_guide"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/bg_obric_accessory_voiceprint_guide"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:id="@+id/iv_accessory_voiceprint_guide_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_obric_earphone_earbud_voice"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="12sp"
                        android:textColor="@color/obric_guide_text_3"
                        android:id="@+id/tv_accessory_voiceprint_guide_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/obric_setting_voice_print_management_accessory_guide_title"
                        android:textFontWeight="500"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_accessory_voiceprint_guide_icon"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="14sp"
                        android:textColor="@color/obric_guide_text_1"
                        android:id="@+id/tv_accessory_voiceprint_guide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/obric_setting_voice_print_management_accessory_guide"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_accessory_voiceprint_guide_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/voice_print_management_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
