<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/left_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ttlive_ktv_panel_left_back_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/title_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="K歌"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineHeight="23.8dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/left_back"
        app:layout_constraintRight_toLeftOf="@+id/title_second"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/title_first_divider"
        android:background="#161823"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/title_first"
        app:layout_constraintStart_toStartOf="@+id/title_first"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/title_first_corner"
        android:background="@drawable/ttlive_solo_red_corner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:translationX="-5dp"
        android:translationY="5dp"
        android:lineHeight="23.8dp"
        app:layout_constraintBottom_toTopOf="@+id/title_first"
        app:layout_constraintLeft_toRightOf="@+id/title_first"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/title_second"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineHeight="23.8dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/title_first"
        app:layout_constraintRight_toLeftOf="@+id/share_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/title_second_divider"
        android:background="#161823"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/title_second"
        app:layout_constraintStart_toStartOf="@+id/title_second"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/title_second_corner"
        android:background="@drawable/ttlive_solo_red_corner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:translationX="-5dp"
        android:translationY="5dp"
        android:lineHeight="23.8dp"
        app:layout_constraintBottom_toTopOf="@+id/title_second"
        app:layout_constraintLeft_toRightOf="@+id/title_second"/>
    <ImageView
        android:id="@+id/share_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/solo_ktv_karaoke_station_share_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
