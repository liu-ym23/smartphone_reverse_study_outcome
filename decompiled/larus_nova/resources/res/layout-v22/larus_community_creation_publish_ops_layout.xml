<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/publish_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_community_download_loading_animated"
        android:indeterminateDuration="2000"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/publish_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/publish_icon"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_community_arrow_up_circle_fill"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/publish_loading"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/button_view"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_ccMob_PreviewPage_btn_makePublic"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/publish_icon"/>
</merge>
