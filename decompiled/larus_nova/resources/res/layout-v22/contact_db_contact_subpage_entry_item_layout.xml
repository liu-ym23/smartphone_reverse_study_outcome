<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_new_friend_item"
        android:background="@drawable/contact_db_contact_item_bg_selector"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_new_friend_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp"
            app:srcCompat="@drawable/contact_db_new_contact_icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/flow_ud_neutral_100"
                android:id="@+id/tv_new_friend_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LarkIM_Friend_NewContact_Title"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/flow_ud_neutral_50"
                android:ellipsize="end"
                android:id="@+id/tv_new_friend_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textFontWeight="400"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/tv_new_friend_badge"
            android:background="@drawable/contact_db_badge_circle_danger_50"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_group_chat_item"
        android:background="@drawable/contact_db_contact_item_bg_selector"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp"
            app:srcCompat="@drawable/contact_db_group_icon"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkIM_Friend_Groups_Menu"
            android:textFontWeight="600"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_external_contact_item"
        android:background="@drawable/contact_db_contact_item_bg_selector"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_external_contact_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp"
            app:srcCompat="@drawable/contact_db_icon_external_contacts"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:id="@+id/tv_external_contact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Legacy_StructureExternal"
            android:textFontWeight="600"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_profile_card_item"
        android:background="@drawable/contact_db_contact_item_bg_selector"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/iv_profile_card_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="12dp"
            android:scaleType="centerCrop"
            app:border_width="0dp"
            app:oval="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/flow_ud_neutral_100"
                android:id="@+id/tv_profile_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textFontWeight="600"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/flow_ud_neutral_50"
                android:id="@+id/tv_profile_card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/LarkIM_Friend_Contacts_MyCard_Text"
                android:textFontWeight="400"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/flow_ud_neutral_50"
        android:id="@+id/tv_org_contacts_title"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/LarkIM_Contacts_OrgContacts_Title"/>
</LinearLayout>
