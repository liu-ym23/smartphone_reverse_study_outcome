<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <ScrollView
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingRight="?attr/larus_dp_20"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="?attr/larus_dp_20">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.legacy.widget.Space
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_12"/>
            <TextView
                android:textSize="?attr/larus_dp_20"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:id="@+id/event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_5">
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/neutral_50"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/event_date_time"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="?attr/larus_dp_11"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_70"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/event_type"
                    android:background="@drawable/bg_event_state"
                    android:paddingLeft="?attr/larus_dp_6"
                    android:paddingTop="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_6"
                    android:paddingBottom="?attr/larus_dp_4"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="?attr/larus_dp_8"
                    android:paddingHorizontal="?attr/larus_dp_6"
                    android:paddingVertical="?attr/larus_dp_4"/>
            </LinearLayout>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/event_time_range"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_22"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/event_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"/>
        </LinearLayout>
    </ScrollView>
    <androidx.legacy.widget.Space
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_20"/>
</androidx.appcompat.widget.LinearLayoutCompat>
