<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraMovieView
        android:id="@+id/dora_scan_mv"
        android:layout_width="?attr/larus_dp_330"
        android:layout_height="?attr/larus_dp_330"
        android:layout_marginTop="?attr/larus_dp_76"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dora_scan_image_view"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_27"
        android:layout_marginTop="?attr/larus_dp_69"
        android:src="@drawable/larus_dora_ic_ola_friend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_scan_mv"
        app:tint="@color/larus_neutral_100"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/dora_scan_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_dora_scan_device_introduction_cn"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_scan_image_view"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/dora_learn_more"
        android:background="@drawable/larus_dora_scan_learn_more_btn_bg"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_20"
        android:paddingBottom="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_32"
        android:text="@string/larus_dora_learn_more_cn"
        android:paddingHorizontal="?attr/larus_dp_20"
        android:paddingVertical="?attr/larus_dp_10"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_scan_text_view"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/dora_scan_for_a_long_time_balloon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_300"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dora_scan_mv">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_message_menu_arrow"
            app:tint="@color/larus_base_3"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_100"
            android:background="@drawable/larus_dora_scan_for_a_long_time_balloon_bg"
            android:paddingLeft="?attr/larus_dp_15"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_15"
            android:paddingBottom="?attr/larus_dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_enter_pariable_mode_tips_cn"
            android:paddingHorizontal="?attr/larus_dp_15"
            android:paddingVertical="?attr/larus_dp_12"
            android:textFontWeight="400"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
