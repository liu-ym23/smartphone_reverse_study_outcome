<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intent_card_container"
    android:background="@drawable/intent_card_bg_light"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/weather_logo"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textColor="@color/assistant_card_neutral_70"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_app_name"
        android:layout_alignTop="@+id/logo"
        android:layout_alignBottom="@+id/logo"
        android:layout_toEndOf="@+id/logo"
        style="@style/Label_M_Thin"/>
    <FrameLayout
        android:id="@+id/divider"
        android:background="@color/assistant_card_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/logo"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_below="@+id/divider"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textColor="@color/assistant_card_neutral_100"
        android:id="@+id/main_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/divider"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/icon"
        style="@style/Title_Title_M"/>
    <FrameLayout
        android:id="@+id/tag_container"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_below="@+id/divider"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/main_info"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">
        <TextView
            android:id="@+id/tag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label_S_Thick"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/assistant_card_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/sub_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/main_info"
        android:layout_alignStart="@+id/main_info"
        style="@style/Label_M"/>
    <RelativeLayout
        android:id="@+id/sub_time_divider_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/sub_info"
        android:layout_alignBottom="@+id/sub_info"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/sub_info">
        <FrameLayout
            android:id="@+id/sub_time_divider"
            android:background="@color/assistant_card_neutral_transparent_2"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/assistant_card_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignTop="@+id/sub_info"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/sub_time_divider_container"
        style="@style/Label_M"/>
</RelativeLayout>
