<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/account_saas_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/account_saas_dp_18"
        android:textColor="@color/account_saas_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_saas_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/account_saas_dp_20"
        android:layout_marginEnd="@dimen/account_saas_dp_20"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="@dimen/account_saas_dp_15"
        android:textColor="@color/account_saas_neutral_70"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_saas_dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/account_saas_dp_20"
        android:layout_marginEnd="@dimen/account_saas_dp_20"
        android:textFontWeight="400"/>
    <View
        android:background="@drawable/account_saas_item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_saas_dp_0_5"
        android:layout_marginTop="@dimen/account_saas_dp_24"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
