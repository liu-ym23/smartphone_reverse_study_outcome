<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/title_bar"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_34"
        android:paddingHorizontal="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_music_template_title"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_icon"
        android:background="@drawable/larus_bg_music_template_back"
        android:padding="9dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/larus_ic_music_detail_back"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/template_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_input"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <FrameLayout
        android:id="@+id/start_write_entry_container"
        android:background="@drawable/larus_bg_music_template_start_write"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingRight="?attr/larus_dp_24"
        android:layout_width="160dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:minWidth="?attr/larus_dp_160"
        android:elevation="?attr/larus_dp_12"
        android:paddingHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/larus_ic_start_write_music"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="64dp"
                android:layout_height="22dp"
                android:src="@drawable/larus_ic_start_write_music_text"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/chat_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <ViewStub
            android:id="@+id/input_delegate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.larus.bmhome.view.ChatConstraintLayout>
