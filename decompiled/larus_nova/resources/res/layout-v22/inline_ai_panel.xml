<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/mask_full_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/mask_around_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space_above_panel"/>
    <androidx.legacy.widget.Space
        android:id="@+id/space_above_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ss.android.lark.inline.ai.ui.PanelView
        android:id="@+id/panel_view"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/drag_view_wrapper"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintBottom_toTopOf="@+id/content_container"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/drag_view"
                android:background="@drawable/inline_ai_drag_bar_background"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tips_and_feedback_wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drag_view_wrapper"
            app:layout_goneMarginBottom="8dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tips_and_feedback_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/history_and_feedback_wrapper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_container">
            <RelativeLayout
                android:id="@+id/tips_group"
                android:paddingBottom="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/feedback_container_in_tips"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/tips_icon"
                    android:paddingTop="13dp"
                    android:paddingBottom="1dp"
                    android:layout_width="38dp"
                    android:layout_height="30dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    app:srcCompat="@drawable/ud_icon_info_outlined"
                    app:tint="@color/icon_disable"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_disabled"
                    android:id="@+id/tips_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="-8dp"
                    android:layout_toEndOf="@+id/tips_icon"
                    app:lineHeight="18dp"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/feedback_container_in_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/feedback_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/feedback_thumbs_up"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        app:srcCompat="@drawable/ud_icon_thumbsup_outlined"
                        app:tint="@color/icon_n3"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/feedback_thumbs_down"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        app:srcCompat="@drawable/ud_icon_thumbdown_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/history_and_feedback_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/operates_rv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_and_feedback_wrapper">
            <RelativeLayout
                android:id="@+id/history_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/history_pre"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    app:srcCompat="@drawable/ud_icon_left_bold_outlined"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/history_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginStart="-10dp"
                    android:layout_toEndOf="@+id/history_pre"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/history_next"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="-10dp"
                    android:layout_toEndOf="@+id/history_text"
                    app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/feedback_container_in_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.ss.android.lark.inline.ai.ui.operates.OperatesRecyclerView
            android:id="@+id/operates_rv"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toTopOf="@+id/prompts_rv"
            app:layout_constraintTop_toBottomOf="@+id/history_and_feedback_wrapper"/>
        <View
            android:id="@+id/prompts_and_input_background"
            android:background="@drawable/inline_ai_section_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/range_container"
            app:layout_constraintTop_toTopOf="@+id/prompts_rv"/>
        <com.ss.android.lark.inline.ai.ui.prompts.PromptsRecyclerView
            android:id="@+id/prompts_rv"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/range_container"
            app:layout_constraintTop_toBottomOf="@+id/operates_rv"/>
        <View
            android:id="@+id/prompts_block_view"
            android:background="@color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/prompts_rv"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/range_container"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@+id/input_group"
            app:layout_constraintTop_toBottomOf="@+id/prompts_rv">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/inline_ai_range_background"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/range_text"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/range_edit_icon"
                    android:padding="4dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/ud_icon_ccm_edit_outlined"
                    app:tint="@color/icon_n2"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_group"
            android:background="@drawable/inline_ai_input_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/range_container">
            <FrameLayout
                android:id="@+id/input_icon_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/input_icon_normal"
                    android:padding="1dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ud_icon_myai_colorful"/>
                <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                    android:id="@+id/input_icon_thinking"
                    android:padding="1dp"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/inline_ai_thinking_anim"
                    app:lottie_repeatMode="restart"/>
            </FrameLayout>
            <com.ss.android.lark.inline.ai.ui.InlineAIEditText
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:textColorHint="@color/icon_n3"
                android:ellipsize="end"
                android:id="@+id/input_text"
                android:background="@color/bg_filler"
                android:padding="0dp"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:maxHeight="85dp"
                android:maxLines="4"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoExtractUi"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/input_at_icon"
                app:layout_constraintStart_toEndOf="@+id/input_icon_wrapper"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="13dp"
                style="@style/UDEditText"/>
            <FrameLayout
                android:id="@+id/input_right_icon_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/input_stop_icon"
                    android:padding="7dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:srcCompat="@drawable/ud_icon_stop_outlined"
                    app:tint="@color/icon_n3"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/input_send_icon"
                    android:padding="6dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:srcCompat="@drawable/inline_ai_icon_send"/>
            </FrameLayout>
            <View
                android:id="@+id/input_divider"
                android:background="@color/line_divider_default"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintRight_toLeftOf="@+id/input_right_icon_wrapper"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/input_at_icon"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintRight_toLeftOf="@+id/input_divider"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_at_outlined"
                app:tint="@color/icon_n3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.ss.android.lark.inline.ai.ui.PanelView>
</androidx.constraintlayout.widget.ConstraintLayout>
