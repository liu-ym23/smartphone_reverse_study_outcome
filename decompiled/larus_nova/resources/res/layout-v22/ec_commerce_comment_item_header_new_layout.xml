<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_comment_item_header_new_layout_587011801"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/ec_commerce_comment_item_header_new_layout_12123712"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_hot_zone_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.shopping.widget.legacy.AvatarImageView
                android:id="@+id/comment_sv_user_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/shopping_color_08161823"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/user_name_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintLeft_toRightOf="@+id/comment_sv_user_avatar"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:id="@+id/comment_tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/comment_tag_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ic_comment_rank_info_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    app:layoutMode="self_adjust_3X"/>
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ic_comment_repeat_customer_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    app:layoutMode="self_adjust_3X"/>
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ic_mall_gold_card_tag"
                    android:visibility="gone"
                    android:layout_width="49dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    android:scaleType="fitXY"
                    android:layout_marginStart="4dp"/>
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/comment_shopping_fans_group_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp">
                    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                        android:id="@+id/comment_ic_shopping_fans_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layoutMode="self_adjust_3X"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/commerce_color_FFFFFF"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/comment_shopping_fans_group_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4.5dp"
                        android:textFontWeight="400"/>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/commerce_color_57161823"
                android:gravity="bottom"
                android:id="@+id/comment_tv_comment_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/comment_sv_user_avatar"
                app:layout_constraintStart_toEndOf="@+id/comment_sv_user_avatar"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/commerce_color_57161823"
                android:gravity="bottom"
                android:id="@+id/comment_tv_comment_shop"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/comment_tv_comment_time"
                app:layout_constraintStart_toEndOf="@+id/comment_tv_comment_time"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/commerce_color_57161823"
            android:gravity="center_vertical"
            android:id="@+id/comment_tv_comment_time_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/comment_item_sv_rank_type"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/comment_item_sv_rank_type"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/more_actions_iv"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/anchor_v3_comment_report_icon"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment_sku_info_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/comment_iv_rank_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:scaleType="centerCrop"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/shopping_color_99161823"
            android:ellipsize="end"
            android:id="@+id/comment_tv_sku_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
