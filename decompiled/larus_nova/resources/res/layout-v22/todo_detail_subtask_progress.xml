<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/progress_add_container"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp">
        <ImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ud_icon_subtasks_outlined"
            android:tint="@color/icon_n3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:gravity="center_vertical"
            android:id="@+id/text_add_subtask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Todo_AddASubTask_Placeholder"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:id="@+id/text_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_12"/>
        <com.larksuite.component.universe_design.progress.UDProgress
            android:layout_gravity="center_vertical"
            android:id="@+id/subtask_progress"
            android:visibility="gone"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_10"
            android:progress="50"
            app:ud_progress_indicatorColor="@color/primary_content_default"
            app:ud_progress_indicatorCornerRadius="@dimen/dp_5"
            app:ud_progress_thickness="10dp"
            app:ud_progress_trackColor="@color/ud_N300"
            app:ud_progress_type="linear"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/sub_tasks_SkeletonFl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
