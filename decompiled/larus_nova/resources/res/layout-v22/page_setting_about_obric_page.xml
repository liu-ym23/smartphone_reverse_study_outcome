<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.common_ui.view.ChatSettingScrollView
            android:id="@+id/scroll_view"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_38"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/larus_layout_common_padding"
            android:paddingEnd="@dimen/larus_layout_common_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/default_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/neutral_50"
                        android:id="@+id/default_group_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:text="@string/larus_AboutPage_doubao_cn"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/item_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/user_agreement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_term_of_use"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/privacy_policy_abs"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_privacy_terms_abs_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/privacy_policy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_privacy_policy"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/sensitive_permissions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_settings_privacy_access_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/community_guidelines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_community_guidelines"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/protect_guideline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_ip_protection_guideline_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/trust_center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_settingsPage_aboutApp_header_trustCenter"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/bug_submission"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_subEntry_aboutCiCiPage_menuLink"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/business_license"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_aboutdoubao_license_commercial_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/icp_record"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_aboutdoubao_license_icp_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/about_sky_luck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/business_ipc_oco"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_wangwen_certificate"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/business_ipc_operate"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_icp_certificate"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/app_permissions_in_setting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/system_permission"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/about_stop_app_service"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stop_service"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:layout_gravity="start"
                            android:id="@+id/about_check_app_update"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/update_check"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextToggle
                            android:id="@+id/about_wifi_auto_download"
                            android:background="@drawable/larus_bg_item_selector_middle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_auto_download"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:layout_gravity="start"
                            android:id="@+id/about_withdraw_privacy_agreement"
                            android:background="@drawable/larus_bg_item_selector_last"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/withdraw_privacy_agreement"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ecommerce_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/neutral_50"
                        android:id="@+id/ecommerce_group_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:text="@string/larus_AboutPage_douyin_ecommerce_cn"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/ecommerce_item_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/ecommerce_qualification_rules"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_douyin_ecommerce_qualification_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/other_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/neutral_50"
                        android:id="@+id/other_group_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:text="@string/larus_AboutPage_other_cn"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/other_item_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/shopping_payment_faq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_shopping_payment_faq_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/local_life_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp_12"
                        android:textColor="@color/neutral_50"
                        android:id="@+id/local_life_group_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:text="@string/larus_AboutPage_douyin_locallife_cn"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/local_life_item_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/local_life_qualification_rules"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_douyin_locallife_qualification_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/local_life_user_agreement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_douyin_locallife_useragreement_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/local_life_privacy_agreement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_douyin_locallife_privacypolicy_cn"
                            android:textFontWeight="500"/>
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:id="@+id/local_life_rule_center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_AboutPage_douyin_locallife_rulecenter_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/neutral_50"
                    android:gravity="center"
                    android:id="@+id/model_detail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"/>
            </LinearLayout>
        </com.larus.common_ui.view.ChatSettingScrollView>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_50"
            android:gravity="center"
            android:id="@+id/hotline"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_hotline_desc_cn"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
