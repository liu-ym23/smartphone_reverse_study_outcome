<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cj_pay_voucher_tag_layout"
        android:background="@drawable/cj_pay_reverse_counter_voucher_bg"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cj_pay_tag_amount_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/cj_pay_voucher_tag_number_pre_des_layout"
                android:background="@drawable/cj_pay_voucher_tag_pre_desc_bg"
                android:paddingLeft="2dp"
                android:paddingTop="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="9sp"
                    android:textColor="#fffe2c55"
                    android:id="@+id/cj_pay_voucher_tag_number_pre_des"
                    android:layout_width="9sp"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="-2sp"
                    android:lineHeight="11sp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:baselineAligned="true">
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#fffe2c55"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_voucher_tag_amount_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineSpacingExtra="-7sp"
                    android:lineHeight="34sp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#fffe2c55"
                    android:id="@+id/cj_pay_voucher_tag_amount_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fffe2c55"
            android:id="@+id/cj_pay_voucher_tag_desc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_tag_amount_layout"
            android:layout_centerHorizontal="true"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
        android:id="@+id/cj_pay_voucher_tag_checkbox"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"/>
</LinearLayout>
