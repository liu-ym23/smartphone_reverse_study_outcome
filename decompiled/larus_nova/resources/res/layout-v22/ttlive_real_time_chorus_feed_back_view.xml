<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_chorus_feed_back_bg"
    android:layout_width="307dp"
    android:layout_height="255dp">
    <ImageView
        android:layout_width="125dp"
        android:layout_height="52dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/ttlive_real_time_chorus_bg_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="32dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/feed_back_song_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:textFontWeight="400"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="分"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/feed_back_song_score"
        app:layout_constraintLeft_toRightOf="@+id/feed_back_song_score"
        app:layout_constraintTop_toTopOf="@+id/feed_back_song_score"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:id="@+id/feed_back_song_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="22dp"
        android:layout_height="0.5dp"
        android:src="@drawable/ttlive_real_time_chorus_feed_back_left_line"
        app:layout_constraintBottom_toBottomOf="@+id/feed_back_song_name"
        app:layout_constraintEnd_toStartOf="@+id/feed_back_song_name"
        app:layout_constraintTop_toTopOf="@+id/feed_back_song_name"/>
    <ImageView
        android:layout_width="22dp"
        android:layout_height="0.5dp"
        android:src="@drawable/ttlive_real_time_chorus_feed_back_right_line"
        app:layout_constraintBottom_toBottomOf="@+id/feed_back_song_name"
        app:layout_constraintStart_toEndOf="@+id/feed_back_song_name"
        app:layout_constraintTop_toTopOf="@+id/feed_back_song_name"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_real_time_chorus_feed_back_number_bg"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="7sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/feed_back_singer_number"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:src="@drawable/chorus_singer_info_arrow"
            android:layout_marginStart="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/feed_back_singer_number"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_first"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:layout_marginBottom="45dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/chorus_first_crown"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="127dp"
        android:src="@drawable/ttlive_real_time_chorus_feed_back_first"
        android:layout_marginEnd="113dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_second"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginBottom="71dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/chorus_second_crown"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginTop="129dp"
        android:src="@drawable/ttlive_real_time_chorus_feed_back_second"
        android:layout_marginEnd="218dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_third"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="29dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="216dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/chorus_third_crown"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="182dp"
        android:src="@drawable/ttlive_real_time_chorus_feed_back_third"
        android:layout_marginEnd="47dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_four"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="73dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="195dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_five"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="31dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="97dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_six"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="50dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/feed_back_seven"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="83dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="274dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="7sp"
        android:textColor="#ffffff"
        android:id="@+id/feed_back_first_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="@+id/feed_back_first"
        app:layout_constraintStart_toStartOf="@+id/feed_back_first"
        app:layout_constraintTop_toBottomOf="@+id/feed_back_first"/>
    <TextView
        android:textSize="7dp"
        android:textColor="#ffffff"
        android:id="@+id/feed_back_second_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="@+id/feed_back_second"
        app:layout_constraintStart_toStartOf="@+id/feed_back_second"
        app:layout_constraintTop_toBottomOf="@+id/feed_back_second"/>
    <TextView
        android:textSize="7dp"
        android:textColor="#ffffff"
        android:id="@+id/feed_back_third_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="@+id/feed_back_third"
        app:layout_constraintStart_toStartOf="@+id/feed_back_third"
        app:layout_constraintTop_toBottomOf="@+id/feed_back_third"/>
</androidx.constraintlayout.widget.ConstraintLayout>
