<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llPreviewBg"
        android:background="@drawable/bg_sticker_preview_center"
        android:paddingLeft="15dp"
        android:paddingTop="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp">
        <FrameLayout
            android:layout_width="146dp"
            android:layout_height="146dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sticker_preview_action_selector"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/btnRemove"
            android:background="@drawable/bg_sticker_preview_action_selector"
            android:layout_width="146dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="@string/LarkIM_Chat_RemoveSticker_Button"
            android:lines="1"/>
    </LinearLayout>
</FrameLayout>
