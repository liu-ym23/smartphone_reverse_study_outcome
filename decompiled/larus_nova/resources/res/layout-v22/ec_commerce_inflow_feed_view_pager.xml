<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.widget.banner.BannerRecyclerView
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.shopping.product.flow.indicator.MediaBannerIndicatorView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/media_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"/>
    <com.bytedance.android.shopping.product.flow.indicator.DefaultBannerIndicatorView
        android:textColor="@color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/page_indicator"
        android:background="@drawable/shopping_bg_product_feed_indicator"
        android:paddingLeft="8dp"
        android:paddingTop="7.5dp"
        android:paddingRight="8dp"
        android:paddingBottom="7.5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/font_size_20"/>
    <com.bytedance.android.shopping.inflow.view.InFlowNumberBannerIndicatorView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/num_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <com.bytedance.android.shopping.feed.banner.ImageSlideListProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/view_pager_wrapper_image_progress_bar_group"
        android:background="@drawable/ec_commerce_inflow_feed_progress_container_bg"
        android:paddingLeft="6dp"
        android:paddingTop="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:paddingHorizontal="6dp"/>
</FrameLayout>
