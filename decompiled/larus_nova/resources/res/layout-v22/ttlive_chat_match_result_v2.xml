<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_fast_match_result_v2_container_height"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="14dp"
        android:textColor="#88161823"
        android:id="@+id/cancel_btn"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_avatar_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cancel_btn"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatar_gender_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingRight="80dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:paddingEnd="80dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toTopOf="@+id/ttlive_avatar_view">
        <TextView
            android:textSize="16dp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/avatar_name_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/avatar_list_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_name_view"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:id="@+id/link_guest_num"
            android:background="@drawable/ttlive_fast_match_topic_item_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_list_view"
            app:layout_constraintStart_toEndOf="@+id/avatar_list_view"
            app:layout_constraintTop_toTopOf="@+id/avatar_list_view"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/avatar_topic_list_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/avatar_name_view"
            app:layout_constraintTop_toBottomOf="@+id/avatar_list_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/center_guideline"
        android:layout_width="11dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/rematch_btn"
            android:background="@drawable/ttlive_btn_rematch_chat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="@string/ttlive_interact_rematch"
            android:layout_weight="1"/>
        <com.bytedance.android.livesdk.widget.desc.CountDownWithDescTextView
            android:id="@+id/match_go_btn"
            android:background="@drawable/ttlive_btn_match_chat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="11dp"
            android:layout_weight="1"
            android:layout_marginStart="11dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
