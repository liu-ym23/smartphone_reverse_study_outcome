<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:fadingEdgeLength="8dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#e5242634"
    app:cardCornerRadius="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_text_message_medium_color"
                android:ellipsize="end"
                android:id="@+id/tv_prompt_send_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:maxEms="6"
                android:singleLine="true"
                android:layout_marginStart="12dp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_white_75"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/ttlive_text_sent_a_prompt"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:lineHeight="18dp"
                android:textFontWeight="400"/>
            <ImageView
                android:id="@+id/iv_close"
                android:padding="4dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_feed_drawer_close"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/tv_prompt_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="8dp"
            android:maxLines="3"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
