<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/auth_button_group_h"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_always_h"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:text="@string/larus_plugin_always_allow_btn"
            android:maxLines="1"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/auth_once_h"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_backgroundPressColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_once_h"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:text="@string/larus_plugin_allow_btn"
            android:maxLines="1"
            android:layout_marginHorizontal="?attr/larus_dp_12"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/auth_deny_h"
            app:layout_constraintStart_toEndOf="@+id/auth_always_h"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_base_1"
            app:rv_backgroundPressColor="?attr/larus_base_1"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_deny_h"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:text="@string/larus_plugin_decline_btn"
            android:maxLines="1"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/auth_once_h"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_base_1"
            app:rv_backgroundPressColor="?attr/larus_base_1"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/auth_button_group_v"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_always_v"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:text="@string/larus_plugin_always_allow_btn"
            android:maxLines="1"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/auth_once_v"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_backgroundPressColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_once_v"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:text="@string/larus_plugin_allow_btn"
            android:maxLines="1"
            android:layout_marginVertical="?attr/larus_dp_12"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/auth_deny_v"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auth_always_v"
            app:rv_backgroundColor="?attr/larus_base_1"
            app:rv_backgroundPressColor="?attr/larus_base_1"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/auth_deny_v"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:text="@string/larus_plugin_decline_btn"
            android:maxLines="1"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auth_once_v"
            app:rv_backgroundColor="?attr/larus_base_1"
            app:rv_backgroundPressColor="?attr/larus_base_1"
            app:rv_cornerRadius="?attr/larus_dp_14"
            app:rv_isRippleEnable="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
