<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_kit_len_16"
    android:layout_marginEnd="@dimen/space_kit_len_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_54">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/left_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_kit_len_24"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <View
            android:id="@+id/wrap_view"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:gravity="center"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:checked="true"
            android:layout_marginStart="@dimen/space_kit_len_16"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <View
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="17.5dp"/>
    <GridView
        android:id="@+id/members"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:horizontalSpacing="12dp"
        android:stretchMode="columnWidth"
        android:columnWidth="32dp"
        android:numColumns="auto_fit"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="16dp"
        android:paddingVertical="20dp"/>
</LinearLayout>
