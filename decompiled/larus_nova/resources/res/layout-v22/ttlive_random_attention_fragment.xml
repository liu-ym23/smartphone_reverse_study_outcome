<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="484dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/back_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ttlive_random_pk_notice"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/ttlive_attention_title_shadow"
        android:background="#e0e0e0"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <FrameLayout
        android:id="@+id/attention_read_switch_container"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/attention_webview_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:layout_gravity="start|center_vertical"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_random_pk_switch_tips"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_attention_before_random_pk"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="false"
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/attention_webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
            android:layout_gravity="center"
            android:id="@+id/loading_webp_view"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/agree_action_btn_container"
        android:layout_width="match_parent"
        android:layout_height="94dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_commonui_white_w1"
            android:gravity="center"
            android:id="@+id/agree_action_btn"
            android:background="@drawable/ttlive_random_check_confirme_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_confirm_lanunch_random_pk"/>
    </FrameLayout>
</LinearLayout>
