<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_front_homepage_payment_method"
    android:background="@drawable/cj_pay_r20_bg_gray"
    android:layout_width="match_parent"
    android:layout_height="420dp">
    <RelativeLayout
        android:id="@+id/cj_pay_front_homepage_title_bar"
        android:background="@drawable/cj_pay_r20_bg_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_52">
        <ImageView
            android:id="@+id/cj_pay_front_homepage_back_view"
            android:layout_width="@dimen/cj_pay_padding_28"
            android:layout_height="@dimen/cj_pay_padding_28"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_icon_titlebar_left_round_close"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/cj_pay_front_homepage_title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择优先付款方式"
            android:singleLine="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cj_pay_bg_r8_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_12"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:layout_marginBottom="@dimen/cj_pay_padding_4"
        android:layout_marginHorizontal="@dimen/cj_pay_padding_12">
        <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
            android:id="@+id/front_homepage_half_payment_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
</LinearLayout>
