<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="69dp"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/match_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/match_title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/match_title_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/match_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/match_title_container"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#fe2c55"
        android:gravity="center"
        android:id="@+id/match_speed_up_btn"
        android:background="@drawable/ttlive_multi_pk_random_match_speed_up_bg"
        android:paddingLeft="2dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="20dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:text="@string/ttlive_multi_pk_random_match_speed_up"
        android:drawableLeft="@drawable/ttlive_ic_multi_pk_random_match_speed_up_deep"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/match_sub_title"
        app:layout_constraintTop_toBottomOf="@+id/match_title_container"/>
    <TextView
        android:gravity="center"
        android:id="@+id/match_btn"
        android:visibility="visible"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_multi_pk_random_match_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ttlive_multi_pk_random_match_btn"/>
    <TextView
        android:textColor="#57161823"
        android:gravity="center"
        android:id="@+id/match_btn_unenable"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/ttlive_multi_pk_random_unsupport"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
