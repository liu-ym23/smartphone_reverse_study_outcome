<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/speak_normal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_hold_to_speak"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/speak_style_0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_hold_to_speak"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:textFontWeight="600"
        app:layout_constraintBottom_toTopOf="@+id/speak_hint_style_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/speak_hint_style_0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_continuous_voice_chat_click_input"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/speak_style_0"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/speak_style_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_hold_to_speak"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/speak_hint_style_1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/speak_hint_style_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_continuous_chat_asr_click_to_talk_cn"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:letterSpacing="0.04"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/speak_style_1"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
