<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_8">
    <FrameLayout
        android:id="@+id/avatar_parent"
        android:layout_width="?attr/larus_dp_120"
        android:layout_height="?attr/larus_dp_120">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/larus_accessibility_botCreate_profilePhoto"
            app:actualImageResource="@drawable/larus_ugc_bot_icon_avatar_empty"
            app:actualImageScaleType="centerCrop"/>
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/center_icon"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_2"
            android:layout_marginEnd="?attr/larus_dp_2"
            app:rv_backgroundColor="@color/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_36"
            app:rv_strokeColor="@color/larus_base_1_overlay"
            app:rv_strokeWidth="?attr/larus_dp_2">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_center_icon"
                android:layout_width="?attr/larus_dp_15"
                android:layout_height="?attr/larus_dp_15"
                android:src="@drawable/larus_ugc_bot_icon_avatar_plus"/>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/gen_anim"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:lottie_autoPlay="true"
            app:lottie_cacheStrategy="strong"
            app:lottie_lazyLoad="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/larus_create_bot_avatar_loading"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="@color/larus_primary_50"
        android:layout_gravity="center_horizontal"
        android:id="@+id/bottom_btn"
        android:background="@drawable/larus_bg_bot_avatar_edit_btn"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_20"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_AI_generate_avatar"
        android:paddingHorizontal="?attr/larus_dp_20"
        android:paddingVertical="?attr/larus_dp_8"/>
</LinearLayout>
