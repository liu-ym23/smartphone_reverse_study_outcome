<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44">
        <FrameLayout
            android:id="@+id/tab_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.larus.livetutor.impl.view.MultiTagListView
                android:id="@+id/live_tutor_multi_tab_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_52"
                android:layout_marginRight="@dimen/dp_52"
                android:layout_marginHorizontal="@dimen/dp_52"/>
            <View
                android:layout_gravity="start"
                android:id="@+id/tab_left_mask"
                android:layout_width="@dimen/dp_68"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="end"
                android:id="@+id/tab_right_mask"
                android:layout_width="@dimen/dp_68"
                android:layout_height="match_parent"
                android:rotation="180"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_live_tutor_home_close"
            android:layout_marginStart="18dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_tutor_title_cn"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/history"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/live_tutor_ic_history"
            android:layout_marginEnd="18dp"/>
    </FrameLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/feed_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_44"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_2"/>
    <FrameLayout
        android:id="@+id/mask_view"
        android:background="@color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/dp_1"/>
</FrameLayout>
