<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/my_ai_mock_item_preview_margin"
    android:paddingRight="@dimen/my_ai_mock_item_preview_margin"
    android:layout_width="match_parent"
    android:layout_height="@dimen/my_ai_mock_item_preview_height"
    android:paddingHorizontal="@dimen/my_ai_mock_item_preview_margin">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/template_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/preview_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/preview_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/preview_text"
        app:layout_constraintStart_toEndOf="@+id/template_prefix"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        app:srcCompat="@drawable/ic_icon_link_copy_outlined"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_link_normal"
        android:ellipsize="end"
        android:id="@+id/preview_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/template_suffix"
        app:layout_constraintStart_toEndOf="@+id/preview_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="64dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/template_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toggle"
        app:layout_constraintStart_toEndOf="@+id/preview_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/template_suffix"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:baselineAlignBottom="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/toggle"
        app:layout_constraintEnd_toEndOf="@+id/toggle"
        app:srcCompat="@drawable/ud_icon_right_outlined"
        app:tint="@color/icon_n3"/>
    <ImageView
        android:id="@+id/progress"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:baselineAlignBottom="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/toggle"
        app:layout_constraintEnd_toEndOf="@+id/toggle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
