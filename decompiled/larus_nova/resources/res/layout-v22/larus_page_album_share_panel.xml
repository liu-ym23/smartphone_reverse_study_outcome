<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_album_share_stroke_layers"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/album_share_title"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintBottom_toTopOf="@+id/album_share_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/primary_50"
        android:gravity="center_vertical"
        android:id="@+id/album_select_title"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_album_select_all_cn"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:paddingHorizontal="?attr/larus_dp_8"
        android:paddingVertical="?attr/larus_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/album_share_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/album_share_close"
        android:padding="?attr/larus_dp_10"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_album_share_close"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/album_share_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/album_share_container"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
