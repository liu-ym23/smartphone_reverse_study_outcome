<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recommend_window_product_container"
    android:background="@drawable/ttlive_bg_live_end_recommend_window"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recommend_window_top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:id="@+id/recommend_window_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/recommend_window_jump_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.9"
            android:layout_marginEnd="2dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/recommend_window_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/recommend_window_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="0.5dp"
            android:src="@drawable/ttlive_ic_live_end_recommend_window_arrow"
            android:alpha="0.9"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/recommend_window_product_wrapper_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_window_top_area">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/recommend_window_product_1"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:roundedCornerRadius="8dp"/>
        <ImageView
            android:layout_width="19dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_img_recommend_window_product_top_1"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/recommend_window_product_wrapper_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/recommend_window_product_wrapper_1"
        app:layout_constraintRight_toLeftOf="@+id/recommend_window_product_wrapper_3"
        app:layout_constraintTop_toBottomOf="@+id/recommend_window_top_area">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/recommend_window_product_2"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:roundedCornerRadius="8dp"/>
        <ImageView
            android:layout_width="19dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_img_recommend_window_product_top_2"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/recommend_window_product_wrapper_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/recommend_window_product_wrapper_2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_window_top_area">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/recommend_window_product_3"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:roundedCornerRadius="8dp"/>
        <ImageView
            android:layout_width="19dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_img_recommend_window_product_top_3"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
