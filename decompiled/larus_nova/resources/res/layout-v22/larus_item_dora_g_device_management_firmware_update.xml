<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_dora_card_white_rounded"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_76"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_16"
    android:layout_marginHorizontal="?attr/larus_dp_16"
    android:paddingHorizontal="?attr/larus_dp_16">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:src="@null"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_text"
        app:tint="@color/larus_neutral_100"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/title_text"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_g_firmware_new_version_tip_cn"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/sub_title_text"
        app:layout_constraintEnd_toStartOf="@+id/update_button"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/sub_title_text"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:maxLines="1"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/update_button"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/update_button"
        android:background="@drawable/larus_dora_g_device_management_firmware_update_btn"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_32"
        android:text="@string/larus_dora_g_update_btn_cn"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
