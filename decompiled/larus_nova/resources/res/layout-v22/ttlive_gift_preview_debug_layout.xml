<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/debug_effect_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="bottom"
        android:id="@+id/guideline_mask"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:id="@+id/debug_setting_panel"
        android:background="#b3000000"
        android:layout_width="260dp"
        android:layout_height="320dp">
        <RadioGroup
            android:gravity="left"
            android:orientation="horizontal"
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textColor="#e6ffffff"
                android:id="@+id/h264_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/ttlive_gift_debug_H264"
                android:buttonTint="#e6ffffff"/>
            <RadioButton
                android:textColor="#e6ffffff"
                android:id="@+id/h265_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/ttlive_gift_debug_H265"
                android:buttonTint="#e6ffffff"/>
            <RadioButton
                android:textColor="#e6ffffff"
                android:id="@+id/h265_super_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/ttlive_gift_debug_H265super"
                android:buttonTint="#e6ffffff"/>
        </RadioGroup>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/filter_asset_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="#e6ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_gift_debug_assertid"/>
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="40dp">
                <EditText
                    android:theme="@style/debug_gift_preview_edittext"
                    android:textColor="#e6ffffff"
                    android:textColorHint="#4dffffff"
                    android:layout_gravity="bottom"
                    android:id="@+id/asset_edit"
                    android:focusable="true"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:focusedByDefault="true"/>
                <TextView
                    android:textColor="#e6ffffff"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/debug_clear_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="@string/ttlive_gift_debug_clear"/>
            </FrameLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/gift_preview_btn"
                android:background="@drawable/ttlive_debug_gift_preview_btn_bg"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="@string/ttlive_gift_debug_preview"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assets_list"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="20dp"/>
        <TextView
            android:textColor="#e6ffffff"
            android:layout_gravity="center"
            android:id="@+id/close_gift_preview"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="5dp"
            android:text="@string/ttlive_gift_debug_close"/>
    </LinearLayout>
</FrameLayout>
