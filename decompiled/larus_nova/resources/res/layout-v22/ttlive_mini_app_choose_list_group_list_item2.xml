<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_area"
    android:background="@drawable/ttlive_mini_app_choose_list_group_list_item2_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="12dp">
    <RelativeLayout
        android:id="@+id/icon_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="8dp"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/doing_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_mount_panel_has_mounted"
            android:layout_alignTop="@+id/icon"
            android:layout_alignRight="@+id/icon"
            android:textAlignment="center"
            android:layout_alignEnd="@+id/icon"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/bind_self_mount_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_bind_self_mount"
            android:layout_alignTop="@+id/icon"
            android:layout_alignRight="@+id/icon"
            android:textAlignment="center"
            android:layout_alignEnd="@+id/icon"/>
        <ImageView
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_ic_red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-6dp"
            android:layout_alignTop="@+id/icon"
            android:layout_alignRight="@+id/icon"
            android:layout_marginEnd="-6dp"
            android:layout_alignEnd="@+id/icon"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:alpha="0.5"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/icon_container"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <ImageButton
        android:background="@drawable/ttlive_mini_app_choose_list_group_list_item2_arrow"
        android:layout_width="7dp"
        android:layout_height="13dp"
        android:layout_marginEnd="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
