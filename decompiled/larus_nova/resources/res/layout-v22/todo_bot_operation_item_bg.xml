<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/todo_card_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:tint="@color/colorful_indigo"
                android:baseline="12sp"
                android:layout_marginEnd="@dimen/dp_8"
                app:srcCompat="@drawable/ud_icon_tab_todo_filled"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/todo_operation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_12"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_11"
            android:layout_marginTop="@dimen/dp_10d5"
            android:layout_marginRight="@dimen/dp_12">
            <ImageView
                android:id="@+id/complete_checkbox"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:layout_marginTop="2dp"/>
            <com.ss.android.lark.widget.richtext.RichTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/todo_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_6"
                android:maxLines="5"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/todo_assignee_owner_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="14sp"
                android:layout_height="14sp"
                android:src="@drawable/ud_icon_member_outlined"
                android:tint="@color/icon_n2"
                android:layout_marginEnd="@dimen/dp_8"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/todo_layout_owner"
                android:background="@drawable/todo_card_owner_item_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                    android:id="@+id/avatar_list_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/todo_owner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="170dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dp_8"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/todo_time_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_time"
                android:layout_width="14sp"
                android:layout_height="14sp"
                android:tint="@color/icon_n2"
                android:layout_alignBaseline="@+id/tv_time"
                android:baseline="12sp"
                app:srcCompat="@drawable/ud_icon_calendar_date_outlined"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_title"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_8"
                android:maxLines="2"
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/dp_4"
                android:layout_toEndOf="@+id/image_time"/>
        </RelativeLayout>
    </LinearLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/todo_icon_follow"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/Todo_Task_FollowButton"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:paddingVertical="10dp"
        app:ud_backgroundColor="@color/ud_button_white_grey_bg"
        app:ud_radius="s"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/todo_icon_detail"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_2"
        android:text="@string/Todo_Task_ViewDetails"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:paddingVertical="10dp"
        app:ud_backgroundColor="@color/ud_button_white_grey_bg"
        app:ud_radius="s"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/operate_more_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_12"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/operate_more"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/text_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Todo_TaskCard_OpenTasks_Button"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:padding="@dimen/dp_2"
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_viewinchat_outlined"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/lkui_N00"
        android:id="@+id/todo_expand_width"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_01"
        android:text="@string/Todo_Android_ExpandCardWidth"/>
</LinearLayout>
