<?xml version="1.0" encoding="utf-8"?>
<com.larus.dora.o.impl.memory.OViewPager2FixLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/memory_personal_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/memory_personal_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/dora_o_text_secondary"
                    android:id="@+id/memory_personal_limit_desc"
                    android:paddingLeft="?attr/larus_dp_20"
                    android:paddingRight="?attr/larus_dp_20"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    android:paddingHorizontal="?attr/larus_dp_20"/>
            </LinearLayout>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/memory_personal_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_secondary"
                android:layout_gravity="center"
                android:id="@+id/memory_personal_retry"
                android:padding="?attr/larus_dp_12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_o_memory_load_failed_retry"/>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</com.larus.dora.o.impl.memory.OViewPager2FixLayout>
