<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.community.impl.detail.toptools.CreationDetailTopToolsView
            android:id="@+id/top_tools_view"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ScrollView
            android:id="@+id/scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_tools_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_tools_view">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll">
                <com.larus.community.impl.detail.image.CreationDetailImageView
                    android:id="@+id/ll_creation_detail_image_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.larus.community.impl.detail.video.CreationDetailVideoView
                    android:id="@+id/ll_creation_detail_video_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.larus.community.impl.detail.prompt.CreationDetailPromptView
                    android:id="@+id/ll_creation_detail_prompt_view"
                    android:padding="?attr/larus_dp_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/creation_detail_comment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:nestedScrollingEnabled="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_tools_view"/>
        <FrameLayout
            android:id="@+id/creation_detail_more_inspiration_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:nestedScrollingEnabled="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_tools_view"/>
        <View
            android:id="@+id/v2_divider"
            android:background="@color/larus_neutral_transparent_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            app:layout_constraintBottom_toTopOf="@+id/bottom_tools_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/bottom_tools_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.larus.community.impl.detail.bottomtools.CreationDetailBottomToolsView
                android:id="@+id/bottom_tools_view"
                android:background="@color/larus_base_1"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="?attr/larus_dp_16"
                android:paddingVertical="?attr/larus_dp_16"/>
            <com.larus.community.impl.detail.bottomtools.CreationDetailBottomToolsViewV2
                android:id="@+id/bottom_tools_view_v2"
                android:background="@color/larus_base_1"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="?attr/larus_dp_16"
                android:paddingVertical="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </FrameLayout>
        <com.larus.community.impl.detail.loading.CreationDetailLoadingView
            android:id="@+id/loading_view"
            android:background="@color/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_tools_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.community.impl.detail.image.CreationFullscreenImageViewer
        android:id="@+id/fullscreen_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
