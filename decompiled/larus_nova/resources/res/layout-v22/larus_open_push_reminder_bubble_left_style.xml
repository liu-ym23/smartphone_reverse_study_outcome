<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="?attr/larus_dp_14"
    android:paddingTop="?attr/larus_dp_14"
    android:paddingRight="?attr/larus_dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/larus_dp_14">
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/iv_push_reminder_bubble_left_style_avatar"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginBottom="?attr/larus_dp_14"
        app:failureImage="@color/larus_base_2_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_base_2_overlay"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_push_reminder_bubble_left_style_sub_avatar"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_23"
        android:src="@drawable/larus_icon_push_reminder_bubble_doubao_avatar"
        android:layout_marginStart="?attr/larus_dp_23"
        app:layout_constraintStart_toStartOf="@+id/iv_push_reminder_bubble_left_style_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_push_reminder_bubble_left_style_avatar"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_left_style_title"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_20"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_5"
        app:layout_constraintEnd_toStartOf="@+id/tv_push_reminder_bubble_left_style_time"
        app:layout_constraintStart_toEndOf="@+id/iv_push_reminder_bubble_left_style_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_left_style_time"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_left_style_brief"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_14"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_push_reminder_bubble_left_style_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
