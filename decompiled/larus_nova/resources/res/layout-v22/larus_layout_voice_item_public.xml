<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_white_bg_item_middle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voice_selector_more"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_0"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voice_add_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_more_gray"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voice_add_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_0"
        android:paddingEnd="?attr/larus_dp_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_voice_mix_add"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/voice_selector_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voice_selector_more"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/voice_selector_selected_icon"
            android:padding="?attr/larus_dp_6"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            app:srcCompat="?attr/larus_ic_selector"/>
        <ProgressBar
            android:id="@+id/voice_selector_selecting_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginEnd="?attr/larus_dp_4"
            style="@style/larus_LoadingProgressBar"/>
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/play_lottie"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:lottie_loop="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/voice_creator_avatar"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/bg_voice_item_avatar_placeholder"
        app:placeholderImageScaleType="centerCrop"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_11"
        android:layout_marginBottom="?attr/larus_dp_11"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voice_selector_state"
        app:layout_constraintStart_toEndOf="@+id/voice_creator_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_17"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/voice_selector_voice_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_11"
                android:textStyle="bold"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/best_match_label"
                android:background="?attr/larus_bg_recommend_match_label"
                android:paddingLeft="?attr/larus_dp_6"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingRight="?attr/larus_dp_6"
                android:paddingBottom="?attr/larus_dp_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_create_botvoice_tag"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_8"
                android:paddingHorizontal="?attr/larus_dp_6"
                android:paddingVertical="?attr/larus_dp_4"/>
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/new_play_lottie"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginStart="?attr/larus_dp_8"
                app:lottie_loop="true"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/reviewing_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/voice_selector_uploading_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:layout_marginEnd="?attr/larus_dp_4"
                style="@style/larus_LoadingProgressBar"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/voice_selector_error_icon"
                android:padding="?attr/larus_dp_2"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                app:srcCompat="@drawable/larus_ic_message_failed_retry"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_danger_50"
                android:id="@+id/voice_selector_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/voice_selector_more"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/label_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/create_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/permission_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_24"
                android:src="?attr/larus_icon_tag_hot"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/permission_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/divider_dot"
                android:layout_width="?attr/larus_dp_8"
                android:layout_height="?attr/larus_dp_17"
                android:layout_marginStart="?attr/larus_dp_4"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_icon_divider_dot"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/create_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voice_creator_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
