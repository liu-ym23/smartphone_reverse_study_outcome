<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/ttlive_bg_ksong_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="481dp">
        <FrameLayout
            android:id="@+id/top_area"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/back_view"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ttlive_ic_ksong_dialog_common_back"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ttlive_ktv_ksong_setting_title_tips"
                android:includeFontPadding="false"
                android:contentDescription="@string/ttlive_ktv_ksong_setting_title_tips"
                android:lineHeight="23.8dp"
                android:textFontWeight="500"/>
        </FrameLayout>
        <View
            android:id="@+id/divider_line"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_area"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
