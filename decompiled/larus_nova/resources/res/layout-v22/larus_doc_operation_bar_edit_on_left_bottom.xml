<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:id="@+id/bottom_operation_container"
    android:background="@color/larus_base_1"
    android:paddingLeft="?attr/larus_dp_12"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/larus_dp_12">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/doc_copy_all_btn"
        android:background="@drawable/larus_bg_operation_bar_item"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_action_bar_item_height"
        android:paddingHorizontal="?attr/larus_dp_12">
        <ImageView
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_docbiz_ic_doc_copy_all"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_aiDoc_selectText_copy"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"
            android:textFontWeight="500"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/doc_edit_all"
        android:background="@drawable/larus_bg_operation_bar_item"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_action_bar_item_height"
        android:layout_marginStart="?attr/larus_dp_6"
        android:paddingHorizontal="?attr/larus_dp_12">
        <ImageView
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_doc_ic_edit"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_imageDetail_btn_edit"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"
            android:textFontWeight="500"/>
    </LinearLayout>
</LinearLayout>
