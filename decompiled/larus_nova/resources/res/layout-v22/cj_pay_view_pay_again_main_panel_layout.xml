<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/rl_main_panel_root_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <FrameLayout
        android:id="@+id/main_panel_titlebar_root_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_106">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/cj_pay_main_panel_back_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_font_size_16"
            android:layout_marginTop="@dimen/cj_pay_font_size_16"
            android:src="@drawable/cj_pay_icon_titlebar_left_arrow_noise_reduction"
            android:scaleType="centerCrop"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/cj_pay_main_panel_middle_top_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
                android:textSize="20sp"
                android:textColor="#ff161823"
                android:ellipsize="middle"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_main_panel_middle_title"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:singleLine="true"
                android:textFontWeight="500"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28px"
            android:layout_marginTop="64dp"
            android:layout_marginRight="28px">
            <TextView
                android:textSize="13sp"
                android:textColor="#99161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_mian_panel_error_pay_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text=""
                android:textFontWeight="400"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99161823"
                android:gravity="center_vertical"
                android:id="@+id/cj_pay_mian_panel_error_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textFontWeight="400"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_main_panel_error_detail"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/cj_pay_icon_pay_again_detail"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_main_panel_right_text_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxWidth="300dp"
            android:singleLine="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_method_list_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/fl_bottom_area"
        android:layout_below="@+id/main_panel_titlebar_root_view">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_method_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cj_pay_bg_card_container"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="16dp">
                <FrameLayout
                    android:id="@+id/cj_pay_method_root_view_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="12dp"/>
                <FrameLayout
                    android:id="@+id/cj_pay_method_root_view_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_expand_area"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                        android:id="@+id/tv_expand_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_expand_arrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/cj_pay_icon_pay_again_expend_arrow_down"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <include
            android:id="@+id/layout_pay_again_combine_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            layout="@layout/cj_pay_view_pay_again_main_combine_area_layout"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_bottom_area"
        android:background="@color/cj_pay_color_gray_248"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include
            android:id="@+id/layout_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
    </FrameLayout>
    <View
        android:id="@+id/cj_pay_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_panel_titlebar_root_view"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_panel_titlebar_root_view"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/main_panel_titlebar_only_title_contianer"
        android:background="@drawable/cj_pay_bg_only_title_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_50">
        <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/main_panel_titlebar_only_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:singleLine="true"/>
    </FrameLayout>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:layout_marginTop="@dimen/cj_pay_height_50"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
