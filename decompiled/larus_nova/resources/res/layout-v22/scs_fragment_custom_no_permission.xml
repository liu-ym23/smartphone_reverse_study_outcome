<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/noPermissionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/innerScrollView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/topIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"/>
        <TextView
            android:textAppearance="@style/UDText.Title3"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/custom_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:lineHeight="24dp"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/custom_rich_text"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/custom_sub_text"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/innerScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_8"
        android:minHeight="120dp"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/custom_button_container"
        app:layout_constraintTop_toBottomOf="@+id/noPermissionContent"
        app:layout_constraintVertical_chainStyle="packed">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/custom_content_container"
            android:background="@drawable/ud_security_notice_bg_dialog"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/custom_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/innerScrollView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <include
        android:id="@+id/loading_view"
        layout="@layout/scs_widget_loading_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
