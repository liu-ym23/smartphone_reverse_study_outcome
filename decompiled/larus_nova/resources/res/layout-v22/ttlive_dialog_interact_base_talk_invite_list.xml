<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/invite_guide_container"
        android:background="#1fffbc1f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <ImageView
            android:id="@+id/invite_guide_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_invite_panel_guide_icon"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ad6507"
            android:gravity="center_vertical"
            android:id="@+id/invite_guide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/invite_guide_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_bar_container"
        android:background="@drawable/ttlive_bg_text_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="10dp">
        <ImageView
            android:id="@+id/iv_search_bar_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/ttlive_search_icon"
            android:alpha="0.45"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#57161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_live_invite_panel_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_search_bar_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_banner_lynx_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.FastScrollRecyclerView
            android:id="@+id/rlv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="84dp"
                android:src="@drawable/ttlive_bg_live_loading_error"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_user_rank_no_network_below_tip"/>
            <TextView
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/refresh"
                android:background="@drawable/ttlive_bg_interact_text"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_network_refresh"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_iv"
                android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="84dp"/>
            <com.bytedance.android.live.liveinteract.common.ui.OnlineFriendsCircleContainer
                android:layout_gravity="center"
                android:id="@+id/friends_avatars"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="108dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#8a000000"
                android:layout_gravity="center"
                android:id="@+id/tv_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_interact_talk_invite_friend_empty"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/invite_tv"
                android:paddingLeft="12dp"
                android:paddingTop="9dp"
                android:paddingRight="12dp"
                android:paddingBottom="9dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/ttlive_interact_video_talk_apply_empty"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
