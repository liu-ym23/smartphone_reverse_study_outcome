<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/head_control_content_container"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingRight="?attr/larus_dp_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/head_control_action_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <FrameLayout
            android:id="@+id/head_control_gesture_container"
            android:layout_width="?attr/larus_dp_240"
            android:layout_height="?attr/larus_dp_240">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/head_control_gesture_lottie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:lottie_loop="true"/>
            <com.larus.common_ui.widget.roundlayout.RoundImageView
                android:id="@+id/head_control_gesture_finish_icon"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/larus_dora_g_head_control_finish"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_23"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/head_control_gesture_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_28"
            android:text="@string/larus_dora_g_nod_twice_tip_cn"
            android:textFontWeight="600"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/head_control_gesture_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_dora_g_wear_glasses_check_cn"/>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:enabled="false"
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/head_control_action_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_34"
        android:text="@string/larus_dora_g_continue_cn"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_24"
        android:stateListAnimator="@null"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
