<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_slides_downloadAs_header"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/cancel"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="@drawable/larus_ic_export_choose_dialog_close"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.FileExportTypeItemView
        android:id="@+id/pptxType"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_106"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_15"
        app:layout_constraintEnd_toStartOf="@+id/pdfType"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.larus.common_ui.view.FileExportTypeItemView
        android:id="@+id/pdfType"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_106"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_15"
        app:layout_constraintBottom_toBottomOf="@+id/pptxType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pptxType"
        app:layout_constraintTop_toTopOf="@+id/pptxType"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/previewFile"
        android:background="@drawable/larus_slides_slides_export_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_10"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pptxType">
        <ProgressBar
            android:id="@+id/download_progress"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminateDrawable="@drawable/larus_bg_progress_loading_white"
            android:layout_marginEnd="?attr/larus_dp_6"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:id="@+id/download_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_slides_download_btn"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
