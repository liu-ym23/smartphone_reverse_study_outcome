<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_open_platform_shelf_card_background"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/card_cover_img"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="#33000000"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_uikit_const_tPrimary"
        android:ellipsize="end"
        android:id="@+id/card_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_cover_img"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:ellipsize="end"
        android:id="@+id/selling_point_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_title_tv"/>
    <TextView
        android:textSize="10sp"
        android:id="@+id/review_status_tv"
        android:paddingLeft="3dp"
        android:paddingTop="2dp"
        android:paddingRight="3dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:includeFontPadding="false"
        android:drawableRight="@drawable/ttlive_open_platform_review_rejected_icon"
        android:drawablePadding="2dp"
        android:drawableEnd="@drawable/ttlive_open_platform_review_rejected_icon"
        android:paddingHorizontal="3dp"
        android:paddingVertical="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/card_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/selling_point_tv"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductIntroductionLayout
        android:id="@+id/product_introduction"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/card_title_tv"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/review_status_tv"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductLabelLayout
        android:id="@+id/product_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/card_title_tv"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_introduction"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductPriceView
        android:id="@+id/product_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
