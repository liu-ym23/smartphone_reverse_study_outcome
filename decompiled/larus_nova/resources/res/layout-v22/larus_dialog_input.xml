<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="600"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20">
        <EditText
            android:textSize="?attr/larus_dp_17"
            android:id="@+id/dialog_input"
            android:background="?attr/larus_bg_input_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:textFontWeight="400"
            style="@style/larus_EditTextStyle"/>
    </LinearLayout>
    <View
        android:background="?attr/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="?attr/larus_bg_leftdown_selector"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_bot_profile_pic_crop_cancel"
            android:layout_weight="1"
            android:textFontWeight="400"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="?attr/larus_item_divider"
            android:layout_width="?attr/larus_dp_0_5"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_primary_50"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="?attr/larus_bg_rightdown_selector"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_edit_chat_name_done"
            android:layout_weight="1"
            android:textFontWeight="400"/>
    </LinearLayout>
</LinearLayout>
