<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_rank_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_rank_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="10dp"
        android:textFontWeight="600"/>
    <TextView
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_rank_title_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Anchor_V3_middle_dot"
        android:includeFontPadding="false"
        android:layout_marginStart="5dp"
        android:textFontWeight="700"
        style="@style/font_size_26"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_v3_tv_rank_text_layout"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/anchor_v3_tv_rank_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textFontWeight="700"/>
    </LinearLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_rank_num_icon"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:actualImageScaleType="centerCrop"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_bg_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="22dp"/>
    <View
        android:id="@+id/anchor_v3_sv_rank_right_arrow"
        android:background="@drawable/commerce_arrow_right_gray"
        android:layout_width="8dp"
        android:layout_height="12dp"
        android:layout_marginStart="2dp"/>
</LinearLayout>
