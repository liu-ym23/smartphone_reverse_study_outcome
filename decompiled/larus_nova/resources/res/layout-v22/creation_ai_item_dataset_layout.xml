<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/inline_ai_creation_panel_model_bg"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintEnd_toStartOf="@+id/selected_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.ss.android.lark.myai.view.LineHeightTextView
                android:textSize="16sp"
                android:textColor="@color/inline_ai_creation_model_item_title_color"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:ux_line_height="@dimen/inline_ai_creation_panel_model_title_line_height"/>
            <com.ss.android.lark.myai.view.LineHeightTextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:ux_line_height="@dimen/inline_ai_creation_panel_model_title_line_height"/>
        </LinearLayout>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/badge_point"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ll_content"
            app:layout_constraintEnd_toEndOf="@+id/ll_content"
            app:layout_constraintTop_toTopOf="@+id/ll_content"
            app:layout_constraintVertical_bias="0.25"
            style="@style/UDBadge.Dot.StrongReminder.Small"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/selected_icon"
            android:padding="2dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_right_outlined"
            app:tint="#8f959e"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
