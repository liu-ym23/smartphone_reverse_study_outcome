<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="@color/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_left_back"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginVertical="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="?attr/larus_dp_55"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_share"
            app:layout_constraintStart_toEndOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="?attr/larus_dp_45"
            android:layout_height="?attr/larus_dp_45"
            android:src="@drawable/larus_ic_web_title_share"
            android:scaleType="centerInside"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_more"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="?attr/larus_dp_10"/>
        <ImageView
            android:id="@+id/btn_more"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_45"
            android:layout_height="?attr/larus_dp_45"
            android:src="@drawable/larus_ic_web_title_more"
            android:scaleType="centerInside"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider"
        android:background="@drawable/larus_bg_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_2"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/larus_progress_horiztal"
        app:layout_constraintBottom_toTopOf="@+id/web_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/web_view_parent"
            android:background="@color/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.ai.view.input.FloatingSpeakerView
            android:layout_gravity="bottom"
            android:id="@+id/floating_speaker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:enable="false"/>
    </FrameLayout>
</LinearLayout>
