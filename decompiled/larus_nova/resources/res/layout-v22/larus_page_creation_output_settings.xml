<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_12"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12">
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/material_compliance_group"
            android:background="?attr/larus_bg_setting_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/material_compliance_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                app:larus_image_height="?attr/larus_dp_32"
                app:larus_image_src="@drawable/larus_ic_creation_material_compliance"
                app:larus_image_width="?attr/larus_dp_32"/>
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/remove_ai_watermark_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                app:larus_image_height="?attr/larus_dp_32"
                app:larus_image_src="@drawable/larus_ic_creation_output_settings"
                app:larus_image_width="?attr/larus_dp_32"/>
        </com.larus.bmhome.view.item.ItemGroup>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
