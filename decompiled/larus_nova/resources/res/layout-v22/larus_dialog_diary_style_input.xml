<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_top_half_round"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_310"
    android:paddingHorizontal="?attr/larus_dp_16">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/diary_style_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_dora_personal_diary_edit_title_cn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/diary_style_dialog_cancel"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_dora_personal_diary_cancel_cn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/diary_style_dialog_save"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_dora_personal_diary_save_and_use_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/diary_style_prompt_count"
        app:layout_constraintTop_toBottomOf="@+id/diary_style_dialog_title"
        app:layout_constraintVertical_bias="0">
        <EditText
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:textColorHint="@color/neutral_50"
            android:gravity="center_vertical"
            android:id="@+id/diary_style_dialog_name"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/larus_dora_personal_diary_personalized_title_cn"
            android:maxLines="1"
            android:maxEms="20"
            android:maxLength="20"
            android:inputType="text"/>
        <EditText
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:textColorHint="@color/neutral_50"
            android:gravity="start|top"
            android:id="@+id/diary_style_dialog_prompt"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/larus_dora_personal_diary_personalized_guide_cn"
            android:cursorVisible="true"
            android:singleLine="false"
            android:inputType="textMultiLine"
            android:focusedByDefault="true"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/diary_style_prompt_count"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
