<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_sticker_panel_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/beyond_panel_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="@string/ttlive_effect_sticker_close_panel_description"
        app:layout_constraintBottom_toTopOf="@+id/panel_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="#ffffff"
            android:id="@+id/aigc_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:shadowColor="#26000000"
            android:shadowDx="0"
            android:shadowDy="2"
            app:layout_constraintBottom_toTopOf="@+id/aigc_task_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.live.effect.sticker.ui.aigc.AigcTaskPanel
            android:id="@+id/aigc_task_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="42dp"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="42dp"
            app:layout_constraintBottom_toTopOf="@+id/favorite_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.live.effect.sticker.ui.StickerFavoriteView
            android:id="@+id/favorite_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/image_selector"
            app:layout_constraintStart_toStartOf="parent"/>
        <include
            android:id="@+id/image_selector"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="0dp"
            layout="@layout/ttlive_effect_broadcast_sticker_image_selector_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/panel_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/beyond_panel_layout"
        app:layout_constraintVertical_bias="1"
        layout="@layout/ttlive_effect_sticker_panel"/>
    <com.bytedance.android.live.effect.sticker.ui.StickerPanelIntroductionPage
        android:id="@+id/introduction_page"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/panel_view"
        app:layout_constraintEnd_toEndOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="@+id/panel_view"
        app:layout_constraintTop_toTopOf="@+id/panel_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
