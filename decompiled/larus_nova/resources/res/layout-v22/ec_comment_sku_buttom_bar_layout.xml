<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:gravity="center"
        android:id="@+id/sku_reset"
        android:background="@color/BGInputReverse"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        app:rounded_radius="8dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/TextReverse"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/commerce_comment_sku_panel_reset_text"
            android:textFontWeight="500"/>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:gravity="center"
        android:id="@+id/sku_confirm"
        android:background="@color/primary"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        app:rounded_radius="8dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ec_comment_sku_confirm"
            android:textFontWeight="500"/>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
</LinearLayout>
