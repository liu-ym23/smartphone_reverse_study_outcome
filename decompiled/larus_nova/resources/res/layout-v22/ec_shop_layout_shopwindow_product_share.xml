<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shopwindow_video_card"
    android:background="@color/shopping_std_text_white_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="8dp">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="228dp"
        app:rounded_radius="8dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shopping_window_video_image"
            android:layout_width="match_parent"
            android:layout_height="228dp"
            app:placeholderImage="@drawable/shopping_shop_video_card_background"/>
        <com.bytedance.commerce.uikit.roundedlayout.RoundedLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/shopping_window_video_card_play_info"
            android:background="@drawable/shop_shopping_shop_video_duration_background_9"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp">
            <com.bytedance.android.ec.core.widget.CircleImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/shopping_window_video_card_play_icon"
                android:visibility="visible"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:foreground="@drawable/shop_shopping_shop_video_play_icon"/>
            <TextView
                android:textColor="@color/shopping_std_text_white_1"
                android:ellipsize="end"
                android:id="@+id/shopping_window_video_card_text"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:singleLine="true"
                android:layout_marginStart="4dp"
                style="@style/font_size_22"/>
        </com.bytedance.commerce.uikit.roundedlayout.RoundedLinearLayout>
        <com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout
            android:orientation="vertical"
            android:id="@+id/shopping_window_product_share_small_card"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            app:rounded_radius="6dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/shopping_window_product_share_small_card_img"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="2dp"
                app:placeholderImage="@drawable/shopping_shop_video_card_background"
                app:roundedCornerRadius="6px"/>
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="12dp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/shopping_window_product_share_small_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
        </com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_std_text_black_1"
        android:ellipsize="end"
        android:id="@+id/shopping_window_product_share_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="10dp"
        android:maxLines="2"
        android:lineSpacingExtra="4dp"
        android:breakStrategy="simple"/>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
