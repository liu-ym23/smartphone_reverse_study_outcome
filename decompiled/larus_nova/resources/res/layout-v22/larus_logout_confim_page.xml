<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/title_container"
            android:background="@drawable/bg_logout_title"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_neutral_70"
                android:layout_gravity="center"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_logOut_bottomsheet_title_allDevices"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </FrameLayout>
        <View
            android:id="@+id/divider_1"
            android:background="@color/larus_base_4_overlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintTop_toBottomOf="@+id/title_container"/>
        <FrameLayout
            android:id="@+id/confirm"
            android:background="@drawable/bg_logout_all_selector"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            app:layout_constraintBottom_toTopOf="@+id/divider_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_danger_50"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_logOut_bottomsheet_btn_confirm"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </FrameLayout>
        <View
            android:id="@+id/divider_2"
            android:background="@color/larus_base_4_overlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_8"
            app:layout_constraintBottom_toTopOf="@+id/cancel"
            app:layout_constraintTop_toBottomOf="@+id/confirm"/>
        <FrameLayout
            android:id="@+id/cancel"
            android:background="@drawable/bg_logout_all_selector"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_2">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_neutral_100"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_logOut_bottomsheet_btn_cancel"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
