<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/close_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/title_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ttlive_bg_custom_recharge_dialog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_view"/>
    <View
        android:background="@color/ttlive_custom_recahrge_bg_grey"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/suggestion_deals_container"/>
    <View
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/custom_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <EditText
        android:textSize="14dp"
        android:textColor="@color/ttlive_recharge_diamond_color"
        android:textColorHint="@color/ttlive_custom_recahrge_text_hint"
        android:gravity="end|center_vertical"
        android:id="@+id/custom_input"
        android:background="@drawable/ttlive_bg_custom_recharge_input_container"
        android:paddingRight="31dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:inputType="number"
        android:textCursorDrawable="@drawable/ttlive_cursor_custom_recharge_drawable"
        android:paddingEnd="31dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tip_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_custom_recahrge_text_input_title"
        android:gravity="center_vertical"
        android:id="@+id/money_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_input"
        app:layout_constraintStart_toStartOf="@+id/custom_input"
        app:layout_constraintTop_toTopOf="@+id/custom_input"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recharge_diamond_unit_color"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:text="@string/ttlive_recharge_diamond_price_unit"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_input"
        app:layout_constraintRight_toRightOf="@+id/custom_input"
        app:layout_constraintTop_toTopOf="@+id/custom_input"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_custom_recahrge_text_input_title"
        android:id="@+id/diamond_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/custom_exchange_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_custom_recahrge_text"
        android:gravity="end|center_vertical"
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/custom_exchange_view"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_custom_recahrge_text"
        android:id="@+id/other_pay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_other_way_to_pay"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/fastpay_other_pay_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fastpay_other_pay_arrow"
        app:layout_constraintTop_toTopOf="@+id/fastpay_other_pay_arrow"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/fastpay_other_pay_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ttlive_recharge_dialog_fastpay_arrow"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_divider"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.bytedance.android.live.recharge.view.BalanceExchangeView
        android:id="@+id/custom_exchange_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/suggestion_deals_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestion_deals_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_divider"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/keyboard_divider"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/custom_keyboard"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/ttlive_recharge_keyboard_view"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#4d000000"
        android:gravity="center_vertical"
        android:id="@+id/protocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/recharge_security_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ToggleButton
            android:id="@+id/recharge_security_toggle_btn"
            android:background="@drawable/ttlive_cash_exchange_attention"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="4dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""/>
        <TextView
            android:textSize="11dp"
            android:textColorLink="@color/ttlive_live_recharge_protocol_blue"
            android:id="@+id/recharge_security_protocol"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:maxLines="1"
            android:lineHeight="22dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
