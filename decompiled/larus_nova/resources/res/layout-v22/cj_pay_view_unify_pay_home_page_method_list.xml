<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_payment_method_root"
    android:background="@drawable/cj_pay_bg_r8_white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/cj_pay_padding_12"
    android:layout_marginRight="@dimen/cj_pay_padding_12"
    android:layout_marginHorizontal="@dimen/cj_pay_padding_12">
    <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
        android:id="@+id/rv_payment_method_layout"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rv_payment_method_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rv_payment_method_title"
        android:background="@drawable/cj_pay_bg_r8_white"
        android:paddingLeft="@dimen/cj_pay_padding_16"
        android:paddingTop="@dimen/cj_pay_padding_12"
        android:paddingRight="@dimen/cj_pay_padding_16"
        android:paddingBottom="@dimen/cj_pay_padding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/cj_pay_padding_16">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/tv_first_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:lineSpacingMultiplier="1.38"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_title_bar_chosen_method_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="70dp">
            <ImageView
                android:id="@+id/iv_chosen_method_icon"
                android:layout_width="@dimen/cj_pay_padding_14"
                android:layout_height="@dimen/cj_pay_padding_14"
                android:layout_marginEnd="@dimen/cj_pay_padding_4"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_chosen_method_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
