<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/featured_comment_root_view"
    android:paddingLeft="16dp"
    android:paddingTop="17dp"
    android:paddingRight="20dp"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="75dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="40dp"
    android:layout_marginHorizontal="12dp"
    app:rounded_radius="10dp">
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
        android:id="@+id/featured_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.HeadCommentInfoView
        android:id="@+id/featured_comment_info_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.HeadCommentInfoView
        android:id="@+id/featured_comment_info_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
        android:layout_gravity="center_horizontal"
        android:id="@+id/featured_more_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"/>
</com.bytedance.android.ec.core.widget.RoundedLinearLayout>
