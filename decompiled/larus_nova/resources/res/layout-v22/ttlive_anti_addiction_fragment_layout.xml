<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:layout_gravity="center"
        android:id="@+id/cover_blur_anti_addiction"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <View
        android:background="#bf000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.antiaddiction.view.VideoPinchViewContainer
        android:layout_gravity="center"
        android:id="@+id/player_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:layout_gravity="center"
            android:id="@+id/cover_anti_addiction"
            android:background="@color/ttlive_light_blue"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"/>
    </com.bytedance.android.livesdk.antiaddiction.view.VideoPinchViewContainer>
    <com.bytedance.lighten.loader.SmartImageView
        android:layout_gravity="center"
        android:id="@+id/cover_anti_addiction_no_network"
        android:background="@drawable/ttlive_ic_anti_addiction_video_loading_background_with_icon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/anti_addiction_player_placeholder"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="200dp"
            android:layout_height="270dp"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_remind_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_douyin_const_ConstTextInverse2"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_remind_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:lineHeight="33.6dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/guide_line_vertical_60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guide_line_vertical_60"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.6"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/extra_container_anti_addiction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
