<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/contact_item_layout"
    android:background="@drawable/contact_db_contact_item_bg_selector"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/contact_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:civ_border_width="0dp"
        app:civ_oval="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:ellipsize="end"
            android:id="@+id/contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_neutral_50"
            android:ellipsize="end"
            android:id="@+id/contact_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/confirm_btn"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textFontWeight="500"/>
</LinearLayout>
