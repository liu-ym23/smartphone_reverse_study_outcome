<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/larus_white_bg_item_middle"
    android:paddingTop="?attr/larus_dp_10"
    android:paddingBottom="?attr/larus_dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_68"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_search_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_10">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/text_search_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/text_search_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
