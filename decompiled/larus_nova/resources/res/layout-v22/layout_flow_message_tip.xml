<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/back_to_bottom_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:ud_shadow_color="@color/ud_N900_05"
        app:ud_shadow_radius="24dp"
        app:ud_shadow_size="s3">
        <ImageView
            android:id="@+id/back_to_bottom_drawable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/flow_ud_ic_fast_down"/>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/new_messages_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:ud_shadow_color="@color/ud_N900_08"
        app:ud_shadow_radius="24dp"
        app:ud_shadow_size="s3">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/new_messages_bg"
            android:background="@drawable/new_messages_tip_white_bg"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <FrameLayout
                android:id="@+id/fl_state_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/arrow_state"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/flow_ud_ic_arrow_up"/>
                <ProgressBar
                    android:id="@+id/loading"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateDrawable="@drawable/flow_chat_window_tip_loading"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_message_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/fl_state_icon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</LinearLayout>
