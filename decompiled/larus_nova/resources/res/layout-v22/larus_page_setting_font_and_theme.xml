<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_font"
                android:background="@drawable/larus_bg_base_2_radius_16"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/dp_17"
                    android:textColor="@color/neutral_100"
                    android:id="@+id/tv_font_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_adjust_text_size"
                    android:fontFamily="PingFang SC"
                    android:textFontWeight="500"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_font_reset"
                    android:layout_width="?attr/larus_dp_14"
                    android:layout_height="?attr/larus_dp_14"
                    android:src="@drawable/larus_ic_font_reset"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_3"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_font_reset"
                    app:layout_constraintEnd_toStartOf="@+id/tv_font_reset"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/tv_font_title"
                    app:layout_constraintTop_toTopOf="@+id/tv_font_reset"/>
                <TextView
                    android:textSize="@dimen/dp_14"
                    android:textColor="@color/neutral_50"
                    android:ellipsize="end"
                    android:id="@+id/tv_font_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_settings_textSize_btn_reset"
                    android:maxLines="1"
                    android:fontFamily="PingFang SC"
                    android:textFontWeight="500"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_font_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_font_reset"
                    app:layout_constraintTop_toTopOf="@+id/tv_font_title"
                    app:layout_constraintWidth_default="wrap"/>
                <android.widget.LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_font_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_font_title">
                    <com.larus.common_ui.widget.roundlayout.RoundTextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_static_white"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="end"
                        android:id="@+id/tv_font_desc_self"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingTop="?attr/larus_dp_12"
                        android:paddingRight="?attr/larus_dp_16"
                        android:paddingBottom="?attr/larus_dp_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_settings_account_text_size_preview"
                        android:lineSpacingMultiplier="1.2"
                        android:paddingHorizontal="?attr/larus_dp_16"
                        android:paddingVertical="?attr/larus_dp_12"
                        app:rv_backgroundColor="@color/larus_primary_50"
                        app:rv_cornerRadius="?attr/larus_dp_16"/>
                    <com.larus.common_ui.widget.roundlayout.RoundTextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_neutral_100"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_font_desc_bot"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingTop="?attr/larus_dp_12"
                        android:paddingRight="?attr/larus_dp_16"
                        android:paddingBottom="?attr/larus_dp_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_settings_account_text_size_adjust"
                        android:lineSpacingMultiplier="1.2"
                        android:paddingHorizontal="?attr/larus_dp_16"
                        android:paddingVertical="?attr/larus_dp_12"
                        app:rv_backgroundColor="@color/larus_base_3_overlay"
                        app:rv_cornerRadius="?attr/larus_dp_16"/>
                </android.widget.LinearLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_font_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/larus_ic_font_small_en"
                    android:contentDescription="@string/larus_accessibilityLabels_settingPage_textSize_small"
                    app:layout_constraintBottom_toBottomOf="@+id/font_setting_view"
                    app:layout_constraintStart_toStartOf="@+id/layout_font_desc"
                    app:layout_constraintTop_toTopOf="@+id/font_setting_view"/>
                <com.larus.setting.impl.view.FontSizeSettingView
                    android:layout_gravity="bottom"
                    android:id="@+id/font_setting_view"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_80"
                    android:layout_marginTop="?attr/larus_dp_48"
                    app:larus_axisColor="@color/larus_neutral_transparent_1"
                    app:larus_circleColor="@color/larus_static_white"
                    app:larus_circleShadowColor="#1f000000"
                    app:larus_circleStrokeColor="@color/larus_neutral_transparent_1"
                    app:larus_pointColor="@color/larus_neutral_transparent_3"
                    app:larus_pointCount="6"
                    app:layout_constraintEnd_toStartOf="@+id/iv_font_big"
                    app:layout_constraintStart_toEndOf="@+id/iv_font_small"
                    app:layout_constraintTop_toBottomOf="@+id/layout_font_desc"
                    app:layout_constraintWidth_default="spread"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_font_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/larus_accessibilityLabels_settingPage_textSize_large"
                    app:layout_constraintBottom_toBottomOf="@+id/font_setting_view"
                    app:layout_constraintEnd_toEndOf="@+id/layout_font_desc"
                    app:layout_constraintTop_toTopOf="@+id/font_setting_view"
                    app:srcCompat="@drawable/larus_ic_font_big_en"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_theme"
                android:background="@drawable/larus_bg_base_2_radius_16"
                android:padding="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_12"
                android:layout_marginHorizontal="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/dp_17"
                    android:textColor="@color/neutral_100"
                    android:id="@+id/tv_theme_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_background_settings"
                    android:fontFamily="PingFang SC"
                    android:textFontWeight="500"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/group_theme_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_theme_title">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_theme_follow"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_8"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintEnd_toStartOf="@+id/layout_theme_light"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_theme_follow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/larus_ic_theme_follow"/>
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_theme_follow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_8"
                            android:text="@string/larus_background_follow_system"
                            android:maxLines="1"
                            android:fontFamily="PingFang SC"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_theme_light"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="?attr/larus_dp_8"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_theme_follow"
                        app:layout_constraintEnd_toStartOf="@+id/layout_theme_dark"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/layout_theme_follow"
                        app:layout_constraintTop_toTopOf="@+id/layout_theme_follow">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_theme_light"
                            android:layout_width="?attr/larus_dp_24"
                            android:layout_height="?attr/larus_dp_24"
                            android:src="@drawable/larus_ic_theme_light"/>
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_theme_light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_8"
                            android:text="@string/larus_background_light_mode"
                            android:maxLines="1"
                            android:fontFamily="PingFang SC"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_theme_dark"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_theme_follow"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/layout_theme_light"
                        app:layout_constraintTop_toTopOf="@+id/layout_theme_follow">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_theme_dark"
                            android:layout_width="?attr/larus_dp_24"
                            android:layout_height="?attr/larus_dp_24"
                            android:src="@drawable/larus_ic_theme_dark"/>
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_theme_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_8"
                            android:text="@string/larus_background_dark_mode"
                            android:maxLines="1"
                            android:fontFamily="PingFang SC"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/group_theme_vertical"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_theme_title">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layout_theme_follow_v"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="?attr/larus_dp_12"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="?attr/larus_dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:paddingHorizontal="?attr/larus_dp_12"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_theme_follow_v"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/larus_ic_theme_follow"/>
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/larus_neutral_70"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_theme_follow_v"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_background_follow_system"
                            android:layout_weight="1"
                            android:fontFamily="PingFang SC"
                            android:layout_marginStart="?attr/larus_dp_8"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layout_theme_light_v"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="?attr/larus_dp_12"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="?attr/larus_dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:paddingHorizontal="?attr/larus_dp_12"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_theme_follow_v">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_theme_light_v"
                            android:layout_width="?attr/larus_dp_24"
                            android:layout_height="?attr/larus_dp_24"
                            android:src="@drawable/larus_ic_theme_light"/>
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/larus_neutral_70"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_theme_light_v"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_background_light_mode"
                            android:layout_weight="1"
                            android:fontFamily="PingFang SC"
                            android:layout_marginStart="?attr/larus_dp_8"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layout_theme_dark_v"
                        android:background="@drawable/larus_bg_item_theme"
                        android:paddingLeft="?attr/larus_dp_12"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingRight="?attr/larus_dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:paddingHorizontal="?attr/larus_dp_12"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_theme_light_v">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_theme_dark_v"
                            android:layout_width="?attr/larus_dp_24"
                            android:layout_height="?attr/larus_dp_24"
                            android:src="@drawable/larus_ic_theme_dark"/>
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="@color/larus_neutral_70"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_theme_dark_v"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_background_dark_mode"
                            android:layout_weight="1"
                            android:fontFamily="PingFang SC"
                            android:layout_marginStart="?attr/larus_dp_8"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
