<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rules_recycler_view"
        android:background="@drawable/larus_dora_bg_rule_list_card"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:overScrollMode="never"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:clipToOutline="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_desc"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_bias="0"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_dora_notification_broadcast_desc_color"
        android:id="@+id/bottom_desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_5"
        android:text="@string/larus_dora_broadcast_v3_custom_rule_desc_cn"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintTop_toBottomOf="@+id/rules_recycler_view"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iv_empty_icon"
        android:background="@drawable/larus_dora_bg_special_contacts_icon"
        android:layout_width="?attr/larus_dp_72"
        android:layout_height="?attr/larus_dp_72"
        android:layout_marginTop="?attr/larus_dp_23"
        android:src="@drawable/larus_dora_ic_special_contacts_empty"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_20"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_dora_broadcast_custom_rule_empty_title_cn"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_empty_icon"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/tv_empty_desc"
        android:layout_width="?attr/larus_dp_310"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_dora_broadcast_v3_custom_rule_desc_cn"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_title"/>
    <View
        android:id="@+id/bottom_gradient"
        android:background="@drawable/larus_dora_bg_rule_list_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_100"
        app:layout_constraintBottom_toTopOf="@+id/add_rule_btn"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/add_rule_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_34"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_dora_ic_applist_add"
            android:scaleType="center"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_base_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_broadcast_btn_add_custom_rule_cn"
            android:layout_marginStart="?attr/larus_dp_5"
            android:textFontWeight="500"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
