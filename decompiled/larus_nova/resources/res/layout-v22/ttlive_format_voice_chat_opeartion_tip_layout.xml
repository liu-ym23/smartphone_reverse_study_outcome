<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="184dp"
    android:layout_marginStart="35dp"
    android:layout_marginEnd="35dp">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_format_voice_chat_operation_tip_bg"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/tip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_format_voice_chat_tip_thinking"
        android:fontFamily="PingFang SC"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tip_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_format_voice_chat_thinking_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tip_title"
        app:layout_constraintEnd_toStartOf="@+id/tip_title"
        app:layout_constraintTop_toTopOf="@+id/tip_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tip_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tip_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
