<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_sku_button_tip"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="56dp"
        android:minHeight="36dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_sku_tips_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_sku_tips_button_container"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_sku_button_tip"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/shopping_std_text_black_1"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_sku_button_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/tv_sku_tips_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ll_sku_tips_content"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/shopping_color_8CFF6E00"
                android:gravity="center"
                android:id="@+id/tv_sku_tips_button"
                android:background="@drawable/shopping_bg_selector_tips_btn_bg"
                android:visibility="gone"
                android:layout_width="68dp"
                android:layout_height="24dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:gravity="center"
                android:id="@+id/tv_sku_tips_button_icon"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/sku_ll_tip_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:gravity="center"
        android:id="@+id/ll_sku_button_container"
        android:background="@color/ec_color_white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:rounded_radius="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@drawable/shopping_tc_selector_add_to_cart_tv"
            android:gravity="center"
            android:id="@+id/ll_sku_add_container"
            android:background="@color/shopping_color_0DFE496A"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/shopping_add_to_cart"
            android:layout_weight="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_sku_buy_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_sku_buy_container"
                android:background="@drawable/shopping_bg_selector_go_to_goods_optimize_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/sdv_sku_button_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="0.5dp"
                        android:layout_marginRight="4dp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/shopping_std_text_white_1"
                        android:id="@+id/tv_sku_buy_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shopping_confirm"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_sku_buy_count_down"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:textColor="@color/shopping_std_text_white_1"
                        android:id="@+id/tv_sku_buy_count_down_1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:textColor="@color/shopping_std_text_white_1"
                        android:id="@+id/tv_sku_buy_count_down_2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:textColor="@color/shopping_std_text_white_1"
                        android:id="@+id/tv_sku_buy_count_down_3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/sku_buy_container_mask"
                android:background="#1f000000"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
</LinearLayout>
