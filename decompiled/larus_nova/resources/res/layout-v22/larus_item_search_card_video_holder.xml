<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_156"
    android:layout_height="?attr/larus_dp_208"
    android:layout_marginStart="?attr/larus_dp_12"
    android:layout_marginEnd="?attr/larus_dp_m_4"
    app:rv_backgroundColor="?attr/larus_base_2"
    app:rv_backgroundPressColor="?attr/larus_neutral_transparent_2"
    app:rv_cornerRadius="?attr/larus_dp_8"
    app:rv_strokeColor="?attr/larus_press"
    app:rv_strokeWidth="?attr/larus_dp_1">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImage="?attr/larus_base_2_overlay"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/larus_svg_searchlist_video_play"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/larus_searchlist_video_title_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_36"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_14"
        android:layout_marginHorizontal="?attr/larus_dp_12">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_creator_avatar"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            app:placeholderImage="?attr/larus_base_2_overlay"
            app:roundBottomEnd="true"
            app:roundBottomStart="true"
            app:roundTopEnd="true"
            app:roundTopStart="true"
            app:roundedCornerRadius="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/text_creator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
</com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
