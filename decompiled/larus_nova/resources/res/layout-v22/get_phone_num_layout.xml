<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingLeft="24dp"
    android:paddingTop="16dp"
    android:paddingRight="24dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/applet_app_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#000000"
        android:id="@+id/applet_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/applet_app_icon"
        app:layout_constraintStart_toEndOf="@+id/applet_app_icon"
        app:layout_constraintTop_toTopOf="@+id/applet_app_icon"/>
    <ImageView
        android:id="@+id/attention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/attention"
        app:layout_constraintBottom_toBottomOf="@+id/applet_app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/applet_app_icon"
        app:srcCompat="@drawable/attention"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="normal"
        android:textColor="#000000"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/get_phone_num_title"
        app:layout_constraintBottom_toTopOf="@+id/tv_detail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/applet_app_icon"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#999999"
        android:id="@+id/tv_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/get_phone_num_detail"
        app:layout_constraintBottom_toTopOf="@+id/obric_btn_accept"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <Button
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#000000"
        android:id="@+id/obric_btn_accept"
        android:background="@drawable/normal_button_background"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toTopOf="@+id/obric_btn_reject"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_detail"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <Button
        android:textSize="16sp"
        android:textColor="#000000"
        android:id="@+id/obric_btn_reject"
        android:background="@drawable/normal_button_background"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:text="@string/get_phone_num_reject"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obric_btn_accept"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</androidx.constraintlayout.widget.ConstraintLayout>
