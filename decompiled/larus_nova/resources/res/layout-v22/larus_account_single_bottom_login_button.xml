<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:id="@+id/button_login_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="?attr/larus_dp_400">
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/button_login"
        android:background="@drawable/larus_bg_account_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="?attr/larus_dp_48"
        android:paddingEnd="?attr/larus_dp_25"
        android:stateListAnimator="@null"
        android:textFontWeight="500"/>
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/button_iv"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_25"/>
</FrameLayout>
