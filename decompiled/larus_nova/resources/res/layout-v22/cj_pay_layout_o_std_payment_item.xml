<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/cj_pay_std_content_layout"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingVertical="14dp">
    <RelativeLayout
        android:id="@+id/cj_pay_std_asset_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_asset_icon"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/cj_pay_asset_icon_disable_mask"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/cj_pay_std_asset_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="46dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
        <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
            android:gravity="left"
            android:id="@+id/cj_pay_std_asset_title_voucher_right"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/cj_pay_std_asset_title"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:gravity="right"
            android:id="@+id/cj_pay_std_asset_guide"
            android:paddingRight="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="36dp"
            android:lines="1"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/cj_pay_std_asset_arrow"
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/cj_pay_icon_right_arrow_gray_40000000"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:ellipsize="end"
        android:id="@+id/cj_pay_std_asset_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="60dp"
        android:maxLines="2"
        android:includeFontPadding="false"/>
    <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
        android:gravity="left"
        android:id="@+id/cj_pay_std_asset_voucher"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"/>
    <HorizontalScrollView
        android:id="@+id/cj_pay_std_sub_asset_scroll_layout"
        android:paddingRight="16dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="@dimen/cj_pay_padding_12">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_std_sub_asset_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
        android:ellipsize="end"
        android:id="@+id/cj_pay_std_asset_desc_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="@dimen/cj_pay_padding_6"
        android:layout_marginRight="60dp"
        android:maxLines="2"/>
</LinearLayout>
