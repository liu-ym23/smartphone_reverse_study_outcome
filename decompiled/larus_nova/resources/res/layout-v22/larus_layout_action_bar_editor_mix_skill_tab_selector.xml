<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tl_switch_tab"
            android:background="?attr/larus_bg_action_bar_instruction_widget_tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:minWidth="?attr/larus_dp_128"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_editor_close"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginTop="?attr/larus_dp_0"
            app:tabBackground="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="?attr/larus_bg_action_bar_instruction_widget_tab_indicator"
            app:tabIndicatorColor="?attr/larus_base_4"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="?attr/larus_dp_36"
            app:tabMaxWidth="?attr/larus_dp_0"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?attr/larus_neutral_100"
            app:tabTextAppearance="@style/larus_InstructionTabLayout"
            app:tabTextColor="?attr/larus_neutral_70"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_editor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tl_switch_tab"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_editor_close"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:contentDescription="@string/larus_accessibility_icon_close"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_input_editor_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraint_layout_control"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_attachment_area_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/bottom_divider">
        <FrameLayout
            android:id="@+id/fl_attachment_area"
            android:paddingTop="?attr/larus_dp_1"
            android:paddingBottom="?attr/larus_dp_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_1"
            android:paddingEnd="?attr/larus_dp_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_editor_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_attachment_area_wrapper"/>
</androidx.constraintlayout.widget.ConstraintLayout>
