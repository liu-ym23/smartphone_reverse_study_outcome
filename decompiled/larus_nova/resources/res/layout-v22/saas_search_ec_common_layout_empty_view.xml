<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_ec_common_status_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="6dp"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_ec_common_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/search_ec_common_empty_top_bg"
            android:layout_width="match_parent"
            android:layout_height="110dp"/>
        <View
            android:id="@+id/search_ec_common_empty_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_ec_common_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28">
        <com.bytedance.dux.image.DuxImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_empty_img"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/search_ec_common_empty_img"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="17sp"
            android:textColor="@color/search_color_161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ec_search_search_empty"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14sp"
            android:textColor="@color/search_color_99161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_empty_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ec_search_search_empty_desc"/>
        <com.bytedance.dux.button.DuxButton
            android:textSize="15sp"
            android:textColor="#181623"
            android:layout_gravity="center"
            android:id="@+id/redirect_button"
            android:background="#0b161823"
            android:paddingLeft="35dp"
            android:paddingTop="11dp"
            android:paddingRight="35dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text=""
            android:fontFamily="PingFangSC-Medium"
            android:backgroundTint="#0b161823"
            android:paddingHorizontal="35dp"
            android:paddingVertical="11dp"
            app:cornerRadius="100dp"
            style="@style/DuxButton.Rectangle.Primary.Large"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
