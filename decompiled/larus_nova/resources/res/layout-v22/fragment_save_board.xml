<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/live_tutor_save_board_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_gravity="center"
        android:id="@+id/scroll_view"
        android:focusable="true"
        android:scrollbars="none"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="40dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/save_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundedCornerRadius="16dp"/>
            <View
                android:id="@+id/scroll_footer"
                android:layout_width="match_parent"
                android:layout_height="116dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.larus.common_ui.venus.ShapeButton
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_save"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginBottom="44dp"
        android:text="@string/larus_tutor_save_screenshot_button_cn"
        app:larus_sb_cornerRadius="34dp"
        app:larus_sb_fillColor="@color/primary_50"/>
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/iv_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/guix_common_ic_back"
        android:layout_marginStart="8dp"/>
</FrameLayout>
