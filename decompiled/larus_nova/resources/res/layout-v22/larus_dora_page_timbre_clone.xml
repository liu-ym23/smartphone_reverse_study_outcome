<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="@dimen/larus_layout_common_padding"
        android:paddingEnd="@dimen/larus_layout_common_padding"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/timbre_clone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/timbre_clone_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_simul_interpret_settings_voice_clone_title_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_multi_devices_switch_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_simul_interpret_settings_voice_clone_description_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
