<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_bg_expert_card"
    android:paddingBottom="?attr/larus_dp_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="?attr/larus_dp_1"
    android:paddingEnd="?attr/larus_dp_1">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_expert_title_fold"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_12">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center_vertical"
            android:id="@+id/expert_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_complex_search_chat_name_card_header"
            android:drawablePadding="?attr/larus_dp_4"
            android:drawableTint="?attr/larus_neutral_100"
            app:drawableStartCompat="?attr/larus_icon_expert"/>
        <View
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_0"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_70"
                android:id="@+id/text_expert_title_completed"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 steps completed"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_expert_fold_arrow"
                android:layout_width="?attr/larus_dp_38"
                android:layout_height="?attr/larus_dp_14"
                android:paddingStart="?attr/larus_dp_12"
                android:paddingEnd="?attr/larus_dp_12"
                app:srcCompat="?attr/larus_icon_chevron_left_fill"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/step_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.bmhome.chat.layout.widget.AtMostHeightRecyclerView
            android:id="@+id/step_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
