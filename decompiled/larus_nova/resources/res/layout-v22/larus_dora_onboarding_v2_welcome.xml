<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/dora_onboarding_welcome_img"
        android:layout_width="?attr/larus_dp_390"
        android:layout_height="?attr/larus_dp_390"
        android:layout_marginTop="?attr/larus_dp_87"
        android:src="@drawable/larus_image_onboarding_popup_headphone_welcome_silver"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_28"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/dora_onboarding_welcome_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_dora_onboarding_welcome_cn"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:textFontWeight="600"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_welcome_sub_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/dora_onboarding_welcome_sub_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_32"
        android:text="@string/larus_dora_onboarding_welcome_slogan_cn"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_bottom_button_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:id="@+id/dora_onboarding_bottom_button_placeholder"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_48"
        android:minHeight="?attr/larus_dp_56"
        android:text="@string/larus_dora_btn_continue_cn"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
