<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ec_coupon_fragment_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ec_page_title_height">
        <View
            android:background="@color/ec_color_black_161823_8"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <com.bytedance.android.ui.base.widget.icon.IconImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/ec_dux_ic_s_s_arrowleft_outlined"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            app:icon_color="@color/ec_dux_black_161823"/>
        <TextView
            android:textSize="@dimen/ec_dialog_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/ec_color_black_text"
            android:id="@+id/tv_coupon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_bind_coupon_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ec_color_coupon_hint"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ec_input_coupon_id_hint"/>
            <FrameLayout
                android:background="@drawable/ec_bg_input_area"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp">
                <RelativeLayout
                    android:id="@+id/rl_edit_region"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp">
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="14dp"
                        android:textColor="@color/ec_color_black_text"
                        android:gravity="center_vertical"
                        android:id="@+id/et_input_coupon"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="16dp"
                        android:hint="@string/ec_input_content_hint"
                        android:digits="0123456789"
                        android:layout_toLeftOf="@+id/ec_edit_wrapper"
                        android:inputType="phone"
                        android:textCursorDrawable="@drawable/ec_coupon_cursor_bg"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ec_edit_wrapper"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true">
                        <ImageView
                            android:id="@+id/tv_delete_text"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginRight="12dp"
                            android:src="@drawable/ec_icon_delete_input_text"
                            android:scaleType="centerCrop"
                            android:layout_toLeftOf="@+id/tv_confirm"
                            android:layout_centerVertical="true"/>
                        <View
                            android:background="@color/ec_color_51_C4C4C4"
                            android:layout_width="0.5dp"
                            android:layout_height="30dp"
                            android:layout_toLeftOf="@+id/tv_confirm"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textColor="@color/ec_color_action_text"
                            android:gravity="center"
                            android:layout_gravity="right"
                            android:id="@+id/tv_confirm"
                            android:layout_width="62dp"
                            android:layout_height="match_parent"
                            android:text="@string/ec_confirm"/>
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/tv_no_coupon_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <ImageView
                        android:id="@+id/ec_coupon_host"
                        android:layout_width="240dp"
                        android:layout_height="160dp"
                        android:src="@drawable/ec_coupon_host"/>
                    <TextView
                        android:textColor="@color/ec_color_black_text_invalid"
                        android:gravity="center_horizontal"
                        android:id="@+id/tv_prompt_msg_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ec_input_coupon_prompt_text"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_coupon_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.livesdk.livecommerce.view.coupon.ECNewAddCouponLayout
                        android:id="@+id/hcdl_coupon_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
