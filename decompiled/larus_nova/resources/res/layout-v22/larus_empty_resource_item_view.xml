<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_92"
    android:layout_height="?attr/larus_dp_108">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resource_item_empty_container"
        android:background="?attr/larus_bg_resource_empty"
        android:layout_width="?attr/larus_dp_84"
        android:layout_height="?attr/larus_dp_84"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/resource_item_empty_image"
                android:background="@android:color/transparent"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_11"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:id="@+id/resource_item_empty_text"
                android:paddingTop="?attr/larus_dp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minHeight="?attr/larus_dp_17"
                android:maxLines="1"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="@dimen/dp_4"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/resource_item_empty_image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
