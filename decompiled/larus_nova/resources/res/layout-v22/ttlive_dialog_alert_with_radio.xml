<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <TextView
        android:id="@+id/alert_dialog_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineHeight="20dp"
        style="@style/uicomponent_common_alert_dialog_title_tv"/>
    <TextView
        android:id="@+id/alert_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/uicomponent_common_alert_dialog_content_tv"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/alert_check_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <ToggleButton
            android:id="@+id/alert_check_toggle"
            android:background="@drawable/ttlive_bg_dialog_checked"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:textOn=""
            android:textOff=""/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:id="@+id/alert_check_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="0dp"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            style="@style/uicomponent_common_alert_dialog_content_tv"/>
    </LinearLayout>
</LinearLayout>
