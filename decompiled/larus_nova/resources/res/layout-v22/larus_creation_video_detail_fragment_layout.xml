<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="@color/larus_static_black_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/background"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/retry_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/big_image_blank_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_refresh_white"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_photo_loading_retry"
            android:layout_below="@+id/big_image_blank_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_info_container"
        android:background="@drawable/larus_bg_img_template_mask"
        android:paddingBottom="?attr/larus_dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/video_play_control_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/prompt_content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_19"
            android:layout_marginRight="?attr/larus_dp_16"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            android:lineHeight="?attr/larus_dp_21"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/static_white_transparent_3"
            android:ellipsize="end"
            android:id="@+id/author_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_16"
            android:lineHeight="?attr/larus_dp_21"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/count_content_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/prompt_content_view"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/static_white_transparent_3"
            android:ellipsize="end"
            android:id="@+id/count_content_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:lineHeight="?attr/larus_dp_21"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/author_info"
            app:layout_constraintTop_toBottomOf="@+id/prompt_content_view"
            app:layout_goneMarginStart="?attr/larus_dp_16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.bmhome.video.view.CreationVideoDetailPlayControlView
        android:id="@+id/video_play_control_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_tools_container"/>
    <View
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintTop_toTopOf="@+id/video_play_control_view"/>
    <FrameLayout
        android:id="@+id/bottom_tools_container"
        android:background="@color/larus_static_black_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="start|bottom"
            android:id="@+id/bottom_container"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/larus_dp_12">
            <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
                android:id="@+id/download_layout"
                android:background="@drawable/larus_bg_big_image_icon"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_44"
                android:contentDescription="@string/larus_accessibility_save"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintEnd_toStartOf="@+id/creation_view"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_0"/>
            <com.larus.bmhome.view.CreationOperateContainerView
                android:id="@+id/creation_view"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_44"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toEndOf="@+id/download_layout"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
