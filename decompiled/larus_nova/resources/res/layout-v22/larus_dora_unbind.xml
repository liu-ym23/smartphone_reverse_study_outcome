<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="?attr/larus_dp_16">
            <LinearLayout
                android:orientation="vertical"
                android:background="@null"
                android:padding="?attr/larus_dp_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="?attr/larus_dp_80"
                    android:layout_height="?attr/larus_dp_80"
                    android:layout_marginTop="?attr/larus_dp_20"
                    android:src="@drawable/larus_dora_unbind_img"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/neutral_100"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_24"
                    android:text="@string/larus_dora_g_recovery_reset_notice_cn"
                    android:textAlignment="center"
                    android:textFontWeight="500"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_12"
                    android:minHeight="?attr/larus_dp_55">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="?attr/larus_dp_32"
                        android:layout_height="?attr/larus_dp_32"
                        android:src="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/neutral_70"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_g_recovery_unsynced_media_cn"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:textFontWeight="400"/>
                </LinearLayout>
                <View
                    android:background="@color/larus_neutral_transparent_3"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0_5"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_56">
                    <ImageView
                        android:layout_width="?attr/larus_dp_32"
                        android:layout_height="?attr/larus_dp_32"
                        android:src="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/neutral_70"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_g_recovery_system_settings_cn"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:textFontWeight="400"/>
                </LinearLayout>
                <View
                    android:background="@color/larus_neutral_transparent_3"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0_5"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_50">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="?attr/larus_dp_32"
                            android:layout_height="?attr/larus_dp_32"
                            android:src="@null"/>
                        <com.larus.dora.impl.view.DoraTextView
                            android:textSize="?attr/larus_sp_15"
                            android:textColor="@color/neutral_70"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_dora_g_recovery_system_logs_cn"
                            android:maxLines="1"
                            android:textAlignment="center"
                            android:layout_marginStart="?attr/larus_dp_16"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:id="@+id/larus_dora_g_unbind_button"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_18"
                android:layout_marginBottom="?attr/larus_dp_16"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_dora_g_recovery_unbind_reset_cn"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
