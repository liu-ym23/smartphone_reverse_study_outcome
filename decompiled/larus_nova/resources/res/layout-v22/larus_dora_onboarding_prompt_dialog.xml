<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/base_1"
        app:rv_cornerRadius_TL="?attr/larus_dp_20"
        app:rv_cornerRadius_TR="?attr/larus_dp_20">
        <ImageView
            android:id="@+id/dora_onboarding_dialog_close_btn"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_16"
            android:src="@drawable/larus_dora_onboarding_close_btn"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_24"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_onboarding_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_70"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_onboarding_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_dialog_title"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_onboarding_dialog_mv_layout"
                android:layout_width="?attr/larus_dp_390"
                android:layout_height="?attr/larus_dp_260"
                android:layout_marginTop="?attr/larus_dp_48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_dialog_title">
                <com.larus.dora.impl.view.DoraMovieView
                    android:layout_gravity="center"
                    android:id="@+id/dora_onboarding_dialog_mv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_title"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/dora_onboarding_dialog_sdv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="?attr/larus_dp_56"
                    android:layout_marginTop="?attr/larus_dp_40"
                    android:layout_marginRight="?attr/larus_dp_56"
                    android:layout_marginBottom="?attr/larus_dp_40"
                    android:layout_marginHorizontal="?attr/larus_dp_56"
                    app:actualImageScaleType="fitCenter"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_70"
                android:ellipsize="end"
                android:gravity="top|left"
                android:id="@+id/dora_onboarding_dialog_center_tips"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_260"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_48"
                android:layout_marginRight="?attr/larus_dp_32"
                android:layout_marginBottom="?attr/larus_dp_48"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="400"
                app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_dialog_connect_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_dialog_title"
                app:layout_constraintWidth_max="?attr/larus_dp_420"/>
            <View
                android:background="@drawable/larus_dora_onboarding_dialog_video_bottom_mask"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_34"
                app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_dialog_mv_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/dora_onboarding_dialog_bottom_tips"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginRight="?attr/larus_dp_32"
                android:maxLines="1"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_dialog_mv_layout"
                app:layout_constraintWidth_max="?attr/larus_dp_420"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/dora_onboarding_dialog_connect_btn"
                android:background="@drawable/larus_dora_onboarding_connect_btn"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginRight="?attr/larus_dp_32"
                android:text="@string/larus_dora_onboarding_connect_cn"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_dialog_mv_layout"
                app:layout_constraintWidth_max="?attr/larus_dp_420"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
