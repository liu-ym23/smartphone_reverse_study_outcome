<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tutorial_ai_replica_container"
        android:paddingTop="?attr/larus_dp_52"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_static_white"
            android:id="@+id/tutorial_ai_replica_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/static_white_transparent_4"
            android:id="@+id/tutorial_ai_replica_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"/>
    </LinearLayout>
    <com.larus.avatar.impl.scan.view.ScanCameraFaceContourView
        android:id="@+id/tutorial_face_contour_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tutorial_scan_container"
        android:paddingTop="?attr/larus_dp_52"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_scan_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_create_replica_video_desc_prep"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_35"
            android:textFontWeight="700"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tutorial_say_container"
        android:paddingTop="?attr/larus_dp_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/tutorial_say_progress"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_4"
            android:layout_marginBottom="?attr/larus_dp_26"
            android:max="100"
            android:progress="4"
            android:progressDrawable="@drawable/larus_tutorial_progress_bar_style"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_18"
            android:textColor="@color/static_white_transparent_4"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_say_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_create_replica_video_desc_face_read"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_26"
            android:textFontWeight="700"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_30"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_say_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_48"
            android:textFontWeight="700"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_68"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_say_text_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:text="3"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_90"
            android:textFontWeight="700"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tutorial_error_container"
        android:paddingTop="?attr/larus_dp_54"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_error_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_replica_video_title_action_not_match"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_35"
            android:textFontWeight="700"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/static_white_transparent_4"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tutorial_error_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_creation_replica_video_desc_action_not_match"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_23"
            android:textFontWeight="400"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tutorial_finish_container"
        android:paddingTop="?attr/larus_dp_56"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/tutorial_finish_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginRight="?attr/larus_dp_24"
            android:text="@string/larus_create_replica_video_desc_done"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="?attr/larus_dp_24"
            android:textFontWeight="700"/>
    </LinearLayout>
</FrameLayout>
