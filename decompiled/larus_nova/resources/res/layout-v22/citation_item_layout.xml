<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_24"
    android:paddingRight="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_24">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/citation_iv_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/dp_24"
        app:srcCompat="@drawable/ud_icon_file_round_link_blue_colorful"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/citation_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_toEndOf="@+id/citation_iv_icon"/>
    <View
        android:id="@+id/citation_item_divider"
        android:background="@color/line_divider_default"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_below="@+id/citation_tv_title"/>
</RelativeLayout>
