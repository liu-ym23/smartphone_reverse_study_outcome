<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_container"
    android:layout_width="?attr/larus_dp_170"
    android:layout_height="?attr/larus_dp_92"
    android:layout_marginStart="?attr/larus_dp_12"
    android:layout_marginEnd="?attr/larus_dp_m_4"
    app:rv_cornerRadius="?attr/larus_dp_12"
    app:rv_strokeColor="?attr/larus_press"
    app:rv_strokeWidth="0.8dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_cover"
        android:paddingLeft="?attr/larus_dp_1"
        android:paddingTop="?attr/larus_dp_1"
        android:paddingRight="?attr/larus_dp_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="?attr/larus_dp_1"
        app:placeholderImage="?attr/larus_base_2_overlay"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_mask"
        android:paddingLeft="?attr/larus_dp_1"
        android:paddingTop="?attr/larus_dp_1"
        android:paddingRight="?attr/larus_dp_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="?attr/larus_dp_1"
        app:placeholderImage="@color/larus_static_black"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <com.larus.bmhome.chat.layout.widget.RoundLinearLayoutWithLastMotion
        android:orientation="vertical"
        android:id="@+id/card_holder"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rv_cornerRadius="?attr/larus_dp_12">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:ellipsize="end"
                android:id="@+id/mock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_cici_auto_renewal_reminder_email_content"
                android:maxLines="2"
                android:lines="2"
                android:alpha="0"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:lines="2"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/card_refer"
            android:layout_width="?attr/larus_dp_132"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/image_creator_avatar"
                android:visibility="visible"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:roundBottomEnd="true"
                app:roundBottomStart="true"
                app:roundTopEnd="true"
                app:roundTopStart="true"
                app:roundedCornerRadius="?attr/larus_dp_4"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:ellipsize="end"
                    android:id="@+id/mock_text_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_cici_auto_renewal_reminder_email_content"
                    android:maxLines="1"
                    android:lines="1"
                    android:alpha="0"/>
                <TextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="?attr/larus_neutral_70"
                    android:id="@+id/text_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
            </FrameLayout>
        </LinearLayout>
    </com.larus.bmhome.chat.layout.widget.RoundLinearLayoutWithLastMotion>
</com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
