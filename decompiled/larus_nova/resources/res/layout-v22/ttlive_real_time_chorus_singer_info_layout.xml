<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.android.livesdk.ktvimpl.realtimechorus.NumberScrollViewFlipper
        android:id="@+id/chorus_num_text_dynamic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#b3ffffff"
        android:id="@+id/chorus_num_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" 人合唱中"
        android:includeFontPadding="false"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/chorus_num_text_dynamic"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_line"
        android:background="#99ffffff"
        android:layout_width="0.5dp"
        android:layout_height="10dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/chorus_num_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#b3ffffff"
        android:id="@+id/chorus_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/divider_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/chorus_arrow"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginLeft="4dp"
        android:src="@drawable/chorus_singer_info_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/chorus_score"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
