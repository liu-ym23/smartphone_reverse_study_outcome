<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="100dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_main_image"
        android:background="@color/shopping_std_bg_primary_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_border"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_color_white"
        android:gravity="center"
        android:id="@+id/tv_status"
        android:background="@drawable/ec_shape_promotion_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:includeFontPadding="false"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_explain_bar_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutMode="height_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_explain_bar_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        app:autoPlayAnimation="true"
        app:layoutMode="self_adjust_3X"
        app:layout_constraintBottom_toBottomOf="@+id/iv_explain_bar_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_explain_bar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_explain_bar_bg"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_explain_bar_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:autoPlayAnimation="true"
        app:layoutMode="self_adjust_3X"
        app:layout_constraintBottom_toBottomOf="@+id/iv_explain_bar_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_explain_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_explain_bar_bg"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/tv_explain_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/iv_explain_bar_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_explain_bar_right"
        app:layout_constraintStart_toEndOf="@+id/iv_explain_bar_left"
        app:layout_constraintTop_toTopOf="@+id/iv_explain_bar_bg"/>
    <FrameLayout
        android:id="@+id/fl_top_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_top_left"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_index"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="20dp"
                android:includeFontPadding="false"
                android:textFontWeight="600"/>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/iv_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                app:actualImageScaleType="fitXY"
                app:layoutMode="width_self_adjust"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
            android:id="@+id/element_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
</merge>
