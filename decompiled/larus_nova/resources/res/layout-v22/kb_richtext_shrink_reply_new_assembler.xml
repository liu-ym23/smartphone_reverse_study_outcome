<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_reply"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="18dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_replay_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <View
            android:id="@+id/divider_vertical"
            android:background="@color/static_black_10"
            android:layout_width="3dp"
            android:layout_height="16dp"/>
        <com.larksuite.framework.ui.ViewTransitionContainer
            android:id="@+id/tv_root_msg_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.ss.android.lark.widget.EllipsizedEmojiconTextView
                android:textSize="14sp"
                android:textColor="@color/flow_ud_neutral_70"
                android:textColorHint="@color/flow_ud_neutral_70"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_root_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Legacy_Reply"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="16dp"/>
        </com.larksuite.framework.ui.ViewTransitionContainer>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_close_reply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_close_btn"/>
    </LinearLayout>
</LinearLayout>
