<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_coupon_popup_coupon"
    android:layout_width="280dp"
    android:layout_height="283dp">
    <ImageView
        android:id="@+id/iv_close_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_ug_coupon_dialog_close_bg"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_coupon_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="1"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_close_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_coupon_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_coupon_bg"
        android:background="@drawable/ttlive_ug_coupon_new_bg"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_popup_coupon_subtitle"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_coupon_center_vertical_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.356"/>
    <View
        android:id="@+id/gl_coupon_center_horizontal_split"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_coupon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_coupon_bg"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_coupon_bg"
        app:layout_constraintEnd_toEndOf="@+id/gl_coupon_center_vertical_split"
        app:layout_constraintStart_toStartOf="@+id/iv_coupon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_coupon_bg">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#fe2c55"
                android:id="@+id/tv_coupon_price_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥"
                android:textFontWeight="600"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="28sp"
                android:textColor="#fe2c55"
                android:id="@+id/tv_coupon_price"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_coupon_price_unit"
                app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_price_unit"
                app:layout_constraintStart_toEndOf="@+id/tv_coupon_price_unit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tv_coupon_price_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textFontWeight="400"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:id="@+id/tv_coupon_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toTopOf="@+id/gl_coupon_center_horizontal_split"
        app:layout_constraintEnd_toEndOf="@+id/iv_coupon_bg"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gl_coupon_center_vertical_split"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:id="@+id/tv_coupon_use_condition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="@+id/iv_coupon_bg"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gl_coupon_center_vertical_split"
        app:layout_constraintTop_toBottomOf="@+id/gl_coupon_center_horizontal_split"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_coupon_popup_positive_button"
        android:background="@drawable/ttlive_bg_coupon_popup_postive_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/iv_coupon_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_coupon_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_coupon_bg"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_negative_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_coupon_popup_positive_button"
        app:layout_constraintStart_toStartOf="@+id/tv_coupon_popup_positive_button"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_popup_positive_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
