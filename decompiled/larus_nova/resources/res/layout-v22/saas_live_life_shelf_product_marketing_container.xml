<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="14dp">
    <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
        android:orientation="horizontal"
        android:id="@+id/marketing_style_1_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="4dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/marketing_style_1_prefix_icon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:scaleType="fitXY"
            android:layout_marginStart="2.5dp"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="9dp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/marketing_style_1_left_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            android:layout_marginStart="2.5dp"
            android:textFontWeight="500"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/marketing_style_1_left_splitter_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <View
                android:id="@+id/marketing_style_1_left_splitter"
                android:layout_width="0.5dp"
                android:layout_height="9dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="9dp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/marketing_style_1_left_extend_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"
                android:textFontWeight="500"/>
        </LinearLayout>
    </com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/marketing_style_2_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="9dp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/marketing_style_2_left_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            android:paddingStart="4dp"
            android:textFontWeight="500"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/marketing_style_2_left_curve_iv"
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="9dp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/marketing_style_2_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:textFontWeight="500"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/marketing_style_3_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/marketing_style_3_content_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/marketing_style_3_left_bg_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:actualImageScaleType="fitXY"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="9dp"
                    android:textColor="#fe2c55"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/marketing_style_3_left_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC-Medium"
                    android:paddingStart="6dp"
                    android:textFontWeight="500"/>
            </FrameLayout>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/marketing_style_3_left_curve_iv"
                android:layout_width="6dp"
                android:layout_height="14dp"
                android:scaleType="fitXY"
                app:actualImageScaleType="fitXY"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="9dp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/marketing_style_3_right_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"
                android:paddingStart="2dp"
                android:paddingEnd="4dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/marketing_style_3_prefix_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/marketing_style_4_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/marketing_style_4_prefix_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <FrameLayout
            android:id="@+id/marketing_style_4_left_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/marketing_style_4_left_bg_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:actualImageScaleType="fitXY"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="9dp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/marketing_style_4_left_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"
                android:textFontWeight="500"/>
        </FrameLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/marketing_style_4_left_curve_iv"
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="9dp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/marketing_style_4_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:textFontWeight="500"/>
    </LinearLayout>
</merge>
