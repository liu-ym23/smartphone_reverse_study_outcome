<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_permission_read"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="阅读权限"
        android:textFontWeight="500"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_permission_edit"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="编辑权限"
        android:textFontWeight="500"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_permission_cancel"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_cancel"
        android:textFontWeight="500"/>
</LinearLayout>
