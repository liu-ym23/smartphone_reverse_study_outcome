<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@drawable/facade_round_around_l"
        android:clipChildren="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/bg_body">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/more_item_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/icon_n1"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/more_item_new"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_2"
            android:layout_marginStart="@dimen/space_kit_len_22"
            style="@style/UDBadge.Dot.StrongReminder.Large"/>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/more_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:minLines="2"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"/>
    </LinearLayout>
</LinearLayout>
