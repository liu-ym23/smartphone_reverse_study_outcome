<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/label_left_text"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="4dp"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.ec.core.widget.VerticalDashLineView
        android:id="@+id/label_divider"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="@+id/label_left_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/coupon_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toRightOf="@+id/label_left_text">
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/label_icon"
            android:visibility="gone"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginRight="2dp"
            app:actualImageScaleType="fitXY"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/label_right_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <View
        android:id="@+id/label_stroke"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
