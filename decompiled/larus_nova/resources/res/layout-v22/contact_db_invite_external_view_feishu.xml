<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/iefRootRl"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.contact.customized.common.view.ContactOfficeTitleBar
        android:id="@+id/iefTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:title="@string/LarkIM_Friend_AddContact_Title"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/iefSearchRoot"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/iefSearchLl"
                    android:background="@color/flow_ud_bg_base_2_overlay"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="12dp"
                    app:rl_radius="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/contact_db_icon_search"
                        app:tint="@color/flow_ud_neutral_50"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/flow_ud_neutral_50"
                        android:id="@+id/iefSearchTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
                <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/iefQrCard"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    app:rl_radius="16dp">
                    <com.larksuite.component.ui.layout.LKUIRoundableLayout
                        android:id="@+id/iefQrContainer"
                        android:background="@color/static_white"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:rl_radius="8dp">
                        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                            android:layout_gravity="center"
                            android:id="@+id/iefQrIv"
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            app:radius="4dp"/>
                        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                            android:layout_gravity="center"
                            android:id="@+id/iefQrLogo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:border_color="@color/static_white"
                            app:border_width="4dp"
                            app:oval="true"/>
                    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/flow_ud_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/iefQrNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="1"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/iefQrTipLayout"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/flow_ud_neutral_50"
                            android:id="@+id/iefQrTipTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iefQrTipIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            app:srcCompat="@drawable/contact_db_icon_copy"/>
                    </LinearLayout>
                </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/iefRv"
                    android:background="@color/flow_ud_bg_base_1"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
            </LinearLayout>
        </ScrollView>
        <com.ss.android.lark.contact.customized.common.view.ContactOfficeEmptyStateView
            android:id="@+id/iefErrorView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/iefLoadingLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.contact.customized.common.view.ContactOfficeLoadingView
                android:layout_gravity="center"
                android:id="@+id/iefLoadingSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
