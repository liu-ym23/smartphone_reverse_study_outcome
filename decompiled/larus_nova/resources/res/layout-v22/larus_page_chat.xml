<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.chat.layout.widget.NestedScrollableContainer
        android:id="@+id/message_list_parent"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/splitter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_login_guide_banner"
        app:layout_constraintVertical_weight="1"
        app:layout_goneMarginTop="0dp">
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="top|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/toggle_pre_one"
            android:paddingBottom="?attr/larus_dp_8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_120">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="?attr/larus_dp_17"
                    android:layout_height="?attr/larus_dp_16"
                    android:src="@drawable/larus_ic_arrow_down_fill"/>
                <TextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_1"
                    android:text="@string/larus_bot_instruction_swipeDown"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/message_list_sub_parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.larus.bmhome.double_post.drag_panel.ChatAwemeNestedContainer
                android:id="@+id/aweme_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.larus.bmhome.view.ChatMessageList
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/message_list"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
                <FrameLayout
                    android:id="@+id/aweme_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.larus.bmhome.double_post.drag_panel.ChatAwemeNestedContainer>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/toggle_next_one"
                android:paddingTop="?attr/larus_dp_8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_120">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="?attr/larus_dp_17"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_ic_arrow_up_fill"/>
                    <TextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/larus_static_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_bot_instruction_swipeUp"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <ViewStub
                android:id="@+id/view_stub_of_deep_think_top_header"
                android:paddingTop="?attr/larus_dp_12"
                android:layout="@layout/larus_component_search_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="?attr/larus_dp_30"/>
        </FrameLayout>
    </com.larus.bmhome.chat.layout.widget.NestedScrollableContainer>
    <View
        android:id="@+id/cancel_modify_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/message_list_parent"
        app:layout_constraintLeft_toLeftOf="@+id/message_list_parent"
        app:layout_constraintRight_toRightOf="@+id/message_list_parent"
        app:layout_constraintTop_toTopOf="@+id/message_list_parent"/>
    <FrameLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_login_guide_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <TextView
        android:textColor="?attr/larus_primary_50"
        android:gravity="center"
        android:id="@+id/tv_login_guide_banner"
        android:background="?attr/larus_bg_login_guide_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:text="@string/larus_login_banner_loginNow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"/>
    <ViewStub
        android:id="@+id/top_floating_button_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_login_guide_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/splitter"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintBottom_toTopOf="@+id/input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_list_parent"/>
    <ViewStub
        android:id="@+id/bottom_floating_button_container"
        android:visibility="gone"
        android:layout="@layout/larus_page_chat_bottom_floating_button"
        android:inflatedId="@+id/bottom_floating_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/input"/>
    <ViewStub
        android:id="@+id/chat_bubble_banner_overlay_stub"
        android:visibility="gone"
        android:layout="@layout/larus_layout_bubble_banner_overlay"
        android:inflatedId="@+id/chat_bubble_banner_overlay_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/input"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/continue_talk_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splitter"
        app:layout_goneMarginBottom="0dp"/>
    <Space
        android:id="@+id/space_shortcut_y_pos"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintTop_toTopOf="@+id/input"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/latest_photo_shortcut_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toTopOf="@+id/space_shortcut_y_pos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/space_shortcut_x_pos"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_0"
            android:layout_marginEnd="?attr/larus_dp_128"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ViewStub
            android:id="@+id/stub_latest_photo_shortcut"
            android:inflatedId="@+id/latest_photo_shortcut_layout"
            android:layout_width="?attr/larus_dp_136"
            android:layout_height="?attr/larus_dp_160"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/space_shortcut_x_pos"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/continuous_talk_container"
        android:inflatedId="@+id/continuous_talk_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/continue_talk_btn"
        android:background="?attr/larus_bg_bottom_action_button_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_shared_chat_continue_chat"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        android:layout_marginVertical="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/share_layout"
        app:layout_constraintTop_toBottomOf="@+id/input"
        app:layout_goneMarginBottom="0dp"/>
    <ViewStub
        android:id="@+id/layout_pc_local_cvs_hint"
        android:visibility="gone"
        android:inflatedId="@+id/layout_pc_local_cvs_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/continue_talk_btn"
        app:layout_constraintVertical_bias="1"/>
    <ViewStub
        android:id="@+id/share_layout"
        android:visibility="gone"
        android:layout="@layout/larus_page_chat_bottom_share"
        android:inflatedId="@+id/share_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/collection_layout"
        app:layout_constraintTop_toBottomOf="@+id/continue_talk_btn"/>
    <ViewStub
        android:id="@+id/collection_layout"
        android:layout="@layout/larus_page_chat_bottom_collection"
        android:inflatedId="@+id/collection_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/case_layout"
        app:layout_constraintTop_toBottomOf="@+id/share_layout"/>
    <ViewStub
        android:id="@+id/case_layout"
        android:layout="@layout/larus_page_chat_bottom_case"
        android:inflatedId="@+id/case_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
        app:layout_constraintTop_toBottomOf="@+id/collection_layout"/>
    <ViewStub
        android:id="@+id/playback_layout"
        android:layout="@layout/larus_page_chat_bottom_playback"
        android:inflatedId="@+id/playback_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/case_layout">
        <com.larus.bmhome.view.BottomMenuGridLayout
            android:id="@+id/bottom_menu"
            android:background="?attr/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            app:layout_constraintVertical_weight="0"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/input_bar_overlay_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/touch_intercepting_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/user_ban_intercept_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/speaker"
        android:visibility="gone"
        android:clickable="true"
        android:layout="@layout/larus_layout_chat_speaker"
        android:inflatedId="@+id/speaker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/immers_guide"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_chat_immers_guide"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/intercept_use_interact_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/input_intercept_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/top_button_intercept_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/luckdog_stub_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.larus.bmhome.view.ChatConstraintLayout>
