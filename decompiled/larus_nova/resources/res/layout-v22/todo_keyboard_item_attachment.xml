<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/layout_attachment_container"
        android:background="@drawable/todo_attachment_background"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:minHeight="64dp"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingVertical="12dp"
        app:rl_radius="@dimen/dp_4">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_attachment_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_attachment_icon"
                android:layout_width="36sp"
                android:layout_height="36sp"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="middle"
                    android:id="@+id/text_attachment_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/text_attachment_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:maxLines="1"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_attachment_retry"
                android:padding="12sp"
                android:layout_width="44sp"
                android:layout_height="44sp"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_refresh_outlined"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_attachment_delete"
                android:padding="12sp"
                android:layout_width="44sp"
                android:layout_height="44sp"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_delete_trash_outlined"/>
        </LinearLayout>
        <com.larksuite.component.universe_design.progress.UDProgress
            android:layout_gravity="bottom"
            android:id="@+id/progressbar_attachment"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_3"
            android:max="100"
            app:ud_progress_indicatorColor="@color/primary_content_default"
            app:ud_progress_indicatorCornerRadius="@dimen/dp_4"
            app:ud_progress_thickness="@dimen/dp_3"
            app:ud_progress_trackColor="@color/ud_N300"
            app:ud_progress_type="linear"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
</LinearLayout>
