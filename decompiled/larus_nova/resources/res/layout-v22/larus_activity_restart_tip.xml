<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/restart_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/restart_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_240">
        <ImageView
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:src="@drawable/larus_ic_restart_hint"
            android:scaleType="centerInside"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:text="@string/larus_Lark_DoubaoIM_RestartToView_Empty"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_white"
            android:gravity="center"
            android:id="@+id/btn_restart"
            android:background="@drawable/larus_bg_btn_restart"
            android:paddingLeft="?attr/larus_dp_28"
            android:paddingTop="?attr/larus_dp_11"
            android:paddingRight="?attr/larus_dp_28"
            android:paddingBottom="?attr/larus_dp_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_Lark_DoubaoIM_RestartToView_Button"
            android:paddingHorizontal="?attr/larus_dp_28"
            android:paddingVertical="?attr/larus_dp_11"/>
    </LinearLayout>
</LinearLayout>
