<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/creation_detail_header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.community.impl.detail.image.CreationDetailImageView
        android:id="@+id/creation_detail_image_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larus.community.impl.detail.video.CreationDetailVideoView
        android:id="@+id/creation_detail_video_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larus.community.impl.detail.prompt.CreationDetailPromptView
        android:id="@+id/creation_detail_prompt_view"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_16"/>
    <View
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:layout_marginVertical="?attr/larus_dp_20"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/tv_comment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_community_close_circle_fill"
        android:text="@string/larus_botsComment_comment_title"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:textFontWeight="600"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/creation_detail_comment_area"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_4"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:paddingHorizontal="?attr/larus_dp_16">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_avatar_icon"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            app:placeholderImage="@color/larus_neutral_transparent_1"
            app:roundAsCircle="true"/>
        <FrameLayout
            android:id="@+id/comment_input_ph"
            android:background="@drawable/larus_creation_detail_comment_ph_bg"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_weight="1"
            android:layout_marginStart="?attr/larus_dp_12">
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_neutral_50"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_botsComment_commentPanel_inputField_placeholder"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="400"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
