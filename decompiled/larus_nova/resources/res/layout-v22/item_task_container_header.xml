<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_for_tasklist_top"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_05"
        android:layout_marginLeft="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginRight="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:layout_marginVertical="@dimen/dp_6"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/button_header_layout"
        android:background="@drawable/todo_container_item_bg"
        android:paddingTop="@dimen/dp_1"
        android:paddingBottom="@dimen/dp_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_6"
        android:layout_marginRight="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:paddingVertical="@dimen/dp_1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_container_header_arrow"
            android:padding="@dimen/dp_4"
            android:layout_width="20sp"
            android:layout_height="20sp"
            android:tint="@drawable/todo_container_item_icon_color"
            android:layout_marginStart="@dimen/dp_10"
            app:srcCompat="@drawable/ud_icon_expand_down_filled"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_10">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_container_header_arrow_small"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:tint="@color/icon_n2"
                android:layout_marginEnd="@dimen/dp_4"
                app:srcCompat="@drawable/ud_icon_down_outlined"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/todo_container_item_text_color"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/text_container_header_name"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_46"
                android:singleLine="true"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_create_task_list"
            android:padding="12sp"
            android:visibility="gone"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:tint="@color/icon_n2"
            app:srcCompat="@drawable/ud_icon_add_middle_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_task_list_section_more"
            android:padding="12sp"
            android:visibility="gone"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:tint="@color/icon_n2"
            app:srcCompat="@drawable/ud_icon_more_outlined"/>
    </LinearLayout>
</LinearLayout>
