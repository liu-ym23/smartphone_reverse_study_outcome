<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_switch_account_layout"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="376dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_switch_account_titlebar"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <Button
            android:id="@+id/cj_pay_switch_account_close"
            android:background="@drawable/cj_pay_close_icon_with_background"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/cj_pay_switch_account_titlebar">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cj_pay_switch_account_merchant_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:textSize="21sp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_switch_account_voucher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="切换一下账号付款\10本单立减5元"
            android:maxLines="2"
            android:lineSpacingExtra="4dp"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#bf161823"
            android:id="@+id/cj_pay_switch_account_suggest_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用你当前高德打车的手机号"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/cj_pay_switch_account_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginBottom="16dp"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
    </LinearLayout>
</LinearLayout>
