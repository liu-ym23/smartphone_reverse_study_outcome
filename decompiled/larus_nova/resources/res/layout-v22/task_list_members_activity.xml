<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.ui.CommonTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout
                android:id="@+id/todo_refactor_ptr_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/task_list_members"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
            <View
                android:id="@+id/mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/invite_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/send_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/line_divider_default"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <com.suite.lark.emm.design.edittext.SCEditText
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_placeholder"
                    android:gravity="bottom"
                    android:id="@+id/note_text"
                    android:background="@null"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/Todo_ShareList_SendNotification_Placeholder"
                    android:maxLines="5"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_64">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/note_checkbox"
                    android:padding="0dp"
                    android:layout_width="20sp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:checked="true"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_title"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_ShareList_SendNotification_Checkbox"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dp_8"/>
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/invite_button"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_TaskList_Invite_Button"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:paddingVertical="5dp"
                    app:ud_backgroundColor="@color/ud_button_blue_bg"
                    app:ud_radius="m"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/todo_lottie_loading_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_200"
            android:layout_centerInParent="true">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/todo_lottie_loading_anim"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_anim"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_caption"
                android:layout_gravity="center"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_DataLoadingNowPleaseWait_Text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/todo_loading_error_ll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_200"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/todo_error_iv"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                app:srcCompat="@drawable/illustration_placeholder_common_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center"
                android:id="@+id/todo_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Todo_Task_LoadFailedTryAgainLater"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
