<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deep_feed_net_error_container"
    android:background="#2b2f36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="252dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/deep_feed_net_error_image"
            android:layout_width="97dp"
            android:layout_height="110dp"
            android:src="@drawable/product_deep_feed_net_error_image"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/deep_feed_net_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="网络异常"
            android:textFontWeight="500"
            app:layout_constraintLeft_toLeftOf="@+id/deep_feed_net_error_image"
            app:layout_constraintRight_toRightOf="@+id/deep_feed_net_error_image"
            app:layout_constraintTop_toBottomOf="@+id/deep_feed_net_error_image"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99ffffff"
            android:gravity="center"
            android:id="@+id/deep_feed_net_error_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="请刷新界面"
            android:textFontWeight="400"
            app:layout_constraintLeft_toLeftOf="@+id/deep_feed_net_error_image"
            app:layout_constraintRight_toRightOf="@+id/deep_feed_net_error_image"
            app:layout_constraintTop_toBottomOf="@+id/deep_feed_net_error_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/deep_feed_net_error_text"
            android:background="@drawable/product_deep_feed_net_error_text_bg"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:text="刷新"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
