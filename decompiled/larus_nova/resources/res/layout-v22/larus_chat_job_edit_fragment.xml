<?xml version="1.0" encoding="utf-8"?>
<com.larus.chat.job.impl.page.edit.ChatJobDragDismissLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_neutral_transparent_4"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_content"
        android:background="@drawable/larus_chat_job_edit_root_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/larus_chat_job_edit_title_bar"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_52"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/larus_chat_job_edit_drag_handle"
                android:background="@drawable/larus_chat_job_edit_handle_bg"
                android:layout_width="?attr/larus_dp_36"
                android:layout_height="?attr/larus_dp_4"
                android:layout_marginTop="?attr/larus_dp_6"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/larus_chat_job_edit_close_button"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_close_dialog"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/larus_chat_job_edit_more_button"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:contentDescription="@string/larus_chat_job_edit_more_desc"
                android:layout_marginEnd="?attr/larus_dp_4">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/larus_chat_job_edit_more_icon"
                    android:background="@drawable/larus_chat_job_edit_top_button_bg"
                    android:layout_width="?attr/larus_dp_28"
                    android:layout_height="?attr/larus_dp_28"
                    android:scaleType="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/larus_chat_job_menu_more_ic"
                    app:tint="?attr/larus_neutral_50"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/larus_chat_job_edit_confirm_icon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    app:srcCompat="?attr/larus_ic_input_modify_confirm"/>
            </FrameLayout>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/larus_chat_job_edit_list"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_24"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:paddingHorizontal="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/larus_chat_job_edit_title_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_frequency_content"
        android:background="@drawable/larus_chat_job_edit_root_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/larus_chat_job_frequency_title_bar"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_52"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/larus_chat_job_frequency_close_button"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_close_dialog"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/larus_chat_job_frequency_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/larus_chat_job_frequency_confirm_button"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:layout_marginEnd="?attr/larus_dp_4">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/larus_chat_job_frequency_confirm_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    app:srcCompat="?attr/larus_ic_input_modify_confirm"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/larus_chat_job_frequency_confirm_progress"
                    android:background="@drawable/larus_chat_job_edit_confirm_bg_enabled"
                    android:padding="?attr/larus_dp_3"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_26"
                    android:layout_height="?attr/larus_dp_26"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/larus_static_white"
                    style="?android:attr/progressBarStyleSmall"/>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/larus_chat_job_frequency_body"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_24"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/larus_chat_job_frequency_title_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.chat.job.impl.page.edit.ChatJobDragDismissLayout>
