<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/settings_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="20dp"
    android:layout_marginHorizontal="16dp"
    app:dividerPaddingLeft="@dimen/dp_16"
    app:itemBackgroundColor="@color/facade_selector_item_float">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/access_public"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/access_public_check_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/access_public_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/access_public_title"
            app:srcCompat="@drawable/ud_icon_lock_outlined"
            app:tint="@color/icon_n2"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/facade_text_title_color_selector"
            android:ellipsize="end"
            android:id="@+id/access_public_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Docs_PrivateCmt_Private_Switch"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@+id/access_public_check_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/access_private_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/access_public_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/access_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/LarkCCM_Docs_PrivateCmt_PrivateOn_Descrip"
            android:layout_marginEnd="16dp"
            android:lineHeight="@dimen/space_kit_len_22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/access_public_check_icon"
            app:layout_constraintTop_toBottomOf="@+id/access_public_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
