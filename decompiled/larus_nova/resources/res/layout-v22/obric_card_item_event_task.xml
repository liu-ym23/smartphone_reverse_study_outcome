<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_12">
    <ImageView
        android:id="@+id/task_icon"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:src="@drawable/obric_card_event_task_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/run_task"
        android:background="@drawable/obric_card_event_task_run_button"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/obric_event_task_card_title"
        android:ellipsize="end"
        android:id="@+id/query"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:lineHeight="@dimen/dp_22"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/run_task"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/obric_event_task_card_secondary"
        android:ellipsize="end"
        android:id="@+id/period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:textFontWeight="400"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/query"/>
    <View
        android:id="@+id/condition_divider"
        android:background="@color/obric_event_task_card_divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/period"
        app:layout_constraintStart_toEndOf="@+id/period"
        app:layout_constraintTop_toTopOf="@+id/period"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/obric_event_task_card_secondary"
        android:ellipsize="end"
        android:id="@+id/condition"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/dp_8"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/condition_divider"
        app:layout_constraintTop_toTopOf="@+id/period"/>
</androidx.constraintlayout.widget.ConstraintLayout>
