<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/private_msg_container"
    android:background="@drawable/ttlive_mini_app_shelf_page_private_msg_container_bg"
    android:layout_width="match_parent"
    android:layout_height="63dp"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginHorizontal="8dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/private_msg_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/private_msg_avatar"
        app:layout_constraintRight_toRightOf="@+id/private_msg_avatar"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/private_msg_identity"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toRightOf="@+id/space"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/private_msg_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/private_msg_avatar"
        app:layout_constraintRight_toLeftOf="@+id/private_msg_btn"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80161823"
        android:ellipsize="end"
        android:id="@+id/private_msg_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/private_msg_title"
        app:layout_constraintRight_toLeftOf="@+id/private_msg_btn"
        app:layout_constraintTop_toBottomOf="@+id/private_msg_title"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/private_msg_btn"
        android:background="@drawable/ttlive_bg_miniapp_shelf_check_btn"
        android:layout_width="66dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:text="进入"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
