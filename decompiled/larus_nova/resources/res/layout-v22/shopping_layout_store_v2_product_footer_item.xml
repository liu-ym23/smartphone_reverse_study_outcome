<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.LoadMoreStatusView
        android:id="@+id/sv_product_load_more"
        android:layout_width="wrap_content"
        android:layout_height="44dp"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#999999"
        android:id="@+id/tt_more_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/shopping_load_more_hint"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/rl_product_no_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/shopping_std_text_black_4"
            android:id="@+id/tv_product_no_more"
            android:paddingTop="10dp"
            android:paddingBottom="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_store_has_shown_all_products"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/product_no_more_warrpe"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_std_text_black_4"
                android:id="@+id/product_no_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/store_to_shop_entrance"
            android:background="@drawable/shopping_shop_to_store_bottom_block"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginBottom="40dp"
            android:layout_below="@+id/product_no_more_warrpe"
            android:layout_centerHorizontal="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/store_to_shop_img"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <TextView
                android:textColor="@color/shopping_std_text_black_2"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/strore_or_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_store_commerce_go_store_v3"
                android:layout_marginStart="2dp"
                style="@style/font_size_28"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/shopping_std_text_black_3"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/tv_product_footer_publicity"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="32dp"
            style="@style/font_size_24"/>
    </RelativeLayout>
</LinearLayout>
