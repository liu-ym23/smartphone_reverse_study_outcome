<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_icon"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_left_back"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/larus_neutral_100"/>
    <ImageView
        android:id="@+id/search_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/obric_ic_chat_title_search"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/larus_neutral_100"/>
    <com.larus.common_ui.widget.RedDotTextView
        android:textSize="?attr/larus_dp_12"
        android:textStyle="bold"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/chat_title_red_dot"
        android:background="@drawable/larus_red_dot_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_30"
        app:layout_constraintBottom_toBottomOf="@+id/back_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_58"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/back_icon"
        app:layout_constraintEnd_toStartOf="@+id/main_container_end_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_icon">
        <com.larus.bmhome.view.TitleAvatarImageView
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_4"
            android:textFontWeight="600"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintEnd_toStartOf="@+id/tag"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_11"
            android:textColor="@color/larus_primary_50"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tag"
            android:background="@drawable/larus_bg_chat_title_tag"
            android:paddingLeft="?attr/larus_dp_6"
            android:paddingTop="?attr/larus_dp_3"
            android:paddingRight="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_4"
            android:paddingHorizontal="?attr/larus_dp_6"
            android:paddingVertical="?attr/larus_dp_3"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:srcCompat="@drawable/larus_ic_text_right_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_30"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/obric_chat_multi_tab_title_bg"
        app:tabIndicatorColor="@color/larus_neutral_100"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabPaddingEnd="?attr/larus_dp_12"
        app:tabPaddingStart="?attr/larus_dp_12"
        app:tabRippleColor="@null"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/main_container_start_barrier"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="?attr/larus_dp_96"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/main_container_end_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/min_end_space"
        android:layout_width="?attr/larus_dp_96"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_history"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/obric_ic_history_close"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/real_time_call_ic_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="?attr/larus_dp_4"/>
    <FrameLayout
        android:id="@+id/real_time_call_ic_container"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/create_new_cvs"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/real_time_call"
            android:visibility="visible"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/obric_ic_realtime_call_chat"
            android:contentDescription="@string/larus_accessibility_icon_call"/>
        <TextView
            android:textSize="?attr/larus_sp_8"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/real_time_call_red_dot"
            android:background="@drawable/larus_red_dot_bg_large"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_8"
            android:layout_marginTop="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_10"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/create_new_cvs"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_main_menu_create_bot"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tts"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/tts"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_tts_disable"
        android:scaleType="centerInside"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/more_add_bot"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tts_continuous_talk"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_tts_disable"
        android:scaleType="centerInside"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/more_add_bot"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/more_add_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/more"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_ic_bot_setting"
            android:contentDescription="@string/larus_accessibility_icon_settings"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/add_bot"
            android:padding="?attr/larus_dp_9"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/ic_bot_add"/>
    </FrameLayout>
</merge>
