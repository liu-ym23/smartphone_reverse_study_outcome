<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expand_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.bmhome.chat.layout.holder.progressloading.ImageWebpLoadingBgView
            android:id="@+id/iv_ppt_preview_animation"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_194"
            android:scaleType="centerCrop"
            android:maxWidth="?attr/larus_dp_340"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:id="@+id/layout_ppt_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ppt_preview_animation"
            app:layout_constraintCircleRadius="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="@+id/iv_ppt_preview_animation"
            app:layout_constraintStart_toStartOf="@+id/iv_ppt_preview_animation"
            app:layout_constraintTop_toTopOf="@+id/iv_ppt_preview_animation">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_ppt_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="@drawable/larus_place_holder_ppt_generation"
                app:placeholderImageScaleType="centerCrop"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/layout_ppt_generating"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_ppt_generating"
                    android:layout_width="?attr/larus_dp_40"
                    android:layout_height="?attr/larus_dp_40"
                    android:src="@drawable/larus_ic_ppt_generating"
                    app:tint="?attr/larus_neutral_transparent_3"/>
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="?attr/larus_neutral_transparent_3"
                    android:id="@+id/tv_ppt_generating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_slides_push_header_generating"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="500"/>
            </LinearLayout>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_small_ppt_generation"
            android:background="@drawable/larus_place_holder_ppt_generation"
            android:paddingLeft="?attr/larus_dp_14"
            android:paddingRight="?attr/larus_dp_14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_50"
            android:paddingHorizontal="?attr/larus_dp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_officecard_ic_ppt_generation_orange"/>
            <TextView
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_small_ppt_generation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_8"
                android:textFontWeight="500"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
