<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/larus_base_2"
        app:rv_cornerRadius_TL="?attr/larus_dp_24"
        app:rv_cornerRadius_TR="?attr/larus_dp_24">
        <ImageView
            android:id="@+id/dora_onboarding_close_btn"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_14"
            android:src="@drawable/larus_dora_onboarding_close_btn"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_350"
            android:layout_marginTop="?attr/larus_dp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_24"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_onboarding_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_onboarding_device_found_cn"
                android:textFontWeight="600"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_onboarding_device_mv_layout"
                android:layout_width="?attr/larus_dp_326"
                android:layout_height="?attr/larus_dp_236"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_title">
                <com.larus.dora.impl.view.DoraMovieView
                    android:layout_gravity="center"
                    android:id="@+id/dora_onboarding_device_mv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_title"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/dora_onboarding_connect_btn"
                android:background="@drawable/larus_dora_btn_bg"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_32"
                android:text="@string/larus_dora_onboarding_connect_cn"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_device_mv_layout"
                app:layout_constraintWidth_max="?attr/larus_dp_420"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/dora_onboarding_connecting"
                android:paddingLeft="?attr/larus_dp_32"
                android:paddingRight="?attr/larus_dp_32"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginTop="?attr/larus_dp_12"
                android:paddingHorizontal="?attr/larus_dp_32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_device_mv_layout">
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:indeterminateDrawable="@drawable/larus_dora_loading"
                    android:indeterminateDuration="750"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_50"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_onboarding_connecting_cn"
                    android:layout_marginStart="?attr/larus_dp_5"
                    android:textFontWeight="500"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
