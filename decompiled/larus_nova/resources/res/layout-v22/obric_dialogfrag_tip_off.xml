<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_52"
        app:rv_backgroundColor="?attr/larus_base_3_overlay"
        app:rv_cornerRadius_TL="?attr/larus_dp_24"
        app:rv_cornerRadius_TR="?attr/larus_dp_24">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_18"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_neutral_100"
                    android:id="@+id/dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_feedback_submit_header"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_10"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dialog_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_close"
                android:padding="?attr/larus_dp_6"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:src="?attr/larus_ic_close"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </FrameLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <com.larus.common_ui.widget.MaxHeightScrollView
            android:id="@+id/content_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="?attr/larus_dp_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginRight="?attr/larus_dp_16"
                android:layout_marginHorizontal="?attr/larus_dp_16">
                <com.obric.assistant.view.ObricFlowTagLayout
                    android:id="@+id/flow_tag_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"/>
                <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                    android:id="@+id/input_container"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_140"
                    android:layout_marginTop="?attr/larus_dp_12"
                    app:rv_backgroundColor="?attr/larus_base_4"
                    app:rv_cornerRadius="?attr/larus_dp_16">
                    <com.larus.common_ui.widget.NestedScrollEditText
                        android:textSize="?attr/larus_dp_17"
                        android:textColorHint="@color/larus_neutral_30"
                        android:gravity="start|top"
                        android:id="@+id/et_input"
                        android:background="@null"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="?attr/larus_dp_16"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:layout_marginRight="?attr/larus_dp_16"
                        android:layout_marginBottom="?attr/larus_dp_12"
                        android:maxLength="500"
                        android:overScrollMode="always"
                        android:layout_marginHorizontal="?attr/larus_dp_16"
                        android:layout_marginVertical="?attr/larus_dp_12"
                        android:textFontWeight="400"
                        style="@style/larus_EditTextStyle"/>
                </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/feedback_score_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/feedback_score_row"
                        android:padding="?attr/larus_dp_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.common_ui.widget.roundlayout.RoundTextView
                            android:textSize="?attr/larus_sp_16"
                            android:textColor="?attr/larus_neutral_70"
                            android:gravity="center"
                            android:id="@+id/feedback_score_1"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="?attr/larus_dp_38"
                            android:layout_weight="1"
                            app:rv_cornerRadius="?attr/larus_dp_12"
                            app:rv_isRippleEnable="false"
                            app:rv_strokeColor="?attr/larus_neutral_transparent_2"
                            app:rv_strokeWidth="?attr/larus_dp_1"/>
                        <com.larus.common_ui.widget.roundlayout.RoundTextView
                            android:textSize="?attr/larus_sp_16"
                            android:textColor="?attr/larus_neutral_70"
                            android:gravity="center"
                            android:id="@+id/feedback_score_2"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="?attr/larus_dp_38"
                            android:layout_weight="1"
                            android:layout_marginStart="?attr/larus_dp_8"
                            app:rv_cornerRadius="?attr/larus_dp_12"
                            app:rv_isRippleEnable="false"
                            app:rv_strokeColor="?attr/larus_neutral_transparent_2"
                            app:rv_strokeWidth="?attr/larus_dp_1"/>
                        <com.larus.common_ui.widget.roundlayout.RoundTextView
                            android:textSize="?attr/larus_sp_16"
                            android:textColor="?attr/larus_neutral_70"
                            android:gravity="center"
                            android:id="@+id/feedback_score_3"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="?attr/larus_dp_38"
                            android:layout_weight="1"
                            android:layout_marginStart="?attr/larus_dp_8"
                            app:rv_cornerRadius="?attr/larus_dp_12"
                            app:rv_isRippleEnable="false"
                            app:rv_strokeColor="?attr/larus_neutral_transparent_2"
                            app:rv_strokeWidth="?attr/larus_dp_1"/>
                        <com.larus.common_ui.widget.roundlayout.RoundTextView
                            android:textSize="?attr/larus_sp_16"
                            android:textColor="?attr/larus_neutral_70"
                            android:gravity="center"
                            android:id="@+id/feedback_score_4"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="?attr/larus_dp_38"
                            android:layout_weight="1"
                            android:layout_marginStart="?attr/larus_dp_8"
                            app:rv_cornerRadius="?attr/larus_dp_12"
                            app:rv_isRippleEnable="false"
                            app:rv_strokeColor="?attr/larus_neutral_transparent_2"
                            app:rv_strokeWidth="?attr/larus_dp_1"/>
                        <com.larus.common_ui.widget.roundlayout.RoundTextView
                            android:textSize="?attr/larus_sp_16"
                            android:textColor="?attr/larus_neutral_70"
                            android:gravity="center"
                            android:id="@+id/feedback_score_5"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="?attr/larus_dp_38"
                            android:layout_weight="1"
                            android:layout_marginStart="?attr/larus_dp_8"
                            app:rv_cornerRadius="?attr/larus_dp_12"
                            app:rv_isRippleEnable="false"
                            app:rv_strokeColor="?attr/larus_neutral_transparent_2"
                            app:rv_strokeWidth="?attr/larus_dp_1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingLeft="?attr/larus_dp_12"
                        android:paddingRight="?attr/larus_dp_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="?attr/larus_dp_12">
                        <TextView
                            android:textSize="?attr/larus_sp_12"
                            android:textColor="?attr/larus_neutral_50"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="wrap_content"
                            android:text="@string/obric_task_feedback_rating_min"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="?attr/larus_sp_12"
                            android:textColor="?attr/larus_neutral_50"
                            android:gravity="end"
                            android:layout_width="?attr/larus_dp_0"
                            android:layout_height="wrap_content"
                            android:text="@string/obric_task_feedback_rating_max"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/gui_log_checkbox_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10">
                    <com.obric.oui.checkbox.OCheckBoxLayout
                        android:id="@+id/gui_log_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="@color/dark_color_black"
                        android:id="@+id/gui_log_checkbox_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:text="@string/obric_omni_feedback_log_tip"
                        android:layout_alignParentTop="true"
                        android:layout_toEndOf="@+id/gui_log_checkbox"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <FrameLayout
                    android:id="@+id/experience_plan_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.larus.common_ui.widget.MaxHeightScrollView>
        <View
            android:id="@+id/content_scroll_divider"
            android:background="?attr/larus_neutral_transparent_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_13"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:text="@string/larus_dislike_feedback_submit"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_16"/>
    </com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
</FrameLayout>
