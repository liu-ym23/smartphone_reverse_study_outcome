<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.blockit.hashtag.widget.SwipeLayout
        android:id="@+id/subtask_swipelayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="right"
            android:id="@+id/behind_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center">
            <RelativeLayout
                android:id="@+id/behind_delete_view"
                android:background="@drawable/todo_bg_list_backend_red_corner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/behind_delete_view_image"
                        android:layout_width="20sp"
                        android:layout_height="20sp"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:src="@drawable/ud_icon_delete_trash_outlined"
                        android:tint="@color/static_white"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/static_white"
                        android:id="@+id/behind_delete_view_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_4"
                        android:layout_marginRight="@dimen/dp_20"
                        android:text="@string/Todo_common_Delete"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/subtask_content_container"
            android:background="@color/bg_body"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:layout_marginEnd="@dimen/dp_12">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/first_line_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16sp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtask_check_box"
                    android:padding="@dimen/dp_6"
                    android:layout_width="32sp"
                    android:layout_height="32sp"
                    android:src="@drawable/todo_svg_icon_uncheck_new"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtask_check_box_lottie"
                    android:visibility="gone"
                    android:layout_width="32sp"
                    android:layout_height="32sp"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp_4"
                    layout="@layout/todo_detail_subtask_summary2"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/subtask_time_icon"
                    android:padding="6sp"
                    android:layout_width="32sp"
                    android:layout_height="32sp"
                    android:tint="@color/ud_N500"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginEnd="@dimen/dp_4"
                    app:srcCompat="@drawable/ud_icon_calendar_date_outlined"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/subtask_owner_icon"
                    android:padding="6sp"
                    android:layout_width="32sp"
                    android:layout_height="32sp"
                    android:tint="@color/ud_N500"
                    app:srcCompat="@drawable/ud_icon_member_add_outlined"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/subtask_owner_avatar_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_32"
                    android:layout_marginStart="@dimen/dp_4">
                    <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                        android:id="@+id/avatar_list_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:task_ud_avatarList_maxCount="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/subtask_time_container"
                android:paddingLeft="16sp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_32">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/subtask_time_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:paddingEnd="@dimen/dp_8"/>
                <ImageView
                    android:id="@+id/subtask_reminder_icon"
                    android:layout_width="12sp"
                    android:layout_height="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ud_icon_bell_outlined"
                    android:tint="@color/icon_n2"
                    android:layout_marginVertical="4dp"/>
                <ImageView
                    android:id="@+id/subtask_repeat_icon"
                    android:layout_width="12sp"
                    android:layout_height="12sp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ud_icon_repeat_outlined"
                    android:tint="@color/icon_n2"/>
                <ImageView
                    android:id="@+id/subtask_time_delete_icon"
                    android:layout_width="12sp"
                    android:layout_height="12sp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ud_icon_close_outlined"
                    android:tint="@color/icon_n2"/>
            </LinearLayout>
        </LinearLayout>
    </com.larksuite.component.blockit.hashtag.widget.SwipeLayout>
</LinearLayout>
