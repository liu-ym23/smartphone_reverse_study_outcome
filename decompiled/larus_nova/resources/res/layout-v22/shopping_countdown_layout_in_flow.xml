<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/shopping_countdown_layout_in_flow_1074885434"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:gravity="center"
        android:id="@+id/activity_countdown_day"
        android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:gravity="center"
        android:id="@+id/activity_countdown_day_label"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:text="@string/ec_anchor_v4_activity_countdown_day_label"
        android:includeFontPadding="false"
        android:paddingHorizontal="2dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:gravity="center"
        android:id="@+id/activity_countdown_hours"
        android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:id="@+id/activity_countdown_category_between_hours_and_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_marginBottom="1dp"
        android:text="@string/ec_commerce_anchor_v4_colon"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:gravity="center"
        android:id="@+id/activity_countdown_min"
        android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:id="@+id/activity_countdown_category_between_min_and_sec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_marginBottom="1dp"
        android:text="@string/ec_commerce_anchor_v4_colon"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/BGReverse"
        android:gravity="center"
        android:id="@+id/activity_countdown_sec"
        android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"/>
</LinearLayout>
