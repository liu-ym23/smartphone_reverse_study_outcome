<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/anchor_v4_shop_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
        android:id="@+id/anchor_v4_shop_ambient_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
        android:id="@+id/anchor_v4_shop_ambient_slogan"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_shop_ambient_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/anchor_v4_shop_ambient_title"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v4_shop_ambient_shading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v4_ll_shop_info"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor_v4_shop_ambient_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/anchor_v4_shop_cl_shop_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/anchor_v4_ibv_shop_avatar_live"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:autoPlayAnimation="true"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintEnd_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintStart_toStartOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.MediaBoxElementView
                android:id="@+id/anchor_v4_ibv_shop_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:layout_marginStart="13dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/anchor_v4_ibv_shop_avatar_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintEnd_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintStart_toStartOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_ibv_shop_avatar_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintStart_toStartOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
                android:id="@+id/anchor_v4_supermarket_icon_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <com.bytedance.android.ec.core.widget.RoundedFrameLayout
                android:id="@+id/anchor_v4_avatar_mask"
                android:background="@color/commerce_color_08161823"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintEnd_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintStart_toStartOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintEnd_toEndOf="@+id/anchor_v4_ibv_shop_avatar">
                <View
                    android:id="@+id/anchor_v4_shop_live_or_douyin_view_bg"
                    android:background="@drawable/anchor_v4_live_or_douyin_icon_stroke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/anchor_v4_shop_live_or_douyin_view_holder"
                    android:padding="0.5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                        android:id="@+id/anchor_v4_shop_live_or_douyin_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </FrameLayout>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_tiv_shop_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/anchor_v4_tiv_jump_to_shop"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_tiv_supermarket_slogan"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_tiv_shop_name"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                android:id="@+id/anchor_v4_supermarket_sales"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_tiv_supermarket_slogan"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                android:id="@+id/anchor_v4_supermarket_distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/commerce_anchor_v4_shop_supermarket_divide_line"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_supermarket_sales"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_supermarket_sales"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_supermarket_sales"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_tiv_jump_to_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/anchor_v4_ibv_shop_avatar"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.IconsWithSpaceElementView
                android:id="@+id/anchor_v4_iws_trust_pics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_tiv_shop_name"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anchor_v4_ll_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_iws_trust_pics">
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                    android:id="@+id/anchor_v4_shop_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                    android:id="@+id/anchor_v4_tv_shop_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:id="@+id/anchor_v4_ll_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
                <View
                    android:id="@+id/anchor_v4_shop_divider"
                    android:background="@color/commerce_color_14161823"
                    android:layout_width="1dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                    android:id="@+id/anchor_v4_tv_shop_peers_exceeded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/anchor_v4_icons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/anchor_v4_tiv_jump_to_shop"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_ll_score">
                <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                    android:id="@+id/anchor_v4_icons_and_fans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                    android:id="@+id/anchor_v4_shop_score_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                    android:id="@+id/anchor_v4_shop_score_text"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_shop_score_icons"
                    app:layout_constraintStart_toEndOf="@+id/anchor_v4_shop_score_icons"
                    app:layout_constraintTop_toTopOf="@+id/anchor_v4_shop_score_icons"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anchor_v4_follow_sales_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@+id/anchor_v4_ibv_shop_avatar"
                app:layout_constraintTop_toBottomOf="@+id/anchor_v4_icons">
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                    android:id="@+id/anchor_v4_detail_main_info_score"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                    android:id="@+id/anchor_v4_detail_main_info_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"/>
                <View
                    android:id="@+id/anchor_v4_detail_main_info_divider"
                    android:background="#57161823"
                    android:layout_width="0.5dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:layout_marginStart="4dp"/>
                <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                    android:id="@+id/anchor_v4_detail_main_info_sell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/anchor_v4_ll_shop_reputation"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/anchor_v4_ll_shop_follower_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <View
                android:id="@+id/anchor_v4_shop_rep_divider1"
                android:background="@color/color_14161823"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/anchor_v4_ll_shop_sell_num"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <View
                android:id="@+id/anchor_v4_shop_rep_divider2"
                android:background="@color/color_14161823"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/anchor_v4_ll_shop_sub_score"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.LynxCardView
            android:id="@+id/store_reputation_lynx_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <View
            android:id="@+id/anchor_v4_shop_rank_list_divider"
            android:background="#0d161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
            android:id="@+id/anchor_v4_shop_rank_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:id="@+id/anchor_v4_shop_promotion_info_divider"
            android:background="#0d161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
            android:id="@+id/anchor_v4_shop_promotion_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:id="@+id/anchor_v4_ll_shop_extra_divider"
            android:background="#0d161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v4_ll_shop_extra"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor_v4_ll_shop_info">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
            android:id="@+id/anchor_v4_shop_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
            android:id="@+id/anchor_v4_shop_recommend_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <com.bytedance.android.shopping.anchorv3.view.AnchorV3RecInShopBoxView
            android:id="@+id/anchor_v4_bv_rec_in_shop"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
