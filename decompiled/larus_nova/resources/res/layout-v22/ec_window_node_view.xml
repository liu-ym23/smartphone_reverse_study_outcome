<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#ffffff"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    app:rounded_radius="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/window_node_author_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:id="@+id/window_node_author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/window_node_author_avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/window_node_info_ll"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginBottom="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="90dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/window_node_author_avatar">
            <com.bytedance.android.ui.base.widget.round.RoundTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:id="@+id/following_tip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_you_are_following"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="3dp"
                app:bg_color="#fff3f4f4"
                app:bg_cornerRadius="2dp"/>
            <com.bytedance.android.ui.base.widget.round.RoundTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:id="@+id/reco_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.bytedance.android.ui.base.widget.round.RoundTextView
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/window_node_button"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:text="@string/commerce_go_window"
            app:bg_color="#0d161823"
            app:bg_cornerRadius="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/images_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">
        <com.bytedance.android.shopping.feed.resourcecard.view.ImageWithPrice
            android:id="@+id/image_view_1"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/image_view_2"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.feed.resourcecard.view.ImageWithPrice
            android:id="@+id/image_view_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            app:layout_constraintLeft_toRightOf="@+id/image_view_1"
            app:layout_constraintRight_toLeftOf="@+id/image_view_3"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.feed.resourcecard.view.ImageWithPrice
            android:id="@+id/image_view_3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            app:layout_constraintLeft_toRightOf="@+id/image_view_2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.ec.core.widget.RoundedLinearLayout>
