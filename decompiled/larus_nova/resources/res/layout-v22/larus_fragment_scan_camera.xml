<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surfaceView_camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/preview_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/video_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/top_mask"
        android:background="@drawable/larus_digital_avatar_scan_top_mask"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_280"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.avatar.impl.scan.view.ScanCameraTutorialView
        android:id="@+id/tutorial_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/back_btn_container"
        android:layout_width="@dimen/dp_44"
        android:layout_height="@dimen/dp_44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/back_btn"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:tint="@color/larus_static_white"/>
    </FrameLayout>
    <View
        android:id="@+id/btn_mask"
        android:background="@drawable/larus_digital_avatar_scan_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_206"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_container"
        android:background="@drawable/larus_digital_avatar_scan_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        app:layout_constraintBottom_toBottomOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/btn_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_digital_avatar_scan_loading_animated"
            android:indeterminateDuration="2000"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_black"
            android:ellipsize="end"
            android:id="@+id/btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_replica_video_btn_record"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/go_upload_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_22"
        app:layout_constraintBottom_toTopOf="@+id/btn_container">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/go_upload_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_replica_video_sug_addPics"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
        <ImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/larus_chevron_left_center_fill"
            app:tint="@color/larus_static_white"/>
    </LinearLayout>
    <com.larus.avatar.impl.scan.view.ScanCameraBeautyButton
        android:id="@+id/beauty_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginBottom="?attr/larus_dp_36"
        app:layout_constraintBottom_toTopOf="@+id/btn_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
