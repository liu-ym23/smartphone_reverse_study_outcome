<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_share_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginBottom="?attr/larus_dp_6">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_cici_share_btn"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/share_dialog_close"
            android:padding="?attr/larus_dp_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_share_dialog_close"
            android:layout_marginEnd="?attr/larus_dp_6"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tips_container"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingRight="?attr/larus_dp_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:paddingHorizontal="?attr/larus_dp_20">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tips_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/tips_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_8"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/tips_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="?attr/larus_dp_4"
                android:letterSpacing="0.02"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textStyle="bold"
                android:textColor="?attr/larus_primary_50"
                android:gravity="end"
                android:id="@+id/tips_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <View
            android:id="@+id/tips_divider"
            android:background="?attr/larus_neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_5"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rl_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larus.common_ui.widget.MaxWidthRecyclerView
        android:id="@+id/rl_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_16"/>
</LinearLayout>
