<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sort_panel"
    android:tag="sort"
    android:background="@color/bg_float_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larksuite.component.universe_design.notice.UDNotice
            android:id="@+id/notice"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_kit_len_16"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginRight="@dimen/space_kit_len_16"
            android:layout_marginHorizontal="@dimen/space_kit_len_16"
            app:ud_notice_backgroundColor="@color/function_info_fill_solid_02"
            app:ud_notice_icon="@drawable/ud_icon_info_colorful"
            app:ud_notice_iconColorful="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sort_info_container"
            android:padding="@dimen/space_kit_len_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/autosort_container"
                android:background="@drawable/facade_round_around_xl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:layout_marginBottom="@dimen/space_kit_len_10"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16"
                android:backgroundTint="@color/bg_float">
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Record_AutomaticSort"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <com.bytedance.ee.bear.bitable.common.widgets.common.AllowClickInDisableUDSwitch
                    android:id="@+id/autosort_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_marginStart="@dimen/space_kit_len_16"/>
            </LinearLayout>
            <com.bytedance.ee.bear.bitable.common.widgets.conditioncard.ConditionListView
                android:id="@+id/sort_conditions_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/empty_state"
            android:visibility="gone"
            app:ud_empty_desc="@string/Bitable_Record_NoSortCondition"
            app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_content"
            style="@style/SpaceEmptyStatusStyle"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
