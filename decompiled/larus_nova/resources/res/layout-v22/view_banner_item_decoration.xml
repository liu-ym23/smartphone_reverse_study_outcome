<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/tv_banner_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="68dp"
        android:layout_marginRight="68dp"
        android:text="@string/Lark_IM_UpgradePlanMoreStorage_Title"
        android:layout_marginHorizontal="68dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_placeholder"
        android:gravity="center"
        android:id="@+id/tv_banner_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="20dp"/>
    <RelativeLayout
        android:id="@+id/rl_banner_upgrade_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <View
            android:id="@+id/v_line_left"
            android:background="@drawable/chat_window_banner_gradient_right_to_left_label"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/ll_banner_upgrade"/>
        <View
            android:id="@+id/v_line_right"
            android:background="@drawable/chat_window_banner_gradient_left_to_right_label"
            android:layout_width="124dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/ll_banner_upgrade"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_banner_upgrade"
            android:background="@drawable/bg_btn_banner_upgrade"
            android:paddingLeft="13dp"
            android:paddingTop="4dp"
            android:paddingRight="13dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:paddingHorizontal="13dp"
            android:paddingVertical="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ud_icon_start_filled"
                app:tint="@color/inverse_primary_content_default"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_IM_FreePlanHiddenOlderMsgUpgrade_Button"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
