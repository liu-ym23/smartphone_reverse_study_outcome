<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.venus.ShapeLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="?attr/larus_dp_172"
        android:layout_height="?attr/larus_dp_61"
        app:larus_sc_cornerRadius="?attr/larus_dp_22"
        app:larus_sc_fillColor="@color/larus_base_3"
        app:larus_sc_shadow_blur_radius="?attr/larus_dp_8"
        app:larus_sc_shadow_color="#0f000000"
        app:larus_sc_shadow_dx="?attr/larus_dp_0"
        app:larus_sc_shadow_dy="?attr/larus_dp_2"
        app:larus_sc_strokeColor="@color/neutral_transparent_1"
        app:larus_sc_strokeWidth="?attr/larus_dp_1">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/doc_copy_all_btn"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_45"
            android:layout_marginTop="?attr/larus_dp_6"
            android:paddingHorizontal="?attr/larus_dp_12">
            <ImageView
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_docbiz_ic_doc_copy_all"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_aiDoc_selectText_copy"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <View
            android:id="@+id/copy_edit_divider"
            android:background="@color/larus_neutral_transparent_3"
            android:layout_width="?attr/larus_dp_0_5"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_21"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/doc_edit_all"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_45"
            android:layout_marginTop="?attr/larus_dp_6"
            android:paddingHorizontal="?attr/larus_dp_12">
            <ImageView
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_doc_ic_edit"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_imageDetail_btn_edit"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
    </com.larus.common_ui.venus.ShapeLinearLayout>
</FrameLayout>
