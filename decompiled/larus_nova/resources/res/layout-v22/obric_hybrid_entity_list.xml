<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/larus_base_2_overlay"
    app:rv_cornerRadius="@dimen/dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_42">
        <ImageView
            android:gravity="center"
            android:id="@+id/icon"
            android:background="@drawable/obric_bg_round_4"
            android:visibility="gone"
            android:layout_width="@dimen/dp_17"
            android:layout_height="@dimen/dp_17"
            android:src="@drawable/obric_ic_card_app_lark_rectangle"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_17"
            android:clipToOutline="true"/>
        <TextView
            android:textSize="@dimen/dp_13"
            android:textColor="@color/neutral_70"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/app_name"
            android:visibility="gone"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp_7"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_70"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16"/>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="@color/neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_below="@+id/title_container"/>
    <com.larus.bmhome.chat.layout.widget.AtMostHeightRecyclerView
        android:id="@+id/entity_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/obric_btn_confirm"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_weight="1"
        android:layout_below="@+id/entity_list"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:rv_backgroundColor="@color/obric_card_delete_bg_n"
        app:rv_backgroundPressColor="@color/obric_card_delete_bg_p"
        app:rv_cornerRadius="@dimen/dp_8"
        app:rv_isRippleEnable="false">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/obric_card_delete_text"
            android:layout_gravity="center"
            android:id="@+id/obric_btn_confirm_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/view_all"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_below="@+id/obric_btn_confirm"
        android:paddingHorizontal="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/view_all_text"
            android:background="@drawable/obric_bg_btn_all_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:text="@string/obric_intent_view_all"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
    </LinearLayout>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
