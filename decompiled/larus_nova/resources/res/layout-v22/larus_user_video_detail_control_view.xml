<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.video.progress.PlayerProgressView
        android:id="@+id/player_progress"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_50"
        android:paddingHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/op_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/op_container"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_68"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/download_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ic_download"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_ic_download_white_filled"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/download_inner_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
                android:indeterminateDuration="2000"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/share_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginStart="?attr/larus_dp_8">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ic_share"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_ic_share_white_filled"/>
        </FrameLayout>
    </LinearLayout>
</merge>
