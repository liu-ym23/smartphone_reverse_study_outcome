<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_sku_installment_item"
    android:layout_width="120dp"
    android:layout_height="58dp"
    android:layout_marginRight="8dp"
    android:layout_marginEnd="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_sku_installment_item"
        android:background="@drawable/shopping_bg_sku_installment_unselected"
        android:layout_width="@dimen/shopping_sku_installment_item_width"
        android:layout_height="@dimen/shopping_sku_installment_item_height">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shopping_std_text_black_2"
            android:gravity="center_horizontal"
            android:id="@+id/tv_sku_installment_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/shopping_std_text_black_2"
            android:gravity="center_horizontal"
            android:id="@+id/tv_sku_installment_service_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sku_installment_info_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/shopping_std_brand"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/tv_sku_installment_benefit"
        android:background="@drawable/shopping_bg_sku_installment_benefit_unable"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:paddingHorizontal="4dp"/>
</FrameLayout>
