<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.dynamic.widget.HistoryDeviceNavigationBar
        android:id="@+id/device_nav_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_main_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tv_title"
        android:layout_below="@+id/device_nav_bar">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_main_image"
            android:layout_width="?attr/larus_dp_325"
            android:layout_height="?attr/larus_dp_325"
            app:actualImageScaleType="fitCenter"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/tv_device_found"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_54"
        android:layout_above="@+id/tv_title"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textColor="@color/neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="16dp"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_4"
        android:text=""
        android:layout_above="@+id/tv_description"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="8dp"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_30"
        android:text=""
        android:layout_above="@+id/btn_bind_ll"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_bind_ll"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_50"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="?attr/larus_dp_16">
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_bind_pb"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminateDrawable="@drawable/larus_dora_progressbar_loading"
            android:indeterminateDuration="750"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_bind_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_onboarding_connecting_cn"
            android:layout_marginStart="?attr/larus_dp_5"
            android:textFontWeight="500"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
