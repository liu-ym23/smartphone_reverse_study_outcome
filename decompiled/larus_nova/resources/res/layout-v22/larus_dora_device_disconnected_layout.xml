<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_28"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/dora_disconnected_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_91"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/dora_disconnected_state_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_disconnected_text_view">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_8"
            android:src="@drawable/larus_dora_ic_device_disconnected_dot"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_device_disconnected_state_cn"
            android:layout_marginStart="?attr/larus_dp_8"
            android:textFontWeight="400"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dora_disconnected_image_view"
        android:layout_width="?attr/larus_dp_390"
        android:layout_height="?attr/larus_dp_390"
        android:layout_marginTop="?attr/larus_dp_24"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_disconnected_state_layout"/>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_74"
        android:src="@drawable/larus_image_onboarding_popup_headphone_shadow"
        app:layout_constraintBottom_toBottomOf="@+id/dora_disconnected_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/dora_disconnected_bottom_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_48"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        android:paddingHorizontal="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="?attr/larus_dp_420">
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/dora_disconnected_progress_bar"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminateDrawable="@drawable/larus_dora_device_disconnect_retrying"
            android:indeterminateDuration="750"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dora_disconnected_bottom_text_view"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/dora_disconnected_bottom_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_onboarding_connecting_cn"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_5"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dora_disconnected_progress_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
