<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_dora_card_white_rounded"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_16"
    android:layout_marginBottom="?attr/larus_dp_24"
    android:layout_marginHorizontal="?attr/larus_dp_16">
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_g_device_more_play_cn"
        android:textFontWeight="500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_text">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_device_more_option_cn"
            android:textFontWeight="400"/>
        <ImageView
            android:layout_width="?attr/larus_dp_12"
            android:layout_height="?attr/larus_dp_12"
            android:src="@drawable/larus_dora_g_device_management_more_icon"/>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/sub_title_text"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_dora_g_device_intro_function_cn"
        android:lineSpacingExtra="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        app:layout_constraintBottom_toBottomOf="@+id/sub_title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sub_title_text"
        app:srcCompat="@null"/>
</androidx.constraintlayout.widget.ConstraintLayout>
