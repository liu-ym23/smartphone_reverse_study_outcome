<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/live_page_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/random_match_btn"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/rank_locked_img"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:src="@drawable/ttlive_bg_season_rank_unlock"
                android:scaleType="centerCrop"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/ttlive_bg_season_rank_unlock"
                app:placeholderImageScaleType="centerCrop"/>
            <LinearLayout
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:background="@drawable/ttlive_rank_new_locked_tips"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:drawableLeft="@drawable/ttlive_rank_new_lock"
                android:paddingHorizontal="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/rank_locked_img"
                app:layout_constraintLeft_toLeftOf="@+id/rank_locked_img"
                app:layout_constraintRight_toRightOf="@+id/rank_locked_img"
                app:layout_constraintTop_toTopOf="@+id/rank_locked_img">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ttlive_rank_new_lock"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#161823"
                    android:id="@+id/rank_locked_img_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="尚未解锁段位赛"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/rank_new_season_label"
                android:background="@drawable/ttlive_pk_rank_new_season_label_bg"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="72dp"
                android:layout_height="21dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="18dp"
                android:text="全新赛季 &gt;"
                android:layout_marginStart="28dp"
                android:paddingHorizontal="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rank_locked_img"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#000000"
                android:id="@+id/rank_new_title"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="10dp"
                android:text="赢积分升段位，成为PK王者"
                android:layout_marginStart="28dp"
                android:textFontWeight="600"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rank_new_season_label"/>
            <FrameLayout
                android:id="@+id/rank_progress_container"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="28dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rank_new_title">
                <View
                    android:id="@+id/rank_progress"
                    android:background="@drawable/ttlive_rank_new_unlock_progress"
                    android:layout_width="100dp"
                    android:layout_height="3dp"/>
                <View
                    android:id="@+id/rank_progress_bg"
                    android:background="@drawable/ttlive_rank_new_unlock_progress_bg"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"/>
            </FrameLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#7f161823"
                android:id="@+id/rank_unlock_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="4dp"
                android:text="完成5场资格赛（PK值&gt;299）获得青铜段位"
                android:layout_marginStart="28dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rank_progress_container"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#7f161823"
                android:id="@+id/rank_unlock_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="28dp"
                android:text="3/5"
                android:layout_marginEnd="28dp"
                android:textFontWeight="600"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rank_progress_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/random_match_btn"
        android:background="@drawable/ttlive_bg_live_random_btn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="55dp"
        android:text="发起匹配"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintCircleRadius="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
