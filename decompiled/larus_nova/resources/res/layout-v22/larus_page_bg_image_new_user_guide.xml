<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/top_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_title"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_16"/>
    <TextView
        android:textSize="?attr/larus_sp_22"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:text="@string/larus_onboarding_chat_bg_header"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:text="@string/larus_onboarding_chat_bg_header"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/ai_gen_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/ai_gen_btn"
        android:background="@drawable/larus_ugc_bot_bg_ai_gen_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/ai_gen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ai_gen"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ai_gen"
        android:padding="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_ai_generate_picture"
        android:drawablePadding="?attr/larus_dp_6"
        android:drawableStart="@drawable/larus_ugc_bot_icon_sparkles"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/select_album_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/select_album_btn"
        android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
        android:padding="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_onboarding_chat_album_select"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
