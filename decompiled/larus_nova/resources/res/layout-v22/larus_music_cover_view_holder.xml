<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cover_picture"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        app:failureImage="@drawable/larus_ic_music_icon_placeholder"
        app:failureImageScaleType="fitXY"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_bg_music_detail_cover_placeholder"
        app:placeholderImageScaleType="fitXY"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.lynx.lottieadapter.LottieAdapterView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cover_image_loading"
        android:background="@drawable/larus_bg_music_detail_cover_placeholder"
        android:padding="?attr/larus_dp_120"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="centerCrop"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
