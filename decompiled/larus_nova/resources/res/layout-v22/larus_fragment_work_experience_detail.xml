<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_work_experience_detail_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="?attr/larus_dp_4"
            android:paddingRight="?attr/larus_dp_4"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:paddingHorizontal="?attr/larus_dp_4">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/work_experience_detail_close"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:contentDescription="@string/larus_accessibility_icon_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_close_dialog"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/work_experience_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_8"
                android:layout_marginRight="?attr/larus_dp_8"
                android:text="@string/larus_moa_work_experience_cn"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="?attr/larus_dp_8"
                android:textFontWeight="500"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/work_experience_detail_end_spacer"
                app:layout_constraintStart_toEndOf="@+id/work_experience_detail_close"
                app:layout_constraintTop_toTopOf="parent"/>
            <Space
                android:id="@+id/work_experience_detail_end_spacer"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_15"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_19"
            android:fillViewport="true"
            android:layout_weight="1"
            android:layout_marginHorizontal="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/work_experience_detail_body"
                android:background="@drawable/larus_bg_office_task_instruction_editor"
                android:padding="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textIsSelectable="true"/>
        </com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView>
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/work_experience_detail_auto_optimize"
            android:background="@drawable/larus_bg_office_task_setting_item_normal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_20"
            android:text="@string/larus_moa_work_experience_model_refine_cn"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            android:textFontWeight="500"
            app:larus_image_height="?attr/larus_dp_32"
            app:larus_image_src="@drawable/larus_ic_work_experience_model_optimization"
            app:larus_image_width="?attr/larus_dp_32"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/work_experience_detail_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
