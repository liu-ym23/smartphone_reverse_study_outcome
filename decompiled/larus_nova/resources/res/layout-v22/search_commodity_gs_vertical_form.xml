<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLayout"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gsContainerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/itemImageView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"/>
        <View
            android:id="@+id/itemCoverView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemImageView"
            app:layout_constraintEnd_toEndOf="@+id/itemImageView"
            app:layout_constraintStart_toStartOf="@+id/itemImageView"
            app:layout_constraintTop_toTopOf="@+id/itemImageView"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:textColor="@color/search_commodity_gs_vertical_label_text_color"
            android:gravity="center"
            android:id="@+id/gsLabelView"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            android:paddingHorizontal="3dp"
            android:paddingVertical="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/gsContentLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemImageView">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textColor="@color/search_commodity_gs_main_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/gsWordView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <android.widget.Space
                android:id="@+id/attachWordPaddingView"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textColor="@color/search_commodity_gs_attach_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/attachWordView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/gsTagIconView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="10sp"
            android:id="@+id/gsTagTextView"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
