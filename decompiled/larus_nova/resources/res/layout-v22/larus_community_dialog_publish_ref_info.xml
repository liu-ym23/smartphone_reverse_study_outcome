<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/container_content_view"
        android:background="@drawable/larus_community_bg_publish_ref_info_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_view"
            android:layout_width="?attr/larus_dp_56"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_40"
            android:src="@drawable/larus_community_icon_ref_publish_warning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_22"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_aiCreation_bottomSheet_title_makeRefPublic"
            android:textAlignment="center"
            android:textFontWeight="600"
            app:layout_constraintBottom_toTopOf="@+id/content_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_view"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_20"
            android:text="@string/larus_aiCreation_bottomSheet_des_makeRefPublicExplain"
            android:textAlignment="center"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/confirm_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_view"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/confirm_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_28"
            android:layout_marginRight="?attr/larus_dp_28"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:text="@string/larus_aiCreation_bottomSheet_btn_ok"
            android:layout_marginHorizontal="?attr/larus_dp_28"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_btn"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginTop="?attr/larus_dp_13"
            android:src="@drawable/larus_community_publish_dialog_close"
            android:layout_marginEnd="?attr/larus_dp_13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
