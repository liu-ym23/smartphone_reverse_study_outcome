<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_44">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:contentDescription="@string/larus_accessibility_icon_back"
        android:layout_marginHorizontal="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_dora_ic_left_back"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title_label"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button"
        app:layout_constraintStart_toEndOf="@+id/ic_back"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/center_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button"
        app:layout_constraintStart_toEndOf="@+id/ic_back"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.dora.impl.dynamic.widget.CenterSelectedRecyclerView
            android:orientation="horizontal"
            android:id="@+id/recycler_view"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/right_button"
        android:background="@android:color/transparent"
        android:padding="?attr/larus_dp_12"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        android:tint="@color/larus_neutral_100"
        android:layout_marginHorizontal="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
