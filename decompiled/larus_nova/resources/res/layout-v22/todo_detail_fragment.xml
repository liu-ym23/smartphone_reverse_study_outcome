<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_detail_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/edit_activity_root"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.ui.CommonTitleBar
            android:id="@+id/title_bar"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/todo_content_wrapper"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_44">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/todo_content_rv"
                    android:paddingBottom="20dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
                <FrameLayout
                    android:id="@+id/todo_comment_at_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:id="@+id/bottom_create_container"
                android:background="@color/bg_body_overlay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_checkbox_send_to_chat"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_52"
                    android:paddingHorizontal="@dimen/dp_16">
                    <com.larksuite.component.universe_design.checkbox.UDCheckBox
                        android:id="@+id/checkbox_send_to_chat"
                        android:padding="@dimen/dp_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textColor="@color/text_title"
                        android:id="@+id/text_checkbox_send_to_chat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_Task_SendTaskToChatShortcut"
                        android:layout_marginStart="@dimen/dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_52"
                    android:layout_weight="1">
                    <com.larksuite.component.universe_design.button.UDButton
                        android:textSize="@dimen/sp_14"
                        android:textColor="@drawable/todo_keyboard_text_color_selector"
                        android:gravity="center_vertical"
                        android:id="@+id/button_create"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_Task_CreateButton"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:paddingVertical="7dp"
                        app:ud_backgroundColor="@color/ud_button_white_blue_bg"
                        app:ud_strokeColor="@color/primary_fill_default"
                        app:ud_strokeWidth="1dp"
                        style="@style/UDButton.Default"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/commentInputLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp">
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/keyboardContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/todo_feature_fragment_container"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"/>
</FrameLayout>
