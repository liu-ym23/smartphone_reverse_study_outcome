<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rule_item"
    android:background="@color/larus_base_2"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="?attr/larus_dp_16">
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/rule_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="?attr/larus_dp_15"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rule_status_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/rule_status_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_dora_rule_status_selector"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
