<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/gen_avatar_action"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/auto_gen_btn"
        android:background="@drawable/larus_bg_avatar_gen_action_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_margin="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/auto_fill_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="?attr/larus_dp_4"
            app:srcCompat="?attr/larus_ic_bot_create_ai_white"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="center"
            android:id="@+id/auto_fill_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_ai_generate_picture"
            android:maxLines="1"
            android:singleLine="true"
            android:textFontWeight="500"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/upload_pic_btn"
        android:background="@drawable/larus_bg_avatar_gen_action_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_40"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="center"
            android:id="@+id/upload_avatar_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_upload_photo"
            android:textFontWeight="500"/>
    </LinearLayout>
</LinearLayout>
