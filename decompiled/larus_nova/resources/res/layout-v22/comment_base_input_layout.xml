<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/input_base"
    android:background="@color/bg_body_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/doc_comment_flow"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/doc_comment_flow"
        android:background="@drawable/facade_edit_bg_shape"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:backgroundTint="@color/bg_body"
        android:layout_marginHorizontal="8dp"
        app:constraint_referenced_ids="doc_comment_input_wrap,rv_selected_image,checkbox_container"
        app:flow_maxElementsWrap="1"
        app:flow_verticalAlign="center"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toTopOf="@+id/bot_at_hint_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/doc_comment_input_wrap"
        android:paddingLeft="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_input_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/doc_comment_input"
            app:layout_constraintTop_toTopOf="@+id/doc_comment_input"
            app:srcCompat="@drawable/ud_icon_lock_filled"
            app:tint="@color/icon_n3"/>
        <com.bytedance.ee.bear.middleground.comment.widget.CommentEditText
            android:textSize="16sp"
            android:gravity="start"
            android:id="@+id/doc_comment_input"
            android:paddingLeft="8dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="84dp"
            android:minHeight="48dp"
            android:scrollHorizontally="false"
            android:inputType="textMultiLine"
            android:imeOptions="flagNoExtractUi|flagNoFullscreen"
            app:layout_constraintLeft_toRightOf="@+id/doc_comment_input_icon"
            app:layout_constraintRight_toLeftOf="@+id/doc_comment_input_voice_send"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/UDEditText"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_input_voice_send"
            android:paddingLeft="0dp"
            android:paddingTop="12dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:tint="@color/space_selector_primary_b500_b300"
            app:layout_constraintBottom_toBottomOf="@+id/doc_comment_input"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/ud_icon_send_colorful"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_selected_image"
        android:paddingLeft="@dimen/space_kit_len_16"
        android:paddingRight="@dimen/space_kit_len_16"
        android:paddingBottom="@dimen/dp_8"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/checkbox_container"
        android:paddingLeft="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/checkbox_wraper"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.larksuite.component.ui.button.LKUICheckBox2
                android:layout_gravity="center_vertical"
                android:id="@+id/checkbox"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:layout_width="20dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/checkbox_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Docs_Mention_GrantViewPermToPplMentioned_Radio"
                android:maxLines="2"
                android:layout_marginEnd="@dimen/space_kit_len_16"/>
        </LinearLayout>
    </LinearLayout>
    <com.bytedance.ee.bear.middleground.comment.widget.BotAtHintView
        android:id="@+id/bot_at_hint_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_8"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/doc_comment_button_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox_container"
        app:layout_constraintVertical_bias="1"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/doc_comment_button_layout"
        android:background="@color/bg_body_overlay"
        android:paddingLeft="9dp"
        android:paddingTop="6dp"
        android:paddingRight="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_at"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:tint="@color/space_selector_comment_icon"
            app:srcCompat="@drawable/ud_icon_at_outlined"/>
        <FrameLayout
            android:id="@+id/fl_voice"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.middleground.comment.audio.MotionImageView
                android:layout_gravity="center"
                android:id="@+id/commentVoice"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:tint="@color/space_selector_comment_icon"
                app:srcCompat="@drawable/ud_icon_voice_outlined"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_insert_image"
            android:padding="6dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ud_icon_image_outlined"
            app:tint="@color/space_selector_comment_icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_area"
            android:padding="6dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ud_icon_box_comment_outlined"
            app:tint="@color/space_selector_comment_icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_visibility"
            android:padding="6dp"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ud_icon_setting_outlined"
            app:tint="@color/icon_n2"/>
        <View
            android:id="@+id/divide_3"
            android:background="@color/line_divider_default"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="22dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_publish_btn"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/space_selector_primary_b500_b300"
            app:srcCompat="@drawable/ud_icon_send_colorful"/>
        <View
            android:id="@+id/divide_4"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_4"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/doc_comment_close"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/space_selector_comment_icon"
            app:srcCompat="@drawable/ud_icon_keyboard_display_outlined"/>
    </LinearLayout>
    <include
        android:id="@+id/comment_voice_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/divider_2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        layout="@layout/comment_voice_bar"/>
    <View
        android:id="@+id/divider_2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/space_kit_len_30"
        android:layout_marginRight="@dimen/space_kit_len_30"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
