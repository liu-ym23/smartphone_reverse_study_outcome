<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/facade_round_around_l"
    android:paddingLeft="@dimen/space_kit_len_8"
    android:paddingTop="@dimen/space_kit_len_12"
    android:paddingRight="@dimen/space_kit_len_8"
    android:paddingBottom="@dimen/space_kit_len_12"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="@dimen/more_item_width"
    android:layout_height="95dp"
    android:backgroundTint="@color/facade_selector_item_float">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="@dimen/more_item_center_size"
        android:layout_height="@dimen/more_item_center_size">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/more_item_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/icon_n1"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/more_item_new"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_2"
            android:layout_marginStart="@dimen/space_kit_len_22"
            style="@style/UDBadge.Dot.StrongReminder.Large"/>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="3dp">
        <TextView
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/more_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="35dp"
            android:maxLines="2"
            android:includeFontPadding="true"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="5sp"
            android:autoSizeMaxTextSize="12sp"/>
    </LinearLayout>
</LinearLayout>
