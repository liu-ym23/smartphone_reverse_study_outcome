<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="22dp"
    android:layout_marginBottom="22dp"
    android:layout_marginVertical="22dp">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:srcCompat="@drawable/card_list_ic_error"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ec_card_list_net_error_hint"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5c5d65"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ec_card_list_net_error_desc"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:background="@drawable/shopping_bg_cart_new_reconnect"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginTop="24dp"
        android:text="@string/ec_card_list_retry"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#04498d"
        android:id="@+id/tv_advice"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ec_card_list_net_advice"/>
</LinearLayout>
