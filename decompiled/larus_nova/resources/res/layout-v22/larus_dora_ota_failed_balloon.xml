<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/larus_dora_balloon_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:minHeight="?attr/larus_dp_66"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/dora_ota_failed_balloon_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_ota_interrupted_tips_cn"
            android:layout_marginStart="?attr/larus_dp_16"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dora_ota_failed_balloon_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_static_white"
            android:id="@+id/dora_ota_failed_balloon_btn"
            android:background="@drawable/larus_dora_ota_bg_btn"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingRight="?attr/larus_dp_12"
            android:paddingBottom="?attr/larus_dp_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_btn_check_cn"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:paddingHorizontal="?attr/larus_dp_12"
            android:paddingVertical="?attr/larus_dp_6"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dora_ota_failed_balloon_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
