<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_20"
    android:paddingRight="?attr/larus_dp_20"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_80"
    android:paddingHorizontal="?attr/larus_dp_20">
    <View
        android:id="@+id/dora_feedback_entry_divider_view"
        android:background="@color/neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dora_feedback_entry_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="你喜欢日记内容吗？"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dora_feedback_entry_actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/dora_feedback_entry_title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dora_feedback_entry_title_text">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/dora_feedback_entry_like_layout"
            android:padding="?attr/larus_dp_7"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dora_feedback_entry_like_image"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:src="@drawable/larus_ic_dora_like"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/dora_feedback_entry_like_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="喜欢"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/dora_feedback_entry_dislike_layout"
            android:padding="?attr/larus_dp_7"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_8">
            <ImageView
                android:id="@+id/dora_feedback_entry_dislike_image"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:src="@drawable/larus_ic_dora_dislike"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/dora_feedback_entry_dislike_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不喜欢"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
