<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_mode_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pc_add_computer_header"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_52"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/pc_add_computer_handle"
            android:background="?attr/larus_bg_sheet_handle"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_4"
            android:layout_marginTop="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pc_add_computer_close"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginStart="?attr/larus_dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_close_dialog"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pc_add_computer_illustration"
        android:layout_width="?attr/larus_dp_174"
        android:layout_height="?attr/larus_dp_110"
        android:layout_marginTop="?attr/larus_dp_90"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pc_add_computer_phone_icon"
            android:layout_width="?attr/larus_dp_46"
            android:layout_height="?attr/larus_dp_46"
            android:layout_marginTop="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_pc_add_guide_mob"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/pc_add_computer_dot_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/pc_add_computer_phone_icon"
            app:layout_constraintEnd_toStartOf="@+id/pc_add_computer_pc_icon"
            app:layout_constraintStart_toEndOf="@+id/pc_add_computer_phone_icon"
            app:layout_constraintTop_toTopOf="@+id/pc_add_computer_phone_icon">
            <View
                android:background="@drawable/larus_bg_pc_add_guide_dot"
                android:layout_width="?attr/larus_dp_4"
                android:layout_height="?attr/larus_dp_4"/>
            <View
                android:background="@drawable/larus_bg_pc_add_guide_dot"
                android:layout_width="?attr/larus_dp_4"
                android:layout_height="?attr/larus_dp_4"
                android:layout_marginStart="?attr/larus_dp_4"/>
            <View
                android:background="@drawable/larus_bg_pc_add_guide_dot"
                android:layout_width="?attr/larus_dp_4"
                android:layout_height="?attr/larus_dp_4"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pc_add_computer_pc_icon"
            android:layout_width="?attr/larus_dp_46"
            android:layout_height="?attr/larus_dp_46"
            android:layout_marginTop="?attr/larus_dp_32"
            android:layout_marginEnd="?attr/larus_dp_15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_pc_add_guide_localpc"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/pc_add_computer_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_224"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/pc_add_computer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_dispatch_connect_your_computer_cn"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_34"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/pc_add_computer_desc"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="?attr/larus_dp_326"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_32"
            android:text="@string/larus_dispatch_connect_local_computer_description_cn"
            android:includeFontPadding="false"
            android:paddingHorizontal="?attr/larus_dp_12"
            android:lineHeight="?attr/larus_dp_21"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pc_add_computer_card_group"
            android:layout_width="?attr/larus_dp_326"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_32">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:id="@+id/pc_add_computer_download_card"
                android:background="@drawable/larus_bg_pc_add_guide_card"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_76"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16">
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/larus_base_1"
                    android:gravity="center"
                    android:id="@+id/pc_add_computer_step_one"
                    android:background="@drawable/larus_bg_pc_guide_step"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"
                    android:text="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="?attr/larus_dp_2"
                    android:paddingBottom="?attr/larus_dp_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_12">
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="?attr/larus_neutral_100"
                        android:id="@+id/pc_add_computer_download_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dispatch_download_desktop_doubao_cn"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:lineHeight="?attr/larus_dp_22"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_4">
                        <TextView
                            android:textSize="?attr/larus_dp_14"
                            android:textColor="?attr/larus_primary_60"
                            android:id="@+id/pc_add_computer_download_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:lineHeight="?attr/larus_dp_22"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/pc_add_computer_copy_icon"
                            android:visibility="gone"
                            android:layout_width="?attr/larus_dp_14"
                            android:layout_height="?attr/larus_dp_14"
                            android:layout_marginStart="?attr/larus_dp_6"
                            app:srcCompat="@drawable/larus_ic_pc_add_guide_copy"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:id="@+id/pc_add_computer_login_card"
                android:background="@drawable/larus_bg_pc_add_guide_card"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:minHeight="?attr/larus_dp_76"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16">
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/larus_base_1"
                    android:gravity="center"
                    android:id="@+id/pc_add_computer_step_two"
                    android:background="@drawable/larus_bg_pc_guide_step"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"
                    android:text="2"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="?attr/larus_dp_2"
                    android:paddingBottom="?attr/larus_dp_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_12">
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="?attr/larus_neutral_100"
                        android:id="@+id/pc_add_computer_login_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dispatch_login_same_account_cn"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:lineHeight="?attr/larus_dp_22"
                        android:textFontWeight="600"/>
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/pc_add_computer_login_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_4"
                        android:text="@string/larus_dispatch_login_desktop_doubao_same_account_cn"
                        android:includeFontPadding="false"
                        android:lineHeight="?attr/larus_dp_22"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_static_white"
        android:gravity="center"
        android:id="@+id/pc_add_computer_completed"
        android:background="@drawable/larus_shape_connection_btn"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_42"
        android:text="@string/larus_dispatch_completed_cn"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        android:lineHeight="?attr/larus_dp_24"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
