<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <RelativeLayout
        android:id="@+id/total_amount_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title">
        <TextView
            android:textSize="32dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_total_diamond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_total_diamond"
            android:layout_centerHorizontal="true">
            <ImageView
                android:gravity="center"
                android:id="@+id/ic_diamond"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="3dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ttlive_open_ic_douyin_white"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_white_50"
                android:id="@+id/diamond_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ttlive_open_platform_current_receive_diamond"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
