<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_proactive_notification_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_proactive_notification_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_allow_broadcast_entrance_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_dora_allow_broadcast_entrance_subtitle_cn"/>
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_proactive_notification_priority"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_priority_broadcast_title_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_dora_broadcast_priority_broadcast_subtitle_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_proactive_notification_freq"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_summary_frequency_cn"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_proactive_notification_app_list_setting"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_authority_management_cn"
                    android:textFontWeight="500"/>
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_head_gesture_control_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_head_action_broadcast_left_right_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_dora_broadcast_v3_head_gesture_desc_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.common_ui.widget.UrlSpanTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_proactive_notification_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                android:textFontWeight="500"
                app:larus_linkColor="@color/larus_neutral_100"
                app:larus_linkUnderLine="false"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_custom_broadcast_rules_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_custom_broadcast_rules_entrance"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_title_custom_broadcast_rules_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_proactive_chat_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_proactive_chat_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_doubao_proactive_broadcast_swithbtn_cn"
                    android:textFontWeight="500"
                    app:larus_sub_text="@string/larus_doubao_proactive_broadcast_notice_cn"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/dora_proactive_settings_container"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="?attr/larus_sp_15"
                            android:textColor="@color/larus_neutral_50"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/larus_doubao_proactive_freq_low_cn"
                            android:layout_marginStart="?attr/larus_dp_16"/>
                        <SeekBar
                            android:id="@+id/proactive_freq_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_16"
                            android:layout_marginBottom="?attr/larus_dp_16"
                            android:max="5"
                            android:progress="3"
                            android:progressDrawable="@drawable/larus_voice_general_progress"
                            android:layout_weight="1"
                            android:layout_marginStart="?attr/larus_dp_12"
                            android:layout_marginEnd="?attr/larus_dp_12"
                            android:min="1"
                            app:layout_constraintStart_toStartOf="parent"
                            style="@style/larus_mix_seekbar_style"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="?attr/larus_sp_15"
                            android:textColor="@color/larus_neutral_50"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/larus_doubao_proactive_freq_high_cn"
                            android:layout_marginEnd="?attr/larus_dp_16"/>
                    </LinearLayout>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/dora_proactive_settings_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:showDividers="none">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.larus.dora.impl.view.DoraMovieView
                                android:layout_gravity="center"
                                android:id="@+id/dora_proactive_settings_video"
                                android:background="@drawable/larus_bg_device_ailib_movie"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:larus_topRadius="?attr/larus_dp_12"
                                app:layout_constraintDimensionRatio="978:708"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/dora_proactive_settings_play"
                                    android:background="@android:color/transparent"
                                    android:visibility="gone"
                                    android:layout_width="?attr/larus_dp_48"
                                    android:layout_height="?attr/larus_dp_48"
                                    android:src="@drawable/larus_dora_img_ailab_play"
                                    android:scaleType="fitCenter"/>
                            </com.larus.dora.impl.view.DoraMovieView>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:background="@color/larus_neutral_transparent_2"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/larus_dp_0_5"/>
                        <com.larus.bmhome.view.item.ItemTextSelector
                            android:id="@+id/dora_proactive_settings_without_confirm"
                            android:background="@drawable/larus_bg_item_selector_middle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_doubao_proactive_broadcast_chat_not_confirm_cn"
                            android:textFontWeight="500"/>
                        <View
                            android:background="@color/larus_neutral_transparent_2"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/larus_dp_0_5"
                            android:layout_marginStart="?attr/larus_dp_16"/>
                        <com.larus.bmhome.view.item.ItemTextSelector
                            android:id="@+id/dora_proactive_settings_need_confirm"
                            android:background="@drawable/larus_bg_item_selector_last"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_doubao_proactive_broadcast_chat_need_confirm_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </LinearLayout>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_wearing_remind_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_wearing_remind"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_proactive_wear_broadcast_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_wearing_remind_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_proactive_wear_broadcast_subtitle_cn"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                android:textFontWeight="400"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
