<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="50dp"
    android:paddingRight="50dp"
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:paddingHorizontal="50dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_network_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#bfffffff"
        android:id="@+id/tv_current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="11sp"
            android:textColor="#bfffffff"
            android:id="@+id/tv_battery_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:background="@drawable/aos_battery_body"
            android:padding="1dp"
            android:layout_width="22dp"
            android:layout_height="10.5dp"
            android:layout_marginStart="2dp">
            <androidx.cardview.widget.CardView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/battery_level_progress"
                android:layout_width="18dp"
                android:layout_height="6.5dp"
                android:layout_marginStart="1dp"
                app:cardBackgroundColor="#fff"
                app:cardCornerRadius="2.5dp"
                app:cardElevation="0dp"/>
            <ImageView
                android:id="@+id/iv_battery_charging"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/aos_icon_battery_charging"
                android:layout_marginStart="1dp"/>
        </FrameLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/aos_icon_battery_head"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
</RelativeLayout>
