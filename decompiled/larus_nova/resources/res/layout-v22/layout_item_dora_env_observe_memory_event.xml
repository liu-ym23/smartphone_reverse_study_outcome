<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_memory_event_item"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_4"
    android:layout_marginBottom="?attr/larus_dp_4"
    android:layout_marginVertical="?attr/larus_dp_4"
    android:paddingHorizontal="?attr/larus_dp_16"
    android:paddingVertical="?attr/larus_dp_12">
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/neutral_50"
        android:id="@+id/memory_event_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/memory_event_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:layout_marginBottom="?attr/larus_dp_2"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/neutral_50"
        android:ellipsize="end"
        android:id="@+id/memory_event_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:maxLines="2"/>
</LinearLayout>
