<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.window.shop.widget.SubCategoryView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/ec_window_subcategory_edge_padding"
    android:paddingRight="@dimen/ec_window_subcategory_edge_padding"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:paddingHorizontal="@dimen/ec_window_subcategory_edge_padding">
    <com.bytedance.android.window.shop.widget.ECWindowTabLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/ec_window_sub_category_tab"
        android:background="@drawable/ec_window_no_ripple"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        app:tabBackground="@color/ec_shop_transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/transparent"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@color/ec_shop_transparent"
        app:tabSelectedTextColor="@color/shopping_color_161823"
        app:tabTextAppearance="@style/ShopTabLayoutTextStyle"
        app:tabTextColor="@color/shopping_color_99161823"
        app:tabUnboundedRipple="false"/>
</com.bytedance.android.window.shop.widget.SubCategoryView>
