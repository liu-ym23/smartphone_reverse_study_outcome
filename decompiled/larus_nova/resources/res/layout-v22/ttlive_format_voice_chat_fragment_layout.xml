<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.profit.format.voicechat.view.BlurBackgroundImageView
        android:id="@+id/voice_chat_avatar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_format_voice_chat_bg_deep"
        android:scaleType="centerCrop"/>
    <com.bytedance.android.live.profit.format.voicechat.view.AlphaMaskView
        android:id="@+id/mask_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maskSrc="@drawable/ttlive_format_voice_chat_bg"/>
    <View
        android:id="@+id/voice_chat_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voice_chat_top"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/voice_chat_status_bar">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ttlive_format_voice_chat_title_color_black"
            android:ellipsize="end"
            android:id="@+id/voice_chat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:textFontWeight="600"
            app:fontFamily="PingFang SC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/voice_chat_tag"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/voice_chat_tag"
            android:background="@drawable/ttlive_format_voice_chat_tag_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/voice_chat_title"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ttlive_format_voice_chat_tag_color_black"
                android:id="@+id/voice_chat_tag_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_format_voice_chat_tag_text"
                app:fontFamily="PingFang SC"/>
        </FrameLayout>
        <View
            android:id="@+id/voice_chat_question"
            android:background="@drawable/ttlive_format_voice_chat_question_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.profit.format.voicechat.view.VoiceChatAvatarView
        android:id="@+id/voice_chat_avatar_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25"/>
    <FrameLayout
        android:id="@+id/gift_play_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.bytedance.android.live.profit.format.voicechat.view.OperationTipView
        android:id="@+id/operation_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/voice_chat_action_view"/>
    <com.bytedance.android.live.profit.format.voicechat.view.VoiceChatActionView
        android:id="@+id/voice_chat_action_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.bytedance.android.live.profit.format.voicechat.view.VoiceChatButtonView
        android:id="@+id/voice_chat_button_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voice_chat_loading"
        android:background="@drawable/ttlive_format_voice_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:id="@+id/voice_chat_loading_view"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintBottom_toTopOf="@+id/voice_chat_loading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#e5161823"
            android:id="@+id/voice_chat_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_format_voice_chat_loading_text"
            android:fontFamily="PingFang SC"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_chat_loading_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
