<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/realtime_call_avatar_bg"
        android:background="@drawable/larus_bg_realtime_call_white_round"
        android:layout_width="?attr/larus_dp_240"
        android:layout_height="?attr/larus_dp_240"
        android:layout_marginTop="?attr/larus_dp_120"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/realtime_call_avatar"
        android:background="@drawable/larus_bg_realtime_call_white_round"
        android:layout_width="?attr/larus_dp_220"
        android:layout_height="?attr/larus_dp_220"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:placeholderImageScaleType="fitCenter"
        app:roundAsCircle="true"/>
    <com.larus.voicecall.impl.ui.VoiceCallVideoView
        android:id="@+id/realtime_call_avatar_video"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_220"
        android:layout_height="@dimen/dp_220"
        app:larus_is_circle="true"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/realtime_call_avatar_first_frame"
        android:background="@drawable/larus_bg_realtime_call_white_round"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_220"
        android:layout_height="?attr/larus_dp_220"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/voice_call_avatar_cover"
        android:background="@drawable/larus_bg_realtime_call_avatar_cover"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/realtime_ball_video_bg"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_420"
        android:layout_height="?attr/larus_dp_420"
        android:src="@drawable/larus_ball_bg_shadow_dark"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"/>
    <com.larus.voicecall.impl.ui.VoiceCallVideoView
        android:id="@+id/realtime_ball_video"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:larus_is_circle="true"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintRight_toRightOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/realtime_call_avatar_bg"/>
    <RelativeLayout
        android:id="@+id/realtime_call_bubble_speaking"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_111"
        android:layout_height="?attr/larus_dp_111"
        android:layout_marginBottom="?attr/larus_dp_180"
        android:layout_marginStart="?attr/larus_dp_155"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/realtime_call_bubble_speaking_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <com.larus.common_ui.view.CustomBarCountAudioVisualizer
            android:id="@+id/realtime_call_bubble_audio_anim"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_32"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/realtime_call_bubble_thinking"
        android:background="@drawable/larus_ic_shadow_bg"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_131"
        android:layout_height="?attr/larus_dp_131"
        android:layout_marginBottom="?attr/larus_dp_180"
        android:layout_marginStart="?attr/larus_dp_155"
        app:layout_constraintBottom_toBottomOf="@+id/realtime_call_avatar_bg"
        app:layout_constraintLeft_toLeftOf="@+id/realtime_call_avatar_bg">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/realtime_call_bubble_thinking_view"
            android:layout_width="?attr/larus_dp_111"
            android:layout_height="?attr/larus_dp_111"
            android:layout_marginTop="?attr/larus_dp_15"
            android:layout_marginStart="?attr/larus_dp_5"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/realtime_call_action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/realtime_call_avatar_bg">
        <com.larus.av_call.view.SceneModeButton
            android:id="@+id/realtime_call_scene_button"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_38"/>
    </LinearLayout>
    <View
        android:id="@+id/realtime_call_hot_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/realtime_call_action_container"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/mic_access_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/realtime_call_action_container">
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/static_white_transparent_4"
            android:gravity="center_horizontal"
            android:id="@+id/mic_access_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_cc_call_access_mic_desc"
            android:layout_marginStart="?attr/larus_dp_32"
            android:layout_marginEnd="?attr/larus_dp_32"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/mic_access_btn"
            android:background="@drawable/larus_bg_realtime_call_mic_access_btn_dark"
            android:layout_width="?attr/larus_dp_240"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_24">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mic_access_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/larus_ic_rtc_mic_dark"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_static_white"
                android:id="@+id/mic_access_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_cc_call_access_mic_button_allow"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/double_line_mic_access_mask"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/double_line_mic_access_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="?attr/larus_dp_32"
            android:paddingEnd="?attr/larus_dp_32">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/double_line_mic_access_desc"
                android:layout_width="326dp"
                android:layout_height="25dp"
                android:text="@string/larus_cc_call_access_mic_desc"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/double_line_mic_access_btn"
                android:background="@drawable/larus_white_bg_item_single_radius12_normal"
                android:paddingLeft="24dp"
                android:paddingTop="11dp"
                android:paddingRight="24dp"
                android:paddingBottom="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="11dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/double_line_mic_access_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/larus_ic_rtc_mic_light"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/neutral_100"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/double_line_mic_access_content"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_cc_call_access_mic_button_allow"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
