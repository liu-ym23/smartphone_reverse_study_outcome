<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/empty_container"
        android:background="?attr/larus_base_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_44"
        android:layout_marginRight="?attr/larus_dp_44"
        android:layout_marginBottom="?attr/larus_dp_44"
        android:layout_marginHorizontal="?attr/larus_dp_44"
        android:layout_marginVertical="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="@+id/palette_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/palette_view">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:src="@drawable/larus_ic_instruction_image_selector"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:paddingLeft="?attr/larus_dp_8"
                android:paddingRight="?attr/larus_dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_ref_image_btn"
                android:maxLines="2"
                android:paddingHorizontal="?attr/larus_dp_8"/>
        </LinearLayout>
    </FrameLayout>
    <com.larus.uaigc.createpage.bussiness.remove.widget.GesturePaletteView
        android:id="@+id/palette_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.larus.uaigc.createpage.bussiness.remove.widget.PenSizeIllustrationView
        android:id="@+id/pen_size_ring"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/palette_view"
        app:layout_constraintEnd_toEndOf="@+id/palette_view"
        app:layout_constraintStart_toStartOf="@+id/palette_view"
        app:layout_constraintTop_toTopOf="@+id/palette_view"/>
    <com.larus.uaigc.createpage.bussiness.remove.widget.PaletteControllerView
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/finish_btn"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/finish_btn"
        android:background="?attr/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_imageEdit_button_eraseArea"
        android:alpha="0.3"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/layer_above_img"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/palette_view"
        app:layout_constraintEnd_toEndOf="@+id/palette_view"
        app:layout_constraintStart_toStartOf="@+id/palette_view"
        app:layout_constraintTop_toTopOf="@+id/palette_view">
        <View
            android:layout_gravity="center"
            android:id="@+id/gray_mask"
            android:background="#80000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_bg_progress_loading_white"
            android:indeterminateDuration="750"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/retry_ll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_icon"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:src="@drawable/larus_ic_arrow_clockwise_white"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/center_text"
                android:paddingLeft="?attr/larus_dp_8"
                android:paddingRight="?attr/larus_dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_aiImage_GenPage_toast_uploadFailAgain"
                android:maxLines="2"
                android:paddingHorizontal="?attr/larus_dp_8"/>
        </LinearLayout>
    </FrameLayout>
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
