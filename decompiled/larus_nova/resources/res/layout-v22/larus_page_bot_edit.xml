<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/new_auto_fill_btn_stub"
        android:layout="@layout/larus_layout_auto_fill_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.larus.bot.impl.feature.edit.view.BotEditScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scroll_child"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="?attr/larus_dp_16">
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ViewStub
                android:id="@+id/old_auto_fill_btn_stub"
                android:layout="@layout/larus_layout_auto_fill_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                app:layout_constraintBottom_toTopOf="@+id/name_edit_area"
                app:layout_constraintStart_toStartOf="@+id/name_edit_area"/>
            <FrameLayout
                android:id="@+id/name_edit_area"
                android:layout_width="0dp"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginTop="?attr/larus_dp_64"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/avatar_container">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="start|center_vertical"
                    android:id="@+id/name_edit_container"
                    android:background="@drawable/larus_bg_bot_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_dp_16"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/name_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_create_bot_name"
                        android:maxLines="1"
                        android:paddingStart="?attr/larus_dp_16"
                        android:paddingEnd="?attr/larus_dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="?attr/larus_dp_16"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:id="@+id/name_edit"
                        android:background="@null"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="?attr/larus_dp_45"
                        android:hint="@string/larus_edit_bot_name_placeholder"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingEnd="?attr/larus_dp_21"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/name_edit_clear"
                        app:layout_constraintStart_toEndOf="@+id/name_title"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/larus_EditTextStyle"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/name_edit_clear"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_20"
                        android:layout_height="?attr/larus_dp_20"
                        android:layout_marginEnd="?attr/larus_dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/larus_ic_name_edit_clear"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/name_edit_skeleton_container"
                        android:background="@color/larus_base_2"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="@+id/name_title"
                        app:layout_constraintEnd_toEndOf="@+id/name_edit_clear"
                        app:layout_constraintStart_toStartOf="@+id/name_edit"
                        app:layout_constraintTop_toTopOf="@+id/name_title">
                        <View
                            android:id="@+id/name_edit_skeleton"
                            android:background="@drawable/larus_bg_black_rounded_rectangle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintWidth_percent="0.67"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/name_edit_cover"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/description_edit_container"
                android:background="@drawable/larus_bg_bot_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/name_edit_area">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_16"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_100"
                    android:ellipsize="end"
                    android:gravity="start|top"
                    android:id="@+id/desc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:text="@string/larus_create_bot_prompt_title"
                    android:maxLines="1"
                    android:layout_marginStart="?attr/larus_dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/larus_primary_50"
                    android:ellipsize="end"
                    android:gravity="end|top"
                    android:id="@+id/desc_polish"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:text="@string/larus_sp_polish"
                    android:maxLines="1"
                    android:drawablePadding="?attr/larus_dp_2"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:drawableLeftCompat="@drawable/larus_icon_desc_polish"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_14"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_50"
                    android:ellipsize="end"
                    android:gravity="end|top"
                    android:id="@+id/desc_polish_undo"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:text="@string/larus_sp_polish_undo"
                    android:maxLines="1"
                    android:drawablePadding="?attr/larus_dp_2"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:drawableLeftCompat="@drawable/larus_icon_desc_polish_undo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="?attr/larus_dp_16"
                    android:gravity="start|top"
                    android:id="@+id/description_edit"
                    android:background="@null"
                    android:scrollbars="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    android:maxHeight="?attr/larus_dp_196"
                    android:minHeight="?attr/larus_dp_76"
                    android:hint="@string/larus_edit_bot_prompt_placeholder"
                    android:inputType="textMultiLine"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/desc_title"
                    style="@style/larus_EditTextStyle"/>
                <include
                    android:id="@+id/description_skeleton"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_0"
                    android:layout_height="?attr/larus_dp_0"
                    app:layout_constraintBottom_toBottomOf="@+id/description_edit"
                    app:layout_constraintEnd_toEndOf="@+id/description_edit"
                    app:layout_constraintStart_toStartOf="@+id/description_edit"
                    app:layout_constraintTop_toTopOf="@+id/description_edit"
                    layout="@layout/larus_bot_create_desc_skeleton"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_settings_advance"
                android:background="@drawable/larus_bg_bot_edit"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:divider="@drawable/larus_bg_divider_left_64"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/description_edit_container">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/model_item_advance"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/larus_bot_setting_llm"
                    android:textFontWeight="700"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_model"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/item_voice_advance"
                    android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_bot_setting_voice"
                    android:textFontWeight="700"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_tts_speaker"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/item_language_advance"
                    android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_language"
                    android:textFontWeight="700"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_language_setting"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemLongTextArrow
                    android:id="@+id/access_permission_advance"
                    android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="700"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_access_permission_public"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/advance_settings_expand"
                android:paddingTop="?attr/larus_dp_20"
                android:paddingBottom="?attr/larus_dp_8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/group_settings_advance"
                app:layout_goneMarginTop="?attr/larus_dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/expand_advance_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="?attr/larus_dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/expand_advance_text"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/larus_edit_expand"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_16"
                    android:textStyle="bold"
                    android:textColor="@color/larus_primary_50"
                    android:id="@+id/expand_advance_text"
                    android:paddingBottom="?attr/larus_dp_2"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_create_bot_settings_advanced"
                    android:maxLines="1"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/expand_advance_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/advance_settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/group_settings_advance"
                app:layout_goneMarginTop="?attr/larus_dp_16">
                <include
                    android:id="@+id/bio_edit_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/larus_layout_bot_bio_edit"/>
                <include
                    android:id="@+id/first_met_edit_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bio_edit_container"
                    layout="@layout/larus_layout_bot_first_met_edit"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/group_settings"
                    android:background="@drawable/larus_bg_bot_edit"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:divider="@drawable/larus_bg_divider_left_64"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/first_met_edit_container">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/model_item"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/larus_bot_setting_llm"
                        android:textFontWeight="700"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_bot_model"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/item_voice"
                        android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_bot_setting_voice"
                        android:textFontWeight="700"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_icon_tts_speaker"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/item_language"
                        android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_language"
                        android:textFontWeight="700"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_bot_language_setting"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/web_search"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_web_browsing"
                        android:textFontWeight="700"
                        app:larus_image_src="@drawable/larus_bg_web_search"/>
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/gen_pic"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_image_generation"
                        android:textFontWeight="700"
                        app:larus_image_src="@drawable/larus_bg_gen_pic"/>
                    <com.larus.bmhome.view.item.ItemLongTextArrow
                        android:id="@+id/access_permission"
                        android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textFontWeight="700"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_bot_access_permission_public"
                        app:larus_image_width="?attr/larus_dp_32"/>
                </com.larus.bmhome.view.item.ItemGroup>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.bot.impl.feature.edit.view.BotEditScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_fixed_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/create_btn_mask"
            android:background="@color/larus_base_1_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/create_btn"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/create_btn"
            android:background="@drawable/larus_bg_confirm_btn_r16"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:text="@string/larus_create_bot_button"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:paddingVertical="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/create_quota"
            app:layout_goneMarginBottom="?attr/larus_dp_16"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="start"
            android:gravity="center"
            android:id="@+id/create_quota"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本周剩余 5/10"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
