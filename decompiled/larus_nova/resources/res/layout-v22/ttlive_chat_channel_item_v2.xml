<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/current_channel_tray_selected"
        android:background="@drawable/ttlive_bg_room_channel_link_seat_v2"
        android:layout_width="162dp"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.interactivity.chatchannel.v2.view.ChatChannelAvatarView
            android:layout_gravity="center_vertical"
            android:id="@+id/selected_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/channel_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxWidth="162dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="8dp"
            android:defaultFocusHighlightEnabled="false"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/total_count_container"
            android:paddingLeft="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:id="@+id/total_count_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="人"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_room_channel_link_seat_arrow_v2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/tray_unselected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/ttlive_chat_channel_avatar_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
        <com.bytedance.android.livesdk.interactivity.chatchannel.v2.view.ChatChannelAvatarView
            android:layout_gravity="center_vertical"
            android:id="@+id/unselected_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
            android:layout_gravity="top|right"
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_bg_room_channel_button_red"
            android:layout_width="8dp"
            android:layout_height="8dp"/>
    </FrameLayout>
</FrameLayout>
