<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/larus_minor_password_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_btn"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_password_close"
        android:contentDescription="@string/larus_accessibility_icon_close"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/minor_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_56"
        android:text="@string/larus_teenagerMode_createParentPasscode_cn"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/minor_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:text="@string/larus_teenagerMode_createParentPasscode_desc_cn"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minor_title"/>
    <com.larus.common_ui.widget.SeparatedEditText
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit_solid"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_24"
        android:inputType="number"
        android:imeOptions="flagNoExtractUi"
        app:larus_blockColor="@color/larus_base_3_overlay"
        app:larus_blockSpacing="?attr/larus_dp_12"
        app:larus_borderColor="@color/larus_primary_50"
        app:larus_borderWidth="?attr/larus_dp_2"
        app:larus_corner="?attr/larus_dp_16"
        app:larus_cursorColor="@color/larus_primary_50"
        app:larus_cursorDuration="1000"
        app:larus_cursorWidth="?attr/larus_dp_2"
        app:larus_highLightEnable="true"
        app:larus_maxLength="4"
        app:larus_separateEqual="false"
        app:larus_separateType="@integer/larus_type_solid"
        app:larus_showKeyboard="false"
        app:larus_textColor="@color/larus_neutral_100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minor_sub_title"/>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/feedback_message"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_82"
        android:layout_marginBottom="?attr/larus_dp_18"
        android:textFontWeight="600"
        app:larus_linkColor="@color/larus_primary_50"
        app:larus_linkUnderLine="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
    <ViewStub
        android:id="@+id/checkbox_minor_mode_disclaimer_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/set_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:id="@+id/set_password"
        android:background="@drawable/larus_ic_password_button_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_64"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_teenagerMode_createParentPasscode_create_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/pre_step"
        android:background="@drawable/larus_ic_password_pre_button_bg"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_173"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_64"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_teenagerMode_confirmParentPasscode_previous_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="600"
        app:layout_constraintEnd_toStartOf="@+id/confirm_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:id="@+id/confirm_btn"
        android:background="@drawable/larus_ic_password_confirm_button_bg"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_173"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_64"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_teenagerMode_confirmParentPasscode_confirm_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pre_step"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
    <View
        android:id="@+id/splitter"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginTop="?attr/larus_dp_128"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_solid"/>
</com.larus.bmhome.view.ChatConstraintLayout>
