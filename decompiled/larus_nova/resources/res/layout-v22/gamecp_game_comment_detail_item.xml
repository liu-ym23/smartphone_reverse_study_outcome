<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_comment_detail_item_parent"
    android:background="#ffffff"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.bytedance.android.gamecp.common.ui.UserAvatarImageView
        android:id="@+id/iv_comment_detail_item_avatar"
        android:background="@drawable/gamecp_game_promote_comment_avatar_bg"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/gamecp_game_promote_comment_default_avatar_bg"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_161823"
        android:ellipsize="end"
        android:id="@+id/tv_comment_detail_item_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_selected_comment"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_item_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_avatar"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_comment_user_title"
        android:background="@drawable/shape_bg_game_comment_user_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_comment_detail_item_nickname"
        app:layout_constraintEnd_toStartOf="@+id/iv_selected_comment"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_item_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_comment_detail_item_nickname"
        app:layout_constraintVertical_bias="0.6"/>
    <ImageView
        android:id="@+id/iv_comment_detail_item_option"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="24dp"
        android:src="@drawable/gamecp_ic_game_comment_list_option_v2"
        android:paddingStart="9dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_item_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_avatar"/>
    <ImageView
        android:id="@+id/iv_selected_comment"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="40dp"
        android:src="@drawable/gamecp_game_promote_choiceness_comment_v2"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_item_avatar"
        app:layout_constraintEnd_toStartOf="@+id/iv_comment_detail_item_option"
        app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_avatar"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/gamecp_game_80161823"
        android:id="@+id/tv_comment_detail_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_item_nickname"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/gamecp_game_80161823"
        android:ellipsize="end"
        android:id="@+id/tv_comment_detail_item_come_from_phone_model"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/gamecp_game_promote_comment_come_from"
        android:lines="1"
        app:layout_constraintEnd_toStartOf="@+id/tv_comment_detail_item_phone_model"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_item_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_item_nickname"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/gamecp_game_80161823"
        android:ellipsize="end"
        android:id="@+id/tv_comment_detail_item_phone_model"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_item_come_from_phone_model"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_item_nickname"/>
    <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
        android:id="@+id/ratingbar_comment_detail_item"
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:layout_marginTop="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_comment_detail_item_avatar"
        app:starBgDrawable="@drawable/gamecp_ic_game_promote_star_bg_v2"
        app:starClickable="false"
        app:starCount="5"
        app:starDrawable="@drawable/gamecp_ic_game_promote_star_v2"
        app:starPadding="5dp"
        app:starScrollable="false"
        app:starType="whole"/>
    <com.bytedance.android.gamecp.business.comment.CommentExpandableTextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_161823"
        android:id="@+id/tv_comment_detail_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingbar_comment_detail_item"
        app:maxFoldedLine="4"
        app:unfoldText="... 展开"
        app:unfoldTextColor="@color/gamecp_game_57161823"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_item_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_comment_detail_item_like_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_item_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_game_comment_images"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/iv_single_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintVertical_bias="0"/>
        <ImageView
            android:id="@+id/iv_image_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gamecp_game_promote_image_failed"
            app:layout_constraintBottom_toBottomOf="@+id/iv_single_image"
            app:layout_constraintEnd_toEndOf="@+id/iv_single_image"
            app:layout_constraintStart_toStartOf="@+id/iv_single_image"
            app:layout_constraintTop_toTopOf="@+id/iv_single_image"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/gl_help_image_locate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.67"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_item_like_container"
        android:paddingTop="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_comment_detail_item_image_container">
        <ImageView
            android:id="@+id/iv_comment_detail_item_like"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gamecp_ic_game_promote_comment_like_v2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_comment_detail_item_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_item_like"
            app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_item_like"
            app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_like"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_item_dislike_container"
        android:paddingLeft="5dp"
        android:paddingTop="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_comment_detail_item_like_container"
        app:layout_constraintStart_toEndOf="@+id/cl_comment_detail_item_like_container"
        app:layout_constraintTop_toTopOf="@+id/cl_comment_detail_item_like_container">
        <ImageView
            android:id="@+id/iv_comment_detail_item_dislike"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gamecp_ic_game_promote_comment_dislike"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_comment_detail_item_dislike_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_item_dislike"
            app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_item_dislike"
            app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_dislike"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_item_reply_container"
        android:paddingLeft="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cl_comment_detail_item_like_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_comment_detail_item_like_container">
        <ImageView
            android:id="@+id/iv_comment_detail_item_reply"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gamecp_ic_game_promote_comment_reply_v2"
            app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_item_like_count"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_comment_detail_item_reply_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_item_reply"
            app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_item_reply"
            app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_item_reply"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_item_secondary_reply_container"
        android:background="@drawable/gamecp_game_promote_secondary_comment"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom_line"
        app:layout_constraintTop_toBottomOf="@+id/cl_comment_detail_item_like_container">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/gamecp_game_161823"
            android:ellipsize="end"
            android:id="@+id/tv_comment_detail_item_secondary_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_bottom_line"
        android:background="@color/gamecp_game_14161823"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_comment_detail_item_secondary_reply_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
