<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView
            android:id="@+id/scroll_view_assignee"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_36">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/detail_owner_text_container"
                    android:background="@drawable/todo_keyboard_item_bg"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingVertical="4dp">
                    <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                        android:id="@+id/avatar_list_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_title"
                        android:id="@+id/avatar_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="170dp"
                        android:singleLine="true"
                        android:layout_marginStart="@dimen/dp_8"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/avatar_more_icon"
                        android:layout_width="14sp"
                        android:layout_height="14sp"
                        android:tint="@color/icon_n1"
                        android:layout_marginStart="@dimen/dp_8"
                        app:srcCompat="@drawable/ud_icon_right_outlined"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/set_section_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/dp_16">
                    <View
                        android:background="@color/line_divider_default"
                        android:layout_width="1sp"
                        android:layout_height="20sp"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_12"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_title"
                        android:gravity="center_vertical"
                        android:id="@+id/todo_section_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_New_Section_NoSection_Title"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_8"
                        android:drawableEnd="@drawable/ud_icon_down_outlined"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/loading_image"
                        android:visibility="gone"
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:layout_marginStart="@dimen/dp_16"
                        app:srcCompat="@drawable/todo_svg_icon_loading"/>
                </LinearLayout>
            </LinearLayout>
        </com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView>
        <View
            android:layout_gravity="end|center_vertical"
            android:id="@+id/assignee_shader"
            android:background="@drawable/todo_keyboard_shader"
            android:visibility="gone"
            android:layout_width="40sp"
            android:layout_height="24sp"/>
    </FrameLayout>
</LinearLayout>
