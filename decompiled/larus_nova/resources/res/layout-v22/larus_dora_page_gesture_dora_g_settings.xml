<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gesture_switch_layout_video_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/gesture_switch_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.larus.dora.impl.view.DoraMovieView
            android:id="@+id/video_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="39:22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/video_view_cover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gesture_switch_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gesture_switch_layout_video_view">
        <View
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/gesture_switch_layout_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gesture_switch_layout_middle"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/gesture_switch_layout_title_left"
                android:paddingTop="?attr/larus_dp_6"
                android:paddingBottom="?attr/larus_dp_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_10"
                android:text="@string/larus_dora_gesture_left_temple_cn"
                android:textAlignment="center"/>
            <View
                android:id="@+id/gesture_switch_layout_divider_left"
                android:background="@color/larus_neutral_100"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/gesture_switch_layout_middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gesture_switch_layout_right"
            app:layout_constraintStart_toEndOf="@+id/gesture_switch_layout_left">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/gesture_switch_layout_title_middle"
                android:paddingTop="?attr/larus_dp_6"
                android:paddingBottom="?attr/larus_dp_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_10"
                android:text="@string/larus_dora_button_cn"
                android:textAlignment="center"/>
            <View
                android:id="@+id/gesture_switch_layout_divider_middle"
                android:background="@color/larus_neutral_100"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/gesture_switch_layout_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/gesture_switch_layout_middle">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/gesture_switch_layout_title_right"
                android:paddingTop="?attr/larus_dp_6"
                android:paddingBottom="?attr/larus_dp_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_10"
                android:text="@string/larus_dora_gesture_right_temple_cn"
                android:textAlignment="center"/>
            <View
                android:id="@+id/gesture_switch_layout_divider_right"
                android:background="@color/larus_neutral_100"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_24"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gesture_switch_layout">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/scroll_view_linear_left_and_right"
                android:paddingBottom="?attr/larus_dp_24"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/dora_gesture_media_group_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_gesture_grouptitle_shortcut__cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dora_gesture_media_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_16"/>
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/dora_gesture_calling_group_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_calling_lite_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dora_gesture_calling_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_16"/>
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/dora_gesture_doubao_group_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_chat_with_doubao_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextDescView
                        android:id="@+id/talk_with_doubao_single_click"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_gesture_click_cn"
                        android:textFontWeight="500"
                        app:larus_describe_text="@string/larus_dora_gesture_conversation_end_cn"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/dora_gesture_doubao_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:background="@drawable/larus_bg_item_selector_last"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_dora_gesture_press_and_hold_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/scroll_view_linear_button"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/dora_gesture_button_group_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_gesture_grouptitle_record__cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextDescView
                        android:id="@+id/button_single_click"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_gesture_click_cn"
                        android:textFontWeight="500"
                        app:larus_describe_text="@string/larus_dora_button_take_photo_cn"/>
                    <com.larus.bmhome.view.item.ItemGroup
                        android:id="@+id/button_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.larus.bmhome.view.item.ItemTextArrow
                            android:background="@drawable/larus_bg_item_selector_last"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_dora_gesture_press_and_hold_cn"
                            android:textFontWeight="500"/>
                    </com.larus.bmhome.view.item.ItemGroup>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
