<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/obric_complex_task_secondary_menu"
    android:paddingTop="@dimen/dp_13"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="@dimen/dp_240"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_0">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/obric_custom_action_bar_blue_icon_and_text_color"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_action_bar_complex_task_secondary_menu_title"
            android:textFontWeight="500"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_obric_custom_action_bar_complex_task_right_arrow"
            android:layout_marginStart="@dimen/dp_3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_18">
        <LinearLayout
            android:layout_gravity="center"
            android:background="@drawable/icon_obric_custom_action_bar_complex_task_cite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_50"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/cite_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_3"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textStyle="bold"
        android:textColor="@color/obric_custom_action_bar_text"
        android:id="@+id/clarify_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:layout_marginEnd="@dimen/dp_18"
        android:textFontWeight="500"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_15">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/obric_complex_task_over_button"
            android:background="@drawable/selector_obric_complex_task_gray_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:text="@string/obric_action_bar_complex_task_over"
            android:layout_weight="1"
            android:textFontWeight="600"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/obric_complex_task_search_button"
            android:background="@drawable/selector_obric_complex_task_gray_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:text="@string/obric_action_bar_complex_task_search"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_7"
            android:textFontWeight="600"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/obric_complex_task_addition_button"
            android:background="@drawable/selector_obric_complex_task_gray_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:text="@string/obric_action_bar_complex_task_addition"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_7"
            android:textFontWeight="600"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/obric_complex_task_reply_button"
            android:background="@drawable/selector_obric_complex_task_gray_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:text="@string/obric_action_bar_complex_task_reply"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_7"
            android:textFontWeight="600"/>
    </LinearLayout>
</LinearLayout>
