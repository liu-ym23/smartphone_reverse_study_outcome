<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.widget.RoundLinearLayoutWithLastMotion xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="?attr/larus_dp_166"
    android:layout_height="?attr/larus_dp_92"
    android:layout_marginEnd="?attr/larus_dp_8"
    app:rv_backgroundColor="?attr/larus_base_2_overlay"
    app:rv_cornerRadius="?attr/larus_dp_12">
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginHorizontal="?attr/larus_dp_12"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_12">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_creator_avatar"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_4"
            app:failureImage="@drawable/larus_icon_search_source_icon_default"
            app:placeholderImage="?attr/larus_base_2_overlay"
            app:roundBottomEnd="true"
            app:roundBottomStart="true"
            app:roundTopEnd="true"
            app:roundTopStart="true"
            app:roundedCornerRadius="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:id="@+id/text_creator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
</com.larus.bmhome.chat.layout.widget.RoundLinearLayoutWithLastMotion>
