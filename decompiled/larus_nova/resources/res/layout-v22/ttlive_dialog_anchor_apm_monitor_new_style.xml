<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="@drawable/ttlive_anchor_apm_record_dialog_bg"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="460dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="性能状态"
            android:layout_weight="1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ttlive_color_99_161823"
                android:id="@+id/stable_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_anchor_stable_mode_des"/>
            <LinearLayout
                android:id="@+id/stable_des_right_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/stable_des"
                android:layout_toEndOf="@+id/stable_des">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#1c161823"
                    android:layout_width="0.5dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ttlive_color_99_161823"
                    android:id="@+id/stable_des_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="实际清晰度"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/stable_des_right_arrow"
                    android:layout_width="6dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ttlive_text_arrow_right"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ttlive_red"
                android:gravity="center"
                android:id="@+id/stable_mode"
                android:background="@drawable/ttlive_bg_stable_mode_open_now"
                android:layout_width="68dp"
                android:layout_height="24dp"
                android:text="立即开启"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/restart_btn"
                android:background="@drawable/ttlive_bg_restart_open_now"
                android:layout_width="68dp"
                android:layout_height="24dp"
                android:text="@string/live_anchor_restart_now"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <com.bytedance.android.live.room.discovery.AnchorPerfDialogScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_mic"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ic_mic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ttlive_ic_mic_regular_detail"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_color_161823"
                    android:id="@+id/tv_mic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="音频状态正常"
                    android:layout_toRightOf="@+id/ic_mic"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_color_99_161823"
                    android:id="@+id/tv_mic_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="适当的音量可以保障观众观看体验"
                    android:layout_toLeftOf="@+id/opti_open_accessiblity_btn"
                    android:layout_toRightOf="@+id/ic_mic"
                    android:layout_below="@+id/tv_mic"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ttlive_color_FF_fe2c55"
                    android:gravity="center"
                    android:id="@+id/opti_open_accessiblity_btn"
                    android:background="@drawable/ttlive_bg_open_accessibility_text"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginLeft="10dp"
                    android:text="@string/live_anchor_open_accessibility"
                    android:layout_alignParentRight="true"
                    android:layout_centerInParent="true"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="12dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/opti_volumn_bar_bg_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/opti_volumn_bar_bg_down_layout"
                    android:background="@drawable/ttlive_bg_bar_layout_normal"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/opti_volumn_info_text_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/ttlive_color_161823"
                            android:gravity="center"
                            android:id="@+id/speaker_info_text"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="12dp"
                            android:text="扬声器音量"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/ttlive_color_161823"
                            android:gravity="center"
                            android:id="@+id/mic_info_text"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginTop="10dp"
                            android:text="麦克风音量"
                            android:textFontWeight="500"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/internal_recording_linearlayout"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:textSize="14dp"
                                android:textColor="@color/ttlive_color_161823"
                                android:gravity="center"
                                android:id="@+id/internal_recording_text"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginLeft="12dp"
                                android:text="内录音量"
                                android:textFontWeight="500"/>
                            <FrameLayout
                                android:id="@+id/internal_recording_click_top_frame"
                                android:layout_width="18dp"
                                android:layout_height="28dp">
                                <ImageView
                                    android:layout_gravity="center"
                                    android:background="@drawable/ttlive_ic_mic_inner_click_tip"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/opti_volumn_bar_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.bytedance.android.live.effect.base.AdjustPercentBar
                            android:id="@+id/speaker_bar"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            app:ttlive_effect_bar_padding="16dp"
                            app:ttlive_effect_sliderRadius="8dp"/>
                        <com.bytedance.android.live.effect.base.AdjustPercentBar
                            android:id="@+id/mic_bar"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            app:ttlive_effect_bar_padding="16dp"
                            app:ttlive_effect_sliderRadius="8dp"/>
                        <com.bytedance.android.live.effect.base.AdjustPercentBar
                            android:id="@+id/internal_recording_bar"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            app:ttlive_effect_bar_padding="16dp"
                            app:ttlive_effect_sliderRadius="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/opti_volumn_index_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:gravity="center"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginLeft="12dp"
                            android:text="100"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ttlive_color_161823"
                            android:gravity="center"
                            android:id="@+id/speaker_index"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="12dp"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ttlive_color_161823"
                            android:gravity="center"
                            android:id="@+id/mic_index"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginTop="10dp"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ttlive_color_161823"
                            android:gravity="center"
                            android:id="@+id/internal_recording_index"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginTop="10dp"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/opti_volumn_bar_up_layout"
                    android:background="@drawable/ttlive_bg_bar_layout_foreground"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_alignTop="@+id/opti_volumn_bar_bg_down_layout"
                    android:layout_alignBottom="@+id/opti_volumn_bar_bg_down_layout"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_bar"
                android:paddingLeft="20dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp">
                <com.bytedance.android.live.effect.base.AdjustPercentBar
                    android:id="@+id/bar"
                    android:layout_width="238dp"
                    android:layout_height="28dp"
                    app:ttlive_effect_bar_padding="16dp"
                    app:ttlive_effect_sliderRadius="8dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_color_80_161823"
                    android:id="@+id/index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/sound_card"
                android:background="@drawable/ttlive_anchor_apm_record_bg"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/sound_card_switch_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/ttlive_color_161823"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/sound_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="声卡音质优化"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/ttlive_color_99_161823"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/sound_card_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="仅使用有线耳机时请关闭功能，避免影响耳机效果"
                        android:maxLines="1"
                        android:drawablePadding="4dp"/>
                </LinearLayout>
                <com.bytedance.dux.duxswitch.DuxSwitch
                    android:id="@+id/sound_card_switch_button"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:isAlwaysLight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <RelativeLayout
                android:id="@+id/temp_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ic_temp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ttlive_ic_temp_regular_detail"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_color_161823"
                    android:id="@+id/tv_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="设备温度正常"
                    android:layout_toRightOf="@+id/ic_temp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_color_99_161823"
                    android:id="@+id/tv_temp_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="建议适时检查，保障流畅开播"
                    android:layout_toRightOf="@+id/ic_temp"
                    android:layout_below="@+id/tv_temp"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ic_net"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ttlive_ic_net_good_detail"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_color_161823"
                    android:id="@+id/tv_net"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Wi-Fi/移动网络良好"
                    android:layout_toRightOf="@+id/ic_net"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_color_99_161823"
                    android:id="@+id/tv_net_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="建议不要频繁切换网络"
                    android:layout_toRightOf="@+id/ic_net"
                    android:layout_below="@+id/tv_net"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_records"
                android:background="@drawable/ttlive_anchor_apm_record_bg"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_color_161823"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_record_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本场问题记录"
                    android:drawableRight="@drawable/ttlive_text_arrow_right"
                    android:drawablePadding="4dp"/>/&gt; 
            </LinearLayout>
        </LinearLayout>
    </com.bytedance.android.live.room.discovery.AnchorPerfDialogScrollView>
</LinearLayout>
