<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/larus_model_choose_1074589248"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/larus_layout_common_padding"
        android:paddingEnd="@dimen/larus_layout_common_padding"
        android:paddingVertical="?attr/larus_dp_8">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="?attr/larus_dp_8">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/model_choose_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
