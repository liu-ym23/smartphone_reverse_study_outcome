<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_view_more"
        android:background="?attr/larus_bg_search_item"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        android:paddingHorizontal="?attr/larus_dp_16">
        <FrameLayout
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/image_search_avatar_single"
                android:layout_width="?attr/larus_dp_40"
                android:layout_height="?attr/larus_dp_40"
                app:placeholderImage="?attr/larus_neutral_transparent_1"
                app:roundAsCircle="true"/>
            <FrameLayout
                android:id="@+id/image_search_avatar_group"
                android:visibility="invisible"
                android:layout_width="?attr/larus_dp_40"
                android:layout_height="?attr/larus_dp_40">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/image_search_avatar_first"
                    android:layout_width="?attr/larus_dp_31"
                    android:layout_height="?attr/larus_dp_31"
                    app:placeholderImage="?attr/larus_neutral_transparent_1"
                    app:roundAsCircle="true"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/image_search_avatar_second"
                    android:layout_width="?attr/larus_dp_35"
                    android:layout_height="?attr/larus_dp_35"
                    app:placeholderImage="?attr/larus_neutral_transparent_1"
                    app:roundAsCircle="true"
                    app:roundingBorderColor="?attr/larus_base_1"
                    app:roundingBorderWidth="?attr/larus_dp_2_5"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/text_search_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            app:srcCompat="?attr/larus_icon_search_more_arrow"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_view_more"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:layout_marginVertical="?attr/larus_dp_8"/>
</LinearLayout>
