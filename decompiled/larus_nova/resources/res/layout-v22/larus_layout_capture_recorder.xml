<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/recorder_title"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_line"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_20"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/recorder_duration"
            android:background="@drawable/larus_bg_recorder_duration"
            android:paddingLeft="@dimen/dp_6"
            android:paddingTop="@dimen/dp_2"
            android:paddingRight="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_6"
            android:paddingVertical="@dimen/dp_2"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <FrameLayout
        android:id="@+id/focus_container_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recorder_control"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/focus_container_placeholder">
        <TextView
            android:textSize="@dimen/dp_13"
            android:textColor="@color/static_white_transparent_4"
            android:id="@+id/hands_free_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/larus_recordVideo_camera_tip_stayRecord"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/recorder_icon_bg"
            android:layout_width="@dimen/larus_camera_capture_button_size"
            android:layout_height="@dimen/larus_camera_capture_button_size"
            android:layout_marginTop="@dimen/larus_camera_control_top_margin"
            android:src="@drawable/larus_bg_recorder_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/recorder_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/larus_ic_recorder"
            app:layout_constraintBottom_toBottomOf="@+id/recorder_icon_bg"
            app:layout_constraintEnd_toEndOf="@+id/recorder_icon_bg"
            app:layout_constraintStart_toStartOf="@+id/recorder_icon_bg"
            app:layout_constraintTop_toTopOf="@+id/recorder_icon_bg"/>
        <ImageView
            android:id="@+id/hands_free_icon"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:src="@drawable/larus_ic_recorder_normal"
            app:layout_constraintBottom_toBottomOf="@+id/recorder_icon_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.7"
            app:layout_constraintStart_toEndOf="@+id/recorder_icon_bg"
            app:layout_constraintTop_toTopOf="@+id/recorder_icon_bg"/>
        <View
            android:id="@+id/connect_line"
            android:background="@color/neutral_70"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/recorder_icon_bg"
            app:layout_constraintEnd_toStartOf="@+id/hands_free_icon"
            app:layout_constraintStart_toEndOf="@+id/recorder_icon_bg"
            app:layout_constraintTop_toTopOf="@+id/recorder_icon_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
