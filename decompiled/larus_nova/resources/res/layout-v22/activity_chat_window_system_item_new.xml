<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp">
    <View
        android:id="@+id/system_message_check_label"
        android:layout_width="4dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:gravity="center"
        android:id="@+id/system_label"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/system_label_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/system_message_check_label"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@android:color/holo_blue_light"
        android:id="@+id/system_label_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/system_label"/>
    <View
        android:id="@+id/system_label_divider_left"
        android:background="@drawable/system_msg_divider_left"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="@+id/system_label"
        app:layout_constraintEnd_toStartOf="@+id/system_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/system_label"
        app:layout_constraintWidth_min="30dp"/>
    <View
        android:id="@+id/system_label_divider_right"
        android:background="@drawable/system_msg_divider_right"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="@+id/system_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/system_label"
        app:layout_constraintTop_toTopOf="@+id/system_label"
        app:layout_constraintWidth_min="30dp"/>
    <FrameLayout
        android:id="@+id/system_message_open_area_mask"
        android:paddingTop="@dimen/dp_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/system_message_open_area"
        android:paddingTop="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
