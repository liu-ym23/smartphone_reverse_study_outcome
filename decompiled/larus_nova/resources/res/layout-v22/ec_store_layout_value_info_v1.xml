<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="54sp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_store_value_info_first_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="48sp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_first_number_text"
                android:layout_width="wrap_content"
                android:layout_height="20sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_first_number_wan_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ec_shop_text_73FFFFFF"
            android:id="@+id/ec_store_value_info_first_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_store_value_info_bought"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/ec_store_value_info_line_first"
        android:background="@color/ec_shop_text_73FFFFFF"
        android:layout_width="0.5dp"
        android:layout_height="29sp"
        android:layout_marginLeft="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ec_store_value_info_first_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_store_value_info_sale_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12sp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ec_store_value_info_line_first"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_sale_number_text"
                android:layout_width="wrap_content"
                android:layout_height="20sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_sale_number_wan_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ec_shop_text_73FFFFFF"
            android:id="@+id/ec_store_value_info_sale_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_store_value_info_sale"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/ec_store_value_info_line_sales"
        android:background="@color/ec_shop_text_73FFFFFF"
        android:layout_width="0.5dp"
        android:layout_height="29sp"
        android:layout_marginLeft="165dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ec_store_value_info_first_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_store_value_info_third"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ec_store_value_info_line_sales"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.shopping.store.home.view.ECShopMarqueeTextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_third_text"
                android:layout_width="wrap_content"
                android:layout_height="20sp"
                android:maxWidth="63dp"
                android:singleLine="true"
                app:ec_scroll_mode="once"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/ec_store_value_info_third_text_sub"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textFontWeight="500"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ec_store_arrow_forward"
                android:visibility="gone"
                android:layout_width="3sp"
                android:layout_height="6sp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/ec_store_arrow_forward"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ec_store_value_info_third_icon_left"
                android:visibility="gone"
                android:layout_width="9sp"
                android:layout_height="9sp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ec_store_list_icon"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ec_shop_text_73FFFFFF"
                android:id="@+id/ec_store_value_info_third_below_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ec_store_value_info_third_icon_right"
                android:visibility="gone"
                android:layout_width="9sp"
                android:layout_height="9sp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ec_store_douyin_img_icon"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
