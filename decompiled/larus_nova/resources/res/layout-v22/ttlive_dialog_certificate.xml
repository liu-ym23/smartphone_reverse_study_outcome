<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_certificate_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/ttlive_open_certificate_title"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_open_platform_certificate_dialog_title"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:gravity="center_vertical"
        android:id="@+id/ttlive_open_certificate_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:text="@string/ttlive_open_platform_certificate_dialog_content"
        android:lineHeight="19.6dp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_open_certificate_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ttlive_open_certificate_msg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_open_certificate_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_open_icon_certificate_name"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_open_platform_certificate_dialog_text_name"
            android:alpha="0.5"
            android:layout_marginStart="4dp"
            android:textFontWeight="400"/>
        <View
            android:background="#161823"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="24dp"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_open_icon_certificate_id"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_open_platform_certificate_dialog_text_id"
            android:alpha="0.5"
            android:layout_marginStart="4dp"
            android:textFontWeight="400"/>
    </LinearLayout>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_open_certificate_msg"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_open_certificate_msg">
        <TextView
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/ttlive_open_certificate_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_open_platform_certificate_dialog_btn_cancel"
            android:layout_weight="1"
            android:textFontWeight="400"/>
        <View
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/ttlive_open_certificate_btn_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_open_platform_certificate_dialog_btn_confirm"
            android:layout_weight="1"
            android:textFontWeight="500"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
