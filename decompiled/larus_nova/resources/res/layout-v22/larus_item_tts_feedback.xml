<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_item_tts_feedback"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_58"
    android:layout_marginBottom="?attr/larus_dp_8"
    android:paddingHorizontal="?attr/larus_dp_16">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/select"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_tts_feedback_normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
