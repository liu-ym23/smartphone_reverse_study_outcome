<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_recharge_security_confirm_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/close_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_recharge_security_confirm_close_btn"
        android:layout_marginEnd="12dp"
        app:actualImageResource="@drawable/ttlive_recharge_security_confirm_close_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/confirm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_charge_security_confirm_title"
        android:lineHeight="24dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:id="@+id/confirm_sub_title"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/ttlive_charge_security_confirm_sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_title"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/confirm_checklist_container"
        android:background="@drawable/ttlive_bg_recharge_confirm_checklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_sub_title">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/rule_toggle_btn_1_container"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:id="@+id/rule_text_1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_charge_security_confirm_rule_1"
                    android:maxLines="2"
                    android:lineHeight="21dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/rule_toggle_btn_1"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ToggleButton
                    android:id="@+id/rule_toggle_btn_1"
                    android:background="@drawable/ttlive_cash_exchange_attention"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/rule_text_1"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:background="@drawable/ttlive_bg_recharge_security_confirm_divider"
            android:layout_width="350dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rule_toggle_btn_2_container"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:id="@+id/rule_text_2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="16dp"
                    android:lineHeight="21dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/rule_toggle_btn_2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ToggleButton
                    android:id="@+id/rule_toggle_btn_2"
                    android:background="@drawable/ttlive_cash_exchange_attention"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/rule_text_2"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:background="@drawable/ttlive_bg_recharge_security_confirm_divider"
            android:layout_width="350dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rule_toggle_btn_3_container"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:id="@+id/rule_text_3"
                    android:layout_width="320dp"
                    android:layout_height="21dp"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_charge_security_confirm_rule_3"
                    android:lineHeight="42dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/rule_toggle_btn_2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ToggleButton
                    android:id="@+id/rule_toggle_btn_3"
                    android:background="@drawable/ttlive_cash_exchange_attention"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/cancel_btn"
        android:background="@drawable/ttlive_bg_recharge_security_confirm_dialog_btn_cancel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="42dp"
        android:text="@string/ttlive_charge_security_confirm_cancel"
        android:lineHeight="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/confirm_checklist_container"
        app:layout_constraintRight_toLeftOf="@+id/ok_btn"
        app:layout_constraintTop_toBottomOf="@+id/confirm_checklist_container"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/ok_btn"
        android:background="@drawable/ttlive_bg_recharge_security_confirm_dialog_btn_ok"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="42dp"
        android:text="@string/ttlive_charge_security_confirm_ok"
        android:alpha="0.3"
        android:lineHeight="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cancel_btn"
        app:layout_constraintRight_toRightOf="@+id/confirm_checklist_container"
        app:layout_constraintTop_toBottomOf="@+id/confirm_checklist_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
