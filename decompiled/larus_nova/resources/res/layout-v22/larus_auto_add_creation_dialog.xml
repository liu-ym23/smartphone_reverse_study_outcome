<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_bottom_sheet"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginTop="?attr/larus_dp_15"
        android:layout_marginEnd="?attr/larus_dp_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_auto_add_close"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_56"
        android:text="@string/larus_ccMob_popupTitle_creationProfile_android"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="?attr/larus_dp_32"
        android:paddingEnd="?attr/larus_dp_32"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/star_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_32"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:id="@+id/icon_star"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_icon_sparkles_fill"
            android:layout_marginStart="?attr/larus_dp_32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/star_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_ccMob_popupHeader_creation"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_14"
            android:textFontWeight="600"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/icon_star"
            app:layout_constraintTop_toTopOf="@+id/icon_star"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/star_text_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:text="@string/larus_ccMob_popupDesc1_creation"
            android:paddingEnd="?attr/larus_dp_32"
            android:textFontWeight="400"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/star_text_title"
            app:layout_constraintTop_toBottomOf="@+id/star_text_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lock_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/star_container">
        <ImageView
            android:id="@+id/icon_lock"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_icon_lock_fill"
            android:layout_marginStart="?attr/larus_dp_32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/lock_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_ccMob_popupHeader_private"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_14"
            android:textFontWeight="600"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/icon_lock"
            app:layout_constraintTop_toTopOf="@+id/icon_lock"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/lock_text_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:text="@string/larus_ccMob_popupDesc_private"
            android:paddingEnd="?attr/larus_dp_32"
            android:textFontWeight="400"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/lock_text_title"
            app:layout_constraintTop_toBottomOf="@+id/lock_text_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/publish_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/lock_container">
        <ImageView
            android:id="@+id/icon_publish"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_icon_arrow_up_circle_fill"
            android:layout_marginStart="?attr/larus_dp_32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/publish_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_ccMob_popupHeader_post"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_14"
            android:textFontWeight="600"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/icon_publish"
            app:layout_constraintTop_toTopOf="@+id/icon_publish"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/publish_text_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:text="@string/larus_ccMob_popupDesc_post"
            android:paddingEnd="?attr/larus_dp_32"
            android:textFontWeight="400"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/publish_text_title"
            app:layout_constraintTop_toBottomOf="@+id/publish_text_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/confim"
        android:background="?attr/larus_auto_publish_confirm"
        android:layout_width="?attr/larus_dp_358"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_32"
        android:text="@string/larus_ccMob_popupBtn_ok"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/publish_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
