<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_window_secondary_page_head_back"
        android:background="@drawable/ec_window_ic_back_gray"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
        android:id="@+id/ec_window_secondary_page_head_author_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:bg_color="@color/white"
        app:bg_cornerRadius="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ec_window_secondary_page_head_back"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ec.core.widget.RoundedFrameLayout
            android:id="@+id/ec_window_secondary_page_head_avatar_wrapper"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rounded_radius="14dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ec_window_secondary_page_head_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="true"
                app:roundedCornerRadius="14dp"/>
        </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:ellipsize="end"
            android:id="@+id/ec_window_secondary_page_head_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ec_window_secondary_page_head_avatar_wrapper"
            app:layout_constraintRight_toLeftOf="@+id/ec_window_secondary_page_head_name_suffix"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:id="@+id/ec_window_secondary_page_head_name_suffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_window_name_suffix"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ec_window_secondary_page_head_name"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.commerce.uikit.roundedlayout.RoundedFrameLayout
            android:id="@+id/ec_window_secondary_page_head_entrance"
            android:background="@drawable/ec_window_secondary_head_entrance_bg"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintCircleRadius="24dp"
            app:layout_constraintLeft_toRightOf="@+id/ec_window_secondary_page_head_name_suffix"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_window_go_to_see"
                android:textFontWeight="500"/>
        </com.bytedance.commerce.uikit.roundedlayout.RoundedFrameLayout>
    </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_window_secondary_page_head_share"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
