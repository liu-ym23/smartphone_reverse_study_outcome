<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLlAnnouncementDialogRoot"
    android:background="@drawable/ttlive_bg_prelive_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlAnnouncementDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mIvBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_dynamic_back"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:id="@+id/mTvAnnouncementDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/ttlive_annocement"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/mTvAnnouncementDialogDividerLine1"
            android:background="@color/ttlive_douyin_dark_DialogDivider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:gravity="center_vertical"
                android:id="@+id/mTvAnnouncementDialogAuditStatus"
                android:background="@color/ttlive_douyin_BGBrand2"
                android:paddingLeft="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:drawableLeft="@drawable/ttlive_ic_announcement_dark_audit_stauts_tip"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/ttlive_ic_announcement_dark_audit_stauts_tip"
                android:paddingStart="15dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.livesdk.widget.MaxHeightScrollView
                android:id="@+id/annocement_main_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@+id/ttlive_announcement_btn_container"
                app:layout_constraintTop_toBottomOf="@+id/mTvAnnouncementDialogAuditStatus"
                app:maxHeight="350dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12dp"
                        android:textColor="@color/ttlive_announcement_remind_tip_color"
                        android:gravity="center"
                        android:id="@+id/mAnnouncementRemindTip"
                        android:background="@color/ttlive_announcement_remind_tip_bg_color"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:text="@string/ttlive_annocement_anchor_daily_max_save_time_remind_tip"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/mEnableSwitchArea"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/mAnnouncementRemindTip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_white_90"
                            android:id="@+id/mTvEnableAnnouncement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_annocement_enable"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/mEnableAnnouncementSwitch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            app:lsb_background="#57ffffff"
                            app:lsb_checked_color="#3bbf7d"
                            app:lsb_checkedbutton_color="#ffffff"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                        <View
                            android:id="@+id/mTvAnnouncementDialogDividerLine2"
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_marginTop="15dp"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_announcement_tips"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:minHeight="219dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/mEnableSwitchArea">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13dp"
                            android:textColor="@color/ttlive_std_text_white_4"
                            android:id="@+id/mTvAnnouncementTip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            app:layout_constraintTop_toBottomOf="@+id/mEnableSwitchArea"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/ttlive_std_text_white_4"
                            android:id="@+id/tv_announcement_tip2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/ttlive_advance_announcement_tip2"
                            android:lineSpacingExtra="3dp"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
                            android:id="@+id/iv_announcement_tip2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="124dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerCrop"
                            app:ttlive_radius="16dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/ttlive_std_text_white_4"
                            android:id="@+id/tv_announcement_tip3"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/ttlive_advance_announcement_tip3"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mAnnoucementMainActionArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/mEnableSwitchArea">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_90"
                                android:id="@+id/mTvAnnouncementDialogTimeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ttlive_annocement_startlive_time"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_50"
                                android:id="@+id/mTvAnnouncementDialogTimeDesc"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ttlive_annocement_select_tip"
                                android:drawableRight="@drawable/ttlive_ic_announcement_entry_arrow"
                                android:drawablePadding="8dp"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:drawableEnd="@drawable/ttlive_ic_announcement_entry_arrow"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/layout_fans_group_switch"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_90"
                                android:id="@+id/mTvAnnouncementDialogFanGroupTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ttlive_annocement_fan_group_attention"
                                android:layout_centerVertical="true"/>
                            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                                android:id="@+id/btn_fans_group_switch"
                                android:layout_width="43dp"
                                android:layout_height="25dp"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                app:lsb_background="#57ffffff"
                                app:lsb_checked_color="#3bbf7d"
                                app:lsb_checkedbutton_color="#ffffff"
                                app:lsb_effect_duration="50"
                                app:lsb_shadow_radius="0dp"
                                app:lsb_show_indicator="false"
                                app:lsb_uncheck_color="@color/transparent"
                                app:lsb_uncheckbutton_color="#d9ffffff"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/layout_fans_group_choose"
                            android:background="@drawable/ttlive_bg_announcement_fan_group_card"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginLeft="12dp"
                                android:layout_marginRight="12dp">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="13dp"
                                    android:textColor="@color/ttlive_white_90"
                                    android:id="@+id/mTvAnnouncementFanGroupTimeTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttlive_annocement_fan_group_attention_time"
                                    android:layout_centerVertical="true"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="13dp"
                                    android:textColor="@color/ttlive_white_50"
                                    android:id="@+id/mTvAnnouncementFanGroupTimeDesc"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttlive_annocement_select_tip"
                                    android:drawableRight="@drawable/ttlive_ic_announcement_entry_arrow"
                                    android:drawablePadding="4dp"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:drawableEnd="@drawable/ttlive_ic_announcement_entry_arrow"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_fan_group_list"
                                android:layout_width="match_parent"
                                android:layout_height="86dp"
                                android:layout_marginLeft="12dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginRight="12dp"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:id="@+id/mRlAnnouncementDialogToVideo"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_90"
                                android:id="@+id/mTvAnnouncementDialogToVideo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ttlive_annocement_startlive_to_video"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_50"
                                android:id="@+id/mTvAnnouncementDialogToVideoDesc"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/ttlive_ic_announcement_entry_arrow"
                                android:drawablePadding="8dp"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:drawableEnd="@drawable/ttlive_ic_announcement_entry_arrow"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/auto_publish_switch_parent"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/ttlive_white_90"
                                android:id="@+id/auto_publish_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ttlive_advance_announcement_auto_publish_switch"
                                android:layout_centerVertical="true"/>
                            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                                android:id="@+id/auto_publish_switch"
                                android:layout_width="43dp"
                                android:layout_height="25dp"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                app:lsb_background="#57ffffff"
                                app:lsb_checked="true"
                                app:lsb_checked_color="#3bbf7d"
                                app:lsb_checkedbutton_color="#ffffff"
                                app:lsb_effect_duration="50"
                                app:lsb_shadow_radius="0dp"
                                app:lsb_show_indicator="false"
                                app:lsb_uncheck_color="@color/transparent"
                                app:lsb_uncheckbutton_color="#d9ffffff"/>
                        </RelativeLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="15dp"
                            android:id="@+id/mTvAnnouncementDialogContentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/ttlive_annocement_content"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/mEtAnnouncementDialogEtContentParent"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginRight="15dp"
                            android:layout_marginBottom="20dp">
                            <EditText
                                android:textSize="13dp"
                                android:textColor="#ccffffff"
                                android:gravity="start|top"
                                android:id="@+id/mEtAnnouncementDialogContent"
                                android:background="@drawable/ttlive_bg_announcement_fan_group_card"
                                android:padding="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="@string/ttlive_annocement_content_hint"
                                android:inputType="textMultiLine"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/mLlAnnouncementSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent">
                                <TextView
                                    android:textSize="11dp"
                                    android:textColor="@color/ttlive_white"
                                    android:id="@+id/mTtAnnouncementSwitchContent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ttlive_annocement_content_change"
                                    android:drawableLeft="@drawable/ttlive_ic_announcement_dark_content_switch"
                                    android:drawablePadding="3dp"
                                    android:alpha="0.5"
                                    android:drawableStart="@drawable/ttlive_ic_announcement_dark_content_switch"/>
                                <TextView
                                    android:textSize="11dp"
                                    android:textColor="#ff0000"
                                    android:id="@+id/mTvAnnouncementInputTip"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
            <LinearLayout
                android:id="@+id/ttlive_announcement_btn_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="11dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_white_1"
                    android:gravity="center"
                    android:id="@+id/mTvAnnouncementSubmitBtn"
                    android:background="@drawable/ttlive_bg_announcement_submit_btn_selector"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="32dp"
                    android:text="@string/ttlive_annocement_save"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_white_1"
                    android:gravity="center"
                    android:id="@+id/mTvAnnouncementVideoBtn"
                    android:background="@drawable/ttlive_bg_announcement_submit_btn_selector"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="32dp"
                    android:text="@string/ttlive_annocement_save_and_publish"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/mDisableAllClick"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/mDcbLoadingView"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_douyin_dark_TextPrimary"
        android:gravity="center"
        android:id="@+id/mTvNetError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/ttlive_loading_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</FrameLayout>
