<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/cj_unify_asset_content_layout"
    android:paddingTop="@dimen/cj_pay_padding_14"
    android:paddingBottom="@dimen/cj_pay_padding_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingVertical="@dimen/cj_pay_padding_14">
    <RelativeLayout
        android:id="@+id/cj_unify_asset_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_unify_asset_icon"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_18"
            android:layout_height="@dimen/cj_pay_padding_18"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/cj_pay_unify_asset_icon_disable_mask"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_18"
            android:layout_height="@dimen/cj_pay_padding_18"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_15"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/cj_unify_asset_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="46dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
        <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
            android:gravity="center"
            android:id="@+id/cj_unify_asset_title_voucher_right"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/cj_unify_asset_title"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_12"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/cj_unify_pay_std_asset_guide"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="40dp"
            android:maxWidth="162dp"
            android:lines="1"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/cj_unify_asset_arrow"
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_icon_right_arrow_gray_40000000"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="#55161823"
        android:ellipsize="end"
        android:id="@+id/cj_unify_asset_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_marginRight="52dp"
        android:maxLines="2"
        android:includeFontPadding="false"/>
    <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
        android:gravity="left"
        android:id="@+id/cj_unify_asset_voucher"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="@dimen/cj_pay_padding_16"/>
    <HorizontalScrollView
        android:id="@+id/cj_unify_sub_asset_scroll_layout"
        android:paddingRight="0dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="@dimen/cj_pay_padding_8">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_unify_sub_asset_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_11"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
        android:ellipsize="end"
        android:id="@+id/cj_unify_asset_desc_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="@dimen/cj_pay_padding_6"
        android:layout_marginRight="52dp"
        android:maxLines="2"/>
</LinearLayout>
