<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/toast_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="210dp"
        android:scaleType="centerCrop"
        app:actualImageResource="@drawable/shop_entrance_check_toast_img"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:id="@+id/toast_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="当前渠道未注册"
        android:textFontWeight="600"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toast_img"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/toast_text"
        android:background="@color/white"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="「重要通知」进店渠道参数治理中，当前渠道未注册，将影响业务访问"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toast_title"/>
    <Button
        android:textColor="@color/black"
        android:id="@+id/toast_button"
        android:background="@drawable/shop_entrance_rounded_button"
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_marginTop="40dp"
        android:text="去登记"
        app:layout_constraintCircleRadius="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toast_text"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/commerce_color_57161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="有问题联系 @zhengwen.col 或 @chenlong.hz"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toast_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
