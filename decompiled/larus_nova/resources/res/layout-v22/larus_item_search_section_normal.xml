<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_search_item"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_4"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/larus_dp_16"
    android:paddingVertical="?attr/larus_dp_4">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/section_name_text"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="?attr/larus_dp_12"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/section_unread_red_dot"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.RedDotTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/section_unread_red_dot"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_22"
        android:layout_height="?attr/larus_dp_22"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
