<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/album_list"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_sync_banner"/>
    <com.larus.avlink.gallery.view.AlbumSyncBanner
        android:id="@+id/album_sync_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_58"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_15"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/calendar_indicator"
        android:background="@drawable/bg_album_list_date_indicator"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_10"
        android:layout_marginTop="?attr/larus_dp_10"
        android:text="Dec 5, 2024"
        android:layout_marginStart="?attr/larus_dp_10"
        android:paddingHorizontal="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_sync_banner"/>
    <include
        android:id="@+id/album_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_sync_banner"
        layout="@layout/larus_page_album_list_empty"/>
    <include
        android:id="@+id/album_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/larus_account_dialog"/>
    <include
        android:id="@+id/album_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/larus_page_album_error"/>
    <View
        android:id="@+id/albumion_item_cover"
        android:background="@color/larus_neutral_transparent_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="@+id/album_list"
        app:layout_constraintStart_toStartOf="@+id/album_list"
        app:layout_constraintTop_toTopOf="@+id/album_list"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_15"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/album_inject_entry"
        android:background="@drawable/bg_album_list_date_indicator"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10"
        android:text="灌测"
        android:layout_marginEnd="?attr/larus_dp_10"
        android:paddingHorizontal="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_sync_banner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
