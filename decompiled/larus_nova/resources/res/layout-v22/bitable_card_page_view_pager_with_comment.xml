<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/bg_base"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.ScrollControlViewPager
        android:layout_gravity="bottom"
        android:id="@+id/bitable_card_view_pager"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/switch_card_view"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottomInnerContainer"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.image.UDAvatar
                android:id="@+id/userAvatar"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ud_avatar_borderWidth="0dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/commentLayout"
                android:background="@drawable/bitable_record_comment_input_bg"
                android:paddingLeft="12dp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/inputHolderTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/commentCount"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:gravity="center_vertical"
                    android:id="@+id/commentCount"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableLeft="@drawable/ud_icon_chat_outlined"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/icon_n2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pre_record"
                    android:padding="16dp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:tint="@color/facade_selector_icon_n1"
                    app:srcCompat="@drawable/ud_icon_left_outlined"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/record_index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/next_record"
                    android:padding="16dp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:tint="@color/facade_selector_icon_n1"
                    app:srcCompat="@drawable/ud_icon_right_outlined"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
