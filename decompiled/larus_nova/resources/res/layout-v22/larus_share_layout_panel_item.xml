<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/img_app_icon"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/fl_app_loading"
        android:background="@drawable/larus_share_channel_icon_save_background"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_app_loading"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
            android:indeterminateDuration="1000"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_app_name"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:maxLines="2"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="?attr/larus_sp_12"
        android:autoSizeMaxTextSize="?attr/larus_sp_13"/>
</LinearLayout>
