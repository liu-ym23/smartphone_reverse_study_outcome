<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/office_sdk_mm_ic_back_doubao"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/flow_ud_neutral_100"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvTitleInBar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightIconFlow"
        app:layout_constraintStart_toEndOf="@+id/ivClose"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="20dp"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/rightIconFlow"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        app:constraint_referenced_ids="ivAIInterpretation,ivLanguage,ivSettings,ivMore,ivShare"
        app:flow_horizontalGap="4dp"
        app:flow_horizontalStyle="packed"
        app:flow_verticalAlign="center"
        app:flow_wrapMode="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLanguage"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:srcCompat="@drawable/office_sdk_mm_ic_translate_doubao"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAIInterpretation"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:srcCompat="@drawable/ud_icon_language_ai_outlined"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSettings"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:srcCompat="@drawable/office_sdk_mm_ic_audio_save_setting_doubao"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivMore"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:srcCompat="@drawable/office_sdk_mm_ic_more_doubao"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivShare"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@color/flow_ud_neutral_100"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:srcCompat="@drawable/ud_icon_share_outlined"/>
</merge>
