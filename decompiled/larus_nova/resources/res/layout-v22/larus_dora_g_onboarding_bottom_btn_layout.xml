<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dora_g_onboarding_bottom_btn_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_dora_g_onboarding_next_text_color"
        android:gravity="center"
        android:id="@+id/dora_g_onboarding_bottom_btn_top"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="?attr/larus_dp_56"
        android:minHeight="?attr/larus_dp_56"
        android:text="@string/larus_dora_environmental_observation_onboarding_agree_cn"
        android:textFontWeight="500"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/dora_g_onboarding_top_margin"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_30"/>
    <View
        android:id="@+id/dora_g_onboarding_top_bottom_margin"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_12"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/dora_g_onboarding_bottom_btn_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="?attr/larus_dp_56"
        android:minHeight="?attr/larus_dp_56"
        android:text="@string/larus_dora_g_onboard_set_later_cn"
        android:textFontWeight="500"/>
</LinearLayout>
