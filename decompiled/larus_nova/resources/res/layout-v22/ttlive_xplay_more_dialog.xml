<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_more_dialog"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/title_bar"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            app:failureImage="@drawable/ttlive_open_feature_icon_default"
            app:placeholderImage="@drawable/ttlive_open_feature_icon_default"
            app:roundedCornerRadius="2dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#bf000000"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toRightOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/ttlive_xplay_more_dialog_ic_arrow_right"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/btn_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/play_rule_container"
        android:background="@drawable/ttlive_xplay_more_dialog_play_rule_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_list">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:text="@string/ttlive_xplay_more_dialog_play_rule_title"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/play_rule_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/clear_screen_container"
        android:background="@drawable/ttlive_bg_more_dialog_clear_screen_btn"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/exit_button"
        app:layout_constraintTop_toBottomOf="@+id/play_rule_container">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="21dp">
            <ImageView
                android:id="@+id/clear_screen_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ttlive_ic_interact_play_exit_clear_sn_black"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:id="@+id/clear_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_exit_clear_screen"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#66161823"
            android:id="@+id/clear_screen_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#fe2c55"
        android:gravity="center"
        android:id="@+id/exit_button"
        android:background="@drawable/ttlive_bg_more_dialog_exit_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_xplay_more_quit_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clear_screen_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
