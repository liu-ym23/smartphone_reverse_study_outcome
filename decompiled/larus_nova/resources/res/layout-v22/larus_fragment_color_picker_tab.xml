<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <View
            android:background="@drawable/larus_bg_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/chameleonv1_ud_icon_left_outlined"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_alignParentStart="true"
            app:tint="@color/larus_neutral_100"/>
        <com.google.android.material.tabs.TabLayout
            android:textSize="?attr/larus_dp_17"
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lines="1"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"
            app:tabIndicatorColor="@color/larus_neutral_100"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabMinWidth="64dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="8dp"
            app:tabPaddingStart="8dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/larus_neutral_100"
            app:tabTextColor="@color/larus_neutral_50"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="#007aff"
            android:gravity="center"
            android:id="@+id/tv_no_fill"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/larus_LarkCCM_SlidesMobile_Highlight_NoFill_Button"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="21dp"
            android:layout_alignParentEnd="true"
            android:textFontWeight="500"/>
        <View
            android:id="@+id/divider"
            android:background="@drawable/larus_bg_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
