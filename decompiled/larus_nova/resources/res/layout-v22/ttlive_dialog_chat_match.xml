<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/chat_match_container"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/topView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_fast_match_title_container_height"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_interact_ic_match_success"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tvMatchTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_anchor_link_cancel_apply"/>
    </LinearLayout>
    <View
        android:id="@+id/split_line"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="0.5px"
        app:layout_constraintTop_toBottomOf="@+id/topView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/body"
        android:background="@drawable/ttlive_interact_bg_match_body"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_fast_match_search_container_height"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/ttlive_fast_match_search_container_margin"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/ttlive_fast_match_search_container_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topView">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ivHead"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImageScaleType="fitXY"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#e6161823"
            android:id="@+id/fast_match_tip_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:text="@string/ttlive_fast_match_tip"
            android:layout_marginStart="9dp"
            android:lineHeight="21dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/ivHead"
            app:layout_constraintLeft_toRightOf="@+id/ivHead"
            app:layout_constraintTop_toTopOf="@+id/ivHead"/>
        <ImageView
            android:id="@+id/ivGender"
            android:visibility="invisible"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivHead"
            app:layout_constraintEnd_toEndOf="@+id/ivHead"/>
        <com.bytedance.android.livesdk.widget.desc.CountDownWithDescTextView
            android:textStyle="bold"
            android:id="@+id/btn"
            android:background="@drawable/ttlive_btn_match_chat"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="63dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tvBodyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="95dp"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="95dp"
            app:layout_constraintBottom_toTopOf="@+id/tvBodyDes"
            app:layout_constraintStart_toEndOf="@+id/ivHead"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#57000000"
            android:ellipsize="end"
            android:id="@+id/tvBodyDes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="95dp"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="95dp"
            app:layout_constraintBottom_toTopOf="@+id/topicListBody"
            app:layout_constraintStart_toEndOf="@+id/ivHead"
            app:layout_constraintTop_toBottomOf="@+id/tvBodyTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/topicListBody"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn"
            app:layout_constraintStart_toEndOf="@+id/ivHead"
            app:layout_constraintTop_toBottomOf="@+id/tvBodyDes"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/body_with_rematch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_fast_match_result_v2_container_height"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
