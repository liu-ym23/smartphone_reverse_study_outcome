<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="6dp"
    style="@style/UDShadow.S4.Down">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/long_click_menu_root"
        android:background="@drawable/ai_note_long_click_menu_bg"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/restore_layout"
            android:background="@drawable/ai_note_long_click_menu_item_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_undo_outlined"
                app:tint="@color/icon_n2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_PersonalNotes_RestoreOriginal_Button"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/copy_layout"
            android:background="@drawable/ai_note_long_click_menu_item_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_copy_outlined"
                app:tint="@color/icon_n2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_Common_Copy_Button"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/delete_layout"
            android:background="@drawable/ai_note_long_click_menu_item_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_delete_trash_outlined"
                app:tint="@color/icon_n2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_PersonalNotes_Delete_Button"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
