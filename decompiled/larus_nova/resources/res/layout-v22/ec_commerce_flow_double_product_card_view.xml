<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/double_feed_product_card_root_view"
    android:background="@color/commerce_color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="6dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/ec_commerce_double_feed_product_card_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        app:layoutMode="square"
        app:placeholderImage="@drawable/commerce_promotion_place_holder"
        app:placeholderImageScaleType="centerCrop"/>
    <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardTitleView
        android:id="@+id/ec_commerce_double_feed_product_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="10dp"/>
    <com.bytedance.android.shopping.feed.widget.SellPointView
        android:id="@+id/selling_points_view"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="10dp"/>
    <com.bytedance.android.shopping.anchorv3.detail.widget.InflowFeedServiceView
        android:id="@+id/service_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/price_and_buy_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="10dp">
        <com.bytedance.android.shopping.feed.widget.TinyCardPriceView
            android:layout_gravity="center_vertical"
            android:id="@+id/ec_commerce_double_feed_product_card_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#ff0050"
            android:layout_gravity="center_vertical"
            android:id="@+id/double_feed_product_card_buy_button"
            android:background="@drawable/ec_commerce_feed_product_double_feed_buy_border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tiny_card_buy_button_text"/>
    </LinearLayout>
</com.bytedance.android.ec.core.widget.RoundedLinearLayout>
