<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/more_items_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.keyboard.biz.plus.LarkKeyBoardMorePanel
        android:gravity="center_horizontal"
        android:id="@+id/more_items_panel"
        android:background="@color/bg_body_overlay"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"/>
    <FrameLayout
        android:gravity="center_horizontal"
        android:id="@+id/more_items_panel_view_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
