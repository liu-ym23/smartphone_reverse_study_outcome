<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/bg_body"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_icon"
        android:layout_width="54sp"
        android:layout_height="match_parent"
        android:tint="@color/icon_n1"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_10"
        app:srcCompat="@drawable/ud_icon_left_outlined"/>
    <TextView
        android:textSize="@dimen/sp_17"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/task_container_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_title_share"
        android:layout_width="50sp"
        android:layout_height="match_parent"
        android:tint="@color/icon_n1"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_10"
        app:srcCompat="@drawable/ud_icon_share_outlined"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_title_more"
        android:layout_width="50sp"
        android:layout_height="match_parent"
        android:tint="@color/icon_n1"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_16"
        app:srcCompat="@drawable/ud_icon_more_outlined"/>
</LinearLayout>
