<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dora_device_single_product_display"
    android:paddingBottom="?attr/larus_dp_16"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dora_device_img"
        android:layout_width="?attr/larus_dp_390"
        android:layout_height="?attr/larus_dp_260"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_device_img">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/dora_device_headphone_mode"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_5"
            android:text="@string/larus_dora_headphone_mode_cn"
            android:textFontWeight="400"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/dora_device_connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_connected_img"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_connected_battery"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/dora_device_connected_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_box_connected_img"
                app:layout_constraintStart_toEndOf="@+id/dora_device_connected_img"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/larus_dora_device_battery_layout"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_box_connected_img"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginStart="?attr/larus_dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_box_connected_battery"
                app:layout_constraintStart_toEndOf="@+id/dora_device_connected_battery"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/dora_device_box_connected_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_device_box_connected_img"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/larus_dora_device_battery_layout"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/dora_device_disconnected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_device_state_disconnected_cn"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_device_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
