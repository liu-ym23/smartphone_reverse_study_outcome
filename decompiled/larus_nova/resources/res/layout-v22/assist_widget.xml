<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/assist_card_root"
    android:background="@drawable/widget_bg_waiting"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="140dp">
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:id="@+id/assist_card_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="暂停中"
        android:layout_marginStart="4dp"
        style="@style/Label_L"/>
    <ImageView
        android:id="@+id/assist_card_app_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerInside"
        android:layout_below="@+id/assist_card_status_text"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
    <ImageView
        android:id="@+id/assist_card_status_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/o_ic_download_failed"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textColor="@color/oui_ai_a_color3_6"
        android:ellipsize="end"
        android:id="@+id/assist_card_content_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:maxLines="1"
        android:layout_below="@+id/assist_card_status_text"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/assist_card_app_icon"
        style="@style/Body_L"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/assist_card_btn_group"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/assist_card_btn_1"
            android:background="@drawable/assist_btn_bg_grey"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/assist_card_btn_1_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/o_ic_close_circle_filled"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="#000000"
                android:id="@+id/assist_card_btn_1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="停止"
                style="@style/BtnLabel_M2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/assist_card_btn_2"
            android:background="@drawable/assist_btn_bg_gradient"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/assist_card_btn_2_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/oic_hand_right_ai_fill"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="@color/oui_ai_a_color2_6"
                android:id="@+id/assist_card_btn_2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BtnLabel_M2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/assist_card_btn_3"
            android:background="@drawable/assist_btn_bg_gradient"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/assist_card_btn_3_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/oic_hand_right_ai_fill"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="@color/oui_ai_a_color2_6"
                android:id="@+id/assist_card_btn_3_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BtnLabel_M2"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
