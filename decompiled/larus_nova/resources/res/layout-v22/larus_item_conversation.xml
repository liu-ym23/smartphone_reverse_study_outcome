<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        android:layout_marginHorizontal="?attr/larus_dp_8">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/bot_recommend_divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/bot_recommend_hit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:text="@string/larus_bot_chat_title_recommend"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/bot_recommend_left_divider"
                android:background="?attr/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="1px"
                android:layout_marginStart="?attr/larus_dp_8"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/bot_recommend_hit"
                app:layout_constraintEnd_toStartOf="@+id/bot_recommend_hit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bot_recommend_hit"/>
            <View
                android:id="@+id/bot_recommend_right_divider"
                android:background="?attr/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="1px"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/bot_recommend_hit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bot_recommend_hit"
                app:layout_constraintTop_toTopOf="@+id/bot_recommend_hit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inner_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bot_recommend_divider"
            app:layout_goneMarginTop="0dp">
            <View
                android:id="@+id/header"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/footer"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
                android:id="@+id/avatar_parent"
                android:layout_width="?attr/larus_conversation_list_avatar_size"
                android:layout_height="?attr/larus_conversation_list_avatar_size"
                android:layout_marginTop="?attr/larus_dp_10"
                android:layout_marginBottom="?attr/larus_dp_10"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toTopOf="@+id/footer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="?attr/larus_conversation_list_avatar_size"
                    android:layout_height="?attr/larus_conversation_list_avatar_size"
                    app:placeholderImage="?attr/larus_neutral_transparent_1"/>
                <RelativeLayout
                    android:id="@+id/avatar_merge"
                    android:layout_width="?attr/larus_conversation_list_avatar_size"
                    android:layout_height="?attr/larus_conversation_list_avatar_size">
                    <com.larus.bmhome.view.ArcAvatarImageView
                        android:id="@+id/avatar_behind"
                        android:layout_width="?attr/larus_dp_40"
                        android:layout_height="?attr/larus_dp_40"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        app:placeholderImage="?attr/larus_neutral_transparent_1"
                        app:roundAsCircle="true"/>
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/avatar_front"
                        android:layout_width="?attr/larus_dp_40"
                        android:layout_height="?attr/larus_dp_40"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        app:roundAsCircle="true"/>
                </RelativeLayout>
            </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
            <com.larus.common_ui.widget.AvatarTagView
                android:id="@+id/avatar_tag_icon_rb"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                app:layout_constraintCircle="@+id/avatar_parent"
                app:layout_constraintCircleAngle="135"
                app:layout_constraintCircleRadius="30dp"/>
            <FrameLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/bot_name_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toTopOf="@+id/brief"
                app:layout_constraintEnd_toStartOf="@+id/right_action"
                app:layout_constraintStart_toEndOf="@+id/avatar_parent"
                app:layout_constraintTop_toTopOf="@+id/avatar_parent">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="?attr/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="?attr/larus_dp_6"
                        android:textFontWeight="600"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_immersive_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="?attr/larus_dp_18"
                        android:paddingEnd="?attr/larus_dp_4"
                        app:srcCompat="@drawable/larus_ic_bot_immersive"/>
                    <TextView
                        android:textSize="?attr/larus_dp_11"
                        android:textColor="?attr/larus_primary_50"
                        android:gravity="center"
                        android:id="@+id/tag"
                        android:background="?attr/larus_bg_chat_title_tag"
                        android:paddingLeft="?attr/larus_dp_6"
                        android:paddingTop="?attr/larus_dp_3"
                        android:paddingRight="?attr/larus_dp_6"
                        android:paddingBottom="?attr/larus_dp_3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="?attr/larus_dp_6"
                        android:paddingVertical="?attr/larus_dp_3"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/brief"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                android:maxLines="1"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_parent"
                app:layout_constraintEnd_toStartOf="@+id/right_action"
                app:layout_constraintStart_toStartOf="@+id/bot_name_container"
                app:layout_constraintTop_toBottomOf="@+id/bot_name_container"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.larus.bmhome.chat.layout.widget.CvsItemRightAction
                android:id="@+id/right_action"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header"/>
            <View
                android:id="@+id/divider"
                android:background="?attr/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="1px"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/bot_name_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/right_action_click_rect"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_52"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/load_more_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:indeterminate="true"
            android:indeterminateDuration="750"
            android:indeterminateTint="?attr/larus_neutral_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/error_lay"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="?attr/larus_dp_13"
                android:layout_height="?attr/larus_dp_16"
                app:srcCompat="?attr/larus_ic_refresh_gray"/>
            <TextView
                android:textColor="?attr/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_chat_list_load_failed"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
