<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/larus_bg_bottom_sheet"
        android:paddingBottom="?attr/larus_dp_48"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/dora_dialog_connect_failed_title"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_dora_connect_failed_dialog_title_cn"
            android:textFontWeight="600"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.business.markdown.impl.markwon.MarkdownTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/dora_dialog_connect_failed_msg"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_11"
            android:layout_marginRight="?attr/larus_dp_24"
            android:layout_marginHorizontal="?attr/larus_dp_24"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_dialog_connect_failed_title"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/dora_dialog_connect_failed_retry_btn"
            android:background="@drawable/larus_dora_btn_bg"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_76"
            android:layout_marginRight="?attr/larus_dp_24"
            android:text="@string/larus_dora_btn_retry_cn"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="?attr/larus_dp_24"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_dialog_connect_failed_msg"
            app:layout_constraintWidth_max="?attr/larus_dp_420"/>
        <ImageView
            android:id="@+id/dora_dialog_connect_failed_close_btn"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_14"
            android:src="@drawable/larus_dora_onboarding_close_btn"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
