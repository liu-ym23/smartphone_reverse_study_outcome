<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_anchorv3_product_format_item_layout_1797603415"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/commerce_color_161823"
        android:id="@+id/anchor_v3_tv_product_format_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.RoundedFrameLayout
            android:id="@+id/anchor_v3_rfl_brand_logo"
            android:background="@drawable/shopping_brand_logo_stroke"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginVertical="2dp"
            app:rounded_radius="2dp">
            <com.bytedance.android.shopping.widget.legacy.SquareImageView
                android:layout_gravity="center"
                android:id="@+id/anchor_v3_brand_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:actualImageScaleType="fitCenter"
                app:roundedCornerRadius="16dp"/>
        </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/commerce_color_161823"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/anchor_v3_tv_product_format_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp"
            android:layout_marginVertical="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/anchor_v3_ll_qualification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/anchor_v3_qualification_context"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/anchor_v3_brand_certificate"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="2dp"
                android:layout_marginVertical="2dp"
                app:srcCompat="@drawable/commerce_anchor_v3_brand_certificate"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/commerce_color_brand_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/anchor_v3_brand_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="4dp"
                android:layout_marginVertical="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/anchor_v3_ll_go_to_qualification"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/commerce_pay_color_gray_161823_opacity_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/anchor_v3_go_to_qualification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:text="@string/commerce_anchor_v3_go_to_qualification"
                android:layout_marginStart="4dp"
                android:layout_marginVertical="3dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/commerce_anchor_v3_go_to_arrow"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
