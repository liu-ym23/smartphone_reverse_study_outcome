<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/applicaitonIcon"
        android:background="@drawable/larus_icon_back"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/applicationName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="@+id/applicaitonIcon"
        app:layout_constraintStart_toEndOf="@+id/applicaitonIcon"
        app:layout_constraintTop_toTopOf="@+id/applicaitonIcon"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/mainDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:textFontWeight="600"
        app:layout_constraintStart_toStartOf="@+id/applicaitonIcon"
        app:layout_constraintTop_toBottomOf="@+id/applicaitonIcon"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/neutral_70"
        android:id="@+id/subDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/applicaitonIcon"
        app:layout_constraintTop_toBottomOf="@+id/mainDescription"/>
    <com.larus.common_ui.widget.roundlayout.RoundLinearLayout
        android:orientation="vertical"
        android:id="@+id/positionButton"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subDescription"
        app:rv_backgroundColor="@color/primary_50"
        app:rv_cornerRadius="?attr/larus_dp_16">
        <TextView
            android:textSize="@dimen/dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/positionButtonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_13"/>
        <TextView
            android:textSize="@dimen/dp_13"
            android:textColor="@color/static_white_transparent_4"
            android:gravity="center"
            android:id="@+id/positiveButtonSubText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"/>
    </com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/negativeButton"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/positionButton"
        app:rv_backgroundColor="@color/neutral_transparent_1"
        app:rv_cornerRadius="?attr/larus_dp_16">
        <TextView
            android:textSize="@dimen/dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_black"
            android:gravity="center"
            android:id="@+id/negativeButtonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_13"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
