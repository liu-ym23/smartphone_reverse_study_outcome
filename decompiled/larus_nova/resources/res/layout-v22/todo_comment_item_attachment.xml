<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/layout_attachment_container"
        android:background="@drawable/todo_attachment_background"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingVertical="12dp"
        app:rl_radius="4sp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_attachment_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_attachment_icon"
                android:layout_width="36sp"
                android:layout_height="36sp"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/dp_16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="middle"
                    android:id="@+id/text_attachment_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/text_attachment_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/primary_fill_default"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/detail_attachment_more"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="4dp"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Todo_ViewMoreAttachments_Button"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="4dp"/>
</LinearLayout>
