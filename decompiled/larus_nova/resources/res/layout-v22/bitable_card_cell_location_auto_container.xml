<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/auto_location_container"
        android:paddingTop="@dimen/space_kit_len_9"
        android:paddingBottom="@dimen/space_kit_len_9"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/auto_location_state_common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_kit_len_4">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/space_kit_len_16"
                    android:layout_height="@dimen/space_kit_len_16"
                    android:layout_marginTop="0.1dp"
                    android:tint="@color/icon_n1"
                    app:srcCompat="@drawable/ud_icon_located_outlined"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Field_GetCurrentLocation"
                android:lineHeight="@dimen/space_kit_font_20"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/auto_location_state_getting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.card.view.cell.location.view.LoadingView
                android:id="@+id/auto_location_state_getting_icon"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_4"
                app:centerRadius="4.5dp"
                app:loadingColor="@color/primary_fill_default"
                app:strokeWidth="1.5dp"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/udtoken_component_text_disabled_loading"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Field_GettingLocation"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/location_des_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:layout_gravity="center"
            android:id="@+id/location_title"
            android:paddingTop="@dimen/space_kit_len_9"
            android:paddingBottom="@dimen/space_kit_len_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/space_kit_len_13"
            android:paddingEnd="@dimen/space_kit_len_13"/>
        <FrameLayout
            android:id="@+id/location_edit_icon_container"
            android:layout_width="@dimen/space_kit_len_26"
            android:layout_height="@dimen/space_kit_len_26"
            android:layout_marginEnd="@dimen/space_kit_len_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/location_edit_icon_common"
                android:visibility="visible"
                android:layout_width="@dimen/space_kit_len_18"
                android:layout_height="@dimen/space_kit_len_18"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_refresh_outlined"/>
            <com.bytedance.ee.bear.bitable.card.view.cell.location.view.LoadingView
                android:layout_gravity="center"
                android:id="@+id/location_edit_icon_loading"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_18"
                android:layout_height="@dimen/space_kit_len_18"
                app:centerRadius="@dimen/space_kit_len_5"
                app:loadingColor="@color/primary_fill_default"
                app:strokeWidth="@dimen/space_kit_len_2"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
