<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:name="retry_view"
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_retry_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginVertical="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/retryButton"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_comment_arrow_clockwise"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/retryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_inapp_search_no_internet"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/retryButton"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
