<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.player.FullVideoView
        android:id="@+id/item_feeditem_videoview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/video_bottom_mask"
        android:background="@drawable/aos_feed_bottom_linear_gradient"
        android:layout_width="match_parent"
        android:layout_height="314dp"
        android:layout_alignParentBottom="true"/>
    <com.bytedance.awemeopen.apps.framework.base.view.DiggLayout
        android:id="@+id/item_digg_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/item_gesture_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/feed_page"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aos_uikit_t_primary_dark"
        android:id="@+id/fullscreen_watch"
        android:background="@drawable/aos_outline_grey_half_dp"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="全屏观看"
        android:drawablePadding="4dp"
        android:layout_centerHorizontal="true"
        android:drawableStart="@drawable/aos_ic_switch_fullscreen"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/series_lock_page"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/pause_btn"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:src="@drawable/aos_legacy_ic_play_pause"
        android:layout_centerInParent="true"/>
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/debug_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
</com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView>
