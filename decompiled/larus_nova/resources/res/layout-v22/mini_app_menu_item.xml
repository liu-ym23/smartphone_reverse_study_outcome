<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/mini_app_menu_container_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_56">
    <FrameLayout
        android:id="@+id/fl_image_container"
        android:visibility="visible"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_mini_app_menu_image"
            android:visibility="visible"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <com.obric.oui.text.OTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/oui_text_1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_mini_app_menu_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/dp_10"
        android:textFontWeight="480"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fl_image_container"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
