<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.view.ReplySuggestList
        android:id="@+id/reply_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="?attr/larus_dp_196"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/reply_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="?attr/larus_dp_196"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reply_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/reply_close"
        app:layout_constraintEnd_toStartOf="@+id/reply_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/reply_close"
        app:srcCompat="?attr/larus_ic_reply_rect"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:id="@+id/reply_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_4"
        android:lineHeight="?attr/larus_dp_20"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="@+id/reply_close"
        app:layout_constraintEnd_toStartOf="@+id/reply_close"
        app:layout_constraintStart_toEndOf="@+id/reply_hint"
        app:layout_constraintTop_toTopOf="@+id/reply_close"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reply_close"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:scaleType="center"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:layout_marginVertical="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reply_text"
        app:layout_constraintTop_toBottomOf="@+id/reply_list"
        app:srcCompat="?attr/larus_ic_icon_reply_close"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
