<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/larus_minor_password_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_btn"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_password_close"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/minor_icon"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_40"
        android:src="@drawable/larus_icon_minor_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/minor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_teenagerMode_onboarding_modeName_parent_cn"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minor_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/minor_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_teenagerMode_desc_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minor_title"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/set_never_minor"
        android:background="@drawable/larus_ic_password_button_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_teenagerMode_onboarding_button_skip_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/minor_sub_title"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_primary_50"
        android:gravity="center_horizontal"
        android:id="@+id/button_later"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:text="@string/larus_teenagerMode_onboarding_button_more_cn"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/set_never_minor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
