<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.interactivity.medialink.ui.MediaMultiAnchorPauseTipsView
        android:id="@+id/pause_view"
        android:background="@drawable/ttlive_bg_media_rematch_anchor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:id="@+id/top_info_linear_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/inter_comment_container"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp">
            <com.bytedance.android.livesdk.interactivity.medialink.intercomment.MediaInteractCommentView
                android:layout_gravity="center"
                android:id="@+id/inter_comment_icon_view"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="end|top"
            android:id="@+id/cl_mute"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="7dp"
            android:layout_marginEnd="7dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_mute"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                app:actualImageScaleType="fitXY"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/ttlive_pk_no_mute_icon"
                app:placeholderImageScaleType="fitXY"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/link_ext_score_tv"
            android:background="@drawable/ttlive_bg_media_anchor_link_ext_score_blue"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:minWidth="24dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_anchor_info_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottom_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.interactivity.medialink.ui.layout.MediaMultiAnchorGuestInfoLayout
                android:id="@+id/ttlive_guest_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="start|top"
        android:orientation="horizontal"
        android:id="@+id/top_left_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <com.bytedance.android.livesdk.interactivity.medialink.ui.layout.MediaMultiAnchorGuestInfoCleanScreenLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/ttlive_guest_info_clear_screen"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:layout_gravity="start|bottom"
        android:id="@+id/owner_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/ttlive_media_mulit_link_owner_label"
        android:layout_marginStart="4dp"
        android:textFontWeight="500"/>
    <View
        android:layout_gravity="bottom|right"
        android:id="@+id/view_follow"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="44dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cover"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.3"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:text="@string/ttlive_media_anchor_link_cover_tips"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.3"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_red"
        android:layout_gravity="center"
        android:id="@+id/debug_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"/>
</merge>
