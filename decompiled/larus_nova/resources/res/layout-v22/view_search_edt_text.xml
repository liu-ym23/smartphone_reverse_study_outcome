<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@color/bg_body"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="38dp">
    <View
        android:id="@+id/search_bg_view"
        android:background="@drawable/bg_search_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.suite.lark.emm.autofocus.AutoFocusEditText
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:textColorHighlight="@color/ud_B500_15"
        android:textColorHint="@color/text_placeholder"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/search_edt_txt"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/Lark_Legacy_Search"
        android:singleLine="true"
        android:inputType="text"
        android:textCursorDrawable="@drawable/text_cursor_drawable"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:importantForAutofill="no"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/search_icon_iv"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ud_icon_search_outline_outlined"
        android:tint="@color/icon_n3"
        android:contentDescription="@string/Lark_Legacy_Search"
        android:layout_marginStart="@dimen/dp_12"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/search_clear_iv"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ud_icon_close_filled"
        android:tint="@color/icon_n3"
        android:contentDescription="@string/Lark_Legacy_Cancel"
        android:layout_marginEnd="@dimen/dp_12"/>
</FrameLayout>
