<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.bytedance.android.gamecp.common.ui.UserAvatarImageView
        android:id="@+id/iv_comment_detail_reply_item_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/gamecp_game_promote_comment_default_avatar_bg"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_99161823"
        android:id="@+id/tv_comment_detail_reply_item_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_reply_item_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_reply_item_avatar"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:id="@+id/tv_comment_official_title"
        android:background="@drawable/shape_bg_game_comment_official_tag"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="@+id/tv_comment_detail_reply_item_nickname"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_reply_item_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_comment_detail_reply_item_nickname"
        app:layout_constraintVertical_bias="0.6"/>
    <ImageView
        android:id="@+id/iv_comment_option"
        android:background="@drawable/gamecp_ic_comment_options"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_game_57161823"
        android:id="@+id/tv_comment_detail_reply_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cl_comment_detail_reply_item_like_container"
        app:layout_constraintStart_toStartOf="@+id/tv_comment_detail_reply_item_content"
        app:layout_constraintTop_toTopOf="@+id/cl_comment_detail_reply_item_like_container"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_BF161823"
        android:id="@+id/tv_comment_detail_reply_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_reply_item_nickname"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_reply_item_like_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_reply_item_content">
        <ImageView
            android:id="@+id/iv_comment_detail_reply_item_like"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gamecp_ic_game_promote_comment_like_v2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_comment_detail_reply_item_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_reply_item_like"
            app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_reply_item_like"
            app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_reply_item_like"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
