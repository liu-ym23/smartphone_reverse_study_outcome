<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:gravity="center"
        android:id="@+id/dialog_top_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_25"/>
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="400"/>
    <View
        android:id="@+id/dialog_btn1_divider"
        android:background="?attr/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_24"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dialog_btn1"
        android:background="?attr/larus_bg_common_menu_item_middle"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="500"/>
    <View
        android:id="@+id/dialog_btn2_divider"
        android:background="?attr/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dialog_btn2"
        android:background="?attr/larus_bg_common_menu_item_middle"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="500"/>
    <View
        android:id="@+id/dialog_btn3_divider"
        android:background="?attr/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dialog_btn3"
        android:background="?attr/larus_bg_common_menu_item_last"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="400"/>
</LinearLayout>
