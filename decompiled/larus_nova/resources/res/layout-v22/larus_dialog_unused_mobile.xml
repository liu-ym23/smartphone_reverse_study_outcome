<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close_dialog"
        android:padding="?attr/larus_dp_12"
        android:layout_width="?attr/larus_dp_52"
        android:layout_height="?attr/larus_dp_52"
        android:src="@drawable/larus_auto_add_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="?attr/larus_dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_48"
            android:layout_marginRight="?attr/larus_dp_16"
            android:text="@string/larus_mobile_can_use_normally_cn"
            android:layout_marginHorizontal="?attr/larus_dp_16"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/text_bind_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_16"
            android:text="@string/larus_mobile_phone_number_lost_cn"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            android:textFontWeight="400"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/button_confirm"
            android:background="@drawable/larus_auto_publish_confirm"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_32"
            android:layout_marginRight="?attr/larus_dp_16"
            android:text="@string/larus_toast_confirm_cn"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            android:textFontWeight="600"/>
    </LinearLayout>
</FrameLayout>
