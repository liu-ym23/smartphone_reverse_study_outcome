<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_remind_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:lineHeight="33.6dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_vertical_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse4"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_remind_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lines="1"
        android:lineHeight="21dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line_vertical_60"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_line_vertical_60"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.6"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_text_TextReverse"
        android:ellipsize="end"
        android:id="@+id/btn_remind_manager_usage"
        android:background="@drawable/ttlive_anti_addiction_bg_white_radius_22"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:minWidth="196dp"
        android:lines="1"
        android:lineHeight="18dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/btn_remind_ignore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/btn_remind_ignore"
        android:background="@null"
        android:layout_width="196dp"
        android:layout_height="44dp"
        android:layout_marginBottom="40dp"
        android:lines="1"
        android:lineHeight="18dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_remind_manager_usage"
        app:layout_constraintStart_toStartOf="@+id/btn_remind_manager_usage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
