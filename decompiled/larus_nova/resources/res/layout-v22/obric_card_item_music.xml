<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_12">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/music_cover"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:layout_marginEnd="@dimen/dp_12"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/dp_6"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:id="@+id/music_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:maxLines="1"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/music_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/music_play_container"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toTopOf="@+id/music_cover"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/neutral_70"
        android:ellipsize="end"
        android:id="@+id/music_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginRight="@dimen/dp_12"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintEnd_toStartOf="@+id/music_play_container"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toBottomOf="@+id/music_title"/>
    <FrameLayout
        android:id="@+id/music_play_container"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_play_btn"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/obric_card_music_icon_play"/>
        <FrameLayout
            android:id="@+id/music_pause_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.assistant.card.layout.viewholder.MusicCircularProgressView
                android:id="@+id/music_play_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/music_pause_btn_icon"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/obric_card_music_icon_pause"/>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
