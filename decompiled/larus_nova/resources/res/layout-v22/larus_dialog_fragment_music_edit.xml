<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/share_container_box"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_music_name_btn"
            android:background="?attr/larus_bg_avatar_action_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/edit_music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_music_title_edit"
                android:textFontWeight="500"/>
        </LinearLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/edit_music_cover_btn"
            android:background="?attr/larus_bg_avatar_action_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/edit_music_cover_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_music_cover_upload"
                android:textFontWeight="500"/>
        </LinearLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/save_to_album_btn"
            android:background="?attr/larus_bg_avatar_action_btn"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/save_to_album_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_music_save"
                android:textFontWeight="500"/>
        </LinearLayout>
        <View
            android:background="?attr/larus_base_1_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_8"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cancel_btn"
            android:background="?attr/larus_bg_avatar_action_btn"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center"
                android:id="@+id/cancel_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_cancel"
                android:textFontWeight="500"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
