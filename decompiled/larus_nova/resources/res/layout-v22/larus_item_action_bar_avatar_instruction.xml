<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/icon_container"
        android:background="@null"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_2"
        android:elevation="?attr/larus_dp_0"
        app:cardCornerRadius="?attr/larus_dp_2"
        app:cardElevation="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/display_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/display_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_36"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_update_dot"
        app:layout_constraintStart_toEndOf="@+id/icon_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="?attr/larus_dp_14"/>
    <TextView
        android:textSize="?attr/larus_dp_11"
        android:textColor="@color/larus_primary_50"
        android:gravity="center"
        android:id="@+id/tv_item_update_dot"
        android:background="@drawable/larus_item_instruction_bar_blue_update_icon"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_18"
        android:paddingStart="?attr/larus_dp_4"
        android:paddingEnd="?attr/larus_dp_4"
        android:layout_marginStart="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/display_text"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
