<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="6dp"
    style="@style/UDShadow.S4.Down">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/subtitle_action_menu_body"
        android:background="@drawable/office_sdk_mm_bg_subtitle_action_menu"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:layout_width="136dp"
        android:layout_height="88dp"
        android:minWidth="136dp"
        android:minHeight="88dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/action_mark"
            android:background="@drawable/office_sdk_mm_bg_subtitle_action_menu_item"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_mark"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ud_icon_flag_outlined"
                app:tint="@color/icon_n2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/tv_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_PersonalNotes_Highlight_Button"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:lineHeight="22dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/action_copy"
            android:background="@drawable/office_sdk_mm_bg_subtitle_action_menu_item"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ud_icon_copy_outlined"
                app:tint="@color/icon_n2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/tv_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_Common_Copy_Button"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:lineHeight="22dp"/>
        </LinearLayout>
    </LinearLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
