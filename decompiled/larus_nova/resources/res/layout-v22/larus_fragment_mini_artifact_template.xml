<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:src="@drawable/larus_ic_artifact_close"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/title_group"
            app:layout_constraintStart_toStartOf="@+id/title_group"
            app:layout_constraintTop_toTopOf="@+id/title_group"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_52"
            android:layout_marginEnd="@dimen/dp_52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dp_17"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:text="@string/larus_building_agent_building_loading_cn"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="@dimen/dp_11"
                android:textStyle="bold"
                android:textColor="@color/neutral_50"
                android:id="@+id/subTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_3"
                android:text="@string/larus_building_ai_generate_tip_cn"
                android:singleLine="true"
                android:textFontWeight="400"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/web_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_group"/>
    <FrameLayout
        android:id="@+id/make_same_template_group"
        android:background="@color/white_black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/make_same_template_button"
            android:background="@drawable/ic_make_same_button_enable"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_14"
            android:layout_marginHorizontal="@dimen/dp_12">
            <ImageView
                android:id="@+id/button_lock_view_text_right_icon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_make_same_icon"
                android:layout_marginEnd="?attr/larus_dp_2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/white_black"
                android:gravity="center"
                android:id="@+id/button_lock_view_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_building_template_copy_cn"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </LinearLayout>
    </FrameLayout>
    <include
        android:id="@+id/chat_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/larus_mini_artifact_input"/>
</com.larus.bmhome.view.ChatConstraintLayout>
