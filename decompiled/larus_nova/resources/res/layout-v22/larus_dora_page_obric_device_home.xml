<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1_variant"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/dora_obric_device_home_scroll_view"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/dora_obric_device_home_content"
            android:paddingTop="0dp"
            android:paddingBottom="?attr/larus_dp_128"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.lisitem.OUICardConstraintLayout
                android:id="@+id/dora_obric_device_home_device_card"
                android:background="@color/larus_base_2"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_16"
                android:foreground="@null"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:stateListAnimator="@null"
                app:oui_radius="?attr/larus_dp_20">
                <com.obric.oui.image.OImage
                    android:id="@+id/dora_obric_device_home_device_image"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_97"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oui_imageStrokeEnabled="false"/>
                <com.obric.oui.tag.OTextTag
                    android:gravity="center"
                    android:id="@+id/dora_obric_device_home_device_mode_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:drawableStart="@drawable/larus_icon_dot"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/OTag.Text.M.Primary.Light"/>
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/dora_obric_device_home_connection_row"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_obric_device_home_device_name_row">
                    <com.obric.oui.layout.OUILinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <com.obric.oui.layout.OUIFrameLayout
                            android:id="@+id/dora_obric_device_home_connection_dot"
                            android:background="@drawable/larus_dora_obric_device_home_ic_reconnect"
                            android:layout_width="?attr/larus_dp_18"
                            android:layout_height="?attr/larus_dp_18"/>
                        <com.obric.oui.text.OTextView
                            android:textSize="?attr/larus_sp_14"
                            android:textColor="?attr/larus_neutral_100"
                            android:gravity="center_vertical"
                            android:id="@+id/dora_obric_device_home_connection_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_marginStart="?attr/larus_dp_6"/>
                        <com.obric.oui.text.OTextView
                            android:textSize="?attr/larus_sp_14"
                            android:textColor="@color/larus_primary_50"
                            android:gravity="center_vertical"
                            android:id="@+id/dora_obric_device_home_reconnect_button"
                            android:background="@android:color/transparent"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/larus_dora_device_disconnected_btn_retry_cn"
                            android:includeFontPadding="false"
                            android:layout_marginStart="?attr/larus_dp_4"/>
                        <com.obric.oui.text.OTextView
                            android:textSize="?attr/larus_sp_14"
                            android:textColor="?attr/larus_neutral_50"
                            android:gravity="center_vertical"
                            android:id="@+id/dora_obric_device_home_connecting_text"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/larus_dora_device_disconnected_btn_retrying_cn"
                            android:includeFontPadding="false"
                            android:layout_marginStart="?attr/larus_dp_4"/>
                    </com.obric.oui.layout.OUILinearLayout>
                </com.obric.oui.layout.OUIFrameLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/dora_obric_device_home_device_name_row"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_22"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_obric_device_home_mode_entry">
                    <com.obric.oui.text.OTextView
                        android:textSize="?attr/larus_sp_16"
                        android:textColor="@color/oui_basic_text_1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/dora_obric_device_home_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="?attr/larus_dp_260"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:textFontWeight="500"/>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/dora_obric_device_home_battery_row"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_obric_device_home_device_name_row">
                    <com.obric.oui.image.OImage
                        android:id="@+id/dora_obric_device_home_glasses_icon"
                        android:layout_width="?attr/larus_dp_20"
                        android:layout_height="?attr/larus_dp_20"
                        android:contentDescription="@null"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.image.OImage
                        android:id="@+id/dora_obric_device_home_glasses_charging_icon"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        android:src="@drawable/larus_dora_obric_device_home_ic_charging"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_4"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center_vertical"
                        android:id="@+id/dora_obric_device_home_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_4"
                        android:textFontWeight="400"/>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/dora_obric_device_home_earbuds_battery_row"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dora_obric_device_home_device_name_row">
                    <com.obric.oui.image.OImage
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_dora_obric_device_home_ic_earbud_left"
                        android:contentDescription="@null"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.image.OImage
                        android:id="@+id/dora_obric_device_home_left_charging_icon"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        android:src="@drawable/larus_dora_obric_device_home_ic_charging"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_4"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center_vertical"
                        android:id="@+id/dora_obric_device_home_left_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_4"
                        android:textFontWeight="400"/>
                    <com.obric.oui.image.OImage
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_dora_obric_device_home_ic_earbud_right"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_8"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.image.OImage
                        android:id="@+id/dora_obric_device_home_right_charging_icon"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        android:src="@drawable/larus_dora_obric_device_home_ic_charging"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_4"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center_vertical"
                        android:id="@+id/dora_obric_device_home_right_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_4"
                        android:textFontWeight="400"/>
                    <com.obric.oui.image.OImage
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_dora_obric_device_home_ic_charging_case"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_8"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.image.OImage
                        android:id="@+id/dora_obric_device_home_box_charging_icon"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        android:src="@drawable/larus_dora_obric_device_home_ic_charging"
                        android:contentDescription="@null"
                        android:layout_marginStart="?attr/larus_dp_4"
                        app:oui_imageStrokeEnabled="false"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center_vertical"
                        android:id="@+id/dora_obric_device_home_box_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_4"
                        android:textFontWeight="400"/>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/dora_obric_device_home_status_row"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.obric.oui.button.OButton
                        android:gravity="center"
                        android:id="@+id/dora_obric_device_home_environment_memory_status"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/larus_dora_obric_device_status_environment_memory_cn"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/larus_dora_obric_device_home_obser_pause"
                        style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="14dp"
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center"
                        android:id="@+id/dora_obric_device_home_interpretation_status"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/larus_dora_obric_device_status_interpretation_cn"
                        android:drawablePadding="9dp"
                        android:drawableStart="@drawable/larus_dora_obric_device_mode_entry_dot"
                        android:layout_marginStart="8dp"
                        style="@style/AndroidButton.S.Standard.Neutral"/>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/dora_obric_device_home_device_card_click_area"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:foreground="@null"
                    android:stateListAnimator="@null"
                    app:OUI_alpha_pressed="@color/Transparent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.image.OImage
                    android:id="@+id/dora_obric_device_home_device_settings_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    android:src="@drawable/larus_dora_obric_device_home_ic_device_settings"
                    android:contentDescription="@null"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:OUI_alpha_pressed="@color/Transparent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:oui_imageStrokeEnabled="false"/>
                <com.larus.dora.obric.device_management.device_home.DoraObricDeviceModeEntryView
                    android:id="@+id/dora_obric_device_home_mode_entry"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.image.OImage
                    android:id="@+id/dora_obric_device_home_top_settings_button"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/larus_dora_obric_device_home_ic_device_settings"
                    android:contentDescription="@null"
                    android:layout_marginEnd="16dp"
                    app:OUI_alpha_pressed="@color/Transparent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oui_imageStrokeEnabled="false"/>
                <View
                    android:id="@+id/dora_obric_device_home_reconnect_click_area"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:OUI_alpha_pressed="@color/Transparent"
                    app:layout_constraintBottom_toBottomOf="@+id/dora_obric_device_home_connection_row"
                    app:layout_constraintEnd_toEndOf="@+id/dora_obric_device_home_connection_row"
                    app:layout_constraintStart_toStartOf="@+id/dora_obric_device_home_connection_row"
                    app:layout_constraintTop_toTopOf="@+id/dora_obric_device_home_connection_row"/>
            </com.obric.oui.lisitem.OUICardConstraintLayout>
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/dora_obric_device_home_device_card_carousel"
                android:visibility="gone"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_16"
                android:overScrollMode="never"/>
            <com.obric.oui.lisitem.OUICardConstraintLayout
                android:id="@+id/dora_obric_device_home_ota_card"
                android:background="@color/oui_basic_fill_element_2"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                android:foreground="@null"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:stateListAnimator="@null"
                app:oui_radius="?attr/larus_dp_20">
                <com.obric.oui.image.OImage
                    android:id="@+id/dora_obric_device_home_ota_icon"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"
                    android:src="@drawable/larus_dora_obric_device_home_ic_ota_info"
                    android:contentDescription="@null"
                    android:layout_marginStart="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oui_imageStrokeEnabled="false"/>
                <com.obric.oui.text.OTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_3"
                    android:ellipsize="end"
                    android:id="@+id/dora_obric_device_home_ota_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="?attr/larus_dp_8"
                    android:layout_marginEnd="?attr/larus_dp_12"
                    android:textFontWeight="500"
                    app:layout_constraintBottom_toBottomOf="@+id/dora_obric_device_home_ota_icon"
                    app:layout_constraintEnd_toStartOf="@+id/dora_obric_device_home_ota_action"
                    app:layout_constraintStart_toEndOf="@+id/dora_obric_device_home_ota_icon"
                    app:layout_constraintTop_toTopOf="@+id/dora_obric_device_home_ota_icon"/>
                <com.obric.oui.text.OTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_functional_blue_6"
                    android:gravity="center"
                    android:id="@+id/dora_obric_device_home_ota_action"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_obric_ota_card_update_cn"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    android:textFontWeight="500"
                    app:OUI_alpha_pressed="@color/Transparent"
                    app:layout_constraintBottom_toBottomOf="@+id/dora_obric_device_home_ota_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/dora_obric_device_home_ota_icon"/>
            </com.obric.oui.lisitem.OUICardConstraintLayout>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/dora_obric_device_home_common_title_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_26"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:sectionTitle_titleText="@string/larus_dora_o_home_common_features_title_cn"/>
            <com.obric.oui.layout.OUIFrameLayout
                android:id="@+id/dora_obric_device_home_album_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12">
                <com.obric.oui.layout.OUIFrameLayout
                    android:background="@color/larus_base_2"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_128"
                    android:importantForAccessibility="no"
                    app:oui_radius="?attr/larus_dp_20"/>
            </com.obric.oui.layout.OUIFrameLayout>
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/dora_obric_device_home_quick_action_grid"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:isScrollContainer="false"
                android:overScrollMode="never"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:nestedScrollingEnabled="false"/>
        </com.obric.oui.layout.OUILinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/dora_obric_device_home_diary_container"
