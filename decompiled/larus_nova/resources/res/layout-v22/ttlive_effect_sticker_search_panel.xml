<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_effect_bg_sticker_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.effect.sticker.ui.StickerSearchBox
        android:id="@+id/search_box"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#e5ffffff"
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/ttlive_effect_sticker_search_cancel"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/search_box"
        app:layout_constraintTop_toTopOf="@+id/search_box"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:id="@+id/text_recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_effect_sticker_search_recommend"
        app:layout_constraintStart_toStartOf="@+id/search_box"
        app:layout_constraintTop_toBottomOf="@+id/search_box"/>
    <com.bytedance.android.livesdk.widget.FlowLayout
        android:id="@+id/container_recommend"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_recommend"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/tv_search_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_effect_sticker_search_empty_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_box"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sticker"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_empty"
        app:layout_goneMarginTop="16dp"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/loading_search"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_box"/>
</androidx.constraintlayout.widget.ConstraintLayout>
