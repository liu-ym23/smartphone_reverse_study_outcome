<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/base_2_overlay"
    app:rv_cornerRadius="@dimen/dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_content"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_18"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_18">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/download_app_icon"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/download_app_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/download_app_icon"
            app:layout_constraintEnd_toStartOf="@+id/open_botton"
            app:layout_constraintStart_toEndOf="@+id/download_app_icon"
            app:layout_constraintTop_toTopOf="@+id/download_app_icon"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/open_botton"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_32"
            android:text="@string/obric_card_open_app"
            app:layout_constraintBottom_toBottomOf="@+id/download_app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/download_app_text"
            app:layout_constraintTop_toTopOf="@+id/download_app_icon"
            style="@style/OStyleV2.OButton.S.Standard.Primary_Light"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
