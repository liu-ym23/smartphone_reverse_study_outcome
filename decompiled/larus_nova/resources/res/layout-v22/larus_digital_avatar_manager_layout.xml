<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet_music_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/larus_base_2_overlay"
    app:rv_cornerRadius_TL="@dimen/dp_16"
    app:rv_cornerRadius_TR="@dimen/dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_view"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="6dp"
        android:src="@drawable/larus_digital_avatar_manager_close_icon"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar_view"
        android:layout_width="?attr/larus_dp_240"
        android:layout_height="?attr/larus_dp_240"
        android:layout_marginTop="?attr/larus_dp_71"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_24"
        android:textColor="@color/neutral_100"
        android:id="@+id/avatar_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_53"
        android:text="@string/larus_replica_bottomsheet_title_myReplica"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/avatar_info_container"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_21"
        android:layout_marginTop="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_title_view">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/neutral_50"
            android:id="@+id/avatar_info_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="600"/>
        <FrameLayout
            android:id="@+id/avatar_info_icon_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_12"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="@drawable/larus_digital_avatar_info_icon"/>
        </FrameLayout>
    </LinearLayout>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/neutral_100"
        android:gravity="center"
        android:id="@+id/avatar_manager_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_15"
        android:layout_marginTop="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_15"
        android:layout_marginBottom="@dimen/dp_8"
        android:text="@string/larus_replica_bottomsheet_btn_manage"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        android:layout_marginHorizontal="?attr/larus_dp_15"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_info_container"
        app:rv_backgroundColor="@color/base_3"
        app:rv_cornerRadius="@dimen/dp_16"/>
    <include
        android:id="@+id/digital_avatar_new_entry_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_info_container"
        layout="@layout/larus_digital_avatar_manager_new_entry_layout"/>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
