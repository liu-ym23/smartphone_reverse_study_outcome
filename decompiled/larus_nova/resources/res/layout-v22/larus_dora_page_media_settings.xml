<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_media_auto_sync_switch_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_media_auto_sync_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_device_media_auto_sync_switch_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_media_auto_sync_switch_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_device_media_auto_sync_dec_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_save_to_gallery_switch_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_save_to_gallery_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_save_to_gallery_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_save_to_gallery_switch_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_save_to_gallery_desc_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_record_location_switch_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_record_location_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_record_location_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_record_location_switch_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_record_location_desc_not_always_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:id="@+id/dora_media_settings_video_record_config"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_g_device_video_setting_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_media_settings_video_record_config_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_media_settings_video_record_quality"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_device_video_resolution_cn"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_media_settings_video_record_ratio"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_device_video_proportion_cn"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_media_settings_video_record_duration"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_device_record_duration_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
