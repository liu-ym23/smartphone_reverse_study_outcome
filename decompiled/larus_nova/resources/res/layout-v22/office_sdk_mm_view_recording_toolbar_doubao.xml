<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.wavebar.MmAudioWaveBarView
        android:id="@+id/recordWaveBarView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gradientLeft"
        android:layout_width="50dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recordWaveBarView"
        app:layout_constraintStart_toStartOf="@+id/recordWaveBarView"
        app:layout_constraintTop_toTopOf="@+id/recordWaveBarView"/>
    <View
        android:id="@+id/gradientRight"
        android:layout_width="50dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recordWaveBarView"
        app:layout_constraintEnd_toEndOf="@+id/recordWaveBarView"
        app:layout_constraintTop_toTopOf="@+id/recordWaveBarView"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:gravity="center"
        android:id="@+id/tvDuration"
        android:padding="13dp"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:fontFamily="monospace"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recordWaveBarView"/>
    <ImageView
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/ivResumePause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDuration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDuration"
        app:tint="@color/flow_ud_neutral_100"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:gravity="center"
        android:id="@+id/ivStop"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="72dp"
        android:text="@string/View_G_AnnoEnd_Button"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivResumePause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivResumePause"/>
</merge>
