<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_payment_method"
    android:background="@drawable/cj_pay_bg_view_container_gray"
    android:layout_width="match_parent"
    android:layout_height="490dp">
    <RelativeLayout
        android:id="@+id/rl_title_bar"
        android:background="@drawable/cj_pay_bg_view_container_gray"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:id="@+id/cj_pay_back_view"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_round_close"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/cj_pay_title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
            android:id="@+id/rv_payment_method_layout"
            android:background="@drawable/cj_pay_bg_r8_white"
            android:paddingBottom="4dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="12dp"/>
    </FrameLayout>
</LinearLayout>
