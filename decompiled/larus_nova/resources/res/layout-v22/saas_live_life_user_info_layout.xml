<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="44dp">
    <View
        android:id="@+id/iv_left_background"
        android:background="@drawable/live_bg_header_user_left_layout"
        android:layout_width="0dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fl_follow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/iv_right_background"
        android:background="@drawable/live_bg_header_user_right_layout"
        android:layout_width="0dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_left_background"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/iv_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_icon_default_head_small"
        app:roundedCornerRadius="8dp"/>
    <com.bytedance.locallife.live.userinfo.title.view.GradientTextView
        android:textSize="13dp"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="138dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        android:fallbackLineSpacing="false"
        app:layout_constraintBottom_toTopOf="@+id/il_introduction"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/il_introduction"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"
        app:maxWidth="138dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_introduction_official_cert"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"
            app:actualImageScaleType="fitCenter"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="11dp"
            android:textColor="#bfffffff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_introduction_additional_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="138dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fallbackLineSpacing="false"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/br_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_nickname,il_introduction"/>
    <FrameLayout
        android:id="@+id/fl_follow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="18dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintStart_toEndOf="@+id/br_content"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
