<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/bg_obric_local_data_search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_22"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:text="@string/obric_local_data_search_confirm_title"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/neutral_70"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:lineHeight="@dimen/dp_22"
        android:textFontWeight="400"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <Button
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/static_white"
        android:id="@+id/bt_go_to_setting"
        android:background="@drawable/bg_obric_local_data_search_confirm_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_36"
        android:text="@string/obric_local_data_search_confirm_btn_gotoSettings"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/primary_50"
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:text="@string/obric_local_data_search_confirm_btn_cancel"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_go_to_setting"/>
</com.larus.bmhome.view.ChatConstraintLayout>
