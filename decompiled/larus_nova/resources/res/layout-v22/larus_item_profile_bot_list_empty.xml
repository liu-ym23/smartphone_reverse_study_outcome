<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_80"
        android:layout_marginBottom="?attr/larus_dp_150"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/profile_info_avatar"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:src="@drawable/larus_profile_bot_list_empty"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/profile_info_nickname"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_profile_placeholder"
            android:layout_marginStart="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_24"
            app:layout_constraintTop_toBottomOf="@+id/profile_info_avatar"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/creation_empty_action_button"
            android:background="@drawable/larus_bg_empty_action_button"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_96"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_profile_create_bot"
            android:includeFontPadding="false"
            android:textFontWeight="500"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
