<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_digit_avatar_emoji_item_height">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/emoji_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:failureImage="@drawable/ttlive_icon_default_emoji"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#4d4d4d"
        android:gravity="center"
        android:id="@+id/emoji_name"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
