<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="20dp">
    <View
        android:id="@+id/subtitleHighlightBackground"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editSpeakerContainer"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmSubtitleSpeakerAvatarView
            android:id="@+id/speakerAvatar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_neutral_70"
            android:ellipsize="end"
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:lines="1"
            android:singleLine="true"
            android:paddingEnd="6dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/speakerAvatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/editSpeakerIcon"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/userName"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/office_sdk_mm_ic_arrow_down_2_doubao"
            app:tint="@color/flow_ud_neutral_50"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/itemSeparator"
        android:layout_width="3dp"
        android:layout_height="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/editSpeakerContainer"
        app:layout_constraintStart_toEndOf="@+id/editSpeakerContainer"
        app:layout_constraintTop_toTopOf="@+id/editSpeakerContainer"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/editSpeakerContainer"
        app:layout_constraintStart_toEndOf="@+id/itemSeparator"
        app:layout_constraintTop_toTopOf="@+id/editSpeakerContainer"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:id="@+id/itemContent1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="6dp"
        android:layout_marginStart="2dp"
        android:clipToOutline="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editSpeakerContainer"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:id="@+id/itemContent2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="6dp"
        android:layout_marginStart="2dp"
        android:clipToOutline="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemContent1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
