<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.livecommerce.iron.ui.ECPromotionListFooterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fv_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_start_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_end_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="16dp"/>
    <View
        android:id="@+id/v_divider_line_left"
        android:background="@color/ec_color_1f_161823"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_footer_text"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_footer_text"
        app:layout_constraintStart_toStartOf="@+id/gl_start_padding"
        app:layout_constraintTop_toTopOf="@+id/tv_item_footer_text"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/shopping_std_text_black_4"
        android:gravity="center_horizontal"
        android:id="@+id/tv_item_footer_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="13dp"
        android:layout_marginHorizontal="13dp"
        app:constraint_referenced_ids="v_title_margin"
        app:layout_constraintBottom_toTopOf="@+id/dv_background"
        app:layout_constraintEnd_toStartOf="@+id/v_divider_line_right"
        app:layout_constraintStart_toEndOf="@+id/v_divider_line_left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/v_divider_line_right"
        android:background="@color/ec_color_1f_161823"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_footer_text"
        app:layout_constraintEnd_toEndOf="@+id/gl_end_padding"
        app:layout_constraintStart_toEndOf="@+id/tv_item_footer_text"
        app:layout_constraintTop_toTopOf="@+id/tv_item_footer_text"/>
    <View
        android:id="@+id/v_title_margin"
        android:layout_width="1dp"
        android:layout_height="19dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_item_footer_text"
        app:layout_constraintStart_toStartOf="@+id/tv_item_footer_text"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_footer_text"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_guild_margin"
        app:layoutMode="height_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/gl_end_padding"
        app:layout_constraintStart_toStartOf="@+id/gl_start_padding"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_footer_text"
        app:placeholderImage="@color/transparent"/>
    <View
        android:id="@+id/v_guild_margin"
        android:layout_width="1dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dv_background"
        app:layout_constraintStart_toStartOf="@+id/dv_background"
        app:layout_constraintTop_toBottomOf="@+id/dv_background"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
        android:id="@+id/cev_left_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/dv_background"
        app:layout_constraintEnd_toStartOf="@+id/cev_right_content"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/dv_background"
        app:layout_constraintTop_toTopOf="@+id/dv_background"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
        android:id="@+id/cev_right_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/dv_background"
        app:layout_constraintEnd_toEndOf="@+id/dv_background"
        app:layout_constraintStart_toEndOf="@+id/cev_left_content"
        app:layout_constraintTop_toTopOf="@+id/dv_background"/>
</com.bytedance.android.livesdk.livecommerce.iron.ui.ECPromotionListFooterView>
