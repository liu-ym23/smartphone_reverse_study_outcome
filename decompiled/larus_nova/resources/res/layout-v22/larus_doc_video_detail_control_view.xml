<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.doc.impl.video.widget.PlayerProgressView
        android:id="@+id/player_progress"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginBottom="?attr/larus_dp_52"
        android:paddingHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/op_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/download_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
