<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_beinvited_constraintlayout"
    android:background="@color/transparent"
    android:paddingBottom="0dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintTop_toTopOf="parent">
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_ban_be_invite"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_refuse">
        <TextView
            android:textSize="11sp"
            android:textColor="#80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_ban_pk_be_invite_tips"/>
        <ImageView
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_ic_ban_pk_be_invite"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/inviter_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/head_view_container"
            android:layout_width="78dp"
            android:layout_height="78dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_live_white_round_37"
                android:layout_width="74dp"
                android:layout_height="74dp"/>
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="center"
                android:id="@+id/ttlive_inviter_head_view"
                android:layout_width="65dp"
                android:layout_height="65dp"
                app:placeholderImage="@drawable/ttlive_ic_default_head_small"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/rank_season_avatar_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitXY"/>
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="end|bottom"
                android:id="@+id/inviter_gender_view"
                android:background="@drawable/ttlive_bg_circle_head"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="6dp"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/line_left"
        android:layout_width="36dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_linearlayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ttlive_linearlayout"/>
    <View
        android:id="@+id/line_right"
        android:layout_width="36dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ttlive_linearlayout"
        app:layout_constraintTop_toTopOf="@+id/ttlive_linearlayout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ttlive_linearlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/line_right"
        app:layout_constraintStart_toEndOf="@+id/line_left"
        app:layout_constraintTop_toBottomOf="@+id/inviter_info_container">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:ellipsize="end"
            android:id="@+id/tv_inviter_nick_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center_vertical"
            android:id="@+id/gender_view"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/ttlive_gender_male_icon"
            android:layout_marginStart="4dp"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/usertags_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_livetags_container"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_linearlayout">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_fire_number"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/season_rank_info_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/rank_season_badge"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"
                    app:retryImageScaleType="fitXY"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#686868"
                    android:id="@+id/rank_detail"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/audience_info_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ttlive_audience_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ttlive_icon_audience"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#686868"
                    android:id="@+id/ttlive_inviter_audience_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#686868"
                    android:id="@+id/ttlive_inviter_fan_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ttlive_location_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ttlive_icon_location"
                    android:layout_marginEnd="2dp"/>
                <ImageView
                    android:id="@+id/ic_fire_number"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ttlive_ic_fire_number"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#686868"
                    android:id="@+id/tv_inviter_fire_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/match_tags"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_live_tags_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#80161823"
        android:id="@+id/tv_recommend_reason"
        android:background="@drawable/ttlive_bg_pklist_recommend_reason"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="11dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/inviter_info_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_livetags_container"
        app:layout_goneMarginTop="8dp"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="@color/ttlive_pk_rule_text_color"
        android:id="@+id/private_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_refuse"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#404040"
        android:gravity="center"
        android:id="@+id/bt_refuse"
        android:background="@drawable/ttlive_bg_pk_feedback_another_v2"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="181dp"
        android:layout_marginRight="4dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/bt_accept"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/bt_accept"
        android:background="@drawable/ttlive_bg_pk_cancel_v2"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="181dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_accept"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toRightOf="@+id/bt_refuse"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/rank_label_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="175dp"
        app:layout_constraintRight_toRightOf="@+id/bt_accept"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/rank_label_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="8dp"
            android:id="@+id/rank_label_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_refuse"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/vote_des"
        android:background="@drawable/ttlive_bg_pk_notify_match_reason"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="92dp"
        android:layout_marginTop="78.5dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/tv_waitting_list"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="92dp"
        android:layout_marginTop="78.5dp"
        android:singleLine="true"
        android:alpha="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
