<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/ttlive_mini_app_explain_card_setting_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp">
        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ttlive_open_platform_back_btn2"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_uikit_const_tPrimary"
            android:gravity="center"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/ttlive_open_platform_miniapp_setting"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ttlive_open_platform_close_btn2"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@color/white"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:ttlive_allRadius="5dp">
        <com.bytedance.android.live.openplatform.impl.miniappcommon.explaincard.MiniAppExplainCard
            android:id="@+id/miniapp_explain_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:enable_new_card_layout="true"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/snapshot_uploading_view"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                android:layout_gravity="center"
                android:id="@+id/ttlive_loading_view"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/ttlive_miniapp_reverse_tTertiary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/ttlive_open_platform_snapshot_hint"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/snapshot_upload_failed_container"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/live_ad_upload_failed_view"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ttlive_ic_load_failed_img"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/ttlive_miniapp_reverse_tTertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_open_platform_snapshot_fail"
                android:layout_below="@+id/live_ad_upload_failed_view"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_mini_app_explain_card_setting_dialog_option_block_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:divider="#1f161823"
        android:showDividers="middle"
        android:dividerPadding="16dp"
        android:layout_marginHorizontal="16dp">
        <RelativeLayout
            android:id="@+id/cover_settings_layout"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:id="@+id/tv_cover_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_cover_settings"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/ttlive_douyin_text_TextReverse3"
                android:ellipsize="end"
                android:id="@+id/tv_cover_settings_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_below="@+id/tv_cover_settings"
                android:layout_marginEnd="16dp"
                android:layout_toStartOf="@+id/tv_custom_cover_review_status"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/ttlive_douyin_light_TextReverse3"
                android:id="@+id/tv_custom_cover_review_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/drawee_view_custom_cover"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/drawee_view_custom_cover"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/iv_cover_settings_right_arrow"
                app:roundedCornerRadius="2dp"/>
            <ImageView
                android:id="@+id/iv_cover_settings_right_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_miniapp_anchor_cover_arraw_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/title_settings_layout"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:id="@+id/tv_title_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_title_settings"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/ttlive_douyin_text_TextReverse3"
                android:ellipsize="end"
                android:id="@+id/tv_title_settings_explain_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_below="@+id/tv_title_settings"
                android:layout_marginEnd="16dp"
                android:layout_toStartOf="@+id/iv_title_settings_right_arrow"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/iv_title_settings_right_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_miniapp_anchor_cover_arraw_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/show_explain_card_switch_layout"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:paddingHorizontal="15dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_custom_card_switch"
                android:layout_centerVertical="true"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/display_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:lsb_background="#33161823"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_save"
        android:background="@drawable/ttlive_mini_app_explain_card_setting_dialog_save_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_open_platform_custom_card_save"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
