<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/create_ugc_voice_close_btn"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:contentDescription="@string/larus_accessibility_icon_close"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_close_dialog"/>
    <TextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/create_ugc_voice_dialog_title"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_70"
        android:layout_marginTop="?attr/larus_dp_40"
        android:text="@string/larus_voice_creation_read_title"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_24"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/create_ugc_voice_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="?attr/larus_dp_5"
        android:layout_marginStart="?attr/larus_dp_36"
        android:layout_marginEnd="?attr/larus_dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/create_ugc_voice_speaker_text_shadow"
        android:background="@drawable/larus_chat_common_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_80"
        android:layout_marginBottom="?attr/larus_dp_28"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_18"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/create_ugc_voice_speaker_text"
        android:background="?attr/larus_bg_input_normal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_40"
        android:text="@string/larus_hold_to_record"
        android:layout_marginStart="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.larus.asr.view.ChatSpeaker
        android:id="@+id/create_ugc_voice_speaker_view"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_86"
        android:paddingHorizontal="?attr/larus_dp_12"
        app:larus_press_hint="@string/larus_hold_to_record_note"
        app:larus_shadow_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/create_ugc_voice_speaker_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
