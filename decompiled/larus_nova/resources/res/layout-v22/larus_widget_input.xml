<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_input_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/action_modify_cancel"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout="@layout/larus_layout_input_action_modify_cancel"
        android:inflatedId="@+id/action_modify_cancel"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input_area_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <ViewStub
        android:id="@+id/action_modify_confirm"
        android:duplicateParentState="true"
        android:layout="@layout/larus_layout_input_action_modify_confirm"
        android:inflatedId="@+id/action_modify_confirm"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input_area_container"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.larus.common_ui.view.GradientMaskView
        android:id="@+id/action_bar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/input_area_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_action_bar_item_height"
            android:fadeScrollbars="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </com.larus.common_ui.view.GradientMaskView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_area_container"
        android:background="@drawable/larus_chat_common_shadow_bg"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:duplicateParentState="true"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/disclaimer"
        app:layout_constraintEnd_toStartOf="@+id/action_modify_confirm"
        app:layout_constraintStart_toEndOf="@+id/action_modify_cancel">
        <FrameLayout
            android:id="@+id/input_above_layout"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/input_area"
            app:layout_constraintEnd_toEndOf="@+id/input_area"
            app:layout_constraintStart_toStartOf="@+id/input_area"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/input_above_ll_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/input_editor_container"
                    android:visibility="gone"
                    android:layout="@layout/larus_layout_instruction_editor_container"
                    android:inflatedId="@+id/input_editor_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.larus.bmhome.view.actionbar.custom.actionbarpanel.CustomActionBarPanel
                    android:id="@+id/action_bar_panel"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/layout_resource_bar_attachment_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.resourcebar.ResourceBar
                        android:id="@+id/layout_multi_attachment_area"
                        android:background="?attr/larus_bg_attachment_area"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:splitMotionEvents="false"/>
                </FrameLayout>
                <include
                    android:id="@+id/input_suggested_action_container"
                    layout="@layout/larus_widget_input_suggested_action"/>
            </LinearLayout>
            <EditText
                android:id="@+id/focus_holder"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="?attr/larus_dp_0"
                android:alpha="0"
                app:layout_constraintBottom_toBottomOf="@+id/input_editor_container"
                app:layout_constraintEnd_toEndOf="@+id/input_editor_container"
                app:layout_constraintStart_toStartOf="@+id/input_editor_container"
                app:layout_constraintTop_toTopOf="@+id/input_editor_container"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/chat_input_mention_panel"
                android:background="?attr/larus_bg_attachment_area"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/divider_input_area_above_container"
            android:background="?attr/larus_base_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/input_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_above_layout">
            <View
                android:id="@+id/divider_input_area_above"
                android:background="?attr/larus_neutral_transparent_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0_5"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_area"
            android:background="?attr/larus_bg_input_normal"
            android:duplicateParentState="true"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/divider_input_area_below"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_input_area_above_container">
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/input_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="top"
                app:constraint_referenced_ids="input_text,action_area"/>
            <View
                android:id="@+id/input_center_anchor"
                android:visibility="invisible"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.common_ui.view.ChatInputInnerView
                android:id="@+id/speak_area"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56"
                android:minHeight="?attr/larus_dp_56"
                android:paddingStart="?attr/larus_dp_100"
                android:paddingEnd="?attr/larus_dp_100"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_full_screen"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_54"
                android:scaleType="centerInside"
                android:contentDescription="@string/larus_accessibility_input_fullScreen"
                android:paddingStart="?attr/larus_dp_0"
                android:paddingEnd="?attr/larus_dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/input_text"
                app:srcCompat="?attr/larus_bg_enlarge_icon"/>
            <ViewStub
                android:id="@+id/input_text"
                android:layout="@layout/larus_widget_input_text"
                android:inflatedId="@+id/input_text"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_0"
                android:layout_marginEnd="?attr/larus_dp_0"
                app:layout_constraintBottom_toBottomOf="@+id/input_center_anchor"
                app:layout_constraintEnd_toStartOf="@+id/action_area"
                app:layout_constraintStart_toEndOf="@+id/action_entrance"
                app:layout_constraintTop_toTopOf="@+id/input_center_anchor"
                app:layout_goneMarginEnd="?attr/larus_dp_0"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/action_area"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="@+id/input_center_anchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/input_center_anchor">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/action_ai_gen"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:srcCompat="@drawable/larus_ic_ai_gen"/>
                <ProgressBar
                    android:id="@+id/progress_ai_gen"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/larus_bg_ai_gen_loading_dy"
                    android:indeterminateDuration="2000"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/action_voice_input"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:src="?attr/larus_ic_mic"
                    android:contentDescription="@string/larus_accessibility_icon_audioInput"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/action_input"
                    android:visibility="visible"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:contentDescription="@string/larus_accessibility_icon_textInput"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:srcCompat="?attr/larus_ic_keyboard"/>
                <FrameLayout
                    android:id="@+id/action_speak_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/larus_accessibility_icon_audioInput">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/action_speak"
                        android:visibility="visible"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"
                        app:srcCompat="?attr/larus_ic_mic"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="center"
                        android:id="@+id/action_press_speak_group"
                        android:paddingLeft="?attr/larus_dp_8"
                        android:paddingTop="?attr/larus_dp_3"
                        android:paddingRight="?attr/larus_dp_8"
                        android:paddingBottom="?attr/larus_dp_3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="?attr/larus_dp_6"
                        android:layout_marginRight="?attr/larus_dp_6"
                        android:layout_marginHorizontal="?attr/larus_dp_6"
                        android:paddingHorizontal="?attr/larus_dp_8"
                        android:paddingVertical="?attr/larus_dp_3">
                        <TextView
                            android:textSize="?attr/larus_dp_14"
                            android:textStyle="bold"
                            android:textColor="?attr/larus_neutral_100"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/action_press_speak_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="?attr/larus_dp_20"
                            android:text="@string/larus_hold_to_speak"
                            android:maxLines="1"
                            android:lineHeight="20dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/action_press_speak_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/action_press_speak_icon"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="center"
                            android:layout_marginStart="2dp"
                            app:layout_constraintBottom_toBottomOf="@+id/action_press_speak_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/action_press_speak_text"
                            app:layout_constraintTop_toTopOf="@+id/action_press_speak_text"
                            app:srcCompat="?attr/larus_ic_speak_press"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/action_menu_entrance"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_action_menu_entrance"
                            android:layout_width="?attr/larus_dp_32"
                            android:layout_height="?attr/larus_dp_56"
                            android:contentDescription="@string/larus_accessibility_icon_moreMenu"
                            app:srcCompat="?attr/larus_icon_chat_bottom_menu"/>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/action_break"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"
                        app:srcCompat="?attr/larus_ic_input_user_break"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/action_send_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/action_send"
                        android:visibility="visible"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:contentDescription="@string/larus_accessibility_icon_send"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"
                        app:srcCompat="?attr/larus_ic_send"/>
                    <ImageView
                        android:id="@+id/action_modify_confirm_new"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:src="@drawable/larus_ic_input_modify_confirm_new"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"/>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/action_entrance"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="@+id/input_center_anchor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/input_center_anchor">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/action_entrance_iv"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"/>
                <TextView
                    android:textSize="?attr/larus_sp_8"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/action_entrance_red_dot"
                    android:background="@drawable/larus_red_dot_bg_large"
                    android:layout_width="?attr/larus_dp_8"
                    android:layout_height="?attr/larus_dp_8"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:layout_marginEnd="?attr/larus_dp_4"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_speech"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_56"
                android:src="?attr/larus_icon_chat_action_speech"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/action_entrance"
                app:layout_goneMarginStart="?attr/larus_dp_12"/>
            <FrameLayout
                android:id="@+id/voice_visualizer_container"
                android:background="?attr/larus_base_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_32"
                app:layout_constraintBottom_toBottomOf="@+id/action_area"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/action_area">
                <com.larus.common_ui.widget.input.audiowave.gradient.AudioWaveGradientView
                    android:id="@+id/audio_visualizer"
                    android:paddingLeft="?attr/larus_dp_12"
                    android:paddingRight="?attr/larus_dp_12"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="?attr/larus_dp_12"
                    app:larus_autoStartAnim="false"
                    app:larus_barCountPerGroup="5"
                    app:larus_barDrawable="?attr/larus_audio_wave_bar_blue"
                    app:larus_barGap="?attr/larus_dp_2"
                    app:larus_barGroupCountMode="floor"
                    app:larus_barWidth="?attr/larus_dp_3"
                    app:larus_gradientBarCount="7"
                    app:larus_maxBarHeight="?attr/larus_dp_24"
                    app:larus_minBarHeight="?attr/larus_dp_6"
                    app:larus_showGradient="true"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_input_area_below"
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_area"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/voice_input_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_transparent_3"
        android:gravity="center"
        android:id="@+id/disclaimer"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:text="@string/larus_im_bottom_disclaimer"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
