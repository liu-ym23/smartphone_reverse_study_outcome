<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_0"
        android:layout_marginBottom="?attr/larus_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/checkbox_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.larus.bot.impl.feature.edit.feature.bgimage.preview.widget.FixedAspectRatioConstraintLayout
            android:id="@+id/avatar_parent"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:larus_aspect_ratio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.1667"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/larus_neutral_transparent_1"
                app:roundAsCircle="true"/>
            <ProgressBar
                android:id="@+id/avatar_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:indeterminate="true"
                android:indeterminateDuration="750"
                android:indeterminateTint="@color/larus_neutral_50"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.larus.bot.impl.feature.edit.feature.bgimage.preview.widget.FixedAspectRatioConstraintLayout>
        <Space
            android:id="@+id/space_left"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_0"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_parent"
            app:layout_constraintStart_toEndOf="@+id/avatar_parent"/>
        <Space
            android:id="@+id/space_bottom"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="@+id/avatar_parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_parent"/>
        <FrameLayout
            android:id="@+id/avatar_crop_icon"
            android:background="@drawable/larus_ugc_bot_avatar_crop_shadow_icon"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            app:layout_constraintBottom_toBottomOf="@+id/space_bottom"
            app:layout_constraintEnd_toEndOf="@+id/space_left">
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:layout_gravity="center"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                app:rv_backgroundColor="@color/larus_base_3"
                app:rv_cornerRadius="?attr/larus_dp_32"
                app:rv_strokeColor="@color/larus_neutral_transparent_1"
                app:rv_strokeWidth="?attr/larus_dp_0_5">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="?attr/larus_dp_18"
                    android:layout_height="?attr/larus_dp_18"
                    android:src="@drawable/larus_ugc_bot_icon_avatar_crop"/>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
        </FrameLayout>
        <androidx.legacy.widget.Space
            android:id="@+id/space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.0333"
            app:layout_constraintTop_toBottomOf="@+id/avatar_parent"/>
        <com.larus.bot.impl.feature.edit.feature.bgimage.preview.widget.BotBgImagePreviewView
            android:id="@+id/bg_image"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.8"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/checkbox_container"
        android:padding="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_13"
        app:layout_constraintBottom_toTopOf="@+id/confirm_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.larus.bmhome.chat.layout.widget.ChatCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/checkbox"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:checked="false"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_create_bot_profile_bg_selection"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/change_avatar_btn"
        android:background="@drawable/larus_bg_btn_r16_base_2_overlay"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_edit_image_btn"
        android:layout_marginStart="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/confirm_btn"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_edit_chat_name_done"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/change_avatar_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
