<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:adjustViewBounds="true">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_mini_app_choose_intro_text"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#a6171a1c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_mini_app_choose_intro_premisson_desc"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/img_intro"
        android:layout_width="match_parent"
        android:layout_height="208dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:scaleType="centerCrop"
        app:roundedCornerRadius="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/use_condition_container"
        android:background="@drawable/ttlive_mini_app_choose_intro_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_mini_app_choose_intro_using_desc"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_mini_app_choose_intro_no_permission"
        android:gravity="center"
        android:id="@+id/btn_miniapp_no_permission"
        android:background="@drawable/ttlive_mini_app_choose_intro_no_permission_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ttlive_mini_app_choose_intro_no_premission"
        android:layout_marginHorizontal="16dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_miniapp_start_use"
        android:background="@drawable/ttlive_mini_app_choose_intro_start_use_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ttlive_mini_app_choose_intro_has_premission"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
