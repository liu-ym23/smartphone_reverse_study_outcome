<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_control_weak_alert"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#000000"
        android:id="@+id/ttlive_control_weak_alert_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:lineHeight="23.8dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:gravity="center_horizontal"
        android:id="@+id/ttlive_control_weak_alert_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineHeight="19.6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_control_weak_alert_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ttlive_control_weak_alert_jump"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_control_weak_alert_content">
        <TextView
            android:textColor="#fe2c55"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_open_platform_control_jump_click"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_icon_control_jump_arrow"/>
    </LinearLayout>
    <Button
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:id="@+id/ttlive_control_weak_alert_btn"
        android:background="@drawable/ttlive_bg_control_positive_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_open_platform_control_confirm"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineHeight="21dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_control_weak_alert_jump"/>
</androidx.constraintlayout.widget.ConstraintLayout>
