<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/permDepCheckbox"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_checkbox_size="small"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/permDepName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/permDepDividerVertical"
        app:layout_constraintStart_toEndOf="@+id/permDepCheckbox"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/permDepDividerVertical"
        android:background="@color/line_divider_default"
        android:layout_width="@dimen/space_kit_len_divider"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/permDepNext"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary_fill_default"
        android:id="@+id/permDepNext"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Doc_Permission_AddUserSubDep"
        android:drawableEnd="@drawable/perm_svg_right_arrow"
        android:paddingStart="12.5dp"
        android:paddingEnd="16dp"
        android:drawableTint="@color/primary_fill_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/permDepName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
