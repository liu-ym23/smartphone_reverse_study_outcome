<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_anchor_relink_waiting_dialog"
    android:layout_width="match_parent"
    android:layout_height="263dp"
    app:layout_constraintTop_toTopOf="parent">
    <FrameLayout
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#161823"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_link_dialog_relink_waiting_title"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/relink_cancel_btn"
            android:background="@drawable/ttlive_bg_anchor_relink_waiting_cancel_text"
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:text="@string/ttlive_anchor_link_cancel_invite"/>
    </FrameLayout>
    <View
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:id="@+id/ll_invite_anchor_info"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.live.revlink.impl.multianchor.ui.AnchorLinkInfoInviteView
            android:id="@+id/link_anchor_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.bytedance.android.live.revlink.impl.multianchor.ui.AnchorLinkInfoInviteView
            android:id="@+id/link_anchor_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
