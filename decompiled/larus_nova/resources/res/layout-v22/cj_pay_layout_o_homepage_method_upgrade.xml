<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_payment_method"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_payment_method_root"
        android:background="@drawable/cj_pay_bg_r8_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp">
        <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
            android:id="@+id/rv_payment_method_layout"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rv_payment_method_title"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rv_payment_method_title"
            android:background="@drawable/cj_pay_bg_r8_white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:id="@+id/tv_first_group_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_title_bar_chosen_method_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="70dp">
                <ImageView
                    android:id="@+id/iv_chosen_method_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tv_chosen_method_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#14161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_alignBottom="@+id/rv_payment_method_title"
            android:layout_marginHorizontal="16dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_combine_layout"
        android:background="@drawable/cj_pay_bg_r8_white"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp">
        <RelativeLayout
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="13sp"
                android:textColor="#99161823"
                android:id="@+id/tv_combine_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_blue"
                android:id="@+id/tv_combine_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_text_cancel"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <View
                android:background="#14161823"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/balance_item_layout"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/combine_balance_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/combine_balance_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:id="@+id/combine_balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bankcard_item_root_layout"
            android:background="@drawable/cj_pay_bg_gray_press_selector"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/bankcard_item_layout"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/combine_card_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="middle"
                    android:id="@+id/combine_card_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/combine_change_arrow"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/cj_pay_icon_combine_right_arrow_gray"
                    android:scaleType="centerCrop"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/combine_card_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:ellipsize="end"
                android:id="@+id/cj_pay_std_asset_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:id="@+id/ll_voucher_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:gravity="center"
                    android:id="@+id/cj_pay_payment_method_sub_label_first"
                    android:background="@drawable/cj_pay_voucher_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:gravity="center"
                    android:id="@+id/cj_pay_payment_method_sub_label_second"
                    android:background="@drawable/cj_pay_voucher_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
