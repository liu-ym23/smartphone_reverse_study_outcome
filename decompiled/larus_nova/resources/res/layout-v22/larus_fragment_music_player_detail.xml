<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bg_detail_page"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/share_product_container"
        android:layout_width="?attr/larus_dp_1"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/title_bar"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:paddingHorizontal="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start"
            android:id="@+id/btn_close"
            android:padding="?attr/larus_dp_10"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            app:srcCompat="@drawable/larus_bg_music_detail_close_btn_dark"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/btn_more"
            android:padding="?attr/larus_dp_10"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            app:srcCompat="@drawable/larus_ic_music_player_more_menu"/>
    </FrameLayout>
    <com.larus.bmhome.music.widget.MusicPlayerSlidingInfoView
        android:id="@+id/music_info_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/op_container"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_goneMarginTop="?attr/larus_dp_44"/>
    <com.larus.common_ui.video.progress.PlayerProgressView
        android:id="@+id/player_progress"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginBottom="?attr/larus_dp_68"
        android:paddingHorizontal="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/op_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/op_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/download_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toStartOf="@+id/creation_view"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="?attr/larus_dp_0"/>
        <com.larus.bmhome.view.CreationOperateContainerView
            android:id="@+id/creation_view"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/download_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.bmhome.bigimg.template.CommonTemplateLayout
            android:id="@+id/prompt_btn"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="@+id/creation_view"
            app:layout_constraintEnd_toEndOf="@+id/creation_view"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@+id/creation_view"
            app:layout_constraintTop_toTopOf="@+id/creation_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
