<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/bot_avatar"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_160"
        android:layout_marginTop="?attr/larus_dp_56"
        android:src="@drawable/larus_common_ui_avatar_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/bot_name"
        android:paddingLeft="?attr/larus_dp_36"
        android:paddingRight="?attr/larus_dp_36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:paddingHorizontal="?attr/larus_dp_36"
        android:lineHeight="?attr/larus_dp_33"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bot_avatar"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/bot_introduction"
        android:paddingLeft="?attr/larus_dp_36"
        android:paddingRight="?attr/larus_dp_36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:paddingHorizontal="?attr/larus_dp_36"
        android:lineHeight="?attr/larus_dp_25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bot_name"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bot_heat_creator_area"
        android:paddingLeft="?attr/larus_dp_36"
        android:paddingRight="?attr/larus_dp_36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:paddingHorizontal="?attr/larus_dp_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bot_introduction">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/heat_icon"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_24"
            android:src="?attr/larus_share_tag_hot"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_70"
            android:layout_gravity="center_vertical"
            android:id="@+id/bot_heat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/heat_divider_dot"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_17"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_4"
            app:srcCompat="?attr/larus_share_divider_dot"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/creator_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/share_divider"
        android:background="?attr/larus_bg_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bot_heat_creator_area"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer_container"
        android:paddingTop="?attr/larus_dp_22"
        android:paddingBottom="?attr/larus_dp_26"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_divider">
        <include layout="@layout/larus_layout_share_footer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
