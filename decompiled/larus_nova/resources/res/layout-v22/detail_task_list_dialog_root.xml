<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="466dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/task_list_member_role_dialog_bg_panel"
        android:layout_width="match_parent"
        android:layout_height="466dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/close_icon"
                android:layout_width="@dimen/sp_24"
                android:layout_height="@dimen/sp_24"
                android:tint="@color/icon_n1"
                android:layout_marginStart="@dimen/dp_16"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
            <TextView
                android:textSize="@dimen/sp_17"
                android:textColor="@color/text_title"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Todo_AddTaskListInTaskDetails_Placeholder"
                android:layout_marginEnd="@dimen/dp_40"/>
        </LinearLayout>
        <com.suite.lark.emm.design.edittext.SCEditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:id="@+id/search_text"
            android:background="@drawable/detail_task_list_search_bg"
            android:paddingTop="@dimen/dp_9"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/Todo_ManageTaskList_SearchOrCreate_Placeholder"
            android:singleLine="true"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/ud_icon_search_outlined"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:drawableTint="@color/icon_n2"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/loading_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:srcCompat="@drawable/todo_svg_icon_loading"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/task_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_100">
            <ImageView
                android:layout_width="100sp"
                android:layout_height="100sp"
                app:srcCompat="@drawable/illustration_empty_neutral_search_failed"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_17"
                android:text="@string/Lark_Legacy_SearchNoAnyResult"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
