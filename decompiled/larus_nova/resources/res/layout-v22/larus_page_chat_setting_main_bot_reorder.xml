    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:paddingBottom="?attr/larus_dp_16"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/larus_dp_16">
            <FrameLayout
                android:id="@+id/chat_setting_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:id="@+id/user_container"
                android:paddingTop="?attr/larus_dp_8"
                android:paddingBottom="?attr/larus_dp_16"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/multi_account_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:translationY="?attr/larus_dp_m_8"/>
