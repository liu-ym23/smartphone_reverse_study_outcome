                    android:id="@+id/user_avatar"
                    android:layout_width="?attr/larus_dp_110"
                    android:layout_height="?attr/larus_dp_110"
                    android:layout_centerHorizontal="true"
                    android:contentDescription="@string/larus_accessibility_profile_profilePhoto"
                    app:avatar_placeholder="@drawable/larus_common_ui_avatar_placeholder"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nick_name_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:layout_below="@+id/user_avatar"
                    android:layout_centerHorizontal="true">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/larus_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/nick_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/nick_name_chevron"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/nick_name_chevron"
                        android:layout_width="?attr/larus_dp_14"
                        android:layout_height="?attr/larus_dp_14"
                        android:src="@drawable/larus_ic_text_right_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/nick_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_50"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:maxLines="1"
                    android:layout_below="@+id/nick_name_container"
                    android:layout_centerHorizontal="true"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_neutral_100"
                    android:id="@+id/account_settings"
                    android:paddingLeft="?attr/larus_dp_20"
                    android:paddingTop="?attr/larus_dp_10"
                    android:paddingRight="?attr/larus_dp_20"
                    android:paddingBottom="?attr/larus_dp_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:layout_below="@+id/user_name"
                    android:layout_centerHorizontal="true"
                    android:paddingHorizontal="?attr/larus_dp_20"
                    android:paddingVertical="?attr/larus_dp_10"/>
