<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_left"
        android:layout_width="0.1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_right"
        android:layout_width="0.1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="42dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sequence_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.34"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/gl_left"
        app:layout_constraintRight_toRightOf="@+id/gl_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/singing"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/gl_left"
        app:layout_constraintRight_toRightOf="@+id/gl_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/song_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginStart="42dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ttlive_ktv_room_selected_music_content"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/join_chorus"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="20dp"
        android:layout_marginRight="90dp"
        android:text="@string/ttlive_ktv_multi_chorus_name"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#b4b5b9"
        android:id="@+id/mv_show"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MV"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/up"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48"/>
    <View
        android:id="@+id/up"
        android:background="@drawable/ttlive_ktv_selected_music_up_new_style"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48"/>
    <View
        android:id="@+id/pause_restart"
        android:background="@drawable/ttlive_ktv_music_controller_start_pause_new_style"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/change_room_start_song"
        android:background="@drawable/ttlive_bg_ktv_room_selected_item_link_mic_text"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="24dp"
        android:text="@string/ttlive_ktv_room_selected_song_list_change_room"
        android:layout_marginEnd="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/link_mic"
        android:background="@drawable/ttlive_bg_ktv_room_selected_item_link_mic_text"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="24dp"
        android:text="@string/ttlive_ktv_room_selected_song_list_link_mic"
        android:layout_marginEnd="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/remove"
        android:background="@drawable/ttlive_ktv_selected_music_remove_new_style"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
