<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_base_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_music_title_edit"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="600"/>
    <EditText
        android:textSize="17sp"
        android:id="@+id/music_name_edit_text"
        android:background="?attr/larus_bg_input_selector_no_stroke"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_50"
        android:layout_marginTop="?attr/larus_dp_16"
        android:maxLines="1"
        android:maxLength="20"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:autofillHints="@null"
        android:textFontWeight="400"
        style="@style/larus_EditTextStyle"/>
    <View
        android:background="?attr/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_primary_50"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="?attr/larus_bg_base_overlay_left_down_selector"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_music_title_edit_cancel"
            android:layout_weight="1"
            android:textFontWeight="400"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/divider"
            android:background="?attr/larus_item_divider"
            android:layout_width="?attr/larus_dp_0_5"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_primary_50"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="?attr/larus_bg_base_overlay_right_down_selector"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_music_title_edit_complete"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
