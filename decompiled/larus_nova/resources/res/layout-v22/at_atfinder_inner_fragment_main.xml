<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/finder_view_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/layout_shadow_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_checkbox_top"
                android:background="@drawable/facade_round_top_xxl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_body">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:layout_gravity="start|top"
                    android:id="@+id/at_checkbox_top"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_kit_len_8"
                    android:layout_marginStart="@dimen/space_kit_len_8"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/at_checkbox_text_top"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_kit_len_8"
                    android:layout_marginStart="@dimen/space_kit_len_4"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:lineHeight="@dimen/space_kit_len_22"/>
            </LinearLayout>
            <com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/search_result_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:panel_background_color="@color/bg_body"
                app:panel_left_text="@string/Doc_Facade_Cancel"
                app:panel_menu_type="text"
                app:panel_title="@string/Doc_At_MentionTip"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_comment_landscape"
                android:background="@drawable/facade_round_top_xxl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_10"
                android:backgroundTint="@color/bg_body"/>
            <FrameLayout
                android:id="@+id/search_result_container"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"/>
                <FrameLayout
                    android:id="@+id/search_loading_container"
                    android:background="@color/bg_body"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                        android:layout_gravity="center"
                        android:id="@+id/search_loading"
                        android:scaleType="centerInside"
                        app:backgroundAlpha="0.9"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/loading_anim"
                        style="@style/BearLottieView"/>
                </FrameLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/layout_checkbox_bottom"
                android:background="@color/bg_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/at_checkbox_bottom"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ud_checkbox_size="normal"
                    app:ud_checkbox_type="check_box"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/at_checkbox_text_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:lineHeight="@dimen/space_kit_len_22"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/text_placeholder"
        android:gravity="start|center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/search_not_found"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:text="@string/Doc_At_NothingFound"
        android:paddingStart="20dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/search_not_found_for_middle_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_not_found_img"
            android:layout_width="@dimen/space_kit_len_100"
            android:layout_height="@dimen/space_kit_len_100"
            app:srcCompat="@drawable/ccm_empty_neutral_search_failed"/>
        <TextView
            android:textSize="@dimen/space_kit_len_14"
            android:gravity="center"
            android:id="@+id/search_not_found_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:text="@string/Doc_Wiki_Tree_SearchNoResult"/>
    </LinearLayout>
</merge>
