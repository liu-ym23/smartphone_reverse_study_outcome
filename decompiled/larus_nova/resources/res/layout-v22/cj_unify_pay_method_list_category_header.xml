<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:id="@+id/tv_cj_unify_method_group_header_text"
        android:paddingTop="@dimen/cj_pay_padding_12"
        android:paddingBottom="@dimen/cj_pay_padding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:lines="1"
        android:lineSpacingMultiplier="1.38"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_rich_mode"
        android:paddingLeft="@dimen/cj_pay_padding_16"
        android:paddingTop="@dimen/cj_pay_padding_8"
        android:paddingRight="@dimen/cj_pay_padding_16"
        android:paddingBottom="@dimen/cj_pay_padding_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="@dimen/cj_pay_padding_16"
        android:paddingVertical="@dimen/cj_pay_padding_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_round_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">
                <ImageView
                    android:id="@+id/iv_title_image"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <ImageView
                    android:id="@+id/iv_recommend_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <View
                android:layout_width="16dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_right_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:textAlignment="viewEnd"/>
    </LinearLayout>
</FrameLayout>
