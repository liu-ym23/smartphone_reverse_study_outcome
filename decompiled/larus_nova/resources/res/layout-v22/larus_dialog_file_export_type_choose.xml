<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_exportFile_sheet_title"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cancel"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_export_choose_dialog_close"/>
    <com.larus.common_ui.view.FileExportTypeItemView
        android:id="@+id/wordType"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_106"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_15"
        app:layout_constraintEnd_toStartOf="@+id/pdfType"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.larus.common_ui.view.FileExportTypeItemView
        android:id="@+id/pdfType"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_106"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/wordType"
        app:layout_constraintEnd_toStartOf="@+id/txtType"
        app:layout_constraintStart_toEndOf="@+id/wordType"
        app:layout_constraintTop_toTopOf="@+id/wordType"/>
    <com.larus.common_ui.view.FileExportTypeItemView
        android:id="@+id/txtType"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_106"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_15"
        app:layout_constraintBottom_toBottomOf="@+id/wordType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pdfType"
        app:layout_constraintTop_toTopOf="@+id/wordType"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/previewFile"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_10"
        android:text="@string/larus_exportFile_sheet_export"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wordType"
        app:rv_backgroundColor="?attr/larus_primary_50"
        app:rv_cornerRadius="?attr/larus_dp_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
