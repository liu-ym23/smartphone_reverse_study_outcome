<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiNoteOverlayRoot"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/aiNoteScrim"
        android:background="@color/office_sdk_mm_ai_note_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/aiNoteSheetContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/aiNoteContentLayout"
            android:background="@drawable/office_sdk_mm_bg_ai_note_sheet_doubao"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/aiNoteRoot"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/aiNoteHeaderDragArea"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteTitleContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="4dp"
                        android:baselineAligned="false"
                        android:layout_marginStart="20dp">
                        <TextView
                            android:textSize="17sp"
                            android:textColor="@color/flow_ud_neutral_100"
                            android:gravity="center_vertical"
                            android:id="@+id/aiNoteTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:text="@string/View_PersonalNotes_MyOwnJots_Title"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textAppearance="@style/UDText.Caption1"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/aiNoteTrialTag"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-1dp"
                            android:maxWidth="66dp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_marginStart="6dp"
                            android:paddingHorizontal="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="end|bottom"
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteHeaderWaveBarAndDuration"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginBottom="6dp"
                        android:baselineAligned="false"
                        android:minWidth="61dp"
                        android:layout_marginEnd="20dp">
                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp">
                            <com.ss.android.lark.officesdk.minutes.ui.record.recording.ainote.MmAINoteWaveBarView
                                android:layout_gravity="center"
                                android:id="@+id/aiNoteHeaderWaveBarView"
                                android:layout_width="20dp"
                                android:layout_height="20dp"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/flow_ud_neutral_70"
                            android:gravity="center_vertical"
                            android:id="@+id/aiNoteHeaderDurationView"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:includeFontPadding="false"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/aiNoteClose"
                    android:background="@drawable/office_sdk_mm_bg_ai_note_close_doubao"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/aiNoteHeaderDragArea">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/office_sdk_mm_ic_close_doubao"
                        app:tint="@color/flow_ud_neutral_70"/>
                </FrameLayout>
                <com.ss.android.lark.officesdk.minutes.ui.record.recording.ainote.MmAINotePanelGestureInterceptLayout
                    android:id="@+id/aiNoteContentGestureHost"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/aiNoteBottomBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/aiNoteHeaderDragArea">
                    <FrameLayout
                        android:id="@+id/aiNoteEditorContainer"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.ss.android.lark.officesdk.minutes.ui.record.recording.ainote.MmAINotePanelGestureInterceptLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/aiNoteBottomBar"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="34dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/aiNoteEditorContainer">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteSaveSwitchContainer"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/flow_ud_neutral_70"
                            android:id="@+id/aiNoteSaveSwitchLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/View_PersonalNotes_GetMyJots_Switch"/>
                        <com.ss.android.lark.foundation.widget.FlowSwitch
                            android:id="@+id/aiNoteSaveSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <Space
                        android:id="@+id/aiNoteSaveActionSpacer"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteCameraAction"
                        android:background="@drawable/office_sdk_mm_bg_ai_note_action_doubao"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aiNoteCameraIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:srcCompat="@drawable/office_sdk_mm_ic_ud_camera_outlined_doubao"
                            app:tint="@color/flow_ud_neutral_100"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/flow_ud_neutral_100"
                            android:id="@+id/aiNoteCameraText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/View_PersonalNotes_TakePhoto_Button"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <Space
                        android:id="@+id/aiNoteMiddleSpacer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteWaveBarAndDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp">
                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp">
                            <com.ss.android.lark.officesdk.minutes.ui.record.recording.ainote.MmAINoteWaveBarView
                                android:layout_gravity="center"
                                android:id="@+id/aiNoteWaveBarView"
                                android:layout_width="24dp"
                                android:layout_height="24dp"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/flow_ud_neutral_70"
                            android:id="@+id/aiNoteDurationView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <Space
                        android:id="@+id/aiNoteRightSpacer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/aiNoteMarkAction"
                        android:background="@drawable/office_sdk_mm_bg_ai_note_action_doubao"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aiNoteMarkIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:srcCompat="@drawable/office_sdk_mm_ic_ud_flag_outlined_doubao"
                            app:tint="@color/flow_ud_neutral_100"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/flow_ud_neutral_100"
                            android:id="@+id/aiNoteMarkText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/View_PersonalNotes_Highlight_Button"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/flow_ud_static_white"
                    android:gravity="center"
                    android:id="@+id/aiNoteSubtitleMissingTip"
                    android:background="@drawable/office_sdk_mm_bg_ai_note_tip_doubao"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginBottom="30dp"
                    android:text="@string/View_PersonalNotes_NoTranscript_Toast"
                    android:elevation="4dp"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/aiNoteBottomBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/flow_ud_static_white"
                    android:gravity="center"
                    android:id="@+id/aiNoteMarkThrottleTip"
                    android:background="@drawable/office_sdk_mm_bg_ai_note_tip_doubao"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginBottom="30dp"
                    android:text="@string/View_PersonalNotes_TooManyRequests_Toast"
                    android:elevation="4dp"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/aiNoteBottomBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
