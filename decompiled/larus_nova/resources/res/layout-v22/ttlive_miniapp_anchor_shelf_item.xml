<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_miniapp_common_shelf_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginHorizontal="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_content"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/card_cover"
            android:layout_width="87dp"
            android:layout_height="87dp"
            android:scaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="8dp"
            app:roundingBorderColor="#33000000"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/card_index"
            android:background="@drawable/ttlive_bg_miniapp_explain_card_index"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:text="20"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="@+id/card_cover"
            app:layout_constraintTop_toTopOf="@+id/card_cover"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/explaining_area"
            android:background="@drawable/ttlive_bg_miniapp_explaining_area"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="21dp"
            app:layout_constraintBottom_toBottomOf="@+id/card_cover"
            app:layout_constraintLeft_toLeftOf="@+id/card_cover"
            app:layout_constraintRight_toRightOf="@+id/card_cover">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ttlive_ic_card_explaining"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_miniapp_card_btn_explaining"
                android:includeFontPadding="false"
                android:textAlignment="center"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_miniapp_card_title_color"
            android:ellipsize="end"
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:text="讲解卡标题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题题"
            android:maxLines="1"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintLeft_toRightOf="@+id/card_cover"
            app:layout_constraintRight_toLeftOf="@+id/operate_button"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/review_status_tv"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:drawableRight="@drawable/ttlive_open_platform_review_rejected_icon"
            android:drawablePadding="2dp"
            android:drawableEnd="@drawable/ttlive_open_platform_review_rejected_icon"
            android:paddingHorizontal="3dp"
            android:paddingVertical="1dp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="@+id/card_title"
            app:layout_constraintTop_toBottomOf="@+id/card_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_op_color_fe2c55"
            android:ellipsize="end"
            android:id="@+id/selling_point_tv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            app:layout_constraintLeft_toRightOf="@+id/card_cover"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/review_status_tv"/>
        <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductIntroductionLayout
            android:id="@+id/product_introduction"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/card_cover"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/selling_point_tv"/>
        <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductLabelLayout
            android:id="@+id/product_label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toRightOf="@+id/card_cover"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/product_introduction"/>
        <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductPriceView
            android:id="@+id/product_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/card_cover"
            app:layout_constraintRight_toLeftOf="@+id/operate_button"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/operate_button"
            android:background="@drawable/ttlive_bg_miniapp_shelf_check_btn"
            android:layout_width="66dp"
            android:layout_height="28dp"
            android:text="@string/ttlive_miniapp_shelf_page_operate_btn_check"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.openplatform.impl.miniappanchor.shelf.page.display.view.trade.AnchorShelfDisplayTradeLayout
        android:gravity="center_vertical"
        android:id="@+id/trade_layout"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"/>
</LinearLayout>
