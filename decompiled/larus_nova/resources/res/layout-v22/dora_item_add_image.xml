<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_add_image"
    android:background="@drawable/bg_round_base2overlay"
    android:layout_width="?attr/larus_dp_80"
    android:layout_height="?attr/larus_dp_80"
    android:layout_marginEnd="8dp">
    <ImageView
        android:id="@+id/iv_album_icon"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:src="@drawable/larus_ic_photo_add_fill"
        android:contentDescription="Add image"
        app:layout_constraintBottom_toTopOf="@+id/tv_image_count"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/neutral_50"
        android:id="@+id/tv_image_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0/4"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_album_icon"
        app:layout_constraintVertical_bias="0.08"/>
</androidx.constraintlayout.widget.ConstraintLayout>
