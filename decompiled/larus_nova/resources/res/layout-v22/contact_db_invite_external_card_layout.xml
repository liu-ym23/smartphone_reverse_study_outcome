<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llCardLayout"
        android:background="@color/flow_ud_bg_base_2"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="342dp"
        app:rl_radius="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:id="@+id/scvTopAvatarCiv"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:radius="28dp"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/flow_ud_neutral_100"
                android:ellipsize="end"
                android:id="@+id/scvTopTitleTv"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:maxLines="1"
                android:textFontWeight="600"
                app:layout_constraintBottom_toTopOf="@+id/scvTopSubTitleTv"
                app:layout_constraintStart_toEndOf="@+id/scvTopAvatarCiv"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/flow_ud_neutral_50"
                android:ellipsize="end"
                android:id="@+id/scvTopSubTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="256dp"
                android:text="@string/LarkIM_Contacts_ScanCode_AddMe_Desc"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/scvTopTitleTv"
                app:layout_constraintTop_toBottomOf="@+id/scvTopTitleTv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/scvShowInfoInviteLinkQrIvParent"
            android:background="@color/static_white"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:rl_radius="8dp">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:layout_gravity="center"
                android:id="@+id/scvShowInfoInviteLinkQrIv"
                android:layout_width="270dp"
                android:layout_height="270dp"
                app:radius="4dp"/>
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:layout_gravity="center"
                android:id="@+id/scvShowInfoInviteLinkQrLogo"
                android:layout_width="108dp"
                android:layout_height="108dp"
                app:border_color="@color/static_white"
                app:border_width="6dp"
                app:oval="true"/>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/flow_ud_neutral_100"
                android:ellipsize="end"
                android:id="@+id/scvShowInfoNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/flow_ud_neutral_50"
                android:ellipsize="end"
                android:id="@+id/scvShowInfoTenantTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
    </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
</merge>
