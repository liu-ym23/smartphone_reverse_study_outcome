<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/description_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_36"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_tips_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text_view"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/description_text_view1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_tips_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_text_view"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/description_text_view2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_tips_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_text_view1"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/description_text_view3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_tips_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_text_view2"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/description_text_view4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/stop_service_tips_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_text_view3"/>
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:id="@+id/stop_service_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="@dimen/dp_18"
        android:layout_marginRight="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_47"
        android:layout_marginHorizontal="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rv_backgroundColor="@color/base_2"
        app:rv_backgroundPressColor="@color/base_2"
        app:rv_cornerRadius="@dimen/dp_16">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop_service"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
