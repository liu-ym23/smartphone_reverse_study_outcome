<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="10dp">
    <com.bytedance.ee.bear.bitable.card.view.cell.select.SelectTagView
        android:textSize="@dimen/space_kit_font_14"
        android:gravity="center_vertical"
        android:id="@+id/option_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="600dp"
        android:maxHeight="@dimen/space_kit_len_32"
        android:minHeight="@dimen/space_kit_len_24"
        android:includeFontPadding="false"
        android:paddingEnd="16dp"
        android:lineHeight="18dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/closeIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:alpha="0.7"
        android:layout_marginEnd="8dp"
        app:srcCompat="@drawable/ud_icon_close_bold_outlined"/>
</FrameLayout>
