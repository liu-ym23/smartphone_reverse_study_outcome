<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_round_up"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_personal_diary_adjust_style_edit_cn"
            android:layout_centerInParent="true"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_personal_diary_cancel_cn"
            android:layout_centerVertical="true"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_primary_50"
            android:id="@+id/save_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_personal_diary_save_cn"
            android:layout_centerVertical="true"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:layout_alignParentEnd="true"
            android:textFontWeight="600"/>
    </RelativeLayout>
    <EditText
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_neutral_100"
        android:textColorHint="@color/larus_neutral_50"
        android:gravity="start|top"
        android:id="@+id/edit_input"
        android:background="@null"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:hint="@string/larus_dora_personal_diary_adjust_style_default_text_cn"
        android:layout_weight="1"
        android:inputType="textMultiLine"
        android:overScrollMode="always"
        android:paddingHorizontal="?attr/larus_dp_16"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_50"
        android:gravity="end"
        android:id="@+id/count_text"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_4"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_4"/>
</LinearLayout>
