<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_300"
    android:layout_height="?attr/larus_dp_300">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:failureImage="@drawable/larus_generate_image_error"
        app:placeholderImage="?attr/larus_base_2_overlay"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <LinearLayout
        android:id="@+id/image_tips_layout"
        android:background="@drawable/larus_image_tips_background"
        android:paddingLeft="?attr/larus_dp_10"
        android:paddingTop="?attr/larus_dp_7"
        android:paddingRight="?attr/larus_dp_10"
        android:paddingBottom="?attr/larus_dp_7"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_33"
        android:layout_marginTop="?attr/larus_dp_3"
        android:paddingHorizontal="?attr/larus_dp_10"
        android:paddingVertical="?attr/larus_dp_7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_exclamationmark_circle_fill"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/static_white_transparent_25"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/image_tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/image_download"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_download_white_shadow"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:id="@+id/image_download_loading"
        android:padding="?attr/larus_dp_8"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="@+id/image_download"
        app:layout_constraintEnd_toEndOf="@+id/image_download"
        app:layout_constraintStart_toStartOf="@+id/image_download"
        app:layout_constraintTop_toTopOf="@+id/image_download"/>
    <ImageView
        android:id="@+id/image_share"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_share_white_shadow"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_download"/>
    <FrameLayout
        android:id="@+id/image_ai_beautify"
        android:padding="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/larus_bg_gray_btn_radius_8"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_30"
            android:text="@string/larus_aiImage_genResults_btn_aiEdit"
            android:paddingStart="?attr/larus_dp_10"
            android:paddingEnd="?attr/larus_dp_10"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/image_cite"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:padding="?attr/larus_dp_7"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_reply"
        android:contentDescription="@string/larus_message_long_press_reply"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/larus_static_white"/>
    <com.larus.bmhome.chat.layout.widget.ImageCoverEditView
        android:id="@+id/image_cover_edit"
        android:padding="?attr/larus_dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ViewStub
        android:id="@+id/image_loading"
        android:layout="@layout/larus_sketch_progress_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
