<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/remove_ai_watermark_scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingVertical="?attr/larus_dp_8">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/remove_ai_watermark_container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/larus_dp_16">
            <androidx.cardview.widget.CardView
                android:id="@+id/remove_ai_watermark_title_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                app:cardCornerRadius="?attr/larus_dp_16"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/larus_base_2"
                    android:paddingBottom="?attr/larus_dp_24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/remove_ai_watermark_title_image"
                        android:layout_width="?attr/larus_dp_56"
                        android:layout_height="?attr/larus_dp_56"
                        android:layout_marginTop="?attr/larus_dp_24"
                        android:src="@drawable/larus_ic_creation_output_settings"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/remove_ai_watermark_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="?attr/larus_dp_16"
                        android:textFontWeight="600"
                        app:layout_constraintEnd_toEndOf="@+id/remove_ai_watermark_title_image"
                        app:layout_constraintStart_toStartOf="@+id/remove_ai_watermark_title_image"
                        app:layout_constraintTop_toBottomOf="@+id/remove_ai_watermark_title_image"/>
                    <com.larus.common_ui.widget.UrlSpanTextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="@color/larus_neutral_70"
                        android:gravity="center"
                        android:id="@+id/remove_ai_watermark_sub_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_4"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="?attr/larus_dp_16"
                        android:textFontWeight="400"
                        app:larus_linkColor="@color/larus_neutral_100"
                        app:larus_linkUnderLine="false"
                        app:layout_constraintEnd_toEndOf="@+id/remove_ai_watermark_title"
                        app:layout_constraintStart_toStartOf="@+id/remove_ai_watermark_title"
                        app:layout_constraintTop_toBottomOf="@+id/remove_ai_watermark_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/remove_ai_watermark_options_group"
                android:background="@drawable/larus_bg_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/remove_ai_watermark_document_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/remove_ai_watermark_media_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
