<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/larus_bg_action_bar_instruction_widget_item"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_38">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ic_item_img"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_item_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_14"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ic_item_right_img"
            app:layout_constraintStart_toEndOf="@+id/ic_item_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="?attr/larus_dp_14"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ic_item_right_img"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_2"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_item_name"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
