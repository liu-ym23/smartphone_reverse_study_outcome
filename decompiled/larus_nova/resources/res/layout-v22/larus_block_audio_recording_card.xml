<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_record_initial_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/audio_recording_loading_text"
            android:background="?attr/larus_base_2_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/audio_recording_auth_btn"
            android:background="@drawable/larus_bg_record_auto_change"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_22"
            android:text="@string/larus_memo_record_card_authorize_button"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"
            app:layout_constraintTop_toBottomOf="@+id/audio_recording_loading_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_recording_card"
        android:background="@drawable/larus_bg_audio_recording_card"
        android:paddingBottom="@dimen/dp_14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/audio_recording_icon"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:src="@drawable/larus_icon_audio_recording"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/audio_recording_sound_wave_view"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/audio_recording_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/audio_recording_icon"
            app:lottie_autoPlay="true"
            app:lottie_colorFilter="?attr/larus_neutral_70"
            app:lottie_fileName="larus_audio_recording.json"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/audio_recording_icon_pause"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_icon_audio_record_pause"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/audio_recording_icon"
            app:layout_constraintEnd_toStartOf="@+id/audio_recording_sound_wave_view"
            app:layout_constraintTop_toTopOf="@+id/audio_recording_icon"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/audio_recording_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/audio_recording_icon"
            app:layout_constraintEnd_toStartOf="@+id/audio_recording_icon_pause"
            app:layout_constraintTop_toTopOf="@+id/audio_recording_icon"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="start"
            android:id="@+id/audio_recording_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_desktop_shortcuts_setting_recordMeeting"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/sp_6"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/audio_recording_icon"
            app:layout_constraintEnd_toStartOf="@+id/audio_recording_duration"
            app:layout_constraintStart_toEndOf="@+id/audio_recording_icon"
            app:layout_constraintTop_toTopOf="@+id/audio_recording_icon"/>
        <View
            android:id="@+id/audio_record_sep_line"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_recording_icon"/>
        <com.larus.office.card.minutes.view.ThreeLinesTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="start"
            android:gravity="start|top"
            android:id="@+id/audio_recording_asr_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginRight="@dimen/dp_16"
            android:minHeight="?attr/larus_dp_66"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:lineHeight="?attr/larus_dp_22"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_record_sep_line"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerTextView
            android:textSize="@dimen/sp_15"
            android:gravity="start|top"
            android:id="@+id/audio_recording_shimmer_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_46"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/larus_audioTrans_processing_text"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_recording_asr_result"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/audio_recording_result_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/larus_memo_record_card_ended_status_button"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:lineHeight="?attr/larus_dp_22"
            android:textFontWeight="400"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audio_record_sep_line"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_danger_50"
            android:gravity="center"
            android:id="@+id/audio_recording_stop_btn"
            android:background="@drawable/larus_bg_stop_audio_recording"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="?attr/larus_dp_22"
            android:layout_marginRight="@dimen/dp_16"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:textFontWeight="500"
            app:layout_constraintTop_toBottomOf="@+id/audio_recording_shimmer_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
