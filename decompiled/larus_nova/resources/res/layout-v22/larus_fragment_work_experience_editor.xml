<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_mode_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="?attr/larus_dp_4"
            android:paddingRight="?attr/larus_dp_4"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:paddingHorizontal="?attr/larus_dp_4">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/work_experience_editor_close"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:contentDescription="@string/larus_accessibility_icon_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_close_dialog"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/work_experience_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/work_experience_editor_save"
                android:padding="?attr/larus_dp_8"
                android:focusable="true"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:contentDescription="@string/larus_dora_btn_done_cn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_input_modify_confirm"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView
            android:id="@+id/work_experience_editor_scroll"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="?attr/larus_dp_16">
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_100"
                    android:id="@+id/work_experience_editor_name_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/larus_dp_4"
                    android:layout_marginRight="?attr/larus_dp_4"
                    android:text="@string/larus_moa_work_experience_name_cn"
                    android:layout_marginHorizontal="?attr/larus_dp_4"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="?attr/larus_neutral_100"
                    android:textColorHint="?attr/larus_neutral_50"
                    android:id="@+id/work_experience_editor_name"
                    android:background="@drawable/larus_bg_office_task_instruction_editor"
                    android:paddingLeft="?attr/larus_dp_16"
                    android:paddingRight="?attr/larus_dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_52"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:hint="@string/larus_moa_work_experience_type_in_cn"
                    android:maxLines="1"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="?attr/larus_dp_16"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_100"
                    android:id="@+id/work_experience_editor_description_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/larus_dp_4"
                    android:layout_marginTop="?attr/larus_dp_20"
                    android:layout_marginRight="?attr/larus_dp_4"
                    android:text="@string/larus_moa_work_experience_description_cn"
                    android:layout_marginHorizontal="?attr/larus_dp_4"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="?attr/larus_neutral_100"
                    android:textColorHint="?attr/larus_neutral_50"
                    android:gravity="start|top"
                    android:id="@+id/work_experience_editor_description"
                    android:background="@drawable/larus_bg_office_task_instruction_editor"
                    android:padding="?attr/larus_dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:minHeight="?attr/larus_dp_52"
                    android:hint="@string/larus_moa_work_experience_type_in_cn"
                    android:inputType="textMultiLine"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_100"
                    android:id="@+id/work_experience_editor_details_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/larus_dp_4"
                    android:layout_marginTop="?attr/larus_dp_20"
                    android:layout_marginRight="?attr/larus_dp_4"
                    android:text="@string/larus_moa_work_experience_detail_cn"
                    android:layout_marginHorizontal="?attr/larus_dp_4"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="?attr/larus_neutral_100"
                    android:textColorHint="?attr/larus_neutral_50"
                    android:gravity="start|top"
                    android:id="@+id/work_experience_editor_details"
                    android:background="@drawable/larus_bg_office_task_instruction_editor"
                    android:padding="?attr/larus_dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:minHeight="?attr/larus_dp_180"
                    android:hint="@string/larus_moa_work_experience_type_in_cn"
                    android:inputType="textMultiLine"/>
            </LinearLayout>
        </com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/work_experience_editor_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
