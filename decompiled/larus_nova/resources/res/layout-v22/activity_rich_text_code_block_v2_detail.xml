<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tb_title="@string/Lark_IM_CodeBlock_Title"
        app:tb_title_color="@color/text_title"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fetch_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fetch_loading_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/dp_8"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_caption"
            android:id="@+id/fetch_loading_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Legacy_Loading"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/process_failed_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/process_failed_iv"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:srcCompat="@drawable/illustration_empty_neutral_no_preview"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/process_failed_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="248dp"
            android:text="@string/Lark_Legacy_ErrorMessageTip"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/content_layout"
        android:paddingBottom="42dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="8dp"
            android:layout_marginHorizontal="8dp">
            <com.ss.android.lark.widget.richtext.codeblockv2.CodeBlockV2DetailView
                android:id="@+id/code_block_line_num_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.ss.android.lark.widget.richtext.codeblockv2.CodeBlockV2DetailView
                    android:id="@+id/code_block_content_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
