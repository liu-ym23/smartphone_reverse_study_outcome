<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/experience_plan_title_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/experience_plan_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/experience_plan_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/experience_plan_header_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_104"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/experience_plan_app_icon"
                android:layout_width="@dimen/dp_78"
                android:layout_height="@dimen/dp_78"
                android:layout_marginTop="@dimen/dp_9"
                android:src="@drawable/obric_guide_doubao_icon"/>
            <TextView
                android:textSize="@dimen/dp_26"
                android:textColor="@color/obric_guide_text_1"
                android:layout_gravity="center"
                android:id="@+id/experience_plan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_21"
                android:text="@string/obric_user_experience_plan_join"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/obric_guide_text_1"
                android:layout_gravity="center"
                android:id="@+id/experience_plan_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:layout_marginBottom="@dimen/dp_26"
                android:text="@string/obric_user_experience_plan_guide_subtitle"
                android:textFontWeight="400"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/experience_plan_illustration_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/experience_plan_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/experience_plan_header"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:id="@+id/experience_plan_illustration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/obric_guide_experience_improve_o"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/experience_plan_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dp_13"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/experience_plan_description"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_22"
            android:layout_marginRight="@dimen/dp_22"
            android:layout_marginBottom="@dimen/dp_14"
            android:text="@string/obric_user_experience_plan_feedback_summary"
            android:layout_marginHorizontal="@dimen/dp_22"
            android:textFontWeight="400"
            app:layout_constraintBottom_toTopOf="@+id/experience_plan_join_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/experience_plan_join_button"
            android:layout_width="@dimen/dp_338"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_13"
            android:text="@string/obric_user_experience_plan_guide_join"
            app:layout_constraintBottom_toTopOf="@+id/experience_plan_later_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/obric_guide_text_1"
            android:gravity="center"
            android:id="@+id/experience_plan_later_button"
            android:layout_width="@dimen/dp_338"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/obric_setting_later"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Trans.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
