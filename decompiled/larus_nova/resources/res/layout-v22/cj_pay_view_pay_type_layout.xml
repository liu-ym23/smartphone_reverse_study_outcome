<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_view_pay_type_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="20dp">
    <RelativeLayout
        android:id="@+id/pay_type_area_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/pay_type_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:id="@+id/tv_pay_type"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_pwd_pay_method"
                android:includeFontPadding="false"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_pay_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:id="@+id/tv_sub_pay_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/cj_pay_padding_10"
                android:textColor="#99161823"
                android:gravity="center"
                android:id="@+id/cj_pay_bind_card_tag"
                android:background="@drawable/cj_pay_bg_bind_card_tag_round_corner"
                android:paddingLeft="@dimen/cj_pay_padding_3"
                android:paddingRight="@dimen/cj_pay_padding_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cj_pay_padding_16"
                android:layout_marginLeft="@dimen/cj_pay_padding_4"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/cj_pay_padding_4"
                android:paddingHorizontal="@dimen/cj_pay_padding_3"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/cj_pay_right_arrow"
                android:scaleType="centerCrop"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_payment"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/pay_type_layout">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/tv_payment_name"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/tv_payment_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
