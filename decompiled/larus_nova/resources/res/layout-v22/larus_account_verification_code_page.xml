<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.bmhome.view.NovaTitleBarEx
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_60"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center_horizontal"
            android:id="@+id/send_code_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_25"
            android:text=""/>
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center_horizontal"
            android:id="@+id/phone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_11"
            android:text=""
            android:textDirection="ltr"/>
        <com.larus.common_ui.widget.SeparatedEditText
            android:layout_gravity="center_horizontal"
            android:id="@+id/edit_solid"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_48"
            android:inputType="number"
            android:imeOptions="flagNoExtractUi"
            app:larus_blockColor="@color/larus_base_2_overlay"
            app:larus_blockSpacing="?attr/larus_dp_4"
            app:larus_borderColor="@color/larus_primary_50"
            app:larus_borderWidth="?attr/larus_dp_2"
            app:larus_corner="?attr/larus_dp_16"
            app:larus_cursorColor="@color/larus_primary_50"
            app:larus_cursorDuration="1000"
            app:larus_cursorWidth="?attr/larus_dp_2"
            app:larus_forceUseLtr="true"
            app:larus_highLightEnable="true"
            app:larus_separateEqual="false"
            app:larus_separateType="@integer/larus_type_solid"
            app:larus_showKeyboard="false"
            app:larus_textColor="@color/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_neutral_30"
            android:layout_gravity="center_horizontal"
            android:id="@+id/phone_hint_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:text=""/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_primary_50"
            android:gravity="center"
            android:id="@+id/verification_code_note"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginRight="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="?attr/larus_dp_24"
            android:lineHeight="?attr/larus_dp_20"
            android:textFontWeight="500"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/dialogFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
