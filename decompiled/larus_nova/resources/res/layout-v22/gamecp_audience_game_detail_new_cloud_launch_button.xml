<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cloud_game_launch_btn_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cloud_game_launch"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp">
        <TextView
            android:textSize="15sp"
            android:ellipsize="end"
            android:id="@+id/cloud_launch_btn_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_mini_game_instant_play"
            android:singleLine="true"
            android:textFontWeight="500"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cloud_launch_btn_sub_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/cloud_launch_btn_sub_icon"
                android:layout_width="10.5sp"
                android:layout_height="13sp"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="1dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@drawable/gamecp_cloud_launch_btn_icon"
                app:failureImageScaleType="centerCrop"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/gamecp_game_FE2C55"
                android:ellipsize="end"
                android:id="@+id/cloud_launch_btn_sub_txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/gamecp_anchor_team_building"
                android:singleLine="true"
                android:paddingEnd="1dp"
                android:textFontWeight="500"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cloud_game_play_the_same_layout"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp">
        <TextView
            android:textSize="15sp"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_play_the_same_game"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gamecp_play_the_same_game2"
            android:singleLine="true"
            android:textFontWeight="500"/>
    </LinearLayout>
</FrameLayout>
