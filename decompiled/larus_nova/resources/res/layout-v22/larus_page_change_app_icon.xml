<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/larus_page_change_app_icon_332758940"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_title_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/app_icon_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/subTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mainTitle"/>
        <ImageView
            android:id="@+id/backImageView"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_ic_left_back"
            android:contentDescription="@string/larus_accessibility_icon_back"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/mainTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mainTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_icon_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/bottom_select_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_title_group"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_select_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_icon_list">
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/voice_group"
            android:background="@drawable/larus_bg_bot_setting_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/voiceTextArrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_bot_setting_voice"
                android:textFontWeight="500"
                app:larus_image_height="?attr/larus_dp_32"
                app:larus_image_src="@drawable/larus_icon_tts_speaker"
                app:larus_image_width="?attr/larus_dp_32"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:id="@+id/start_use_icon"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_36"
            android:layout_marginHorizontal="?attr/larus_dp_16"
            android:paddingVertical="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_group"
            app:rv_backgroundColor="@color/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_static_white"
                android:gravity="center_horizontal"
                android:id="@+id/startText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
