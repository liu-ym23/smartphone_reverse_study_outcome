<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_64"
    android:paddingHorizontal="?attr/larus_dp_16">
    <com.larus.bmhome.view.RoundAvatarImageView
        android:id="@+id/avatar"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_display_name"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_26"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/btn_remove"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="?attr/larus_dp_12"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_20"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_remove"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_display_name"
        app:layout_goneMarginEnd="?attr/larus_dp_12"/>
    <ImageView
        android:id="@+id/checked_container"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:src="@drawable/larus_ic_multi_account_checked"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/unchecked_circle"
        android:background="@drawable/larus_bg_multi_account_unchecked"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/btn_remove"
        android:background="@drawable/larus_bg_btn_r8_transparent_1"
        android:paddingLeft="?attr/larus_dp_14"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_14"
        android:paddingBottom="?attr/larus_dp_8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_switchAccount_accRemoval_popup_remove"
        android:paddingHorizontal="?attr/larus_dp_14"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_1"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_display_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
