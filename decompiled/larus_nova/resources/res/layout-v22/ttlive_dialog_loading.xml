<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_loading"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="104dp"
        android:layout_height="76dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="false"
            android:indeterminateDrawable="@drawable/uikit_loading_anim"
            android:indeterminateDuration="800"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="72sp"
            android:text="加载中"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_btn"
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_s_s_xmark_outlined_12"
        android:layout_marginEnd="8dp"
        app:tint="@color/ConstTextInverse5"/>
</FrameLayout>
