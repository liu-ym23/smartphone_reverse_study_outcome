<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:id="@+id/shop_search_hint"
        android:visibility="gone"
        android:layout_width="32sp"
        android:layout_height="4sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/ec_shop_33161823"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/commerce_store_search_top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/commerce_store_search_result_back"
            android:padding="5dp"
            android:layout_width="34sp"
            android:layout_height="34sp"
            android:layout_marginLeft="11dp"
            android:src="@drawable/shopping_ic_store_v2_back_black"
            android:layout_marginStart="11dp"/>
        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/commerce_store_search_title_bg"
                android:background="@drawable/shape_bg_white_corner36"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="16dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="16dp"/>
            <FrameLayout
                android:id="@+id/commerce_store_right_icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignRight="@+id/commerce_store_search_title_bg"
                android:layout_centerVertical="true"
                android:layout_alignEnd="@+id/commerce_store_search_title_bg">
                <ImageView
                    android:id="@+id/commerce_store_search_close"
                    android:background="@drawable/ecommerce_store_ic_search_close"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:layout_marginEnd="12dp"/>
                <ImageView
                    android:id="@+id/commerce_store_search_camera"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/search_camera_img"
                    android:paddingEnd="12dp"
                    android:paddingVertical="2dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/commerce_store_search_icon"
                android:background="@drawable/shopping_ic_store_compat_search_icon_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_alignLeft="@+id/commerce_store_search_title_bg"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_alignStart="@+id/commerce_store_search_title_bg"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/commerce_text_reverse"
                android:gravity="start|center_vertical"
                android:id="@+id/commerce_store_search_input"
                android:background="@color/transparent"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_toRightOf="@+id/commerce_store_search_icon"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="2dp"
                android:textCursorDrawable="@drawable/commerce_ic_cursor"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_marginStart="4.5dp"
                android:layout_marginEnd="4.5dp"
                android:layout_toStartOf="@+id/commerce_store_right_icon_container"
                android:layout_toEndOf="@+id/commerce_store_search_icon"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/ec_store_fold_close_btn"
            android:visibility="gone"
            android:layout_width="24sp"
            android:layout_height="24sp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/shopping_ic_store_sheet_close_black"/>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout
        android:id="@+id/store_search_result_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
