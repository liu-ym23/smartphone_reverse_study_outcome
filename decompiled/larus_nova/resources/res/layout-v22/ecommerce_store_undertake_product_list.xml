<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl_all_product_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="124dp"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/undertake_product_list_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/store_live_sort_area_bg_white"
        android:background="@color/shopping_std_text_tooltip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <View
        android:id="@+id/store_live_sort_area"
        android:background="@drawable/shopping_store_live_sort_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/store_sort_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ec_store_product_list_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/store_sort_bar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/undertake_rv_product_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/ec_store_float_cart_entry"
            android:background="@drawable/ec_store_ic_cart_round_white_new"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="98dp"
            android:layout_marginEnd="14dp"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/shopping_std_text_black_3"
        android:gravity="center"
        android:id="@+id/undertake_product_publicity"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:maxLines="3"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="32dp"
        style="@style/font_size_24"/>
</RelativeLayout>
