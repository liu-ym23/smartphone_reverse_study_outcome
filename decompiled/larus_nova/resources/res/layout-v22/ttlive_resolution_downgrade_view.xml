<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="24dp">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/notification_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_audience_resolution_degrade_toast"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textAlignment="center"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/notification_resolution"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/notification_resolution"
        app:layout_constraintTop_toTopOf="@+id/notification_resolution"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#face15"
        android:id="@+id/notification_resolution"
        android:background="@drawable/ttlive_bg_resolution_downgrade"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/notification_hint"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
