<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/todo_container_item_bg"
    android:paddingTop="@dimen/dp_1"
    android:paddingBottom="@dimen/dp_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_6"
    android:layout_marginEnd="@dimen/dp_6">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_select_item"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        android:paddingVertical="2dp">
        <ImageView
            android:id="@+id/img_task_list_icon"
            android:layout_width="20sp"
            android:layout_height="20sp"
            android:layout_marginStart="@dimen/dp_16"/>
        <View
            android:id="@+id/divider_view"
            android:layout_width="@dimen/dp_12"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/todo_container_item_text_color"
            android:ellipsize="end"
            android:id="@+id/tv_container_name"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingVertical="10dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_archive"
                android:paddingLeft="12sp"
                android:paddingTop="12sp"
                android:paddingBottom="12sp"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:tint="@color/icon_n3"
                android:paddingVertical="12sp"
                app:srcCompat="@drawable/ud_icon_massage_box_out_outlined"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_action_more"
                android:padding="12sp"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
