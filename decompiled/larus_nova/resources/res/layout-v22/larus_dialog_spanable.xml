<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="600"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_content"
        android:background="@drawable/larus_alert_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_108"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title">
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/dialog_message"
            android:paddingBottom="?attr/larus_dp_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textFontWeight="400"
            app:larus_linkColor="?attr/larus_primary_50"
            app:larus_linkUnderLine="false"/>
    </ScrollView>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_sp_14"
        android:id="@+id/bottom_individual_text"
        android:paddingLeft="?attr/larus_dp_40"
        android:paddingRight="?attr/larus_dp_40"
        android:paddingBottom="?attr/larus_dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_preinstall_privacy_privacy_term"
        app:larus_linkColor="?attr/larus_primary_50"
        app:larus_linkUnderLine="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_5"
        app:layout_constraintTop_toBottomOf="@+id/bottom_individual_text"
        app:layout_goneMarginTop="?attr/larus_dp_5">
        <View
            android:background="?attr/larus_item_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            app:layout_constraintTop_toBottomOf="@+id/bottom_individual_text">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="?attr/larus_bg_leftdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_cancel"
                android:layout_weight="1"
                android:textFontWeight="400"/>
            <View
                android:layout_gravity="center_horizontal"
                android:background="?attr/larus_item_divider"
                android:layout_width="?attr/larus_dp_0_5"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="?attr/larus_bg_rightdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_save"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_alert_bg"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/scroll_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
