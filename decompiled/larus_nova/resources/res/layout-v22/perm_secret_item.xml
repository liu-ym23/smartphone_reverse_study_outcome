<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingEnd="@dimen/dp_12">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/checkBox"
        android:clickable="false"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/secretName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="radio"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:id="@+id/secretName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11.5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/checkBox"
        app:layout_constraintRight_toLeftOf="@+id/secretTag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/space_kit_font_12"
        android:textColor="@color/text_title"
        android:id="@+id/secretTag"
        android:background="@drawable/sec_approve_default_tag"
        android:paddingLeft="@dimen/dp_8"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:text="@string/LarkCCM_Workspace_SecLeviI_Default_Tag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/secretName"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/secretName"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/secretDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkBox"
        app:layout_constraintTop_toBottomOf="@+id/secretName"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/function_warning_content_default"
        android:id="@+id/secretApplyTips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkBox"
        app:layout_constraintTop_toBottomOf="@+id/secretDesc"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ud_B600"
        android:id="@+id/approveMsg"
        android:background="@drawable/sec_approve_review_bg"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/secretName"
        app:layout_constraintTop_toBottomOf="@+id/secretApplyTips"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_search_tips"
        android:background="@drawable/bg_sec_search_tips"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/approveMsg">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/tvSearchTips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"
            android:layout_marginHorizontal="@dimen/dp_10"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_search_box_status"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.larksuite.component.universe_design.checkbox.UDCheckBox
                android:id="@+id/cb_search_box_status"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                app:ud_checkbox_size="small"
                app:ud_checkbox_type="check_box"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:id="@+id/tv_search_box_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/ud_divider_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_divider"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/secretDesc"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
