<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/card_background_image"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_124"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/card_title"
        android:paddingLeft="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_40"
        android:maxLines="1"
        android:paddingHorizontal="?attr/larus_dp_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_background_image"/>
    <View
        android:background="?attr/larus_fg_aweme_travel_card_suggest_item_v2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
