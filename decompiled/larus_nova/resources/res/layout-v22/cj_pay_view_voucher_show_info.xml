<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_voucher_info_left"
        android:background="@drawable/cj_ic_voucher_left"
        android:layout_width="wrap_content"
        android:layout_height="19dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:gravity="center_vertical"
            android:id="@+id/tv_voucher_show_info_left"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:paddingHorizontal="2dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_voucher_show_info_left"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/cj_ic_voucher_platform_logo_bd_base"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="2dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:gravity="center_vertical"
        android:id="@+id/tv_voucher_show_info_right"
        android:background="@drawable/cj_ic_voucher_right"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginLeft="-0.5dp"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</LinearLayout>
