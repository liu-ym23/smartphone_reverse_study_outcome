<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_state_container"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingBottom="120dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp">
        <ImageView
            android:id="@+id/empty_state_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:gravity="center"
            android:id="@+id/empty_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textFontWeight="600"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_static_white"
            android:id="@+id/empty_state_action"
            android:background="@drawable/contact_db_empty_state_action_primary"
            android:paddingLeft="28dp"
            android:paddingTop="11dp"
            android:paddingRight="28dp"
            android:paddingBottom="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="11dp"
            android:textFontWeight="600"/>
    </LinearLayout>
</FrameLayout>
