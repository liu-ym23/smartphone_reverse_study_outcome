<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <RelativeLayout
        android:background="@drawable/ttlive_mini_app_choose_list_search_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/cancel_search"
        android:layout_toStartOf="@+id/cancel_search">
        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_mini_app_choose_list_search_icon"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"/>
        <EditText
            android:textSize="15sp"
            android:textColor="#161823"
            android:textColorHint="#80161823"
            android:id="@+id/search_edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:hint="@string/ttlive_mini_app_choose_search_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/clear_search_input"
            android:layout_toRightOf="@+id/search_icon"
            android:layout_centerVertical="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_toStartOf="@+id/clear_search_input"
            android:layout_toEndOf="@+id/search_icon"
            android:layout_marginHorizontal="4dp"/>
        <ImageView
            android:id="@+id/clear_search_input"
            android:visibility="invisible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_mini_app_choose_search_clear_input_icon"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/cancel_search"
        android:paddingLeft="16dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_mini_app_choose_search_cancel"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
