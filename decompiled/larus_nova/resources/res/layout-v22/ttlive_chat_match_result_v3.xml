<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_fast_match_result_v3_container_height"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="14dp"
        android:textColor="#88161823"
        android:id="@+id/cancel_btn"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_avatar_container"
        android:background="@drawable/ttlive_chat_match_avatar_border"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cancel_btn">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_view"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_anim"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
            app:layout_constraintRight_toRightOf="@+id/ttlive_avatar_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_room_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_avatar_container">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/avatar_name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/avatar_name_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="228dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="9dp"
                android:textStyle="bold"
                android:textColor="#80161823"
                android:id="@+id/avatar_tag"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="同城"
                android:maxLines="1"
                android:paddingHorizontal="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/guest_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_name_container">
            <com.bytedance.android.livesdk.chatroom.ui.NoTouchRecyclerView
                android:id="@+id/avatar_rv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#80161823"
                android:gravity="center"
                android:id="@+id/link_guest_num"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="5dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_room_info_container">
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:id="@+id/more_room_btn"
            android:background="@drawable/ttlive_btn_more_room_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="@string/ttlive_interact_more_room"
            android:layout_weight="1"/>
        <com.bytedance.android.livesdk.widget.desc.CountDownWithDescTextView
            android:id="@+id/match_go_btn"
            android:background="@drawable/ttlive_btn_match_chat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="11dp"
            android:layout_weight="1"
            android:layout_marginStart="11dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
