<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/midi_feed_back_container_v2"
    android:background="@drawable/ttlive_ktv_component_feedback_bg_success"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:minWidth="160dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintHorizontal_bias="1"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/ttlive_ktv_component_feedback_watermark_iv"
        android:layout_width="39dp"
        android:layout_height="31dp"
        android:src="@drawable/ttlive_ktv_component_feedback_watermark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/ktv_component_feed_back_music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="《孤勇者224...》"
        android:textFontWeight="500"
        app:layout_constraintEnd_toStartOf="@+id/ktv_component_feed_back_score_number"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="italic"
        android:gravity="center"
        android:id="@+id/ktv_component_feed_back_score_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        android:text="77"
        android:textFontWeight="700"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_component_feed_back_music_name"
        app:layout_constraintEnd_toStartOf="@+id/ktv_component_feed_back_score"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="italic"
        android:id="@+id/ktv_component_feed_back_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="45dp"
        android:text="分"
        android:textFontWeight="700"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_component_feed_back_music_name"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:id="@+id/ktv_component_feed_back_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小樱桃哈...达成"
            android:maxLines="1"
            android:textFontWeight="400"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ktv_component_feed_back_high_score_achievement"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="12dp"
            android:src="@drawable/ktv_midi_high_score_achievement"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
