<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_view_more"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_10">
        <com.larus.common_ui.view.AvatarListView
            android:id="@+id/avatar_list"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:layout_marginEnd="?attr/larus_dp_15"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_db_feed_chatList_viewMore_cn"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"
            app:srcCompat="?attr/larus_icon_chevron_down_fill_2"/>
    </LinearLayout>
    <com.larus.common_ui.widget.GradientTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_static_black"
        android:gravity="center"
        android:id="@+id/divider_text"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_db_feed_recommend_tip_cn"
        android:paddingHorizontal="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"/>
</LinearLayout>
