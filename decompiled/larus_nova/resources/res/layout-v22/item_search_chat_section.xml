    android:background="?attr/larus_bg_search_item"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56"
    android:paddingStart="?attr/larus_dp_20"
    android:paddingEnd="?attr/larus_dp_20">
