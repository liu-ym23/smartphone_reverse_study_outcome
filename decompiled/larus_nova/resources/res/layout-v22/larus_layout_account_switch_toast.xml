<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/larus_base_3"
    app:cardCornerRadius="?attr/larus_dp_16"
    app:cardElevation="?attr/larus_dp_5"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_16"
        android:paddingVertical="?attr/larus_dp_12">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/lottie"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <com.larus.bmhome.view.RoundAvatarImageView
            android:id="@+id/icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
