<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_view_pay_type_combine_layout"
    android:background="?attr/cj_pay_bg_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="20dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_combine_type_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:id="@+id/cj_pay_tv_pay_type"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_pwd_pay_method"
            android:includeFontPadding="false"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/cj_pay_type_click_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_iv_pay_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/cj_pay_text_secondary"
                android:id="@+id/cj_pay_tv_sub_pay_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/cj_pay_padding_10"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:gravity="center"
                android:id="@+id/cj_pay_bind_card_tag"
                android:background="@drawable/cj_pay_bg_bind_card_tag_round_corner"
                android:paddingLeft="@dimen/cj_pay_padding_3"
                android:paddingRight="@dimen/cj_pay_padding_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cj_pay_padding_16"
                android:layout_marginLeft="@dimen/cj_pay_padding_4"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/cj_pay_padding_4"
                android:paddingHorizontal="@dimen/cj_pay_padding_3"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_iv_arrow"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:src="?attr/cj_pay_right_arrow"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_ll_payment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/cj_pay_combine_type_layout">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:id="@+id/cj_pay_tv_payment_name"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/cj_pay_tv_payment_info"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/cj_pay_tv_payment_info"
            android:paddingLeft="24dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_tv_payment_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_yf_fee_compliance_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/cj_pay_ll_payment">
        <TextView
            android:textSize="10dp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/cj_pay_yf_fee_compliance_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_yf_fee_compliance_icon"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/cj_pay_info_icon"/>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/cj_pay_std_sub_asset_scroll_layout"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_below="@+id/cj_pay_combine_type_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_std_sub_asset_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_combine_pay_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/cj_pay_combine_type_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_balance_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_combine_balance_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:id="@+id/cj_pay_combine_balance_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:id="@+id/cj_pay_combine_balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cj_pay_bankcard_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/balance_item_layout">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_combine_card_click_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_combine_card_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:id="@+id/cj_pay_combine_card_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_combine_change_arrow"
                    android:layout_width="16sp"
                    android:layout_height="16sp"
                    android:layout_marginTop="1dp"
                    android:src="?attr/cj_pay_right_arrow"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:id="@+id/cj_pay_combine_card_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJRowSwitchText
        android:id="@+id/cj_pay_bank_card_points_selection"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/cj_pay_combine_pay_layout"
        app:CJRowSwitchChecked="false"
        app:CJRowSwitchContent=""
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</RelativeLayout>
