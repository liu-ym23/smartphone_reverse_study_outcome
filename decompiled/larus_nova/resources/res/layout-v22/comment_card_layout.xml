<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pop_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/pop_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout
            android:id="@+id/rl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/UDShadow.L.Up">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/facade_round_top_xxl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="0dp"
                android:backgroundTint="@color/bg_float">
                <View
                    android:id="@+id/comment_top_divider"
                    android:background="@drawable/facade_dragview_handler"
                    android:visibility="visible"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:id="@+id/comment_title_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/comment_top_divider">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:enabled="false"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/icon_prev"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="9dp"
                        app:srcCompat="@drawable/ud_icon_left_outlined"
                        app:tint="@color/facade_selector_icon_n1"/>
                    <TextView
                        android:textSize="@dimen/space_kit_font_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_title"
                        android:gravity="center"
                        android:id="@+id/tv_page_title"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/Doc_Facade_Comment"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:enabled="false"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/icon_next"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="9dp"
                        app:srcCompat="@drawable/ud_icon_right_outlined"
                        app:tint="@color/facade_selector_icon_n1"/>
                </LinearLayout>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_opt_comment"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:drawableStart="@drawable/ud_icon_more_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawableTint="@color/facade_selector_icon_n1"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"/>
                <ImageView
                    android:id="@+id/comment_close_full"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:src="@drawable/ud_icon_close_small_outlined"
                    android:tint="@color/facade_selector_icon_n1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"/>
                <ImageView
                    android:id="@+id/comment_back_arrow"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:src="@drawable/ud_icon_left_outlined"
                    android:tint="@color/facade_selector_icon_n1"
                    android:paddingStart="14dp"
                    app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"/>
                <View
                    android:id="@+id/divider_title"
                    android:background="@color/line_divider_default"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    app:layout_constraintTop_toBottomOf="@+id/comment_back_arrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout>
        <com.bytedance.ee.bear.widgets.ScrollControlViewPager
            android:id="@+id/doc_comment_viewpager"
            android:background="@color/bg_float"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/rl_title"
            app:layout_constraintBottom_toTopOf="@+id/doc_comment_sender"
            app:layout_constraintTop_toBottomOf="@+id/rl_title"/>
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/no_comment"
            android:visibility="gone"
            android:layout_below="@+id/rl_title"
            app:layout_constraintBottom_toTopOf="@+id/doc_comment_sender"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_title"
            app:ud_empty_desc="@string/Doc_Comment_Empty"
            app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_message_logging"
            style="@style/SpaceEmptyStatusStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/comment_create_whole_comment"
            android:background="@drawable/comment_create_whole_comment_button_background"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/LarkCCM_Comment_Image_AddComment_Button"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/doc_comment_sender"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ud_icon_add_comment_fab_button_icon"
            app:tint="@color/static_white"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/doc_comment_sender"
            android:background="@color/bg_body_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:id="@+id/line_1"
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/comment_sender_container"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/comment_sender_container"
                android:background="@drawable/facade_round_around_m"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:backgroundTint="@color/bg_body"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toTopOf="@+id/toolbar_guide_line">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/doc_comment_input_icon"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        app:srcCompat="@drawable/ud_icon_lock_filled"
                        app:tint="@color/icon_n3"/>
                    <com.bytedance.ee.bear.middleground.comment.widget.CommentEditText
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:textColorHint="@color/text_placeholder"
                        android:gravity="start"
                        android:id="@+id/et_sender"
                        android:background="@null"
                        android:paddingTop="12dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="12dp"
                        android:focusable="false"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="@dimen/space_kit_len_128"
                        android:scrollHorizontally="false"
                        android:lineSpacingExtra="2dp"
                        android:textCursorDrawable="@drawable/facade_edit_text_cursor"
                        app:layout_constraintBottom_toTopOf="@+id/toolbar_guide_line"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/checkbox_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/checkbox_wraper"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.larksuite.component.ui.button.LKUICheckBox2
                            android:layout_gravity="center_vertical"
                            android:id="@+id/checkbox"
                            android:paddingTop="1dp"
                            android:paddingRight="6dp"
                            android:layout_width="20dp"
                            android:layout_height="16dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_caption"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/checkbox_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/LarkCCM_Docs_Mention_GrantViewPermToPplMentioned_Radio"
                            android:maxLines="2"
                            android:layout_marginEnd="@dimen/space_kit_len_16"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/toolbar_guide_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/space_kit_len_52"/>
            <ImageView
                android:id="@+id/comment_at_btn"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ud_icon_at_outlined"
                android:scaleType="centerInside"
                android:tint="@color/space_selector_comment_icon"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_guide_line"/>
            <com.bytedance.ee.bear.middleground.comment.audio.MotionImageView
                android:id="@+id/commentVoice"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ud_icon_voice_outlined"
                android:scaleType="centerInside"
                android:tint="@color/space_selector_comment_icon"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/comment_at_btn"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_guide_line"
                app:layout_goneMarginStart="6dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/commentImage"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:tint="@color/space_selector_comment_icon"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/commentVoice"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_guide_line"
                app:layout_goneMarginStart="6dp"
                app:srcCompat="@drawable/ud_icon_image_outlined"/>
            <ImageView
                android:id="@+id/comment_send_btn"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ud_icon_send_colorful"
                android:tint="@color/space_selector_primary_b500_b300"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_guide_line"/>
            <include
                android:id="@+id/comment_voice_bar"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                layout="@layout/comment_voice_bar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
