<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_switch_account_layout"
    android:background="@drawable/cj_pay_switch_account_half_panel_background"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="376dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <Button
            android:id="@+id/cj_pay_switch_account_close"
            android:background="@drawable/cj_pay_close_icon_with_background"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="60dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="当前账号："/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/cj_pay_current_user_avatar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:id="@+id/cj_pay_current_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一只北极星"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="21sp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_switch_account_voucher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="28dp"
            android:text="切换一下账号付款\10本单立减5元"
            android:maxLines="2"
            android:lineSpacingExtra="4dp"
            android:textFontWeight="600"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@drawable/cj_pay_bg_switch_account_container"
            android:layout_width="match_parent"
            android:layout_height="100dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/cj_pay_switch_account_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_toRightOf="@+id/cj_pay_switch_account_avatar"
                android:layout_alignTop="@+id/cj_pay_switch_account_avatar">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_switch_account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="张三"
                    android:singleLine="true"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:id="@+id/cj_pay_switch_account_phone_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"
                    android:text="手机号 186****2596"
                    android:layout_toRightOf="@+id/cj_pay_switch_account_avatar"
                    android:layout_below="@+id/cj_pay_switch_account_name"
                    android:layout_alignBottom="@+id/cj_pay_switch_account_avatar"
                    android:textFontWeight="400"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/cj_pay_switch_account_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginBottom="16dp"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
    </LinearLayout>
</LinearLayout>
