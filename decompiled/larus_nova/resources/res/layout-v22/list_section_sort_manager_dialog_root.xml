<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/task_list_share_dialog_bg_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <ImageView
                android:id="@+id/close_icon"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:tint="@color/icon_n1"
                android:layout_marginStart="@dimen/dp_16"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
            <TextView
                android:textSize="@dimen/sp_17"
                android:textColor="@color/text_title"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_SectionSorting_Title"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_link_normal"
                android:id="@+id/save_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_SectionSortingSave_Button"
                android:layout_marginEnd="@dimen/dp_16"/>
        </LinearLayout>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
            android:id="@+id/todo_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            app:rl_radius_left_bottom="@dimen/dp_10"
            app:rl_radius_left_top="@dimen/dp_10"
            app:rl_radius_right_bottom="@dimen/dp_10"
            app:rl_radius_right_top="@dimen/dp_10">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
    </LinearLayout>
</LinearLayout>
