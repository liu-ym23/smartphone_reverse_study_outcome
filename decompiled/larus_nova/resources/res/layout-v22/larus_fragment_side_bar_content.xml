<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_side_bar_content"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_top_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/layout_middle_range"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_legacy_top_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:layout_marginHorizontal="?attr/larus_dp_12"
            android:layout_marginVertical="?attr/larus_dp_12">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_search"
                android:background="@drawable/larus_bg_side_bar_search"
                android:paddingTop="?attr/larus_dp_8"
                android:paddingBottom="?attr/larus_dp_8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16">
                <ImageView
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:src="@drawable/larus_icon_search"/>
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/search_edit"
                    android:paddingLeft="?attr/larus_dp_12"
                    android:paddingRight="?attr/larus_dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="?attr/larus_dp_12"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/side_bar_create_conversation"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:contentDescription="@string/larus_accessibility_icon_createNewChat"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_merged_top_range"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:paddingStart="?attr/larus_dp_28"
            android:paddingEnd="?attr/larus_dp_22">
            <TextView
                android:textSize="?attr/larus_dp_20"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/side_bar_merged_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="?attr/larus_dp_20"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/side_bar_merged_work_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_4"
                android:textFontWeight="600"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/side_bar_merged_search"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_icon_search"
                android:contentDescription="@string/larus_accessibility_icon_search"
                android:layout_marginStart="?attr/larus_dp_16"
                app:tint="?attr/larus_neutral_100"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/view_bottom_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom_range"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_middle_range"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/profile_container"
            android:paddingTop="?attr/larus_dp_15"
            android:paddingBottom="?attr/larus_dp_18"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingStart="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.bmhome.view.RoundAvatarImageView
                android:id="@+id/iv_avatar"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/username_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_8">
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_100"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_26"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toTopOf="@+id/tv_tenant_name"
                    app:layout_constraintEnd_toStartOf="@+id/username_chevron"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <ImageView
                    android:id="@+id/username_chevron"
                    android:layout_width="?attr/larus_dp_12"
                    android:layout_height="?attr/larus_dp_12"
                    android:src="@drawable/larus_ic_text_right_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_username"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_username"
                    app:layout_constraintTop_toTopOf="@+id/tv_username"/>
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/larus_neutral_50"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_tenant_name"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_20"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/tv_username"
                    app:layout_constraintTop_toBottomOf="@+id/tv_username"
                    app:layout_constraintWidth_default="wrap"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/action_container"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_0"
            android:paddingEnd="?attr/larus_dp_10"
            android:layout_marginStart="?attr/larus_dp_2"
            android:paddingVertical="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profile_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/layout_middle_range"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom_divider"
        app:layout_constraintTop_toBottomOf="@+id/layout_top_range"/>
    <com.larus.home.impl.main.side_bar.view.SideBarFloatingButtonView
        android:id="@+id/layout_back_doubao"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_2"
        android:stateListAnimator="@animator/button_press_animator"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom_range"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
