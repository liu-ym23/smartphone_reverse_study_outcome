<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_ktv_rt_chorus_ll_bg"
    android:paddingLeft="3dp"
    android:paddingTop="1dp"
    android:paddingRight="3dp"
    android:paddingBottom="1dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/rt_chorus_live_iv"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:placeholderImageScaleType="fitXY"/>
    <FrameLayout
        android:id="@+id/rt_chorus_avatar_fl"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="right"
            android:id="@+id/rt_chorus_avatar1_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="0dp"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:placeholderImageScaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/rt_chorus_avatar2_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="8dp"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:placeholderImageScaleType="fitXY"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="#99161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rt_chorus_join_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="加入xxxxxxx人合唱"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineHeight="14dp"
        android:textFontWeight="500"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/rt_chorus_arrow_iv"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:placeholderImage="@drawable/ttlive_ktv_rt_chorus_arrow_icon"
        app:placeholderImageScaleType="fitXY"/>
</LinearLayout>
