<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_44"
    android:minHeight="44sp">
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_05"/>
    <com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView
        android:id="@+id/filter_item_container"
        android:paddingLeft="16sp"
        android:paddingRight="16sp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingHorizontal="16sp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/todo_container_item_text_color"
                android:gravity="center"
                android:id="@+id/text_filter_all"
                android:background="@drawable/todo_tasklist_filter_bg"
                android:paddingLeft="@dimen/dp_8"
                android:paddingRight="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Todo_TaskListPage_All_Tab"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/todo_container_item_text_color"
                android:gravity="center"
                android:id="@+id/text_filter_create"
                android:background="@drawable/todo_tasklist_filter_bg"
                android:paddingLeft="@dimen/dp_8"
                android:paddingRight="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Todo_TaskListPage_Created_Tab"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/todo_container_item_text_color"
                android:gravity="center"
                android:id="@+id/text_filter_collaborate"
                android:background="@drawable/todo_tasklist_filter_bg"
                android:paddingLeft="@dimen/dp_8"
                android:paddingRight="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Todo_TaskListPage_Collaborated_Tab"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/todo_container_item_text_color"
                android:gravity="center"
                android:id="@+id/text_filter_docs"
                android:background="@drawable/todo_tasklist_filter_bg"
                android:paddingLeft="@dimen/dp_8"
                android:paddingRight="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Todo_TaskListPage_FromDocs_Tab"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/todo_container_item_text_color"
                android:gravity="center"
                android:id="@+id/text_filter_chat"
                android:background="@drawable/todo_tasklist_filter_bg"
                android:paddingLeft="@dimen/dp_8"
                android:paddingRight="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_4"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Todo_TaskListPage_FromChat_Tab"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_8"/>
        </LinearLayout>
    </com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView>
    <View
        android:id="@+id/filter_shader"
        android:background="@drawable/todo_keyboard_shader"
        android:visibility="gone"
        android:layout_width="40sp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
