<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/time_tips"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/current_text_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/current_text_sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/current_text_min"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/current_text_sec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/current_text_sp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/mid_sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/"
            android:layout_marginStart="?attr/larus_dp_8"
            android:textFontWeight="300"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/current_text_sec"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/total_text_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_8"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mid_sp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/total_text_sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/total_text_min"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/total_text_sec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="700"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/total_text_sp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.doc.impl.video.widget.HorizontalProgressLayer
        android:id="@+id/progress_layer"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/seek_bar"
        app:layout_constraintEnd_toEndOf="@+id/seek_bar"
        app:layout_constraintStart_toStartOf="@+id/seek_bar"
        app:layout_constraintTop_toTopOf="@+id/seek_bar">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start"
            android:id="@+id/loading_bar_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/larus_animation_video_progress_bar_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start"
            android:id="@+id/loading_bar_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/larus_animation_video_progress_bar_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start"
            android:id="@+id/loading_bar_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/larus_animation_video_progress_bar_3"/>
    </com.larus.doc.impl.video.widget.HorizontalProgressLayer>
    <View
        android:id="@+id/divider"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_tips"/>
    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_4"
        android:thumbOffset="?attr/larus_dp_0"
        android:paddingStart="?attr/larus_dp_0"
        android:paddingEnd="?attr/larus_dp_0"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
