<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/promotion_list_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/iv_top_close_btn"
        app:layout_constraintEnd_toStartOf="@+id/iv_top_close_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_top_close_btn"
        app:layout_goneMarginBottom="8dp"/>
    <ImageView
        android:id="@+id/iv_top_close_btn"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="13dp"
        android:src="@drawable/ec_icon_promotion_list_top_close"
        android:contentDescription="@string/ec_close_button"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/promotion_list_root_layout"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ViewStub
        android:id="@+id/promotion_list_user_choose_store_layout"
        android:layout="@layout/ec_list_top_user_choose_store_layout"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/promotion_list_root_layout"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout
        android:id="@+id/promotion_list_root_layout"
        android:background="@drawable/ec_bg_iron_promotion_list"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/ec_promotion_list"
        android:importantForAccessibility="yes"
        app:ec_leftTopRadius="20dp"
        app:ec_rightTopRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.bytedance.android.livesdk.livecommerce.iron.ui.IronPromotionListBackgroundView
            android:id="@+id/iv_promotion_background"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="-22dp"/>
        <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout
            android:id="@+id/list_content_layout"
            android:background="@drawable/ec_bg_iron_promotion_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/iv_promotion_background"
            app:ec_leftTopRadius="20dp"
            app:ec_rightTopRadius="20dp">
            <com.bytedance.android.livesdk.livecommerce.iron.ui.top.ECPromotionListHeaderLayout
                android:id="@+id/list_header_opt"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/fl_open_below_area"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/list_header_opt"/>
            <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout
                android:id="@+id/list_below_header_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/list_header_opt">
                <Space
                    android:id="@+id/list_left_exclusive_region"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"/>
                <FrameLayout
                    android:id="@+id/fl_open_tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/list_left_exclusive_region"/>
                <FrameLayout
                    android:id="@+id/fl_tab_module_replaceable_container"
                    android:background="@drawable/ec_bg_iron_promotion_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/list_left_exclusive_region"
                    android:layout_below="@+id/fl_open_tab">
                    <View
                        android:id="@+id/view_category_list_place_holder"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"/>
                    <com.bytedance.android.livesdk.livecommerce.iron.category.CategoryRecyclerView
                        android:id="@+id/category_list"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"/>
                    <com.bytedance.android.livesdk.livecommerce.iron.ui.tab.CategoryExpandView
                        android:layout_gravity="top|right"
                        android:id="@+id/category_expand"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/fl_hint_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/list_left_exclusive_region"
                    android:layout_below="@+id/fl_tab_module_replaceable_container">
                    <com.bytedance.android.livesdk.livecommerce.iron.ui.ECPromotionListHintBannerView
                        android:id="@+id/hbv_hint_bar"
                        android:background="@color/white"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"/>
                </FrameLayout>
                <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout
                    android:id="@+id/fl_promotion_list_replaceable_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/fl_hint_bar_container">
                    <RelativeLayout
                        android:id="@+id/fl_promotion_list_replaceable_area"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <Space
                            android:id="@+id/list_inner_left_exclusive_region"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentLeft="true"/>
                        <androidx.coordinatorlayout.widget.CoordinatorLayout
                            android:id="@+id/cl_promotion_area"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toRightOf="@+id/list_inner_left_exclusive_region">
                            <com.bytedance.android.livesdk.livecommerce.iron.widgets.PromotionRecyclerView
                                android:id="@+id/rv_promotion_list"
                                android:background="@color/white"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </androidx.coordinatorlayout.widget.CoordinatorLayout>
                        <com.bytedance.android.livesdk.livecommerce.view.ECLoadingStateView
                            android:gravity="center"
                            android:id="@+id/eclv_loading"
                            android:background="@drawable/ec_shape_promotion_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <com.bytedance.android.livesdk.livecommerce.view.ECHostLiveNoPromotionLayoutImpl
                            android:id="@+id/npl_no_promotion"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toRightOf="@+id/list_inner_left_exclusive_region"/>
                    </RelativeLayout>
                </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout>
                <RelativeLayout
                    android:id="@+id/rl_toast_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:layout_below="@+id/iv_promotion_background"
                    android:layout_centerHorizontal="true">
                    <com.bytedance.android.livesdk.livecommerce.iron.widgets.IronPromotionListToast
                        android:id="@+id/iplt_toast"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/m3_distinguish_mark"
                    android:background="@color/ec_color_m3_distinguish_mark"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="1dp"
                    android:layout_height="3dp"
                    android:layout_marginLeft="7dp"
                    android:layout_marginBottom="76dp"
                    android:layout_toRightOf="@+id/list_left_exclusive_region"
                    android:layout_alignParentBottom="true"/>
            </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout>
        </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout>
    </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout>
    <FrameLayout
        android:id="@+id/fl_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
