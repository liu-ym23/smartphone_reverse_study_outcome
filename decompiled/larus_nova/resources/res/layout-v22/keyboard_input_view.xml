<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/input_bg"
        android:background="@drawable/bg_input"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/content_editor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/attachment"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/input_bg"
        app:layout_constraintStart_toStartOf="@+id/input_bg"
        app:layout_constraintTop_toTopOf="@+id/input_bg"/>
    <com.ss.android.lark.keyboard.edittext.FlowKeyboardFunctionEditText
        android:scrollbarStyle="outsideOverlay"
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="start"
        android:id="@+id/content_editor"
        android:background="@null"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="90dp"
        android:maxLines="4"
        android:lineSpacingExtra="3sp"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/text_cursor_drawable_ig"
        android:paddingVertical="13dp"
        android:useLocalePreferredLineHeightForMinimum="false"
        app:layout_constraintEnd_toEndOf="@+id/input_bg"
        app:layout_constraintHeight_min="50dp"
        app:layout_constraintStart_toStartOf="@+id/input_bg"
        app:layout_constraintTop_toBottomOf="@+id/attachment"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="bottom"
        android:id="@+id/picture_btn"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:scaleType="fitXY"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintStart_toStartOf="@+id/input_bg"
        app:srcCompat="@drawable/ud_icon_camera_outlined"
        app:tint="@color/icon_n1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/action_speak"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="28dp"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_action_menu_entrance"
        app:srcCompat="@drawable/ic_mic_btn"
        app:tint="@color/speak_tint_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_action_menu_entrance"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintEnd_toEndOf="@+id/after_add_divider_line"
        app:srcCompat="@drawable/ic_plus_menu_btn"
        app:tint="@color/plus_tint_color"/>
    <View
        android:id="@+id/after_add_divider_line"
        android:background="@drawable/bg_keyboard_btn_divider"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintEnd_toEndOf="@+id/input_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/send_btn"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintEnd_toEndOf="@+id/input_bg"
        app:srcCompat="@drawable/ud_icon_send_filled"
        app:tint="@color/send_tint_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stop_btn"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_bg"
        app:layout_constraintEnd_toEndOf="@+id/input_bg"
        app:srcCompat="@drawable/ud_icon_stop_round_filled"
        app:tint="@color/icon_n1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
