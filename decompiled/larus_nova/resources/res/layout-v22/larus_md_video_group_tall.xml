<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/md_video_group_tall"
    android:background="@android:color/transparent"
    android:layout_width="190dp"
    android:layout_height="286dp">
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/videoTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_23"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:maxLines="1"/>
    <FrameLayout
        android:background="@drawable/larus_md_video_group_tall_bg"
        android:layout_width="190dp"
        android:layout_height="286dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/md_video_group_cover"
            android:layout_width="190dp"
            android:layout_height="286dp"
            android:transitionName="share_video"
            app:roundedCornerRadius="8dp"/>
        <com.larus.bmhome.chat.markdown.imagegroup.view.MarkdownSourceImageView
            android:layout_gravity="start|top"
            android:id="@+id/sourceIcon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_margin="?attr/larus_dp_10"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="start|top"
            android:id="@+id/md_video_group_source_label"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:scaleType="fitCenter"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="10dp"
            android:src="@drawable/larus_md_video_group_play_ic"/>
        <ImageView
            android:layout_gravity="bottom"
            android:background="@drawable/larus_bg_md_video_bottom"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:layout_gravity="start|bottom"
            android:id="@+id/tvMdBottomCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_10"
            android:layout_marginRight="?attr/larus_dp_10"
            android:layout_marginBottom="10dp"
            android:lines="1"
            android:layout_marginHorizontal="?attr/larus_dp_10"/>
    </FrameLayout>
</LinearLayout>
