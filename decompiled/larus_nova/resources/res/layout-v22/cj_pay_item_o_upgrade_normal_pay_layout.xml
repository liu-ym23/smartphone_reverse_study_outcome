<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/cj_pay_item_normal_pay_root_layout"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="14dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/cj_pay_payment_method_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginLeft="46dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:id="@+id/cj_pay_payment_method_voucher_label_right"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:id="@+id/cj_pay_payment_method_combine_amount_label"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:ellipsize="end"
            android:id="@+id/cj_pay_payment_method_sub_title"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_title"/>
        <HorizontalScrollView
            android:id="@+id/cj_pay_sub_asset_scroll_layout"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="46dp"
            android:layout_marginTop="@dimen/cj_pay_padding_6"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_sub_title">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/credit_pay_voucher_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
            android:ellipsize="end"
            android:id="@+id/cj_pay_asset_desc_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_6"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_sub_asset_scroll_layout"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:id="@+id/cj_pay_payment_method_sub_label_first"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_asset_desc_text"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:id="@+id/cj_pay_payment_method_sub_label_second"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_sub_label_first"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_asset_desc_text"/>
        <FrameLayout
            android:id="@+id/cj_pay_payment_select_customer_Layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
