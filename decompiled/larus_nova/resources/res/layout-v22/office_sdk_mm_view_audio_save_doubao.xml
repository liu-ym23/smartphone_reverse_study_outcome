<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/office_sdk_mm_half_screen_dialog_padding_bottom_doubao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.titlebar.MmTitleBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tbv_title_text="@string/MMweb_AITranscribe_AudioSettings_Title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/audioSaveSettingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/audioSaveLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/audioSaveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/MMweb_AITranscribe_KeepAudio_Checkbox"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/audioSaveCheckView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/audioSaveCheckView"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/primary_fill_default"/>
            <View
                android:id="@+id/audioSaveBottomDivider"
                android:background="@color/line_divider_default"
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/audioNotSaveLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/audioNotSaveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/MMweb_AITranscribe_TranscriptOnly_Dropdown"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/audioNotSaveCheckView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/audioNotSaveCheckView"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/primary_fill_default"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
