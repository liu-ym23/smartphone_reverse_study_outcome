<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shopping_layout_match_purchase_button_v2_1263187714"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="#ff6f00"
        android:ellipsize="end"
        android:id="@+id/tv_button_tip"
        android:background="#fff2e0"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingVertical="6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="63.5dp">
        <com.bytedance.android.shopping.anchorv3.matchpurchase.view.MPV2SelectAllLayout
            android:gravity="center_vertical"
            android:id="@+id/ly_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/cb_select_all_or_none"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:checked="true"
                android:layout_marginStart="14dp"
                style="@style/show_talent_comment_checkbox_style"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_match_purchase_select_hint"
                android:layout_marginStart="4dp"/>
        </com.bytedance.android.shopping.anchorv3.matchpurchase.view.MPV2SelectAllLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ly_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff161823"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_match_purchase_price_prefix"
                android:layout_marginEnd="4dp"/>
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="22sp"
                android:id="@+id/pv_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                app:pv_prefixMarginRight="6dp"
                app:pv_prefixTextSizeRatio="0.54"
                app:pv_priceTextColor="@color/commerce_color_FE2C55"
                app:pv_suffixTextMarginLeft="0dp"
                app:pv_suffixTextSizeRatio="1"
                app:pv_yuanSymbolRatioOfPriceTextSize="0.75"/>
        </LinearLayout>
        <com.bytedance.android.shopping.widget.buybutton.ShoppingPurchaseButton
            android:id="@+id/match_purchase_button"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
