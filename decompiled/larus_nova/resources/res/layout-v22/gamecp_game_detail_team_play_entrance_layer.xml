<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gamecp_detail_interactive_layer_container"
        android:background="@drawable/gamecp_detail_interactive_layer_bg"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="18dp"
        android:layout_marginHorizontal="18dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">
        <com.bytedance.android.gamecp.common.ui.CornerHoleHSImageView
            android:id="@+id/gamecp_detail_interactive_layer_main_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:align="bottom"
            app:holeCenterXOffset="-3dp"
            app:holeCenterYOffset="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/gamecp_detail_interactive_icon_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="19dp"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/gamecp_detail_interactive_layer_sub_icon"
            android:background="@drawable/gamecp_detail_interactive_game_icon_bg"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_interactive_layer_main_icon"
            app:layout_constraintStart_toStartOf="@+id/gamecp_detail_interactive_icon_guideline"
            app:roundAsCircle="true"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/gamecp_detail_interactive_icon_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/gamecp_detail_interactive_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_interactive_end_barrier"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/gamecp_detail_interactive_icon_barrier"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#80161823"
            android:id="@+id/gamecp_detail_interactive_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/gamecp_detail_interactive_button"
            android:background="@drawable/gamecp_detail_interactive_button_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="64dp"
            android:textAlignment="center"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="64dp"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/gamecp_detail_interactive_end_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
