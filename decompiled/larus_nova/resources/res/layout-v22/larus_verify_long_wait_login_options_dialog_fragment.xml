<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bgView"
        android:background="@color/larus_static_black_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.larus.login.impl.view.DragCloseLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:background="@drawable/larus_bg_long_wait_dialog"
        android:paddingBottom="?attr/larus_dp_24"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_login_phoneOtherMethods_title"
                android:layout_marginStart="?attr/larus_dp_20"
                android:layout_marginEnd="?attr/larus_dp_20"
                app:layout_constraintEnd_toStartOf="@+id/close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_neutral_70"
                android:id="@+id/subTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_6"
                android:text="@string/larus_login_phoneOtherMethods_subtitle"
                app:layout_constraintEnd_toEndOf="@+id/title"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <ImageView
                android:id="@+id/close"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_12"
                android:src="@drawable/larus_ic_tourist_close"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_20"
            android:overScrollMode="never"
            android:layout_marginHorizontal="?attr/larus_dp_20"/>
    </com.larus.login.impl.view.DragCloseLinearLayout>
</FrameLayout>
