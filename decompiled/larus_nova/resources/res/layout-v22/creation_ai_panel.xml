<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/creation_mask_full_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/creation_ai_keyboard_bg"
        android:background="@color/bg_float"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_250"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.ss.android.lark.inline.ai.creationai.NSPConstraintLayout
        android:id="@+id/creation_panel_view"
        android:layout_width="match_parent"
        android:layout_height="714dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:layout_marginHorizontal="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.larksuite.component.universe_design.shadow.UDShadowLayout
            android:id="@+id/creation_ai_shadow_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/UDShadow.S5.Up">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/creation_ai_section_background_2r"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="0dp"
                android:layout_marginHorizontal="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <FrameLayout
                    android:id="@+id/creation_drag_view_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/creation_header_container"
                    app:layout_constraintTop_toTopOf="parent">
                    <View
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/creation_drag_view"
                        android:background="@drawable/inline_ai_drag_bar_background"
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"/>
                </FrameLayout>
                <RelativeLayout
                    android:id="@+id/creation_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:layout_constraintBottom_toTopOf="@+id/creation_content_container"
                    app:layout_constraintTop_toBottomOf="@+id/creation_drag_view_wrapper">
                    <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsRecyclerView
                        android:id="@+id/creation_header_left_rv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="18dp"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/space_kit_font_17"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/creation_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_centerInParent="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/space_kit_len_12"
                        android:paddingEnd="@dimen/space_kit_len_12"/>
                    <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsRecyclerView
                        android:id="@+id/creation_header_right_rv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="18dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <FrameLayout
                    android:id="@+id/creation_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/creation_operates_ll"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/creation_header_container"
                    app:layout_goneMarginBottom="8dp"/>
                <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsLinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/creation_operates_ll"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/creation_recommend_label_rv"
                    app:layout_constraintTop_toBottomOf="@+id/creation_content_container"/>
                <com.ss.android.lark.inline.ai.creationai.label.LabelRecyclerView
                    android:id="@+id/creation_recommend_label_rv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/creation_recommend_content_rv"
                    app:layout_constraintTop_toBottomOf="@+id/creation_operates_ll"/>
                <com.ss.android.lark.inline.ai.creationai.recommend.RecommendRecyclerView
                    android:id="@+id/creation_recommend_content_rv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/creation_footer_rv"
                    app:layout_constraintTop_toBottomOf="@+id/creation_recommend_label_rv"/>
                <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsRecyclerView
                    android:id="@+id/creation_footer_rv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/creation_input_group"
                    app:layout_constraintTop_toBottomOf="@+id/creation_recommend_content_rv"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/creation_input_group"
                    android:background="@drawable/inline_ai_input_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/creation_footer_rv">
                    <com.ss.android.lark.inline.ai.creationai.CreationAIEditText
                        android:scrollbarStyle="outsideOverlay"
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:textColorHint="@color/text_placeholder"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/creation_input_text"
                        android:background="@color/bg_float_overlay"
                        android:paddingTop="@dimen/inline_ai_creation_keyboard_input_vertical_padding"
                        android:paddingBottom="@dimen/inline_ai_creation_keyboard_input_vertical_padding"
                        android:focusable="true"
                        android:scrollbars="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="90dp"
                        android:minHeight="50dp"
                        android:maxLines="4"
                        android:lineSpacingExtra="3sp"
                        android:inputType="textMultiLine"
                        android:imeOptions="flagNoExtractUi"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="@dimen/inline_ai_creation_keyboard_input_vertical_padding"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/creation_input_right_icon_wrapper"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginEnd="13dp"
                        style="@style/UDEditText"/>
                    <FrameLayout
                        android:id="@+id/creation_input_right_icon_wrapper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/creation_input_stop_icon"
                            android:padding="6dp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/ud_icon_stop_round_filled"
                            app:tint="@color/icon_n1"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/creation_input_send_icon"
                            android:padding="6dp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/ud_icon_send_filled"
                            app:tint="@color/inline_ai_creation_keyboard_send"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    </com.ss.android.lark.inline.ai.creationai.NSPConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
