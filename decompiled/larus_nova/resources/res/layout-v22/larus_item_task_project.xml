<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_skill_item_middle"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_project_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:contentDescription="@null"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_side_bar_project"
            app:tint="?attr/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/item_project_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_12"
            android:textFontWeight="500"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_pc_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/item_project_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_pc_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:contentDescription="@null"
            android:layout_marginStart="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_selected_icon"
            app:layout_constraintStart_toEndOf="@+id/item_project_name"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_localpc"
            app:tint="?attr/larus_neutral_50"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_selected_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:contentDescription="@null"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_check_mark_black"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/item_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginStart="?attr/larus_dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
