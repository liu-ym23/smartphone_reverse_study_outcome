<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/coachmark_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/coachmark_main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <FrameLayout
            android:id="@+id/coachmark_hero_container"
            android:paddingTop="8dp"
            android:paddingBottom="0dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <com.obric.oui.layout.OUIFrameLayout
                android:id="@+id/coachmark_hero_frame"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                app:oui_radius="20dp">
                <ImageView
                    android:id="@+id/coachmark_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"/>
            </com.obric.oui.layout.OUIFrameLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/coachmark_content_container"
            android:padding="@dimen/oui_p_container_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/coachmark_content_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/coachmark_icon_container"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:oui_layout_borderColor="@color/oui_line_1"
                    app:oui_layout_borderWidth="0.6dp"
                    app:oui_radius="10dp">
                    <ImageView
                        android:id="@+id/coachmark_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"/>
                </com.obric.oui.layout.OUIFrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/coachmark_text_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.obric.oui.text.OTextView
                        android:textColor="@color/oui_basic_text_1"
                        android:id="@+id/tv_coachmark_title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        style="@style/Title_1_Medium"/>
                    <com.obric.oui.text.OTextView
                        android:textColor="@color/oui_basic_text_1"
                        android:ellipsize="end"
                        android:id="@+id/tv_coachmark_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.5"
                        style="@style/Body_1_Regular"/>
                </LinearLayout>
                <com.obric.oui.button.OIconButton
                    android:id="@+id/btn_coachmark_close"
                    android:padding="7dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/coachmark_icon_oic_xmark"
                    android:tint="@color/oui_fill_icon_as_action"
                    android:contentDescription="@string/oui_iv_close_desc"
                    android:layout_marginHorizontal="8dp"
                    style="@style/OIconButton.M1.Trans.Understated"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/coachmark_action_text_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.obric.oui.button.OButton
                    android:id="@+id/btn_coachmark_action_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/oui_h_m1"
                    android:minHeight="0dp"
                    style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/btn_coachmark_action_text_primary"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/oui_h_m1"
                    android:minHeight="0dp"
                    android:layout_marginStart="@dimen/oui_gh_button_l1"
                    style="@style/OStyleV2.OButton.S.Trans.Primary"/>
            </LinearLayout>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_coachmark_action_filled"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/oui_h_l1"
                android:layout_marginTop="@dimen/oui_gh_button_l1"
                android:minHeight="0dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
