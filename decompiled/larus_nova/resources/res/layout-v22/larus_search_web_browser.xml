<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_bar"
            android:background="@color/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_web_back"
                android:contentDescription="@string/larus_accessibility_icon_back"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/larus_neutral_100"/>
            <ImageView
                android:id="@+id/btn_close_all"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_web_close"
                android:contentDescription="@string/larus_accessibility_icon_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_back"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/larus_neutral_100"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_52"
                android:layout_marginEnd="?attr/larus_dp_52"
                android:textFontWeight="600"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/btn_share"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_top_share"
                android:scaleType="centerInside"
                android:contentDescription="@string/larus_accessibility_icon_share"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_more"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_8"/>
            <ImageView
                android:id="@+id/btn_more"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_45"
                android:layout_height="?attr/larus_dp_45"
                android:src="@drawable/larus_ic_web_title_more"
                android:scaleType="centerInside"
                android:contentDescription="@string/larus_accessibility_icon_more"
                android:layout_marginEnd="?attr/larus_dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider"
                android:background="@drawable/larus_bg_divider"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/web_view_parent"
                android:background="@color/larus_base_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:id="@+id/progress_bar"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_2"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/larus_progress_horiztal"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/bottom_action_bar"
            android:background="@color/larus_base_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_49">
            <ImageView
                android:id="@+id/btn_bottom_go_back"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/larus_ic_web_bottom_backup_unclickable"
                android:scaleType="center"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/btn_bottom_go_forward"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/larus_ic_web_bottom_forward_unclickable"
                android:scaleType="center"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/error_container"
        android:background="@color/larus_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/error_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_auth_screen_error_desc"
            app:layout_constraintBottom_toTopOf="@+id/error_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/error_close"
            android:background="@drawable/larus_bg_base_3_overlay_r12_press"
            android:paddingLeft="?attr/larus_dp_36"
            android:paddingTop="?attr/larus_dp_11"
            android:paddingRight="?attr/larus_dp_36"
            android:paddingBottom="?attr/larus_dp_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_auth_screen_error_btn_close"
            android:paddingHorizontal="?attr/larus_dp_36"
            android:paddingVertical="?attr/larus_dp_11"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/error_refresh"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_desc"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_static_white"
            android:id="@+id/error_refresh"
            android:background="@drawable/larus_bg_primary_50_r12_press"
            android:paddingLeft="?attr/larus_dp_36"
            android:paddingTop="?attr/larus_dp_11"
            android:paddingRight="?attr/larus_dp_36"
            android:paddingBottom="?attr/larus_dp_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_auth_screen_error_btn_refresh"
            android:layout_marginStart="?attr/larus_dp_12"
            android:paddingHorizontal="?attr/larus_dp_36"
            android:paddingVertical="?attr/larus_dp_11"
            app:layout_constraintBottom_toBottomOf="@+id/error_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/error_close"
            app:layout_constraintTop_toTopOf="@+id/error_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/center_progress"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        android:indeterminateTint="@color/larus_neutral_50"/>
</FrameLayout>
