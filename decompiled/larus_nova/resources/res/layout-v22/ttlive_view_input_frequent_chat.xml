<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ttlive_color_f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/frequent_chat_header_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ttlive_color_f8f8f8"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/frequent_chat_header"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_color_BF_161823"
                android:gravity="center"
                android:id="@+id/frequent_chat_num"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_color_161823"
                android:gravity="center"
                android:id="@+id/frequent_chat_list_edit_btn"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="@string/frequent_chat_edit"
                android:layout_marginEnd="16dp"
                android:lineHeight="18.2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_frequent_chat_key_btn_color"
                android:gravity="center"
                android:id="@+id/edit_or_sort_finish_btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="@string/frequent_chat_finish"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_color_161823"
                android:gravity="center"
                android:id="@+id/frequent_chat_list_sort_btn"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="@string/frequent_chat_sort"
                android:layout_marginEnd="16dp"
                android:lineHeight="18.2dp"
                android:textFontWeight="400"
                app:layout_constraintEnd_toStartOf="@+id/frequent_chat_list_edit_btn"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/frequent_chat_intro"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#57161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/describe_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginStart="33dp"
            android:layout_marginEnd="34dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/frequent_chat_list"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:textSize="13dp"
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/frequent_chat_api_error_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/frequent_chat_api_error_hint_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_color_99_161823"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:text="@string/frequent_chat_api_error_hint_text"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:id="@+id/frequent_chat_refresh_btn"
            android:background="@drawable/ttlive_bg_frequent_chat_fresh_btn"
            android:layout_width="165dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/frequent_chat_refresh"/>
    </LinearLayout>
</LinearLayout>
