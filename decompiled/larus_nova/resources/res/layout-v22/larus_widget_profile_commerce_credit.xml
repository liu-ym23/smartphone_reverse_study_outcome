<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/layout_profile_commerce_credit"
    android:background="@drawable/larus_bg_profile_commerce_credit"
    android:paddingLeft="@dimen/dp_8"
    android:paddingTop="@dimen/dp_4"
    android:paddingRight="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_4"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_28"
    android:paddingHorizontal="@dimen/dp_8"
    android:paddingVertical="@dimen/dp_4">
    <TextView
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/tv_profile_commerce_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="860"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_profile_commerce_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_10"
        android:minHeight="@dimen/dp_14"
        android:layout_marginStart="@dimen/dp_3"
        app:placeholderImage="@drawable/larus_ic_lightening"
        app:placeholderImageScaleType="fitCenter"/>
</LinearLayout>
