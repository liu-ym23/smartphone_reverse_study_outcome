<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_action_bar_item_height"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12"
    app:rv_backgroundColor="@android:color/transparent"
    app:rv_backgroundPressColor="?attr/larus_press"
    app:rv_cornerRadius="?attr/larus_dp_8"
    app:rv_strokeColor="?attr/larus_neutral_transparent_2"
    app:rv_strokePressColor="?attr/larus_press"
    app:rv_strokeWidth="?attr/larus_dp_1">
    <FrameLayout
        android:id="@+id/fl_item_icons"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_item_img"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/larus_ic_connector_fallback"
            app:failureImageScaleType="centerCrop"
            app:placeholderImage="@drawable/larus_ic_connector_fallback"
            app:placeholderImageScaleType="centerCrop"/>
        <FrameLayout
            android:id="@+id/fl_connector_icons"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_18"
            android:alpha="0">
            <FrameLayout
                android:id="@+id/fl_item_icon_first"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/ic_connector_img_first"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="@drawable/larus_ic_connector_fallback"
                    app:failureImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_ic_connector_fallback"
                    app:placeholderImageScaleType="centerCrop"/>
                <View
                    android:id="@+id/v_item_icon_outer_border_first"
                    android:background="@drawable/larus_bg_connector_icon_outer_border"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/v_item_icon_border_first"
                    android:background="@drawable/larus_bg_connector_action_bar_icon_border"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_item_icon_second"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:layout_marginStart="?attr/larus_dp_10">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/ic_item_img_second"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="@drawable/larus_ic_connector_fallback"
                    app:failureImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_ic_connector_fallback"
                    app:placeholderImageScaleType="centerCrop"/>
                <View
                    android:id="@+id/v_item_icon_outer_border_second"
                    android:background="@drawable/larus_bg_connector_icon_outer_border"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/v_item_icon_border_second"
                    android:background="@drawable/larus_bg_connector_action_bar_icon_border"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_item_icon_third"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:layout_marginStart="?attr/larus_dp_20">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/ic_item_img_third"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="@drawable/larus_ic_connector_fallback"
                    app:failureImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_ic_connector_fallback"
                    app:placeholderImageScaleType="centerCrop"/>
                <View
                    android:id="@+id/v_item_icon_outer_border_third"
                    android:background="@drawable/larus_bg_connector_icon_outer_border"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/v_item_icon_border_third"
                    android:background="@drawable/larus_bg_connector_action_bar_icon_border"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_4"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_item_dot"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fl_item_icons"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_item_dot"
        android:background="@drawable/larus_shape_online_dot"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_6"
        android:layout_height="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_item_arrow"
        app:layout_constraintStart_toEndOf="@+id/tv_item_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_item_arrow"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_4"
        android:layout_height="?attr/larus_dp_11"
        android:src="@drawable/larus_ic_action_bar_menu_arrow"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_item_dot"
        app:layout_constraintTop_toTopOf="parent"/>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
