<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/ud_dialog_padding_left_right"
    android:paddingEnd="@dimen/ud_dialog_padding_left_right">
    <TextView
        android:textAppearance="@style/UDText.Body0"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/ud_dialog_content_message_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineHeight="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ud_dialog_content_hint_container"
        android:background="@drawable/ud_security_notice_bg_dialog"
        android:padding="@dimen/dp_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_content_message_tv">
        <TextView
            android:textAppearance="@style/UDText.Headline"
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:id="@+id/ud_dialog_content_hint_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:lineHeight="22dp"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/text_caption"
            android:id="@+id/ud_dialog_content_hint_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineHeight="22dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/custom_dialog_content_container"
        android:background="@drawable/ud_security_notice_bg_dialog"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_content_message_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
