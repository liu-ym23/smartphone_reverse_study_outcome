<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cj_pay_bg_r8_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/pay_x_rec_top_core_root_view"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">
            <ImageView
                android:id="@+id/iv_title_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_title_icon_overlay"
                android:visibility="gone"
                android:layout_width="7dp"
                android:layout_height="7dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_title_icon"
                app:layout_constraintEnd_toEndOf="@+id/iv_title_icon"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/iv_title_icon"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/iv_title_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_title_icon"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:gravity="center"
                android:id="@+id/tv_voucher_tag1"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintStart_toEndOf="@+id/tv_title"
                app:layout_constraintTop_toTopOf="@+id/tv_title"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:gravity="center"
                android:id="@+id/tv_voucher_tag2"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toTopOf="@+id/ll_service_detail_root_view"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayStandardCircleCheckbox
                android:id="@+id/v_check_box"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="@dimen/cj_pay_padding_12"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="36dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_service_detail_root_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/cj_pay_padding_8"
                android:layout_marginRight="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_voucher_tag2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_bottom_mask"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</merge>
