<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center"
        android:id="@+id/titleRoot"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/CreationMobile_Docs_Cancel_Button"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/select"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LarkCCM_CM_Verify_ValidityPeriod_Until_Title"
            android:layout_weight="3"
            app:layout_constraintEnd_toStartOf="@+id/open"
            app:layout_constraintStart_toEndOf="@+id/cancel"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textSize="16sp"
            android:textColor="@color/primary_content_default"
            android:gravity="center"
            android:id="@+id/open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Doc_Doc_SearchDone"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/divider"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleRoot"/>
    <com.larksuite.component.universe_design.timepicker.UDTimePicker
        android:id="@+id/time_picker"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:ud_timePicker_datePickerMode="yearMonthDay"
        app:ud_timePicker_itemVisibleNum="5"
        app:ud_timePicker_minuteInternal="5"
        app:ud_timePicker_showDayInfo="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
