<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/larus_chat_job_edit_card_bg"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_16"
    android:paddingHorizontal="?attr/larus_dp_16"
    android:paddingVertical="?attr/larus_dp_16">
    <EditText
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="start|top"
        android:id="@+id/larus_chat_job_edit_text_input"
        android:background="@null"
        android:padding="0dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:includeFontPadding="false"
        android:lineSpacingExtra="?attr/larus_dp_2"/>
</FrameLayout>
