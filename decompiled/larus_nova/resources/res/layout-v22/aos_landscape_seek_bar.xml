<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.base.view.seekbar.SupportSeekBarFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/supportSeekBarFL"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.base.view.RoundImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/video_thumb"
        android:background="@drawable/aos_common_feed_bg_video_thumb"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_marginBottom="144dp"
        app:radius="4dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.seekbar.CustomizedUISeekBar
        android:layout_gravity="bottom"
        android:id="@+id/video_seek_bar"
        android:visibility="invisible"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginBottom="64dp"
        android:progress="0"
        android:layout_marginHorizontal="50dp"
        style="@style/common_feed_customized_ui_seek_bar"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/video_duration_pinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="50dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/aos_const_text_inverse2"
            android:id="@+id/current_video_time_pinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:src="@drawable/aos_common_feed_seek_bar_duration_slash"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/aos_const_text_inverse4"
            android:id="@+id/total_video_time_pinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/video_seek_duration"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/aos_const_text_inverse2"
            android:id="@+id/current_seek_video_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/seek_bar_time_diagonal"
            android:layout_width="3dp"
            android:layout_height="11dp"
            android:src="@drawable/aos_common_feed_seek_bar_duration_slash"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/aos_const_text_inverse4"
            android:id="@+id/total_video_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
</com.bytedance.awemeopen.apps.framework.base.view.seekbar.SupportSeekBarFrameLayout>
