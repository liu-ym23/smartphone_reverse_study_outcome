<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/state_anim"
        android:background="@drawable/live_tutor_bottom"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/hybrid_container"
        android:paddingTop="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/voice_operation_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.livetutor.impl.view.LiveTutorVoiceView
        android:id="@+id/voice_operation_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hybrid_container"/>
    <com.larus.common_ui.venus.ShapeLinearLayout
        android:gravity="center"
        android:id="@+id/live_tutor_pause_container"
        android:paddingLeft="@dimen/dp_12"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_4"
        android:paddingHorizontal="@dimen/dp_12"
        app:larus_sc_cornerRadius="@dimen/dp_26"
        app:larus_sc_shadow_blur_radius="@dimen/dp_12"
        app:larus_sc_shadow_color="#1f000000"
        app:larus_sc_shadow_dy="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/live_tutor_pause_icon"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:src="@drawable/live_tutor_pause_icon"/>
    </com.larus.common_ui.venus.ShapeLinearLayout>
    <FrameLayout
        android:id="@+id/voice_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
