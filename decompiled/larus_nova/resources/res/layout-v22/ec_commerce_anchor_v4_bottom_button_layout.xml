<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/anchorv3_bottom_nav_button_root"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v4_ll_bottom_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.shopping.anchorv4.bottom.widget.CenteredTextWithOneIconElementView
            android:id="@+id/anchor_v4_bottom_tips_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.LynxCardView
            android:id="@+id/anchor_v4_bottom_lynx_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/button_top_border_view"
        android:background="@color/shopping_color_0D161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/supermarket_cart_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/commerce_anchor_v3_bottom_nav_area_height"/>
    <LinearLayout
        android:id="@+id/scale_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/anchor_v4_normal_buttons"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/commerce_anchor_v3_bottom_nav_area_height"
            android:baselineAligned="false">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                android:id="@+id/anchor_v4_bottom_left_items"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/anchor_v4_bottom_right_buttons"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginVertical="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
