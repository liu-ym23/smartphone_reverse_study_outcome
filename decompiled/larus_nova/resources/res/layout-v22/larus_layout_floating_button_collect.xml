<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/floating_collect_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:background="@drawable/larus_shadow_float"
        android:padding="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/larus_bg_floating_collect_button"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            android:paddingVertical="?attr/larus_dp_8">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/floating_collect_left_icon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"/>
            <com.larus.common_ui.view.NoSpaceTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_static_black"
                android:gravity="center"
                android:id="@+id/floating_collect_left_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_2"
                android:textFontWeight="500"/>
            <View
                android:id="@+id/floating_icon_center"
                android:background="@color/larus_static_neutral_transparent_3"
                android:layout_width="?attr/larus_dp_1"
                android:layout_height="?attr/larus_dp_14"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"/>
            <com.larus.common_ui.view.NoSpaceTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_primary_50"
                android:gravity="center"
                android:id="@+id/floating_collect_right_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
