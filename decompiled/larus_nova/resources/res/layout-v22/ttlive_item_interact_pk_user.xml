<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/head_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_nick_name_usertags"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/invite_container"
        app:layout_constraintStart_toEndOf="@+id/head_view"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:ellipsize="end"
            android:id="@+id/tv_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:maxEms="5"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/pk_season_icon"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="14.73dp"
            android:layout_marginLeft="4dp"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center_vertical"
            android:id="@+id/gender_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="visible"
            android:layout_width="14dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_gender_male_icon"
            android:scaleType="fitCenter"
            android:layout_marginStart="4dp"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <FrameLayout
            android:id="@+id/grade_level_container"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_grade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/iv_level"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitXY"/>
        </FrameLayout>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tags_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_fire_number"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/head_view"
        app:layout_constraintTop_toBottomOf="@+id/ll_nick_name_usertags">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/season_rank_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/rank_season_info_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="2dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#80161823"
                android:id="@+id/rank_season_info_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:text="钻石3星"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="#33000000"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ttlive_audience_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_icon_audience"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_douyin_pklist_audience"
            android:id="@+id/ttlive_audience_number"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ttlive_location_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_ic_location_v3"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="2dp"/>
        <ImageView
            android:id="@+id/ic_fire_number"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_ic_fire_number"
            android:scaleType="fitCenter"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_douyin_pklist_audience"
            android:id="@+id/tv_fire_number"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/relation_tags_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/reserve_container"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="3dp">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/reserve_line"
                android:background="#33000000"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#80161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/reserve_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="18dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/reserve_btn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11dp"
                    android:textColor="#bf161823"
                    android:gravity="center"
                    android:id="@+id/reserve_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="邀约"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/reserve_arrow"
                    android:background="@drawable/ttlive_reserve_arrow_icon"
                    android:layout_width="4dp"
                    android:layout_height="7dp"
                    android:layout_marginLeft="2dp"/>
            </LinearLayout>
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/invite_container"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_fire_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_nick_name_usertags">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_invite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:placeholderImage="@drawable/ttlive_bg_live_red_btn"
            app:roundedCornerRadius="@dimen/ttlive_pk_invite_random_btn_radius"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/tv_invite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_interact_invite"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_requesting"
            android:background="@drawable/ttlive_bg_link_invite_requesting"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
