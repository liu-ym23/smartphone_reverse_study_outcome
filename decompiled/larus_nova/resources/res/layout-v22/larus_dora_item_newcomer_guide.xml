<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_35"
        android:layout_marginRight="?attr/larus_dp_35"
        android:layout_marginHorizontal="?attr/larus_dp_35"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ux_shadow_color="#29000000"
        app:ux_shadow_offset_x="0dp"
        app:ux_shadow_offset_y="?attr/larus_dp_8"
        app:ux_shadow_radius="?attr/larus_dp_12"
        app:ux_shadow_size="?attr/larus_dp_8">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_card"
            android:background="@drawable/larus_bg_white_r12"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_40"
            android:paddingHorizontal="?attr/larus_dp_16"
            android:paddingVertical="?attr/larus_dp_8"
            app:layout_constrainedWidth="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="#af52de"
                    android:gravity="center_horizontal"
                    android:id="@+id/guideContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Can you take?"
                    android:textFontWeight="600"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.common_ui.widget.ShadowLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
