<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/larus_bg_round_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_dp_18"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"
            android:textFontWeight="600"/>
        <ScrollView
            android:background="@drawable/larus_alert_bg"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_108"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_5"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20">
            <com.larus.common_ui.widget.UrlSpanTextView
                android:textSize="?attr/larus_dp_15"
                android:textColor="@color/larus_neutral_70"
                android:id="@+id/dialog_message"
                android:paddingBottom="?attr/larus_dp_15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="400"
                app:larus_linkColor="@color/larus_primary_50"
                app:larus_linkUnderLine="false"/>
        </ScrollView>
        <View
            android:background="@drawable/larus_item_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/larus_bg_leftdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_cancel"
                android:layout_weight="1"
                android:textFontWeight="400"/>
            <View
                android:layout_gravity="center_horizontal"
                android:background="@drawable/larus_item_divider"
                android:layout_width="?attr/larus_dp_0_5"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="@drawable/larus_bg_rightdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_save"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_48"
        android:src="@drawable/larus_alert_bg"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"/>
</FrameLayout>
