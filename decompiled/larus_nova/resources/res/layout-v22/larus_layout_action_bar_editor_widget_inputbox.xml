<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="top"
        android:id="@+id/input_box_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_0"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_dp_16"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/input_box"
        android:background="@android:color/transparent"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="visible"
        android:scrollbars="vertical"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:maxHeight="?attr/larus_dp_122"
        android:minHeight="?attr/larus_dp_56"
        android:hint="@string/larus_send_message"
        android:maxLines="3"
        android:inputType="textMultiLine"
        android:paddingHorizontal="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_box_sub_title"
        app:layout_goneMarginTop="?attr/larus_dp_0"
        style="@style/larus_EditTextStyle"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
