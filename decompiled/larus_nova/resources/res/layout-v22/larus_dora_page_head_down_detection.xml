<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/head_down_detection_content_container"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingRight="?attr/larus_dp_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_144"
        android:paddingHorizontal="?attr/larus_dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/head_down_detection_visual_container"
            android:layout_width="?attr/larus_dp_284"
            android:layout_height="?attr/larus_dp_266">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/head_down_detection_running_lottie"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_284"
                android:layout_height="?attr/larus_dp_266"
                android:scaleType="fitCenter"
                app:lottie_loop="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/head_down_detection_running_face"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_150"
                android:layout_height="?attr/larus_dp_150"
                android:src="@drawable/larus_dora_g_head_down_calibrating_face"/>
            <com.larus.dora.impl.device.settings.lab.headdown.HeadDownCircularProgressView
                android:layout_gravity="center"
                android:id="@+id/head_down_detection_circular_progress"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_180"
                android:layout_height="?attr/larus_dp_180"/>
            <com.larus.common_ui.widget.roundlayout.RoundImageView
                android:id="@+id/head_down_detection_illustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/larus_dora_g_head_control_finish"
                android:scaleType="fitCenter"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/head_down_detection_countdown_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="64sp"
                    android:textColor="@color/larus_primary_50"
                    android:id="@+id/head_down_detection_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textFontWeight="700"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/head_down_detection_countdown_suffix"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_sec_to_start_cn"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/head_down_detection_status_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_72"
                android:layout_height="?attr/larus_dp_72"
                android:src="@drawable/larus_icon_warning_circle"/>
        </FrameLayout>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_23"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/head_down_detection_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:textFontWeight="600"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/head_down_detection_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"/>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/head_down_detection_action_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_34"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_24"
        android:stateListAnimator="@null"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
