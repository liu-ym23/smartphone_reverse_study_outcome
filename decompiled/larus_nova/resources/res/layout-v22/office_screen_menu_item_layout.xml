<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/menu_icon_container"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/office_screen_menu_text"
            android:ellipsize="end"
            android:id="@+id/menu_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="18dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/menu_sub_text"
            app:layout_constraintEnd_toStartOf="@+id/holder"
            app:layout_constraintStart_toEndOf="@+id/menu_icon_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"
            app:layout_constraintWidth_max="150dp"
            app:layout_goneMarginStart="0dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/menu_sub_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/menu_end_icon_container"
            app:layout_constraintStart_toStartOf="@+id/menu_text"
            app:layout_constraintTop_toBottomOf="@+id/menu_text"/>
        <View
            android:id="@+id/holder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/menu_end_icon_container"
            app:layout_constraintStart_toEndOf="@+id/menu_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="0dp"/>
        <FrameLayout
            android:id="@+id/menu_end_icon_container"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_end_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
