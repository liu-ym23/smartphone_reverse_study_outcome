<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#3d131415"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_public_screen_config_hint_color"
        android:gravity="center"
        android:id="@+id/usage_hint"
        android:layout_width="240dp"
        android:layout_height="42dp"
        android:layout_marginTop="108dp"
        android:text="@string/ttlive_public_screen_config_hint"
        android:shadowColor="#1a000000"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:lineHeight="21dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_public_screen_config_btn_close"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tray_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toTopOf="@+id/public_screen"
        app:layout_constraintLeft_toLeftOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_tray_1"
            android:layout_width="206dp"
            android:layout_height="47dp"
            android:src="@color/transparent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_tray_2"
            android:layout_width="206dp"
            android:layout_height="47dp"
            android:src="@color/transparent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/enter_anim"
            android:layout_width="238dp"
            android:layout_height="26dp"
            android:src="@color/transparent"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/public_screen"
        android:fadingEdgeLength="24dp"
        android:clipChildren="true"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="14dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/slider_area"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/slider_area"
        android:clipChildren="false"
        android:layout_width="108dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/toolbar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:layout_marginBottom="8dp"
            android:text="高度"
            android:shadowColor="#4d000000"
            android:shadowDy="1"
            android:shadowRadius="1"
            app:layout_constraintBottom_toTopOf="@+id/slider_height"
            app:layout_constraintLeft_toLeftOf="@+id/slider_height"
            app:layout_constraintRight_toRightOf="@+id/slider_height"/>
        <com.bytedance.android.livesdk.interactivity.publicscreen.ui.PublicScreenConfigSliderView
            android:id="@+id/slider_height"
            android:layout_width="36dp"
            android:layout_height="161dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="18dp"
            app:bottom_text="低"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/slider_font"
            app:middle_text="中"
            app:top_text="高"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:layout_marginBottom="8dp"
            android:text="字号"
            android:shadowColor="#4d000000"
            android:shadowDy="1"
            android:shadowRadius="1"
            app:layout_constraintBottom_toTopOf="@+id/slider_font"
            app:layout_constraintLeft_toLeftOf="@+id/slider_font"
            app:layout_constraintRight_toRightOf="@+id/slider_font"/>
        <com.bytedance.android.livesdk.interactivity.publicscreen.ui.PublicScreenConfigSliderView
            android:id="@+id/slider_font"
            android:layout_width="36dp"
            android:layout_height="161dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="18dp"
            app:bottom_text="小"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:middle_text="中"
            app:top_text="大"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_complete"
            android:background="@drawable/ttlive_bg_complete_btn"
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:layout_marginRight="20dp"
            android:text="完成"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
