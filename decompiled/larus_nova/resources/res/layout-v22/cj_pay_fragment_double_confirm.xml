<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_double_confirm_panel"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="372dp"
    android:layout_alignParentBottom="true">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/close_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/cj_pay_icon_x_close"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/cj_pay_text_link_default"
            android:id="@+id/top_right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/cj_pay_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_confirm_page_order_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_verify_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_verify_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <TextView
            android:textSize="24sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="bottom"
            android:id="@+id/amount_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="3dp"
            android:text="@string/cj_pay_currency_unit"/>
        <com.android.ttcjpaysdk.base.ui.widget.ScrollAnimTextView
            android:textSize="36sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="bottom"
            android:id="@+id/cj_pay_verify_amount_text"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.android.ttcjpaysdk.base.ui.component.money.CJMoneyTextComponent
            android:textSize="36sp"
            android:gravity="bottom"
            android:id="@+id/cj_pay_verify_amount_text_std"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_marketing_orange"
        android:id="@+id/cj_pay_verify_discount_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="320dp"
        android:maxLines="2"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_verify_amount"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_page_plain_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_verify_discount_desc"/>
    <View
        android:id="@+id/pay_type_helper_layout_divider_line"
        android:background="?attr/cj_pay_border_divider_grey_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_page_plain_text"
        app:layout_goneMarginTop="8dp"/>
    <com.android.ttcjpaysdk.thirdparty.front.counter.dypay.view.CJPayVerifyPayTypeLayout
        android:id="@+id/verify_pay_type_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:minHeight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pay_type_helper_layout_divider_line"/>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJRowSwitchText
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_bank_card_points_open"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="12dp"
        app:CJRowSwitchChecked="false"
        app:CJRowSwitchContent=""
        app:CJRowSwitchContentSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_button_above_security_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.android.ttcjpaysdk.base.ui.component.security.CJSecurityTextView
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_button_above_security_view"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_button_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="bottom"
        android:id="@+id/bottom_button_layout"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:id="@+id/right_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
