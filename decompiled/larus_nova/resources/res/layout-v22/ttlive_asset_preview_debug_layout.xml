<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#b3000000"
        android:layout_width="match_parent"
        android:layout_height="320dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/filter_asset_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="#e6ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索："/>
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="40dp">
                <EditText
                    android:theme="@style/debug_gift_preview_edittext"
                    android:textColor="#e6ffffff"
                    android:textColorHint="#4dffffff"
                    android:layout_gravity="bottom"
                    android:id="@+id/asset_edit"
                    android:focusable="true"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:focusedByDefault="true"/>
                <TextView
                    android:textColor="#e6ffffff"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/debug_clear_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="@string/ttlive_gift_debug_clear"/>
            </FrameLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/update_btn"
                android:background="@drawable/ttlive_debug_gift_preview_btn_bg"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="刷新"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assets_list"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="20dp"/>
        <TextView
            android:textColor="#e6ffffff"
            android:layout_gravity="center"
            android:id="@+id/close_gift_preview"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="5dp"
            android:text="@string/ttlive_gift_debug_close"/>
    </LinearLayout>
</FrameLayout>
