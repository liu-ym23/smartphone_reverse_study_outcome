<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/commerce_law_hint_dialog_bg"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/TextReverse"
        android:gravity="center"
        android:id="@+id/law_hint_title"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/font_size_34"/>
    <TextView
        android:textColor="@color/commerce_color_BF161823"
        android:id="@+id/law_hint_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_title"
        style="@style/font_size_28"/>
    <CheckBox
        android:id="@+id/law_hint_check_box"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:paddingStart="20dp"
        android:paddingEnd="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_desc"
        style="@style/commerce_anchor_v3_law_hint_dialog_check_box"/>
    <TextView
        android:textColor="#99161823"
        android:id="@+id/law_hint_agree_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toRightOf="@+id/law_hint_check_box"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_desc"
        style="@style/font_size_28"/>
    <ImageView
        android:id="@+id/law_hint_divider_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/commerce_law_hint_divider_row"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_agree_desc"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/commerce_law_hint_divider_column"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_divider_row"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:id="@+id/law_hint_later"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_agree_desc"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/shopping_std_text_black_1"
        android:gravity="center"
        android:id="@+id/law_hint_confirm"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/law_hint_agree_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
