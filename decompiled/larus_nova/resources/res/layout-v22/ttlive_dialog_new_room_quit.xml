<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dialog_new_room_quit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_new_room_quit_dialog_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_new_room_quit_close_btn"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_live_cover_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_live_cover_1,iv_avatar_1,tv_nickname_1,tv_desc_1,tv_watch_count_1,assist_label_1"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_live_cover_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:foreground="@drawable/ttlive_fg_new_room_quit_dialog_cover"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="@+id/gl_center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.bytedance.android.livesdk.quitroom.view.RoomAssistLabelView
        android:id="@+id/assist_label_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_1"
        app:layout_constraintTop_toTopOf="@+id/iv_live_cover_1"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="33dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_1"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nickname_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8.5dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_1"
        app:layout_constraintEnd_toEndOf="@+id/iv_live_cover_1"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar_1"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar_1"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_desc_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_1"
        app:layout_constraintEnd_toStartOf="@+id/tv_watch_count_1"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_1"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#b2ffffff"
        android:id="@+id/tv_watch_count_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_1"
        app:layout_constraintEnd_toEndOf="@+id/iv_live_cover_1"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_live_cover_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_live_cover_2,iv_avatar_2,tv_nickname_2,tv_desc_2,tv_watch_count_2,assist_label_2"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_live_cover_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:foreground="@drawable/ttlive_fg_new_room_quit_dialog_cover"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.bytedance.android.livesdk.quitroom.view.RoomAssistLabelView
        android:id="@+id/assist_label_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_2"
        app:layout_constraintTop_toTopOf="@+id/iv_live_cover_2"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="33dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_2"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nickname_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8.5dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_2"
        app:layout_constraintEnd_toEndOf="@+id/iv_live_cover_2"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar_2"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar_2"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_desc_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_2"
        app:layout_constraintEnd_toStartOf="@+id/tv_watch_count_2"
        app:layout_constraintStart_toStartOf="@+id/iv_live_cover_2"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#b2ffffff"
        android:id="@+id/tv_watch_count_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_cover_2"
        app:layout_constraintEnd_toEndOf="@+id/iv_live_cover_2"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_live_cover_1">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_positive_btn"
            android:background="@drawable/ttlive_bg_new_room_quit_dialog_positive_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_new_room_quit_dialog_more_live_tip"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#80ffffff"
            android:layout_gravity="center"
            android:id="@+id/tv_negative_btn"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_new_room_quit_dialog_no_data_tip"/>
    </LinearLayout>
    <com.bytedance.dux.drawable.DoubleColorBallAnimationView
        android:id="@+id/lottie_animation_view"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_empty_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="114dp"
        android:src="@drawable/ttlive_new_quit_room_dialog_empty_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80ffffff"
        android:id="@+id/tv_empty_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_new_room_quit_dialog_empty_tip"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="@+id/iv_empty_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_empty_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_empty_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
