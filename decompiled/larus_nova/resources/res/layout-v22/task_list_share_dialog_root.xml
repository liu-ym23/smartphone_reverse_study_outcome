<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/task_list_share_dialog_bg_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">
                <ImageView
                    android:id="@+id/close_icon"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:tint="@color/icon_n1"
                    android:layout_marginStart="@dimen/dp_16"
                    app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
                <TextView
                    android:textSize="@dimen/sp_17"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_ShareList_Title"
                    android:layout_marginEnd="@dimen/dp_40"/>
            </LinearLayout>
            <View
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/bg_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/task_list_invite_collaborator_container"
                    android:background="@drawable/bg_setting_group_item_round_top"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_13"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:tint="@color/icon_n1"
                        app:srcCompat="@drawable/ud_icon_member_add_outlined"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_ShareList_InviteCollaborators_Title"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_marginEnd="@dimen/dp_12"/>
                    <ImageView
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:tint="@color/icon_n2"
                        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
                </LinearLayout>
                <LinearLayout
                    android:background="@color/bg_body"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16">
                    <View
                        android:background="@color/line_divider_default"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dp_44"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/task_list_manage_collaborator_container"
                    android:background="@drawable/bg_setting_group_item_round_bottom"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:tint="@color/icon_n1"
                        app:srcCompat="@drawable/ud_icon_group_outlined"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_ListCard_Collaborators_Text"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_marginEnd="@dimen/dp_12"/>
                    <com.larksuite.component.universe_design.image.UDAvatarList
                        android:id="@+id/task_list_collaborators"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:ud_avatarList_maxCount="5"/>
                    <ImageView
                        android:layout_width="16sp"
                        android:layout_height="16sp"
                        android:tint="@color/icon_n2"
                        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/task_list_share_icon"
                            android:background="@drawable/bg_setting_group_item_round"
                            android:padding="16sp"
                            android:layout_width="48sp"
                            android:layout_height="48sp"
                            android:layout_marginBottom="@dimen/dp_8"
                            android:tint="@color/icon_n1"
                            app:srcCompat="@drawable/ud_icon_forward_outlined"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/text_caption"
                            android:gravity="center_horizontal"
                            android:id="@+id/task_list_share_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/dp_64"
                            android:text="@string/Todo_ShareList_ShareToChat_Title"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:paddingHorizontal="8dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/task_list_copy_link_icon"
                            android:background="@drawable/bg_setting_group_item_round"
                            android:padding="16sp"
                            android:layout_width="48sp"
                            android:layout_height="48sp"
                            android:layout_marginBottom="@dimen/dp_8"
                            android:tint="@color/icon_n1"
                            app:srcCompat="@drawable/ud_icon_link_copy_outlined"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/text_caption"
                            android:gravity="center_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/dp_64"
                            android:text="@string/Todo_ShareList_ShareViaLink_Hover"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
