<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="?attr/larus_dp_4"
    android:paddingBottom="?attr/larus_dp_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="?attr/larus_dp_4">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/left_img"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_canvas_button_close"/>
    <TextView
        android:textSize="?attr/larus_dp_20"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/center_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textFontWeight="700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/center_img"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_79"
        android:layout_height="?attr/larus_dp_29"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/right_text"
        android:background="?attr/larus_ic_canvas_button_with_border"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_44"
        android:minWidth="?attr/larus_dp_64"
        android:maxLines="1"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:paddingHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/right_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated_black"
        android:indeterminateDuration="1000"
        android:repeatCount="infinite"
        app:layout_constraintBottom_toBottomOf="@+id/right_text"
        app:layout_constraintEnd_toEndOf="@+id/right_text"
        app:layout_constraintStart_toStartOf="@+id/right_text"
        app:layout_constraintTop_toTopOf="@+id/right_text"/>
</merge>
