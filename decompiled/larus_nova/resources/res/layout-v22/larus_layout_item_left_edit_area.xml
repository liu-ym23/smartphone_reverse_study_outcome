<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_44"
    android:layout_height="?attr/larus_dp_58">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_left_edit_area"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_9"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/iv_left_edit_area_indicator"
        android:layout_width="?attr/larus_dp_14"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginTop="?attr/larus_dp_3"
        android:text="@string/larus_imageDetail_btn_label_new"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_3"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rv_backgroundColor="?attr/larus_primary_50"
        app:rv_backgroundPressColor="?attr/larus_primary_50"
        app:rv_cornerRadius="?attr/larus_dp_4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_10"
        android:textColor="@color/larus_static_white"
        android:id="@+id/tv_left_edit_area"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_left_edit_area"/>
</merge>
