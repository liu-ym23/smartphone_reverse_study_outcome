<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_coupon_fragment_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rl_title_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ec_page_title_height">
            <com.bytedance.android.ui.base.widget.icon.IconImageView
                android:id="@+id/iv_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ec_dux_ic_s_s_arrowleft_outlined"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                app:icon_color="@color/ec_dux_black_161823"/>
            <TextView
                android:textSize="@dimen/ec_dialog_title_text_size"
                android:textStyle="bold"
                android:textColor="@color/ec_color_black_text"
                android:id="@+id/tv_coupon_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_coupon_text"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/iv_coupon_desc"
                android:padding="2dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ec_icon_coupon_desc"
                android:layout_toRightOf="@+id/tv_coupon_text"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_coupon_text"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tv_bind_coupon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ec_add_coupon"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ec_color_90_666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/ec_add"
                    android:layout_marginHorizontal="4dp"/>
            </LinearLayout>
            <View
                android:background="@color/ec_color_black_161823_10"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_coupon_list"
                android:paddingTop="12dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.livesdk.livecommerce.view.ECHostNoCouponLayoutImpl
                android:id="@+id/echncl_no_coupon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.livesdk.livecommerce.view.ECLoadingStateView
                android:gravity="center"
                android:id="@+id/eclv_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <com.bytedance.android.livesdk.livecommerce.view.ECLoadingLayout
        android:id="@+id/ecll_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.ui.ec.widget.guide.ECFunctionGuideView
        android:id="@+id/view_function_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
