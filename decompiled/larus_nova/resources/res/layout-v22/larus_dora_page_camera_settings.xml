<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_take_image_switch_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_take_image_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_take_image_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_burst_take_image_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_burst_take_image_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_burst_take_image_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_burst_take_image_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="打开后，耳机会在用户与豆包对话期间持续拍摄照片"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_burst_take_image_group"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_take_image_tips_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="\10\10\10\10"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_burst_take_image_group"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_take_image_tips_content1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视觉工作模式1：默认对话模式"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_take_image_tips_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_take_image_tips_content2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="【进入】：说 “豆包豆包”\10【退出】：说 “退出”，或摘下耳机，或 8 秒无人说话\10【拍照机制】\10  - 关闭 “连续拍照” ：有视觉意图时，左右耳各拍一张照片\10  - 开启 “连续拍照” ：不判断意图，对话期间单耳持续连拍\10"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_take_image_tips_content1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_take_image_tips_content3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视觉工作模式2：陪伴模式"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_take_image_tips_content2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_take_image_tips_content4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="【进入】：说 “豆包豆包，进入陪伴模式” \10【退出】：说 “退出”，或摘下耳机（不会 8 秒超时退出）\10【拍照机制】：陪伴模式中单耳持续连拍（间隔小于2秒）\10【免唤醒】：陪伴模式中可以随时和豆包说话，无需唤醒"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_take_image_tips_content3"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
