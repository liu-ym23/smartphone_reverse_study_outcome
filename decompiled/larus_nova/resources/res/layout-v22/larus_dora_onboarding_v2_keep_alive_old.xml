<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/dora_onboarding_keep_alive_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_164">
            <ImageView
                android:layout_width="?attr/larus_dp_160"
                android:layout_height="?attr/larus_dp_160"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginRight="?attr/larus_dp_32"
                android:src="@drawable/larus_dora_onboarding_keep_alive_avatar_img"
                android:layout_marginHorizontal="?attr/larus_dp_32"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_23"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_33"
                android:layout_marginRight="?attr/larus_dp_32"
                android:text="@string/larus_dora_onboarding_keep_alive_title_cn"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="600"/>
            <com.larus.dora.impl.view.DoraUrlSpanTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_neutral_50"
                android:gravity="center_horizontal"
                android:id="@+id/dora_onboarding_keep_alive_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_20"
                android:layout_marginRight="?attr/larus_dp_32"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="?attr/larus_dp_32"
                android:textFontWeight="400"
                app:larus_linkColor="@color/larus_neutral_100"
                app:larus_linkUnderLine="false"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
