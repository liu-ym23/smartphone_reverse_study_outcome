<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v4_nav_area_2102168156"
    android:layout_width="match_parent"
    android:layout_height="@dimen/commerce_anchor_v3_top_area_height">
    <View
        android:id="@+id/anchor_v4_top_mask"
        android:background="@color/BGReverse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/anchor_v4_top_mask_layout"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <com.bytedance.android.shopping.anchorv4.nav.blur.UnresponsiveRecyclerView
            android:id="@+id/anchor_v4_top_blur_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.blur.RealtimeBlurView
            android:id="@+id/blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:realtimeBlurRadius="40dp"
            app:realtimeOverlayColor="@android:color/transparent"/>
        <View
            android:background="@color/BGReverse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/anchor_v4_nav_white_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0">
        <ImageView
            android:id="@+id/anchor_v4_nav_close_shadow"
            android:padding="5dp"
            android:layout_width="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ec_commerce_anchor_v4_back_arrow_shadow"
            android:contentDescription="@string/shopping_return"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/commerce_color_161823"
            android:gravity="center"
            android:id="@+id/anchor_v4_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_anchor_v4_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/top_right_controls_light_layout"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginRight="2dp"
            android:layout_marginEnd="2dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                android:layout_gravity="center_vertical"
                android:id="@+id/top_right_controls_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                android:layout_gravity="center_vertical"
                android:id="@+id/top_right_controls_off_screen"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.bytedance.android.shopping.anchorv4.nav.AnchorV4SearchEditView
            android:id="@+id/anchor_v4_search_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="10dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintLeft_toRightOf="@+id/anchor_v4_nav_close_shadow"
            app:layout_constraintRight_toLeftOf="@+id/top_right_controls_light_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/anchor_v4_nav_dark_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/anchor_v4_nav_close"
            android:padding="5dp"
            android:layout_width="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ec_commerce_anchor_v4_back_arrow"
            android:contentDescription="@string/shopping_return"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/top_right_controls_dark_layout"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginRight="2dp"
            android:paddingHorizontal="12dp">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
                android:layout_gravity="center_vertical"
                android:id="@+id/top_right_controls_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
