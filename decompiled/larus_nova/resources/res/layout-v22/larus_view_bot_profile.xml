<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/profile_bot_avatar"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:scaleType="centerCrop"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:roundAsCircle="true"/>
    <FrameLayout
        android:id="@+id/profile_layout_right_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="?attr/larus_dp_30"
        android:minHeight="?attr/larus_dp_30"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/profile_add_bot_btn"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            app:srcCompat="@drawable/ic_bot_add"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/profile_bot_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/profile_bot_intro"
        app:layout_constraintEnd_toStartOf="@+id/iv_immersive_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/profile_bot_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="?attr/larus_dp_20"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start"
        android:id="@+id/iv_immersive_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="?attr/larus_dp_18"
        android:paddingStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/profile_bot_name"
        app:layout_constraintEnd_toStartOf="@+id/profile_bot_review_tag"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/profile_bot_name"
        app:layout_constraintTop_toTopOf="@+id/profile_bot_name"
        app:layout_goneMarginEnd="?attr/larus_dp_16"
        app:srcCompat="@drawable/larus_ic_bot_immersive"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_11"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/profile_bot_review_tag"
        android:background="@drawable/larus_bg_gray_rectangle"
        android:paddingLeft="?attr/larus_dp_6"
        android:paddingTop="?attr/larus_dp_5"
        android:paddingRight="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_tag_review_failed"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginStart="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_4"
        android:paddingHorizontal="?attr/larus_dp_6"
        android:paddingVertical="?attr/larus_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/profile_bot_name"
        app:layout_constraintEnd_toStartOf="@+id/profile_layout_right_action"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_immersive_icon"
        app:layout_constraintTop_toTopOf="@+id/profile_bot_name"
        app:layout_goneMarginStart="?attr/larus_dp_6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/profile_bot_intro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/iv_tag"
        app:layout_constraintEnd_toStartOf="@+id/profile_layout_right_action"
        app:layout_constraintStart_toStartOf="@+id/profile_bot_name"
        app:layout_constraintTop_toBottomOf="@+id/profile_bot_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_3"
        android:src="@drawable/larus_icon_tag_hot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/profile_bot_intro"
        app:layout_constraintTop_toBottomOf="@+id/profile_bot_intro"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/tv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_tag"
        app:layout_constraintStart_toEndOf="@+id/iv_tag"
        app:layout_constraintTop_toTopOf="@+id/iv_tag"/>
</merge>
