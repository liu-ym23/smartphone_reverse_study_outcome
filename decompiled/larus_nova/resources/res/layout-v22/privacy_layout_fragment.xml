<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:backgroundTint="@color/bg_body_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_left_title=""
        app:widget_widgets_tb_title="@string/CreationMobile_Common_PrivacySettings_tab"/>
    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading_anim"
        style="@style/BearLottieView"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:id="@+id/title1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/CreationMobile_Common_PrivacySettings_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/open_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title1">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:id="@+id/oepn_text"
            android:background="@drawable/facade_round_around_l"
            android:paddingLeft="13dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/CreationMobile_Stats_Visits_Enable"
            android:backgroundTint="@color/bg_body"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/ud_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_12"
            android:checked="true"
            app:layout_constraintBottom_toBottomOf="@+id/oepn_text"
            app:layout_constraintRight_toRightOf="@+id/oepn_text"
            app:layout_constraintTop_toTopOf="@+id/oepn_text"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:id="@+id/explain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/CreationMobile_Stats_Visits_DisableDesc"
            app:layout_constraintLeft_toLeftOf="@+id/oepn_text"
            app:layout_constraintRight_toRightOf="@+id/oepn_text"
            app:layout_constraintTop_toBottomOf="@+id/oepn_text"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/ud_B600"
            android:gravity="start"
            android:id="@+id/lean_more"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/CreationDoc_Stats_Visits_desc_more"
            android:paddingVertical="6dp"
            app:layout_constraintLeft_toLeftOf="@+id/explain"
            app:layout_constraintTop_toBottomOf="@+id/explain"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/avatar_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/open_root">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:id="@+id/avatar_txt"
            android:background="@drawable/facade_round_around_l"
            android:paddingLeft="13dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/LarkCCM_Docs_DocDetail_ShowIdentity_Title"
            android:backgroundTint="@color/bg_body"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/avatar_ud_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_12"
            android:checked="true"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_txt"
            app:layout_constraintRight_toRightOf="@+id/avatar_txt"
            app:layout_constraintTop_toTopOf="@+id/avatar_txt"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:id="@+id/avatar_explain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/LarkCCM_Docs_DocDetail_ShowIdentity_Descrip"
            app:layout_constraintLeft_toLeftOf="@+id/avatar_txt"
            app:layout_constraintRight_toRightOf="@+id/avatar_txt"
            app:layout_constraintTop_toBottomOf="@+id/avatar_txt"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/ud_B600"
            android:gravity="start"
            android:id="@+id/avatar_learn_more"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/CreationDoc_Stats_Visits_desc_more"
            android:paddingVertical="6dp"
            app:layout_constraintLeft_toLeftOf="@+id/avatar_explain"
            app:layout_constraintTop_toBottomOf="@+id/avatar_explain"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/found_empty_state"
        android:background="@color/bg_body_overlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        app:ud_empty_imageRes="@null"
        style="@style/SpaceEmptyStatusStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
