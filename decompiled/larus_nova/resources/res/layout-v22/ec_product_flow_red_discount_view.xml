<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_commerce_anchor_v3_discount_price"
    android:paddingLeft="8dp"
    android:paddingTop="0.5dp"
    android:paddingRight="8dp"
    android:paddingBottom="0.5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="0.5dp">
    <TextView
        android:textSize="11sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_discount_price_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_discount_price_divider"
        android:layout_width="0.5dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/commerce_anchor_v3_divider"
        android:scaleType="centerCrop"
        android:layout_toRightOf="@+id/tv_discount_price_text"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tv_discount_price_text"/>
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/tv_discount_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/iv_discount_price_divider"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/iv_discount_price_divider"
        app:extraTextColor="@android:color/white"
        app:extraTextSize="11sp"
        app:prefixTextSize="11sp"
        app:priceDecimalTextSize="11sp"
        app:priceTextColor="@android:color/white"
        app:priceTextSize="15sp"
        app:spaceSize="1dp"
        app:thinDecimal="true"
        app:yangTextSize="11sp"/>
</RelativeLayout>
