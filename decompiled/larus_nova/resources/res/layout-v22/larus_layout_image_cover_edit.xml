<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/image_ai_beautify"
        android:padding="?attr/larus_dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/larus_bg_gray_btn_radius_8"
            android:paddingLeft="?attr/larus_dp_7"
            android:paddingRight="?attr/larus_dp_7"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_30"
            android:paddingHorizontal="?attr/larus_dp_7">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/image_ai_beautify_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_creation_photo_editor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/image_ai_beautify_text"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_30"
                android:text="@string/larus_aiImage_genResults_btn_aiEdit"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/image_ai_beautify_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="?attr/larus_dp_0"/> /&gt; 
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/image_ai_video"
        android:padding="?attr/larus_dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/larus_bg_gray_btn_radius_8"
            android:paddingLeft="?attr/larus_dp_7"
            android:paddingRight="?attr/larus_dp_7"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_30"
            android:paddingHorizontal="?attr/larus_dp_7">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/image_ai_video_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_creation_video"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/image_ai_video_text"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_30"
                android:text="@string/larus_imageDetail_btn_video"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/image_ai_video_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="?attr/larus_dp_0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</merge>
