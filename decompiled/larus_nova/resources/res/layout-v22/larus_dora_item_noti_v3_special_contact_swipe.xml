<?xml version="1.0" encoding="utf-8"?>
<com.larus.dora.impl.nl.notification_rule.ui.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_72">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/btn_edit"
            android:background="@color/larus_warning_50"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="?attr/larus_dp_72"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_rule_action_edit_cn"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/btn_delete"
            android:background="@color/larus_danger_50"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="?attr/larus_dp_72"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_dialog_delete_rule_btn_confirm_cn"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:background="@color/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="?attr/larus_dp_16">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/tv_contact_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_14"
            android:maxLines="1"
            android:textFontWeight="500"
            app:layout_constraintEnd_toStartOf="@+id/iv_selection_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/iv_selection_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_contact_name"/>
        <ImageView
            android:id="@+id/iv_selection_icon"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="match_parent"
            android:src="@drawable/larus_dora_rule_status_selector"
            android:scaleType="center"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.dora.impl.nl.notification_rule.ui.SwipeLayout>
