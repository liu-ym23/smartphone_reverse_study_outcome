<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/front_home_page_method_view"
        android:background="@drawable/cj_pay_front_home_page_payment_bg"
        android:paddingTop="@dimen/cj_pay_padding_10"
        android:paddingBottom="@dimen/cj_pay_padding_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/cj_pay_padding_14"
        android:paddingEnd="@dimen/cj_pay_padding_11"
        android:paddingVertical="@dimen/cj_pay_padding_10">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/preferred_payment_method_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="优先付款方式"/>
        <ImageView
            android:id="@+id/bank_image"
            android:layout_width="@dimen/cj_pay_padding_14"
            android:layout_height="@dimen/cj_pay_padding_14"
            android:layout_marginStart="@dimen/cj_pay_padding_12"
            android:layout_marginEnd="@dimen/cj_pay_padding_2"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="middle"
            android:id="@+id/bank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="175dp"
            android:text="中国银行储蓄卡 (6320)"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow"
            android:layout_width="@dimen/cj_pay_height_20"
            android:layout_height="@dimen/cj_pay_height_20"
            android:src="@drawable/cj_pay_icon_right_arrow_gray_40000000"
            android:scaleType="centerCrop"/>
    </LinearLayout>
    <Space
        android:id="@+id/front_home_page_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJPayAgreementView
        android:id="@+id/protocol_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_14"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="@dimen/cj_pay_font_size_15"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/primary_button"
        android:background="@drawable/cj_pay_bg_stdui_dialog_primary_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:text="签约并支付"
        android:stateListAnimator="@null"/>
    <Button
        android:textSize="@dimen/cj_pay_font_size_15"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/secondary_button"
        android:background="@drawable/cj_pay_bg_stdui_dialog_secondary_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_marginTop="@dimen/cj_pay_padding_8"
        android:text="继续免密付款"
        android:stateListAnimator="@null"/>
</LinearLayout>
