<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:background="?attr/larus_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/larus_chat_job_main_title_container"
        android:background="?attr/larus_base_1"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/larus_chat_job_main_content_placeholder"
        android:background="?attr/larus_base_1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/splitter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/larus_chat_job_main_title_container"/>
    <View
        android:id="@+id/cancel_modify_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/larus_chat_job_main_content_placeholder"
        app:layout_constraintEnd_toEndOf="@+id/larus_chat_job_main_content_placeholder"
        app:layout_constraintStart_toStartOf="@+id/larus_chat_job_main_content_placeholder"
        app:layout_constraintTop_toTopOf="@+id/larus_chat_job_main_content_placeholder"/>
    <View
        android:id="@+id/splitter"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintBottom_toTopOf="@+id/input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/larus_chat_job_main_content_placeholder"/>
    <ViewStub
        android:id="@+id/bottom_floating_button_container"
        android:visibility="gone"
        android:inflatedId="@+id/bottom_floating_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/input"/>
    <FrameLayout
        android:id="@+id/input"
        android:background="?attr/larus_base_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/continue_talk_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splitter">
        <ViewStub
            android:id="@+id/input_delegate"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <Space
        android:id="@+id/space_shortcut_y_pos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintTop_toTopOf="@+id/input"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/latest_photo_shortcut_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/space_shortcut_y_pos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/space_shortcut_x_pos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="?attr/larus_dp_128"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ViewStub
            android:id="@+id/stub_latest_photo_shortcut"
            android:inflatedId="@+id/latest_photo_shortcut_layout"
            android:layout_width="?attr/larus_dp_136"
            android:layout_height="?attr/larus_dp_160"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/space_shortcut_x_pos"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/continuous_talk_container"
        android:visibility="gone"
        android:inflatedId="@+id/continuous_talk_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/continue_talk_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginHorizontal="?attr/larus_dp_12"
        android:layout_marginVertical="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/case_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input"/>
    <ViewStub
        android:id="@+id/case_layout"
        android:layout="@layout/larus_page_chat_bottom_case"
        android:inflatedId="@+id/case_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
        app:layout_constraintTop_toBottomOf="@+id/continue_talk_btn"/>
    <ViewStub
        android:id="@+id/playback_layout"
        android:layout="@layout/larus_page_chat_bottom_playback"
        android:inflatedId="@+id/playback_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_layout"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/case_layout">
        <com.larus.bmhome.view.BottomMenuGridLayout
            android:id="@+id/bottom_menu"
            android:background="?attr/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/speaker"
        android:visibility="gone"
        android:clickable="true"
        android:inflatedId="@+id/speaker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/touch_intercepting_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/intercept_use_interact_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/input_intercept_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.view.TouchInterceptingView
        android:id="@+id/top_button_intercept_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.larus.bmhome.view.ChatConstraintLayout>
