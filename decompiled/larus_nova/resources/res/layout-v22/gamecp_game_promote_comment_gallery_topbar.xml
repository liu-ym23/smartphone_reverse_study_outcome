<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.gamecp.business.gallery.view.indicator.NumberIndicator
            android:textColor="#ffffff"
            android:id="@+id/preview_indicator"
            android:background="@drawable/shape_bg_57000000_corner_20"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="5dp"/>
        <com.bytedance.android.gamecp.business.gallery.view.indicator.TitleIndicator
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/preview_title"
            android:background="@drawable/shape_bg_57000000_corner_20"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxHeight="106dp"
            android:layout_centerInParent="true"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"/>
    </RelativeLayout>
</LinearLayout>
