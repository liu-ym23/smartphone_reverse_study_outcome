<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
        android:id="@+id/ratingbar_title_score"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:starBgDrawable="@drawable/gamecp_ic_game_promote_star_white"
        app:starClickable="false"
        app:starCount="1"
        app:starScrollable="false"
        app:starType="whole"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:id="@+id/tv_title_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ratingbar_title_score"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
