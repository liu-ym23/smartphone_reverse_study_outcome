<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_44">
    <FrameLayout
        android:id="@+id/dora_onboarding_top_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_wakeup_title"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/dora_onboarding_avatar"
            android:background="@drawable/larus_bg_white_circle"
            android:layout_width="?attr/larus_dp_160"
            android:layout_height="?attr/larus_dp_160"
            app:roundedCornerRadius="?attr/larus_dp_80"/>
    </FrameLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_24"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dora_onboarding_wakeup_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:text="@string/larus_dora_onboarding_wakeup_title_cn"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <FrameLayout
        android:id="@+id/dora_onboarding_recycler_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_selected_container">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dora_onboarding_recycler_view"
            android:paddingLeft="?attr/larus_dp_24"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_24"
            android:paddingBottom="?attr/larus_dp_24"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="?attr/larus_dp_24"/>
    </FrameLayout>
    <View
        android:id="@+id/dora_onboarding_recycler_mask"
        android:background="@drawable/larus_dora_h_simplified_recycler_mask"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dora_onboarding_selected_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dora_onboarding_selected_container"
        android:background="@drawable/larus_dora_h_simplified_capsule_bg"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_24"
        android:minHeight="?attr/larus_dp_48"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        android:paddingHorizontal="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_wakeup_title">
        <com.larus.dora.impl.view.DoraSimplifiedGradientTextView
            android:textSize="?attr/larus_sp_16"
            android:id="@+id/dora_onboarding_selected_prefix"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingBottom="?attr/larus_dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="?attr/larus_dp_12"
            android:textFontWeight="500"/>
        <FrameLayout
            android:id="@+id/dora_onboarding_selected_suffix_container"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_48">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/dora_onboarding_selected_suffix_current"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:paddingVertical="?attr/larus_dp_12"
                android:textFontWeight="500"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/dora_onboarding_selected_suffix_next"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_12"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:paddingVertical="?attr/larus_dp_12"
                android:textFontWeight="500"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/dora_onboarding_selected_arrow"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_ic_arrow"
            android:layout_marginStart="?attr/larus_dp_8"
            app:tint="?attr/larus_neutral_100"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
