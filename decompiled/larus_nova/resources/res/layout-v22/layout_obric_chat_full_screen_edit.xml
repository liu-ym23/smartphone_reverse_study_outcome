<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fullscreen"
    android:background="@color/larus_static_black_transparent_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/fullscreen_container"
            android:background="?attr/larus_bg_top_round_base_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/ic_input_fold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ic_input_fold_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_24"
                    android:layout_marginRight="?attr/larus_dp_20"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginHorizontal="?attr/larus_dp_20"
                    app:srcCompat="?attr/larus_ic_input_fold"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/edit_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/voice_input_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ic_input_fold">
                <ScrollView
                    android:id="@+id/edit_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_4">
                    <EditText
                        android:textSize="?attr/larus_dp_17"
                        android:gravity="start|top"
                        android:id="@+id/input_edit"
                        android:background="@null"
                        android:paddingBottom="?attr/larus_dp_90"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/larus_send_message"
                        android:lineSpacingMultiplier="1.25"
                        android:layout_marginEnd="?attr/larus_dp_20"
                        style="@style/larus_EditTextStyle"/>
                </ScrollView>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/voice_input_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_shadow"
            android:background="?attr/larus_bg_full_screen_edit_shadow"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            android:alpha="0"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/action_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_send"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_56"
                android:paddingStart="?attr/larus_dp_0"
                android:paddingEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_send"/>
            <com.lynx.lottieadapter.LottieAdapterView
                android:layout_gravity="center"
                android:id="@+id/action_voice_input"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_56"
                android:src="?attr/larus_ic_voice_mix_input"
                android:paddingStart="?attr/larus_dp_0"
                android:paddingEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/action_send"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.common_ui.view.TouchInterceptingView
            android:id="@+id/input_intercept_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
