<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="2000dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/debug_info_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="#afffaf"
            android:background="#662222"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="临时支持打开 hdt 开关，其他功能已失效"/>
        <View
            android:background="@color/ttlive_std_line_black_1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_std_text_black_1"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/ttlive_hybrid_dev_page"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_std_text_black_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_hybrid_schema"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_3"
            android:id="@+id/current_schema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="false"
            android:textIsSelectable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <View
            android:background="@color/ttlive_std_line_black_1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_std_text_black_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_hybrid_url"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_3"
            android:id="@+id/current_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="false"
            android:textIsSelectable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_std_text_black_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_hybrid_param_info"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:id="@+id/params_tv"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:maxLines="5"
            android:textIsSelectable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            style="@style/ttlive_hybrid_tool_common_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_std_text_black_2"
                android:id="@+id/schema_test_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:text="@string/ttlive_hybrid_erro_check_info"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_red"
                android:id="@+id/schema_param_normal_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/invalid_param_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_red"
                    android:id="@+id/schema_param_error_key_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/ttlive_param_error"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_red"
                    android:id="@+id/schema_param_error_info_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_red"
                android:id="@+id/page_load_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_red"
                android:id="@+id/page_auth_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp">
            <TextView
                android:text="@string/ttlive_offline"
                style="@style/ttlive_hybrid_tool_common_title"/>
            <TextView
                android:id="@+id/tv_offline"
                android:textIsSelectable="true"
                style="@style/ttlive_hybrid_tool_common_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp">
            <TextView
                android:text="@string/ttlive_offline_version"
                style="@style/ttlive_hybrid_tool_common_title"/>
            <TextView
                android:id="@+id/tv_offline_version"
                android:textIsSelectable="true"
                style="@style/ttlive_hybrid_tool_common_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lynx_taro_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp">
            <TextView
                android:text="@string/ttlive_lynx_taro_source"
                style="@style/ttlive_hybrid_tool_common_title"/>
            <TextView
                android:id="@+id/taro_status_tv"
                android:textIsSelectable="true"
                style="@style/ttlive_hybrid_tool_common_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lynx_sdk_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp">
            <TextView
                android:text="@string/ttlive_lynx_sdk_version"
                style="@style/ttlive_hybrid_tool_common_title"/>
            <TextView
                android:id="@+id/lynx_version_tv"
                android:textIsSelectable="true"
                style="@style/ttlive_hybrid_tool_common_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/debug_console"
            android:layout_width="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:text="@string/ttlive_jsb_callback_info"
            android:drawableRight="@drawable/ttlive_ic_right_arrow"
            android:drawableEnd="@drawable/ttlive_ic_right_arrow"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:drawableTint="#a9a9a9"
            style="@style/ttlive_hybrid_tool_common_title"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/geckox_debug"
            android:layout_width="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:text="@string/ttlive_geckox_debug"
            android:drawableRight="@drawable/ttlive_ic_right_arrow"
            android:drawableEnd="@drawable/ttlive_ic_right_arrow"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            android:drawableTint="#a9a9a9"
            style="@style/ttlive_hybrid_tool_common_title"/>
        <TextView
            android:id="@+id/offline_info"
            android:layout_width="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:text="@string/ttlive_offline_info"
            android:drawableRight="@drawable/ttlive_ic_right_arrow"
            android:drawableEnd="@drawable/ttlive_ic_right_arrow"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            android:drawableTint="#a9a9a9"
            style="@style/ttlive_hybrid_tool_common_title"/>
        <TextView
            android:id="@+id/lynx_log"
            android:layout_width="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:text="@string/ttlive_log_info"
            android:drawableRight="@drawable/ttlive_ic_right_arrow"
            android:drawableEnd="@drawable/ttlive_ic_right_arrow"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            android:drawableTint="#a9a9a9"
            style="@style/ttlive_hybrid_tool_common_title"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:id="@+id/lynx_setting_tv"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_lynx_setting"
            android:maxLines="5"
            android:textIsSelectable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            style="@style/ttlive_hybrid_tool_common_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/live_lynx_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginEnd="10dp">
                <RelativeLayout
                    android:id="@+id/lynx_test_enable_rl"
                    android:layout_marginTop="10dp"
                    style="@style/ttlive_hybrid_tool_common_container">
                    <TextView
                        android:id="@+id/fallback_hint"
                        android:text="@string/ttlive_lynx_test_enable"
                        style="@style/ttlive_hybrid_tool_common_title"/>
                    <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
                        android:id="@+id/fallback_switch"
                        style="@style/ttlive_hybrid_tool_common_switch"/>
                </RelativeLayout>
                <RelativeLayout style="@style/ttlive_hybrid_tool_common_container">
                    <TextView
                        android:text="@string/ttlive_lynx_offline_enable"
                        style="@style/ttlive_hybrid_tool_common_title"/>
                    <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
                        android:id="@+id/lynx_offline_switch"
                        style="@style/ttlive_hybrid_tool_common_switch"/>
                </RelativeLayout>
                <RelativeLayout style="@style/ttlive_hybrid_tool_common_container">
                    <TextView
                        android:text="@string/ttlive_dev_tool_enable"
                        style="@style/ttlive_hybrid_tool_common_title"/>
                    <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
                        android:id="@+id/lynx_devtool_switch"
                        style="@style/ttlive_hybrid_tool_common_switch"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout style="@style/ttlive_hybrid_tool_common_container">
                <TextView
                    android:text="@string/ttlive_lynx_force_fallback"
                    style="@style/ttlive_hybrid_tool_common_title"/>
                <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
                    android:id="@+id/lynx_fallback_force"
                    style="@style/ttlive_hybrid_tool_common_switch"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:id="@+id/offline_setting_tv"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_offline_setting"
            android:maxLines="5"
            android:textIsSelectable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            style="@style/ttlive_hybrid_tool_common_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <FrameLayout
                    android:orientation="horizontal"
                    android:id="@+id/fr_update_resource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center_vertical"
                        android:text="@string/ttlive_update_offline_package"
                        style="@style/ttlive_hybrid_tool_common_title"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/iv_update_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ttlive_ic_below_arrow_white"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_update_resource"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:gravity="center_vertical"
                        android:id="@+id/update_resource"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/ttlive_geckox_start_update"
                        style="@style/ttlive_hybrid_tool_common_title"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_scr_update_resource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:text="@string/ttlive_geckox_web_offline"
                    style="@style/ttlive_hybrid_tool_common_title"/>
                <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
                    android:id="@+id/web_offline_switch"
                    style="@style/ttlive_hybrid_tool_common_switch"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
