<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/privacy_icon"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_104"
        android:src="@drawable/obric_privacy_doubao_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/obric_guide_text_1"
        android:id="@+id/privacy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/obric_privacy_permissions"
        android:fontFamily="sans-serif"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_icon"/>
    <FrameLayout
        android:id="@+id/privacy_scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/tv_privacy_policy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_title">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/privacy_content_scroll"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/wifi_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_defaultCustomEnd="end_checkbox"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_title="@string/obric_enable_wifi_ex"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/privacy_intro_card"
                    android:background="@drawable/obric_bg_privacy_card"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_16">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/obric_basic_text_1"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/obric_privacy_intro"
                        android:fontFamily="sans-serif"
                        android:lineHeight="21sp"
                        android:textFontWeight="400"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:background="@drawable/obric_ic_privacy_mic"
                            android:padding="@dimen/dp_6"
                            android:layout_width="?attr/larus_dp_28"
                            android:layout_height="?attr/larus_dp_28"
                            android:src="@drawable/obric_ic_microphone_white"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:paddingTop="10.5dp"
                            android:paddingBottom="10.5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="?attr/larus_dp_10">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/obric_basic_text_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/obric_privacy_record_permission"
                                android:fontFamily="sans-serif"
                                android:lineHeight="21sp"
                                android:textFontWeight="400"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/obric_guide_text_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="?attr/larus_dp_2"
                                android:text="@string/obric_privacy_record_permission_desc"
                                android:fontFamily="sans-serif"
                                android:textFontWeight="400"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/privacy_other_card"
                    android:background="@drawable/obric_bg_privacy_card"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_12"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/obric_basic_text_1"
                            android:id="@+id/privacy_other_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/obric_privacy_other_permissions"
                            android:fontFamily="sans-serif"
                            android:lineHeight="21sp"
                            android:textFontWeight="400"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/privacy_other_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_8"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:enabled="false"
            android:layout_gravity="top"
            android:id="@+id/privacy_scroll_top_fade"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_75"
            android:alpha="0"
            android:importantForAccessibility="no"/>
        <View
            android:enabled="false"
            android:layout_gravity="bottom"
            android:id="@+id/privacy_scroll_bottom_fade"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_75"
            android:alpha="0"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="14sp"
        android:textColor="@color/obric_basic_text_1"
        android:gravity="center"
        android:id="@+id/tv_privacy_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_14"
        android:fontFamily="sans-serif"
        android:textFontWeight="400"
        app:larus_linkColor="@color/obric_link_1"
        app:larus_linkUnderLine="false"
        app:layout_constraintBottom_toTopOf="@+id/button_agree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_scroll_container"/>
    <com.obric.oui.button.OButton
        android:textColor="@color/larus_base_1"
        android:gravity="center"
        android:id="@+id/button_agree"
        android:background="@drawable/obric_bg_account_button_white"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/obric_allow"
        app:layout_constraintBottom_toTopOf="@+id/button_disagree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:oui_radius="@dimen/dp_16"
        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    <com.obric.oui.button.OButton
        android:textColor="@color/obric_guide_text_1"
        android:gravity="center"
        android:id="@+id/button_disagree"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_24"
        android:text="@string/obric_quit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:oui_radius="@dimen/dp_16"
        style="@style/OStyleV2.OButton.L.Trans.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
