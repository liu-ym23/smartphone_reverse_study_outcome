<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dux_relativelayout"
        android:background="@drawable/dux_bg_toast"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.dux.image.DuxImageView
                android:layout_gravity="center"
                android:id="@+id/iv_spinner"
                android:layout_width="40sp"
                android:layout_height="40sp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/ConstTextInverse"
                android:layout_gravity="center"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="72sp"
            android:text="正在保存"/>
    </LinearLayout>
    <com.bytedance.dux.image.DuxImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_btn"
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_s_s_xmark_outlined_12"
        android:layout_marginEnd="8dp"
        app:tint="@color/ConstTextInverse5"/>
</FrameLayout>
