<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_brand_qualification_dialog_661845381"
    android:background="@drawable/commerce_order_show_off_panel_bg"
    android:layout_width="match_parent"
    android:layout_height="570dp">
    <FrameLayout
        android:id="@+id/anchor_v3_fl_brand_qualification_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/commerce_color_161823"
            android:layout_gravity="center"
            android:id="@+id/anchor_v3_tv_brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="bottom"
            android:background="@color/shopping_std_line_black_2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/anchor_v3_rv_qualification_pics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/anchor_v3_fl_btn"
        app:layout_constraintTop_toBottomOf="@+id/anchor_v3_fl_brand_qualification_title"/>
    <FrameLayout
        android:id="@+id/anchor_v3_fl_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="15dp"
            android:textColor="@color/ConstTextInverse"
            android:id="@+id/anchor_v3_btn_brand_qualification_complete"
            android:background="@drawable/commerce_law_hint_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="完成"
            android:layout_marginHorizontal="16dp"
            style="?android:attr/borderlessButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
