<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/story_picture_blue_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/story_picture_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/story_pause_btn"
        android:padding="14dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerInside"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/aos_s1"
        android:ellipsize="end"
        android:id="@+id/story_picture_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:maxLines="2"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="12dp"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/story_picture_bottom_info_lt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/aos_s1"
            android:id="@+id/story_picture_info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </RelativeLayout>
</RelativeLayout>
