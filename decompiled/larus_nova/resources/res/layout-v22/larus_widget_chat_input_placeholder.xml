<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_input_placeholder_container"
        android:background="@drawable/larus_chat_common_shadow_bg"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/larus_chat_input_placeholder_area"
            android:background="?attr/larus_bg_input_normal"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/larus_chat_input_placeholder_center_anchor"
                android:visibility="invisible"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.common_ui.view.ChatInputInnerView
                android:id="@+id/larus_chat_input_placeholder_speak_area"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56"
                android:minHeight="?attr/larus_dp_56"
                android:paddingStart="?attr/larus_dp_100"
                android:paddingEnd="?attr/larus_dp_100"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/larus_chat_input_placeholder_action_entrance"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="@+id/larus_chat_input_placeholder_center_anchor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/larus_chat_input_placeholder_center_anchor">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"
                    app:srcCompat="?attr/larus_icon_chat_action_camera"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/larus_chat_input_placeholder_text"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/larus_chat_input_placeholder_center_anchor"
                app:layout_constraintEnd_toStartOf="@+id/larus_chat_input_placeholder_action_area"
                app:layout_constraintStart_toEndOf="@+id/larus_chat_input_placeholder_action_entrance"
                app:layout_constraintTop_toTopOf="@+id/larus_chat_input_placeholder_center_anchor"
                style="@style/larus_WidgetInputTextStyle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/larus_chat_input_placeholder_action_area"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="@+id/larus_chat_input_placeholder_center_anchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/larus_chat_input_placeholder_center_anchor">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/larus_chat_input_placeholder_mic"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:srcCompat="?attr/larus_ic_mic"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/larus_chat_input_placeholder_keyboard"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:srcCompat="?attr/larus_ic_keyboard"/>
                <FrameLayout
                    android:id="@+id/larus_chat_input_placeholder_menu"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="?attr/larus_dp_32"
                        android:layout_height="?attr/larus_dp_56"
                        app:srcCompat="?attr/larus_icon_chat_bottom_menu"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
