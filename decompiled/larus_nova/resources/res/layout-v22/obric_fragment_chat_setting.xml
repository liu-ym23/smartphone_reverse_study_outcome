<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/group_obric_settings"
        android:background="@drawable/larus_bg_bot_setting_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8">
        <com.obric.assistant.common.ui.item.ObricItemTextArrowSubTitle
            android:id="@+id/obric_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_setting"
            android:textFontWeight="500"
            app:larus_image_height="@dimen/dp_32"
            app:larus_image_src="@drawable/ic_obric_setting"
            app:larus_image_width="@dimen/dp_32"
            app:obric_sub_text="@string/obric_setting_hint"/>
        <com.larus.bmhome.view.item.ItemTextView
            android:textSize="?attr/larus_sp_16"
            android:id="@+id/obric_set_default_assistant"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textFontWeight="500"/>
    </com.larus.bmhome.view.item.ItemGroup>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/group_model_settings"
        android:background="@drawable/larus_bg_bot_setting_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8">
        <com.larus.bmhome.view.item.ItemTextArrow
            android:id="@+id/item_model_settings"
            android:background="@drawable/larus_bg_item_selector_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_assist_model_settings"
            android:textFontWeight="500"
            app:larus_image_height="@dimen/dp_32"
            app:larus_image_src="@drawable/ic_obric_model_setting"
            app:larus_image_width="@dimen/dp_32"
            app:larus_long_sub_text="true"
            app:larus_sub_text="稳定版"/>
    </com.larus.bmhome.view.item.ItemGroup>
</LinearLayout>
