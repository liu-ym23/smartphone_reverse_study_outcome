<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/rank_num"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/round_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/round_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_radius="20dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white_90"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_nickname"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/diamond_amount"
        app:layout_constraintStart_toEndOf="@+id/round_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white_90"
        android:id="@+id/diamond_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
