<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/account_tips_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/douyin_icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_28"
        android:src="@drawable/larus_ic_tt"
        android:importantForAccessibility="no"
        android:layout_marginStart="?attr/larus_dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/larus_auth_douyin_title_cn"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_9"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/douyin_icon"
        app:layout_constraintEnd_toStartOf="@+id/close_icon"
        app:layout_constraintStart_toEndOf="@+id/douyin_icon"
        app:layout_constraintTop_toTopOf="@+id/douyin_icon"/>
    <ImageView
        android:id="@+id/close_icon"
        android:padding="?attr/larus_dp_7"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_10"
        android:src="@drawable/larus_binder_close_icon"
        android:contentDescription="@string/larus_accessibility_icon_close"
        android:layout_marginEnd="?attr/larus_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_auth_douyin_subtitle_cn"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:lineHeight="?attr/larus_dp_24"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/douyin_icon"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/privacy_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_auth_douyin_description_cn"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        android:lineHeight="?attr/larus_dp_21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/action_container"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_28"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_description">
        <Button
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/reject_button"
            android:background="@drawable/larus_bg_douyin_conversation_auth_secondary_button"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/larus_auth_douyin_reject_cn"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="?attr/larus_dp_6"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textFontWeight="600"/>
        <Button
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/allow_button"
            android:background="@drawable/larus_bg_douyin_conversation_auth_primary_button"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/larus_auth_douyin_confirm_cn"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textFontWeight="600"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
