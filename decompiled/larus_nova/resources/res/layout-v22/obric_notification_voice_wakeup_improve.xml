<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/obric_notification_voice_wakeup_improve_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/obric_notification_voice_wakeup_improve_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/obric_notification_voice_wakeup_improve_icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="1dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="#e6000000"
                    android:id="@+id/obric_notification_voice_wakeup_improve_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textFontWeight="500"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#73000000"
                    android:gravity="end"
                    android:id="@+id/obric_notification_voice_wakeup_improve_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="#b3000000"
                android:id="@+id/obric_notification_voice_wakeup_improve_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
