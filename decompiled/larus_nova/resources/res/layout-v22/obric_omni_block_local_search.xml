<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginRight="@dimen/dp_16"
    android:layout_marginHorizontal="@dimen/dp_16">
    <com.larus.common_ui.widget.roundlayout.RoundRelativeLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/base_3"
        app:rv_cornerRadius="@dimen/dp_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_34"
            android:layout_alignParentTop="true"
            android:paddingEnd="?attr/larus_dp_10"
            android:layout_alignParentStart="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="start|top"
                android:id="@+id/icon"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginStart="?attr/larus_dp_8"
                app:actualImageScaleType="fitCenter"/>
            <Space
                android:layout_width="@dimen/dp_4"
                android:layout_height="match_parent"/>
            <TextSwitcher
                android:id="@+id/search_reference_switcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_7"
                android:layout_marginBottom="?attr/larus_dp_7"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/neutral_70"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_7"
                android:layout_marginBottom="?attr/larus_dp_7"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="500"/>
            <com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/askUserContainer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="?attr/larus_primary_50"
                        android:ellipsize="end"
                        android:id="@+id/tvAskUserText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginBottom="@dimen/dp_8"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="500"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/rightIcon"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/rightIcon"
                        android:background="@drawable/obric_omni_ic_operate_phone_arrow"
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/tvAskUserText"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout>
            <com.larus.bmhome.chat.layout.widget.MessageLoading
                android:orientation="horizontal"
                android:id="@+id/message_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_7"
                android:layout_marginBottom="?attr/larus_dp_7"
                android:color="@color/larus_neutral_100"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/arrow"
                android:background="@drawable/obric_icon_bold_gray_right_arrow"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_15"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/dropdown_layout"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title_layout">
            <View
                android:id="@+id/divider"
                android:background="@color/larus_neutral_transparent_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/neutral_70"
                android:id="@+id/tv_queries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_below="@+id/tv_queries"/>
        </RelativeLayout>
    </com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
</RelativeLayout>
