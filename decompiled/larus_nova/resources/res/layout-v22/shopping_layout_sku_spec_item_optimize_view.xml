<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_spec_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_switch_mode_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_big_pic_container"
            android:background="@drawable/shopping_sku_spec_unselect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sdv_big_pic_spec_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="1dp"
                android:scaleType="centerCrop"
                android:layout_marginHorizontal="1dp"
                app:failureImage="@drawable/shopping_sku_spec_big_pic_error"
                app:failureImageScaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/shopping_sku_spec_big_pic_error"
                app:roundBottomLeft="false"
                app:roundBottomRight="false"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/tv_big_pic_spec_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sdv_big_pic_spec_pic"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/iv_big_pic_gallery"
            android:background="@drawable/shopping_sku_big_pic_gallery_bg"
            android:padding="4dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/shopping_sku_big_pic_gallery"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="@+id/cl_big_pic_container"
            app:layout_constraintTop_toTopOf="@+id/cl_big_pic_container"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_small_pic_container"
            android:background="@drawable/shopping_sku_spec_unselect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sdv_small_pic_spec_pic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="1dp"
                app:failureImage="@drawable/shopping_sku_spec_big_pic_error"
                app:failureImageScaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/shopping_sku_spec_big_pic_error"
                app:roundedCornerRadius="5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_small_pic_spec_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_small_pic_price"
                app:layout_constraintStart_toEndOf="@+id/sdv_small_pic_spec_pic"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="#99161823"
                android:gravity="center_vertical"
                android:id="@+id/tv_small_pic_price"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_small_pic_spec_name"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <android.widget.Space
        android:id="@+id/space"
        android:layout_width="4dp"
        android:layout_height="6dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_switch_mode_container"
        app:layout_constraintStart_toEndOf="@+id/cl_switch_mode_container"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_sku_status"
        android:background="@drawable/shopping_sku_spec_no_stock"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:text="@string/shopping_sku_optimize_spec_no_stock"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/space"
        app:layout_constraintTop_toTopOf="@+id/space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
