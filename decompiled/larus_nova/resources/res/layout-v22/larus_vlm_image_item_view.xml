<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_300"
    android:layout_height="?attr/larus_dp_300">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/mainImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_static_white"
        android:id="@+id/moreImageSize"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingRight="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:lineSpacingMultiplier="1.2"
        android:paddingStart="8dp"
        android:paddingEnd="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_9"
        android:paddingHorizontal="?attr/larus_dp_8"
        android:paddingVertical="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rv_backgroundColor="@color/larus_static_black_transparent_1"
        app:rv_cornerRadius="?attr/larus_dp_7"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sourceView"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/videoIcon"
        android:background="@drawable/larus_md_video_group_play_ic"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_static_white"
        android:ellipsize="end"
        android:id="@+id/videoCaptionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_10"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
