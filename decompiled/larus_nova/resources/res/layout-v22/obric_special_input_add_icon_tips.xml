<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/obric_add_icon_tips_bar"
    android:background="@drawable/bg_obric_add_icon_tips"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_38">
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:id="@+id/obric_add_icon_tips_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/obric_add_task_manager_icon_to_screen"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_add_icon_tips_add"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.text.OTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/primary_50"
        android:id="@+id/obric_add_icon_tips_add"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/obric_add_now"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_add_icon_tips_close"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="4dp"/>
    <com.obric.oui.text.OTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/neutral_100"
        android:id="@+id/obric_add_icon_tips_close"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/obric_ignore_add_icon"
        android:layout_marginEnd="?attr/larus_dp_4"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="4dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
