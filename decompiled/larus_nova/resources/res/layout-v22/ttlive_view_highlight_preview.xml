<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_container"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextureView
            android:layout_gravity="center_vertical"
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/video_player_btn"
            android:background="@drawable/ttlive_ic_record_preview_player_btn"
            android:layout_width="35dp"
            android:layout_height="48dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/video_time_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:layout_gravity="right"
            android:id="@+id/video_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:shadowColor="#33000000"
            android:shadowRadius="1"/>
        <SeekBar
            android:id="@+id/seek_bar"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:max="100"
            android:thumb="@drawable/ttlive_bg_highlight_thumb"
            android:thumbOffset="0dp"
            android:progressTint="#33000000"
            android:progressBackgroundTint="#88ffffff"
            android:paddingHorizontal="0dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/desc_container"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:layout_alignBottom="@+id/video_time_layout">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/preview_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/preview_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</RelativeLayout>
