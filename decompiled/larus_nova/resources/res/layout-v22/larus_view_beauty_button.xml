<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:paddingTop="?attr/larus_dp_10"
    android:paddingBottom="?attr/larus_dp_10"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <FrameLayout
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_6">
        <ImageView
            android:id="@+id/beauty_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_static_white"
        android:id="@+id/beauty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textFontWeight="500"/>
</merge>
