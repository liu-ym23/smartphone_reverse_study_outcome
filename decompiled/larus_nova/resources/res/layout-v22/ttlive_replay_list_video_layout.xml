<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp">
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/ttlive_replay_list_video_item_cover"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_replay_camera_place_holder"
        app:placeholderImageScaleType="fitXY"
        app:ttlive_radius="8dp"/>
    <FrameLayout
        android:id="@+id/ttlive_replay_list_video_item_playing_container"
        android:background="@drawable/ttlive_replay_list_item_playing"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_replay_list_video_item_cover"
        app:layout_constraintLeft_toLeftOf="@+id/ttlive_replay_list_video_item_cover"
        app:layout_constraintRight_toRightOf="@+id/ttlive_replay_list_video_item_cover"
        app:layout_constraintTop_toTopOf="@+id/ttlive_replay_list_video_item_cover">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/ttlive_replay_list_video_item_playing"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:scaleType="centerCrop"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"/>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_replay_video_list_label_text_normal"
        android:gravity="center"
        android:id="@+id/ttlive_replay_list_video_item_label"
        android:background="@drawable/ttlive_bg_replay_video_list_label"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:textAlignment="center"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="@+id/ttlive_replay_list_video_item_cover"
        app:layout_constraintTop_toTopOf="@+id/ttlive_replay_list_video_item_cover"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ttlive_replay_list_video_item_cover"
        app:layout_constraintRight_toLeftOf="@+id/ttlive_replay_list_action_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="0dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_replay_text_color"
            android:ellipsize="end"
            android:id="@+id/ttlive_replay_list_video_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_replay_text_unselected_color"
            android:id="@+id/ttlive_replay_list_video_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="5dp"
            android:maxLines="2"
            android:layout_alignParentBottom="true"
            android:textFontWeight="400"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/ttlive_replay_list_action_button"
        android:background="@drawable/ttlive_bg_replay_paid_buy_button"
        android:visibility="gone"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
