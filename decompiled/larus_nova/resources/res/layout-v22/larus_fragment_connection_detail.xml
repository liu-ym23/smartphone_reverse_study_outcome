<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_mode_bottom_sheet"
    android:paddingBottom="?attr/larus_dp_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_52"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/larus_layout_bottom_sheet_header"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/tv_pc_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_dispatch_current_computer_cn"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/cl_pc_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_pc_title"
        app:rv_backgroundColor="?attr/larus_base_2"
        app:rv_backgroundPressColor="?attr/larus_base_2"
        app:rv_cornerRadius="?attr/larus_dp_16">
        <include
            android:id="@+id/include_pc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/larus_item_task_common_ui"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/tv_folder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_dispatch_current_project_cn"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_pc_card"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/cl_folder_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_folder_title"
        app:rv_backgroundColor="?attr/larus_base_2"
        app:rv_backgroundPressColor="?attr/larus_base_2"
        app:rv_cornerRadius="?attr/larus_dp_16">
        <include
            android:id="@+id/include_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/larus_item_task_common_ui"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/btn_copy"
        android:background="@drawable/larus_shape_connection_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_26"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_local_agent_copy_path_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
