<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dora_onboarding_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_48">
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dora_onboarding_item_text"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingVertical="?attr/larus_dp_12"
        android:textFontWeight="500"/>
</FrameLayout>
