<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rl_radius_left_top="@dimen/ud_radius_l"
    app:rl_radius_right_top="@dimen/ud_radius_l">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_constraint_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.ui.CommonTitleBar
                android:id="@+id/titlebar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_title_bar_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tb_back_icon="@drawable/ud_icon_close_small_outlined"/>
            <TextView
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cta_title_bar_horizontal_margin"
                android:layout_marginRight="@dimen/cta_title_bar_horizontal_margin"
                android:maxLines="2"
                android:layout_marginHorizontal="@dimen/cta_title_bar_horizontal_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titlebar"/>
            <TextView
                android:textSize="@dimen/subtitle_text_size"
                android:textColor="@color/text_caption"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/subtitle_horizontal_margin"
                android:layout_marginTop="@dimen/subtitle_top_margin"
                android:layout_marginRight="@dimen/subtitle_horizontal_margin"
                android:maxLines="3"
                android:lineSpacingExtra="@dimen/subtitle_spacing_extra"
                android:layout_marginHorizontal="@dimen/subtitle_horizontal_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/benefit_list"
                android:paddingLeft="@dimen/benefit_list_horizontal_padding"
                android:paddingTop="@dimen/benefit_list_vertical_padding"
                android:paddingRight="@dimen/benefit_list_horizontal_padding"
                android:paddingBottom="@dimen/benefit_list_vertical_padding"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/benefit_list_horizontal_margin"
                android:layout_marginTop="@dimen/benefit_list_top_margin"
                android:layout_marginRight="@dimen/benefit_list_horizontal_margin"
                android:layout_marginHorizontal="@dimen/benefit_list_horizontal_margin"
                android:paddingHorizontal="@dimen/benefit_list_horizontal_padding"
                android:paddingVertical="@dimen/benefit_list_vertical_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
            <com.larksuite.component.ui.layout.LKUIRoundableLayout
                android:id="@+id/version_info_wrapper"
                android:background="@color/bg_base"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/version_info_horizontal_margin"
                android:layout_marginTop="@dimen/version_info_top_margin"
                android:layout_marginRight="@dimen/version_info_horizontal_margin"
                android:layout_marginHorizontal="@dimen/version_info_horizontal_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/benefit_list"
                app:rl_radius="@dimen/version_info_wrapper_radius">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/version_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larksuite.component.ui.layout.LKUIRoundableLayout>
            <ImageView
                android:id="@+id/cta_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cta_image_top_margin"
                android:layout_marginBottom="@dimen/cta_image_bottom_margin"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
            <com.suite.lark.platform.component.cta.newstyle.widgets.CustomButtonGroup
                android:orientation="horizontal"
                android:id="@+id/button_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/button_list_horizontal_margin"
                android:layout_marginTop="@dimen/button_list_top_margin"
                android:layout_marginRight="@dimen/button_list_horizontal_margin"
                android:layout_marginBottom="@dimen/button_list_bottom_margin"
                android:layout_marginHorizontal="@dimen/button_list_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
