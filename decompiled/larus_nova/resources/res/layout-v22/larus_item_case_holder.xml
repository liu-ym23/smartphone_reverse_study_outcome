<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_80">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/inner_container"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_100"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:background="@drawable/larus_bg_loading_skeleton_rounded_rectangle"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_20"
                android:layout_marginEnd="?attr/larus_dp_238"/>
            <View
                android:background="@drawable/larus_bg_loading_skeleton_rounded_rectangle"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_46"/>
            <View
                android:background="@drawable/larus_bg_loading_skeleton_rounded_rectangle"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_68"/>
        </FrameLayout>
        <View
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inner_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/real_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/img_cover_container"
            android:background="@drawable/larus_icon_case_bg"
            android:layout_width="?attr/larus_dp_56"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginStart="?attr/larus_dp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/img_cover"
                android:layout_width="?attr/larus_dp_28"
                android:layout_height="?attr/larus_dp_28"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/larus_neutral_transparent_1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover_container"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
