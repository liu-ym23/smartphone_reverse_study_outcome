<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginRight="?attr/larus_dp_16"
    android:elevation="?attr/larus_dp_2"
    android:layout_marginHorizontal="?attr/larus_dp_16"
    android:paddingHorizontal="?attr/larus_dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_device_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="?attr/larus_dp_312"
        app:layout_constraintEnd_toStartOf="@+id/iv_device_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_20"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_296"
            android:text="我的眼镜"
            android:maxLines="1"
            android:textFontWeight="500"/>
        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="?attr/larus_dp_12"
            android:layout_height="?attr/larus_dp_12"
            android:src="@drawable/larus_dora_g_device_management_dropdown"
            android:layout_marginStart="?attr/larus_dp_4"
            app:tint="@color/larus_neutral_100"/>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/tv_device_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:text="@string/larus_dora_g_device_disconnect_cn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_device_selector"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_reconnect_button"
        android:background="@drawable/larus_dora_g_device_management_reconnect_button_bg"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_20"
        android:paddingBottom="?attr/larus_dp_8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_21"
        android:paddingHorizontal="?attr/larus_dp_20"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_status">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_connect_device_balloon_connect"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_connecting_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_21"
        android:layout_marginTop="?attr/larus_dp_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_device_selector">
        <ImageView
            android:id="@+id/iv_connecting_icon"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_3_5"
            android:layout_marginBottom="?attr/larus_dp_3_5"
            android:src="@null"
            android:layout_marginStart="?attr/larus_dp_3"
            android:layout_marginEnd="?attr/larus_dp_4"
            android:layout_marginVertical="?attr/larus_dp_3_5"
            app:tint="@color/larus_neutral_50"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_30"
            android:id="@+id/tv_connecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_device_disconnected_btn_retrying_cn"
            android:textFontWeight="500"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_device_mode_tag"
        android:background="@drawable/larus_dora_g_device_management_mode_tag_bg"
        android:paddingLeft="?attr/larus_dp_6"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingRight="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:paddingHorizontal="?attr/larus_dp_6"
        android:paddingVertical="?attr/larus_dp_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_device_selector">
        <View
            android:id="@+id/v_mode_dot"
            android:background="@drawable/larus_dora_g_device_management_dot_white"
            android:layout_width="?attr/larus_dp_6"
            android:layout_height="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/tv_mode_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_gesture_headphone_mode_cn"
            android:textFontWeight="500"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_battery_info"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_86"
        android:layout_marginBottom="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_device_image"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_glasses_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/larus_neutral_100"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_glasses_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:layout_marginStart="?attr/larus_dp_4"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/iv_glasses_icon"
            app:layout_constraintStart_toEndOf="@+id/iv_glasses_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_glasses_icon"/>
        <ProgressBar
            android:id="@+id/pb_glasses_battery"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_4"
            android:progress="50"
            android:progressDrawable="@drawable/larus_dora_g_device_management_progress_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_glasses_icon"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/iv_charging_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_12"
            android:layout_height="?attr/larus_dp_12"
            android:elevation="?attr/larus_dp_1"
            app:layout_constraintBottom_toBottomOf="@+id/pb_glasses_battery"
            app:layout_constraintEnd_toEndOf="@+id/pb_glasses_battery"
            app:layout_constraintStart_toStartOf="@+id/pb_glasses_battery"
            app:layout_constraintTop_toTopOf="@+id/pb_glasses_battery"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_case_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/iv_case_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_dora_g_device_management_box"
            android:layout_marginStart="?attr/larus_dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/iv_glasses_icon"
            app:layout_constraintStart_toEndOf="@+id/pb_glasses_battery"
            app:layout_constraintTop_toTopOf="@+id/iv_glasses_icon"
            app:tint="@color/larus_neutral_100"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_case_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18%"
            android:layout_marginStart="?attr/larus_dp_4"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/iv_case_icon"
            app:layout_constraintStart_toEndOf="@+id/iv_case_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_case_icon"/>
        <ProgressBar
            android:id="@+id/pb_case_battery"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_4"
            android:progress="18"
            android:progressDrawable="@drawable/larus_dora_g_device_management_progress_red"
            app:layout_constraintStart_toStartOf="@+id/iv_case_icon"
            app:layout_constraintTop_toBottomOf="@+id/iv_case_icon"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/iv_case_charging_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_12"
            android:layout_height="?attr/larus_dp_12"
            android:elevation="?attr/larus_dp_1"
            app:layout_constraintBottom_toBottomOf="@+id/pb_case_battery"
            app:layout_constraintEnd_toEndOf="@+id/pb_case_battery"
            app:layout_constraintStart_toStartOf="@+id/pb_case_battery"
            app:layout_constraintTop_toTopOf="@+id/pb_case_battery"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_device_image"
        android:layout_width="?attr/larus_dp_136"
        android:layout_height="?attr/larus_dp_76"
        android:layout_marginTop="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:src="@null"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
