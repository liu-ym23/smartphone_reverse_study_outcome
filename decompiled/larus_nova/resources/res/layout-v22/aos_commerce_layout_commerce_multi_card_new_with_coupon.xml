<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@drawable/aos_new_product_card_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:fitsSystemWindows="true"
    android:layout_width="wrap_content"
    android:layout_height="144dp"
    android:paddingHorizontal="12dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_product_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/aos_white"
        android:ellipsize="end"
        android:id="@+id/tv_product_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="@+id/coupon_container"
        app:layout_constraintStart_toEndOf="@+id/iv_product_image"
        app:layout_constraintTop_toTopOf="@+id/iv_product_image"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/tv_product_tag_1"
        android:background="@drawable/aos_product_tag_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_product_image"
        app:layout_constraintStart_toStartOf="@+id/tv_product_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_title"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_product_tag_2"
        android:background="@drawable/aos_product_tag_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_product_tag_1"
        app:layout_constraintEnd_toEndOf="@+id/coupon_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_product_tag_1"
        app:layout_constraintTop_toTopOf="@+id/tv_product_tag_1"
        app:layout_constraintWidth_max="wrap"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/coupon_container"
        android:background="@drawable/aos_new_coupon_bg"
        android:layout_width="236dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_product_image">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/coupon_value_container"
            android:layout_width="72dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="26dp"
                android:textColor="@color/aos_custom_primary"
                android:id="@+id/tv_coupon_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/tv_coupon_desc"
                app:layout_constraintEnd_toStartOf="@+id/tv_coupon_unit"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="@color/aos_custom_primary"
                android:id="@+id/tv_coupon_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="元"
                android:layout_marginStart="1dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_coupon_amount"
                app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_amount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_coupon_amount"/>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="10dp"
                android:textColor="@color/aos_custom_primary"
                android:id="@+id/tv_coupon_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_coupon_amount"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/iv_coupon_divider"
            android:background="@drawable/aos_ic_coupon_divider"
            android:layout_width="1dp"
            android:layout_height="52dp"
            android:translationX="-0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coupon_value_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/coupon_details_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_coupon_divider"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#ff161823"
                android:id="@+id/tv_coupon_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/countdown_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_coupon_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_coupon_title"
                app:layout_constraintTop_toTopOf="@+id/tv_coupon_title">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/countdown_timer"
                    android:layout_width="60dp"
                    android:layout_height="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <View
                        android:id="@+id/iv_hour_background"
                        android:background="@drawable/aos_count_down_bg"
                        android:layout_width="16dp"
                        android:layout_height="14dp"
                        android:alpha="0.6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0"/>
                    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/aos_custom_primary"
                        android:id="@+id/tv_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_hour_background"
                        app:layout_constraintEnd_toEndOf="@+id/iv_hour_background"
                        app:layout_constraintStart_toStartOf="@+id/iv_hour_background"
                        app:layout_constraintTop_toTopOf="@+id/iv_hour_background"/>
                    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/aos_custom_primary"
                        android:id="@+id/tv_separator_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_minute_background"
                        app:layout_constraintStart_toEndOf="@+id/iv_hour_background"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/iv_minute_background"
                        android:background="@drawable/aos_count_down_bg"
                        android:layout_width="16dp"
                        android:layout_height="14dp"
                        android:alpha="0.6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_separator_2"
                        app:layout_constraintStart_toEndOf="@+id/tv_separator_1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0"/>
                    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/aos_custom_primary"
                        android:id="@+id/tv_minute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_minute_background"
                        app:layout_constraintEnd_toEndOf="@+id/iv_minute_background"
                        app:layout_constraintStart_toStartOf="@+id/iv_minute_background"
                        app:layout_constraintTop_toTopOf="@+id/iv_minute_background"/>
                    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/aos_custom_primary"
                        android:id="@+id/tv_separator_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_second_background"
                        app:layout_constraintStart_toEndOf="@+id/iv_minute_background"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/iv_second_background"
                        android:background="@drawable/aos_count_down_bg"
                        android:layout_width="16dp"
                        android:layout_height="14dp"
                        android:alpha="0.6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_separator_2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0"/>
                    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/aos_custom_primary"
                        android:id="@+id/tv_second"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_second_background"
                        app:layout_constraintEnd_toEndOf="@+id/iv_second_background"
                        app:layout_constraintStart_toStartOf="@+id/iv_second_background"
                        app:layout_constraintTop_toTopOf="@+id/iv_second_background"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="10dp"
                    android:textColor="@color/aos_custom_primary"
                    android:id="@+id/tv_remain_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="10dp"
                android:textColor="#ff8a8b91"
                android:id="@+id/tv_countdown_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后过期"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/countdown_container"
                app:layout_constraintStart_toEndOf="@+id/countdown_container"
                app:layout_constraintTop_toTopOf="@+id/countdown_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="11dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_use_coupon"
            android:background="@drawable/aos_use_coupon_btn_bg"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="去使用"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.55"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
