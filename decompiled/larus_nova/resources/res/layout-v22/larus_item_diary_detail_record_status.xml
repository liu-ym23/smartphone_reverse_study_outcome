<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/diary_record_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_20"
    android:layout_marginTop="?attr/larus_dp_8"
    android:layout_marginRight="?attr/larus_dp_20"
    android:layout_marginHorizontal="?attr/larus_dp_20">
    <com.lynx.lottieadapter.LottieAdapterView
        android:layout_gravity="center_vertical"
        android:id="@+id/diary_recording_animation"
        android:layout_width="?attr/larus_dp_14"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/neutral_50"
        android:layout_gravity="center_vertical"
        android:id="@+id/diary_title_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_diary_tag_pausing_cn"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/larus_neutral_50"
        android:layout_gravity="center_vertical"
        android:id="@+id/diary_next_update_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_8"/>
</LinearLayout>
