<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/cj_pay_pwd_input_tip_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/cj_pay_padding_6"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="@dimen/cj_pay_padding_6"
        android:layout_marginVertical="@dimen/cj_pay_padding_6">
        <TextView
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_pwd_input_hint_text"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_input_pwd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cj_layout_password_input_error_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <TextView
                android:textSize="13sp"
                android:id="@+id/cj_pay_password_input_error_tip_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支付密码错误，"/>
            <TextView
                android:textSize="13sp"
                android:id="@+id/cj_pay_password_input_error_tip_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="刷脸支付"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_password_input_error_tip_right_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:src="@drawable/cj_pay_icon_right_arrow_blue"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_password_input_error_tip_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:layout_gravity="center"
        android:id="@+id/cj_pay_pwd_input_area"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        app:CJPayDotColor="@color/cj_std_ui_component_text_primary_color"
        app:CJPayDotRadius="6dp"
        app:CJPayIsShowCursor="true"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_std_ui_component_pwd_stroke"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"
        app:layout_goneMarginTop="24dp"/>
    <TextView
        android:textSize="13sp"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_forget_password_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/cj_pay_forget_password"/>
</LinearLayout>
