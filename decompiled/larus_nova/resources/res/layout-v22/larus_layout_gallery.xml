<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/cover_image"
        android:background="@color/larus_static_black"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/right_side_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/right_bottom_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/thumbnail_list"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.larus.gallery.tracker.GalleryThumbnailView
        android:id="@+id/thumbnail_list"
        android:paddingLeft="?attr/larus_dp_9"
        android:paddingTop="?attr/larus_dp_15"
        android:paddingRight="?attr/larus_dp_9"
        android:fadingEdgeLength="?attr/larus_dp_9"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_45"
        android:layout_marginBottom="?attr/larus_dp_84"
        android:requiresFadingEdge="horizontal"
        android:paddingHorizontal="?attr/larus_dp_9"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
