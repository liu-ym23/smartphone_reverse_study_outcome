<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/input_section_v3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_secret_chat_history_user"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="12dp">
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/user_avatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginLeft="3dp"
            android:layout_marginStart="3dp"
            app:placeholderImage="@drawable/my_live_default_avatar"
            app:roundAsCircle="true"
            app:ttlive_allRadius="20dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/user_name"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxWidth="100dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:defaultFocusHighlightEnabled="false"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.widget.MaxHeightRecyclerView
        android:id="@+id/history_secret_chat"
        android:visibility="gone"
        android:fadingEdgeLength="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:requiresFadingEdge="vertical"
        app:maxHeight="160dp"/>
</LinearLayout>
