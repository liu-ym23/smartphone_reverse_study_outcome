<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/input_shrink"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ai_smart_reply_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/input_outter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="8dp">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/placeHolder_view"
            android:background="@color/bg_body_overlay"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/input_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/switcher_plugin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:background="@drawable/larus_shadow"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/normal_message_et_layout"
                android:background="@drawable/kb_input_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/input_innerTop_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/input_innerTop_container_divider"
                    android:background="@color/line_divider_default"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp">
                    <FrameLayout
                        android:id="@+id/input_innerStart_container"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingVertical="12dp"/>
                    <FrameLayout
                        android:orientation="horizontal"
                        android:id="@+id/et_container_wrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/et_container"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingVertical="12dp">
                            <androidx.core.widget.NestedScrollView
                                android:id="@+id/kb_rich_text_content_wrapper"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="4dp"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.ss.android.lark.keyboard.edittext2.KeyboardFunctionEditText
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_title"
                                        android:textColorHint="@color/text_placeholder"
                                        android:gravity="left"
                                        android:id="@+id/kb_rich_text_title"
                                        android:background="@null"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:visibility="invisible"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="4dp"
                                        android:maxLines="2"
                                        android:maxLength="100"
                                        android:lineSpacingExtra="3sp"
                                        android:inputType="textMultiLine"
                                        android:textCursorDrawable="@drawable/text_cursor_drawable_ig"/>
                                    <include
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        layout="@layout/kb_richtext_shrink_editor_content2_assembler"/>
                                </LinearLayout>
                            </androidx.core.widget.NestedScrollView>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/status_transform_btn"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tint="@color/icon_n3"
                                app:srcCompat="@drawable/ic_transform_btn"/>
                        </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
                        <FrameLayout
                            android:id="@+id/touch_speak_view_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/input_innerEnd_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"/>
                    <FrameLayout
                        android:id="@+id/input_innerEndVertical_container"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingVertical="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/input_innerBottom_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
