<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/task_list_member_role_dialog_bg_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/task_list_member_role_container"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="13dp">
                <com.larksuite.component.ui.avatar.v2.LarkAvatarView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/member_role_avatar"
                    android:layout_width="40sp"
                    android:layout_height="40sp"
                    android:tint="@color/fill_img_mask"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="52sp"
                    android:layout_marginRight="32dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/member_role_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_placeholder"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/member_role_department"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
            </FrameLayout>
            <View
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_05"
                android:layout_marginStart="@dimen/dp_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/task_list_member_role_first_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/task_list_member_role_inherit_container"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="14dp"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="14dp">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_disable"
                        android:gravity="center_vertical"
                        android:id="@+id/task_list_member_role_inherit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/Todo_Doc_FollowDocsPermissions_Button"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/task_list_member_role_inherit_icon"
                        android:visibility="gone"
                        android:layout_width="24sp"
                        android:layout_height="24sp"
                        android:tint="@color/primary_fill_default"
                        app:srcCompat="@drawable/ud_icon_check_outlined"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/task_list_member_role_read_container"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="14dp"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="14dp">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_disable"
                        android:gravity="center_vertical"
                        android:id="@+id/task_list_member_role_read_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/Todo_ShareList_ManageCollaboratorsCanView_Text"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/task_list_member_role_read_icon"
                        android:visibility="gone"
                        android:layout_width="24sp"
                        android:layout_height="24sp"
                        android:tint="@color/primary_fill_default"
                        app:srcCompat="@drawable/ud_icon_check_outlined"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/task_list_member_role_edit_container"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="14dp"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="14dp">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_disable"
                        android:gravity="center_vertical"
                        android:id="@+id/task_list_member_role_edit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/Todo_ShareList_ManageCollaboratorsCanEdit_Text"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/task_list_member_role_edit_icon"
                        android:visibility="gone"
                        android:layout_width="24sp"
                        android:layout_height="24sp"
                        android:tint="@color/primary_fill_default"
                        app:srcCompat="@drawable/ud_icon_check_outlined"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_05"
                android:layout_marginStart="@dimen/dp_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/task_list_member_role_second_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/task_list_member_set_owner_container"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="14dp"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_disable"
                        android:gravity="center_vertical"
                        android:id="@+id/task_list_member_set_owner_txt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/Todo_ShareList_ManageCollaboratorsSetAsOwner_MenuItem"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/task_list_member_role_remove_container"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="14dp"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/function_danger_fill_default"
                        android:gravity="center_vertical"
                        android:id="@+id/task_list_member_role_remove_txt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/Todo_ShareList_ManageCollaboratorsRemove_MenuItem"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
