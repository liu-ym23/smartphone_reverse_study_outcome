<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.office.plugins.slides.media.widget.GenerateImageViewPagerContainer
        android:id="@+id/view_pager_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_20"
        app:layout_constraintBottom_toTopOf="@+id/indicator"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.larus.office.plugins.slides.media.imggen.IndefinitePagerIndicator
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:larus_office_dotColor="@color/larus_neutral_30"
        app:larus_office_dotCount="4"
        app:larus_office_dotRadius="?attr/larus_dp_4"
        app:larus_office_dotSeparation="?attr/larus_dp_6"
        app:larus_office_fadingDotCount="2"
        app:larus_office_selectedDotColor="@color/larus_neutral_100"
        app:larus_office_selectedDotRadius="?attr/larus_dp_4"
        app:layout_constraintBottom_toTopOf="@+id/confirm_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_slides_genImage_btn_select"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:paddingVertical="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
