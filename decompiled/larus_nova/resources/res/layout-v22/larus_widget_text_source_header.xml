<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/header_split_line"
        android:background="@drawable/larus_bg_text_source_header_split_line"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_reference_title_wrapper"/>
    <Space
        android:id="@+id/header_split_line_bottom_space"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_split_line"/>
    <com.larus.bmhome.chat.layout.widget.MaxHeightRelativeLayout
        android:orientation="vertical"
        android:id="@+id/subview_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_43"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/verticalLineOfDeepThink"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_split_line"
        android:background="?attr/larus_bg_line_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        android:layout_marginVertical="?attr/larus_dp_6"
        app:layout_constraintTop_toBottomOf="@+id/subview_container"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="?attr/larus_dp_35"/>
    <com.larus.bmhome.chat.layout.widget.ExpendAllThinkView
        android:id="@+id/expand_all_think_view"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/subview_container"/>
    <FrameLayout
        android:id="@+id/zoom_in_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/verticalLineOfDeepThink"
        app:layout_constraintTop_toTopOf="@+id/guideline"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_reference_title_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.bmhome.block.newheader.foldcontainer.ReferenceTitleBackgroundView
            android:id="@+id/ll_reference_title_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ll_reference_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_reference_title"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_reference_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/sdv_reference_icon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_4"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextSwitcher
                    android:id="@+id/tv_switcher_reference_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.larus.bmhome.chat.layout.widget.ShimmerTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="?attr/larus_neutral_70"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_reference_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_24"
                    android:maxLines="1"
                    android:maxEms="15"
                    android:includeFontPadding="false"/>
            </FrameLayout>
            <com.larus.common_ui.view.ActivityIndicatorView
                android:layout_gravity="center_vertical"
                android:id="@+id/aiv_lazy_load"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:layout_marginStart="?attr/larus_dp_6"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:larus_aiv_auto_start="false"
                app:larus_aiv_color="?attr/larus_neutral_70"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_arrow"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:layout_marginStart="?attr/larus_dp_2"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:srcCompat="@drawable/larus_ic_tool_header_arrow_right"/>
        </com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout>
        <View
            android:id="@+id/mask_reference_title"
            android:background="?attr/larus_bg_vertical_linear_gray_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_reference_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
