<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.venus.ShapeConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sheet_container"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="56dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        app:larus_sc_cornerPosition="topRight|topLeft"
        app:larus_sc_cornerRadius="20dp"
        app:larus_sc_fillColor="#f2f4f9"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:id="@+id/top_bar_icon"
            android:background="@drawable/guix_top_bar_half_bg"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center_vertical"
            android:id="@+id/speed_title"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/larus_tutor_voice_settings_voice_cn"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.common_ui.venus.ShapeConstraintLayout
            android:id="@+id/speed_container"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:larus_sc_cornerRadius="@dimen/dp_16"
            app:larus_sc_fillColor="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/speed_title">
            <TextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/live_tutor_pitch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_tutor_voice_settings_pitch_cn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <SeekBar
                android:id="@+id/live_tutor_pitch_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:max="12"
                android:progress="6"
                android:progressDrawable="?attr/larus_voice_general_progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/live_tutor_pitch_title"
                style="@style/larus_mix_seekbar_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/live_tutor_pitch_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/live_tutor_pitch_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_tutor_pitch_title"/>
            <TextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/live_tutor_rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/larus_tutor_speed_title_cn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/live_tutor_pitch_progress"/>
            <SeekBar
                android:id="@+id/live_tutor_rate_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:max="16"
                android:progress="6"
                android:progressDrawable="?attr/larus_voice_general_progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/live_tutor_rate_title"
                style="@style/larus_mix_seekbar_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/live_tutor_rate_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/live_tutor_rate_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_tutor_rate_title"/>
        </com.larus.common_ui.venus.ShapeConstraintLayout>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/larus_neutral_50_day"
            android:gravity="center_vertical"
            android:id="@+id/subtitle_title"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/larus_tutor_subtitle_title_cn"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/speed_container"/>
        <com.larus.bmhome.view.item.ItemTextToggle
            android:textColor="@color/black"
            android:id="@+id/subtitle_container"
            android:background="@drawable/live_tutor_settings_item_background"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/larus_tutor_subtitle_switch_cn"
            android:textFontWeight="500"
            app:layout_constraintTop_toBottomOf="@+id/subtitle_title"/>
    </com.larus.common_ui.venus.ShapeConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
