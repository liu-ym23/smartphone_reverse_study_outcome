<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/theme_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/drive_permission_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_slides_share_settings_linkAccess_switch"
            android:textFontWeight="500"
            app:larus_image_height="?attr/larus_dp_32"
            app:larus_image_src="@drawable/larus_icon_doubao_website"
            app:larus_image_width="?attr/larus_dp_32"/>
    </com.larus.bmhome.view.item.ItemGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
