<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_bg_tts_feedback"
    android:paddingBottom="?attr/larus_dp_25"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_btn"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:srcCompat="?attr/larus_ic_close_dialog"/>
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_weight="1"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/complete_button"
        android:background="?attr/larus_bg_voice_info_complete"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_dislike_feedback_submit"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"/>
</LinearLayout>
