<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/crowd_title"
        android:layout_width="wrap_content"
        android:layout_height="26sp"
        android:layout_marginTop="?attr/larus_dp_12"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/crowd_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26sp"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/crowd_title"/>
    <TextView
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_1"
        android:background="?attr/larus_bg_crowd_test_selection"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintEnd_toStartOf="@+id/btn_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/crowd_sub_title"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_2"
        android:background="?attr/larus_bg_crowd_test_selection"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/btn_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_1"
        app:layout_constraintTop_toTopOf="@+id/btn_1"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_3"
        android:background="?attr/larus_bg_crowd_test_selection"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintEnd_toStartOf="@+id/btn_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_1"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_4"
        android:background="?attr/larus_bg_crowd_test_selection"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@+id/btn_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_3"
        app:layout_constraintTop_toTopOf="@+id/btn_3"
        app:layout_constraintVertical_chainStyle="spread"/>
</androidx.constraintlayout.widget.ConstraintLayout>
