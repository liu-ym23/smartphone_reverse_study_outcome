<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/larus_dp_16">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="5dp"
        android:lineHeight="21dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/error_icon"
        android:paddingTop="1.5dp"
        android:paddingBottom="1.5dp"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:scaleType="fitCenter"
        android:paddingVertical="1.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/desc_text"
        app:srcCompat="@drawable/larus_ic_message_failed_retry"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:id="@+id/desc_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_14"
        android:maxLines="3"
        android:lineSpacingExtra="1dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:letterSpacing="0.03"
        app:layout_constraintEnd_toStartOf="@+id/icon_image"
        app:layout_constraintStart_toEndOf="@+id/error_icon"
        app:layout_constraintTop_toBottomOf="@+id/title_text"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/icon_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/desc_text"
        app:placeholderImage="?attr/larus_neutral_30"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="4dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
