<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/button_login_layout"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_4"
    android:layout_marginRight="?attr/larus_dp_4"
    android:maxWidth="?attr/larus_dp_400"
    android:layout_marginHorizontal="?attr/larus_dp_4"
    app:layout_constraintTop_toTopOf="parent">
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/button_login"
        android:background="@drawable/larus_bg_login_bottom"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:textFontWeight="600"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/button_iv"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"/>
</FrameLayout>
