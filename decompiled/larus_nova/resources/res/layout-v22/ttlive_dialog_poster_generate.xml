<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cl_poster"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:cardCornerRadius="12dp"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:background="@drawable/ttlive_bg_dialog_poster_generate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_top"
                android:layout_width="280dp"
                android:layout_height="296dp"
                fresco:layout_constraintBottom_toTopOf="@+id/cl_bottom"
                fresco:layout_constraintEnd_toEndOf="parent"
                fresco:layout_constraintStart_toStartOf="parent"
                fresco:layout_constraintTop_toTopOf="parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/sdv_background"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    fresco:actualImageScaleType="focusCrop"
                    fresco:layout_constraintBottom_toTopOf="@+id/view_gap"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent"
                    fresco:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_background"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    fresco:layout_constraintBottom_toTopOf="@+id/view_gap"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent"
                    fresco:layout_constraintTop_toTopOf="parent"
                    fresco:layout_constraintVertical_bias="1"/>
                <View
                    android:id="@+id/view_gap"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    fresco:layout_constraintBottom_toBottomOf="parent"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent"
                    fresco:layout_constraintTop_toBottomOf="@+id/sdv_background"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginHorizontal="16dp"
                    fresco:layout_constraintBottom_toTopOf="@+id/tv_title"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/sdv_avatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        fresco:layout_constraintBottom_toBottomOf="parent"
                        fresco:layout_constraintEnd_toStartOf="@+id/tv_user_name"
                        fresco:layout_constraintHorizontal_bias="0"
                        fresco:layout_constraintHorizontal_chainStyle="packed"
                        fresco:layout_constraintStart_toStartOf="parent"
                        fresco:layout_constraintTop_toTopOf="parent"
                        fresco:roundAsCircle="true"/>
                    <View
                        android:background="@drawable/ttlive_poster_avatar_border"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        fresco:layout_constraintBottom_toBottomOf="@+id/sdv_avatar"
                        fresco:layout_constraintEnd_toEndOf="@+id/sdv_avatar"
                        fresco:layout_constraintStart_toStartOf="@+id/sdv_avatar"
                        fresco:layout_constraintTop_toTopOf="@+id/sdv_avatar"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tv_user_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="4dp"
                        fresco:layout_constraintBottom_toBottomOf="parent"
                        fresco:layout_constraintEnd_toStartOf="@+id/tv_after_user_name"
                        fresco:layout_constraintStart_toEndOf="@+id/sdv_avatar"
                        fresco:layout_constraintTop_toTopOf="parent"
                        fresco:layout_constraintWidth_default="wrap"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_after_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_appointment_after_user_name"
                        android:maxLines="1"
                        android:layout_marginStart="4dp"
                        fresco:layout_constrainedWidth="true"
                        fresco:layout_constraintBottom_toBottomOf="parent"
                        fresco:layout_constraintEnd_toEndOf="parent"
                        fresco:layout_constraintStart_toEndOf="@+id/tv_user_name"
                        fresco:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="8dp"
                    android:maxLines="2"
                    android:maxLength="14"
                    android:layout_marginHorizontal="16dp"
                    fresco:layout_constraintBottom_toTopOf="@+id/tv_description"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#99ffffff"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="2"
                    android:maxLength="30"
                    android:layout_marginHorizontal="16dp"
                    fresco:layout_constraintBottom_toTopOf="@+id/view_gap"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_bottom"
                android:layout_width="280dp"
                android:layout_height="96dp"
                fresco:layout_constraintBottom_toBottomOf="parent"
                fresco:layout_constraintEnd_toEndOf="@+id/cl_top"
                fresco:layout_constraintStart_toStartOf="@+id/cl_top"
                fresco:layout_constraintTop_toBottomOf="@+id/cl_top">
                <ImageView
                    android:id="@+id/iv_save_poster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/ttlive_icon_image"
                    android:layout_marginStart="22dp"
                    fresco:layout_constraintStart_toStartOf="parent"
                    fresco:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#161823"
                    android:id="@+id/tv_save_poster_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_appointment_save_poster_hint"
                    android:layout_marginStart="8dp"
                    fresco:layout_constraintBottom_toBottomOf="@+id/iv_save_poster"
                    fresco:layout_constraintStart_toEndOf="@+id/iv_save_poster"
                    fresco:layout_constraintTop_toTopOf="@+id/iv_save_poster"/>
                <ImageView
                    android:id="@+id/iv_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ttlive_icon_scan"
                    android:layout_marginStart="22dp"
                    fresco:layout_constraintStart_toStartOf="parent"
                    fresco:layout_constraintTop_toBottomOf="@+id/tv_save_poster_hint"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#161823"
                    android:id="@+id/tv_scan_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_appointment_scan_hint"
                    android:layout_marginStart="8dp"
                    fresco:layout_constraintBottom_toBottomOf="@+id/iv_scan"
                    fresco:layout_constraintStart_toEndOf="@+id/iv_scan"
                    fresco:layout_constraintTop_toTopOf="@+id/iv_scan"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/sdv_qr_code"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="20dp"
                    fresco:layout_constraintBottom_toBottomOf="parent"
                    fresco:layout_constraintEnd_toEndOf="parent"
                    fresco:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:id="@+id/loading"
                    android:visibility="invisible"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    fresco:layout_constraintBottom_toBottomOf="@+id/sdv_qr_code"
                    fresco:layout_constraintEnd_toEndOf="@+id/sdv_qr_code"
                    fresco:layout_constraintStart_toStartOf="@+id/sdv_qr_code"
                    fresco:layout_constraintTop_toTopOf="@+id/sdv_qr_code"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:id="@+id/fl_save_poster"
        android:background="@drawable/ttlive_bg_poster_save_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="112dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toBottomOf="@+id/cl_poster">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_icon_download"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_appointment_btn_save_poster"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
