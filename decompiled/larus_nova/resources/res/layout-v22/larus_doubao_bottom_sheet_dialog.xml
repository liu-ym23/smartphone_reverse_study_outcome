<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/app_icon"
        android:background="@drawable/larus_icon_back"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:id="@+id/app_name_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_9"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="@+id/app_icon"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_28"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/app_icon"
        app:layout_constraintTop_toBottomOf="@+id/app_icon"
        app:layout_goneMarginTop="0dp"/>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/app_icon"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_scroll"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls">
            <com.larus.common_ui.widget.UrlSpanTextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/neutral_70"
                android:textColorLink="@color/neutral_100"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/dp_4"
                app:larus_linkColor="@color/neutral_100"
                app:larus_linkUnderLine="false"/>
        </androidx.core.widget.NestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/content_bottom_fade"
            android:background="@drawable/larus_doubao_bottom_sheet_content_fade"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
