<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_30"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="700"
        style="bold"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_primary_50"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_23"
        android:text="@string/larus_bot_profile_pic_crop_cancel"
        android:textFontWeight="500"/>
    <Button
        android:textColor="@color/larus_static_white"
        android:id="@+id/confirm"
        android:background="?attr/larus_bg_button_register_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"/>
</LinearLayout>
