<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/button_content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/button_login"
            android:background="@drawable/larus_bg_account_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:textFontWeight="600"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/button_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_12"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/carrier_phone_container"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_27">
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_mask_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_3"
            android:src="@drawable/larus_ic_login_edit"/>
    </LinearLayout>
</merge>
