<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/img_cover"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_80"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sub_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_5"
        android:layout_marginEnd="?attr/larus_dp_5"
        app:layout_constraintEnd_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="@+id/img_cover"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/item_img_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="img_cover, sub_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_4"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toStartOf="@+id/img_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="?attr/larus_dp_16"
        app:layout_goneMarginEnd="?attr/larus_dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_4"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:textFontWeight="400"
        app:layout_constraintBottom_toTopOf="@+id/collection_bottom_layout"
        app:layout_constraintEnd_toStartOf="@+id/img_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginBottom="?attr/larus_dp_16"
        app:layout_goneMarginEnd="?attr/larus_dp_16"
        app:layout_goneMarginTop="?attr/larus_dp_16"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/collection_bottom_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_goneMarginEnd="?attr/larus_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/collection_create_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="400"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
