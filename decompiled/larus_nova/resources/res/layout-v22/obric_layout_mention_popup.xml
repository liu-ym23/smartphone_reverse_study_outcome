<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="?attr/larus_dp_12">
    <com.larus.common_ui.widget.ShadowLayout
        android:layout_gravity="bottom"
        android:id="@+id/obric_mention_shadow_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/obric_bg_mention_popup_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_312">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/obric_mention_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <View
                android:layout_gravity="top"
                android:id="@+id/obric_mention_top_mask"
                android:background="@drawable/obric_mention_popup_top_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_32"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/obric_mention_bottom_mask"
                android:background="@drawable/obric_mention_popup_bottom_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_32"/>
        </FrameLayout>
    </com.larus.common_ui.widget.ShadowLayout>
</FrameLayout>
