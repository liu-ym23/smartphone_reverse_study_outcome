<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="207dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="normal"
        android:textColor="#161823"
        android:id="@+id/ttlive_mic_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:maxEms="9"
        android:layout_marginStart="16dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_mic_kick_out_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="#7f000000"
        android:id="@+id/ttlive_mic_kick_out_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_media_multi_link_mic_kick_out_desc"
        android:layout_marginEnd="16dp"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_mic_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0"
        app:layout_constraintStart_toEndOf="@+id/ttlive_mic_dialog_title"
        app:layout_constraintTop_toTopOf="@+id/ttlive_mic_dialog_title"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="29dp"
        android:layout_marginRight="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_mic_dialog_title">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ttlive_mic_dialog_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </HorizontalScrollView>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="#57000000"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="120dp"
        android:layout_marginRight="6dp"
        android:text="@string/ttlive_media_multi_link_mic_panel_bottom_desc"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_mic_dialog_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
