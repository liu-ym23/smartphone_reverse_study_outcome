<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/source_icon"
            android:background="@drawable/obric_bg_round_16"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_24"
            android:src="@drawable/obric_ic_card_app_lark_rectangle"
            android:clipToOutline="true"
            app:layout_constraintEnd_toStartOf="@+id/exchange_icon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/exchange_icon"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:src="@drawable/obric_ic_card_exchange_icon"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/source_icon"
            app:layout_constraintEnd_toStartOf="@+id/target_icon"
            app:layout_constraintStart_toEndOf="@+id/source_icon"
            app:layout_constraintTop_toTopOf="@+id/source_icon"/>
        <ImageView
            android:id="@+id/target_icon"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_24"
            android:src="@drawable/obric_ic_card_app_doubao"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/exchange_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/neutral_100"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:layout_marginVertical="@dimen/dp_12"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/source_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/middle_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_zone">
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/obric_authorized_card_content_color"
            android:id="@+id/hint_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginVertical="@dimen/dp_8"
            android:textFontWeight="500"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="@dimen/dp_8"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_10">
            <ImageView
                android:id="@+id/hint_icon1"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/obric_ic_card_blue_dot"
                android:scaleType="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:id="@+id/hint_subtitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/hint_icon1"
                app:layout_constraintTop_toTopOf="@+id/hint_icon1"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:id="@+id/hint_subcontent1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/hint_icon1"
                app:layout_constraintStart_toEndOf="@+id/hint_icon1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="@dimen/dp_8"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_10">
            <ImageView
                android:id="@+id/hint_icon2"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/obric_ic_card_blue_dot"
                android:scaleType="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:id="@+id/hint_subtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/hint_icon2"
                app:layout_constraintTop_toTopOf="@+id/hint_icon2"/>
            <TextView
                android:textSize="@dimen/dp_12"
                android:id="@+id/hint_subcontent2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/hint_icon2"
                app:layout_constraintStart_toEndOf="@+id/hint_icon2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/foot_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/middle_zone">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/base_1"
            android:gravity="center"
            android:id="@+id/authorization_but"
            android:background="@drawable/obric_authorized_card_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:textFontWeight="500"/>
    </LinearLayout>
</RelativeLayout>
