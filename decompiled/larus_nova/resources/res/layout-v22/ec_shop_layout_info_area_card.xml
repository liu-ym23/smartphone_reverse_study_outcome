<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/ec_shop_info_area"
    android:paddingTop="8dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ec_window_info_area"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.window.shop.widget.ClipView
            android:id="@+id/ec_shop_info_area_logo_wrapper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/user_bought_bg"
            android:background="@drawable/shape_shopping_shop_info_card_bought_background_2nd"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/user_bought_recommend_container"
            android:background="@drawable/shape_shopping_shop_info_card_bought_background"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="15dp"
            android:paddingStart="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@+id/ec_window_base_info">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/user_bought_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/shopping_color_66161823"
                    android:id="@+id/ec_shop_user_bought_empty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_no_follow_record"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/user_bought_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#99161823"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ec_shop_chao"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#bf161823"
                        android:id="@+id/ec_shop_bought_count"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#99161823"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ec_shop_follower_buy"/>
                </LinearLayout>
                <View
                    android:id="@+id/ec_shop_line"
                    android:background="#1a161823"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#99161823"
                    android:gravity="center_vertical"
                    android:id="@+id/ec_shop_recommend_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_recommend_count"/>
            </LinearLayout>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/window_info_everyone_talk_area"
            android:background="@drawable/shape_shopping_shop_info_card_bought_background"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="13dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@+id/ec_window_base_info">
            <TextView
                android:textSize="12dp"
                android:textColor="#e5161823"
                android:id="@+id/window_info_everyone_talk_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"
                android:text="@string/ec_window_everyone_talk"
                android:textFontWeight="600"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/window_info_everyone_talk_impression"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/window_info_everyone_talk_title"
                app:layout_constraintRight_toLeftOf="@+id/window_info_everyone_talk_ic"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/window_info_everyone_talk_ic"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="9dp"
                android:src="@drawable/ec_window_talk_ic_arrowforward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/window_info_everyone_talk_impression"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ec_window_base_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.ec.core.widget.CircleImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_shop_user"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginTop="1dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_shop_name"
                android:paddingBottom="2dp"
                android:focusable="true"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="31dp"
                android:layout_marginRight="12dp"
                app:layout_constraintHeight_default="spread"
                app:layout_constraintLeft_toRightOf="@+id/iv_shop_user"
                app:layout_constraintRight_toLeftOf="@+id/ec_shop_info_area_follow"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="@color/shopping_std_text_black_1"
                    android:ellipsize="end"
                    android:id="@+id/tv_shop_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="@color/shopping_std_text_black_1"
                    android:id="@+id/tv_name_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/commerce_anchor_v3_store"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/view_enter"
                    android:background="@drawable/ec_store_ic_round_right_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_window_author_self_intro"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                app:layout_constraintLeft_toRightOf="@+id/iv_shop_user"
                app:layout_constraintRight_toLeftOf="@+id/ec_shop_info_area_follow"
                app:layout_constraintTop_toBottomOf="@+id/ll_shop_name"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ec_shop_reputation_recommend_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="5dp"
                app:layout_constraintLeft_toRightOf="@+id/iv_shop_user"
                app:layout_constraintTop_toBottomOf="@+id/ec_window_author_self_intro">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/shopping_color_99161823"
                    android:id="@+id/window_fans_info"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textFontWeight="400"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/window_fans_info_split"
                    android:background="@color/shopping_color_1A161823"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/shopping_color_66161823"
                    android:id="@+id/ec_shop_reputation_empty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_recommend_empty"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ec_shop_reputation_container"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/shopping_color_99161823"
                        android:id="@+id/tv_shop_score_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ec_shop_recommend_score"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/shopping_color_FE2C55"
                        android:id="@+id/tv_shop_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:id="@+id/tv_shop_score_rank"
                        android:paddingLeft="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ec_window_level_info_area"
                android:background="@drawable/ec_window_level_info_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toRightOf="@+id/iv_shop_user"
                app:layout_constraintRight_toLeftOf="@+id/ec_window_popular_rank_entrance_container"
                app:layout_constraintTop_toBottomOf="@+id/ec_shop_reputation_recommend_container">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ec_window_level_info_icon"
                    android:layout_width="23dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/shopping_color_FE2C55"
                    android:id="@+id/ec_window_level_info_category_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="4dp"
                    android:textFontWeight="400"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ec_window_level_info_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/ec_window_popular_rank_entrance_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toRightOf="@+id/ec_window_level_info_area"
                app:layout_constraintTop_toBottomOf="@+id/ec_shop_reputation_recommend_container">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ec_window_popular_rank_entrance"
                    android:background="@drawable/window_popular_rank_entrance_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ec_window_popular_rank_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/ec_window_rank_info_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:gravity="center_vertical"
                        android:id="@+id/ec_window_rank_info_arrow"
                        android:layout_width="5dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="6dp"
                        android:src="@drawable/ec_window_popular_rank_entrance_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/ec_window_rank_info_text"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <FrameLayout
                android:gravity="center"
                android:id="@+id/ec_shop_info_area_follow"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ec_shop_info_area_follow_action"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/ec_shop_info_area_follow_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_follow_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="2dp"
                            android:src="@drawable/ec_shop_follow_white"
                            android:layout_marginEnd="2dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_follow_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <FrameLayout
                        android:gravity="center"
                        android:id="@+id/ec_shop_info_area_fans_group"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_fans_group_icon"
                            android:layout_width="26dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ec_store_info_join_fans_group_image"/>
                        <TextView
                            android:textSize="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/shopping_std_text_white_1"
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_fans_group_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                    </FrameLayout>
                </LinearLayout>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="end|top"
                    android:id="@+id/ec_shop_info_area_follow_bubble"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="19dp"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:id="@+id/ec_window_lynx_container"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_info_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
