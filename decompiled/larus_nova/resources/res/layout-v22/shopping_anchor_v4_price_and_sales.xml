<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopping_anchor_v4_price_and_sales_1671483472"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.anchorv4.voavhs.baseinfo.AnchorV4PriceViewContainer
        android:orientation="horizontal"
        android:id="@+id/base_info_price_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
            android:layout_gravity="center_vertical"
            android:id="@+id/base_info_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pv_suffixTextMarginLeft="4dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
            android:layout_gravity="center_vertical"
            android:id="@+id/base_info_discount_price"
            android:paddingLeft="9dp"
            android:paddingTop="2dp"
            android:paddingRight="9dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="2dp"
            app:pv_suffixTextMarginLeft="4dp"
            app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
            android:layout_gravity="bottom"
            android:id="@+id/base_info_market_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="2dp"
            app:pv_suffixTextMarginLeft="4dp"/>
    </com.bytedance.android.shopping.anchorv4.voavhs.baseinfo.AnchorV4PriceViewContainer>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
        android:id="@+id/base_info_sales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
