<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flow_ud_toast_shadow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="20dp"
    style="@style/UDShadow.S3.Down">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/flow_ud_toast_root"
        android:background="@drawable/flow_ud_bg_toast_normal"
        android:paddingLeft="@dimen/flow_ud_toast_padding_horizontal"
        android:paddingTop="@dimen/flow_ud_toast_padding_vertical"
        android:paddingRight="@dimen/flow_ud_toast_padding_horizontal"
        android:paddingBottom="@dimen/flow_ud_toast_padding_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/flow_ud_toast_padding_horizontal"
        android:paddingVertical="@dimen/flow_ud_toast_padding_vertical">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/flow_ud_toast_icon"
            android:visibility="gone"
            android:layout_width="@dimen/flow_ud_toast_icon_size"
            android:layout_height="@dimen/flow_ud_toast_icon_size"
            android:layout_marginEnd="@dimen/flow_ud_toast_padding_icon_text"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/flow_ud_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/flow_ud_toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="12"/>
        <View
            android:id="@+id/flow_ud_toast_action_divider"
            android:background="@color/flow_ud_neutral_transparent_3"
            android:visibility="gone"
            android:layout_width="@dimen/flow_ud_toast_divider_size"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/flow_ud_toast_padding_action_divider"
            android:layout_marginEnd="@dimen/flow_ud_toast_padding_action_divider"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/flow_ud_primary_50"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/flow_ud_toast_action"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/flow_ud_toast_action_max_wight"/>
    </LinearLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
