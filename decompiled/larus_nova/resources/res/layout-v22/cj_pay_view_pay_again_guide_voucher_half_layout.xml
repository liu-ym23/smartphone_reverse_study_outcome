<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/insufficient_panel_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <ImageView
        android:id="@+id/top_icon"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"
        app:srcCompat="@drawable/cj_pay_cry_face_icon"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/guide_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cj_pay_insufficient_balance"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:lineHeight="25sp"
        app:layout_constraintEnd_toStartOf="@+id/guide_title_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_icon"/>
    <ImageView
        android:id="@+id/guide_title_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/cj_pay_icon_pay_again_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide_title_text"
        app:layout_constraintTop_toTopOf="@+id/guide_title_text"/>
    <include
        android:id="@+id/field_voucher"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_title_text"
        layout="@layout/cj_pay_view_pay_again_guide_content_style_voucher"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/field_simple"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_title_text"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:ellipsize="middle"
        android:id="@+id/field_simple_voucher"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/field_simple"/>
    <include
        android:id="@+id/field_credit_pay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_title_text"
        layout="@layout/cj_pay_view_pay_again_guide_content_style_credit_pay"/>
    <include
        android:id="@+id/field_combine_pay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_title_text"
        layout="@layout/cj_pay_view_pay_again_guide_content_style_combine_pay"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/confirm_btn_voucher_label_layout"
        android:background="@drawable/cj_pay_bg_pay_again_voucher_label"
        android:paddingLeft="@dimen/cj_pay_padding_15"
        android:paddingRight="@dimen/cj_pay_padding_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_btn_layout"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_10"
            android:layout_marginRight="@dimen/cj_pay_padding_5"
            android:src="@drawable/cj_pay_icon_pay_again_voucher"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:id="@+id/confirm_btn_voucher_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_7"
            android:singleLine="true"/>
    </LinearLayout>
    <include
        android:id="@+id/confirm_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/other_method_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/other_method_btn"
        android:background="@drawable/cj_pay_bg_round_gray_border"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
