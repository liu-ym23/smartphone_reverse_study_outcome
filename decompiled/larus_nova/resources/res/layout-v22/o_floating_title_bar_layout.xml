<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/material_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_title_bar_mask_height"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:id="@+id/title_bar_container"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="12dp">
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/start_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp">
            <com.obric.oui.button.OButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/start_button_group"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                style="@style/OStyleV2.OButtonGroup.S"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/start_title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_1"
                    android:ellipsize="end"
                    android:id="@+id/start_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    style="@style/Title_3_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_3"
                    android:ellipsize="end"
                    android:id="@+id/start_sub_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    style="@style/Subtitle_1_Regular"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/center_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp">
            <com.obric.oui.button.OButtonGroup
                android:layout_gravity="center"
                android:id="@+id/center_button_group"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                style="@style/OStyleV2.OButtonGroup.S"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/center_custom_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/center_title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_1"
                    android:ellipsize="end"
                    android:id="@+id/center_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/Title_1_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_3"
                    android:ellipsize="end"
                    android:id="@+id/center_sub_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    style="@style/Subtitle_1_Regular"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/end_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp">
            <com.obric.oui.button.OButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/end_sub_button_group"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                style="@style/OStyleV2.OButtonGroup.S"/>
            <com.obric.oui.button.OButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/end_button_group"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                style="@style/OStyleV2.OButtonGroup.S"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
