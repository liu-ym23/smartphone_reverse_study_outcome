<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dora_o_bg_memory_card"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_20"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/larus_dp_20"
        android:paddingVertical="?attr/larus_dp_16">
        <EditText
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/dora_o_text_primary"
            android:textColorHint="@color/dora_o_text_tertiary"
            android:id="@+id/style_name_input"
            android:background="@null"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/larus_dora_o_diary_style_name_hint"
            android:maxLines="1"
            android:maxLength="20"
            android:inputType="text"
            android:paddingVertical="?attr/larus_dp_4"/>
        <View
            android:background="@color/dora_o_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginVertical="?attr/larus_dp_8"/>
        <EditText
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/dora_o_text_primary"
            android:textColorHint="@color/dora_o_text_tertiary"
            android:gravity="top"
            android:id="@+id/style_prompt_input"
            android:background="@null"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_132"
            android:hint="@string/larus_dora_o_diary_style_prompt_hint"
            android:maxLength="200"
            android:inputType="textMultiLine"
            android:paddingVertical="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_sp_10"
            android:textColor="@color/dora_o_text_secondary"
            android:gravity="end"
            android:id="@+id/style_prompt_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"/>
    </LinearLayout>
</LinearLayout>
