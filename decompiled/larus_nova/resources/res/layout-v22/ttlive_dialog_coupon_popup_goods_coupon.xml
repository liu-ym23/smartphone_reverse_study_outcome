<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_coupon_popup_goods_coupon"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_close_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_ug_coupon_dialog_close_bg"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_goods_coupon_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="1"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_close_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_goods_coupon_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg_coupon_popup_goods_1"
        android:background="@drawable/ttlive_bg_dialog_coupon_popup_goods_item"
        android:layout_width="240dp"
        android:layout_height="68dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_popup_goods_coupon_subtitle"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_coupon_popup_goods_1_image"
        android:background="@drawable/ttlive_bg_dialog_popup_goods_image"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_1"
        app:layout_constraintStart_toStartOf="@+id/bg_coupon_popup_goods_1"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_coupon_popup_goods_1_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@+id/bg_coupon_popup_goods_1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_1_image"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_1"/>
    <TextView
        android:textSize="1sp"
        android:textColor="#ff1c49"
        android:gravity="bottom"
        android:id="@+id/tv_coupon_popup_goods_1_discount_pricing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="￥"
        android:layout_marginStart="6dp"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_1"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_1_image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_coupon_popup_goods_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bg_coupon_popup_goods_1,iv_coupon_popup_goods_1_image,tv_coupon_popup_goods_1_pricing"/>
    <View
        android:id="@+id/bg_coupon_popup_goods_2"
        android:background="@drawable/ttlive_bg_dialog_coupon_popup_goods_item"
        android:layout_width="240dp"
        android:layout_height="68dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_coupon_popup_goods_1"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_coupon_popup_goods_2_image"
        android:background="@drawable/ttlive_bg_dialog_popup_goods_image"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_2"
        app:layout_constraintStart_toStartOf="@+id/bg_coupon_popup_goods_2"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_2"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_coupon_popup_goods_2_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@+id/bg_coupon_popup_goods_2"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_2_image"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_2"/>
    <TextView
        android:textSize="1sp"
        android:textColor="#ff1c49"
        android:gravity="bottom"
        android:id="@+id/tv_coupon_popup_goods_2_discount_pricing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="￥"
        android:layout_marginStart="6dp"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_2"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_2_image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_coupon_popup_goods_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bg_coupon_popup_goods_2,iv_coupon_popup_goods_2_image,tv_coupon_popup_goods_2_discount_pricing"/>
    <View
        android:id="@+id/bg_coupon_popup_goods_3"
        android:background="@drawable/ttlive_bg_dialog_coupon_popup_goods_item"
        android:layout_width="240dp"
        android:layout_height="68dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_coupon_popup_goods_2"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_coupon_popup_goods_3_image"
        android:background="@drawable/ttlive_bg_dialog_popup_goods_image"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_3"
        app:layout_constraintStart_toStartOf="@+id/bg_coupon_popup_goods_3"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_3"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_coupon_popup_goods_3_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="@+id/bg_coupon_popup_goods_3"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_3_image"
        app:layout_constraintTop_toTopOf="@+id/bg_coupon_popup_goods_3"/>
    <TextView
        android:textSize="1sp"
        android:textColor="#ff1c49"
        android:gravity="bottom"
        android:id="@+id/tv_coupon_popup_goods_3_discount_pricing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="￥"
        android:layout_marginStart="6dp"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="@+id/bg_coupon_popup_goods_3"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_popup_goods_3_image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_coupon_popup_goods_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bg_coupon_popup_goods_3,iv_coupon_popup_goods_3_image,tv_coupon_popup_goods_3_discount_pricing"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_coupon_popup_positive_button"
        android:background="@drawable/ttlive_bg_coupon_popup_postive_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_coupon_popup_goods_3"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coupon_popup_negative_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="15dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_coupon_popup_positive_button"
        app:layout_constraintStart_toStartOf="@+id/tv_coupon_popup_positive_button"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_popup_positive_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
