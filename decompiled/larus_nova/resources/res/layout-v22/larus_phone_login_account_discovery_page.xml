<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/larus_phone_login_account_discovery_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/phone_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="24dp"
        android:maxLines="1"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/page_title"/>
    <FrameLayout
        android:id="@+id/account_list_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="32dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/create_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_subtitle"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/account_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/account_list_gradient"
            android:background="@drawable/larus_bg_account_list_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/create_account"
        android:background="@drawable/larus_bg_phone_login_account_card"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="32dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_list_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/create_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/larus_ic_add_account"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/create_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/larus_phone_login_account_discovery_create_title"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toTopOf="@+id/create_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/create_arrow"
            app:layout_constraintStart_toEndOf="@+id/create_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/create_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/larus_phone_login_account_discovery_create_subtitle"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/create_arrow"
            app:layout_constraintStart_toEndOf="@+id/create_icon"
            app:layout_constraintTop_toBottomOf="@+id/create_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/create_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_arrow_right_neutral_30"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
