<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/larus_dp_16">
    <androidx.cardview.widget.CardView
        android:id="@+id/ltm_button_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="?attr/larus_dp_16"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemTextToggle
                android:id="@+id/ltm_button_switch"
                android:background="@drawable/larus_bg_item_selector_middle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_new_memory_toggle"
                android:textFontWeight="500"
                app:larus_image_src="@drawable/larus_icon_ltm_title"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/ltm_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:includeFontPadding="false"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:larus_linkColor="@color/larus_neutral_100"
        app:larus_linkUnderLine="false"/>
</LinearLayout>
