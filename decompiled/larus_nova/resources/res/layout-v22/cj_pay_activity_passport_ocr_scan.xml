<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tt_cj_pay_ocr_id_rootview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.ocr.view.OCRCodeView
        android:id="@+id/tt_cj_pay_ocr_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:CJPayScanBoxLayout="@layout/cj_pay_view_scan_box"/>
    <ImageView
        android:id="@+id/back_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/cj_pay_ocr_back_icon"
        android:layout_marginStart="8dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/light_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/cj_pay_ocr_light_icon"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/passport_identity_label_view"
        android:layout_width="88dp"
        android:layout_height="100dp"
        android:layout_marginTop="191dp"
        android:src="@drawable/cj_pay_ocr_passport_label"
        android:layout_marginStart="40dp"/>
    <ImageView
        android:id="@+id/passport_id_mask"
        android:background="@drawable/cj_pay_ocr_passport_id_mask"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginTop="313dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"/>
    <ImageView
        android:id="@+id/passport_id_indicator"
        android:background="@drawable/cj_pay_ocr_passport_id_label"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="324dp"
        android:layout_marginStart="187dp"
        android:layout_marginEnd="53dp"/>
    <TextView
        android:textSize="14dp"
        android:id="@+id/passport_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="400dp"
        android:layout_marginRight="24dp"
        android:lineHeight="20dp"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/take_photo_button"
        android:background="@drawable/cj_pay_bg_fe2c55_btn_radis_8"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="76dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        app:theme_type="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/ocr_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
