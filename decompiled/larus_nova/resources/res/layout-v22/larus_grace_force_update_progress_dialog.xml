<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="?attr/larus_dp_48"
    app:cardCornerRadius="?attr/larus_dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/larus_base_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_18"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:text="@string/larus_update_popup_downloading"
            android:lines="1"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <ProgressBar
            android:id="@+id/updateProgressBar"
            android:background="@color/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginBottom="?attr/larus_dp_24"
            android:max="100"
            android:progressDrawable="@drawable/larus_grace_update_progress"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"
            android:min="0"
            style="?android:attr/progressBarStyleHorizontal"/>
        <View
            android:background="@color/larus_neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layout_user_action"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/btn_update_cancel"
                android:background="@drawable/larus_bg_leftdown_selector"
                android:paddingTop="?attr/larus_dp_13"
                android:paddingBottom="?attr/larus_dp_13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_update_cancel_cn"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16"/>
            <View
                android:background="@color/larus_neutral_transparent_1"
                android:layout_width="?attr/larus_dp_1"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_primary_50"
                android:gravity="center"
                android:id="@+id/btn_update_pause"
                android:background="@drawable/larus_bg_rightdown_selector"
                android:paddingTop="?attr/larus_dp_13"
                android:paddingBottom="?attr/larus_dp_13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_update_pause_cn"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_update_hint"
            android:background="@drawable/larus_bg_leftdown_selector"
            android:paddingTop="?attr/larus_dp_13"
            android:paddingBottom="?attr/larus_dp_13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_update_popup_quit"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
