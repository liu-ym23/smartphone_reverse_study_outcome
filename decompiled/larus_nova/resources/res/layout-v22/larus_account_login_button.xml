<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/button_login_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_12"
    android:maxWidth="?attr/larus_dp_400"
    android:layout_marginStart="?attr/larus_dp_32"
    android:layout_marginEnd="?attr/larus_dp_32"
    app:layout_constraintTop_toTopOf="parent">
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/button_login"
        android:background="@drawable/larus_bg_account_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:textFontWeight="600"/>
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/button_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"/>
</FrameLayout>
