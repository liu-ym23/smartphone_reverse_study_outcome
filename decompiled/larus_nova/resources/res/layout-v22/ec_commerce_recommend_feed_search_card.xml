<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/product_feed_search_card_root_view"
    android:background="#ffffff"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp"
    app:rounded_radius="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ec_inflow_heart_icon"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_tip_guessulike_product_title"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">
        <com.bytedance.android.shopping.feed.view.SearchPictureCardView
            android:id="@+id/image_view_1"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/image_view_2"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.feed.view.SearchPictureCardView
            android:id="@+id/image_view_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            app:layout_constraintLeft_toRightOf="@+id/image_view_1"
            app:layout_constraintRight_toLeftOf="@+id/image_view_3"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.feed.view.SearchPictureCardView
            android:id="@+id/image_view_3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            app:layout_constraintLeft_toRightOf="@+id/image_view_2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.ec.core.widget.RoundedLinearLayout>
