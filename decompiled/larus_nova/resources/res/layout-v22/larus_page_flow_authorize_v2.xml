<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/auth_account_close"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:src="@drawable/icon_authorize_close"
        android:layout_marginEnd="?attr/larus_dp_12"
        android:layout_marginVertical="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/auth_account_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintBottom_toTopOf="@+id/auth_account_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auth_account_close"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_white_black"
        android:id="@+id/auth_account_confirm"
        android:background="@drawable/larus_ic_confirm_button_bg"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_28"
        android:text="@string/larus_auth_login_btn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/auth_account_loading_container"
        android:background="@color/larus_base_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/auth_account_loading"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:indeterminate="true"
            android:indeterminateDuration="750"
            android:indeterminateTint="@color/larus_neutral_100"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
