<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_link_manager_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_device_link_manager_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_multi_devices_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_multi_device_link_switch_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_multi_devices_switch_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_g_multi_device_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                android:textFontWeight="400"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_wear_sensor_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_wear_sensor"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_auto_wear_sensor_switch_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_wear_sensor_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_g_wear_music_tip_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                android:textFontWeight="400"/>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:text="@string/larus_dora_general_basic_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_device_ota"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_ota_title_cn"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextDescView
                    android:id="@+id/dora_device_case_version"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_device_case_ver_cn"
                    android:textFontWeight="500"/>
                <com.larus.bmhome.view.item.ItemTextDescView
                    android:id="@+id/dora_device_sn"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_device_sn_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/larus_dora_device_shutdown_btn"
                android:background="@drawable/larus_bg_item_selector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_dora_g_device_reboot_btn_cn"
                android:textFontWeight="500"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/dora_device_unbind_btn"
                android:background="@drawable/larus_bg_item_selector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:minHeight="?attr/larus_dp_56"
                android:maxLines="2"
                android:textFontWeight="500"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_danger_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/dora_device_reset_factory_btn"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:minHeight="?attr/larus_dp_56"
                android:maxLines="2"
                android:textFontWeight="500"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
