<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="?attr/larus_dp_586">
    <androidx.cardview.widget.CardView
        android:id="@+id/notification_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_4"
        android:layout_marginRight="?attr/larus_dp_4"
        android:layout_marginHorizontal="?attr/larus_dp_4"
        app:cardBackgroundColor="@color/larus_base_4"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/notification_container"
            android:paddingTop="?attr/larus_dp_14"
            android:paddingBottom="?attr/larus_dp_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/text_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_10"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/click_area"
                app:layout_constraintStart_toEndOf="@+id/left_image"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="?attr/larus_dp_16"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_100"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="?attr/larus_dp_10"/>
                <TextView
                    android:textSize="?attr/larus_dp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:ellipsize="end"
                    android:id="@+id/content"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_1"
                    android:layout_marginStart="?attr/larus_dp_10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/click_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_right_action"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_16">
                <ImageView
                    android:id="@+id/icon_1"
                    android:layout_width="?attr/larus_dp_36"
                    android:layout_height="?attr/larus_dp_36"/>
                <ImageView
                    android:id="@+id/icon_2"
                    android:layout_width="?attr/larus_dp_36"
                    android:layout_height="?attr/larus_dp_36"
                    android:layout_marginStart="?attr/larus_dp_12"/>
            </LinearLayout>
            <TextView
                android:textSize="?attr/larus_dp_15"
                android:textColor="@color/primary_50"
                android:id="@+id/tv_right_action"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_credit_popUp_btn_view"
                android:layout_marginEnd="?attr/larus_dp_24"
                android:paddingVertical="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/left_image"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/larus_neutral_transparent_1"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
