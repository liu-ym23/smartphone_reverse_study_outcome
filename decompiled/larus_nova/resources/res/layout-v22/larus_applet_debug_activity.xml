<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/debug_info_container"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="?attr/larus_dp_24"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/version_manager_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                android:text="@string/applet_app_debug_setting_cn"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/debug_info_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/debug_tag_switch"
                android:background="@drawable/larus_bg_item_selector_middle"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_50"
                android:layout_marginTop="?attr/larus_dp_12"
                android:checked="false"
                android:text="@string/applet_app_debug_show_debug_tag_cn"
                android:paddingStart="?attr/larus_dp_10"
                android:paddingEnd="?attr/larus_dp_10"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/version_manager_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_16"
        android:text="@string/applet_debug_version_manager_entry_cn"
        app:layout_constraintBottom_toTopOf="@+id/navigate_debug_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:id="@+id/navigate_debug_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_16"
        android:text="@string/applet_app_debug_enter_cn"
        app:layout_constraintBottom_toTopOf="@+id/close_debug_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:id="@+id/close_debug_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_16"
        android:text="@string/applet_app_debug_exit_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:background="@color/larus_base_1"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_view"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:indeterminate="true"
            android:indeterminateDuration="750"
            android:indeterminateTint="@color/larus_primary_50"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
