<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:id="@+id/share_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/normal_action_button_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_message_share_checkbox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/message_share_checkbox"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:checked="false"
                android:button="@null"
                android:layout_marginEnd="?attr/larus_dp_4"/>
            <TextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/message_share_bottom_text"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_cici_share_msgs_disclaimer_checkbox"
                android:maxLines="1"
                android:paddingVertical="?attr/larus_dp_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_message_share_select_num"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/message_share_select_num"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingVertical="?attr/larus_dp_4"/>
        </LinearLayout>
        <View
            android:id="@+id/normal_action_button_top_split"
            android:background="?attr/larus_neutral_transparent_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            android:layout_marginBottom="?attr/larus_dp_16"/>
        <Button
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/normal_action_button"
            android:background="?attr/larus_bg_select_mode_action_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:text="@string/larus_cici_share_btn"
            android:textAllCaps="false"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/panel_bottom_share_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="?attr/larus_neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            android:layout_alignParentTop="true"/>
        <FrameLayout
            android:id="@+id/panel_bottom_share_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
