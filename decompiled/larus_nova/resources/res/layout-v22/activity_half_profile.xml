<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/shadow"
        android:background="@drawable/half_profile_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:layout_marginTop="-50dp"/>
    <com.bytedance.ee.bear.profile.VerticalScrollInterceptLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/profile_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/invite_banner"
            android:background="@drawable/half_profile_invite_banner_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="4dp"
            android:clipToOutline="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/invite_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/half_profile_ic_info_fill"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:text="@string/LarkCCM_Docs_Mention_AuthorizeViewPermAndNotify_Desc"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineHeight="24dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/static_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/invite"
                android:background="@drawable/half_profile_invite_button_bg"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:text="@string/LarkCCM_Mention_Authorize_Button"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="12dp"
                android:lineHeight="20dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/profile_panel"
            android:background="@drawable/half_profile_panel_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="8dp">
            <FrameLayout
                android:id="@+id/profile_fragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/top_divider"
                android:background="@drawable/half_profile_drag_handle"
                android:visibility="visible"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
    </com.bytedance.ee.bear.profile.VerticalScrollInterceptLayout>
</FrameLayout>
