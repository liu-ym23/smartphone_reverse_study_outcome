<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/obric_welcome_content_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constaint_layout"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_21"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_60"
        app:layout_constraintBottom_toTopOf="@+id/select_view"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/animator_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/login_items_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="?attr/larus_dp_232"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_weight="1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/account_text_ll"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/animator_title">
            <TextView
                android:textSize="?attr/larus_dp_30"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/account_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name_replace"
                android:includeFontPadding="false"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/account_title_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_account_title_loading"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/login_anim_move_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/animator_title">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/login_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_116"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/downgrade_login_items"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_116"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/larus_neutral_70"
                    android:gravity="top|center_horizontal"
                    android:id="@+id/downgrade_button"
                    android:paddingTop="?attr/larus_dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_68"
                    android:text="@string/larus_trafficDegradation_logInOtherMethods_cn"
                    android:textFontWeight="500"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/login_anim_move_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_24"
            app:layout_constraintBottom_toTopOf="@+id/login_button_fold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_items_container"/>
        <ImageView
            android:id="@+id/login_button_fold"
            android:paddingBottom="?attr/larus_dp_4"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_ic_bottom_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_anim_move_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/left_space"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/right_space"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/login_bottom_items"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_20"
        app:layout_constraintBottom_toTopOf="@+id/select_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_6"
        app:layout_constraintBottom_toTopOf="@+id/bottom_tips_container"
        app:layout_constraintEnd_toStartOf="@+id/right_space"
        app:layout_constraintStart_toEndOf="@+id/left_space">
        <CheckBox
            android:id="@+id/select_privacy_circle_view"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/larus_select_circle_view"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:layout_gravity="center"
            android:id="@+id/privacy_policy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:includeFontPadding="false"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"
            app:layout_constraintBottom_toBottomOf="@+id/select_privacy_circle_view"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_30"
        android:layout_marginRight="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:layout_marginHorizontal="?attr/larus_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_primary_50"
            android:gravity="center_horizontal"
            android:id="@+id/tv_login_by_lark"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_enterprise_login_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bottom_tips_divider"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/bottom_tips_divider"
            android:background="@color/primary_transparent_4"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_0_5"
            android:layout_height="?attr/larus_dp_9"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:layout_marginHorizontal="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_bottom_tips_container"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/tv_login_by_lark"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:id="@+id/right_bottom_tips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/bottom_tips_divider"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="@color/larus_primary_50"
                android:gravity="center_horizontal"
                android:id="@+id/tv_no_login_feedback"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_tourist_submit_feedback"/>
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="@color/larus_primary_50"
                android:gravity="center_horizontal"
                android:id="@+id/tv_no_login_use_directly"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_login_bottom_link_noLogin"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.login.impl.view.TouristTipLayout
        android:id="@+id/tourist_tip"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
