<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_60"
    android:paddingRight="?attr/larus_dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="?attr/larus_dp_60">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_left_back"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/copy_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rotate_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_full_screen_copy_button"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/rotate_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/share_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_screen_rotate_button"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_full_screen_detail_share_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_11"
        android:layout_marginBottom="?attr/larus_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/ai_content_disclaimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_container">
        <FrameLayout
            android:id="@+id/markdown_container"
            android:paddingBottom="?attr/larus_dp_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/ai_content_disclaimer"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_10"
        android:text="@string/larus_Bot_desc_genByAI"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
