<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sku_header_container"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sdv_sku_select_pop_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sdv_sku_background"
        app:placeholderImage="@drawable/shopping_ic_sku_good_small_default"
        app:roundedCornerRadius="8dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_sku_price_info_container"
        android:paddingRight="46dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/coupon_layout"
        app:layout_constraintStart_toEndOf="@+id/sdv_sku_select_pop_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_sku_price_first_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/rl_sku_price_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.android.ec.core.widget.PriceView
                    android:id="@+id/pv_sku_hot_min_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:priceBold="true"
                    app:priceDecimalTextSize="16sp"
                    app:priceTextColor="@color/shopping_std_brand"
                    app:priceTextSize="20sp"
                    app:pv_autoResize="true"
                    app:spaceSize="1dp"
                    app:thinDecimal="true"
                    app:yangTextSize="16sp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/shopping_std_brand"
                    android:id="@+id/tv_sku_hot_price_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shopping_sku_optimize_hot_price_divider"
                    android:layout_alignBottom="@+id/pv_sku_hot_min_price"
                    android:layout_toEndOf="@+id/pv_sku_hot_min_price"/>
                <com.bytedance.android.ec.core.widget.PriceView
                    android:id="@+id/pv_sku_hot_max_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/pv_sku_hot_min_price"
                    android:layout_marginEnd="4dp"
                    android:layout_toEndOf="@+id/tv_sku_hot_price_divider"
                    app:hideYang="true"
                    app:priceBold="true"
                    app:priceDecimalTextSize="16sp"
                    app:priceTextColor="@color/shopping_std_brand"
                    app:priceTextSize="20sp"
                    app:pv_autoResize="true"
                    app:thinDecimal="true"/>
                <com.bytedance.android.ec.core.widget.PriceView
                    android:id="@+id/pv_sku_first_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/pv_sku_hot_max_price"
                    android:layout_marginEnd="4dp"
                    android:layout_toEndOf="@+id/pv_sku_hot_max_price"
                    app:extraTextColor="@color/shopping_std_brand"
                    app:extraTextSize="13sp"
                    app:prefixSpaceSize="2dp"
                    app:prefixTextBold="true"
                    app:prefixTextSize="13sp"
                    app:priceBold="true"
                    app:priceDecimalTextSize="16sp"
                    app:priceTextColor="@color/shopping_std_brand"
                    app:priceTextSize="20sp"
                    app:pv_autoResize="true"
                    app:spaceSize="1dp"
                    app:thinDecimal="true"
                    app:yangTextSize="15sp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ec_sku_supplement_color"
                    android:id="@+id/pv_sku_first_supplement"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_toRightOf="@+id/pv_sku_first_price"
                    android:layout_alignBottom="@+id/pv_sku_first_price"
                    android:layout_marginEnd="4dp"
                    android:textFontWeight="500"/>
                <com.bytedance.android.ec.core.widget.PriceView
                    android:id="@+id/pv_sku_regular_price"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_alignBottom="@+id/pv_sku_first_price"
                    android:layout_marginEnd="4dp"
                    android:layout_toEndOf="@+id/pv_sku_first_supplement"
                    app:extraTextColor="@color/shopping_std_text_black_3"
                    app:extraTextSize="14sp"
                    app:prefixSpaceSize="2dp"
                    app:prefixTextSize="14sp"
                    app:priceDecimalTextSize="14sp"
                    app:priceTextColor="@color/shopping_std_text_black_3"
                    app:priceTextSize="14sp"
                    app:spaceSize="1dp"
                    app:thinDecimal="true"
                    app:yangTextSize="14sp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/shopping_std_text_black_3"
                    android:id="@+id/pv_sku_regular_supplement"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-4dp"
                    android:layout_marginBottom="2dp"
                    android:layout_toRightOf="@+id/pv_sku_regular_price"
                    android:layout_alignBottom="@+id/pv_sku_first_price"
                    android:textFontWeight="500"/>
            </RelativeLayout>
            <com.bytedance.android.ec.core.widget.PriceView
                android:id="@+id/pv_sku_second_price"
                android:background="@drawable/shopping_bg_discount_price_optimize"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:extraTextColor="@color/shopping_std_text_white_1"
                app:extraTextSize="12sp"
                app:prefixSpaceSize="2dp"
                app:prefixTextBold="true"
                app:prefixTextSize="12sp"
                app:priceBold="true"
                app:priceDecimalTextSize="15sp"
                app:priceTextColor="@color/shopping_std_text_white_1"
                app:priceTextSize="18sp"
                app:pv_autoResize="true"
                app:spaceSize="1dp"
                app:thinDecimal="true"
                app:yangTextSize="15sp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ec_sku_supplement_color"
                android:id="@+id/pv_sku_second_supplement"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="2dp"
                android:layout_toLeftOf="@+id/pv_sku_second_price"
                android:layout_alignBottom="@+id/pv_sku_second_price"
                android:textFontWeight="500"/>
            <com.bytedance.android.ec.core.widget.PriceView
                android:id="@+id/pv_sku_origin_price"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:extraTextColor="@color/shopping_std_text_modal_6"
                app:extraTextSize="14sp"
                app:prefixSpaceSize="0dp"
                app:prefixTextBold="false"
                app:prefixTextSize="14sp"
                app:priceBold="true"
                app:priceDecimalTextSize="14sp"
                app:priceTextColor="@color/shopping_std_text_modal_6"
                app:priceTextSize="14sp"
                app:pv_autoResize="true"
                app:spaceSize="1dp"
                app:thinDecimal="true"
                app:yangTextSize="14sp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ec_sku_supplement_color"
                android:id="@+id/pv_sku_origin_supplement"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/pv_sku_origin_price"
                android:layout_alignBottom="@+id/pv_sku_origin_price"
                android:textFontWeight="500"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_sku_price_second_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/ll_sku_price_first_container"
            app:layout_constraintTop_toBottomOf="@+id/ll_sku_price_first_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/coupon_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_sku_select_spec"
        app:layout_constraintStart_toStartOf="@+id/rl_sku_price_info_container"
        app:layout_constraintTop_toBottomOf="@+id/rl_sku_price_info_container">
        <com.bytedance.android.ec.common.impl.sku.view.SkuBenefitLabelGroupOptimizeLayout
            android:orientation="horizontal"
            android:id="@+id/ll_sku_benefit_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/iv_sku_benefit_entrance"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/shopping_ic_sku_forward_red"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/shopping_std_text_black_2"
        android:ellipsize="end"
        android:id="@+id/tv_sku_select_spec"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="80dp"
        android:maxWidth="300dp"
        android:maxLines="1"
        android:lineSpacingExtra="2dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rl_sku_price_info_container"
        app:layout_constraintTop_toBottomOf="@+id/coupon_layout"/>
    <ImageView
        android:id="@+id/iv_sku_detail_entrance"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ec_ic_sku_detail_entrance"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_sku_detail_entrance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="#99161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_sku_optimize_detail_entrance"/>
        <ImageView
            android:textSize="12sp"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ec_ic_sku_detail_entrance"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
