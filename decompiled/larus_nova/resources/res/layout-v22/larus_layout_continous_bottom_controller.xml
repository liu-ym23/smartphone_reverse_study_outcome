<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/continuous_talk_left_icon"
        android:background="@drawable/larus_ic_chat_continuous_bottom_camera"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:alpha="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/continuous_talk_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_weight="1"
        android:alpha="0.6"
        android:layout_marginHorizontal="?attr/larus_dp_16">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/continuous_talk_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ProgressBar
            android:id="@+id/continuous_talk_loading"
            android:padding="?attr/larus_dp_2"
            android:paddingTop="?attr/larus_dp_4"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginBottom="?attr/larus_dp_18"
            android:indeterminateDrawable="?attr/larus_continuous_bg_loading_process_dark"
            app:layout_constraintBottom_toTopOf="@+id/continuous_talk_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.larus.common_ui.view.ChatContinuousAudioVisualizerOpt
            android:id="@+id/continuous_talk_listening_anim"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_68"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginBottom="?attr/larus_dp_6"
            app:larus_bar_color="?attr/larus_neutral_100"
            app:larus_bar_max_height="?attr/larus_dp_46"
            app:larus_bar_min_height="?attr/larus_dp_3"
            app:larus_group_bar_count="4"
            app:larus_side_margin="?attr/larus_dp_0"
            app:larus_top_group_count="1"
            app:layout_constraintBottom_toTopOf="@+id/continuous_talk_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/continuous_talk_interrupt"
            android:paddingTop="?attr/larus_dp_6"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_22"
            app:layout_constraintBottom_toTopOf="@+id/continuous_talk_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="?attr/larus_ic_chat_continuous_bottom_interrupt"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/continuous_talk_pause_or_error"
            android:paddingTop="?attr/larus_dp_2"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/continuous_talk_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="?attr/larus_continuous_stop_speaking_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/continuous_talk_right_icon"
        android:background="@drawable/larus_ic_chat_continuous_bottom_close"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_6"/>
</merge>
