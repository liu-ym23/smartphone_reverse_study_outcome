<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="16sp"
        android:textColor="@color/larus_base_1"
        android:id="@+id/welcome_primary_button"
        android:background="@drawable/obric_bg_account_button_white"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="84dp"
        android:text="@string/larus_account_welcome_page_primary_button"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:stateListAnimator="@null"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/welcome_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_account_welcome_page_app_name"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcome_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/welcome_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_108"
        android:text="@string/larus_account_welcome_page_title"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif"
        android:lineHeight="22sp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
