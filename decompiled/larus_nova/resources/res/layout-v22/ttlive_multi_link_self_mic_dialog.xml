<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="normal"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/ttlive_enlarge_for_self_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/ttlive_multi_link_enlarge_for_self_desc"
        android:textFontWeight="400"/>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="normal"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/ttlive_enlarge_for_all_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/ttlive_multi_link_enlarge_for_all_desc"
        android:textFontWeight="400"/>
    <View
        android:background="#0c161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="normal"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/ttlive_multi_link_enlarge_panel_cancel_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_multi_link_mic_panel_cancel_desc"
        android:textFontWeight="400"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="34dp"/>
</LinearLayout>
