<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_dora_onboarding_music_panel_bg"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="?attr/larus_dp_30">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dora_onboarding_music_avatar"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_64"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/dora_onboarding_music_song_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_music_artist_name"
        app:layout_constraintEnd_toStartOf="@+id/dora_onboarding_music_state"
        app:layout_constraintStart_toEndOf="@+id/dora_onboarding_music_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/dora_onboarding_music_artist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dora_onboarding_music_song_name"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_music_song_name"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_music_song_name"/>
    <ImageView
        android:id="@+id/dora_onboarding_music_state"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:src="@drawable/larus_dora_onboarding_ic_music_pause"
        android:layout_marginEnd="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/larus_neutral_100"/>
</androidx.constraintlayout.widget.ConstraintLayout>
