<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_icon"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_left_back"/>
    <com.larus.common_ui.widget.RedDotTextView
        android:textSize="?attr/larus_dp_12"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/chat_title_red_dot"
        android:background="@drawable/larus_red_dot_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_30"
        app:layout_constraintBottom_toBottomOf="@+id/back_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_icon"/>
    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_100"
        android:layout_marginRight="?attr/larus_dp_100"
        android:layout_marginHorizontal="?attr/larus_dp_100"
        app:layout_constraintBottom_toBottomOf="@+id/back_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_icon">
        <com.larus.bmhome.view.RoundAvatarImageView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_46"
            android:layout_height="?attr/larus_dp_46"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginVertical="?attr/larus_dp_8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:tabBackground="@android:color/transparent"
                app:tabIndicator="?attr/larus_tab_bottom_bar"
                app:tabIndicatorColor="?attr/larus_neutral_100"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabRippleColor="@null"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/tts"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_56"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tts_continuous_talk"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_56"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/more"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_bot_setting"/>
    <FrameLayout
        android:id="@+id/add_bot_lay"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        android:layout_marginVertical="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/add_bot"
            android:layout_width="?attr/larus_dp_26"
            android:layout_height="?attr/larus_dp_26"
            app:srcCompat="?attr/ic_bot_add"/>
    </FrameLayout>
</merge>
