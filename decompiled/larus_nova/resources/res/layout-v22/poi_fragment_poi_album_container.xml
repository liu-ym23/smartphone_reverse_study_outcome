<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_fragment_poi_album_page_650869094"
    android:background="@color/POIBgPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/photos_container"
        android:background="@color/POIBgPrimary"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/placeholder_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <com.bytedance.ies.dmt.ui.widget.DmtStatusView
            android:id="@+id/status_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.locallife.photo.photopage.view.ScrollFlexViewPager
                android:id="@+id/album_view_pager"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.locallife.photo.photopage.view.PoiAlbumTagLayout
                android:id="@+id/album_tag_container"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/float_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:elevation="3dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/upload_photos_button"
                android:background="@drawable/poi_bg_poi_upload_photo_button"
                android:paddingLeft="24dp"
                android:paddingTop="12dp"
                android:paddingRight="24dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">
                <ImageView
                    android:id="@+id/camera_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/ic_s_s_camera_filled_16"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/TextReverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_upload_img"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/bottom_lynx_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
