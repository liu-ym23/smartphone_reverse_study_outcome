<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_voucher_item_root"
    android:background="@drawable/cj_pay_bg_voucher_item"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_voucher_item_top_label"
            android:background="@drawable/cj_pay_bg_voucher_component_label"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="9sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/cj_pay_voucher_item_top_label_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="9sp"
                android:typeface="monospace"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/cj_pay_voucher_item_top_count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cj_pay_voucher_item_left_layout"
            android:layout_width="100dp"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/voucher_left_tag_des_layout"
                    android:background="@drawable/cj_pay_voucher_tag_pre_desc_bg"
                    android:paddingLeft="2dp"
                    android:paddingTop="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/cj_pay_padding_2">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#fffe2c55"
                        android:gravity="center"
                        android:id="@+id/voucher_left_tag_des"
                        android:layout_width="9sp"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:baselineAligned="true">
                    <TextView
                        android:textSize="22sp"
                        android:typeface="monospace"
                        android:textColor="@color/cj_pay_color_red_fe2c55"
                        android:id="@+id/cj_pay_voucher_item_voucher_worth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:letterSpacing="-0.05"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/cj_pay_color_red_fe2c55"
                        android:ellipsize="end"
                        android:id="@+id/cj_pay_voucher_item_voucher_measure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#fffe2c55"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/voucher_left_msg_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/cj_pay_voucher_item_left_layout"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:ellipsize="end"
                android:id="@+id/cj_pay_voucher_item_voucher_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_toRightOf="@+id/cj_pay_voucher_item_left_layout"
                android:layout_centerVertical="true"
                android:textFontWeight="500"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/cj_pay_color_gray_8a8b91"
                android:ellipsize="end"
                android:id="@+id/cj_pay_voucher_item_voucher_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:layout_toRightOf="@+id/cj_pay_voucher_item_left_layout"
                android:layout_below="@+id/cj_pay_voucher_item_voucher_text"
                android:layout_centerVertical="true"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
