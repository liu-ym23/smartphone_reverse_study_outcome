<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.recharge.view.FastPayView
        android:id="@+id/fastpay_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="13dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/pay_button"/>
    <com.bytedance.android.live.recharge.view.BalanceExchangeView
        android:id="@+id/balance_exchange_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/pay_button"
        app:layout_goneMarginBottom="0dp"/>
    <Button
        android:textSize="@dimen/ttlive_live_recharge_pay_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:id="@+id/pay_button"
        android:background="@drawable/ttlive_bg_recharge_dialog_pay_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_live_recharge_pay_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_bar_layout"
        android:background="@drawable/ttlive_bg_recharge_dialog_pay_button"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_live_recharge_pay_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:translationZ="3dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent">
        <ProgressBar
            android:clickable="false"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:indeterminateDrawable="@drawable/ttlive_bg_pay_button_loading_anim"
            android:indeterminateDuration="1000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_recharge_balance_exchange_tip_text"
        android:id="@+id/balance_exchange_tip"
        android:background="@drawable/ttlive_recharge_exchange_tip_bg"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="40dp"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="16dp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_recharge_balance_exchange_tip_text"
        android:id="@+id/return_diamond_tip"
        android:background="@drawable/ttlive_recharge_exchange_tip_bg"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="40dp"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="16dp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#4d000000"
        android:gravity="center_vertical"
        android:id="@+id/protocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/recharge_security_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ToggleButton
            android:id="@+id/recharge_security_toggle_btn"
            android:background="@drawable/ttlive_cash_exchange_attention"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="4dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""/>
        <TextView
            android:textSize="11dp"
            android:textColor="#4d000000"
            android:textColorLink="@color/ttlive_live_recharge_protocol_blue"
            android:id="@+id/recharge_security_protocol"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:maxLines="1"
            android:lineHeight="22dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
