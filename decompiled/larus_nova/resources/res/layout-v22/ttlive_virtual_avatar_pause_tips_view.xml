<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container_cl"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/anchor_leave_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/root_container_cl"
        app:layout_constraintLeft_toLeftOf="@+id/root_container_cl"
        app:layout_constraintRight_toRightOf="@+id/root_container_cl"
        app:layout_constraintTop_toTopOf="@+id/root_container_cl">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/anchor_leave_tips_iv"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/ttlive_live_interact_enter_background"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#88ffffff"
            android:ellipsize="end"
            android:id="@+id/content_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_interact_anchor_pause_tips_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
