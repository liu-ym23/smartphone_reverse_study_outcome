<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/md_image_group_join_6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_1"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_3"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <com.larus.bmhome.chat.markdown.imagegroup.view.MarkdownSourceImageView
            android:id="@+id/sourceIcon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_9"
            android:layout_marginEnd="?attr/larus_dp_9"
            app:layout_constraintEnd_toEndOf="@+id/image_group_img_1"
            app:layout_constraintTop_toTopOf="@+id/image_group_img_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_2"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_3"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_3"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_1"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_3"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_2"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_4"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_3"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_3"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_group_img_1"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_5"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_3"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_3"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_6"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_4"
            app:layout_constraintTop_toBottomOf="@+id/image_group_img_2"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_6"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_3"
            android:contentDescription="@string/larus_accessibility_message_photo"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_5"
            app:layout_constraintTop_toBottomOf="@+id/image_group_img_3"
            app:placeholderImage="?attr/larus_neutral_transparent_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_static_white"
            android:id="@+id/image_group_img_more_tag"
            android:background="@drawable/larus_md_image_group_join_vertical_more_tag_bg"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:paddingStart="?attr/larus_dp_6"
            android:paddingEnd="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_10"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/image_group_img_6"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
