<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:orientation="vertical"
        android:id="@+id/product_feed_detail_root_view"
        android:background="@drawable/commerce_bg_product_feed_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="@dimen/goods_cover_top_radius">
        <FrameLayout
            android:id="@+id/header_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout
            android:id="@+id/product_feed_card_activity_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.feed.widget.InflowSkuWidget
            android:id="@+id/product_feed_sku_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout
            android:id="@+id/product_feed_card_price_container"
            android:background="@color/commerce_color_FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/product_feed_card_activity_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/product_feed_discount_info_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"/>
        <com.bytedance.android.shopping.inflow.detail.viewholder.info.BenefitGroupLayout
            android:id="@+id/product_feed_benefit_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"/>
        <com.bytedance.android.shopping.inflow.detail.viewholder.info.MarketingBannerLayout
            android:id="@+id/product_feed_marketing_banner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <com.bytedance.android.shopping.feed.widget.ExchangeCouponView
            android:id="@+id/exchange_coupon_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardTitleView
                android:id="@+id/product_feed_detail_product_title"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <com.bytedance.android.shopping.feed.widget.inflowcardtitle.InFlowCardTitleView
                android:id="@+id/product_feed_detail_product_title_new"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <View
                android:gravity="center"
                android:id="@+id/title_divider"
                android:background="#1f161823"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                android:layout_marginEnd="5dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/new_same_product_entrance_beside_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:paddingStart="8dp"
                android:layout_marginEnd="12dp">
                <com.bytedance.android.ui.base.widget.icon.IconImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:icon_color="#99161823"
                    app:srcCompat="@drawable/shopping_inflow_scanmagnifier_outlined"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#99161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5.05dp"
                    android:layout_marginTop="3.5dp"
                    android:layout_marginBottom="3.5dp"
                    android:text="@string/shopping_search_same_product"
                    android:includeFontPadding="false"
                    android:layout_marginStart="5.05dp"
                    android:layout_marginVertical="3.5dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/product_feed_extra_info_container"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <FrameLayout
            android:id="@+id/product_feed_comment_container"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <com.bytedance.android.shopping.feed.view.bottombar.InflowFeedBottomBarView
            android:id="@+id/product_feed_detail_price_buy_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="16dp"/>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/gesture_education_fl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
