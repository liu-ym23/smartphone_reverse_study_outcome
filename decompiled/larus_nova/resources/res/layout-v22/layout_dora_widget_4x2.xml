<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/widget_content"
        android:background="@drawable/bg_dora_widget_4x2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/larus_dp_158"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/larus_dp_15"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/glass_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_16"
            android:maxWidth="@dimen/larus_dp_150"
            android:text="@string/larus_dora_widget_glass"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/larus_dp_16"
            android:layout_marginEnd="@dimen/larus_dp_148"
            android:layout_alignParentStart="true"
            android:textFontWeight="600"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/dora_scene"
            android:background="@drawable/larus_bg_dora_widget_scene"
            android:paddingTop="@dimen/larus_dp_3"
            android:paddingBottom="@dimen/larus_dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/larus_dp_21"
            android:layout_marginTop="@dimen/larus_dp_12"
            android:layout_alignParentTop="true"
            android:paddingStart="@dimen/larus_dp_3_5"
            android:paddingEnd="@dimen/larus_dp_6"
            android:layout_marginStart="@dimen/larus_dp_16"
            android:layout_alignParentStart="true"
            android:paddingVertical="@dimen/larus_dp_3">
            <ImageView
                android:id="@+id/dora_scene_icon"
                android:layout_width="@dimen/larus_dp_10"
                android:layout_height="@dimen/larus_dp_10"
                android:src="@drawable/icon_dora_widget_scene_red"/>
            <TextView
                android:textSize="@dimen/larus_dp_10"
                android:textColor="@color/larus_dora_widget_scene_text_color"
                android:id="@+id/dora_scene_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_widget_scene_live_ai"
                android:layout_marginStart="@dimen/larus_dp_2"
                android:textFontWeight="500"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/larus_dp_11"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/glass_state_disconnected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_40"
            android:text="@string/larus_dora_widget_unbound"
            android:includeFontPadding="false"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/larus_dp_16"
            android:layout_alignParentStart="true"/>
        <RelativeLayout
            android:id="@+id/glass_state_connected"
            android:visibility="gone"
            android:layout_width="@dimen/larus_dp_126"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_36"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/larus_dp_16"
            android:layout_alignParentStart="true">
            <RelativeLayout
                android:id="@+id/glass_info"
                android:layout_width="@dimen/larus_dp_56"
                android:layout_height="@dimen/larus_dp_27"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <ImageView
                    android:layout_width="@dimen/larus_dp_20"
                    android:layout_height="@dimen/larus_dp_20"
                    android:src="@drawable/icon_dora_widget_glass"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/larus_dp_12"
                    android:textColor="@color/larus_neutral_100"
                    android:gravity="center"
                    android:id="@+id/glass_power_level_percent"
                    android:layout_width="@dimen/larus_dp_34"
                    android:layout_height="@dimen/larus_dp_20"
                    android:text="@string/larus_dora_widget_power_percent_100"
                    android:includeFontPadding="false"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:textFontWeight="500"/>
                <RelativeLayout
                    android:layout_width="@dimen/larus_dp_46"
                    android:layout_height="@dimen/larus_dp_3"
                    android:layout_marginBottom="@dimen/larus_dp_4"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_dora_widget_power_progress_bg"/>
                    <ProgressBar
                        android:id="@+id/glass_power_progress_bar_green"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <ProgressBar
                        android:id="@+id/glass_power_progress_bar_yellow"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <ProgressBar
                        android:id="@+id/glass_power_progress_bar_red"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                        style="?android:attr/progressBarStyleHorizontal"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/glass_charge_flash"
                    android:visibility="gone"
                    android:layout_width="@dimen/larus_dp_10"
                    android:layout_height="@dimen/larus_dp_11"
                    android:src="@drawable/icon_dora_widget_lightening"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/larus_dp_18"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/glass_box_info"
                android:layout_width="@dimen/larus_dp_56"
                android:layout_height="@dimen/larus_dp_27"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="@dimen/larus_dp_16"
                    android:layout_height="@dimen/larus_dp_20"
                    android:src="@drawable/icon_dora_widget_glass_box"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/larus_dp_12"
                    android:textColor="@color/larus_neutral_100"
                    android:gravity="center"
                    android:id="@+id/glass_box_power_level_percent"
                    android:layout_width="@dimen/larus_dp_34"
                    android:layout_height="@dimen/larus_dp_20"
                    android:text="@string/larus_dora_widget_power_percent_100"
                    android:includeFontPadding="false"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="@dimen/larus_dp_4"
                    android:layout_alignParentEnd="true"
                    android:textFontWeight="500"/>
                <RelativeLayout
                    android:layout_width="@dimen/larus_dp_46"
                    android:layout_height="@dimen/larus_dp_3"
                    android:layout_marginBottom="@dimen/larus_dp_4"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_dora_widget_power_progress_bg"/>
                    <ProgressBar
                        android:id="@+id/glass_box_power_progress_bar_green"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <ProgressBar
                        android:id="@+id/glass_box_power_progress_bar_yellow"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <ProgressBar
                        android:id="@+id/glass_box_power_progress_bar_red"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                        style="?android:attr/progressBarStyleHorizontal"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/glass_box_charge_flash"
                    android:visibility="gone"
                    android:layout_width="@dimen/larus_dp_10"
                    android:layout_height="@dimen/larus_dp_11"
                    android:src="@drawable/icon_dora_widget_lightening"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/larus_dp_18"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/dora_device_pic"
            android:layout_width="@dimen/larus_dp_120"
            android:layout_height="@dimen/larus_dp_60"
            android:layout_marginBottom="@dimen/larus_dp_12"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/larus_dp_16"
            android:layout_marginEnd="@dimen/larus_dp_148"
            android:layout_alignParentStart="true"/>
        <RelativeLayout
            android:layout_width="@dimen/larus_dp_134"
            android:layout_height="@dimen/larus_dp_134"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/larus_dp_136"
            android:layout_marginEnd="@dimen/larus_dp_12"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/larus_dp_63"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:id="@+id/diary_btn"
                    android:background="@drawable/larus_bg_dora_widget_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/larus_dp_63"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_20"
                        android:layout_height="@dimen/larus_dp_20"
                        android:layout_marginTop="@dimen/larus_dp_13"
                        android:src="@drawable/icon_dora_widget_diary"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_11"
                        android:textColor="@color/larus_neutral_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/larus_dp_13"
                        android:text="@string/larus_dora_widget_diary_button"
                        android:includeFontPadding="false"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/recording_btn"
                    android:background="@drawable/larus_bg_dora_widget_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/larus_dp_63"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/larus_dp_8">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_20"
                        android:layout_height="@dimen/larus_dp_20"
                        android:layout_marginTop="@dimen/larus_dp_13"
                        android:src="@drawable/icon_dora_widget_recording"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_11"
                        android:textColor="@color/larus_neutral_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/larus_dp_13"
                        android:text="@string/larus_dora_widget_record_button"
                        android:includeFontPadding="false"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/larus_dp_63"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:id="@+id/album_btn"
                    android:background="@drawable/larus_bg_dora_widget_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/larus_dp_63"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_20"
                        android:layout_height="@dimen/larus_dp_20"
                        android:layout_marginTop="@dimen/larus_dp_13"
                        android:src="@drawable/icon_dora_widget_album"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_11"
                        android:textColor="@color/larus_neutral_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/larus_dp_13"
                        android:text="@string/larus_dora_widget_album_button"
                        android:includeFontPadding="false"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/note_btn"
                    android:background="@drawable/larus_bg_dora_widget_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/larus_dp_63"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/larus_dp_8">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_20"
                        android:layout_height="@dimen/larus_dp_20"
                        android:layout_marginTop="@dimen/larus_dp_13"
                        android:src="@drawable/icon_dora_widget_note"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_11"
                        android:textColor="@color/larus_neutral_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/larus_dp_13"
                        android:text="@string/larus_dora_widget_note_button"
                        android:includeFontPadding="false"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
