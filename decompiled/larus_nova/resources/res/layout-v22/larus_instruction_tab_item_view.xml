<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_unselected_instruction_tab_background"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_36"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <com.facebook.drawee.view.SimpleDraweeView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tab_icon"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:placeholderImage="?attr/larus_neutral_transparent_1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="500"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_selected_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_4"
        android:textFontWeight="500"
        app:layout_goneMarginStart="?attr/larus_dp_14"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/icon_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_4"
        app:srcCompat="?attr/larus_icon_chevron_down_fill"/>
</LinearLayout>
