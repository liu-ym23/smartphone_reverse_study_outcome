<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/commerce_store_hot_search_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="264dp">
    <RelativeLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/shopping_color_161823"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_store_search_hot_view_title"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:id="@+id/commerce_store_hot_search_refresh_click"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingVertical="4dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/store_search_hot_view_refresh"
                android:background="@drawable/shopping_store_search_refresh_btn"
                android:visibility="visible"
                android:layout_width="16sp"
                android:layout_height="16sp"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/ecommerce_store_hot_serach_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
