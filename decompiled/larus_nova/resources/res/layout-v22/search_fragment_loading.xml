<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/photo_search_loading_bg"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.05"/>
    <com.ss.android.ugc.aweme.search.vision.loading.view.LoadingLottieView
        android:id="@+id/lottie_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textColor="@color/TextReverse"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_cancel_search"
        android:background="@drawable/search_bg_commodity_cancel_button"
        android:paddingLeft="36dp"
        android:paddingTop="8dp"
        android:paddingRight="36dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:text="@string/search_commodity_cancel_search"
        android:paddingHorizontal="36dp"
        android:paddingVertical="8dp"
        style="@style/font_size_30_sp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_cancel_search_v2"
        android:background="@drawable/photo_search_cancel_search_bg"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginBottom="76dp"
        android:text="@string/search_commodity_cancel_search"
        style="@style/font_size_26_sp"/>
</FrameLayout>
