<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
        android:id="@+id/layout_avatar"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title_affix_area"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_avatar"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            app:failureImage="@drawable/larus_common_ui_avatar_placeholder"
            app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"/>
    </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_affix_area"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_action_area"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/layout_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp">
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_review_tag"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="?attr/larus_dp_6"/>
        <View
            android:id="@+id/title_end_gradient"
            android:background="?attr/larus_right_gradient_mask_state_list"
            android:visibility="invisible"
            android:duplicateParentState="true"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_11"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_review_tag"
            android:background="@drawable/larus_bg_gray_rectangle"
            android:paddingLeft="?attr/larus_dp_6"
            android:paddingTop="?attr/larus_dp_5"
            android:paddingRight="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_5"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_tag_review_failed"
            android:maxLines="1"
            android:textAlignment="center"
            android:layout_marginEnd="?attr/larus_dp_6"
            android:paddingHorizontal="?attr/larus_dp_6"
            android:paddingVertical="?attr/larus_dp_5"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_enterprise_tag"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="?attr/larus_dp_6"/>
        <TextView
            android:textSize="?attr/larus_dp_11"
            android:textStyle="bold"
            android:textColor="@color/larus_static_black"
            android:gravity="center"
            android:id="@+id/tv_enterprise_tag"
            android:background="?attr/larus_bg_chat_title_tag"
            android:paddingLeft="?attr/larus_dp_5"
            android:paddingTop="?attr/larus_dp_3"
            android:paddingRight="?attr/larus_dp_5"
            android:paddingBottom="?attr/larus_dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_enterprise_mainBot_tag_cn"
            android:paddingHorizontal="?attr/larus_dp_5"
            android:paddingVertical="?attr/larus_dp_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_review_tag"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/right_action_area"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_realtime_call"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_ic_side_bar_realtime_call"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <ImageView
            android:id="@+id/iv_pin"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_ic_side_bar_pin"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <FrameLayout
            android:id="@+id/layout_end_action"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_22"
            android:minWidth="?attr/larus_dp_22">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_pending_confirmation"
                android:background="?attr/larus_bg_chat_title_tag"
                android:paddingLeft="?attr/larus_dp_6"
                android:paddingRight="?attr/larus_dp_6"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_22"
                android:paddingHorizontal="?attr/larus_dp_6">
                <View
                    android:background="@drawable/larus_bg_side_bar_pending_confirmation_dot"
                    android:layout_width="?attr/larus_dp_6"
                    android:layout_height="?attr/larus_dp_6"
                    android:layout_marginEnd="?attr/larus_dp_2"/>
                <TextView
                    android:textSize="?attr/larus_dp_11"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_primary_50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_mainPage_sidebar_status_pending_confirmation"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <com.larus.common_ui.widget.CircleProgressBar
                android:layout_gravity="end|center_vertical"
                android:id="@+id/message_progress"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                app:larus_maxProgress="100"
                app:larus_progress="75"
                app:larus_progressbarBackgroundColor="@android:color/transparent"
                app:larus_progressbarGradientEndColor="?attr/larus_side_bar_message_progress_gradient_end"
                app:larus_progressbarGradientStartColor="?attr/larus_side_bar_message_progress_gradient_start"
                app:larus_progressbarInset="?attr/larus_dp_1"
                app:larus_radius="?attr/larus_dp_9"
                app:larus_strokeWidth="?attr/larus_dp_2_5"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_receive_failed"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:src="@drawable/larus_ic_side_bar_receive_failed"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_conversation_with_job"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:src="@drawable/larus_ic_side_bar_conversation_with_job"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_close_item"
                android:padding="2dp"
                android:visibility="visible"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_ic_side_bar_close"/>
            <com.larus.common_ui.widget.RedDotTextView
                android:textSize="?attr/larus_dp_11"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_red_dot"
                android:background="@drawable/larus_red_dot_bg"
                android:visibility="visible"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:text="1"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
