<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/ttlive_anti_addiction_mask"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse2"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_remind_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:lines="1"
        android:lineHeight="33.6dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/tv_remind_subtitle"
        app:layout_constraintStart_toEndOf="@+id/tv_remind_countdown"
        app:layout_goneMarginStart="32dp"/>
    <com.bytedance.android.livesdk.antiaddiction.view.CountdownTextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse2"
        android:gravity="center"
        android:id="@+id/tv_remind_countdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="32dp"
        android:lineHeight="33.6dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/tv_remind_subtitle"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_remind_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:lines="1"
        android:layout_marginStart="32dp"
        android:lineHeight="21dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/tv_block_feedback"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_douyin_const_ConstTextInverse4"
        android:ellipsize="end"
        android:id="@+id/tv_block_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:lines="1"
        android:layout_marginStart="32dp"
        android:lineHeight="18dp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_block_feedback"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ttlive_anti_addiction_ic_arrow_const_text_inverse4"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_block_feedback"
        app:layout_constraintStart_toEndOf="@+id/tv_block_feedback"
        app:layout_constraintTop_toTopOf="@+id/tv_block_feedback"/>
</androidx.constraintlayout.widget.ConstraintLayout>
