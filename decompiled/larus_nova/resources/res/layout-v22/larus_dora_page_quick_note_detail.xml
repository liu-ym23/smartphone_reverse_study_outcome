<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_30"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:paddingVertical="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_quick_note"
                android:layout_width="?attr/larus_dp_72"
                android:layout_height="?attr/larus_dp_72"
                android:layout_marginTop="?attr/larus_dp_8"
                android:src="@drawable/larus_dora_quick_note"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_20"
                android:textColor="@color/larus_neutral_100"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_dora_gesture_quick_note_cn"
                android:textFontWeight="500"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_neutral_70"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:text="@string/larus_dora_quick_note_desc_cn"
                android:lineSpacingMultiplier="1.2"
                android:textFontWeight="400"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/primary_50"
                android:layout_gravity="center_horizontal"
                android:id="@+id/view_quick_note_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:text="@string/larus_dora_view_quick_note_cn"
                android:textFontWeight="400"/>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:id="@+id/dora_gesture_wakeup_group_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_dora_quick_note_long_press_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_gesture_wakeup_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.dora.impl.dynamic.quicknote.views.QuickNoteItemTextSelectorSubTitle
                    android:id="@+id/dora_long_press_left"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="500"/>
                <com.larus.dora.impl.dynamic.quicknote.views.QuickNoteItemTextSelectorSubTitle
                    android:id="@+id/dora_long_press_right"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_7"
                android:layout_marginBottom="?attr/larus_dp_24"
                android:text="@string/larus_query_or_record_desc_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="400"/>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_tips_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_gesture_media_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.dora.impl.dynamic.quicknote.views.QuickNoteItemTextSelectorSubTitle
                    android:id="@+id/dora_double_click_left"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_quick_note_double_click_left_cn"
                    android:textFontWeight="500"/>
                <com.larus.dora.impl.dynamic.quicknote.views.QuickNoteItemTextSelectorSubTitle
                    android:id="@+id/dora_double_click_right"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_quick_note_double_click_right_cn"
                    android:textFontWeight="500"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_7"
                android:text="@string/larus_voice_reminder_desc_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:textFontWeight="400"/>
        </LinearLayout>
    </ScrollView>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_34"
        android:minHeight="?attr/larus_dp_56"
        android:text="@string/larus_dora_save_cn"
        android:maxLines="2"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
