<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_toast_container"
        android:background="@drawable/larus_toast_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_72"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:paddingStart="?attr/larus_dp_20"
        android:paddingEnd="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:elevation="?attr/larus_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/lottieAdapterView"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_15"
            android:layout_marginBottom="?attr/larus_dp_15"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textStyle="normal"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_17"
            android:layout_marginBottom="?attr/larus_dp_17"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
    </LinearLayout>
</merge>
