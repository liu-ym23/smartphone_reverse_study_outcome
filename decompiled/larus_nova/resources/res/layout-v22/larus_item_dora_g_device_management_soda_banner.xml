<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.item.ItemGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/soda_banner_root"
    android:padding="?attr/larus_dp_8"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_16"
    android:layout_marginStart="?attr/larus_dp_16"
    android:layout_marginEnd="?attr/larus_dp_16">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/soda_banner_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_10"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:layout_weight="1"
            android:layout_marginStart="?attr/larus_dp_8">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/soda_vip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_soda_membership_title_cn"
                android:textAlignment="viewStart"
                android:lineHeight="?attr/larus_dp_22"
                android:textFontWeight="500"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/soda_vip_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_2"
                android:text="@string/larus_dora_soda_membership_detail_cn"
                android:textAlignment="viewStart"
                android:lineHeight="?attr/larus_dp_16"
                android:textFontWeight="400"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <ImageView
            android:id="@+id/soda_vip_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_image_dora_soda_vip"/>
        <ImageView
            android:id="@+id/soda_vip_close"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_dora_soda_vip_close_btn"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.larus.bmhome.view.item.ItemGroup>
