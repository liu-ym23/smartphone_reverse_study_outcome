<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#4affffff"
    android:layout_width="100dp"
    android:layout_height="match_parent">
    <TextView
        android:textSize="10dp"
        android:textColor="#000000"
        android:id="@+id/mix_stream_type"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:maxLines="2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:id="@+id/chorus_tag"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:text="非连线副唱"
        android:textFontWeight="500"
        app:layout_constraintTop_toBottomOf="@+id/mix_stream_type"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/result_tv"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:text="选路结果:"
        android:textFontWeight="500"
        app:layout_constraintTop_toBottomOf="@+id/chorus_tag"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chorus_singer_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/result_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
