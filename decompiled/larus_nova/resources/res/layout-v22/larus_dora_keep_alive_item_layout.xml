<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dora_keep_alive_item_img"
        android:layout_width="?attr/larus_dp_214"
        android:layout_height="?attr/larus_dp_460"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/dora_keep_alive_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:maxWidth="?attr/larus_dp_214"
        android:maxLines="2"
        android:lines="2"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_keep_alive_item_img"/>
    <ImageView
        android:id="@+id/dora_keep_alive_item_img_load_failed"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:src="@drawable/larus_dora_ic_img_load_failed"
        app:layout_constraintBottom_toBottomOf="@+id/dora_keep_alive_item_img"
        app:layout_constraintEnd_toEndOf="@+id/dora_keep_alive_item_img"
        app:layout_constraintStart_toStartOf="@+id/dora_keep_alive_item_img"
        app:layout_constraintTop_toTopOf="@+id/dora_keep_alive_item_img"
        app:tint="@color/larus_neutral_30"/>
</androidx.constraintlayout.widget.ConstraintLayout>
