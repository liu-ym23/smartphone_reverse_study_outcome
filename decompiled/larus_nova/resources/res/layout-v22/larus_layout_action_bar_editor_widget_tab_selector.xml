<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="top"
        android:id="@+id/tab_selector_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_0"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_12"
        android:textFontWeight="500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tl_switch_tab"
        android:background="?attr/larus_bg_action_bar_instruction_widget_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_selector_sub_title"
        app:layout_goneMarginTop="?attr/larus_dp_0"
        app:tabBackground="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicator="?attr/larus_bg_action_bar_instruction_widget_tab_indicator"
        app:tabIndicatorColor="?attr/larus_base_4"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="?attr/larus_dp_36"
        app:tabMaxWidth="?attr/larus_dp_0"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="?attr/larus_neutral_100"
        app:tabTextAppearance="@style/larus_InstructionTabLayout"
        app:tabTextColor="?attr/larus_neutral_70"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
