<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v3_rec_in_shop_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_round"
        android:background="@color/BGReverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.RoundedFrameLayout
            android:id="@+id/rec_in_shop_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.shopping.widget.legacy.SquareImageView
                android:id="@+id/rec_in_shop_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderImage="@drawable/commerce_promotion_place_holder"
                app:placeholderImageScaleType="fitCenter"/>
            <View
                android:background="@color/commerce_color_08161823"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
        <TextView
            android:textColor="@color/TextReverse"
            android:ellipsize="end"
            android:id="@+id/tv_rec_in_shop_title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            style="@style/font_size_26"/>
        <RelativeLayout
            android:id="@+id/anchor_v3_recommend_price_info_layout"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:id="@+id/anchor_v3_rec_in_shop_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                app:pv_priceBold="true"
                app:pv_yuanSymbolMarginRight="2dp"/>
            <TextView
                android:textColor="@color/commerce_color_57161823"
                android:id="@+id/anchor_v3_tv_rec_in_shop_sales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/font_size_22"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
