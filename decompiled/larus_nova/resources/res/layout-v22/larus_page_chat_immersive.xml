<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.immerse.ChatImmerseConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="vertical"
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_container"
        android:background="@color/larus_static_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chat_container">
        <ProgressBar
            android:id="@+id/progress_bar"
            android:visibility="visible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="#ff777777"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/retry_container"
        android:background="@color/larus_static_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chat_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/larus_static_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/retry_icon"
                android:layout_width="?attr/larus_dp_60"
                android:layout_height="?attr/larus_dp_60"
                android:src="@drawable/larus_retry_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="#ffffffff"
                android:id="@+id/retry_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_22"
                android:text="@string/larus_AI_generate_reload"
                android:textFontWeight="400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/retry_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back_icon"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:minHeight="?attr/larus_dp_60"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginVertical="?attr/larus_dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_left_back"
            app:tint="?attr/larus_neutral_100"/>
        <ImageView
            android:id="@+id/discovery_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:src="@drawable/larus_discovery_icon"
            android:minHeight="?attr/larus_dp_60"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginVertical="?attr/larus_dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/larus_neutral_100"/>
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_dp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/chat_title_red_dot"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_30"
            app:layout_constraintBottom_toBottomOf="@+id/back_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/back_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.bmhome.chat.immerse.ChatImmerseConstraintLayout>
