<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ttlive_ktv_seat_list_root"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_anchor_avatar_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/ktv_anchor_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:placeholderImage="@drawable/ttlive_ic_default_avatar"
            app:roundAsCircle="true"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/ktv_anchor_silence_bg"
            android:background="@drawable/ttlive_icon_ktv_seat_mute"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:layout_gravity="center"
            android:id="@+id/leave_view"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/ktv_anchor_effect"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/ktv_anchor_seat_anim_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_anchor_label_container"
            android:background="@drawable/ttlive_ktv_room_seat_label_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginTop="36dp"
            android:minWidth="18dp">
            <TextView
                android:textSize="8dp"
                android:textColor="@color/ttlive_white"
                android:id="@+id/ktv_anchor_text_label"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ktv_anchor_icon_label"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ttlive_icon_ktv_room_seat_microphone"/>
        </FrameLayout>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_room_seat_tag_label"
            android:background="@drawable/ttlive_ktv_room_seat_label_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginTop="36dp"
            android:minWidth="18dp"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/ktv_host_list"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/divider"
        android:background="#33ffffff"
        android:layout_width="0.5dp"
        android:layout_height="20dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/ktv_seat_list"
        android:fadingEdgeLength="16dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:requiresFadingEdge="horizontal"/>
</LinearLayout>
