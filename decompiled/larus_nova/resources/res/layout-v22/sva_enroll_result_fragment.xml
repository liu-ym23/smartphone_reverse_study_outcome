<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oFloatingTitleBar_maskBlurRadius="8"
                app:oFloatingTitleBar_statusBarImmersion="true"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/result_guideline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintGuide_begin="96dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guide_page"
            android:background="@color/sva_transparent"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_guideline">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/guide_content_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/result_hint_section"
                    android:background="@color/sva_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/page_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/sva_lottie_voiceprint_record_success"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_26"
                        android:textColor="@color/neutral_100"
                        android:gravity="center"
                        android:id="@+id/page_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_21"
                        android:text="@string/sva_record_completed"
                        android:lines="1"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/neutral_70"
                        android:gravity="center"
                        android:id="@+id/page_tips"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/sva_failed_tips_record_again"
                        android:lines="2"
                        android:lineHeight="20sp"
                        android:textFontWeight="400"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/voice_hint"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/result_hint_section">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/obric_guide_text_3"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginLeft="32dp"
                        android:layout_marginRight="32dp"
                        android:text="@string/sva_enroll_apply_voice_print"
                        android:layout_marginHorizontal="32dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/switcher_section"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:showDividers="none"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/voice_hint">
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/voice_wake_up_section"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_top"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_switch"
                        app:ocardlistitem_showCardBg="true"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/sva_voice_wake_up"/>
                    <com.obric.oui.lisitem.OCardListItem
                        android:id="@+id/help_improve_voice_wake_up_section"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ocardlistitem_cardPosition="position_bottom"
                        app:ocardlistitem_cardType="type_normal"
                        app:ocardlistitem_defaultCustomEnd="end_switch"
                        app:ocardlistitem_showCardBg="true"
                        app:ocardlistitem_showCustomEnd="true"
                        app:ocardlistitem_showTitle="true"
                        app:ocardlistitem_title="@string/obric_setting_improve_voice_wakeup"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_area"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_62"
                    android:layout_marginBottom="@dimen/dp_26"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/switcher_section"
                    app:layout_constraintVertical_bias="1">
                    <com.obric.oui.button.OButton
                        android:textColor="@color/neutral_100"
                        android:gravity="center"
                        android:id="@+id/know_button"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_338"
                        android:layout_height="@dimen/dp_52"
                        android:text="@string/sva_enroll_know"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/OStyleV2.OButton.L.Trans.Primary"/>
                    <com.obric.oui.button.OButton
                        android:gravity="center"
                        android:id="@+id/finish_button"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_338"
                        android:layout_height="@dimen/dp_52"
                        android:text="@string/sva_enroll_done"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
