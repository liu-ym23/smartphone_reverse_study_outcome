<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/ec_store_popup_menu_elevation">
        <androidx.cardview.widget.CardView
            android:layout_gravity="end"
            android:id="@+id/fans_group_bubble_triangle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/ec_store_popup_menu_radius"
            android:layout_marginBottom="-16dp"
            android:rotation="45"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            app:cardBackgroundColor="@color/ec_store_fans_group_bubble_background"
            app:cardCornerRadius="4dp"
            app:cardElevation="4dp"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:layout_marginHorizontal="26dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp">
        <LinearLayout
            android:id="@+id/fans_group_bubble_wrappar"
            android:background="@color/ec_store_fans_group_bubble_background"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/fans_group_bubble_prompt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/fans_group_bubble_separator"
                android:background="#33ffffff"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ec_store_fans_group_bubble_text_color_yellow"
                android:ellipsize="end"
                android:id="@+id/fans_group_bubble_read_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/fans_group_bubble_more_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ec_store_join_fans_group_arrow"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
