<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dora_content"
    android:background="@color/larus_dora_g_onboarding_base_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraMovieView
        android:layout_gravity="center"
        android:id="@+id/dora_onboarding_mv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dora_onboarding_bottom_desc_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_30"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_bottom_btn_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/dora_onboarding_done"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_62"
            android:layout_height="?attr/larus_dp_62"
            android:src="@null"/>
        <com.larus.dora.impl.view.DoraTextViewWithAnim
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/dora_onboarding_bottom_desc_level_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textFontWeight="500"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:id="@+id/dora_onboarding_bottom_desc_level_two"
            android:padding="?attr/larus_dp_8"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:paddingHorizontal="?attr/larus_dp_12"
            android:textFontWeight="500"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/dora_onboarding_query_image_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_135"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_54"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_bottom_desc_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/dora_onboarding_query_image"
            android:background="@drawable/larus_dora_onboarding_query_image_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:outlineProvider="background"
            android:clipToOutline="true"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/dora_onboarding_query_image_mask"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_100"
            android:alpha="0.4"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginRight="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:text="@string/larus_dora_g_onboard_disclaimer_cn"
            android:layout_marginHorizontal="?attr/larus_dp_24"
            android:textFontWeight="500"/>
    </FrameLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_23"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dora_onboarding_wakeup_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_32"
        android:text="@string/larus_dora_onboarding_wakeup_title_cn"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_avatar"/>
    <com.larus.dora.impl.view.DoraUrlSpanTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/dora_onboarding_wakeup_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_32"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        android:textFontWeight="400"
        app:larus_linkColor="@color/larus_neutral_100"
        app:larus_linkUnderLine="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_wakeup_title"/>
    <View
        android:id="@+id/dora_onboarding_avatar_anchor_view"
        android:layout_width="?attr/larus_dp_132"
        android:layout_height="?attr/larus_dp_132"
        android:layout_marginTop="?attr/larus_dp_170"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/dora_onboarding_bubble_bg_anchor_view"
        android:layout_width="?attr/larus_dp_120"
        android:layout_height="?attr/larus_dp_120"
        android:layout_marginBottom="?attr/larus_dp_72"
        android:layout_marginStart="?attr/larus_dp_72"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar_anchor_view"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_avatar_anchor_view"/>
    <View
        android:id="@+id/dora_onboarding_bubble_anchor_view"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_80"
        android:layout_marginBottom="?attr/larus_dp_92"
        android:layout_marginStart="?attr/larus_dp_92"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar_anchor_view"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_avatar_anchor_view"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_23"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dora_onboarding_query_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_35"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginHorizontal="?attr/larus_dp_32"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_avatar_anchor_view"/>
    <com.larus.dora.impl.onboarding.g.v2.DoraGOnboardingTopicView
        android:id="@+id/dora_onboarding_query_topic_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_32"
        android:maxHeight="?attr/larus_dp_300"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_bottom_btn_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_query_title"/>
    <View
        android:id="@+id/dora_onboarding_query_topic_mask_view"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_query_topic_view"
        app:layout_constraintEnd_toEndOf="@+id/dora_onboarding_query_topic_view"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_query_topic_view"
        app:layout_constraintTop_toTopOf="@+id/dora_onboarding_query_topic_view"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/dora_onboarding_avatar"
        android:background="@drawable/larus_bg_realtime_call_white_round"
        android:layout_width="?attr/larus_dp_198"
        android:layout_height="?attr/larus_dp_198"
        android:layout_marginTop="?attr/larus_dp_210"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:roundedCornerRadius="?attr/larus_dp_117"/>
    <ImageView
        android:id="@+id/dora_onboarding_bubble_bg"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_160"
        android:layout_marginBottom="?attr/larus_dp_118"
        android:src="@drawable/larus_dora_onboarding_speaking_bubble_bg"
        android:alpha="0.6"
        android:layout_marginStart="?attr/larus_dp_118"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_avatar"/>
    <RelativeLayout
        android:id="@+id/dora_onboarding_bubble_speaking"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_100"
        android:layout_marginBottom="?attr/larus_dp_148"
        android:layout_marginStart="?attr/larus_dp_148"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_avatar">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/dora_onboarding_bubble_speaking_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <com.larus.common_ui.view.CustomBarCountAudioVisualizer
            android:id="@+id/dora_onboarding_bubble_audio_anim"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_30"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/dora_onboarding_bubble_thinking"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_100"
        android:layout_marginBottom="?attr/larus_dp_148"
        android:layout_marginStart="?attr/larus_dp_148"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar"
        app:layout_constraintStart_toStartOf="@+id/dora_onboarding_avatar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <include
        android:id="@+id/dora_onboarding_bottom_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/larus_dora_g_onboarding_bottom_btn_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
