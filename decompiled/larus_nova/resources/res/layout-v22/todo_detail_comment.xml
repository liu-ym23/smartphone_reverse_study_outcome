<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/commentTitleLl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/Todo_Task_Comment"
            android:layout_marginHorizontal="16dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/creator_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <ImageView
                android:layout_width="8sp"
                android:layout_height="8sp"
                android:layout_marginTop="@dimen/dp_6"
                android:src="@drawable/todo_circle_icon_detail_create"
                android:layout_marginStart="@dimen/dp_10"/>
            <com.ss.android.lark.widget.light.LKUILightTextView
                android:textColor="@color/text_title"
                android:id="@+id/creator_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/dp_4"
                android:layout_marginStart="@dimen/dp_38"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/commentShowMoreLl"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:minHeight="24dp"
            android:layout_marginStart="12dp">
            <ImageView
                android:id="@+id/commentShowMoreIv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/todo_svg_icon_loading"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="@color/text_placeholder"
                android:id="@+id/commentShowMoreTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Legacy_LoadingNow"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/commentSkeletonFl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/comment_load_fail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_28">
            <ImageView
                android:id="@+id/comment_load_status_iv"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:src="@drawable/illustration_placeholder_common_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:gravity="center"
                android:id="@+id/comment_load_status_tv"
                android:layout_width="216.5dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/Todo_Task_LoadFailedTryAgainLater"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
