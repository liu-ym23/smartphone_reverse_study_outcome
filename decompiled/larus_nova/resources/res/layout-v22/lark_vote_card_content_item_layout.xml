<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.vote.message.cell.MaxHeightConstrainLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vote_cell_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vote_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:scaleType="centerInside"
                android:tint="@color/udtoken_message_card_text_indigo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_vote_colorful"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/udtoken_message_card_text_indigo"
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/vote_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/options_rv"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/title_layout"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/participant_number_layout"
        android:paddingLeft="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/options_rv"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/options_rv">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:id="@+id/number_of_participants_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:id="@+id/actual_participant_number_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="14sp"
        android:textColor="@color/ud_button_grey_text"
        android:gravity="center"
        android:id="@+id/action_btn"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/participant_number_layout"
        app:ud_backgroundColor="@color/ud_button_white_grey_bg"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"
        style="@style/UDButton.Big.Column"/>
    <View
        android:id="@+id/item_show_more"
        android:background="@drawable/lark_vote_bg_show_more"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/item_show_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_show_more"
        app:ud_shadow_radius="73dp"
        style="@style/UDShadow.S2.Down">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/ud_bg_action_panel_item_corners"
            android:paddingLeft="20dp"
            android:paddingTop="6dp"
            android:paddingRight="20dp"
            android:paddingBottom="6dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/Lark_IM_Poll_Detail_AllOptions_Button"/>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    <com.larksuite.component.autolinearlayout.AutoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_operate_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_12"
        android:divider="@drawable/lark_vote_bg_operate_button_divider"
        android:showDividers="middle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/participant_number_layout">
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/retransmit_vote"
            android:tag="primary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="@string/Lark_IM_Poll_Result_ResendPollMessageToChat_Button"
            android:layout_weight="1"
            app:ud_backgroundColor="@color/ud_button_white_grey_bg"
            app:ud_radius="m"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Middle"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/close_vote"
            android:tag="secondary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="@string/Lark_IM_Poll_Result_EndPoll_Button"
            android:layout_weight="1"
            app:ud_backgroundColor="@color/ud_button_white_grey_bg"
            app:ud_radius="m"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Middle"/>
    </com.larksuite.component.autolinearlayout.AutoLinearLayout>
</com.ss.android.lark.vote.message.cell.MaxHeightConstrainLayout>
