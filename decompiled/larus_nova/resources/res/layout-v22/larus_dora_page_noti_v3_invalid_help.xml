                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="?attr/larus_neutral_50"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_broadcast_v3_troubleshoot_multi_device_desc_cn"/>
            </LinearLayout>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_5"
                android:text="@string/larus_dora_broadcast_v3_troubleshoot_footer_desc_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_4"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
