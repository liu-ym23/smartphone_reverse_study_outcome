                android:paddingHorizontal="?attr/larus_dp_16"
                android:paddingVertical="?attr/larus_dp_16">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="?attr/larus_neutral_100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_broadcast_v3_troubleshoot_lock_screen_title_cn"
                    android:textFontWeight="600"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="?attr/larus_neutral_50"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
