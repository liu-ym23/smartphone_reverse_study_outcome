<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dora_content"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dora_wifi_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:overScrollMode="ifContentScrolls"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/dora_wifi_add_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_bias="0"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/dora_wifi_add_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:minHeight="?attr/larus_dp_56"
        android:text="@string/larus_dora_wifi_add_btn_cn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="?attr/larus_dp_520"/>
    <include
        android:id="@+id/dora_g_onboarding_bottom_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginHorizontal="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/larus_dora_g_onboarding_bottom_btn_layout"/>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
