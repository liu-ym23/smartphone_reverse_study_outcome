<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/to_user_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:maxWidth="200dp"
        android:text="@string/ttlive_talk_room_interact_emoji_dialog_title"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/img_avatar"
        android:background="@drawable/ttlive_profile_avatar_bg_oval_black"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overlayImage="@drawable/ttlive_profile_avatar_overlay_mask"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/bullet_color_161823"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="18dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/set_position_name"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.view.GuestHonorView
        android:id="@+id/view_guest_honor"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:id="@+id/set_position_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_edit_linkmic_position_and_name_hint"
        android:alpha="0.5"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_action_list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_avatar"/>
    <View
        android:id="@+id/divider"
        android:background="#19000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_action_list"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/emoji_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_talk_room_emoji_dialog_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_emoji_list"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:paddingHorizontal="9dp"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#525252"
        android:gravity="center"
        android:id="@+id/empty_list_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text="@string/ttlive_talk_room_emoji_list_error_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/list_loading_webp_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
