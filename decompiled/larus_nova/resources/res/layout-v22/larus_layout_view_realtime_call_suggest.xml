<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_static_black"
        android:gravity="center"
        android:id="@+id/suggest_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_call_suggested_prompts_title"
        android:alpha="0.5"
        android:lineHeight="?attr/larus_dp_17"
        android:textFontWeight="500"
        app:layout_constraintBottom_toTopOf="@+id/suggest_switcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextSwitcher
        android:id="@+id/suggest_switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/suggest_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
