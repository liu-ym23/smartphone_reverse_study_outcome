<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/ttlive_bg_ktv_component_mini_operate_panel"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="183dp"
    android:layout_height="28dp"
    android:paddingHorizontal="8dp">
    <ImageView
        android:id="@+id/function_pause_start"
        android:background="@drawable/ttlive_ktv_mv_stop_sing_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/ttlive_ktv_sing_pause"/>
    <ImageView
        android:id="@+id/function_turn_next"
        android:background="@drawable/ttlive_ktv_component_top_bar_turn_ic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/ttlive_ktv_sing_next_song"/>
    <ImageView
        android:id="@+id/function_adjust"
        android:background="@drawable/ttlive_ktv_mv_tone_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/ttlive_ktv_sing_adjust_song"/>
    <ImageView
        android:id="@+id/function_origin"
        android:background="@drawable/ttlive_ktv_mv_origin_closed"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/ttlive_ktv_sing_original"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/score_container"
        android:layout_width="20dp"
        android:layout_height="20dp">
        <ImageView
            android:id="@+id/function_score"
            android:background="@drawable/ttlive_ktv_score_opened"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/ttlive_ktv_score"/>
        <ImageView
            android:id="@+id/function_challenge"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ktv_challenge_closed_btn"
            android:scaleType="fitCenter"
            android:contentDescription="@string/ttlive_ktv_challenge_desc"/>
        <View
            android:id="@+id/ktv_challenge_dot_view"
            android:background="@drawable/ttlive_ic_setting_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintRight_toRightOf="@+id/function_challenge"
            app:layout_constraintTop_toTopOf="@+id/function_challenge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
