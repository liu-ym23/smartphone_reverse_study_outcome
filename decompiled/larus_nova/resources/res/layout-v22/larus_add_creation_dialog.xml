<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_bottom_sheet"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_add_creation_dialog_close"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_48"
        android:text="@string/larus_add_creation_public"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/tips"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingRight="?attr/larus_dp_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_add_creation_public_tips"
        android:paddingHorizontal="?attr/larus_dp_24"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintTop_toBottomOf="@+id/tips">
        <Space
            android:id="@+id/anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_private"
            android:background="?attr/larus_private_text_button"
            android:layout_width="?attr/larus_dp_173"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_add_creation_private"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="?attr/larus_dp_6"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/anchor"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/tv_public"
            android:background="?attr/larus_public_text_button"
            android:layout_width="?attr/larus_dp_173"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_visibility_double_check_public"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/anchor"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
