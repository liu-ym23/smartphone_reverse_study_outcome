<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_dora_wifi_add_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_28"
        android:paddingHorizontal="?attr/larus_dp_16">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_wifi_add_title_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_dora_wifi_add_cancel_btn_selector"
                android:id="@+id/dora_wifi_add_cancel_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_dialog_btn_cancel_cn"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/dora_wifi_add_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_wifi_input_pwd_cn"
                android:textFontWeight="600"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_dora_wifi_add_btn_selector"
                android:id="@+id/dora_wifi_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_btn_add_cn"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ProgressBar
                android:id="@+id/dora_wifi_add_progress_bar"
                android:padding="?attr/larus_dp_10"
                android:layout_width="?attr/larus_dp_40"
                android:layout_height="?attr/larus_dp_40"
                android:indeterminateDrawable="@drawable/larus_dora_loading"
                android:indeterminateDuration="750"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.bmhome.view.item.ItemGroupTitle
            android:id="@+id/dora_wifi_ssid_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_wifi_add_title_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_wifi_pwd_layout"
            android:background="@drawable/larus_bg_item_selector"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_56"
            android:paddingHorizontal="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_wifi_ssid_text_view">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/dora_wifi_pwd_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_wifi_pwd_cn"
                android:textFontWeight="500"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_wifi_pwd_edit_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/dora_wifi_pwd_edit_text"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_wifi_pwd_eye_img_view"
                app:layout_constraintStart_toEndOf="@+id/dora_wifi_pwd_label"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/dora_wifi_pwd_eye_img_view"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_dora_wifi_eye_close_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_wifi_pwd_edit_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_550"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_wifi_pwd_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
