<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_dora_bg_notification_broadcast_mode_sheet"
    android:paddingBottom="?attr/larus_dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_18"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/dora_noti_v3_mode_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="@+id/dora_noti_v3_mode_sheet_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dora_noti_v3_mode_sheet_close"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dora_noti_v3_mode_sheet_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="?attr/larus_dp_2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_16"
        android:src="@drawable/larus_dora_ic_notification_broadcast_close"
        android:contentDescription="@string/larus_broadcast_app_turnoff_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dora_noti_v3_mode_sheet_options"
        android:background="@drawable/larus_dora_bg_notification_broadcast_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@+id/dora_noti_v3_mode_sheet_close">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_noti_v3_mode_option_primary"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_56"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/dora_noti_v3_mode_option_primary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:textFontWeight="500"
                app:layout_constraintBottom_toTopOf="@+id/dora_noti_v3_mode_option_primary_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_primary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/dora_noti_v3_mode_option_primary_subtitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_2"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_primary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_noti_v3_mode_option_primary_text"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dora_noti_v3_mode_option_primary_selected"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_dora_ic_notification_broadcast_check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dora_noti_v3_mode_divider_1"
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="?attr/larus_dp_16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_noti_v3_mode_option_secondary"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_56"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/dora_noti_v3_mode_option_secondary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:textFontWeight="500"
                app:layout_constraintBottom_toTopOf="@+id/dora_noti_v3_mode_option_secondary_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_secondary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/dora_noti_v3_mode_option_secondary_subtitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_2"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_secondary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_noti_v3_mode_option_secondary_text"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dora_noti_v3_mode_option_secondary_selected"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_dora_ic_notification_broadcast_check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dora_noti_v3_mode_divider_2"
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="?attr/larus_dp_16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_noti_v3_mode_option_tertiary"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_56"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/dora_noti_v3_mode_option_tertiary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/larus_dp_12"
                android:textFontWeight="500"
                app:layout_constraintBottom_toTopOf="@+id/dora_noti_v3_mode_option_tertiary_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_tertiary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/dora_noti_v3_mode_option_tertiary_subtitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_2"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_mode_option_tertiary_selected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_noti_v3_mode_option_tertiary_text"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dora_noti_v3_mode_option_tertiary_selected"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_dora_ic_notification_broadcast_check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
