<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bg_shadow"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_120"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/fl_audio_visualizer"/>
    <ImageView
        android:id="@+id/bg_full_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_420"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.common_ui.blur.BlurCircleWithAmplitude
        android:id="@+id/blur_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:larus_circle_autoStartAnim="false"
        app:larus_circle_blurRadius="?attr/larus_dp_48"
        app:larus_circle_highlightRadius="?attr/larus_dp_120"
        app:larus_circle_radiusRatio="0.8"
        app:larus_circle_rectHeight="?attr/larus_dp_160"
        app:larus_circle_scale="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="664dp"/>
    <View
        android:id="@+id/left_group_shadow"
        android:background="@drawable/larus_fast_button_bg_shadow"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_150"
        android:layout_height="?attr/larus_dp_150"
        app:layout_constraintBottom_toBottomOf="@+id/left_group"
        app:layout_constraintEnd_toEndOf="@+id/left_group"
        app:layout_constraintStart_toStartOf="@+id/left_group"
        app:layout_constraintTop_toTopOf="@+id/left_group"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_92"
        android:layout_marginStart="?attr/larus_dp_50"
        app:layout_constraintBottom_toTopOf="@+id/fl_audio_visualizer"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/left_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_icon_speaker_cancel_light"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/left_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_6"
            android:maxLines="1"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/left_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/right_group_shadow"
        android:background="@drawable/larus_fast_button_bg_shadow"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_150"
        android:layout_height="?attr/larus_dp_150"
        app:layout_constraintBottom_toBottomOf="@+id/right_group"
        app:layout_constraintEnd_toEndOf="@+id/right_group"
        app:layout_constraintStart_toStartOf="@+id/right_group"
        app:layout_constraintTop_toTopOf="@+id/right_group"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_92"
        android:layout_marginEnd="?attr/larus_dp_50"
        app:layout_constraintBottom_toTopOf="@+id/fl_audio_visualizer"
        app:layout_constraintEnd_toEndOf="parent"
        app:rv_backgroundColor="?attr/larus_primary_transparent_1">
        <ImageView
            android:id="@+id/right_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_icon_speaker_speech_light"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_primary_50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/right_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_6"
            android:maxLines="1"
            android:textFontWeight="500"
            app:layout_constraintBottom_toTopOf="@+id/right_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="?attr/larus_dp_13"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:maxWidth="664dp"
        android:text="@string/larus_hold_to_speak_note"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/fl_audio_visualizer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_audio_visualizer"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="664dp">
        <View
            android:id="@+id/audio_visualizer_bg"
            android:background="?attr/larus_bg_audio_speak"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/audio_visualizer"
            app:layout_constraintEnd_toEndOf="@+id/audio_visualizer"
            app:layout_constraintStart_toStartOf="@+id/audio_visualizer"
            app:layout_constraintTop_toTopOf="@+id/audio_visualizer"/>
        <FrameLayout
            android:id="@+id/audio_visualizer"
            android:background="?attr/larus_bg_audio_visualizer"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:layout_marginHorizontal="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="366dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
