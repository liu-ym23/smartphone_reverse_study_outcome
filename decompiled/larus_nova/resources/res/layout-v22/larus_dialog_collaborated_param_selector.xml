<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_collaborated_param_panel"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/collaborated_param_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_collaborated_param_panel_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_56"
            android:layout_marginEnd="?attr/larus_dp_56"
            android:textFontWeight="600"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_collaborated_param_panel_close"
            android:padding="?attr/larus_dp_6"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:srcCompat="?attr/larus_ic_close_dialog_btn"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/collaborated_param_selector_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:fillViewport="false"
        android:fadeScrollbars="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/collaborated_param_bottom_bar"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/tv_collaborated_param_confirm"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_aiCreation_paraBottomSheet_btn_confirm"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_16"/>
    </LinearLayout>
</LinearLayout>
