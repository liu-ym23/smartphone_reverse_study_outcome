<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_team_fight_apply_select_team_panel_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:paddingHorizontal="12dp">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/red_team_apply_btn"
            android:background="@drawable/ttlive_bg_team_fight_red_team_apply"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            android:layout_marginEnd="7dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ttlive_team_fight_apply_red_team_btn_bg"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/ttlive_team_fight_red_team"/>
        </FrameLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/blue_team_apply_btn"
            android:background="@drawable/ttlive_bg_team_fight_blue_team_apply"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ttlive_team_fight_apply_blue_team_btn_bg"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/ttlive_team_fight_blue_team"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
