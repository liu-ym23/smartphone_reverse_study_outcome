<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.tetris.vr.VrAudienceCursorView
        android:id="@+id/vrCursorContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="33dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ttlive_close_in_top_container_shadow"
        android:contentDescription="@string/ttlive_label_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/exit_vr_mode"
        android:background="@drawable/ttlive_bg_vr_mode_exit_vr_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="33dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/exit_vr_mode_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ttlive_vr_mode_exit_vr_icon"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#b2ffffff"
            android:gravity="right"
            android:layout_gravity="center"
            android:id="@+id/exit_vr_mode_text"
            android:paddingLeft="4dp"
            android:paddingRight="13dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:text="@string/ttlive_vr_exit_vr_mode"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="13dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/open_vr_viewport_reset"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="33dp"
        android:src="@drawable/ttlive_ic_vr_reset_viewport"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open_vr_sensor"/>
    <ImageView
        android:id="@+id/open_vr_sensor"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="33dp"
        android:src="@drawable/ttlive_ic_vr_sensor_open"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/exit_vr_mode"/>
    <com.bytedance.android.livesdk.chatroom.tetris.vr.ui.RecenterGuideView
        android:id="@+id/recenterGuideView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
