<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet_music_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintDimensionRatio="H,1:1"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundedCornerRadius="?attr/larus_dp_16"/>
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/cover_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/mute_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_nex_pulse_dialog_mute"
        app:layout_constraintBottom_toBottomOf="@+id/cover_video"
        app:layout_constraintEnd_toEndOf="@+id/cover_video"/>
    <View
        android:id="@+id/close_btn"
        android:background="@drawable/larus_ic_close_circle"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginTop="?attr/larus_dp_8"
        android:contentDescription="@string/larus_accessibility_icon_close"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:padding="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/select_privacy_text_view"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_privacy_text_view"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:includeFontPadding="false"
        android:textFontWeight="400"
        app:layout_constraintBottom_toTopOf="@+id/select_view"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/select_view"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/confirm_btn">
        <CheckBox
            android:gravity="top"
            android:id="@+id/select_privacy_circle_view"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_0_5"
            android:checked="false"
            android:button="@drawable/larus_digital_avatar_select_circle_view"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_0_5"
            android:includeFontPadding="false"
            android:textFontWeight="400"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/larus_bg_digital_avatar_create_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginHorizontal="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
