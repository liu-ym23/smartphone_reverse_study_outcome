<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopping_homepage_layout_native_delivery_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/left_start"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toStartOf="@+id/left_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/left_divider"
        android:background="#8a8b91"
        android:layout_width="36dp"
        android:layout_height="1dp"
        android:layout_marginTop="19.75dp"
        android:alpha="0.3"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_text"
        app:layout_constraintStart_toEndOf="@+id/left_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="#8a8b91"
        android:gravity="center_horizontal"
        android:id="@+id/tv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11.5dp"
        android:layout_marginBottom="10.5dp"
        android:maxWidth="270dp"
        android:text=""
        android:fontFamily="sans-serif"
        android:lineHeight="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_divider"
        app:layout_constraintStart_toEndOf="@+id/left_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right_divider"
        android:background="#8a8b91"
        android:layout_width="36dp"
        android:layout_height="1dp"
        android:layout_marginTop="19.75dp"
        android:alpha="0.3"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/right_start"
        app:layout_constraintStart_toEndOf="@+id/tv_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right_start"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/right_divider"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
