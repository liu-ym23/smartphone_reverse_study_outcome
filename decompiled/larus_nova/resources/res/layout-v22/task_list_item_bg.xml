<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/task_list_container_content"
    android:background="@color/bg_body"
    android:padding="16dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_1">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/task_list_container_view"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/task_list_icon"
            android:layout_width="24sp"
            android:layout_height="24sp"
            android:layout_marginTop="2dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/task_list_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/task_list_archived_img"
                    android:layout_alignParentLeft="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/task_list_archived_img"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    android:layout_marginLeft="@dimen/dp_8"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/ud_icon_massage_box_out_outlined"
                    app:tint="@color/icon_n3"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/task_list_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_4"
                android:minHeight="24dp">
                <com.larksuite.component.universe_design.image.UDAvatar
                    android:id="@+id/task_list_owner_avatar"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:src="@drawable/todo_at_all"
                    app:ud_avatar_size="20sp"
                    style="@style/UDAvatar.Circle"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:id="@+id/task_list_owner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_6"
                    android:maxWidth="@dimen/dp_120"
                    android:singleLine="true"/>
                <View
                    android:id="@+id/task_info_divider"
                    android:background="@color/ud_divider_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="12sp"
                    android:layout_marginLeft="@dimen/dp_8"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/task_list_sections_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_4"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
