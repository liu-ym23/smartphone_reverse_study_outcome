<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_dora_card_white_rounded"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginTop="?attr/larus_dp_16"
    android:layout_marginRight="?attr/larus_dp_16"
    android:layout_marginHorizontal="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_17"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_icon_dora_note"
            app:tint="@color/larus_neutral_100"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_lab_dairy_cn"
            android:layout_marginStart="?attr/larus_dp_8"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/title_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title_text">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_sharesheet_more"
                android:textFontWeight="400"/>
            <ImageView
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_12"
                android:src="@drawable/larus_dora_g_device_management_more_icon"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_state_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <ImageView
            android:id="@+id/loading_image"
            android:layout_width="?attr/larus_dp_326"
            android:layout_height="?attr/larus_dp_66"
            android:src="@drawable/larus_dora_g_device_management_daily_loading"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/sub_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下次更新时间13:40"
            android:textFontWeight="400"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/content_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:text="从此刻开始，基于环境记忆，眼镜开始记录你的日常，为你编写日..."
            android:maxLines="2"
            android:lineSpacingExtra="?attr/larus_dp_8"
            android:textFontWeight="400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/thumbnail_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sub_title_text"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/thumbnail_image"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_62"
            android:layout_height="?attr/larus_dp_62"
            android:layout_marginTop="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sub_title_text"
            app:layout_constraintWidth_default="wrap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/empty_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/empty_state_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_device_env_memory_on_cn"
            android:layout_weight="1"
            android:textFontWeight="400"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/primary_50"
            android:id="@+id/empty_state_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_device_go_enable_cn"
            android:layout_marginStart="?attr/larus_dp_8"
            android:textFontWeight="500"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
