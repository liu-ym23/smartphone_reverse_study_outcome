<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/account_saas_bg_round_login_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/account_saas_dp_18"
        android:textColor="@color/account_saas_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_saas_dp_24"
        android:layout_marginTop="@dimen/account_saas_dp_24"
        android:layout_marginRight="@dimen/account_saas_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/account_saas_dp_24"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="@dimen/account_saas_dp_15"
        android:textColor="@color/account_saas_neutral_50"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/account_saas_dp_24"
        android:layout_marginTop="@dimen/account_saas_dp_8"
        android:layout_marginRight="@dimen/account_saas_dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/account_saas_dp_24"
        android:textFontWeight="400"/>
    <TextView
        android:textSize="@dimen/account_saas_dp_17"
        android:textColor="@color/account_saas_base_1"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/account_saas_bg_align_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/account_saas_dp_56"
        android:layout_marginLeft="@dimen/account_saas_dp_16"
        android:layout_marginTop="@dimen/account_saas_dp_24"
        android:layout_marginRight="@dimen/account_saas_dp_16"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/account_saas_dp_16"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="@dimen/account_saas_dp_17"
        android:textColor="@color/account_saas_neutral_70"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_saas_dp_16"
        android:layout_marginBottom="@dimen/account_saas_dp_16"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="400"/>
</LinearLayout>
