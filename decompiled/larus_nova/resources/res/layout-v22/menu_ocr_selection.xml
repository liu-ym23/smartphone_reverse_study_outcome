<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/UDShadow.S2.Down">
    <com.ss.android.lark.widget.photo.preview.ocr.BubbleLayout
        android:id="@+id/bubble_layout"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/iv_arrow_left_container"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_arrow_left"
                    android:visibility="visible"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:srcCompat="@drawable/ud_icon_expand_left_filled"
                    app:tint="@color/icon_n2"/>
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_menu_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <FrameLayout
                android:id="@+id/iv_arrow_right_container"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_arrow_right"
                    android:visibility="visible"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:srcCompat="@drawable/ud_icon_expand_left_filled"
                    app:tint="@color/icon_n2"/>
            </FrameLayout>
        </LinearLayout>
    </com.ss.android.lark.widget.photo.preview.ocr.BubbleLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
