<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/select_title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <LinearLayout
        android:background="@color/bg_body"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.suite.lark.emm.design.edittext.SCEditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:id="@+id/search_text"
            android:background="@drawable/detail_task_list_search_bg"
            android:paddingTop="@dimen/dp_9"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:hint="@string/Todo_Task_SearchTask"
            android:singleLine="true"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/ud_icon_search_outlined"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:drawableTint="@color/icon_n2"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/loading_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:srcCompat="@drawable/todo_svg_icon_loading"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/task_lists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100">
        <ImageView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_100"
            app:srcCompat="@drawable/illustration_empty_neutral_search_failed"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_17"
            android:text="@string/Lark_Legacy_SearchNoAnyResult"/>
    </LinearLayout>
</LinearLayout>
