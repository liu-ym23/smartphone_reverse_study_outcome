<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dora_o_bg_card"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/larus_base_2">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/album_title"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_album_album_cn"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <com.obric.oui.button.OButtonLink
            android:id="@+id/album_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_widgetText="@string/larus_dora_o_album_view_all"
            app:oui_widgetTextColor="@color/oui_basic_text_3"
            style="@style/OStyleV2.OButtonLink.S.ChevronTrailing"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/album_images_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center"
            android:id="@+id/album_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            android:text="@string/larus_dora_o_album_empty"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sync_status_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10">
        <ProgressBar
            android:id="@+id/sync_status_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:indeterminateDrawable="@drawable/dora_o_progress_sync"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <ImageView
            android:id="@+id/sync_status_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:importantForAccessibility="no"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/dora_o_text_secondary"
            android:id="@+id/sync_status_text"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/oui_accent_6_bg"
            android:id="@+id/sync_action_btn"
            android:paddingLeft="?attr/larus_dp_4"
            android:paddingTop="?attr/larus_dp_2"
            android:paddingRight="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_album_to_sync_cn"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="?attr/larus_dp_4"
            android:paddingVertical="?attr/larus_dp_2"/>
    </LinearLayout>
</LinearLayout>
