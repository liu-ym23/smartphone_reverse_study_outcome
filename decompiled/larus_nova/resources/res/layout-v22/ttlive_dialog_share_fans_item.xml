<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_icon_share_fans_item"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_share_fans_item_black"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_share_fans_item_title"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintRight_toLeftOf="@+id/share_button"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_share_fans_item_desc"
        android:gravity="start|center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_share_fans_item_desc"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintRight_toLeftOf="@+id/share_button"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_share_fans_item_black"
        android:gravity="center"
        android:id="@+id/share_button"
        android:background="@drawable/ttlive_bg_long_press_share_fans_btn"
        android:visibility="visible"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_share_fans_item_share"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_share_fans_item_gray"
        android:gravity="center"
        android:id="@+id/shared_button"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_share_fans_item_shared"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/ttlive_std_line_black_2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
