<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextureView
        android:id="@+id/sf_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/preview_start_btn"
        android:background="@drawable/ttlive_solo_ktv_preview_play_ic"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        app:layout_constraintBottom_toBottomOf="@+id/sf_preview_texture_view"
        app:layout_constraintLeft_toLeftOf="@+id/sf_preview_texture_view"
        app:layout_constraintRight_toRightOf="@+id/sf_preview_texture_view"
        app:layout_constraintTop_toTopOf="@+id/sf_preview_texture_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_draft_btn"
        android:background="@drawable/solo_ktv_edit_save_draft_bg_light"
        android:paddingLeft="12dp"
        android:paddingTop="11.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="11.5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="3.5dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="3.5dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/center_guide_line"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/center_guide_line"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/save_draft_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_solo_ktv_save_to_draft"
            android:layout_marginStart="4dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/publish_btn"
        android:background="@drawable/solo_ktv_edit_publish_bg"
        android:paddingLeft="12dp"
        android:paddingTop="11.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="11.5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3.5dp"
        android:layout_marginTop="27dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="3.5dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/center_guide_line"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="@+id/center_guide_line">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/publish_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_solo_ktv_publish"
            android:layout_marginStart="4dp"
            android:textFontWeight="500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
