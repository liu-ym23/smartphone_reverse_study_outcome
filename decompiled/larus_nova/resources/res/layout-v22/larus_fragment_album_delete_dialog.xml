<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_round_full"
    android:layout_width="?attr/larus_dp_270"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/album_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="确定删除?"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/album_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="你可以选择仅从豆包删除，或同时从手机删除，删除后无法恢复"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        android:textFontWeight="400"/>
    <View
        android:background="@drawable/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_17"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_danger_50"
        android:gravity="center"
        android:id="@+id/album_delete_all"
        android:background="@drawable/larus_bg_create_menu_item_middle"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:text="同时删除"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="400"/>
    <View
        android:background="@drawable/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_danger_50"
        android:gravity="center"
        android:id="@+id/album_delete_local"
        android:background="@drawable/larus_bg_create_menu_item_middle"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:text="仅从豆包删除"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="400"/>
    <View
        android:background="@drawable/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/album_delete_cancel"
        android:background="@drawable/larus_bg_create_menu_item_last"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:text="@string/larus_bot_profile_pic_crop_cancel"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="400"/>
</LinearLayout>
