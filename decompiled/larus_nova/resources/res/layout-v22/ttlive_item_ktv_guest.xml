<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="52dp"
    android:layout_height="52dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_guest_avatar"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:roundAsCircle="true"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/ttlive_guest_identification"
        android:background="@drawable/ttlive_icon_ktv_seat_mute"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <com.bytedance.android.livesdk.common.AnchorPauseTipsView
        android:layout_gravity="center"
        android:id="@+id/ttlive_leave_view"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_volume_Anim"
        android:visibility="invisible"
        android:layout_width="50dp"
        android:layout_height="50dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_seat_label_container"
        android:background="@drawable/ttlive_ktv_seat_label_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"
        android:minWidth="18dp">
        <TextView
            android:textSize="8dp"
            android:textColor="@color/ttlive_white"
            android:id="@+id/ktv_seat_text_label"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_ktv_seat_label_sing"
            android:paddingHorizontal="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ktv_seat_icon_label"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ttlive_icon_ktv_seat_microphone"/>
    </FrameLayout>
    <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
        android:textSize="8dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_seat_tag_label"
        android:background="@drawable/ttlive_ktv_seat_label_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"
        android:minWidth="18dp"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
</FrameLayout>
