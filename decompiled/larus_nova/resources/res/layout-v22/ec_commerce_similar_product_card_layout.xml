<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_similar_product_card_rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:orientation="vertical"
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="8dp">
        <com.bytedance.android.shopping.widget.legacy.SquareImageView
            android:id="@+id/ec_similar_product_card_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:placeholderImage="@drawable/commerce_promotion_place_holder"
            app:placeholderImageScaleType="centerCrop"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:id="@+id/ec_similar_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:id="@+id/ec_similar_product_card_coupons_container"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <com.bytedance.android.ec.core.widget.ECCouponView
                android:id="@+id/ec_similar_product_card_first_coupon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"/>
            <com.bytedance.android.ec.core.widget.ECCouponView
                android:id="@+id/ec_similar_product_card_second_coupon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="17dp"
                android:id="@+id/ec_similar_product_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:pv_prefixMarginRight="4dp"
                app:pv_prefixTextColor="@color/primary"
                app:pv_prefixTextSizeRatio="0.65"
                app:pv_priceTextColor="@color/primary"
                app:pv_suffixTextColor="@color/primary"
                app:pv_suffixTextMarginLeft="2dp"
                app:pv_suffixTextSizeRatio="0.65"/>
            <com.bytedance.android.ec.core.widget.RoundedLinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/ec_similar_product_card_deposit_presale_price_container"
                android:background="@color/commerce_color_1AFE2C55"
                android:paddingLeft="4dp"
                android:paddingTop="0.5dp"
                android:paddingRight="4dp"
                android:paddingBottom="0.5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0.5dp"
                app:rounded_radius="2dp">
                <com.bytedance.android.ec.core.widget.price.PriceView
                    android:textSize="11dp"
                    android:id="@+id/ec_similar_product_card_deposit_presale_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:pv_prefixMarginRight="2dp"
                    app:pv_prefixTextColor="@color/primary"
                    app:pv_prefixTextSizeRatio="0.9"
                    app:pv_priceTextColor="@color/primary"
                    app:pv_yuanSymbolMarginRight="1dp"
                    app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
            </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="#57161823"
                android:id="@+id/ec_similar_product_card_sales"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <com.bytedance.android.shopping.searchsimilar.view.SimilarProductFeedbackView
        android:id="@+id/ec_similar_product_card_feedback_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
