<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.bytedance.dux.button.DuxButton
        android:id="@+id/btn_secondary"
        android:paddingTop="11.5dp"
        android:paddingBottom="11.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:paddingVertical="11.5dp"
        style="@style/DuxButton.Rectangle.Secondary.Large.LightConst"/>
    <com.bytedance.dux.button.DuxButton
        android:id="@+id/btn_primary"
        android:paddingTop="11.5dp"
        android:paddingBottom="11.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:paddingVertical="11.5dp"
        style="@style/DuxButton.Rectangle.Primary.Large"/>
</merge>
