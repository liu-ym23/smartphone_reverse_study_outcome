<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@drawable/aos_new_product_card_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:fitsSystemWindows="true"
    android:layout_width="260dp"
    android:layout_height="144dp"
    android:paddingHorizontal="12dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_product_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/aos_white"
        android:ellipsize="end"
        android:id="@+id/tv_product_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_product_image"
        app:layout_constraintTop_toTopOf="@+id/iv_product_image"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/tv_product_tag_1"
        android:background="@drawable/aos_product_tag_bg"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:paddingHorizontal="2dp"
        app:layout_constraintStart_toStartOf="@+id/tv_product_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_title"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_product_tag_2"
        android:background="@drawable/aos_product_tag_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_product_tag_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_title"
        app:layout_constraintWidth_max="wrap"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="13dp"
        android:textColor="@color/aos_white"
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_product_image"
        app:layout_constraintStart_toEndOf="@+id/iv_product_image"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="15dp"
        android:textColor="@color/aos_white"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/aos_confirm_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="去购买"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_product_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
