<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="?attr/larus_dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/titleWrapper"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_12">
            <ImageView
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginTop="?attr/larus_dp_1"
                app:srcCompat="?attr/larus_ic_record_mic"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="?attr/larus_neutral_100"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_8"
                android:textFontWeight="500"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/recordDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:typeface="monospace"
                    android:textColor="?attr/larus_neutral_70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:lineHeight="?attr/larus_dp_20"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_70"
                    android:paddingBottom="?attr/larus_dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:typeface="monospace"
                    android:textColor="?attr/larus_neutral_70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:lineHeight="?attr/larus_dp_20"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_70"
                    android:paddingBottom="?attr/larus_dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:typeface="monospace"
                    android:textColor="?attr/larus_neutral_70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:lineHeight="?attr/larus_dp_20"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <com.larus.common_ui.SoundWaveView
                android:id="@+id/SoundWaveView"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_66"
            android:maxLines="3"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="?attr/larus_dp_22"
            android:textFontWeight="400"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/warningWrapper"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_82">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/warningIcon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                app:srcCompat="?attr/larus_ic_record_warning"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="?attr/larus_neutral_70"
                android:id="@+id/warningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_6"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/markdownWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/left_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/audioPlayButton"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="?attr/larus_sp_17"
                        android:textColor="?attr/larus_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/markdownTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="?attr/larus_dp_4"
                        android:maxLines="1"
                        android:paddingEnd="?attr/larus_dp_4"
                        android:textFontWeight="500"/>
                    <TextView
                        android:textSize="?attr/larus_sp_13"
                        android:textColor="?attr/larus_neutral_70"
                        android:id="@+id/markdownSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="?attr/larus_sp_19"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/audioPlayButton"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"
                    android:contentDescription="@string/larus_accessibility_play"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="?attr/larus_ic_record_play"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="?attr/larus_neutral_transparent_2"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0_5"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:layout_marginVertical="?attr/larus_dp_12"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_12"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/buttonText"
            android:background="?attr/larus_bg_record_auto_change"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
