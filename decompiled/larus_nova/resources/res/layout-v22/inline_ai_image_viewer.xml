<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/N900_90_light"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <FrameLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/cancel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Legacy_Cancel"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/image_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/v_selected_region"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="12sp"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/v_selected"
                    android:background="@drawable/inline_ai_image_checkbox_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:button="@null"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </FrameLayout>
    </FrameLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:orientation="horizontal"
        android:background="@color/N900_90_light"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <FrameLayout
            android:layout_gravity="top"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/save_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ud_icon_download_outlined"
                    app:tint="@color/static_white"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="@color/static_white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Doc_Facade_Save"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/confirm_button"
                android:background="@drawable/inline_ai_primary_button_bg_selector"
                android:paddingLeft="16dp"
                android:paddingTop="7dp"
                android:paddingRight="16dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                app:ud_radius="xxl"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
