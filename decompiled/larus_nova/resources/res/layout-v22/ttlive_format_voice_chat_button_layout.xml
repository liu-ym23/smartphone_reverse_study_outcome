<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="65dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/voice_chat_heart_icon"
        android:layout_width="230dp"
        android:layout_height="330dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ttlive_format_voice_chat_heart"
        android:scaleType="centerCrop"
        android:translationX="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_chat_button"
        app:layout_constraintEnd_toEndOf="@+id/voice_chat_button"/>
    <com.bytedance.android.live.profit.format.voicechat.view.VoiceChatStartButton
        android:id="@+id/voice_chat_button"
        android:background="@drawable/ttlive_format_voice_chat_button_bg"
        android:layout_width="200dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_chat_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/voice_chat_button_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_format_voice_chat_call"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/voice_chat_button_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#fafbff"
            android:id="@+id/voice_chat_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="140dp"
            android:text="@string/ttlive_format_voice_chat_button"
            android:maxLines="1"
            android:textFontWeight="500"
            app:fontFamily="PingFang SC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/voice_chat_button_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.live.profit.format.voicechat.view.VoiceChatStartButton>
    <TextView
        android:id="@+id/voice_chat_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_format_voice_chat_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_chat_button"/>
    <FrameLayout
        android:id="@+id/voice_chat_exit"
        android:background="@drawable/ttlive_format_voice_chat_exit_drawable"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_chat_button"
        app:layout_constraintEnd_toStartOf="@+id/voice_chat_button"
        app:layout_constraintTop_toTopOf="@+id/voice_chat_button">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_format_voice_chat_exit"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
