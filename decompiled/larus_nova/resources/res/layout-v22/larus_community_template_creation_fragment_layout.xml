<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tag_list_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/back_space"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tag_mask_left_icon"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/back_space"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="?attr/larus_sp_15"
            android:autoSizeMaxTextSize="?attr/larus_sp_17"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/profile_image_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/profile_image"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
                app:roundAsCircle="true"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.community.impl.widget.CreationLoadingAndRetryView
        android:id="@+id/loading_and_retry_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tag_list_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
