<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="280dp"
        android:layout_height="329dp">
        <RelativeLayout
            android:background="@drawable/ttlive_balance_coupon_bg"
            android:layout_width="280dp"
            android:layout_height="279dp">
            <RelativeLayout
                android:id="@+id/balance_coupon_left_part"
                android:background="@drawable/ttlive_balance_coupon_left_bg"
                android:layout_width="68dp"
                android:layout_height="80dp"
                android:layout_alignBottom="@+id/balance_coupon_right_part"
                android:layout_marginStart="26dp"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="22dp"
                        android:textColor="#fe2c55"
                        android:id="@+id/balance_coupon_left_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textFontWeight="600"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#fe2c55"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="元"
                        android:includeFontPadding="false"
                        android:layout_alignBaseline="@+id/balance_coupon_left_amount"
                        android:layout_toEndOf="@+id/balance_coupon_left_amount"
                        android:textFontWeight="500"/>
                </RelativeLayout>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#fe2c55"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="现金余额"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="92.5dp"
                android:src="@drawable/ttlive_balance_coupon_upper_icon"
                android:layout_marginStart="102dp"/>
            <RelativeLayout
                android:id="@+id/balance_coupon_right_part"
                android:background="@drawable/ttlive_balance_coupon_right_bg"
                android:layout_width="96dp"
                android:layout_height="98dp"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/coupon_title"
                android:layout_marginEnd="26dp"
                android:layout_alignParentEnd="true">
                <RelativeLayout
                    android:id="@+id/balance_coupon_right_amount_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="28dp"
                        android:textColor="#fe2c55"
                        android:id="@+id/balance_coupon_right_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textFontWeight="600"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#fe2c55"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="元"
                        android:includeFontPadding="false"
                        android:layout_alignBaseline="@+id/balance_coupon_right_amount"
                        android:layout_toEndOf="@+id/balance_coupon_right_amount"
                        android:textFontWeight="600"/>
                </RelativeLayout>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#fe2c55"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="全平台可用"
                    android:layout_below="@+id/balance_coupon_right_amount_container"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="-1dp"
                    android:lineHeight="14dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fe2c55"
                    android:id="@+id/balance_coupon_right_amount_threshold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/ttlive_balance_coupon_amount_threshold_1"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:textFontWeight="500"/>
            </RelativeLayout>
            <TextView
                android:textSize="17dp"
                android:textColor="#161823"
                android:id="@+id/coupon_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="余额兑换优惠券"
                android:layout_centerHorizontal="true"
                android:fontFamily="PingFangSC-Medium"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#fff9f1"
                android:gravity="center"
                android:id="@+id/coupon_btn"
                android:background="@drawable/ttlive_balance_coupon_btn_background"
                android:layout_width="228dp"
                android:layout_height="48dp"
                android:layout_marginBottom="45dp"
                android:text="@string/ttlive_balance_coupon_btn_desc"
                android:layout_alignParentBottom="true"
                android:layout_centerInParent="true"
                android:textFontWeight="500"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#4d000000"
                    android:id="@+id/coupon_rule_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_balance_coupon_rule_desc"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#04498d"
                    android:id="@+id/coupon_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="兑换规则"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/coupon_rule_arrow"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_arrowright_outlined"/>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/coupon_close_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_basic_dialog_close_outline"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
