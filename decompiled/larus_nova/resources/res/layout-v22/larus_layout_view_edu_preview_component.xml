<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <FrameLayout
        android:id="@+id/edu_image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0"/>
    <com.larus.camera.impl.widget.EduPreviewLoadingView
        android:id="@+id/edu_preview_loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/edu_image_container"
        app:layout_constraintEnd_toEndOf="@+id/edu_image_container"
        app:layout_constraintStart_toStartOf="@+id/edu_image_container"
        app:layout_constraintTop_toTopOf="@+id/edu_image_container"/>
    <FrameLayout
        android:id="@+id/tip_view_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/edu_image_container"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="@+id/edu_image_container"
        app:layout_constraintStart_toStartOf="@+id/edu_image_container">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_tip"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_mode_exchange"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawablePadding="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:drawableStartCompat="@drawable/larus_ic_edu_mode_exchange"/>
    </FrameLayout>
    <com.larus.camera.impl.ui.component.result.edu.EduResultTabView
        android:id="@+id/edu_result_tab_view"
        app:layout_constraintBottom_toBottomOf="@+id/edu_image_container"
        app:layout_constraintEnd_toEndOf="@+id/edu_image_container"
        app:layout_constraintStart_toStartOf="@+id/edu_image_container"
        style="@style/Larus.EduResultTabView"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
</androidx.constraintlayout.widget.ConstraintLayout>
