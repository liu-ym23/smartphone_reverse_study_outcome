<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/drawer_shadow"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/drawer_top_shadow_landscape"
        android:background="@drawable/ttlive_bg_landscape_drawer_dialog_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/drawer_bottom_shadow_landscape"
        android:background="@drawable/ttlive_bg_landscape_drawer_dialog_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"/>
    <FrameLayout
        android:id="@+id/drawer_close_area"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false"/>
    <com.bytedance.android.livesdk.drawer.LiveDrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
            android:layout_gravity="end"
            android:id="@+id/panel_layout_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/feed_panel_bar"
                android:layout_width="17dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/feed_panel_bar_image"
                    android:layout_width="17dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="52dp"
                    android:src="@drawable/ttlive_bar"
                    android:scaleType="centerCrop"/>
            </RelativeLayout>
            <RelativeLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/panel_topbar"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">
                        <ImageView
                            android:id="@+id/drawer_back"
                            android:layout_width="32dp"
                            android:layout_height="24dp"
                            android:layout_marginLeft="12dp"
                            android:src="@drawable/ttlive_ic_drawer_back"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:textSize="17dp"
                            android:textColor="@color/white"
                            android:id="@+id/panel_topbar_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_top_drawer_entrance_text"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <View
                        android:id="@+id/panel_top_divider"
                        android:background="#1dffffff"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/panel_background"
                    android:background="@drawable/ttlive_bg_live_feed_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/drawer_custom_background"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ttlive_bg_live_feed_panel"
                        app:roundBottomLeft="true"
                        app:roundTopLeft="true"
                        app:roundedCornerRadius="12dp"/>
                    <RelativeLayout
                        android:id="@+id/drawer_chosen_background"
                        android:background="@drawable/ttlive_bg_appointment_tab"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="44dp">
                        <ImageView
                            android:background="@drawable/ttlive_appointment_tab_decorator_1"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginLeft="39dp"
                            android:layout_marginTop="14dp"
                            android:layout_alignParentLeft="true"
                            android:layout_marginStart="39dp"
                            android:layout_alignParentStart="true"/>
                        <ImageView
                            android:background="@drawable/ttlive_appointment_decorator_2"
                            android:layout_width="58dp"
                            android:layout_height="104dp"
                            android:layout_marginTop="32dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"/>
                        <ImageView
                            android:background="@drawable/ttlive_appointment_decorator_3"
                            android:layout_width="116dp"
                            android:layout_height="149dp"
                            android:layout_marginTop="412dp"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/panel_layout"
                        android:paddingTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/panel_topbar">
                        <FrameLayout
                            android:id="@+id/panel_top_layout_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/panel_layout_top"
                                android:paddingBottom="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@+id/feed_panel_indicator">
                                <RelativeLayout
                                    android:id="@+id/search_container"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    app:layout_constraintEnd_toStartOf="@+id/history_container"
                                    app:layout_constraintStart_toStartOf="parent"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/history_container"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/ttlive_live_history"
                                    android:layout_marginStart="16dp"
                                    android:layout_marginEnd="8dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/search_container"
                                    app:layout_constraintTop_toTopOf="parent">
                                    <ImageView
                                        android:id="@+id/history_icon"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ttlive_ic_searshbar_history"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <ImageView
                                        android:id="@+id/yellow_point"
                                        android:visibility="gone"
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        android:src="@drawable/ttlive_bg_yellow_point"
                                        app:layout_constraintEnd_toEndOf="@+id/history_icon"
                                        app:layout_constraintTop_toTopOf="@+id/history_icon"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/white"
                                android:id="@+id/panel_layout_top_title"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@+id/feed_panel_indicator"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/panel_feed_container"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/panel_top_layout_container"
                            android:layout_toEndOf="@+id/feed_panel_indicator"/>
                        <View
                            android:id="@+id/feed_panel_indicator"
                            android:background="@drawable/ttlive_shape_live_feed_panel_indicator"
                            android:layout_width="5dp"
                            android:layout_height="100dp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="7dp"
                            android:layout_marginEnd="3dp"/>
                        <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
                            android:id="@+id/dmt_loading_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </RelativeLayout>
                </FrameLayout>
            </RelativeLayout>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
    </com.bytedance.android.livesdk.drawer.LiveDrawerLayout>
</FrameLayout>
