<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/id_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.opengl.GLSurfaceView
            android:id="@+id/id_gl_sv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:background="@color/byted_transparent_gray_72"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/return_back"
            android:padding="5dp"
            android:layout_width="21dp"
            android:layout_height="29dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/byted_return_white"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
    <com.ss.android.bytedcert.view.RectInsideBgView
        android:gravity="center_horizontal"
        android:id="@+id/rect_inside_bg_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        app:layout_constraintDimensionRatio="h,255:280"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.85"/>
    <TextView
        android:textSize="22sp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="30dp"
        android:text="@string/byted_video_record_default_prompt"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rect_inside_bg_view"/>
    <TextView
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:letterSpacing="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_prompt"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_time_spend"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/video_record_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ss.android.bytedcert.view.VideoRecordButton
        android:id="@+id/video_record_button"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
