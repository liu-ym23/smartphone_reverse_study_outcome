<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cons_root"
    android:paddingLeft="?attr/larus_dp_36"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_36"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_2"
    android:paddingHorizontal="?attr/larus_dp_36"
    android:paddingVertical="?attr/larus_dp_12">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_photo"
        android:layout_width="?attr/larus_dp_200"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:maxWidth="?attr/larus_dp_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@android:color/transparent"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <View
        android:id="@+id/view_uploading_cover"
        android:background="@color/larus_static_black_transparent_1"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/iv_photo"
        app:layout_constraintEnd_toEndOf="@+id/iv_photo"
        app:layout_constraintStart_toStartOf="@+id/iv_photo"
        app:layout_constraintTop_toTopOf="@+id/iv_photo"/>
    <com.larus.common_ui.widget.CustomCircularProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        app:larus_progressBackgroundColor="#99ffffff"
        app:larus_progressColor="@color/larus_static_white"
        app:larus_progressWidth="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_photo"
        app:layout_constraintEnd_toEndOf="@+id/iv_photo"
        app:layout_constraintStart_toStartOf="@+id/iv_photo"
        app:layout_constraintTop_toTopOf="@+id/iv_photo"
        style="@android:style/Widget.ProgressBar.Large"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/retry"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        android:src="@drawable/larus_ic_message_failed_retry"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_photo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
