<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_message_action_item_round"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/default_view_container"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/message_action_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="2dp"
            android:layout_marginHorizontal="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_copy_outlined"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/message_action_item_text_color_selector"
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:id="@+id/message_action_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/message_action_icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/red_dot_view"
            android:visibility="visible"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintCircle="@+id/message_action_icon"
            app:layout_constraintCircleAngle="45"
            app:layout_constraintCircleRadius="18dp"
            app:srcCompat="@drawable/update_red_dot"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
