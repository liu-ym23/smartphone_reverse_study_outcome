<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/error_root_page"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/error_icon"
            android:layout_width="@dimen/cj_pay_height_80"
            android:layout_height="@dimen/cj_pay_height_80"
            android:layout_marginBottom="@dimen/cj_pay_padding_8"
            android:src="@drawable/cj_pay_std_net_error_icon_light"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/main_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cj_pay_padding_6"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/sub_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/error_solve_button"
            android:layout_width="165dp"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginTop="@dimen/cj_pay_height_40"
            app:btnBackground="@drawable/cj_pay_std_error_button_bg_drawable_light"
            app:btnTextColor="@color/cj_pay_color_black_161823"
            app:btnTextSize="@dimen/cj_pay_font_size_15"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_blue"
            android:id="@+id/error_solve_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_20"/>
    </LinearLayout>
</FrameLayout>
