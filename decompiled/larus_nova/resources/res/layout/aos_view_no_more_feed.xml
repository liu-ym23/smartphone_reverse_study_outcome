<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/aos_feed_loading_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/aos_icon_no_more_feed"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_no_more_feed_title_color"
            android:gravity="center"
            android:layout_width="311dp"
            android:layout_height="24dp"
            android:layout_marginTop="23dp"
            android:text="@string/aos_no_more_feed_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/aos_no_more_feed_subtitle_color"
            android:gravity="center"
            android:layout_width="311dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/aos_no_more_feed_subtitle"/>
    </LinearLayout>
</FrameLayout>
