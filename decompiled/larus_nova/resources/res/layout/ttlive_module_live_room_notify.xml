<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:id="@+id/notification_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_centerInParent="true"
    android:layout_centerVertical="true"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="30dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/right_back"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_global_notification_right_array_side"
        android:layout_height="@dimen/ttlive_global_notification_right_array_height"
        android:src="@drawable/ttlive_icon_titlebar_whiteback_right"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#000000"
        android:ellipsize="none"
        android:layout_gravity="center_vertical"
        android:id="@+id/notification_text_normal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_global_notification_text_margin_left"
        android:layout_marginRight="@dimen/ttlive_global_notification_text_margin_right"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="@dimen/ttlive_global_notification_text_margin_left"
        android:layout_marginEnd="@dimen/ttlive_global_notification_text_margin_right"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#000000"
        android:ellipsize="none"
        android:layout_gravity="center_vertical"
        android:id="@+id/notification_text_not_rtl"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_global_notification_text_margin_right"
        android:layout_marginRight="@dimen/ttlive_global_notification_text_margin_left"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="@dimen/ttlive_global_notification_text_margin_right"
        android:layout_marginEnd="@dimen/ttlive_global_notification_text_margin_left"/>
</FrameLayout>
