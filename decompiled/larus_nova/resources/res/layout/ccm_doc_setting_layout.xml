<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:backgroundTint="@color/bg_base"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_left_title=""
        app:widget_widgets_tb_title="@string/LarkCCM_IM_SharingSuggestions_Docs_Title_Mob"/>
    <RelativeLayout
        android:id="@+id/leader_layout"
        android:background="@drawable/docs_bg_setting_group_item_round"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="13dp"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_below="@+id/titleBar">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:id="@+id/leader_auth_tx"
            android:background="@drawable/facade_round_around_l"
            android:layout_width="251dp"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_IM_SharingSuggestions_GrantViewPermToMymanager_Radio"
            android:layout_alignParentLeft="true"
            android:backgroundTint="@color/bg_body"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/ud_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/leader_auth_tx"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/access_layout"
        android:background="@drawable/docs_bg_setting_group_item_round"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="13dp"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_below="@+id/leader_layout">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_IM_SharingSuggestions_DefaultPermissionOfNewDocs_Text_Mob"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_title"
                android:id="@+id/right_tx"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_IM_SharingSuggestions_AnyoneWithLinkCanView_Radio_Mob"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/right_tx"
                app:srcCompat="@drawable/ud_icon_right_outlined"
                app:tint="@color/ud_N500"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
