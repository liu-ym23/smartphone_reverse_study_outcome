<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/item_content"
    android:background="@drawable/list_item_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:civ_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_file_round_doc_colorful"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_shortcut"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_icon"
        app:layout_constraintLeft_toLeftOf="@+id/item_icon"
        app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
    <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
        android:id="@+id/item_name"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/item_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:titleSize="@dimen/facade_title_text_size"
        app:titleText="@string/Doc_List_TitleLabel"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/owner_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:civ_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_file_round_doc_colorful"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/owner_name"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/owner_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/update_time"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/owner_name"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
