<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mmSubtitleFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subtitleRecyclerView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/backToBottomLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_shadow_radius="@dimen/dp_16"
        style="@style/UDShadow.S2.Down">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backToBottomView"
            android:padding="10dp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:tint="@color/flow_ud_neutral_100"
            app:srcCompat="@drawable/office_sdk_mm_ic_arrow_down_doubao"/>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
