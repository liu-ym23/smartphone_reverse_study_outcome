<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ec_window_author_say_recommend_bg"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="20dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center"
        android:id="@+id/recommend_icon"
        android:layout_width="44dp"
        android:layout_height="16dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="4dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_window_sub_text_color"
        android:id="@+id/recommend_text"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginRight="7dp"/>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
