<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_livetab_recom"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/top_icon_view"
            android:background="@drawable/ttlive_ic_livetab_recom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundedCornerRadius="12dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/center_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_live_tab_recom_center_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_icon_view"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:id="@+id/bottom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_live_tab_recom_bottom_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/center_text"/>
        <View
            android:id="@+id/line"
            android:background="#1e181823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/bottom_text"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#bf161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/iknow_text"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_guide_room_quit_ok"
            app:layout_constraintEnd_toStartOf="@+id/gotosee_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/gotosee_text"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_guide_room_quit_gotosee"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iknow_text"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
