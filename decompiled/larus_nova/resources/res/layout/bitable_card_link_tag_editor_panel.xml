<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
        android:layout_gravity="bottom"
        android:id="@+id/dragView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:midHeightPercent="0.6"
        app:panel_background_color="@color/bg_float"
        app:panel_enable_drag="true"
        app:panel_right_menu_type="text"
        app:panel_show_divider="false"
        app:panel_show_drag_handler="true"
        app:panel_show_left_icon="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/contentLayout"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_7"
                android:layout_marginStart="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_16">
                <TextView
                    android:textSize="@dimen/space_kit_font_15"
                    android:textColor="@color/primary_fill_default"
                    android:id="@+id/cancelSearchBtn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Doc_Facade_Cancel"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_kit_len_16"
                    android:layout_alignParentEnd="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/facade_round_around_m"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_36"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/cancelSearchBtn"
                    android:backgroundTint="@color/bg_filler">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="@dimen/space_kit_len_16"
                        android:layout_height="@dimen/space_kit_len_16"
                        android:layout_marginStart="@dimen/space_kit_len_10"
                        android:layout_marginEnd="@dimen/space_kit_len_6"
                        app:srcCompat="@drawable/ud_icon_search_outlined"
                        app:tint="@color/icon_n3"/>
                    <com.suite.lark.emm.design.edittext.SCEditText
                        android:textSize="@dimen/space_kit_font_14"
                        android:textColor="@color/text_title"
                        android:textColorHint="@color/text_placeholder"
                        android:id="@+id/searchEditText"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/Bitable_Relation_SearchRecord"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:imeOptions="actionDone"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/clearSearchIcon"
                        android:visibility="gone"
                        android:layout_width="@dimen/space_kit_len_16"
                        android:layout_height="@dimen/space_kit_len_16"
                        android:layout_marginStart="@dimen/space_kit_len_6"
                        android:layout_marginEnd="@dimen/space_kit_len_10"
                        app:srcCompat="@drawable/ud_icon_close_filled"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/noPermissionRecordTip"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_kit_len_4"
                android:layout_marginStart="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:tint="@color/icon_n3"
                    app:srcCompat="@drawable/ud_icon_lock_filled"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_12"
                    android:textColor="@color/text_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Dashboard_DrillDown_NoPermToViewSomeData"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/selectedListContainer"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.widgets.panel.InterceptTouchRecyclerView
                    android:id="@+id/selectedList"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/addNewRecordBtn"
                android:background="@color/bg_float"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:backgroundTint="@color/facade_selector_item_float">
                <View
                    android:background="@color/line_divider_default"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_divider"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/addRecordIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="centerInside"
                    android:tint="@color/icon_n1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    app:srcCompat="@drawable/ud_icon_add_outlined"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/addNewRecordTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Mobile_AddRecord_Button"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/addRecordIcon"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/newRecordTV"
                    android:background="@drawable/bitable_card_link_cell_bg"
                    android:paddingTop="@dimen/space_kit_len_2"
                    android:paddingBottom="@dimen/space_kit_len_2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/space_kit_len_24"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/space_kit_len_8"
                    android:paddingEnd="@dimen/space_kit_len_8"
                    android:layout_marginStart="@dimen/space_kit_len_12"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:layout_toEndOf="@+id/addNewRecordTV"
                    android:backgroundTint="@color/bg_float_overlay"/>
                <com.bytedance.ee.bear.bitable.uikit.fieldcell.pure.LinkTagView
                    android:textColor="@color/text_title"
                    android:id="@+id/newRecordTVV2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_kit_len_12"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:layout_toEndOf="@+id/addNewRecordTV"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/bodyContainer"
                android:background="@color/bg_float"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/optionListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.ee.bear.widgets.panel.InterceptTouchRecyclerView
                        android:id="@+id/optionList"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/searchLoadingLayout"
                    android:background="@color/bg_float"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                        android:layout_gravity="center"
                        android:id="@+id/searchLoadingLottie"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/loading_anim"
                        style="@style/BearLottieView"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/emptyContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                        android:layout_gravity="center"
                        android:id="@+id/emptyView"
                        app:ud_empty_desc="@string/Bitable_Relation_NoResultFound"
                        app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_content"
                        style="@style/SpaceEmptyStatusStyle"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/loadingLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:layout_gravity="center"
                android:id="@+id/loadingLottie"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_anim"
                style="@style/BearLottieView"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/invalidContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                    android:layout_gravity="center"
                    android:id="@+id/invalidView"
                    app:ud_empty_desc="@string/Bitable_Relation_NoPermissionToViewLinkedTable"
                    app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_access"
                    style="@style/SpaceEmptyStatusStyle"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_15"
                    android:textColor="@color/primary_fill_default"
                    android:id="@+id/retryButton"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/Bitable_Common_ButtonRetry"/>
            </LinearLayout>
        </FrameLayout>
    </com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView>
</FrameLayout>
