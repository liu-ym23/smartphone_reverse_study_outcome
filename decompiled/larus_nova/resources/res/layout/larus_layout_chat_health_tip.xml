<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_ltm_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/exit_cancel"
        android:padding="?attr/larus_dp_13"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_icon_pay_close"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/top_icon"
        android:layout_width="?attr/larus_dp_86"
        android:layout_height="?attr/larus_dp_86"
        android:layout_marginTop="?attr/larus_dp_10"
        android:src="@drawable/larus_common_ui_avatar_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exit_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/botName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/tip_describe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:lineSpacingExtra="?attr/larus_sp_1"
        android:layout_marginStart="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/botName"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/start_use_health_tv"
        android:background="@drawable/larus_bg_ltm_hit_right"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_35"
        android:layout_marginBottom="?attr/larus_dp_54"
        android:text="@string/larus_Health_compliance_popup_button"
        android:paddingStart="?attr/larus_dp_57"
        android:paddingEnd="?attr/larus_dp_57"
        android:layout_marginStart="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tip_describe"
        app:layout_constraintVertical_bias="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/backGround"
        android:background="@drawable/larus_bg_ltm_hit_right"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/start_use_health_tv"
        app:layout_constraintEnd_toEndOf="@+id/start_use_health_tv"
        app:layout_constraintStart_toStartOf="@+id/start_use_health_tv"
        app:layout_constraintTop_toTopOf="@+id/start_use_health_tv"/>
    <View
        android:id="@+id/loadingView"
        android:background="@drawable/larus_icon_loading"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/start_use_health_tv"
        app:layout_constraintEnd_toEndOf="@+id/start_use_health_tv"
        app:layout_constraintStart_toStartOf="@+id/start_use_health_tv"
        app:layout_constraintTop_toTopOf="@+id/start_use_health_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
