<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="@dimen/ttlive_interact_window_width"
    android:layout_height="@dimen/ttlive_interact_window_height">
    <FrameLayout
        android:id="@+id/online_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/bg_container"
            android:background="#4d312038"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/interact_info"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_mute_icon"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ttlive_icon_video_silence"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/online_name"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lines="1"
                android:singleLine="true"
                android:shadowColor="#66000000"
                android:shadowRadius="15"
                android:layout_weight="1"/>
            <com.bytedance.android.live.ui.LinkGuestSendGiftNoAnimationView
                android:id="@+id/online_fans_ticket_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/offline_status"
            android:background="@color/ttlive_interact_offline_bc"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_interact_player_enter_background"
            android:maxLines="2"
            android:fontFamily="sans-serif"/>
        <com.bytedance.android.live.livepkaudience.seat.PkSeatAnimationView
            android:id="@+id/seat_anim_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_red"
            android:layout_gravity="center"
            android:id="@+id/guest_debug_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"/>
    </FrameLayout>
</merge>
