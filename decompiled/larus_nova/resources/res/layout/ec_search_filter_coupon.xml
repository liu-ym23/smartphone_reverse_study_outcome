<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="7dp">
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="64dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/search_filter_coupon_left_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="64dp"
            android:layout_height="64dp">
            <TextView
                android:textSize="20dp"
                android:textColor="#161823"
                android:id="@+id/search_filter_coupon_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#161823"
                android:id="@+id/search_filter_coupon_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:layout_marginStart="1dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/search_filter_coupon_right_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="#161823"
                android:id="@+id/search_filter_coupon_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#73161823"
                android:id="@+id/search_filter_coupon_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/coupon_countdown_layout"
            android:background="@drawable/search_filter_coupon_countdown_bg"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="3dp"
            android:paddingEnd="4dp">
            <TextView
                android:textSize="8dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/coupon_countdown"
                android:layout_width="35dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="8dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/coupon_countdown_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/search_filter_coupon_select_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
</LinearLayout>
