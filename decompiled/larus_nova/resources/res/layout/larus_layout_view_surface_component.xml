<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <SurfaceView
        android:id="@+id/camera_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/focus_container"
        app:layout_constraintDimensionRatio="h,9:16"
        app:layout_constraintEnd_toEndOf="@+id/focus_container"
        app:layout_constraintStart_toStartOf="@+id/focus_container"/>
    <ImageView
        android:id="@+id/top_mask"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/focus_container"
        app:layout_constraintEnd_toEndOf="@+id/camera_surface"
        app:layout_constraintStart_toStartOf="@+id/camera_surface"
        app:layout_constraintTop_toTopOf="@+id/camera_surface"/>
    <com.larus.camera.impl.widget.SurfaceBaselineView
        android:id="@+id/surface_baseline"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/focus_container"
        app:layout_constraintEnd_toEndOf="@+id/focus_container"
        app:layout_constraintStart_toStartOf="@+id/focus_container"
        app:layout_constraintTop_toTopOf="@+id/focus_container"/>
    <FrameLayout
        android:id="@+id/focus_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:id="@+id/focus"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/larus_ic_surface_focus"
            android:scaleType="center"
            android:alpha="0"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_zoom_ratio"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/focus_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_const_text_inverse2"
            android:gravity="center"
            android:id="@+id/tv_single_zoom_ratio"
            android:background="@drawable/larus_bg_zoom_ratio_dark"
            android:visibility="gone"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_const_text_inverse2"
            android:gravity="center"
            android:id="@+id/tv_multi_zoom_ratio_1x"
            android:background="@drawable/larus_bg_zoom_ratio_light"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_12"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_const_text_inverse2"
            android:gravity="center"
            android:id="@+id/tv_multi_zoom_ratio_2x"
            android:background="@drawable/larus_bg_zoom_ratio_light"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_12"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_const_text_inverse2"
            android:gravity="center"
            android:id="@+id/tv_multi_zoom_ratio_3x"
            android:background="@drawable/larus_bg_zoom_ratio_light"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_12"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textStyle="bold"
            android:textColor="@color/larus_const_text_inverse2"
            android:gravity="center"
            android:id="@+id/tv_multi_zoom_ratio_4x"
            android:background="@drawable/larus_bg_zoom_ratio_light"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_12"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/preview_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/focus_container"
        app:layout_constraintEnd_toEndOf="@+id/focus_container"
        app:layout_constraintStart_toStartOf="@+id/focus_container"
        app:layout_constraintTop_toTopOf="@+id/focus_container"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
</androidx.constraintlayout.widget.ConstraintLayout>
