<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compressDeepThinkHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/compressDeepThinkHeaderIcon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.chat.standarduikit.floatingthink.view.DeepThinkShimmerLinearLayout
        android:id="@+id/compressDeepThinkHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/compressDeepThinkHeaderIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginStart="?attr/larus_dp_0">
        <TextView
            android:textSize="@dimen/dp_17"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/compressDeepThinkHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/compressDeepThinkHeaderTrailing"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"/>
        <FrameLayout
            android:id="@+id/compressDeepThinkHeaderTrailing"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginStart="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/compressDeepThinkHeaderTitle"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.common_ui.view.ActivityIndicatorView
                android:id="@+id/compressDeepThinkHeaderLoading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:larus_aiv_auto_start="false"
                app:larus_aiv_color="?attr/larus_neutral_70"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/compressDeepThinkHeaderArrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/larus_ic_tool_header_arrow_right"/>
        </FrameLayout>
    </com.larus.bmhome.chat.standarduikit.floatingthink.view.DeepThinkShimmerLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
