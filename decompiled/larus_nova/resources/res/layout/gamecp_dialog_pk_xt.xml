<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/gamecp_white"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="start"
        android:id="@+id/live_dialog_title"
        android:background="@color/gamecp_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#999999"
        android:gravity="left"
        android:id="@+id/live_dialog_message"
        android:background="@color/gamecp_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:textAllCaps="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/live_dialog_container"
        android:paddingLeft="16dp"
        android:paddingTop="5dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <Button
            android:textSize="15dp"
            android:textColor="#2a90d7"
            android:id="@+id/live_dialog_btn_2"
            android:background="@color/gamecp_white"
            android:layout_width="65dp"
            android:layout_height="36dp"
            android:text="@string/gamecp_cancel"/>
        <Button
            android:textSize="15dp"
            android:textColor="#2a90d7"
            android:id="@+id/live_dialog_btn_1"
            android:background="@color/gamecp_white"
            android:layout_width="65dp"
            android:layout_height="36dp"
            android:layout_marginLeft="9dp"
            android:text="@string/gamecp_live_float_quit"/>
    </LinearLayout>
</LinearLayout>
