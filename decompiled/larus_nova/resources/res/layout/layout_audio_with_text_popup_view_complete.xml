<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_with_text_popup_view_bg"
    android:background="@color/bg_body_overlay"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.suite.lark.emm.design.edittext.SCAppCompatEditText
        android:textAppearance="@style/UDText.Body0"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="start|top"
        android:id="@+id/audio_with_text_popup_view_edit_text"
        android:background="@drawable/kb_input_round_bg"
        android:padding="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:maxLines="8"
        android:lineSpacingExtra="3sp"
        android:textCursorDrawable="@drawable/text_cursor_drawable_ig"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioWaveformWidget
        android:id="@+id/audio_with_text_popup_view_waveform"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/audio_with_text_popup_view_edit_text"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:gravity="center"
        android:id="@+id/audio_with_text_popup_view_main_button"
        android:layout_width="108dp"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_backgroundColor="@color/function_info_content_pressed"
        app:ud_isRadiusAdjustBounds="true"
        app:ud_radius="round"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_with_text_popup_view_cancel_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        app:btn_iconZh="@drawable/ic_undo_outlined"
        app:btn_text="@string/Lark_IM_AudioToTextSelectLangugage_Cancel_Button"
        app:layout_constraintEnd_toStartOf="@+id/audio_with_text_popup_view_send_audio_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/audio_with_text_popup_view_send_all_button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_with_text_popup_view_send_audio_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        app:btn_iconZh="@drawable/ud_icon_originalmode_filled"
        app:btn_text="@string/Lark_IM_AudioMsg_SendAudioOnly_Button"
        app:layout_constraintEnd_toStartOf="@+id/audio_with_text_popup_view_send_text_button"
        app:layout_constraintStart_toEndOf="@+id/audio_with_text_popup_view_cancel_button"
        app:layout_constraintTop_toTopOf="@+id/audio_with_text_popup_view_send_all_button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_with_text_popup_view_send_text_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        app:btn_iconOther="@drawable/ud_icon_voice2text_en_outlined"
        app:btn_iconZh="@drawable/ud_icon_voice2text_cn_outlined"
        app:btn_text="@string/Lark_IM_AudioMsg_SendTextOnly_Button"
        app:layout_constraintEnd_toStartOf="@+id/audio_with_text_popup_view_send_all_button"
        app:layout_constraintStart_toEndOf="@+id/audio_with_text_popup_view_send_audio_button"
        app:layout_constraintTop_toTopOf="@+id/audio_with_text_popup_view_send_all_button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_with_text_popup_view_send_all_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        app:btn_iconColor="@color/ud_B500"
        app:btn_iconZh="@drawable/ud_icon_send_colorful"
        app:btn_text="@string/Lark_Chat_SendAudioWithText"
        app:btn_textColor="@color/text_link_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/audio_with_text_popup_view_send_text_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
