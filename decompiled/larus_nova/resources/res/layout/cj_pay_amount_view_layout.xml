<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="27dp"
        android:textStyle="bold"
        android:textColor="?attr/cj_pay_text_primary"
        android:id="@+id/cj_unify_pay_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cj_pay_currency_unit"
        app:layout_constraintBaseline_toBaselineOf="@+id/cj_unify_pay_total_value_container"
        app:layout_constraintEnd_toStartOf="@+id/cj_unify_pay_total_value_container"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <RelativeLayout
        android:id="@+id/cj_unify_pay_total_value_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cj_unify_pay_unit"
        app:layout_constraintTop_toTopOf="parent">
        <com.android.ttcjpaysdk.base.ui.component.money.CJMoneyTextComponent
            android:textSize="44dp"
            android:textStyle="bold"
            android:textColor="?attr/cj_pay_text_primary"
            android:id="@+id/cj_unify_pay_total_value_std"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cj_pay_padding_2"
            app:layout_constraintHorizontal_bias="0"/>
        <com.android.ttcjpaysdk.base.ui.widget.ScrollAnimTextView
            android:textSize="44dp"
            android:textStyle="bold"
            android:textColor="?attr/cj_pay_text_primary"
            android:id="@+id/cj_unify_pay_total_value"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cj_pay_padding_2"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_40"
        android:ellipsize="end"
        android:id="@+id/tv_unify_pay_origin_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/cj_unify_pay_total_value_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/cj_unify_pay_total_value_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
