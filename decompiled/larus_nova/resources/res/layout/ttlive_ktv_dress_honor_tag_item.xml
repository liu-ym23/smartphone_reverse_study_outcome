<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_ktv_honor_tag_item"
    android:layout_width="76dp"
    android:layout_height="76dp"
    android:layout_marginRight="14dp"
    android:layout_marginBottom="12dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_honor_tag_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ktv_honor_tag_tv"
        android:background="@drawable/ttlive_bg_ktv_room_nick_tag"
        android:paddingLeft="3dp"
        android:paddingTop="1dp"
        android:paddingRight="3dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_resident_singer"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_honor_tag_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/ktv_honor_tag_avatar"
        app:layout_constraintRight_toRightOf="@+id/ktv_honor_tag_avatar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_honor_tag_lock"
        android:background="@drawable/ttlive_bg_ktv_honor_tag_lock"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_honor_tag_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/ktv_honor_tag_avatar"
        app:layout_constraintRight_toRightOf="@+id/ktv_honor_tag_avatar"
        app:layout_constraintTop_toTopOf="@+id/ktv_honor_tag_avatar">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_ktv_honor_tag_lock"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ktv_honor_tag_expired_time"
        android:background="@drawable/ttlive_bg_ktv_honor_tag_expire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
