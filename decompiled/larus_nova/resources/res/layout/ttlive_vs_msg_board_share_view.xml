<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="280dp"
    android:layout_height="455dp"
    app:ttlive_leftBottomRadius="16dp"
    app:ttlive_rightBottomRadius="16dp">
    <ImageView
        android:id="@+id/preview_original_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="matrix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/preview_bottom"
        android:background="#ffffff"
        android:layout_width="280dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/preview_qr_code_container"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginBottom="15dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/preview_image_guide"
        android:background="@drawable/ttlive_share_poster_preview_image_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/preview_bottom"/>
    <TextView
        android:textSize="11.2sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_image_saving_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_image_guide"
        app:layout_constraintEnd_toStartOf="@+id/preview_qr_code_container"
        app:layout_constraintStart_toEndOf="@+id/preview_image_guide"
        app:layout_constraintTop_toTopOf="@+id/preview_image_guide"/>
    <ImageView
        android:id="@+id/preview_scan_guide"
        android:background="@drawable/ttlive_share_poster_preview_scan_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="54dp"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/preview_bottom"/>
    <TextView
        android:textSize="11.2sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_search_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_scan_guide"
        app:layout_constraintEnd_toStartOf="@+id/preview_qr_code_container"
        app:layout_constraintStart_toEndOf="@+id/preview_scan_guide"
        app:layout_constraintTop_toTopOf="@+id/preview_scan_guide"/>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
