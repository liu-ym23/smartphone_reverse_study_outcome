<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.voicecall.impl.ui.VoiceCallVideoView
        android:id="@+id/realtime_bg_video"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/realtime_bg_image"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/larus_dp_100"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/new_subtitle_bg_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/realtime_call_subtitle_bg_big"
            android:background="?attr/larus_bg_base_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/subtitle_bottom_bg_view"
            android:background="?attr/larus_realtime_bottom_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/live_video_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/liveVideoTopCover"
            android:background="@drawable/larus_bg_live_video_top_cover"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_200"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/realtime_bg_image_top_cover"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_390"
        android:src="@drawable/larus_bg_image_top_cover"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/realtime_bg_image_center_cover"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_320"
        app:layout_constraintBottom_toTopOf="@+id/realtime_bg_image_bottom"/>
    <ImageView
        android:id="@+id/realtime_bg_image_bottom"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_114"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
