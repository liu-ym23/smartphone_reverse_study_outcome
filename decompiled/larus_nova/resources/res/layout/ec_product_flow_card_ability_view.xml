<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="30dp"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/product_flow_card_ability_view_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/shopping_product_shop_window"/>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/product_flow_card_ability_view_tv"
        android:layout_width="30dp"
        android:layout_height="14dp"
        android:text="@string/commerce_store"
        android:lines="1"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</LinearLayout>
