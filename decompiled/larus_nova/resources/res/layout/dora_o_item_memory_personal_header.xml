<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/dora_o_memory_link_blue"
        android:gravity="center"
        android:id="@+id/memory_personal_add"
        android:background="@drawable/dora_o_bg_memory_card"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingTop="?attr/larus_dp_21"
        android:paddingRight="?attr/larus_dp_24"
        android:paddingBottom="?attr/larus_dp_21"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:text="@string/larus_dora_environmental_data_personal_add_cn"
        android:fontFamily="sans-serif-medium"/>
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:id="@+id/memory_personal_group_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:paddingStart="?attr/larus_dp_32"
        android:paddingEnd="?attr/larus_dp_24"
        style="@style/OSectionTitleBar.S"/>
</LinearLayout>
