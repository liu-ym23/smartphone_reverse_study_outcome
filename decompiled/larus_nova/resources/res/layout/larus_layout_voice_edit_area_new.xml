<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/voice_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/larus_speaker_voice_mute"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/voice_empty_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_modify_bot_voice_empty"
            android:layout_marginStart="?attr/larus_dp_16"/>
    </LinearLayout>
    <com.larus.voice_setting.voice.mix.VoiceSingleView
        android:id="@+id/voice_single_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adjust_area"
        android:paddingTop="?attr/larus_dp_4"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_single_view">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/pitch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_modify_bot_voice_bot_voice_card_slider_header1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <SeekBar
            android:id="@+id/pitch_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:max="12"
            android:progress="6"
            android:progressDrawable="?attr/larus_voice_general_progress"
            android:layout_marginEnd="?attr/larus_dp_44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pitch_title"
            style="@style/larus_mix_seekbar_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/pitch_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/pitch_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/pitch_progress"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/rate_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:text="@string/larus_modify_bot_voice_bot_voice_card_slider_header2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pitch_progress"/>
        <SeekBar
            android:id="@+id/rate_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:max="16"
            android:progress="6"
            android:progressDrawable="?attr/larus_voice_general_progress"
            android:layout_marginEnd="?attr/larus_dp_44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rate_title"
            style="@style/larus_mix_seekbar_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/rate_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/rate_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rate_progress"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
