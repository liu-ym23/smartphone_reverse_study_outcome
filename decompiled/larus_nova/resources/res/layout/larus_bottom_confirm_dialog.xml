<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_confirm_tip_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_17"
        android:layout_marginBottom="?attr/larus_dp_19"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_danger_50"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_confirm_tv"
        android:paddingTop="?attr/larus_dp_15"
        android:paddingBottom="?attr/larus_dp_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_cancel_tv"
        android:paddingTop="?attr/larus_dp_15"
        android:paddingBottom="?attr/larus_dp_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_cancel"/>
</LinearLayout>
