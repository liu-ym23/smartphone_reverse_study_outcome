<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingTop="@dimen/space_kit_len_20"
    android:paddingBottom="@dimen/space_kit_len_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/save_type_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true">
        <com.larksuite.component.universe_design.p010switch.UDSwitch
            android:id="@+id/switch_view"
            android:paddingTop="@dimen/space_kit_len_10"
            android:paddingBottom="@dimen/space_kit_len_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_kit_len_10"
            android:paddingEnd="0dp"
            android:layout_marginEnd="@dimen/space_kit_len_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_upload_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/test_upload_save_enable"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/file_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginBottom="@dimen/space_kit_len_20"
        android:layout_below="@+id/save_type_container"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_name"
            android:layout_marginEnd="@dimen/space_kit_len_10"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/colorful_blue"
            android:id="@+id/tv_save_file_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_selection"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="16sp"
        android:textColor="@color/static_white"
        android:id="@+id/btn_save"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/test_upload_save_title"
        android:layout_below="@+id/file_container"
        app:ud_backgroundColor="@color/ud_button_blue_bg"
        app:ud_radius="l"
        app:ud_strokeWidth="@dimen/ud_divider_size"
        style="@style/UDButton.Small.Primary"/>
</RelativeLayout>
