<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="337dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ll_title_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_back_view"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_round_close"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_title_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_service_detail_root_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_voucher_label"
        android:background="@drawable/cj_pay_bg_red_fff7f8_radius_8"
        android:paddingLeft="19dp"
        android:paddingRight="19dp"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="16dp"
        android:singleLine="true"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
</LinearLayout>
