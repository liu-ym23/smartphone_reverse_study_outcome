<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/aos_profile_card_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textColor="@color/aos_uikit_reverse_t_primary_light"
        android:id="@+id/aos_profile_card_entry_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/aos_profile_card_image"/>
    <View
        android:id="@+id/aos_profile_card_round"
        android:background="@drawable/aos_profile_card_round_light"
        android:visibility="invisible"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_toEndOf="@+id/aos_profile_card_entry_title"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="12sp"
        android:textColor="@color/aos_text_reverse3"
        android:id="@+id/aos_profile_card_entry_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/aos_profile_card_entry_title"
        android:layout_alignStart="@+id/aos_profile_card_entry_title"/>
</RelativeLayout>
