<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/mic_room_grab_mic_root"
    android:background="@drawable/ttlive_bg_official_channel_grab_mic_show_dialog"
    android:layout_width="match_parent"
    android:layout_height="264dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_official_channel_grab_mic_show_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        android:background="@drawable/ttlive_official_channel_grab_mic_show_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mic_room_info"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        app:layout_constraintTop_toTopOf="@+id/line">
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
            android:id="@+id/mic_room_avatar_thumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="23dp"
            android:layout_marginStart="16dp"
            app:backgroundImage="@drawable/ttlive_ic_withdraw_default_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/mic_room_info_nickname"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="28dp"
            android:text="@string/ttlive_official_channel_grab_mic_show_info_nickname"
            android:layout_marginStart="11dp"
            app:layout_constraintStart_toEndOf="@+id/mic_room_avatar_thumb"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/mic_room_info_auth"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="31dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/mic_room_info_nickname"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:id="@+id/mic_room_info_content"
            android:layout_width="260dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_official_channel_grab_mic_show_info_content"
            android:lines="2"
            android:lineSpacingExtra="1dp"
            android:layout_marginStart="11dp"
            app:layout_constraintStart_toEndOf="@+id/mic_room_avatar_thumb"
            app:layout_constraintTop_toBottomOf="@+id/mic_room_info_nickname"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mic_room_buttons"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/mic_room_info">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:id="@+id/mic_room_button_grab_refuse"
            android:background="@drawable/ttlive_bg_official_channel_grab_mic_show_button_refuse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_official_channel_grab_mic_show_button_grab_refuse"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/mic_room_button_grab_confirm"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mic_room_button_grab_confirm"
            android:background="@drawable/ttlive_bg_official_channel_grab_mic_show_button_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_official_channel_grab_mic_show_button_grab_confirm"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/mic_room_button_grab_refuse"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mic_room_buttons">
        <ImageView
            android:id="@+id/mic_room_never_notice"
            android:background="@drawable/ttlive_bg_official_channel_grab_mic_show_never_notice_unselected"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mic_room_never_notice_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:id="@+id/mic_room_never_notice_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_official_channel_grab_mic_show_never_notice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mic_room_never_notice"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
