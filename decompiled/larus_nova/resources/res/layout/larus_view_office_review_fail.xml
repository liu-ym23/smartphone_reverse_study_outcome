<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_left_back"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingLeft="?attr/larus_dp_19"
        android:paddingRight="?attr/larus_dp_19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back">
        <ImageView
            android:id="@+id/iv_lock"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:layout_marginBottom="?attr/larus_dp_20"
            android:src="@drawable/larus_office_no_permission_lock"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_24"
            android:text="@string/larus_mobile_docPermission_noAccess"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:gravity="start|top"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_32"
            android:minHeight="?attr/larus_dp_152"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_skip"
            android:background="@drawable/larus_bg_button_skip"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginBottom="?attr/larus_dp_200">
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:id="@+id/tv_skip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_btn_skip"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
