<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_introduction"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#e5ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_introduction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/iv_introduction"
        app:layout_constraintStart_toStartOf="@+id/iv_introduction"
        app:layout_constraintTop_toBottomOf="@+id/iv_introduction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
