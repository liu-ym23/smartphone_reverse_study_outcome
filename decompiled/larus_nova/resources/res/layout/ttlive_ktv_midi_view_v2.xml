<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/midi_tone_hit_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/midi_divide_line"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.KSongToneLinesView
        android:id="@+id/toneLines"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/midi_divide_line"
        android:background="#33ffffff"
        android:visibility="visible"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tonePoint"
        app:layout_constraintStart_toStartOf="@+id/tonePoint"/>
    <ImageView
        android:id="@+id/tonePoint_tail"
        android:visibility="gone"
        android:layout_width="55dp"
        android:layout_height="13dp"
        android:src="@drawable/ttlive_ktv_hit_float_ball_tail"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_component_midi_score_content"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tonePoint"
        app:layout_constraintEnd_toEndOf="@+id/tonePoint"
        app:layout_constraintStart_toStartOf="@+id/tonePoint">
        <ImageView
            android:id="@+id/ktv_component_midi_score_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ktv_component_midi_score_bg"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textStyle="normal"
            android:textColor="@color/ttlive_ktv_midi_score_low_text_color"
            android:gravity="center"
            android:id="@+id/ktv_component_midi_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/ttlive_ktv_score"
            android:includeFontPadding="false"
            android:fontFamily="arial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/tonePoint"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ttlive_ktv_hit_float_ball"
        android:layout_marginStart="94dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
