<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/anchor_whole_bg_rect_bg"
        android:background="@drawable/ttlive_bg_round_item"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignStart="@+id/anchor_info_container"
        android:layout_alignEnd="@+id/anchor_info_container">
        <View
            android:id="@+id/anchor_whole_animation_bg_rect"
            android:background="@drawable/ttlive_mic_room_show_list_bg_dark"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:layout_width="wrap_content"
        android:layout_height="22dp">
        <ImageView
            android:id="@+id/show_list_entrance"
            android:background="@drawable/ttlive_mic_room_show_list_bg_retangle"
            android:visibility="gone"
            android:layout_width="63dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_mic_room_show_list_entrance_img"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#7fffffff"
            android:id="@+id/count_down_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginEnd="1dp"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/head"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:scaleType="fitXY"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/name_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="4dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/right_layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="5"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:lineSpacingExtra="0.5dp"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/new_name_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="4dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/right_layout"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.livesdk.common.MarqueeTextView
                    android:id="@+id/new_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/right_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/follow_layout"
                    android:layout_width="32dp"
                    android:layout_height="22dp"
                    android:layout_marginRight="2dp">
                    <com.bytedance.android.live.core.widget.FitTextView
                        android:textSize="10dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/follow"
                        android:background="@drawable/ttlive_bg_mic_room_anchor_follow"
                        android:layout_width="32dp"
                        android:layout_height="18dp"
                        android:text="@string/ttlive_follow_label"/>
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/follow_progress"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@android:style/Widget.ProgressBar.Small"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/anchor_fans_icon"
                    android:background="@drawable/ttlive_bg_fans"
                    android:visibility="gone"
                    android:layout_width="22dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ttlive_ic_live_fans_broadcast"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="2dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</RelativeLayout>
