<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_3"/>
    <View
        android:id="@+id/album_item_select"
        android:background="@drawable/larus_ic_album_item_unselected"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_26"
        android:layout_height="?attr/larus_dp_26"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gallery_mask"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <ProgressBar
        android:id="@+id/album_item_processing"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_26"
        android:layout_height="?attr/larus_dp_26"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_6"
        android:indeterminateTint="@color/larus_bg_base_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_13"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:text="123123123123"
        android:layout_marginEnd="9.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
