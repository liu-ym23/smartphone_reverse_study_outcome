<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/ttlive_sticker_dialog_bg"
    android:layout_width="@dimen/ttlive_decoration_dialog_width"
    android:layout_height="@dimen/ttlive_sticker_decoration_dialog_fragment_height"
    android:layout_marginStart="@dimen/ttlive_decoration_dialog_horizontal_margin"
    android:layout_marginEnd="@dimen/ttlive_decoration_dialog_horizontal_margin">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/sticker_decoration_view_pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_sticker_decoration_dialog_fragment_height"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sticker_decoration_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorFullWidth="false"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/ttlive_white_50"/>
    </androidx.viewpager.widget.ViewPager>
</androidx.constraintlayout.widget.ConstraintLayout>
