<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/fans_club_medal"
        android:layout_width="96dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/fans_calub_unselected"
        android:background="@drawable/ttlive_bg_unselected_fans_club_medal"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:text="@string/ttlive_not_show_fans_club_medal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="4dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="@+id/fans_club_medal"
        app:layout_constraintStart_toStartOf="@+id/fans_club_medal"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/selected_icon"
        android:background="@drawable/ttlive_ic_fans_club_selected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="78dp"
        android:layout_marginTop="22dp"
        android:layout_marginStart="78dp"
        app:layout_constraintStart_toStartOf="@+id/fans_club_medal"
        app:layout_constraintTop_toTopOf="@+id/fans_club_medal"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_hs_s27"
        android:ellipsize="end"
        android:id="@+id/anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="96dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/fans_club_medal"
        app:layout_constraintStart_toStartOf="@+id/fans_club_medal"
        app:layout_constraintTop_toBottomOf="@+id/fans_club_medal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
