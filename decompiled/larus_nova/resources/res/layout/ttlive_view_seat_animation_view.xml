<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/emoji_mask_layer"
        android:background="@drawable/ttlive_bg_emoji_mask_layer"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/guest_seat_animation"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <com.bytedance.android.live.liveinteract.view.MicSeatSponsorView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ll_mic_seat_sponsor_anim"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="18dp"
        android:layout_marginTop="35dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/themed_competition_seat_animation"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.DynamicEmojiView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dynamic_emoji_view"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.LinkSucAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/link_suc_anim_view"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:actualImageScaleType="fitXY"/>
</FrameLayout>
