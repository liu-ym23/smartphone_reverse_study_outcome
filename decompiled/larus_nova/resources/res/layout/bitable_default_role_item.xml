<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:id="@+id/role_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/role_select"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/role_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/role_name"
        android:lineSpacingExtra="@dimen/space_kit_font_6"
        android:layout_toStartOf="@+id/role_select"
        android:layout_alignParentStart="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/role_select"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@color/primary_pri_500"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"/>
</RelativeLayout>
