<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/msg_swipe_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/chat_message_ai_recommend_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/top_region"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/msg_swipe_view_background_header_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_message_ai_recommend_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/msg_swipe_view_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/msg_swipe_view_background_bottom_padding"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/msg_swipe_view_background_header_padding"/>
    <Space
        android:id="@+id/msg_swipe_view_background_bottom_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chat_message_ai_recommend_bottom"/>
    <com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout
        android:id="@+id/avatar_region"
        android:clipChildren="false"
        android:layout_width="56dp"
        android:layout_height="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_region">
        <View
            android:id="@+id/avatar_click_region"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="@+id/avator"
            app:layout_constraintEnd_toEndOf="@+id/avator"
            app:layout_constraintStart_toStartOf="@+id/avator"
            app:layout_constraintTop_toTopOf="@+id/avator"/>
        <com.larksuite.component.decoration.avatar.DecoratedAvatar
            android:id="@+id/avator"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            app:decoratedAvatar_avatarLayout="@layout/message_common_avatar_lark_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/v_secret_sign"
            android:visibility="gone"
            android:layout_width="15dp"
            android:layout_height="15dp"
            app:layout_constraintCircle="@+id/avator"
            app:layout_constraintCircleAngle="135"
            app:layout_constraintCircleRadius="@dimen/dp_16"/>
    </com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout>
    <FrameLayout
        android:id="@+id/check_box_region"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/message_content_wrapper"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_barrier"
        app:layout_constraintTop_toTopOf="@+id/message_content_wrapper">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:layout_gravity="center"
            android:id="@+id/choose_message_checkbox"
            android:padding="0dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/chat_msg_group"
            app:layout_constraintHorizontal_bias="0.554"
            app:ud_checkbox_type="check_box"/>
    </FrameLayout>
    <View
        android:id="@+id/left_spacer"
        android:layout_width="16dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_barrier"/>
    <View
        android:id="@+id/right_spacer"
        android:layout_width="16dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toRightOf="@+id/right_barrier"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/left_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="avatar_region,check_box_region,left_spacer"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/right_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="right_spacer"/>
    <FrameLayout
        android:id="@+id/top_region"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintTop_toBottomOf="@+id/chat_message_ai_recommend_header"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/name_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintRight_toLeftOf="@+id/right_barrier"
        app:layout_constraintTop_toBottomOf="@+id/top_region">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/custom_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"/>
        <com.suite.lark.platform.component.widget_biz_userstatus.UserStatusLinearLayout
            android:id="@+id/user_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="9dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/message_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:singleLine="true"/>
    </LinearLayout>
    <com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout
        android:id="@+id/message_content_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintRight_toLeftOf="@+id/right_barrier"
        app:layout_constraintTop_toBottomOf="@+id/name_wrapper"
        app:layout_goneMarginTop="0dp">
        <com.ss.android.lark.chatwindow.view.widget.MeasureDetectSpareLayout
            android:id="@+id/chat_msg_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/time_read_state_container_align_bubble"
            app:layout_constraintTop_toTopOf="parent">
            <com.ss.android.lark.chatwindow.view.widget.MeasureDetectLKUIRoundLinearLayout
                android:orientation="vertical"
                android:id="@+id/bubble_content_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/chat_message_reply_stub"
                    android:layout="@layout/chat_window_reply_stub_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <ViewStub
                    android:id="@+id/chat_message_thread_reply_stub"
                    android:layout="@layout/chat_window_thread_reply_stub_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <View
                    android:id="@+id/reply_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.ss.android.lark.chatwindow.view.widget.MeasureDetectFrameLayout
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="12dp"/>
                <LinearLayout
                    android:layout_gravity="top"
                    android:orientation="horizontal"
                    android:id="@+id/excel_permission_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/excel_permission_name"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"/>
                    <com.ss.android.lark.chat.preview.components.view.SpinButton
                        android:id="@+id/excel_permission_button"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/reaction_divider"
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="4dp"/>
                <com.ss.android.lark.reaction.widget.flowlayout.ReactionFlowLayout
                    android:id="@+id/view_reaction"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"/>
                <ViewStub
                    android:id="@+id/my_ai_action"
                    android:layout="@layout/my_ai_message_action"
                    android:inflatedId="@+id/my_ai_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.ss.android.lark.chatwindow.view.widget.MeasureDetectLKUIRoundLinearLayout>
            <com.ss.android.lark.translate.cell_ui.TranslationAnimationView
                android:layout_gravity="bottom"
                android:id="@+id/show_translate_origin_lv"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="-15dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="-29dp"
                android:layout_marginEnd="-15dp"/>
        </com.ss.android.lark.chatwindow.view.widget.MeasureDetectSpareLayout>
        <FrameLayout
            android:id="@+id/time_read_state_container_align_bubble"
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="25dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/chat_msg_group"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/chat_msg_group"
            app:layout_constraintRight_toRightOf="parent">
            <include layout="@layout/chat_window_message_common_time_read_state_layout"/>
        </FrameLayout>
        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
            android:id="@+id/chat_message_mask"
            android:background="@color/selected_message_cell_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_msg_group"
            app:layout_constraintLeft_toLeftOf="@+id/chat_msg_group"
            app:layout_constraintRight_toRightOf="@+id/chat_msg_group"
            app:layout_constraintTop_toTopOf="@+id/chat_msg_group"/>
        <ImageView
            android:id="@+id/view_flag"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/chat_msg_group"
            app:layout_constraintTop_toTopOf="@+id/chat_msg_group"
            app:srcCompat="@drawable/ud_icon_flag_filled"
            app:tint="@color/colorful_red"/>
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView
            android:id="@+id/view_ding"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_svg_chat_msg_bubble_ding_icon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="@+id/chat_msg_group"
            app:layout_constraintTop_toTopOf="@+id/chat_msg_group"
            app:layout_goneMarginTop="0dp"/>
    </com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout>
    <com.ss.android.lark.chatbase.view.ChatMessageEditStatusView
        android:id="@+id/layout_msg_edit_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="@+id/message_content_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/message_content_wrapper"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/content_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="layout_msg_edit_status"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/reply_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/message_content_wrapper"
        app:layout_constraintStart_toStartOf="@+id/message_content_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/content_bottom_barrier">
        <ViewStub
            android:id="@+id/msg_from_view"
            android:visibility="gone"
            android:layout="@layout/chat_window_message_common_from_view"
            android:inflatedId="@+id/msg_from_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <ViewStub
            android:id="@+id/ai_summarize_stub"
            android:visibility="gone"
            android:layout="@layout/chat_window_message_common_ai_summarize"
            android:inflatedId="@+id/ai_summarize_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <ViewStub
            android:id="@+id/dlp_view"
            android:visibility="gone"
            android:layout="@layout/chat_window_message_common_dlp"
            android:inflatedId="@+id/dlp_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <ViewStub
            android:id="@+id/file_detect_view"
            android:visibility="gone"
            android:layout="@layout/chat_window_message_common_file_detect"
            android:inflatedId="@+id/file_detect_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <ViewStub
            android:id="@+id/message_restricted_view"
            android:visibility="gone"
            android:layout="@layout/chat_window_message_common_message_restricted"
            android:inflatedId="@+id/message_restricted_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/chat_message_ding_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:drawablePadding="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_link_normal"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/tv_reply_num"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_svg_message_tag_reply"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/imtoken_message_icon_pin"
            android:layout_gravity="start"
            android:id="@+id/chat_message_pin_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="2dp"
            android:drawableStart="@drawable/ic_svg_message_tag_pin"/>
    </LinearLayout>
    <com.ss.android.lark.chatwindow.view.burn.CountDownView
        android:textSize="12sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/tv_burn_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/message_content_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/reply_layout"
        app:layout_goneMarginTop="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/time_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="6dp"
        app:layout_constraintLeft_toLeftOf="@+id/message_content_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/tv_burn_time"/>
    <com.ss.android.lark.chat.chatwindow.biz.component.messagelist.render.block.followup.MessageFollowUpView
        android:id="@+id/my_ai_follow_up_quickactions"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/message_content_wrapper"
        app:layout_constraintStart_toStartOf="@+id/message_content_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/time_tv"/>
    <View
        android:id="@+id/chat_message_item_mask"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/chat_message_ai_recommend_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_tv"
        app:layout_constraintVertical_bias="0"/>
</com.ss.android.lark.chatwindow.view.widget.MeasureDetectConstraintLayout>
