<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginRight="24dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/head_view"
        android:background="@drawable/ttlive_bg_circle_head"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="7dp"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="8dp"
        android:textColor="@color/ttlive_pk_precision_match_dialog_status_accept_text"
        android:gravity="center"
        android:id="@+id/relation_desc"
        android:background="@drawable/ttlive_bg_registed_user_friend"
        android:paddingLeft="3dp"
        android:paddingTop="1dp"
        android:paddingRight="3dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/ttlive_registed_friend"
        android:paddingStart="3dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_live_dialog_title"
        android:gravity="center"
        android:id="@+id/user_name"
        android:layout_width="61dp"
        android:layout_height="17dp"
        android:layout_marginTop="2dp"
        android:text="@string/ttlive_registed_username"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_view"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_text_user_desc"
        android:gravity="center"
        android:id="@+id/user_desc"
        android:layout_width="61dp"
        android:layout_height="15dp"
        android:text="@string/ttlive_registed_userdesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
