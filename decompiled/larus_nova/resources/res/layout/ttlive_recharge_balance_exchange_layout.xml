<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/balance_exchange_layout"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="13dp"
        android:id="@+id/balance_exchange_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_recharge_balance_exchange_hint"/>
    <ImageView
        android:id="@+id/balance_exchange_hint_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:src="@drawable/ttlive_recharge_balance_exchange_hint_icon"
        android:layout_marginStart="3dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_recharge_balance_exchange_tip_text"
        android:id="@+id/custom_balance_exchange_tip"
        android:background="@drawable/ttlive_recharge_exchange_tip_bg"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="5dp"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/balance_exchange_select_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_recharge_balance_exchange_select"/>
</LinearLayout>
