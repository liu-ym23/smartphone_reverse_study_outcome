<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/LarkCCM_CM_Verify_AskOwner_Menu"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/CreationMobile_SecureLabel_Edit_ModifySubtitle"
        android:layout_marginStart="16dp"/>
    <FrameLayout
        android:background="@drawable/facade_round_around_l"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/facade_selector_item_float">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:gravity="top"
            android:id="@+id/input"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/CreationMobile_SecureLabel_Edit_ModifyDesc"
            android:maxLines="5"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/doneBtn"
            app:layout_constraintTop_toBottomOf="@+id/feedback"
            style="@style/UDEditText"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">
        <com.larksuite.component.universe_design.button.UDButton
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:id="@+id/doneBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/LarkCCM_CM_Verify_SendFeedback_Button"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            app:ud_radius="l"
            style="@style/UDButton.Small.Primary"/>
    </LinearLayout>
</LinearLayout>
