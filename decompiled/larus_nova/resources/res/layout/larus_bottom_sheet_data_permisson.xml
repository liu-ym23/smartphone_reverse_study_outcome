<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/larus_bottom_sheet_data_permisson_412917406"
    android:background="@drawable/larus_bg_bottom_sheet_data_permission"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:id="@+id/drag_indicator_card"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:cardCornerRadius="?attr/larus_dp_2"
        app:cardElevation="0dp">
        <View
            android:id="@+id/drag_indicator"
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/permission_toggle_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:cardBackgroundColor="@color/larus_base_2"
        app:cardCornerRadius="?attr/larus_dp_16"
        app:cardElevation="0dp">
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/permission_item_switch"
            android:background="@drawable/larus_bg_item_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.cardview.widget.CardView>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/permission_item_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/permission_description"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/dp_2"
        app:larus_linkColor="@color/larus_neutral_100"
        app:larus_linkUnderLine="false"/>
</LinearLayout>
