<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/poi_detail_navigation_bar_8429099"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/poi_navigation_status_bar"
        android:background="@color/POIBgPrimary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/nav_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_default_title_bar_height">
        <View
            android:id="@+id/poi_navigation_bar_bg"
            android:background="@color/POIBgPrimary"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="end|center_vertical"
            android:id="@+id/poi_header_share_stub"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/poi_navigation_lynx_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/poi_detail_navigation_back"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/poi_back_description"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"/>
            <com.bytedance.locallife.poi.newdetail.widget.lynx.PoiSimpleLynxView
                android:id="@+id/poi_detail_navigation_lynx"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
