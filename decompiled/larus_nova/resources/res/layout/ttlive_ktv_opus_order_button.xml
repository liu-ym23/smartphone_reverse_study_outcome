<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="43dp"
    android:layout_height="43dp">
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/ktv_mv_order_song_btn"
        android:background="@drawable/ttlive_ktv_opus_order_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginRight="3dp"
        android:text="@string/ttlive_interactive_audience_order_song"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#121212"
        android:gravity="center"
        android:id="@+id/ktv_mv_song_num"
        android:background="@drawable/ttlive_ktv_mv_song_count"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ktv_dress_yellow_dot"
        android:background="@drawable/ttlive_ktv_dress_yellow_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_margin="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
