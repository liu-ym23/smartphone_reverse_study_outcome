<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_pay_confirm_full_page"
    android:background="@color/cj_pay_color_black_opacity_34"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/layout_pay_confirm_half_page"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="280dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/close_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/cj_pay_close_icon_with_background"/>
        <com.android.ttcjpaysdk.base.ui.component.CJMoneyTextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center_horizontal"
            android:id="@+id/second_confirm_amount_tv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_2"
            android:letterSpacing="-0.01"
            app:CJPayMoneyCurrency="@string/cj_pay_currency_unit"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayImageSpanTextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_orange_FF6E26"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/second_confirm_voucher_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="2dp"
            android:maxLines="2"
            android:layout_below="@+id/confirm_amount"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/confirm_btn"
            android:background="@color/cj_pay_color_red_fe2c55"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/cj_pay_confirm"/>
    </LinearLayout>
</RelativeLayout>
