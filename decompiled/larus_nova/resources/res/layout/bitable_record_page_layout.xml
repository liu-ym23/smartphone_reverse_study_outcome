<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/record_page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/record_page_appbar_layout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/record_page_collapsed_layout"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/record_page_view_header_right_bg"
                        android:layout_width="500dp"
                        android:layout_height="250dp"
                        android:scaleType="fitXY"
                        android:layout_marginStart="42dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:srcCompat="@drawable/bitable_card_page_header_bg_right"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/record_page_view_header_left_bg"
                        android:layout_width="500dp"
                        android:layout_height="250dp"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:srcCompat="@drawable/bitable_card_page_header_bg_left"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:id="@+id/cover_view_pager_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/record_title_layout"
                    android:background="@drawable/bitable_card_page_record_title_round_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_pri_900"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/record_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:maxLines="2"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <com.bytedance.ee.bear.bitable.card.view.page.RecordCatalogView
                        android:id="@+id/catalog_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/record_page_titlebar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="pin">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/recordcard_title_ll_opt"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="44dp">
                        <FrameLayout
                            android:id="@+id/recordcard_close"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginStart="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/icon_n1"
                                app:srcCompat="@drawable/ud_icon_left_outlined"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="17sp"
                            android:textColor="@color/text_title"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/recordcard_table_title_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="12dp"
                            android:maxLines="1"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/recordcard_to_navigation"
                            app:layout_constraintStart_toEndOf="@+id/recordcard_close"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <FrameLayout
                            android:id="@+id/recordcard_menu_more"
                            android:visibility="visible"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/icon_n1"
                                app:srcCompat="@drawable/ud_icon_more_outlined"/>
                        </FrameLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@+id/recordcard_to_navigation"
                            android:padding="6dp"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:tint="@color/icon_n1"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/recordcard_menu_share"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ud_icon_more_launcher_outlined"/>
                        <FrameLayout
                            android:id="@+id/recordcard_menu_share"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/record_card_menu_subscribe"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/recordcard_menu_share_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/icon_n1"
                                app:srcCompat="@drawable/ud_icon_forward_outlined"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/record_card_menu_subscribe"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/record_page_menu_cover"
                            app:layout_constraintTop_toTopOf="parent">
                            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                                android:layout_gravity="center"
                                android:id="@+id/record_card_menu_subscribe_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                app:srcCompat="@drawable/ud_icon_subscribe_add_outlined"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/record_page_menu_cover"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/recordcard_menu_more"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/icon_n1"
                                app:srcCompat="@drawable/ud_icon_image_outlined"/>
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/add_record_titlebar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_kit_len_42"
                        android:paddingStart="@dimen/space_kit_len_12"
                        android:paddingEnd="@dimen/space_kit_len_12">
                        <TextView
                            android:textSize="@dimen/space_kit_font_16"
                            android:textColor="@color/text_title"
                            android:id="@+id/add_record_cancel_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Bitable_AdvancedPermission_AddRecordButtonCancel"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:textSize="@dimen/space_kit_font_16"
                            android:textColor="@color/text_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Bitable_AdvancedPermission_AddRecordTitle"
                            android:layout_centerInParent="true"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="@dimen/space_kit_font_16"
                            android:textColor="@color/primary_fill_default"
                            android:id="@+id/add_record_confirm_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Bitable_AdvancedPermission_AddRecordButtonAdd"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <com.larksuite.component.universe_design.notice.UDNotice
                        android:id="@+id/record_pin_notice"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ud_notice_backgroundColor="@color/function_warning_fill_solid_02"
                        app:ud_notice_icon="@drawable/ud_icon_warning_light_colorful"
                        app:ud_notice_iconBtn="@drawable/icon_feed_close"
                        app:ud_notice_iconColorful="true"
                        app:ud_notice_text="@string/Doc_Block_RecordFilteredTip"
                        app:ud_notice_textColor="@color/function_warning_fill_default"/>
                    <com.larksuite.component.universe_design.notice.UDNotice
                        android:id="@+id/record_pin_notice2"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:ud_notice_backgroundColor="@color/function_warning_fill_solid_02"
                        app:ud_notice_icon="@drawable/ud_icon_warning_light_colorful"
                        app:ud_notice_iconColorful="true"
                        app:ud_notice_text="@string/Doc_Block_RecordFilteredTip"
                        app:ud_notice_textColor="@color/function_warning_fill_default"/>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <com.larksuite.component.universe_design.tab.UDTabLayout
                android:id="@+id/tab_layout"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ud_tab_bottomDividerEnabled="false"
                app:ud_tab_gravity="start"
                app:ud_tab_indicatorAnimationDuration="0"
                app:ud_tab_indicatorFullWidth="false"
                app:ud_tab_mode="scrollable"/>
            <View
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_divider"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/no_permission_layout"
        android:background="@color/bg_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/no_permission_title"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <FrameLayout
                android:id="@+id/no_permission_recordcard_close"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="@color/icon_n1"
                    app:srcCompat="@drawable/ud_icon_left_outlined"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larksuite.component.universe_design.emptystate.UDEmptyState
            android:layout_gravity="center"
            android:id="@+id/no_permission_placeholder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ud_empty_desc="@string/Bitable_Relation_NoPermissionToAccessRecord"
            app:ud_empty_imageRes="@drawable/bitable_permission_limited_view"/>
    </FrameLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/submit_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ud_shadow_radius="30dp"
        style="@style/UDShadow.S3.Down.Pri">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/submit_record"
            android:background="@drawable/bitable_page_submit_record_bg"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginBottom="26dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/submit_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_done_outlined"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/submit_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"
                android:text="@string/Bitable_QuickAdd_Submit_Button"
                android:maxLines="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</FrameLayout>
