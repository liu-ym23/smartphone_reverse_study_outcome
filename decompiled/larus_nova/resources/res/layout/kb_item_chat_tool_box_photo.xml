<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginEnd="5dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_photo_preview"
        android:layout_width="129dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:srcCompat="@color/bg_body"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="start|bottom"
        android:id="@+id/tv_image_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        app:text="@string/Lark_IM_GIF_Tag"/>
    <View
        android:id="@+id/visible_mask"
        android:background="@color/fill_img_mask"
        android:layout_width="129dp"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:gravity="end|top"
        android:layout_gravity="end|top"
        android:id="@+id/v_selected_region"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:textSize="16dp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/v_selected"
            android:background="@drawable/checkbox_bg_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:button="@null"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="start|bottom"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        app:icon="@drawable/ud_icon_video_filled"
        app:tint="@color/static_white"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/v_mask"
        android:background="@color/static_white_60"
        android:layout_width="129dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/v_divider_mask"
        android:layout_width="129dp"
        android:layout_height="match_parent"/>
</FrameLayout>
