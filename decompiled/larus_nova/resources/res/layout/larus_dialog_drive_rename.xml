<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/static_black_transparent_1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/larus_drive_rename_dialog_container"
        android:background="@drawable/larus_drivesdk_bg_drive_confirm_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_50"
        android:layout_marginEnd="?attr/larus_dp_50">
        <TextView
            android:textSize="?attr/larus_sp_18"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/larus_drive_rename_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_27"
            android:layout_marginTop="?attr/larus_dp_24"
            android:text="@string/larus_drive_rename_header"
            android:includeFontPadding="false"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/larus_drive_rename_dialog_input"
            android:background="@drawable/larus_drivesdk_bg_drive_confirm_input"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_16"
            android:singleLine="true"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <View
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_24"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/larus_drive_rename_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/larus_drive_rename_btn_cancel"
                android:layout_weight="1"/>
            <View
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_0_5"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/larus_drive_rename_dialog_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/larus_drive_rename_btn_rename"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
