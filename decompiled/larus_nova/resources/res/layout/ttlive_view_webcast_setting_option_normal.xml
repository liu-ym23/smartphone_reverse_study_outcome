<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_dialog_main_text"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="91dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivTitleAbout"
        android:background="@drawable/ttlive_icon_circle_about"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="3dp"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/scene_switch_title"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintLeft_toRightOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/switchButton"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lsb_background="@color/ttlive_dialog_switch_button_unchecked"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="#67dca0"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#d9ffffff"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_dialog_desc_text"
        android:id="@+id/tvDesc"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
</merge>
