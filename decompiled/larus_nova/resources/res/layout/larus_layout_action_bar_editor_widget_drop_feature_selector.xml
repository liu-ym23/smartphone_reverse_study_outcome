<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="top"
        android:id="@+id/drop_feature_selector_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_0"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drop_feature_selector_btn"
        android:background="?attr/larus_bg_unselected_action_bar_instruction_widget_item"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drop_feature_selector_sub_title"
        app:layout_goneMarginBottom="?attr/larus_dp_0"
        app:layout_goneMarginTop="?attr/larus_dp_0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_drop_down_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/tv_selected_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_drop_down_label"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="?attr/larus_dp_14"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="@+id/tv_selected_option"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_selected_option"
            app:layout_constraintTop_toTopOf="@+id/tv_selected_option"
            app:srcCompat="?attr/larus_icon_chevron_down_fill"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/drop_down_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/drop_feature_selector_btn"
        app:layout_constraintStart_toEndOf="@+id/drop_feature_selector_btn"
        app:layout_constraintTop_toTopOf="@+id/drop_feature_selector_btn"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
