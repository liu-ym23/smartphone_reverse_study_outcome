<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/tv_sku_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_sku_optimize_sku_number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fe3824"
        android:id="@+id/tv_sku_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sku_number"
        app:layout_constraintStart_toEndOf="@+id/tv_sku_number"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#73161823"
        android:id="@+id/tv_sku_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_sku_optimize_count_divider"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sku_stock"
        app:layout_constraintStart_toEndOf="@+id/tv_sku_stock"
        app:layout_constraintTop_toTopOf="@+id/tv_sku_stock"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#73161823"
        android:id="@+id/tv_sku_user_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sku_number"
        app:layout_constraintStart_toEndOf="@+id/tv_sku_divider"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_sku_select_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shopping_sku_count_minus"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:gravity="center"
            android:id="@+id/tv_sku_select_count"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="32dp"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/iv_sku_select_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shopping_sku_count_plus"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
