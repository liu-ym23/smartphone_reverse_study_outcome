<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="432dp"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ttlive_white"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="432dp"
        android:layout_marginBottom="20dp"
        android:weightSum="4">
        <FrameLayout
            android:id="@+id/fl_apply_link_invitations"
            android:background="@color/ttlive_white"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="start|center_vertical"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_media_anchor_interact_link_invitation_allow_setting"
                android:layout_marginStart="16dp"/>
            <Switch
                android:layout_gravity="end|center_vertical"
                android:id="@+id/switch_apply_link_invitations"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:checked="false"
                android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
