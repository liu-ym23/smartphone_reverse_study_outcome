<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_close"
            android:visibility="invisible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_ic_multi_anchor_link_close"
            app:layout_constraintRight_toRightOf="@+id/fl_avatar_gender"
            app:layout_constraintTop_toTopOf="@+id/fl_avatar_gender"/>
        <FrameLayout
            android:id="@+id/fl_avatar_gender"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="center"
                android:id="@+id/iv_avatar"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ttlive_ic_multi_anchor_link_placeholder"
                app:placeholderImage="@drawable/ttlive_ic_default_head_small"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_status"
                android:background="@drawable/ttlive_bg_multi_anchor_link_status"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/iv_living"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ttlive_bg_anchor_link_living"/>
        </FrameLayout>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:maxEms="4"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="@+id/fl_avatar_gender"
            app:layout_constraintStart_toStartOf="@+id/fl_avatar_gender"
            app:layout_constraintTop_toBottomOf="@+id/fl_avatar_gender"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
