<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <View
        android:id="@+id/spread_bottom_line_left"
        android:background="@color/ttlive_color_1F_161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/spread_bottom_spread_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/spread_bottom_spread_layout"
        app:layout_constraintTop_toTopOf="@+id/spread_bottom_spread_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spread_bottom_spread_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_color_66_161823"
            android:id="@+id/spread_bottom_spread_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_spread_more_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/spread_bottom_spread_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/ttlive_icon_spread_more_icon_down"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/spread_bottom_spread_text"
            app:layout_constraintLeft_toRightOf="@+id/spread_bottom_spread_text"
            app:layout_constraintTop_toTopOf="@+id/spread_bottom_spread_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spread_bottom_line_right"
        android:background="@color/ttlive_color_1F_161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/spread_bottom_spread_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spread_bottom_spread_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
