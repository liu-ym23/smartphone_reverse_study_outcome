<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_bg_ffffff_corner_8"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/center_title"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="26dp"
        android:text="@string/gamecp_game_promote_comment_delete_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gamecp_game_promote_comment_delete_content"
        android:alpha="0.7"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_title"/>
    <View
        android:id="@+id/divider"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_content"
        style="@style/gamecp_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <Button
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/left_button"
            android:background="@drawable/shape_bg_ffffff_corner_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gamecp_game_promote_comment_delete_cancel"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:background="#1e161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/right_button"
            android:background="@drawable/shape_bg_ffffff_corner_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gamecp_game_promote_comment_delete_confirm"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
