<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_constraint_wrap"
    android:background="@drawable/aos_feed_bottom_panel_shape"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.comment.view.widget.CommentLoadingLayout
        android:id="@+id/comment_loading_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_write_comment"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.awemeopen.apps.framework.comment.view.widget.CommentLoadingLayout>
    <ViewStub
        android:id="@+id/forbid_view_stub"
        android:layout="@layout/aos_view_forbid_comment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/aos_comment_top_text_color"
        android:id="@+id/tv_comment_suction_word"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="大家都在搜:"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/comment_suction_word_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/comment_suction_word_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_top_search_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_suction_word"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_top_search_icon"
        android:background="@drawable/aos_ic_bg_comment_suction"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/aos_ic_comment_suction_search"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_top_search_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_top_search_close"
        android:background="@drawable/aos_ic_bg_comment_suction"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/aos_ic_comment_suction_close"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/aos_text_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_suction_word"/>
    <ImageView
        android:id="@+id/close_comment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/aos_aweme_comment_icon_comment_close"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/aos_bottom_write_comment_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
