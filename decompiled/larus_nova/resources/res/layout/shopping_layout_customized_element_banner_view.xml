<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_background"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:actualImageScaleType="fitXY"
        app:placeholderImage="@drawable/shopping_bg_live_list_banner"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
        android:id="@+id/cev_left_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="26dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="26dp"
        android:layout_alignParentStart="true"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
        android:id="@+id/cev_right_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/view_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="4dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"
        app:layoutMode="self_adjust_3X"/>
</merge>
