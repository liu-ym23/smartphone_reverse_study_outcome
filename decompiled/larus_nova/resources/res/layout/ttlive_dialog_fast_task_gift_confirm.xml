<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_dialog_fast_task_gift_confirm_bg"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="12dp"
    android:layout_width="280dp"
    android:layout_height="205dp">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_live_fast_task_gift_main_title"
        android:gravity="center"
        android:id="@+id/fast_task_gift_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_live_fast_task_gift_confirm_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_fast_task_gift_sub_title"
        android:gravity="center"
        android:id="@+id/fast_task_gift_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_live_fast_task_gift_confirm_message"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fast_task_gift_main"/>
    <Button
        android:textSize="15dp"
        android:textColor="@color/white"
        android:id="@+id/fast_task_gift_send"
        android:background="@drawable/ttlive_dialog_fast_task_gift_send_bg"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_live_fast_gift_confirm_send"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fast_task_gift_sub"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_live_fast_task_gift_cancel"
        android:gravity="center"
        android:id="@+id/fast_task_gift_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_live_fast_gift_cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fast_task_gift_send"/>
</androidx.constraintlayout.widget.ConstraintLayout>
