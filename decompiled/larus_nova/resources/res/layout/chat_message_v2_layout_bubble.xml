<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.view.InterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/left_spacer"
        android:layout_width="16dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right_spacer"
        android:layout_width="16dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toRightOf="@+id/right_barrier"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/left_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="bubble_layout_avatar_slot,left_spacer,bubble_layout_select_spacer"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/right_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="right_spacer"/>
    <com.ss.android.lark.blueprint.StubSlot
        android:id="@+id/bubble_layout_avatar_slot"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/left_spacer"
        app:layout_constraintRight_toLeftOf="@+id/left_barrier"
        app:layout_constraintTop_toBottomOf="@+id/bubble_layout_roof_slot"/>
    <com.ss.android.lark.blueprint.StubSlot
        android:id="@+id/bubble_layout_roof_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bubble_layout_top_slot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintRight_toLeftOf="@+id/right_barrier"
        app:layout_constraintTop_toBottomOf="@+id/bubble_layout_roof_slot"/>
    <com.ss.android.lark.chatwindow.view.widget.MessageBubbleBodyContainer
        android:orientation="horizontal"
        android:id="@+id/bubble_layout_main_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toRightOf="@+id/left_barrier"
        app:layout_constraintRight_toLeftOf="@+id/right_barrier"
        app:layout_constraintTop_toBottomOf="@+id/bubble_layout_top_slot"
        app:layout_goneMarginTop="0dp">
        <FrameLayout
            android:id="@+id/bubble_layout_bottom_end_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="25dp"
            android:paddingStart="5dp"/>
        <FrameLayout
            android:id="@+id/bubble_layout_top_end_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"/>
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/bubble_layout_body_mask_view"
            android:background="@color/selected_message_cell_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.ss.android.lark.blueprint.StubSlot
            android:id="@+id/bubble_layout_ding_icon_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.ss.android.lark.chatwindow.view.widget.MessageBubbleBodyContainer>
    <Space
        android:id="@+id/bubble_layout_select_spacer"
        android:layout_width="56dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_barrier"
        app:layout_constraintTop_toTopOf="@+id/bubble_layout_main_container"/>
    <com.ss.android.lark.blueprint.StubSlot
        android:id="@+id/bubble_layout_select_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/bubble_layout_main_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_barrier"
        app:layout_constraintTop_toTopOf="@+id/bubble_layout_main_container"/>
    <com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot
        android:orientation="vertical"
        android:id="@+id/bubble_layout_bottom_slot"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/bubble_layout_main_container"
        app:layout_constraintRight_toLeftOf="@+id/right_barrier"
        app:layout_constraintTop_toBottomOf="@+id/bubble_layout_main_container"/>
</com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.view.InterceptConstraintLayout>
