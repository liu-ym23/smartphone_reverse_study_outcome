<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ViewSwitcher
        android:layout_gravity="center"
        android:id="@+id/tab_name_switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:measureAllChildren="false"
        android:inAnimation="@anim/ttlive_gift_panel_page_scroll_guide_slide_in_bottom"
        android:outAnimation="@anim/ttlive_gift_panel_page_scroll_guide_slide_out_top"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/prop_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </ViewSwitcher>
    <View
        android:id="@+id/prop_panel_red_point"
        android:background="@drawable/ttlive_ic_red_point_tip"
        android:visibility="visible"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_toRightOf="@+id/tab_name_switcher"
        android:layout_alignTop="@+id/tab_name_switcher"
        android:layout_toEndOf="@+id/tab_name_switcher"/>
    <View
        android:id="@+id/sort_order_view"
        android:background="@drawable/ttlive_gift_default_sort_order"
        android:layout_width="9dp"
        android:layout_height="12dp"
        android:layout_marginTop="4dp"
        android:layout_toRightOf="@+id/tab_name_switcher"
        android:layout_toEndOf="@+id/tab_name_switcher"/>
    <View
        android:id="@+id/topic_label_view"
        android:background="@drawable/ttlive_gift_topic_label_unselected"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_toRightOf="@+id/tab_name_switcher"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tab_name_switcher"/>
</RelativeLayout>
