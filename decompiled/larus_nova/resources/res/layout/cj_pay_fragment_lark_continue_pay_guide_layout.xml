<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hint_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ll_hint_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <RelativeLayout
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/hint_icon"
                android:background="@color/cj_pay_color_red_fe2c55"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:layout_marginTop="@dimen/cj_pay_height_40"
                android:src="@drawable/cj_pay_continue_pay_guide_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center_horizontal"
                android:id="@+id/hint_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="@dimen/cj_pay_padding_24"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:layout_below="@+id/hint_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:gravity="center_horizontal"
                android:id="@+id/hint_sub_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="@dimen/cj_pay_padding_12"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:layout_below="@+id/hint_title"
                android:layout_centerHorizontal="true"/>
            <include
                android:id="@+id/confirm_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_marginBottom="@dimen/cj_pay_padding_16"
                android:layout_above="@+id/other_method_btn"
                layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:gravity="center"
                android:id="@+id/other_method_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/cj_pay_view_half_screen_loading_layout"/>
        </RelativeLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
