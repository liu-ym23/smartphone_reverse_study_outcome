<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_douyin_text_TextTertiary"
        android:id="@+id/title_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_open_platform_edit_label_explain_card"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/ttlive_douyin_text_TextPrimary"
        android:textColorHint="@color/ttlive_mini_app_title_editor_edit_hint"
        android:id="@+id/title_edit"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.5dp"
        android:layout_marginBottom="7.5dp"
        android:hint="@string/ttlive_open_platform_title_maximum_character"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/divider_line"
        app:layout_constraintEnd_toStartOf="@+id/clear_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_label"/>
    <ImageView
        android:id="@+id/clear_view"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ttlive_mini_app_title_editor_clear"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_edit"
        app:layout_constraintEnd_toStartOf="@+id/confirm_button"
        app:layout_constraintTop_toTopOf="@+id/title_edit"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ttlive_mini_app_title_editor_confirm_normal"
        android:gravity="center"
        android:id="@+id/confirm_button"
        android:background="@drawable/ttlive_mini_app_title_editor_confirm_bg"
        android:layout_width="50dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_open_platform_confirm"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_edit"/>
    <View
        android:id="@+id/divider_line"
        android:background="#1f161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/character_limit_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_mini_app_title_editor_alert"
        android:id="@+id/sensitive_words_alert_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_open_platform_sensitive_alert"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/character_limit_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider_line"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/ttlive_mini_app_title_editor_character_limit_normal"
        android:id="@+id/character_limit_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
