<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.widget.PriceView
        android:layout_gravity="bottom"
        android:id="@+id/min_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:priceBold="true"
        app:priceTextColor="@color/Primary"
        app:priceTextSize="22sp"
        app:spaceSize="1dp"
        app:thinDecimal="true"
        app:yangTextSize="16sp"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:layout_gravity="bottom"
        android:id="@+id/market_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:includeFontPadding="false"
        app:priceTextColor="#b3fe496a"
        app:priceTextSize="12sp"
        app:showDeleteLine="true"
        app:spaceSize="2dp"
        app:thinDecimal="true"
        app:yangTextSize="12sp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/filled_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="1dp">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/Primary"
            android:id="@+id/filled_money"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="@drawable/shopping_filled_money_stroke"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/filled_money"
            app:layout_constraintLeft_toLeftOf="@+id/filled_money"
            app:layout_constraintRight_toRightOf="@+id/filled_money"
            app:layout_constraintTop_toTopOf="@+id/filled_money"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/commerce_color_57161823"
        android:id="@+id/saled_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</merge>
