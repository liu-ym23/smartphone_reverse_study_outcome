<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/control_button_list"
    android:background="@color/white"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ttlive_input_dialog_input_container_height"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/function_button_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/container_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-5dp">
            <ImageButton
                android:id="@+id/control_emoji"
                android:background="@drawable/ttlive_control_emoji_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <ImageView
                android:id="@+id/red_dot"
                android:background="@drawable/ttlive_new_portrait_control_red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="26dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="26dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/container_audio2text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/control_audio2text"
                android:background="@drawable/ttlive_control_audio2text_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/control_button_group"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageButton
            android:id="@+id/control_keyboard"
            android:background="@drawable/ttlive_input_v3_switch_keyboard"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <ImageButton
            android:id="@+id/control_delete"
            android:background="@drawable/ttlive_input_v3_emoji_delete_off"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="21dp"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/control_send"
        android:background="@color/transparent"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ttlive_input_v3_send_off"
        android:layout_marginStart="21dp"/>
</LinearLayout>
