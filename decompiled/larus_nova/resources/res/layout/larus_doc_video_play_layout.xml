<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.doc.impl.video.widget.VideoPlayView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_centerInParent="true"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/retry_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/big_image_blank_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_refresh_white"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_photo_loading_retry"
            android:layout_below="@+id/big_image_blank_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:background="@drawable/larus_image_detail_top_shadow"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_207"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_common_slide_close"
        android:layout_marginStart="?attr/larus_dp_8"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_image_detail_icon_share_hollow"
        android:layout_marginEnd="?attr/larus_dp_8"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
