<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_white_bg_item_middle"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_68"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_drive_file_item_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_drive_file_icon"
            android:layout_width="?attr/larus_dp_42"
            android:layout_height="?attr/larus_dp_42"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/larus_drive_file_thumbnail"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/larus_drive_file_icon"
            app:layout_constraintEnd_toEndOf="@+id/larus_drive_file_icon"
            app:layout_constraintStart_toStartOf="@+id/larus_drive_file_icon"
            app:layout_constraintTop_toTopOf="@+id/larus_drive_file_icon"
            app:roundBottomEnd="true"
            app:roundBottomStart="true"
            app:roundTopEnd="true"
            app:roundTopStart="true"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/larus_drive_item_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_11"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/larus_drive_file_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/larus_drive_item_file_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/larus_drive_item_file_name"
            app:layout_constraintTop_toBottomOf="@+id/larus_drive_item_file_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
