<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.common.TouchDetectFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touch_detect_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bitable_app_content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/bitable_app_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/doc_web_container"/>
                <com.bytedance.ee.bear.bitable.infoarch.nativeview.BitableNativeViewContainer
                    android:id="@+id/bitable_native_view_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ViewStub
                    android:id="@+id/bitable_native_empty_view"
                    android:layout="@layout/bitable_native_empty_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/doc_appbar_layout"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/titleContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.bitable.app.titlebar.BitableAppTitleBar
                    android:gravity="center_vertical"
                    android:id="@+id/doc_main_title"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:widget_widgets_tb_background="@color/transparent"/>
                <ViewStub
                    android:id="@+id/doc_main_tip"
                    android:layout="@layout/doc_main_tips_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout
            android:id="@+id/bitable_app_drawer_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/contentOuterContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/pluginUIContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/permission_forbid_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.bytedance.ee.bear.bitable.common.TouchDetectFrameLayout>
