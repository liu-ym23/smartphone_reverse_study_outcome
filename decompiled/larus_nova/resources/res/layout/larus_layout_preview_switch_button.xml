<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_preview_switch_button"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_28">
    <FrameLayout
        android:id="@+id/indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="?attr/larus_dp_1"
        android:layout_marginEnd="?attr/larus_dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_state1"
        app:layout_constraintStart_toStartOf="@+id/btn_state1"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="?attr/larus_bg_preview_switch_button_indicator_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_4"/>
        <View
            android:background="?attr/larus_bg_preview_switch_button_indicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_2"
            android:layout_marginBottom="?attr/larus_dp_2"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_dp_13"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/btn_state1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:layout_marginBottom="?attr/larus_dp_2"
        android:maxWidth="?attr/larus_dp_100"
        android:text="@string/larus_html_detailScreen_label_preview"
        android:maxLines="1"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="?attr/larus_dp_10"
        android:layout_marginStart="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_state2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_13"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/btn_state2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:layout_marginBottom="?attr/larus_dp_2"
        android:maxWidth="?attr/larus_dp_100"
        android:text="@string/larus_html_detailScreen_label_code"
        android:maxLines="1"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="?attr/larus_dp_10"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_state1"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
