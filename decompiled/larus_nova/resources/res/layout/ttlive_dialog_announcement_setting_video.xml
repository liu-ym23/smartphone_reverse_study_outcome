<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLlAnnouncementDialogRoot"
    android:background="@drawable/ttlive_bg_prelive_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlAnnouncementDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mIvBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_dynamic_back"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:id="@+id/video_bind_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/ttlive_annocement_startlive_to_video_title"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12dp"
            android:gravity="center"
            android:id="@+id/tip_text"
            android:background="@color/ttlive_douyin_BGBrand2"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_bind_list"
            android:layout_width="match_parent"
            android:layout_height="400dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_white"
                android:id="@+id/selected_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_annocement_startlive_selected"
                android:layout_weight="1"/>
            <Button
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:id="@+id/confirm_btn"
                android:background="@drawable/uicomponent_bg_button_normal"
                android:layout_width="96dp"
                android:layout_height="36dp"
                android:text="@string/ttlive_live_confirm"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:layout_gravity="center"
        android:id="@+id/no_video_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_annocement_startliv_no_video_tips"/>
</FrameLayout>
