<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp">
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/group_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:circleCenterLeftMargin="30dp"
            app:circleCenterTopMargin="30dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/group_active"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/group_name_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/group_label"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#bfffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/group_label"
                android:background="@drawable/ttlive_bg_chat_channel_group_label"
                android:layout_width="48dp"
                android:layout_height="16dp"
                android:text="@string/ttlive_chat_channel_group_label"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/group_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_chat_channel_group_subtitle"
            android:maxLines="1"
            android:layout_below="@+id/group_name_container"/>
    </RelativeLayout>
    <com.bytedance.android.uicomponent.compoundbutton.TranslucentCheckBox
        android:id="@+id/group_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        style="@style/ttlive_standard_check_box_style"/>
</LinearLayout>
