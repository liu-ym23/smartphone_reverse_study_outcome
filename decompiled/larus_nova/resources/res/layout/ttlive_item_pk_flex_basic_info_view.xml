<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_live_pk_random_view_title"
        android:maxLines="1"
        android:maxEms="14"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_title">
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/tv_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pk_random_view_sub_title"
            android:maxEms="17"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ic_sub_title_rule"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintLeft_toRightOf="@+id/tv_sub_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_main_title"
            app:placeholderImage="@drawable/ttlive_ic_pk_flex_sub_title_rule"
            app:placeholderImageScaleType="fitXY"/>
    </LinearLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_background"
        android:visibility="visible"
        android:layout_width="106dp"
        android:layout_height="65dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_pk_flex_basic_info"
        app:placeholderImageScaleType="fitXY"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/ll_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:id="@+id/tv_countdown_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text="@string/ttlive_pk_flex_count_down_tips"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:id="@+id/tv_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_register"
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_interact_pk_dialog_random_emoji_button_hint"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_sub_title"/>
    <View
        android:id="@+id/divider"
        android:background="#0a161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_sub_title"/>
</merge>
