<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:paddingLeft="15dp"
    android:paddingTop="14dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_feed_black_text"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:maxEms="10"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_s7"
        android:gravity="center"
        android:id="@+id/tv_fans_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/iv_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_s7"
        android:gravity="center"
        android:id="@+id/tv_douyin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        android:text="@string/ttlive_feed_title_tag_tt"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/tv_fans_count"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:layout_goneMarginLeft="8dp"/>
    <View
        android:id="@+id/dislike_view"
        android:background="@drawable/ttlive_feed_new_dislike"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_feed_black_text"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_card_title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:maxEms="10"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
    <com.bytedance.android.livesdk.feed.drawerfeed.widget.FixedRatioRelativeLayout
        android:id="@+id/card_live_cover_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_card_title">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_card_live_cover_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@+id/tv_card_title"
            app:placeholderImage="@drawable/ttlive_feed_cover_loading"
            app:roundedCornerRadius="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_card_live_cover"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            app:placeholderImage="@drawable/ttlive_feed_cover_loading"
            app:placeholderImageScaleType="fitXY"
            app:roundedCornerRadius="@dimen/ttlive_dimen_feed_img_corner_radius"/>
    </com.bytedance.android.livesdk.feed.drawerfeed.widget.FixedRatioRelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/live_tag_status_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/card_live_cover_container"
        app:layout_constraintTop_toTopOf="@+id/card_live_cover_container">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/live_status_layout"
            android:background="@drawable/ttlive_feed_bg_live_status"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp">
            <com.bytedance.android.livesdk.feed.ui.XiguaLivingTagView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_white"
                android:id="@+id/tv_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="@string/ttlive_feed_on_live"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/live_main_tag_layout"
                android:visibility="gone"
                android:layout_width="62dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toLeftOf="@+id/card_live_cover_container"
                app:layout_constraintTop_toTopOf="@+id/card_live_cover_container">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_status_main_bg"
                    android:layout_width="66dp"
                    android:layout_height="16dp"
                    app:actualImageScaleType="centerCrop"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_live_status_main"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/ttlive_white"
                    android:id="@+id/tv_live_status_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_toRightOf="@+id/iv_live_status_main"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/live_secondary_tag_layout"
                android:visibility="gone"
                android:layout_width="66dp"
                android:layout_height="16dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="8dp">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_status_secondary_bg"
                    android:layout_width="66dp"
                    android:layout_height="16dp"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_live_status_secondary"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:layout_centerVertical="true"
                    app:actualImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/ttlive_white"
                    android:id="@+id/tv_live_status_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_toRightOf="@+id/iv_live_status_secondary"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/follow_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_tag_status_layout"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_content_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toRightOf="@+id/live_tag_status_layout"
        app:layout_constraintTop_toTopOf="@+id/card_live_cover_container"/>
    <com.bytedance.android.live.core.widget.CustomFontTextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/tv_audience_count"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_feed_live_audience_count_height"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="6dp"
        android:singleLine="true"
        android:shadowColor="@color/ttlive_feed_audience_count_shadow_color"
        android:shadowRadius="4"
        app:layout_constraintBottom_toBottomOf="@+id/card_live_cover_container"
        app:layout_constraintLeft_toLeftOf="@+id/card_live_cover_container"/>
    <View
        android:id="@+id/play_view"
        android:background="@drawable/ttlive_ic_preview_play"
        android:layout_width="47dp"
        android:layout_height="47dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_live_cover_container"
        app:layout_constraintLeft_toLeftOf="@+id/card_live_cover_container"
        app:layout_constraintRight_toRightOf="@+id/card_live_cover_container"
        app:layout_constraintTop_toTopOf="@+id/card_live_cover_container"/>
    <FrameLayout
        android:id="@+id/surface_container"
        android:background="@drawable/ttlive_feed_live_small_bg_radius2"
        android:padding="1dp"
        android:visibility="invisible"
        android:layout_width="2dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_live_cover_container"
        app:layout_constraintRight_toRightOf="@+id/card_live_cover_container"/>
    <View
        android:background="@color/ttlive_feed_open_d2_73"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_live_cover_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
