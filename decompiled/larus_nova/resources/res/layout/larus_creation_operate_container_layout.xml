<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_static_black"
        android:ellipsize="end"
        android:id="@+id/add_btn"
        android:background="@color/larus_static_white"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/larus_add_creation"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/publish_container"
        android:background="@color/larus_static_white"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minWidth="?attr/larus_dp_120"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/publish_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_creation_publish_icon_v2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/publish_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_static_black"
            android:ellipsize="end"
            android:id="@+id/publish_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creationPreview_btn_publish"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"
            app:autoSizeMaxTextSize="?attr/larus_sp_16"
            app:autoSizeMinTextSize="?attr/larus_sp_10"
            app:autoSizeStepGranularity="?attr/larus_sp_1"
            app:autoSizeTextType="uniform"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/publish_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/privacy_button_container"
        android:background="@drawable/larus_bg_creation"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rv_cornerRadius="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/privacy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_add_creation_private"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:autoSizeMaxTextSize="?attr/larus_sp_16"
            app:autoSizeMinTextSize="?attr/larus_sp_10"
            app:autoSizeStepGranularity="?attr/larus_sp_1"
            app:autoSizeTextType="uniform"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/more"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/more"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:src="@drawable/larus_creation_private_more_message"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/privacy_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
