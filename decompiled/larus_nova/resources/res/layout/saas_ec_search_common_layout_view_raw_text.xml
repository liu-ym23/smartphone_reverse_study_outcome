<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_result_text_info_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_short_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/search_color_161823"
            android:id="@+id/search_short_line_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/search_short_line_left"
            android:layout_width="33dp"
            android:layout_height="1dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/search_short_line_text"
            app:layout_constraintEnd_toStartOf="@+id/search_short_line_text"
            app:layout_constraintTop_toTopOf="@+id/search_short_line_text"/>
        <View
            android:background="@drawable/search_short_line_right"
            android:layout_width="33dp"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/search_short_line_text"
            app:layout_constraintStart_toEndOf="@+id/search_short_line_text"
            app:layout_constraintTop_toTopOf="@+id/search_short_line_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_text_with_icon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">
        <ImageView
            android:id="@+id/search_text_with_icon_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_text_with_icon_text_search"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/search_text_with_icon_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/search_color_8a8b90"
            android:id="@+id/search_text_with_icon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/search_text_with_icon_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_long_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/search_color_57161823"
            android:id="@+id/search_long_line_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/search_color_1f161823"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/search_long_line_text"
            app:layout_constraintEnd_toStartOf="@+id/search_long_line_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/search_long_line_text"/>
        <View
            android:background="@color/search_color_1f161823"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/search_long_line_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_long_line_text"
            app:layout_constraintTop_toTopOf="@+id/search_long_line_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/search_to_more"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="6dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/search_to_more_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/search_color_161823"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_to_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/search_color_fe2c55"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_to_more_text_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/search_to_more_text_guide"
                app:layout_constraintStart_toEndOf="@+id/search_to_more_text"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/search_color_161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_to_more_text_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/search_to_more_image_arrow"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/search_to_more_image_arrow"
                android:layout_width="9dp"
                android:layout_height="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/search_no_result"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/search_empty_text_with_icon_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search_text_with_icon_text_search"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/search_color_8a8b90"
                android:layout_gravity="center"
                android:id="@+id/search_empty_text_with_icon_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/search_jump"
            android:background="@drawable/search_common_button_bg_shape"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/search_color_161823"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_jump_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/search_color_fe2c55"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_jump_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <include
        android:id="@+id/ec_search_opt_title"
        layout="@layout/saas_ec_search_commodity_raw_text"/>
</FrameLayout>
