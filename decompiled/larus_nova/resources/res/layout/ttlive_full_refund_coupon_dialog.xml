<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="234dp"
    android:layout_height="370dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="234dp"
        android:layout_height="324dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/full_refund_coupon_bg"
            android:layout_width="234dp"
            android:layout_height="324dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_refund_coupon_main_text_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refund_coupon_main_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_avatar"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/ttlive_uikit_const_tPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refund_coupon_price_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:text="¥"
            android:includeFontPadding="false"
            app:layout_constraintBaseline_toBaselineOf="@+id/refund_coupon_price_text"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="44dp"
            android:textColor="@color/ttlive_uikit_const_tPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refund_coupon_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toEndOf="@+id/refund_coupon_price_flag"
            app:layout_constraintTop_toBottomOf="@+id/refund_coupon_main_text"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_uikit_const_tPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refund_coupon_price_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最高"
            app:layout_constraintBaseline_toBaselineOf="@+id/refund_coupon_price_text"
            app:layout_constraintStart_toEndOf="@+id/refund_coupon_price_text"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_douyin_light_TextSecondary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refund_coupon_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:layout_marginBottom="29dp"
            android:lineSpacingExtra="4dp"
            app:layout_constraintBottom_toTopOf="@+id/do_obtain_btn"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/commonui_white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/do_obtain_btn"
            android:background="@drawable/ttlive_bg_refund_btn"
            android:layout_width="168dp"
            android:layout_height="36dp"
            android:layout_marginBottom="40dp"
            android:text="@string/ttlive_full_refund_btn_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/coupon_dialog_dismiss"
        android:background="@drawable/ttlive_coupon_dialog_exit"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"/>
</LinearLayout>
