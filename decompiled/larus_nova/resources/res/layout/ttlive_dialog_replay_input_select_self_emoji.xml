<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_vs_select_self_emoji_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <View
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_vs_select_self_emoji"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintCircleRadius="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:roundedCornerRadius="4dp"/>
    <ImageView
        android:id="@+id/live_vs_select_self_emoji_remove_btn"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ttlive_ic_vs_self_emoji_remover"
        app:layout_constraintRight_toRightOf="@+id/live_vs_select_self_emoji"
        app:layout_constraintTop_toTopOf="@+id/live_vs_select_self_emoji"/>
</androidx.constraintlayout.widget.ConstraintLayout>
