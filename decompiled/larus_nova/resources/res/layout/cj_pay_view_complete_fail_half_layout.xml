<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_complete_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_status_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_icon_layout"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/cj_pay_status_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/cj_pay_value_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:gravity="top"
                    android:id="@+id/cj_pay_status_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_unit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_2"
                    android:text="@string/cj_pay_currency_unit"
                    android:layout_marginStart="@dimen/cj_pay_padding_2"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.05"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_detail_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="40dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_combine_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_sign_pay_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_buy_again_layout"
                android:background="@drawable/cj_pay_result_buy_again_area_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="44dp"
                android:layout_marginRight="30dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80161823"
                    android:gravity="center_vertical"
                    android:id="@+id/buy_again_title"
                    android:paddingLeft="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="15dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="15dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#cc161823"
                        android:id="@+id/buy_again_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#fe2c55"
                        android:gravity="center"
                        android:id="@+id/buy_again_desc_highlight"
                        android:background="@drawable/cj_pay_result_buy_again_red_bg"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <View
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#57161823"
                    android:id="@+id/buy_again_supplement"
                    android:paddingLeft="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.5dp"
                    android:layout_marginBottom="6dp"
                    android:paddingStart="15dp"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/cj_pay_view_half_screen_loading_layout"/>
        <include
            android:id="@+id/cj_pay_security_panel_loading_container"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            layout="@layout/cj_pay_view_security_panel_loading_container"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_btn_back"
            android:visibility="gone"
            android:layout_width="165dp"
            android:layout_height="44dp"
            android:layout_marginBottom="32dp"
            android:text="@string/cj_pay_outer_return_merchant"
            android:includeFontPadding="false"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/cj_pay_complete_insurance_tips_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:theme_type="0"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp">
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_status_button_shadow"
            android:paddingLeft="@dimen/cj_pay_padding_4"
            android:paddingRight="@dimen/cj_pay_padding_4"
            android:paddingBottom="@dimen/cj_pay_padding_8"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_height_168"
            android:layout_height="@dimen/cj_pay_height_48"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="16sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_status_button"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_height_160"
            android:layout_height="@dimen/cj_pay_height_40"
            android:includeFontPadding="false"/>
    </FrameLayout>
</FrameLayout>
