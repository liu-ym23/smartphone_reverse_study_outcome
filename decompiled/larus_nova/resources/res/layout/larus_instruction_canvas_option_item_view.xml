<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_63"
    android:layout_height="?attr/larus_dp_86"
    app:larus_rcv_bottomLeftRadius="?attr/larus_dp_8"
    app:larus_rcv_bottomRightRadius="?attr/larus_dp_8"
    app:larus_rcv_topLeftRadius="?attr/larus_dp_8"
    app:larus_rcv_topRightRadius="?attr/larus_dp_8">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_option_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="?attr/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <FrameLayout
        android:id="@+id/image_cover_loading_mask"
        android:background="@drawable/larus_bg_instruction_canvas_option_card_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/option_cover_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="1000"/>
    <FrameLayout
        android:id="@+id/option_icon_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_19">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/image_option_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="?attr/larus_base_4"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/option_icon_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
            android:indeterminateDuration="1000"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/option_card_mask"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_53">
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_option_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:maxWidth="?attr/larus_dp_72"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
</com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView>
