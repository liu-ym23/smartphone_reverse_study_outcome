<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.uikit.tabhost.FragmentTabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/tab_activity">
        <FrameLayout
            android:id="@android:id/tabcontent"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <TabWidget
            android:orientation="horizontal"
            android:id="@android:id/tabs"
            android:layout_alignParentBottom="true"
            style="@style/tab_widget_style"/>
        <FrameLayout
            android:id="@+id/realtabcontent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@android:id/tabs"
            android:layout_alignParentTop="true"/>
    </RelativeLayout>
</com.bytedance.android.live.uikit.tabhost.FragmentTabHost>
