<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insufficient_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/insufficient_panel_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/insufficient_image"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:layout_marginTop="@dimen/cj_pay_padding_36"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/cj_pay_cry_face_icon"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:layout_gravity="center_horizontal"
                android:id="@+id/insufficient_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="112dp"
                android:text="@string/cj_pay_insufficient_balance"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/credit_pay_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="172dp"
                android:layout_marginRight="@dimen/cj_pay_padding_24">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/credit_pay_image"
                    android:layout_width="@dimen/cj_pay_padding_16"
                    android:layout_height="@dimen/cj_pay_padding_16"
                    android:layout_marginRight="@dimen/cj_pay_padding_4"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/credit_pay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <HorizontalScrollView
                android:id="@+id/credit_pay_voucher_horizontal_scroll_view"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="208dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/credit_pay_voucher_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
            <include
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/insufficient_confirm_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:layout_marginBottom="44dp"
                layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/insufficient_other_method_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cj_pay_padding_13"
                android:singleLine="true"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/cj_pay_view_half_screen_loading_layout"/>
        </FrameLayout>
        <include
            android:id="@+id/cj_pay_security_panel_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_security_panel_loading_container"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
