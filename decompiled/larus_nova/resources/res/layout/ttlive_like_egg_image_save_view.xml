<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="312dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/saved_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintDimensionRatio="W,1:0.69"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_bar"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/qr_code"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="18dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="@+id/bottom_bar"/>
    <ImageView
        android:id="@+id/save_guide"
        android:background="@drawable/ttlive_ic_like_egg_save_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_image_saving_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_like_egg_save_view_save_guide"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/save_guide"
        app:layout_constraintEnd_toStartOf="@+id/qr_code"
        app:layout_constraintStart_toEndOf="@+id/save_guide"
        app:layout_constraintTop_toTopOf="@+id/save_guide"/>
    <ImageView
        android:id="@+id/scan_guide"
        android:background="@drawable/ttlive_ic_like_egg_scan_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="54dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar"/>
    <TextView
        android:textSize="11.2sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_search_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_like_egg_save_view_scan_guide"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/scan_guide"
        app:layout_constraintEnd_toStartOf="@+id/qr_code"
        app:layout_constraintStart_toEndOf="@+id/scan_guide"
        app:layout_constraintTop_toTopOf="@+id/scan_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
