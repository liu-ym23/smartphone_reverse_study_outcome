<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deep_feed_product_detail_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.shopping.deepfeed.weights.common.ProductTextView
            android:textSize="15dp"
            android:textColor="@color/shopping_color_FF003C"
            android:id="@+id/infeed_product_detail_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_infeed_product_detail_guide"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/infeed_product_detail_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
            android:id="@+id/infeed_product_detail_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/shopping_ic_deepfeed_product_arrow_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.shopping.deepfeed.weights.common.ProductTextView
        android:textSize="15dp"
        android:textColor="@color/shopping_color_000000"
        android:id="@+id/infeed_product_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/deep_feed_product_detail_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.ec.store.widget.BreakWordTextView
        android:textSize="15dp"
        android:textColor="@color/shopping_color_000000"
        android:id="@+id/infeed_product_break_word_title_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/deep_feed_product_detail_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/commerce_bg_product_feed_title_arrow_v2"
        android:layout_width="30dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/deep_feed_product_detail_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/skeleton_view"
        android:background="#f8f8f8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
