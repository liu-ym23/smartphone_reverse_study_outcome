<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ux_shadow_color="#26000000"
    app:ux_shadow_offset_x="?attr/larus_dp_0"
    app:ux_shadow_offset_y="?attr/larus_dp_0"
    app:ux_shadow_radius="?attr/larus_dp_12"
    app:ux_shadow_size="?attr/larus_dp_12">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/larus_bg_action_bar_instruction_spinner_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxHeight="?attr/larus_dp_500"
        android:minWidth="?attr/larus_dp_210">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/digital_avatar_regenerate_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_88"
            android:minHeight="?attr/larus_dp_48">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_digital_avatar_regenerate"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:src="@drawable/larus_digital_avatar_regenerate_icon_new"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_digital_avatar_regenerate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="?attr/larus_dp_90"
                android:text="@string/larus_portrait_bottomsheet_menuOption_replace"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/ic_digital_avatar_regenerate"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_16"
                app:layout_goneMarginStart="?attr/larus_dp_16"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/item_divider"
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/digital_avatar_delete_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_88"
            android:minHeight="?attr/larus_dp_48">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_digital_avatar_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:src="@drawable/larus_digital_avatar_trash_icon"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_danger_50"
                android:ellipsize="end"
                android:id="@+id/tv_digital_avatar_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="?attr/larus_dp_90"
                android:text="@string/larus_mob_ccBot_AIReplica_menuBtn_delete"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/ic_digital_avatar_delete"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_16"
                app:layout_goneMarginStart="?attr/larus_dp_16"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.larus.common_ui.widget.ShadowLayout>
