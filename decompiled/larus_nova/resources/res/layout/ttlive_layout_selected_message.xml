<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ttlive_bg_selected_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.chatroom.widget.LiveMessageRecyclerView
        android:id="@+id/selected_messages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#80ffffff"
        android:layout_gravity="center"
        android:id="@+id/empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_no_selected_msg_hint"/>
    <TextView
        android:layout_gravity="top|right"
        android:id="@+id/more_panel_entry"
        android:background="@drawable/ttlive_selected_message_more_panel_entry"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"/>
</merge>
