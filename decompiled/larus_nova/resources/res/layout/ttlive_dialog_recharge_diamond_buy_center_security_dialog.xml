<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_recharge_security_protocol_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/top_image_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
            android:id="@+id/top_image"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:layout_marginTop="19dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/top_close"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            custom:placeholderImage="@drawable/ttlive_ic_hs_room_center_dialog_close"
            custom:placeholderImageScaleType="centerCrop"/>
    </RelativeLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:gravity="left"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#08161823"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:background="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                custom:actualImageResource="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#bf161823"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_charge_security_diamond_buy_center_tip1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:background="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                custom:actualImageResource="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#bf161823"
                android:id="@+id/center_text_tip2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:background="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"
                custom:actualImageResource="@drawable/ttlive_bg_recharge_security_protocol_diamond_dialog_point"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#bf161823"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_charge_security_diamond_buy_center_tip3"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:id="@+id/room_center_button"
        android:background="@drawable/ttlive_bg_room_review_dialog_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="47dp"/>
    <include
        android:id="@+id/room_center_button_layout"
        layout="@layout/ttlive_dialog_recharge_security_one_button"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_center_bottom_tip"
        android:gravity="center"
        android:id="@+id/room_center_bottom_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:drawableLeft="@drawable/ttlive_ic_illegal_warning"
        android:drawablePadding="8dp"
        android:lineSpacingExtra="2dp"
        android:drawableStart="@drawable/ttlive_ic_illegal_warning"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
