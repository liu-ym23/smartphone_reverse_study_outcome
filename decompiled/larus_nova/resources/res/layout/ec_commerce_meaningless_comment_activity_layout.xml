<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_meaningless_comment_activity_layout_922701280"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/commerce_back_view"
        android:background="@drawable/commerce_comment_back_black"
        android:layout_width="@dimen/commerce_anchor_v3_comment_back_icon_size"
        android:layout_height="@dimen/commerce_anchor_v3_comment_back_icon_size"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="49dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/TextReverse"
        android:id="@+id/tv_comment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_shrink_comment"
        app:layout_constraintBottom_toBottomOf="@+id/commerce_back_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/commerce_back_view"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/color_33black"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="88dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shrink_comment_rv"
        android:background="@color/shopping_color_08161823"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
