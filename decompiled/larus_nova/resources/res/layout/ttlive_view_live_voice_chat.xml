<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/talkroom_root_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/voice_chat_container_new"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.liveinteract.hamlet.HamletInterceptTouchFrameLayout
        android:id="@+id/hamlet_avatar_surfaceview_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/video_surface_dummy_container"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <FrameLayout
        android:id="@+id/ai_mv_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/base_common_window_layout"
        android:visibility="gone"
        layout="@layout/ttlive_base_multi_link_voice_window_manager"/>
    <FrameLayout
        android:id="@+id/dynamic_layers_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/dynamic_float_anchor_window_layout"
        android:visibility="gone"
        layout="@layout/ttlive_video_dynamic_float_anchor_multi_link_window_manager"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/play_mode_status_effect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="105dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/request_song_status_effect"
        android:visibility="gone"
        android:layout_width="111dp"
        android:layout_height="121dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/themed_competition_status_effect"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="110dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/guest_battle_rank_transition_container_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guest_battle_rank_first_transition_icon_root"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:placeholderImage="@drawable/ttlive_guest_battle_tiny_crown"/>
    </FrameLayout>
    <android.opengl.GLSurfaceView
        android:id="@+id/interact_render_container_voice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
