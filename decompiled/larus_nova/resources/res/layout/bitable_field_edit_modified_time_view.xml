<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/specifyFieldsContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/specifyFieldsTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_kit_len_2"
            android:text="@string/Bitable_DB_LastModifiedDateField_SpecifiedFields_Option"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/specifyFieldsSelector"
            android:background="@drawable/facade_round_around_xl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_2"
            android:minHeight="@dimen/space_kit_len_52"
            android:paddingStart="@dimen/space_kit_len_8"
            android:paddingEnd="@dimen/space_kit_len_16"
            android:backgroundTint="@color/facade_selector_item_float">
            <com.bytedance.ee.bear.bitable.fieldedit.view.edit.modifiedtime.MultiFieldItemView
                android:id="@+id/specifyFieldsSelectorView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_10"
                android:layout_marginBottom="@dimen/space_kit_len_10"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_kit_len_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/function_danger_content_default"
            android:id="@+id/specifyFieldsError"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_2"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/timeFormatTV"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_BTModule_DateTimeFormat"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/timeFormatSelector"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/timeFormatSelectorTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:text=""
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
</LinearLayout>
