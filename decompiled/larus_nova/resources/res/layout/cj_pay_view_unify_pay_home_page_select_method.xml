<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_r8_gray"
    android:paddingTop="@dimen/cj_pay_padding_6"
    android:paddingBottom="@dimen/cj_pay_padding_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_fold_header"
        android:paddingLeft="@dimen/cj_pay_padding_16"
        android:paddingTop="@dimen/cj_pay_padding_8"
        android:paddingRight="@dimen/cj_pay_padding_16"
        android:paddingBottom="@dimen/cj_pay_padding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="#99161823"
                android:id="@+id/select_method_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/partition_title_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/tv_works_area"
            android:layout_alignBottom="@+id/tv_works_area"
            android:layout_marginEnd="@dimen/cj_pay_padding_10">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_chosen_method_icon"
                android:layout_width="@dimen/cj_pay_padding_13"
                android:layout_height="@dimen/cj_pay_padding_13"
                android:layout_marginEnd="@dimen/cj_pay_padding_4"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_chosen_method_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/cj_pay_height_160"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tv_works_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_blue"
                android:id="@+id/tv_combine_switch"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_text_cancel"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:id="@+id/ll_open_method_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_13"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_text_more"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/cj_pay_padding_12"
                    android:layout_height="@dimen/cj_pay_padding_12"
                    android:src="@drawable/cj_pay_ic_arrow_down"
                    android:contentDescription="@string/cj_pay_text_more"
                    android:layout_marginStart="@dimen/cj_pay_padding_4"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/cj_unify_method_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/select_method_root_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_combine_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/balance_item_root_layout"
                    android:background="@drawable/cj_pay_bg_gray_press_selector"
                    android:paddingLeft="@dimen/cj_pay_padding_16"
                    android:paddingTop="@dimen/cj_pay_padding_14"
                    android:paddingRight="@dimen/cj_pay_padding_16"
                    android:paddingBottom="@dimen/cj_pay_padding_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/balance_item_layout"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/combine_balance_icon"
                            android:layout_width="@dimen/cj_pay_padding_18"
                            android:layout_height="@dimen/cj_pay_padding_18"
                            android:layout_marginEnd="@dimen/cj_pay_padding_12"/>
                        <TextView
                            android:textSize="@dimen/cj_pay_font_size_15"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:id="@+id/combine_balance_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/cj_pay_font_size_13"
                            android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                            android:id="@+id/combine_balance_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/cj_pay_padding_4"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/cj_pay_padding_30"
                        android:layout_marginTop="@dimen/cj_pay_padding_4"
                        android:layout_marginEnd="60dp">
                        <TextView
                            android:textSize="@dimen/cj_pay_font_size_13"
                            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                            android:ellipsize="end"
                            android:id="@+id/combine_balance_subtitle"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/combine_subtitle_icon"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/combine_subtitle_icon"
                            android:visibility="gone"
                            android:layout_width="@dimen/cj_pay_padding_14"
                            android:layout_height="@dimen/cj_pay_padding_14"
                            android:src="@drawable/cj_pay_info_icon"
                            android:scaleType="centerCrop"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/combine_balance_subtitle"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bankcard_item_root_layout"
                    android:background="@drawable/cj_pay_bg_gray_press_selector"
                    android:paddingLeft="@dimen/cj_pay_padding_16"
                    android:paddingTop="@dimen/cj_pay_padding_14"
                    android:paddingRight="@dimen/cj_pay_padding_16"
                    android:paddingBottom="@dimen/cj_pay_padding_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/bankcard_item_layout"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/combine_card_icon"
                            android:layout_width="@dimen/cj_pay_padding_18"
                            android:layout_height="@dimen/cj_pay_padding_18"
                            android:layout_marginEnd="@dimen/cj_pay_padding_12"/>
                        <TextView
                            android:textSize="@dimen/cj_pay_font_size_15"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:ellipsize="middle"
                            android:id="@+id/combine_card_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/combine_change_arrow"
                            android:layout_width="@dimen/cj_pay_padding_14"
                            android:layout_height="@dimen/cj_pay_padding_14"
                            android:layout_marginLeft="@dimen/cj_pay_padding_4"
                            android:src="@drawable/cj_pay_icon_combine_right_arrow_gray"
                            android:scaleType="centerCrop"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/cj_pay_font_size_13"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:id="@+id/combine_card_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/cj_pay_padding_4"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/cj_pay_font_size_13"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                        android:ellipsize="end"
                        android:id="@+id/cj_pay_std_asset_subtitle"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/cj_pay_padding_30"
                        android:layout_marginTop="@dimen/cj_pay_padding_4"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
                        android:gravity="left"
                        android:id="@+id/cj_unify_pay_std_asset_voucher"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/cj_pay_padding_30"
                        android:layout_marginTop="@dimen/cj_pay_padding_4"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_multi_method_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.method.view.CJUnifySelectSingleMethodView
                android:id="@+id/single_method_item"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/v_scroll_fade_bottom"
        android:background="@drawable/cj_pay_scroll_fade_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="-20dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_open_method_list_bottom"
        android:paddingTop="@dimen/cj_pay_padding_4"
        android:paddingBottom="@dimen/cj_pay_padding_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:minHeight="20dp">
        <ImageView
            android:layout_width="@dimen/cj_pay_padding_12"
            android:layout_height="@dimen/cj_pay_padding_12"
            android:src="@drawable/cj_pay_ic_arrow_down"
            android:contentDescription="@string/cj_pay_text_more"/>
    </LinearLayout>
</LinearLayout>
