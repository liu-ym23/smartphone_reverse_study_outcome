<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="146dp">
    <FrameLayout
        android:background="@drawable/bitable_card_view_setting_top_bg"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bitable_card_view_setting_rec_top_bg"
            android:layout_width="136dp"
            android:layout_height="62dp"
            android:layout_marginTop="22dp">
            <View
                android:id="@+id/line1_1"
                android:background="@drawable/bitable_card_view_setting_line_graph_blue_deep"
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"/>
            <View
                android:id="@+id/line2_1"
                android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                android:layout_width="30dp"
                android:layout_height="4dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/line1_1"/>
            <View
                android:id="@+id/line3_1"
                android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/line2_1"/>
            <View
                android:id="@+id/horizontal_line1"
                android:background="@drawable/bitable_card_view_setting_divider_graph"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="6.5dp"
                android:layout_below="@+id/line1_1"/>
            <View
                android:id="@+id/horizontal_line2"
                android:background="@drawable/bitable_card_view_setting_divider_graph"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="7.5dp"
                android:layout_below="@+id/line2_1"/>
            <View
                android:id="@+id/vertical_line1"
                android:background="@drawable/bitable_card_view_setting_divider_graph"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginLeft="70dp"/>
            <View
                android:id="@+id/vertical_line2"
                android:background="@drawable/bitable_card_view_setting_divider_graph"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginLeft="115dp"/>
            <View
                android:id="@+id/line1_2"
                android:background="@drawable/bitable_card_view_setting_circle_graph_green"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="9.5dp"
                android:layout_toRightOf="@+id/line1_1"/>
            <View
                android:id="@+id/line1_3"
                android:background="@drawable/bitable_card_view_setting_line_graph_green"
                android:layout_width="16dp"
                android:layout_height="4dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@+id/line1_2"/>
            <View
                android:id="@+id/line2_2"
                android:background="@drawable/bitable_card_view_setting_circle_graph_blue"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="14dp"
                android:layout_toRightOf="@+id/line2_1"
                android:layout_below="@+id/line1_2"/>
            <View
                android:id="@+id/line2_3"
                android:background="@drawable/bitable_card_view_setting_line_graph_blue"
                android:layout_width="16dp"
                android:layout_height="4dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@+id/line2_2"
                android:layout_below="@+id/line1_2"/>
            <View
                android:id="@+id/line3_2"
                android:background="@drawable/bitable_card_view_setting_circle_graph_purple"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:layout_toRightOf="@+id/line3_1"
                android:layout_below="@+id/line2_2"/>
            <View
                android:id="@+id/line3_3"
                android:background="@drawable/bitable_card_view_setting_line_graph_purple"
                android:layout_width="16dp"
                android:layout_height="4dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@+id/line3_2"
                android:layout_below="@+id/line2_3"/>
        </RelativeLayout>
    </FrameLayout>
    <FrameLayout
        android:background="@color/bg_float"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bitable_card_view_setting_text_color"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Mobile_CardMode_Grid"/>
    </FrameLayout>
</LinearLayout>
