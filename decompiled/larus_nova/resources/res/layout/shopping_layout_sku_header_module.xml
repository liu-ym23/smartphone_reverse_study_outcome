<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sku_header_container"
    android:paddingTop="16dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sdv_sku_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/sdv_sku_select_pop_cover"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginLeft="16dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sdv_sku_background"
        app:placeholderImage="@drawable/shopping_ic_sku_good_small_default"
        app:roundedCornerRadius="2dp"/>
    <RelativeLayout
        android:id="@+id/sdv_sku_right_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sdv_sku_select_pop_cover"
        app:layout_constraintTop_toTopOf="@+id/sdv_sku_select_pop_cover">
        <RelativeLayout
            android:id="@+id/rl_sku_price_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_sku_first_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/shopping_std_brand"
                    android:gravity="center_horizontal"
                    android:id="@+id/sku_price_header"
                    android:paddingTop="6dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_sku_sec_kill_wrapper"
                    android:background="@drawable/shopping_bg_sku_seckill_tag"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/sec_kill_image"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/shopping_ic_sec_kill"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textColor="@color/shopping_std_brand"
                        android:gravity="center"
                        android:id="@+id/sec_kill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shopping_sku_seckill"
                        style="@style/font_size_20"/>
                </LinearLayout>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/sku_sv_activity_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textColor="@color/shopping_std_brand"
                    android:id="@+id/tv_sku_deposit_price"
                    android:background="@drawable/shopping_bg_sku_deposit_presale"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_size_24"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_sku_price_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_below="@+id/ll_sku_first_container">
                <RelativeLayout
                    android:id="@+id/rl_sku_price_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.ec.core.widget.PriceView
                        android:id="@+id/pv_sku_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:extraTextColor="@color/ec_color_FE2C55"
                        app:prefixSpaceSize="2dp"
                        app:prefixTextSize="11sp"
                        app:priceBold="true"
                        app:priceDecimalTextSize="13sp"
                        app:priceTextColor="@color/shopping_std_brand"
                        app:priceTextSize="20sp"
                        app:pv_autoResize="true"
                        app:spaceSize="1dp"
                        app:suffixTextSize="11sp"
                        app:thinDecimal="true"
                        app:yangTextSize="13sp"/>
                    <com.bytedance.android.ec.core.widget.PriceView
                        android:id="@+id/pv_sku_origin_price"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginBottom="2dp"
                        android:layout_toRightOf="@+id/pv_sku_price"
                        android:layout_alignBottom="@+id/pv_sku_price"
                        android:layout_marginStart="6dp"
                        android:layout_toEndOf="@+id/pv_sku_price"
                        app:prefixSpaceSize="2dp"
                        app:priceTextColor="@color/shopping_std_text_black_3"
                        app:priceTextSize="12dp"
                        app:pv_autoResize="true"
                        app:showDeleteLine="true"
                        app:spaceSize="1dp"
                        app:thinDecimal="true"/>
                </RelativeLayout>
                <include
                    android:id="@+id/layout_discount_price_container"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    layout="@layout/shopping_layout_sku_discount_price"/>
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/fl_sku_benefit_tip_or_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/rl_sku_price_info_container">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_std_text_modal_1"
                android:id="@+id/tv_sku_installment_benefit_tip"
                android:background="@drawable/shopping_bg_dou_installment_benefit"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_std_text_black_3"
                android:id="@+id/tv_sku_total"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shopping_std_text_black_2"
            android:ellipsize="end"
            android:id="@+id/tv_sku_select_spec"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="80dp"
            android:maxLines="1"
            android:layout_below="@+id/fl_sku_benefit_tip_or_stock"
            android:lineSpacingExtra="2dp"
            android:layout_marginEnd="80dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_sku_detail_entrance"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_sku_select_spec"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_std_text_black_3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/shopping_sku_detail"
                android:layout_marginEnd="2dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/shopping_ic_sku_forward"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
