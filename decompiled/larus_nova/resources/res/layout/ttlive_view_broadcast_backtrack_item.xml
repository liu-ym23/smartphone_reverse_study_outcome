<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/ttlive_broadcast_more_action_root_height"
    android:minHeight="@dimen/ttlive_broadcast_more_action_root_height">
    <RelativeLayout
        android:layout_width="@dimen/ttlive_broadcast_more_action_width"
        android:layout_height="@dimen/ttlive_broadcast_more_action_height"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <View
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/anchor_backtrack_little_icon"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="21dp"
            android:scaleType="center"
            android:layout_alignLeft="@+id/icon"
            android:layout_marginStart="2dp"/>
        <com.bytedance.android.livesdk.chatroom.widget.LiveCircleProgressView
            android:id="@+id/anchor_backtrack_little_progress"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="25dp"
            android:layout_alignLeft="@+id/icon"/>
        <ImageView
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_ic_red_point_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/icon"
            android:layout_alignRight="@+id/icon"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:layout_below="@+id/icon"/>
    </RelativeLayout>
</RelativeLayout>
