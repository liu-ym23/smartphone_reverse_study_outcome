<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_write_comment"
    android:background="@color/aos_bg_secondary3"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <View
        android:id="@+id/view_divider"
        android:background="@color/aos_line_primary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_write_comment"
        android:background="@drawable/aos_write_comment_panel_shape"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_comment_publish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/aos_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aos_write_comment_hint"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/iv_write_comment_emoji"/>
        <ImageView
            android:id="@+id/iv_write_comment_emoji"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/aos_write_comment_emoji"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/aos_comment_publish_button_text_color_selector"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_comment_publish"
        android:background="@drawable/aweme_comment_selector_send_button"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:text="发送"
        android:maxLines="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rl_write_comment"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
