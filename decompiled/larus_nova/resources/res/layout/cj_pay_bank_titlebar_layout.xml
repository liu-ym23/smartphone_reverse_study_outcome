<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_titlebar_layout"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <RelativeLayout
        android:id="@+id/cj_pay_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_back_view"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cj_pay_title_content_layout"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_brand_icon"
                android:visibility="visible"
                android:layout_width="87dp"
                android:layout_height="20dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/cj_pay_quick_bind_pay_brand_title"
                android:scaleType="fitCenter"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#161823"
                android:ellipsize="middle"
                android:id="@+id/cj_pay_title_view"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/cj_pay_brand_icon"
                android:layout_centerInParent="true"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/cj_pay_right_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#bf161823"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/cj_pay_h5_subtitle"
        android:paddingBottom="20dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/cj_pay_title_bar"
        android:layout_centerInParent="true"/>
</RelativeLayout>
