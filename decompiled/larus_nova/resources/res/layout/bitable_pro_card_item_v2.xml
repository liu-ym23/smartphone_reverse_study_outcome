<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
        android:orientation="vertical"
        android:id="@+id/roleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemBackgroundColor="@color/bg_body">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/roleTitleLayout"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/managers_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_AdvancedPermission_WhoCanManage"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:tint="@color/icon_n2"
                    android:layout_marginStart="7dp"
                    app:srcCompat="@drawable/ud_icon_lock_filled"/>
            </LinearLayout>
            <com.bytedance.ee.bear.bitable.pro.DefaultTagTitleView
                android:id="@+id/roleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:id="@+id/roleDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="@dimen/space_kit_font_6"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/inviteMemberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/inviteMemberIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_member_add_outlined"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:id="@+id/inviteMemberText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/Bitable_AdvancedPermission_AddMember"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/inviteMemberArrowIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/managerMemberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/managerMemberIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_group_outlined"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/managerMemberText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/Bitable_AdvancedPermission_RoleMember_Mobile"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <com.larksuite.component.universe_design.image.UDAvatarList
                android:id="@+id/memberAvatarList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ud_avatarList_maxCount="5"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/managerMemberArrowIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:gravity="center_vertical"
            android:id="@+id/template_pro_tips"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="@string/Bitable_AdvancedPermission_UseTemplateToAddMember"
            android:lineSpacingExtra="@dimen/space_kit_font_6"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
</androidx.cardview.widget.CardView>
