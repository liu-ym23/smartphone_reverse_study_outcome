<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/add_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rv_backgroundColor="@color/larus_base_2"
        app:rv_cornerRadius="?attr/larus_dp_8">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_icon_digital_avatar_plus"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/upload_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rv_cornerRadius="?attr/larus_dp_8">
        <com.larus.avatar.impl.upload.widget.RotateImageView
            android:layout_gravity="center"
            android:id="@+id/loading_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_digital_avatar_upload_loading_icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/retry_icon"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:src="@drawable/larus_digital_avatar_regenerate_icon"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/delete_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:src="@drawable/larus_digital_avatar_close_icon"
        android:layout_marginEnd="?attr/larus_dp_4"/>
</com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
