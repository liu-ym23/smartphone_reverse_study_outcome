<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/cj_pay_voucher_bubble"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_centerInParent="true">
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="@dimen/cj_pay_padding_5"
        android:src="@drawable/cj_pay_sign_voucher"
        android:scaleType="center"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:ellipsize="end"
        android:id="@+id/tv_voucher_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/iv_voucher_label_arrow"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/cj_pay_voucher_bubble_arrow"/>
</LinearLayout>
