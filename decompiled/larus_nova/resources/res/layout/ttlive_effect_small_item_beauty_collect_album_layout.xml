<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:layout_width="wrap_content"
    android:layout_height="108dp">
    <View
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="39dp"
        android:layout_marginRight="20dp"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="108dp">
        <ImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/sub_beauty_item_back"
            android:background="@drawable/ttlive_effect_sub_small_beauty_item_fold"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="27dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/sub_beauty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lines="1"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/sub_beauty_list"
        android:layout_width="wrap_content"
        android:layout_height="108dp"/>
    <View
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="39dp"
        android:layout_marginRight="20dp"/>
</LinearLayout>
