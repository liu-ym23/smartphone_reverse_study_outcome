<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/back"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ttlive_ic_pk_back"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title_center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_media_link_title_invite_anchor"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tab"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:text="@string/ttlive_media_anchor_container_anchor"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:id="@+id/set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_ic_anchor_container_set"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#80000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/set_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_setting"/>
    </LinearLayout>
</RelativeLayout>
