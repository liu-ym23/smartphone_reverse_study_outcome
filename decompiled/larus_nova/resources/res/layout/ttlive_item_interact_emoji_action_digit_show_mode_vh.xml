<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="72dp">
    <FrameLayout
        android:background="@drawable/ttlive_emoji_action_digit_show_mode_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/showModeItemContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:divider="@drawable/ttlive_divider_digit_avatar_action_item"
        android:showDividers="middle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/audioModeLayout"
            android:layout_width="50dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/audioModeIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ttlive_icon_show_mode_attlive_icon_show_mode_audio"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_digit_show_mode_action_item_text_color"
                android:gravity="center"
                android:id="@+id/audioModeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ttlive_digit_avatar_show_mode_audio"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/videoModeLayout"
            android:layout_width="50dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/videoModeIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ttlive_icon_show_mode_attlive_icon_show_mode_video"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_digit_show_mode_action_item_text_color"
                android:gravity="center"
                android:id="@+id/videoModeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ttlive_digit_avatar_show_mode_video"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/avatarModeLayout"
            android:layout_width="50dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/avatarModeIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ttlive_icon_show_mode_attlive_icon_show_mode_avatar"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_digit_show_mode_action_item_text_color"
                android:gravity="center"
                android:id="@+id/avatarModeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_digit_avatar_show_mode_avatar"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
