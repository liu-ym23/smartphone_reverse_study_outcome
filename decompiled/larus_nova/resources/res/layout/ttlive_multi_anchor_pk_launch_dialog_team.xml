<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/back"
                android:padding="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ttlive_ic_pk_back"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_std_text_black_1"
                android:layout_gravity="center"
                android:id="@+id/play_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.bytedance.android.live.revlink.impl.multianchor.ui.TeamPkMatchView
            android:id="@+id/anchor_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:minHeight="124dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start_pk"
            android:background="@drawable/ttlive_bg_anchor_link_invite_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="33dp"
            android:text="@string/ttlive_interact_start_pk_v2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
