<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cj_pay_bg_union_bind_card"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="12dp">
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true">
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@color/cj_pay_color_white"
            app:CJPayRoundCornerImageCornerRadius="12dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/iv_bank_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:CJPayRoundCornerImageCornerRadius="10dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/iv_bank_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
            app:CJPayRoundCornerImageCornerRadius="10dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/tv_bank_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_centerVertical="true"/>
    <CheckBox
        android:id="@+id/cb_card"
        android:clickable="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:button="@drawable/cj_pay_selector_checkbox_bg_trans"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:id="@+id/tv_card_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
