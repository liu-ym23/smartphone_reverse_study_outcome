<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:layout_width="294dp"
    android:layout_height="409dp"
    android:adjustViewBounds="true"
    android:minHeight="323dp">
    <RelativeLayout
        android:id="@+id/update_root"
        android:background="@drawable/update_check_white_bg"
        android:clipChildren="false"
        android:layout_width="272dp"
        android:layout_height="378dp"
        android:adjustViewBounds="true"
        android:minHeight="314dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/scroll_view_container"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="22dp"
            android:layout_marginBottom="92dp"
            android:layout_below="@+id/update_sdk_title">
            <ScrollView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/scroll_view"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/update_content_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/update_sdk_title"
            android:background="@drawable/update_check_white_bg"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <ImageView
                android:id="@+id/update_check_cancel_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/btn_appupdate_close"
                android:layout_alignParentRight="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/update_rocket_lottie"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_marginTop="-37dp"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="19sp"
                android:textColor="#222204"
                android:gravity="left"
                android:id="@+id/update_title_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="8dp"
                android:text="@string/new_app_already_downloaded"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/update_version_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/update_title_txt"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:id="@+id/button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/but_ignore"
                    android:background="@drawable/install_alpha_left_but_bg"
                    android:layout_width="1dp"
                    android:layout_height="44dp"
                    android:text="@string/install_alpha_ignore"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/but_install_now"
                    android:background="@drawable/install_alpha_right_but_bg"
                    android:layout_width="1dp"
                    android:layout_height="44dp"
                    android:text="@string/install_alpha_now"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:background="#f2f2f2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignTop="@+id/button_container"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
