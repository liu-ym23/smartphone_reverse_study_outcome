<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/scoreboard_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/team_a_container"
            android:clipChildren="false"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/match_info_container">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/team_a_icon"
                android:layout_width="24dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#faf8ea"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/team_a_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/match_info_container"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/team_a_container"
            app:layout_constraintRight_toLeftOf="@+id/team_b_container">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#faf8ea"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/team_a_score"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/score_slash"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#faf8ea"
                    android:gravity="center"
                    android:id="@+id/score_slash"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:text="@string/ttlive_live_scoreboard_slash"
                    app:layout_constraintLeft_toRightOf="@+id/team_a_score"
                    app:layout_constraintRight_toLeftOf="@+id/team_b_score"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#faf8ea"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/team_b_score"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/score_slash"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="8sp"
                android:textColor="#99faf8ea"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/match_info"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:maxLines="1"
                android:maxLength="7"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/team_b_container"
            android:clipChildren="false"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/match_info_container"
            app:layout_constraintRight_toRightOf="parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/team_b_icon"
                android:layout_width="24dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#faf8ea"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/team_b_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
