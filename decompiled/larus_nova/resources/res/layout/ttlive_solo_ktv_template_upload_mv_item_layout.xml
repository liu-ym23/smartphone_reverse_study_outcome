<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="15dp"
    android:paddingRight="2.5dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_upload_img"
        android:background="@color/ttlive_ktv_upload_img_item_default_bg"
        android:layout_width="68dp"
        android:layout_height="90dp"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_upload_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ttlive_upload_icon"
            app:layout_constraintBottom_toTopOf="@+id/tv_upload"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_upload"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_solo_ktv_upload_img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_upload_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="#33ffffff"
        android:layout_width="0.5dp"
        android:layout_height="72dp"
        android:layout_marginLeft="7.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_upload_img"
        app:layout_constraintLeft_toRightOf="@+id/fl_upload_img"
        app:layout_constraintTop_toTopOf="@+id/fl_upload_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
