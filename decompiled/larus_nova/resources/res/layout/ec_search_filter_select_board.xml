<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/BGPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/board_divider"
        android:background="@color/LinePrimary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/board_content_rv"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="414dp"/>
    <View
        android:id="@+id/board_divider_bottom"
        android:background="@color/LinePrimary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
            android:textSize="15sp"
            android:textColor="@color/TextPrimary"
            android:gravity="center"
            android:id="@+id/board_reset_btn"
            android:background="@color/BGInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="@string/search_filter_board_reset"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="7.5dp"/>
        <com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/board_ensure_btn"
            android:background="@color/Primary"
            android:clipChildren="true"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/board_ensure_btn_loading"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientTextView
                android:textSize="15sp"
                android:textColor="@color/ConstTextInverse"
                android:gravity="center"
                android:id="@+id/board_ensure_btn_text"
                android:background="@color/Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/search_filter_board_ensure_confirm"/>
        </com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView>
    </LinearLayout>
</LinearLayout>
