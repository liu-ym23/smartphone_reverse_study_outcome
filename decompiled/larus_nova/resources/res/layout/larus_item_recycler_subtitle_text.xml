<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="?attr/larus_dp_36"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_36"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_2">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/color_4079FF"
        android:layout_gravity="end|top"
        android:id="@+id/reply_simple_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="reply_simple_text"/>
    <com.larus.bmhome.view.textview.impl.CustomMarkdownTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/dot"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_12"
        android:layout_height="?attr/larus_dp_12"
        android:src="@drawable/larus_subtitle_dot_dark"/>
</FrameLayout>
