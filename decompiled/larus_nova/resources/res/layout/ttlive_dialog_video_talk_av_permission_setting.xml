<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:paddingBottom="33dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_line"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/camera"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_video_talk_camera"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/default_camera_control"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/camera">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/default_camera_control_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_video_talk_camera_control"
            android:layout_marginStart="16dp"/>
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_camera_default_control_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <Switch
                android:id="@+id/switch_camera_default_control"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:checked="true"
                android:textOn=""
                android:textOff=""
                android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
        </FrameLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/guest_link_auto_silence_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/default_camera_control">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_video_talk_guest_link_default_silence"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_guest_link_auto_silence"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
