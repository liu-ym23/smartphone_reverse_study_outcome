<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/translate_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:id="@+id/card_translate_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lark_Chat_Translation"
        app:layout_constraintBottom_toBottomOf="@+id/card_translate_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_translate_divider"/>
    <View
        android:id="@+id/card_translate_divider"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_translate_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="0dp"
        app:layout_goneMarginStart="0dp"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/translate_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/card_translate_divider"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/translate_card_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/translate_header_container"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:id="@+id/card_translate_feedback_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Lark_Chat_TranslationFeedbackRateButton"
        android:drawablePadding="4.17dp"
        android:drawableEnd="@drawable/ic_svg_pointer2"
        app:layout_constraintStart_toStartOf="@+id/translate_header_container"
        app:layout_constraintTop_toBottomOf="@+id/translate_card_content_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/card_translate_more_action"
        android:padding="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/card_translate_feedback_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="@+id/card_translate_feedback_tv"
        app:layout_goneMarginTop="24dp"
        app:srcCompat="@drawable/ud_icon_more_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/card_divider_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="card_translate_divider,card_translate_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
