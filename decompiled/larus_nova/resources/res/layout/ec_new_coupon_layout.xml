<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_new_coupon_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="6dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tv_left_wrapper"
        android:background="@drawable/ec_new_coupon_left_bg"
        android:layout_width="match_parent"
        android:layout_height="109dp"
        android:layout_toLeftOf="@+id/tv_right_layout"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/tv_right_layout"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="75dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_alignParentStart="true">
            <RelativeLayout
                android:id="@+id/ec_new_coupon_discount_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textColor="@color/ec_color_platform_label_text"
                    android:id="@+id/ec_new_coupon_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ec_new_coupon_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.bytedance.android.livesdk.livecommerce.view.ECPriceView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ec_new_coupon_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:autoResizeByMeasureWidth="true"
                    app:priceBold="true"
                    app:priceText="20"
                    app:priceTextColor="@color/ec_color_platform_label_text"
                    app:priceTextSize="30dp"
                    app:yangTextSize="18dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/ec_color_platform_label_text"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ec_new_coupon_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ec_coupon_message_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="81dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="81dp"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ec_color_60_000000"
                android:id="@+id/ec_new_coupon_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ec_color_60_000000"
                android:id="@+id/ec_new_coupon_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ec_color_60_000000"
                android:id="@+id/ec_new_coupon_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/tv_right_layout"
        android:background="@drawable/ec_new_coupon_right_bg"
        android:layout_width="116dp"
        android:layout_height="109dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <FrameLayout
            android:id="@+id/ec_coupon_btn_container"
            android:layout_width="69dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/ec_coupon_logo"
        android:background="@drawable/ec_coupon_logo_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_right_layout"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null"/>
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:id="@+id/ec_coupon_left_top_icon"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="28dp"
        android:scaleType="fitXY"
        android:layout_alignParentLeft="true"
        android:contentDescription="@null"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
