<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="156dp">
        <View
            android:id="@+id/itemImageBgView"
            android:background="@drawable/search_commodity_gs_main_img_bg_horizontal"
            android:layout_width="65dp"
            android:layout_height="65dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/itemImageView"
            android:layout_width="65dp"
            android:layout_height="65dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/itemImageBgView"
            app:layout_constraintEnd_toEndOf="@+id/itemImageBgView"
            app:layout_constraintStart_toStartOf="@+id/itemImageBgView"
            app:layout_constraintTop_toTopOf="@+id/itemImageBgView"
            app:roundBottomLeft="true"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="false"
            app:roundedCornerRadius="10dp"/>
        <View
            android:id="@+id/itemCoverView"
            android:background="@drawable/search_commodity_gs_main_image_cover_horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemImageBgView"
            app:layout_constraintEnd_toEndOf="@+id/itemImageBgView"
            app:layout_constraintStart_toStartOf="@+id/itemImageBgView"
            app:layout_constraintTop_toTopOf="@+id/itemImageBgView"/>
        <android.widget.Space
            android:id="@+id/gsWordImagePaddingView"
            android:layout_width="6dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/itemImageBgView"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/gsContentLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/gsWordImagePaddingView"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textColor="@color/search_commodity_gs_main_text_color"
                android:gravity="center"
                android:id="@+id/gsLabelView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:maxLines="1"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/search_commodity_gs_main_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/gsWordView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <android.widget.Space
                android:id="@+id/attachWordPaddingView"
                android:layout_width="0dp"
                android:layout_height="2dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textColor="@color/search_commodity_gs_attach_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/attachWordView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/gsTagIconView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="10sp"
            android:id="@+id/gsTagTextView"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
