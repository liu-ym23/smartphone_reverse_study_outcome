<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <View
        android:id="@+id/filter_view_bg"
        android:background="@drawable/filter_view_item_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/filter_right_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:id="@+id/filter_view_pre_tv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/filter_avatar_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/filter_avatar_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/filter_name_tv"
        app:layout_constraintStart_toEndOf="@+id/filter_view_pre_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:oval="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:id="@+id/filter_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/filter_view_aft_tv"
        app:layout_constraintStart_toEndOf="@+id/filter_avatar_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:id="@+id/filter_view_aft_tv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/filter_right_border"
        app:layout_constraintStart_toEndOf="@+id/filter_name_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/filter_right_border"
        android:background="@color/bg_float_overlay"
        android:layout_width="2dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/filter_view_aft_tv"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
