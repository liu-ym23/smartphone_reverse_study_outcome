<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_link_result_dialog"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_title_link_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_link_result_dialog_user_leave"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80161823"
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_link_result_dialog_feedback"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#80161823"
        android:id="@+id/tv_title_link_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_link_result"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_link_result_container"
        android:background="@drawable/ttlive_bg_link_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_link_info">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/tv_link_result_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_link_result_dialog_label_link_result"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/tv_link_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="更多"
            android:maxLines="1"
            android:drawableRight="@drawable/ttlive_ic_talk_room_setting_arrow"
            android:drawablePadding="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_link_result_label"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_link_result_container"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_link_result_label">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_fan_ticket_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_value_zero"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80161823"
                    android:gravity="center"
                    android:id="@+id/tv_fan_ticket_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_label_fan_ticket"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_add_follower_count_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_value_zero"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80161823"
                    android:gravity="center"
                    android:id="@+id/tv_follower_count_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_label_add_follower_count"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_link_duration_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_value_zero"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80161823"
                    android:gravity="center"
                    android:id="@+id/tv_link_duration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_link_result_dialog_label_link_duration"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/view_contribution_line"
            android:background="#1618231f"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_link_result_container"/>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/fl_link_contribution"
            android:layout_width="match_parent"
            android:layout_height="36.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_link_result_container">
            <TextView
                android:textSize="14sp"
                android:textColor="#80161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_result_contribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.LinkResultContributeAvatarView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/view_contribute_avatar_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_talk_room_setting_arrow"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_room_recommend"
        android:background="@drawable/ttlive_bg_link_result_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="123dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_banner_lynx_container">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/tv_room_recommend_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_link_result_dialog_label_room_recommend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:id="@+id/tv_link_change_room"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_link_result_dialog_label_change_room"
            app:layout_constraintBottom_toBottomOf="@+id/tv_room_recommend_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_room_recommend_label"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_recommend_room_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="18dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_room_recommend_label"/>
        <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.LiveAvatarCircleView
            android:id="@+id/circle_avatart_frame"
            android:padding="2dp"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:translationX="-8dp"
            android:translationY="-8dp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_recommend_room_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_recommend_room_avatar"/>
        <View
            android:id="@+id/avatar_live_tag"
            android:background="@drawable/ttlive_link_result_avatar_live_tag"
            android:layout_width="34dp"
            android:layout_height="14dp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_recommend_room_avatar"
            app:layout_constraintRight_toRightOf="@+id/iv_recommend_room_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_recommend_room_avatar"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/tv_room_recommend_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:lines="1"
            android:translationX="-2dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_go_to_link"
            app:layout_constraintStart_toEndOf="@+id/circle_avatart_frame"
            app:layout_constraintTop_toTopOf="@+id/circle_avatart_frame"/>
        <com.bytedance.android.live.liveinteract.view.MarqueeTextView
            android:textSize="10dp"
            android:textColor="#80161823"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/tv_room_recommend_tips"
            android:background="@drawable/ttlive_bg_link_result_recommend_room_tips"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:translationX="-2dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_go_to_link"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/circle_avatart_frame"
            app:layout_constraintTop_toBottomOf="@+id/tv_room_recommend_name"
            app:layout_constraintWidth_default="wrap"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/btn_go_to_link"
            android:background="@drawable/ttlive_bg_live_red_btn"
            android:layout_width="72dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_link_result_dialog_label_go_to_link"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_recommend_room_avatar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_recommend_room_avatar"/>
        <ImageView
            android:id="@+id/ic_no_recommend_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:src="@drawable/ttlive_no_recommend_room"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/has_recommend_room_group"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="tv_link_change_room, iv_recommend_room_avatar, circle_avatart_frame, avatar_live_tag, tv_room_recommend_name, tv_room_recommend_tips, btn_go_to_link"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/no_recommend_room_group"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="ic_no_recommend_room"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_link_result_container"/>
    <FrameLayout
        android:id="@+id/fl_banner_lynx_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/view_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
