<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/bg_body">
    <RelativeLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_48">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cancel"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/space_kit_len_16"
            app:srcCompat="@drawable/ud_icon_close_outlined"
            app:tint="@color/icon_n1"/>
        <TextView
            android:textSize="@dimen/space_kit_font_17"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Docs_MoreMenu_PageSettings_RemoveAuthors_Title_Mob"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/space_kit_len_16"
            android:paddingEnd="@dimen/space_kit_len_16"/>
        <TextView
            android:enabled="false"
            android:textSize="@dimen/font_size_17"
            android:textColor="@color/facade_pri_500_color_selector"
            android:gravity="center"
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/LarkCCM_Docs_MoreMenu_PageSettings_RemoveAuthors_Button_Mob"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/space_kit_len_16"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/user_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
