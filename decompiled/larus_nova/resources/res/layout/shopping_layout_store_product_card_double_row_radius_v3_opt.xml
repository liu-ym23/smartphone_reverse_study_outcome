<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.store.widget.ECRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="12dp">
    <com.bytedance.android.ui.base.widget.round.RoundRelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bg_cornerRadius_BL="0dp"
        app:bg_cornerRadius_BR="0dp"
        app:bg_cornerRadius_TL="12dp"
        app:bg_cornerRadius_TR="12dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="166dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ecommerce_slogan_product_single_bg"
                app:roundBottomLeft="false"
                app:roundBottomRight="false"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="12dp"/>
            <com.bytedance.android.shopping.store.home.view.ShopNoTouchViewpager
                android:id="@+id/shop_product_image_viewpager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include layout="@layout/shopping_layout_store_card_video"/>
            <View
                android:background="@color/shopping_std_bg_black_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
        <com.bytedance.android.ec.core.widget.RoundedLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/store_product_card_live_status"
            android:background="@color/ec_store_FFB3B3B3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            app:rounded_radius="10dp">
            <com.bytedance.android.ec.core.widget.RoundedLinearLayout
                android:gravity="center"
                android:id="@+id/store_product_card_live_status_bg"
                android:layout_width="18dp"
                android:layout_height="18dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_live_status_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:roundAsCircle="true"/>
            </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_white_1"
                android:id="@+id/store_product_card_live_status_text"
                android:paddingLeft="4dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    </com.bytedance.android.ui.base.widget.round.RoundRelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/store_product_card_info_wrapper"
        android:background="@color/shopping_std_bg_primary_white"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/store_sku_image_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>
        <com.bytedance.android.ec.store.widget.BreakWordTextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:gravity="center_vertical"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/shopping_color_B28059"
            android:ellipsize="none"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <com.bytedance.android.ec.store.view.ECTagListView
            android:id="@+id/store_product_card_recommend_info_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    layout="@layout/ec_store_product_card_info_price_v2"/>
                <com.bytedance.android.ec.store.view.ECTagListView
                    android:gravity="center_vertical"
                    android:id="@+id/store_product_card_price_bottom_tag_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp"/>
                <View
                    android:id="@+id/ec_store_product_card_divider_line"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="5dp"/>
                <com.bytedance.android.ec.store.view.ECTagListView
                    android:id="@+id/store_product_card_tag_list_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/store_product_card_add_to_cart"
                android:background="@drawable/ec_store_ic_add_to_cart_pink_new"
                android:visibility="gone"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/store_product_card_source_wrapper"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/shape_shopping_store_v2_item_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layerType="software"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_store_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginEnd="4dp"
                    app:roundAsCircle="true"
                    app:roundingBorderColor="@color/ec_shop_1F161823"
                    app:roundingBorderWidth="1dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/shopping_std_text_black_4"
                    android:ellipsize="end"
                    android:id="@+id/store_product_card_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.ec.store.widget.ECRoundedLinearLayout>
