<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_line_stub_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.77"/>
    <View
        android:id="@+id/stub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_line_stub_bottom"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_empty_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub">
        <View
            android:id="@+id/guide_content_view_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintHorizontal_weight="15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="15"/>
        <View
            android:id="@+id/guide_content_view_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="15"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintVertical_weight="15"/>
        <View
            android:id="@+id/guide_content_view_point"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_right"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_right"
            app:layout_constraintHorizontal_weight="60"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_left"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_left"
            app:layout_constraintVertical_weight="60"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_audio_invite_link_guide_effect"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_invite_link_guide_effect_animator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"
            app:placeholderImage="@color/ttlive_live_radio_interact_audience_empty_bg"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#87ffffff"
            android:gravity="center"
            android:id="@+id/ttlive_empty_position"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayoutWrapContent
            android:id="@+id/round_rect_layout_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point">
            <ImageView
                android:id="@+id/avatar"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/shader"
                android:background="@color/white"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/tick"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayoutWrapContent>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_empty_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"
            app:placeholderImage="@drawable/ttlive_ic_interact_guest_add"/>
        <com.bytedance.android.live.liveinteract.view.PositionNameTv
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/ttlive_position_name"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLength="4"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"/>
        <ImageView
            android:id="@+id/ttlive_lock"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ttlive_icon_interact_position_lock"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#87ffffff"
            android:id="@+id/ttlive_empty_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_live_radio_interact_waiting"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_point"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_linkmic_alert_stub"
        android:layout="@layout/ttlive_room_empty_stub_link_alert_view"
        android:inflatedId="@+id/ttlive_linkmic_alert_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_button_bg"
        android:background="@drawable/ttlive_bg_friend_online_guide_button_chat_room"
        android:visibility="invisible"
        android:layout_width="58dp"
        android:layout_height="16dp"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/online_text"
        android:visibility="invisible"
        android:layout_width="58dp"
        android:layout_height="16dp"
        android:layout_marginTop="56dp"
        android:text="@string/ttlive_friend_online_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/invite_text"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="16dp"
        android:layout_marginTop="56dp"
        android:text="@string/ttlive_friend_online_invite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/has_invited_text"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="16dp"
        android:layout_marginTop="56dp"
        android:text="@string/ttlive_friend_online_has_invited"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
