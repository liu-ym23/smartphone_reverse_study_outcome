<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/mini_app_action_bar_bg_light"
    android:layout_width="@dimen/dp_88"
    android:layout_height="@dimen/dp_32">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_mini_menu"
        android:layout_width="@dimen/dp_33"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_11"
        android:layout_marginEnd="4.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mini_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_mini_menu"
            android:layout_width="@dimen/dp_19"
            android:layout_height="@dimen/dp_7"
            android:src="@drawable/mini_app_icon_more_black"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/mini_divider"
        android:background="@color/mini_app_action_bar_divide_light"
        android:layout_width="0.5dp"
        android:layout_height="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_mini_close"
        app:layout_constraintStart_toEndOf="@+id/btn_mini_menu"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_mini_close"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mini_divider"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_mini_close"
            android:layout_width="@dimen/dp_13"
            android:layout_height="@dimen/dp_13"
            android:src="@drawable/mini_app_icon_close_black"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
