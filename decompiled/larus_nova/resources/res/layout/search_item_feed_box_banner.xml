<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/search_banner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/search_banner_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/search_banner_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_banner_img_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/search_banner_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/search_banner_tag_img"
                    android:layout_width="56dp"
                    android:layout_height="19dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:id="@+id/search_banner_tag_text"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/search_banner_tag_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/search_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="13sp"
                android:ellipsize="end"
                android:id="@+id/search_banner_sug_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:lines="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/search_banner_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:id="@+id/search_banner_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/search_banner_button_img"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_more_white"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
