<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/id_preview_layout"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.opengl.GLSurfaceView
            android:id="@+id/id_gl_sv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/face_bg"
        android:background="@color/byted_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_face_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
        <com.ss.android.bytedcert.view.CountDownButton
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/countdown2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:byted_progressLineWidth="10dp"
            app:byted_totalTime="5000"/>
        <com.ss.android.bytedcert.view.CircleMotionView
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/liveness_opt_circle_motion_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.ss.android.bytedcert.view.CircleInsideBgView
        android:gravity="center_horizontal"
        android:id="@+id/circle_inside_bg_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.ss.android.bytedcert.view.ClipCircleImageView
        android:id="@+id/iv_wb_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_lost_face_mask"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@mipmap/byted_face_mask"
        android:scaleType="centerInside"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/byted_white"
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/tv_tip_in_cycle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:id="@+id/id_c"
        android:background="@color/byted_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.bytedcert.view.AudioProgressTextView
            android:textSize="23sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_task_board"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="100dp"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_tip_under_cicle"
            android:visibility="gone"
            android:layout_width="200dp"
            android:layout_height="100dp"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_task_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="100dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bar_view"
        android:background="@color/byted_transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/bar"
            android:background="@color/byted_white"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/face_return_back"
                android:padding="4dp"
                android:layout_width="21dp"
                android:layout_height="29dp"
                android:layout_marginLeft="12dp"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/face_title_icon"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/face_voice_switch"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="29dp"
                android:layout_marginRight="12dp"
                android:scaleType="centerInside"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_protocol_logo"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="5dp"
            android:src="@mipmap/byted_protocol_logo1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="5dp"
            android:src="@mipmap/byted_protocol_logo2"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99161823"
            android:id="@+id/ima_protocol_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/byted_protocol_label"/>
    </LinearLayout>
    <Button
        android:id="@+id/btn_debug"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="测试"/>
    <ScrollView
        android:id="@+id/sv_debug_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:layout_marginLeft="50dp"
        android:layout_marginBottom="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="50dp">
        <TextView
            android:id="@+id/tv_debug_info"
            android:visibility="gone"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>
    </ScrollView>
</RelativeLayout>
