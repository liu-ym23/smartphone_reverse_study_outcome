<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_52">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/larus_drive_loading_progress"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        android:indeterminateDrawable="@drawable/larus_drivebiz_ic_drive_loading_more"
        style="?android:attr/progressBarStyleSmall"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/larus_drive_loading_fail"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/larus_drive_loading_fail_icon"
            android:layout_width="?attr/larus_sp_16"
            android:layout_height="?attr/larus_sp_16"
            android:src="@drawable/larus_ic_drive_load_more_retry"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_drive_loadFail_cta"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
</FrameLayout>
