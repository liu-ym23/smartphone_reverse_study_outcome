<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center_vertical"
        android:id="@+id/search_et"
        android:paddingLeft="@dimen/space_kit_len_16"
        android:paddingRight="@dimen/space_kit_len_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_40"
        android:layout_margin="@dimen/space_kit_len_16"
        android:hint="@string/Doc_Facade_Search"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionDone"
        app:ud_backgroundColor="@color/bg_float"
        app:ud_editText_clearBtnEnabled="true"
        app:ud_editText_clearIconTint="@color/icon_n3"
        app:ud_editText_iconHeight="@dimen/space_kit_len_20"
        app:ud_editText_iconWidth="@dimen/space_kit_len_20"
        app:ud_editText_leftIcon="@drawable/ud_icon_search_outlined"
        app:ud_editText_leftIconTint="@color/icon_n3"
        app:ud_radius="m"
        style="@style/SpaceEditTextStyle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/selected_users_rv"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_12"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggest_users_rv"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_state_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:layout_gravity="center"
                android:id="@+id/loading_lottie"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_anim"
                style="@style/BearLottieView"/>
        </FrameLayout>
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/empty_state"
            android:paddingTop="@dimen/space_kit_len_16"
            android:paddingBottom="@dimen/space_kit_len_16"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/SpaceEmptyStatusStyle"/>
        <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
