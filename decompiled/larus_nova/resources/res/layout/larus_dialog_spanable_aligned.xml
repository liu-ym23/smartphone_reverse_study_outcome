<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_login_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_content"
        android:background="@drawable/larus_alert_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_108"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title">
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/dialog_message"
            android:paddingBottom="?attr/larus_dp_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"/>
    </ScrollView>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_dp_13"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_individual_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_content"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_base_1"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/larus_bg_align_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_5"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_bot_profile_pic_crop_save"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@+id/bottom_individual_text"
        app:layout_goneMarginTop="?attr/larus_dp_5"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_bot_profile_pic_crop_cancel"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm"/>
    <ImageView
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_alert_bg"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/scroll_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
