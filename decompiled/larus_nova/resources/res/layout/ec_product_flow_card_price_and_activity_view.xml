<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="11sp"
        android:textColor="@color/commerce_color_FE2C55"
        android:id="@+id/prefix_text_view"
        android:background="@drawable/shopping_bg_product_feed_price_prefix_or_suffix"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lineSpacingExtra="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/product_feed_container_price"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/product_feed_container_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/prefix_text_view"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ec.core.widget.PriceView
            android:id="@+id/min_price_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:extraTextColor="@color/Primary"
            app:extraTextSize="12sp"
            app:priceBold="true"
            app:priceDecimalTextSize="22sp"
            app:priceText="8.8"
            app:priceTextColor="@color/Primary"
            app:priceTextSize="26sp"
            app:spaceSize="2dp"
            app:thinDecimal="true"
            app:yangTextSize="18sp"/>
        <com.bytedance.android.ec.core.widget.PriceView
            android:id="@+id/market_price_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginBottom="4dp"
            android:layout_toRightOf="@+id/min_price_view"
            android:layout_alignBottom="@+id/min_price_view"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/min_price_view"
            app:extraTextColor="@color/commerce_color_57161823"
            app:extraTextSize="12sp"
            app:priceText="100.1"
            app:priceTextColor="@color/commerce_color_57161823"
            app:priceTextSize="12sp"
            app:showDeleteLine="true"
            app:spaceSize="2dp"
            app:yangTextSize="12sp"/>
        <com.bytedance.android.ec.core.widget.PriceView
            android:id="@+id/pre_sale_deposit_price_view"
            android:background="@drawable/shopping_bg_product_feed_price_prefix_or_suffix"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/commerce_product_price_margin"
            android:layout_marginBottom="3dp"
            android:layout_toRightOf="@+id/min_price_view"
            android:layout_alignBottom="@+id/min_price_view"
            android:layout_marginStart="@dimen/commerce_product_price_margin"
            android:layout_toEndOf="@+id/min_price_view"
            app:prefixText="@string/shopping_product_feed_pre_sale_deposit_label"
            app:prefixTextColor="@color/commerce_color_FE2C55"
            app:prefixTextSize="13dp"
            app:priceTextColor="@color/commerce_color_FE2C55"
            app:priceTextSize="13dp"
            app:spaceSize="2dp"
            app:thinDecimal="false"
            app:yangTextSize="13dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
