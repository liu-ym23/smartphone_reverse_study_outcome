<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <com.larksuite.component.universe_design.progress.UDProgress
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/progress_percent"
        app:layout_constraintEnd_toStartOf="@+id/progress_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_percent"
        app:ud_progress_indicatorColor="@color/function_warning_350"
        app:ud_progress_indicatorCornerRadius="3dp"
        app:ud_progress_thickness="6dp"
        app:ud_progress_trackColor="@color/line_border_card"
        app:ud_progress_type="linear"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/function_warning_fill_default"
        android:gravity="center"
        android:id="@+id/progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/progress_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/line_top"
        android:background="@color/icon_n3"
        android:layout_width="1dp"
        android:layout_height="3dp"
        android:layout_marginBottom="1.5dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/progress_bar"/>
    <View
        android:id="@+id/line_bottom"
        android:background="@color/icon_n3"
        android:layout_width="1dp"
        android:layout_height="3dp"
        android:layout_marginTop="1.5dp"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_percent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/primary_content_default"
        android:id="@+id/details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
