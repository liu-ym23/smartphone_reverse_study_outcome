<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/head_view"
        android:layout_width="@dimen/ttlive_interact_pk_user_list_douyin_head_size"
        android:layout_height="@dimen/ttlive_interact_pk_user_list_douyin_head_size"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/gender_view"
        android:background="@drawable/ttlive_bg_circle_head"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="2dp"
        android:src="@drawable/ttlive_gender_male_icon"
        app:layout_constraintBottom_toBottomOf="@+id/head_view"
        app:layout_constraintRight_toRightOf="@+id/head_view"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rival_rank_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bt_invite"
        app:layout_constraintStart_toEndOf="@+id/head_view"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#404040"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="5"
                android:singleLine="true"/>
            <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tags_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_fire_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_audience"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ttlive_icon_audience"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/ttlive_douyin_pklist_audience"
                    android:id="@+id/ttlive_audience_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ttlive_location_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ttlive_icon_location"/>
                <ImageView
                    android:id="@+id/iv_fire_wave"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ttlive_ic_fire_number"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/ttlive_douyin_pklist_audience"
                    android:id="@+id/tv_fire_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="14dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/bt_invite"
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="18dp"
        android:text="@string/ttlive_live_pk_invite_btn"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/liveuikit_gray"
        android:gravity="center"
        android:id="@+id/tv_unaccept_invite"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="22dp"
        android:text="@string/ttlive_interact_pk_search_unaccept_pk"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="#e0e0e0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
