<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.vs_base.base.view.InputLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <view
            android:id="@+id/view_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            class="com.bytedance.android.livesdk.chatroom.replay.input.ReplayKeyboardShadowView"/>
        <FrameLayout
            android:id="@+id/gift_guide_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/inner_container"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/input_container"
            android:background="#ffffff"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_input_dialog_input_container_height">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:minHeight="32dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <FrameLayout
                    android:id="@+id/emoji_edit_text_container"
                    android:paddingTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.bytedance.android.live.core.widget.FitTextView
                    android:textSize="15dp"
                    android:textColor="#b0b0b0"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/edit_text_hint"
                    android:background="@null"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="6dp"/>
            </FrameLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/open_emoji_panel"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ttlive_ic_panel_input_keyboard"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/send_message"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ttlive_icon_send_untouch"/>
        </LinearLayout>
        <View
            android:background="#33161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <FrameLayout
            android:id="@+id/emoji_panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.bytedance.android.livesdk.chatroom.vs_base.base.view.InputLinearLayout>
