<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="54dp"
    android:layout_height="72dp"
    android:elevation="8dp"
    app:cardCornerRadius="2dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_bg_publish_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/black"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ttlive_bg_quick_publish_process"/>
    <com.bytedance.android.uicomponent.loading.CircularProgressView
        android:layout_gravity="center"
        android:id="@+id/ttlive_publish_share_process"
        android:layout_width="43dp"
        android:layout_height="43dp"
        app:cpv_animAutostart="true"
        app:cpv_color="#ffffff"
        app:cpv_maxProgress="1"
        app:cpv_startAngle="-90"
        app:cpv_thickness="3dp"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ttlive_publish_share_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_vs_publish_share_loading_process"/>
    <View
        android:background="@drawable/ttlive_bg_match_publish_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.cardview.widget.CardView>
