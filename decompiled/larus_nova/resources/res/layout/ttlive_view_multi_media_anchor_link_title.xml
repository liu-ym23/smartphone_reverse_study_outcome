<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/title_background"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            android:layout_alignLeft="@+id/title_content"
            android:layout_alignRight="@+id/title_content"
            android:layout_alignStart="@+id/title_content"
            android:layout_alignEnd="@+id/title_content"
            app:actualImageResource="@drawable/ttlive_bg_multi_anchor_link_title"
            app:actualImageScaleType="fitXY"
            app:placeholderImage="@drawable/ttlive_bg_multi_anchor_link_title"
            app:placeholderImageScaleType="fitXY"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/title_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="140dp"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_link_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ttlive_ic_multi_anchor_link_title_linking_hint"
                    android:scaleType="fitXY"/>
                <com.bytedance.android.livesdk.interactivity.medialink.ui.MultiPkTextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_pk_title"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="@string/ttlive_live_interact_in_progress"
                    android:layout_marginStart="2dp"/>
                <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_time"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
