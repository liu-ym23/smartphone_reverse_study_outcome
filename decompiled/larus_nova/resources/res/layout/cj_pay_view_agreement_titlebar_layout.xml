<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_52">
    <FrameLayout
        android:id="@+id/cj_pay_back_view_container"
        android:layout_width="@dimen/cj_pay_height_52"
        android:layout_height="@dimen/cj_pay_height_52"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cj_pay_middle_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_back_view"
            android:layout_width="@dimen/cj_pay_height_28"
            android:layout_height="@dimen/cj_pay_height_28"
            android:src="@drawable/cj_pay_icon_x_close"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
        android:textSize="17sp"
        android:textColor="?attr/cj_pay_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_middle_title"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/cj_pay_height_52"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cj_pay_back_view_container"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
