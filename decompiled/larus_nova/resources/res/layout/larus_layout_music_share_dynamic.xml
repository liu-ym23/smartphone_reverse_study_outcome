<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="1080px"
    android:layout_height="1980px">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover"
            android:layout_width="744px"
            android:layout_height="744px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/larus_bg_music_save_cover_default"
            app:placeholderImageScaleType="centerCrop"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_sp_20"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60px"
            app:layout_constraintStart_toStartOf="@+id/cover"
            app:layout_constraintTop_toBottomOf="@+id/cover"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/static_white_transparent_3"
            android:id="@+id/subtitle"
            android:layout_width="744px"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="?attr/larus_sp_18"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/lyrics"
            android:layout_width="744px"
            android:layout_height="wrap_content"
            android:layout_marginTop="60px"
            android:layout_marginBottom="39px"
            android:minHeight="162px"
            android:maxLines="3"
            app:layout_constraintEnd_toEndOf="@+id/cover"
            app:layout_constraintStart_toStartOf="@+id/subtitle"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
