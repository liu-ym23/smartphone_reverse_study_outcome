<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_window_author_info_card"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ec_window_info_live_click_area"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="4dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="right"
            android:id="@+id/ec_window_live_volume_icon"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="4dp"
            android:alpha="0.8"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ec_window_enter_live_room_hint"
            android:background="@drawable/ec_window_live_hint_bg"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="14dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ec_window_enter_live_room_hint_live_status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.8"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#bfffffff"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:text="@string/ec_window_live_click_hint"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ec_window_info_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/ec_shop_info_area_click_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="8dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wc_window_info_right_area"
                android:paddingRight="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:translationZ="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_shop_user_wrapper"
                app:layout_constraintLeft_toRightOf="@+id/iv_shop_user_wrapper"
                app:layout_constraintRight_toLeftOf="@+id/ec_shop_info_area_follow"
                app:layout_constraintTop_toTopOf="@+id/iv_shop_user_wrapper">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_shop_name"
                    android:tag="anchor_window_header_info_area_name"
                    android:focusable="true"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:translationZ="20dp"
                    app:layout_constraintHeight_default="spread"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/tv_shop_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/tv_name_right"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="spread_inside"/>
                    <TextView
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/commerce_color_FFFFFF"
                        android:id="@+id/tv_name_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_shop_name"
                        app:layout_constraintRight_toLeftOf="@+id/ec_window_good_talent_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="spread_inside"/>
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/ec_window_good_talent_icon"
                        android:visibility="gone"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="1dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintLeft_toRightOf="@+id/tv_name_right"
                        app:layout_constraintRight_toLeftOf="@+id/view_enter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="spread_inside"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/view_enter"
                        android:background="@drawable/ec_store_ic_round_right_arrow_white"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintLeft_toRightOf="@+id/ec_window_good_talent_icon"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="spread_inside"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ec_window_author_self_intro"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_shop_name"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ec_shop_reputation_recommend_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ec_window_author_self_intro">
                    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                        android:id="@+id/ec_window_great_talent_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        app:layoutMode="width_self_adjust"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/shopping_color_BFFFFFFF"
                        android:id="@+id/window_fans_info"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ec_window_layout_header_reputation_second"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ec_shop_reputation_recommend_container"
                    app:layout_goneMarginTop="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:gravity="center"
                android:id="@+id/ec_shop_info_area_follow"
                android:tag="anchor_window_header_info_area_follow"
                android:clipChildren="false"
                android:layout_width="68dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_shop_user_wrapper"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_shop_user_wrapper">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ec_shop_info_area_follow_action"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/ec_shop_info_area_follow_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_follow_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="2dp"
                            android:src="@drawable/ec_shop_follow_white"
                            android:layout_marginEnd="2dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_follow_text"
                            android:paddingTop="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <FrameLayout
                        android:gravity="center"
                        android:id="@+id/ec_shop_info_area_fans_group"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_fans_group_icon"
                            android:layout_width="26dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ec_store_info_join_fans_group_image"/>
                        <TextView
                            android:textSize="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/shopping_std_text_white_1"
                            android:layout_gravity="center"
                            android:id="@+id/ec_shop_info_area_fans_group_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/ec_shop_info_area_follow_bubble"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginBottom="-3dp"
                android:layout_marginEnd="1dp"
                android:translationZ="3dp"
                app:layoutMode="width_self_adjust"
                app:layout_constraintBottom_toTopOf="@+id/ec_shop_info_area_follow"
                app:layout_constraintRight_toRightOf="@+id/ec_shop_info_area_follow"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/iv_shop_user_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.android.ec.window.base.view.ECWindowLiveCircleView
                    android:id="@+id/ec_window_head_live_circle_big"
                    android:padding="3dp"
                    android:visibility="gone"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:live_strokeWidth="1.5dp"/>
                <com.bytedance.android.ec.core.widget.RoundedFrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rounded_radius="32dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/iv_shop_user"
                        android:tag="anchor_window_header_info_area_avatar"
                        android:padding="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:roundAsCircle="true"
                        app:roundedCornerRadius="32dp"
                        app:viewAspectRatio="1"/>
                </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ec_window_head_live_diagram"
                    android:background="@drawable/ec_window_ic_live_status"
                    android:visibility="gone"
                    android:layout_width="38dp"
                    android:layout_height="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ec_window_header_reputation_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ec_shop_info_area_follow"
                app:layout_constraintTop_toBottomOf="@+id/iv_shop_user_wrapper"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</LinearLayout>
