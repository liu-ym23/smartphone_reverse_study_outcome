<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_bar_container"
        android:background="@drawable/ttlive_bg_text_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp">
        <ImageView
            android:id="@+id/iv_search_bar_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/ttlive_search_icon"
            android:alpha="0.45"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#57161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_live_invite_panel_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_search_bar_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_banner_lynx_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/apply_mode_tips_layout"
                android:background="#0d161823"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ttlive_icon_interactive_apply_mode_tips"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80000000"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_apply_mode_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="@string/ttlive_interactive_apply_auto_permit_mode_tips"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/apply_mode_tips_no_need_apply_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80000000"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="@string/ttlive_interactive_apply_auto_permit_mode_tips_v2"
                    android:layout_marginStart="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/ttlive_white"
                    android:gravity="center"
                    android:id="@+id/btn_open_apply_mode_tips_ensure"
                    android:background="@drawable/ttlive_friend_invite_enable"
                    android:layout_width="68dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="10dp"
                    android:text="@string/ttlive_live_open"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/btn_close_apply_mode_tips_cancel"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/btn_close_apply_mode_tips_cancel"
                    android:padding="3dp"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ttlive_ic_interact_window_close"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/ttlive_std_line_black_3"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/paid_link_guide_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_paid_link_guide_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/paid_link_guide_btn_open"
                    android:background="@drawable/ttlive_bg_paid_link_guide_open_btn"
                    android:layout_width="64dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="44dp"
                    android:text="@string/ttlive_paid_link_guide_open"
                    android:layout_marginEnd="44dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/paid_link_guide_btn_close"
                    android:background="@drawable/ttlive_ic_paid_link_guide_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.bytedance.android.live.liveinteract.linkpanel.list.BaseRefreshLayout
                android:id="@+id/userlist_swipe_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp">
                    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                        android:layout_gravity="center"
                        android:id="@+id/userlist_refresh_progress"
                        android:visibility="visible"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                </FrameLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rlv"
                    android:background="@color/ttlive_core_hs_w1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.android.live.liveinteract.linkpanel.list.BaseRefreshLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="84dp"
                android:src="@drawable/ttlive_bg_live_loading_error"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_user_rank_no_network_below_tip"/>
            <TextView
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/refresh"
                android:background="@drawable/ttlive_bg_interact_text"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_network_refresh"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_iv"
                android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"/>
            <com.bytedance.android.live.liveinteract.common.ui.OnlineFriendsCircleContainer
                android:layout_gravity="center"
                android:id="@+id/friends_avatars"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="108dp"/>
            <TextView
                android:textSize="12dp"
                android:layout_gravity="center"
                android:id="@+id/invite_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_interact_invite_friends_unlive_hint"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/invite_tv"
                android:paddingLeft="12dp"
                android:paddingTop="9dp"
                android:paddingRight="12dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/ttlive_interact_video_talk_apply_empty"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
