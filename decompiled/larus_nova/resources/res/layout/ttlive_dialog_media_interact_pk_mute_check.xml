<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_white_round_top_corner_rect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_media_interact_link_mute_confirm_dialog_top_tip"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <ImageView
        android:id="@+id/ttlive_close_icon"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ttlive_pk_end_dialog_close"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:layout_marginBottom="23dp"
        android:layout_below="@+id/tv_title">
        <Button
            android:textColor="@color/ttlive_pk_cancel_dialog_button"
            android:id="@+id/ttlive_cancel"
            android:background="@drawable/ttlive_bg_media_pk_end"
            android:layout_width="164dp"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:text="@string/ttlive_new_pk_cancel_dialog_cancel"
            android:layout_weight="1"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/ttlive_end"
            android:background="@drawable/ttlive_bg_media_pk_cancel"
            android:layout_width="164dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_label_close"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rb_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:layout_below="@+id/linearLayout"
        android:layout_centerHorizontal="true">
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/ttlive_uncheck_radio_button"
            android:textColor="#161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/rb"
            android:background="@drawable/ttlive_ic_pk_raido"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#161823"
            android:id="@+id/tv_rb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_media_interact_link_mute_confirm_dialog_bottom_tip"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>
