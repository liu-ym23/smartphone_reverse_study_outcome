<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_expired_fold_hint"
    android:background="@drawable/bg_expired_fold_hint"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_16"
    android:layout_marginBottom="@dimen/dp_8">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_expired_fold_hint_close"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:tint="@color/text_caption"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_expired_fold_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_expired_fold_title"
        app:srcCompat="@drawable/ud_icon_close_outlined"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:id="@+id/tv_expired_fold_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_8"
        android:text="@string/Lark_IM_FilterClutter_Onboard_Title"
        app:layout_constraintEnd_toStartOf="@+id/img_expired_fold_hint_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/tv_expired_fold_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginRight="@dimen/dp_8"
        app:layout_constraintEnd_toStartOf="@+id/img_expired_fold_hint_close"
        app:layout_constraintStart_toStartOf="@+id/tv_expired_fold_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_expired_fold_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/primary_content_default"
        android:id="@+id/tv_expired_fold_click_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_2"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/Lark_IM_FilterClutter_Onboard_Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_expired_fold_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_expired_fold_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
