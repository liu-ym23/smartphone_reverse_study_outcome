<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_card_root_view"
    android:background="@drawable/shopping_match_purchase_activity_item"
    android:layout_width="106dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:id="@+id/product_card_picture_container"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rounded_radius="4dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/product_card_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/product_card_picture_tip"
            android:background="@color/const_tSecondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp">
            <TextView
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/product_card_picture_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/font_size_28"/>
        </FrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
    <com.bytedance.android.shopping.anchorv3.matchpurchase.view.ExtendedHotAreaCheckBox
        android:id="@+id/cb_product_card"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/TextReverse"
        android:ellipsize="end"
        android:id="@+id/tv_product_card_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/product_card_picture_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/product_card_picture_container"
        app:layout_constraintRight_toRightOf="@+id/product_card_picture_container"
        app:layout_constraintStart_toStartOf="@+id/product_card_picture_container"
        app:layout_constraintTop_toBottomOf="@+id/product_card_picture_container"
        style="@style/font_size_26"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_price_and_count_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_product_card_title"
        app:layout_constraintLeft_toLeftOf="@+id/tv_product_card_title"
        app:layout_constraintRight_toRightOf="@+id/tv_product_card_title"
        app:layout_constraintStart_toStartOf="@+id/tv_product_card_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_card_title">
        <com.bytedance.android.ec.core.widget.price.PriceView
            android:textSize="11sp"
            android:textColor="@color/shopping_std_brand"
            android:id="@+id/pv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:pv_autoResize="true"
            app:pv_prefixMarginRight="2dp"
            app:pv_prefixTextSizeRatio="0.588"
            app:pv_priceBold="false"
            app:pv_priceDecimalTextSizeRatio="1"
            app:pv_priceTextColor="@color/commerce_color_80161823"
            app:pv_suffixTextSizeRatio="1"
            app:pv_yuanSymbolMarginRight="1dp"
            app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/shopping_std_text_black_3"
            android:id="@+id/tv_selected_product_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/font_size_22"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_product_card_spec_info"
        android:background="@drawable/shopping_match_purchase_sku_spec_bg"
        android:padding="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/product_card_picture_container"
        app:layout_constraintLeft_toLeftOf="@+id/product_card_picture_container"
        app:layout_constraintRight_toRightOf="@+id/product_card_picture_container"
        app:layout_constraintStart_toStartOf="@+id/product_card_picture_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_price_and_count_container">
        <TextView
            android:textColor="@color/commerce_color_BF161823"
            android:id="@+id/tv_product_card_selected_spec_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_match_purchase_product_card_default_spec"
            android:alpha="0.75"
            style="@style/font_size_26"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_product_card_select_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shopping_match_purchase_selected_icon"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
