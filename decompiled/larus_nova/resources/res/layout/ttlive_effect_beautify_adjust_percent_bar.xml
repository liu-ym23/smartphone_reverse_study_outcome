<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:id="@+id/beautify_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/minus_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <ImageView
        android:id="@+id/minus_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ttlive_effect_ic_beautify_adjust_bar_minus"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/beautify_seek_bar"
        app:layout_constraintStart_toEndOf="@+id/beautify_title"/>
    <com.bytedance.android.live.effect.base.AdjustPercentBar
        android:id="@+id/beautify_seek_bar"
        android:background="#0000"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:maxHeight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/plus_icon"
        app:layout_constraintStart_toEndOf="@+id/minus_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="10dp"
        app:ttlive_effect_bar_padding="14dp"
        app:ttlive_effect_textColor="#ffffff"
        app:ttlive_effect_textSize="14dp"/>
    <ImageView
        android:id="@+id/plus_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ttlive_effect_ic_beautify_adjust_bar_plus"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/beautify_seek_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
