<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_live_tag_and_from_douyin"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:layout_marginBottom="8dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_whole_img"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="3dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/live_status_layout_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_status_layout"
        app:layout_constraintEnd_toEndOf="@+id/live_status_layout"
        app:layout_constraintStart_toStartOf="@+id/live_status_layout"
        app:layout_constraintTop_toTopOf="@+id/live_status_layout"
        app:roundedCornerRadius="3dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_status_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:paddingStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_label"
        app:layout_constraintTop_toTopOf="@+id/live_label">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_live_status"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_live_icon"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:lineSpacingExtra="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
