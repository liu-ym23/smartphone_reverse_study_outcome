<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compose_container"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.interactivity.comment.newinput.view.AudioComposePageViewPager
        android:id="@+id/audio_pager"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0.5dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginBottom="24dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/audio_indicator"
            android:layout_width="wrap_content"
            android:layout_height="35dp">
            <TextView
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/btn_audio"
                android:paddingRight="10dp"
                android:layout_width="@dimen/ttlive_audio_indicator_button_width"
                android:layout_height="match_parent"
                android:text="@string/ttlive_compose_indicator_audio"
                android:paddingStart="10dp"/>
            <TextView
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/btn_asr"
                android:paddingRight="10dp"
                android:layout_width="@dimen/ttlive_audio_indicator_button_width"
                android:layout_height="match_parent"
                android:text="@string/ttlive_compose_indicator_asr"
                android:paddingStart="10dp"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
            android:layout_gravity="center_horizontal"
            android:background="@color/black"
            android:layout_width="16dp"
            android:layout_height="3dp"
            app:ttlive_allRadius="8dp"/>
    </LinearLayout>
</FrameLayout>
