<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="42dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="192dp"
        android:layout_height="128dp"
        android:src="@drawable/ec_commerce_ic_network_error_placeholder"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_tip_api_error"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_color_99161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/shopping_tip_api_retry"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:gravity="center"
        android:id="@+id/ec_same_api_refresh_btn"
        android:background="@drawable/ec_commerce_bg_same_refresh_btn"
        android:layout_width="231dp"
        android:layout_height="44dp"
        android:layout_marginTop="42dp"
        android:text="@string/shopping_tip_api_refresh"/>
</LinearLayout>
