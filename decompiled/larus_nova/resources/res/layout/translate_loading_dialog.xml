<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#591f2329"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/translateStopView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="25dp"
        app:srcCompat="@drawable/ud_icon_close_outlined"
        app:tint="@color/translate_close_tint_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/translateLoadingIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/common_scanning"/>
</RelativeLayout>
