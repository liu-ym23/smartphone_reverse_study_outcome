<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/lkui_N1000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.SwipeControlViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/lkui_N00"
            android:gravity="center"
            android:layout_gravity="bottom|left"
            android:id="@+id/doc_tv_index"
            android:background="@drawable/doc_download_icon_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="15dp"
            android:minWidth="45dp"
            android:minHeight="28dp"/>
        <LinearLayout
            android:layout_gravity="end|bottom"
            android:orientation="horizontal"
            android:id="@+id/menu_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:layout_marginEnd="15dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/follow_mark"
                android:background="@drawable/doc_comment_bg_sel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    app:srcCompat="@drawable/ud_icon_pen_outlined"
                    app:tint="@color/white"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/lkui_N00"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minHeight="28dp"
                    android:text="@string/LarkCCM_VM_ShareAnnotation_Button"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/doc_iv_edit"
                android:background="@drawable/doc_comment_bg_sel"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/ud_icon_edit_outlined"
                app:tint="@color/white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/area_mark"
                android:background="@drawable/doc_comment_bg_sel"
                android:padding="5dp"
                android:visibility="visible"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitXY"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/ud_icon_box_comment_outlined"
                app:tint="@color/white"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/lkui_N00"
                android:gravity="center_vertical"
                android:id="@+id/doc_tv_comment"
                android:background="@drawable/doc_comment_bg_sel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:drawablePadding="7dp"
                android:drawableStart="@drawable/doc_comment_icon_sel"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="20dp"/>
            <ImageView
                android:id="@+id/doc_iv_delete"
                android:background="@drawable/doc_download_icon_bg"
                android:padding="@dimen/space_kit_len_6"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ud_icon_delete_trash_outlined"
                android:scaleType="centerInside"
                android:layout_marginStart="20dp"/>
            <ImageView
                android:id="@+id/doc_iv_download"
                android:background="@drawable/doc_comment_bg_sel"
                android:padding="7dp"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/doc_comment_download_sel"
                android:scaleType="fitXY"
                android:layout_marginStart="20dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/doc_iv_more"
                android:background="@drawable/doc_comment_bg_sel"
                android:padding="7dp"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitXY"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/ud_icon_more_outlined"
                app:tint="@color/white"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
