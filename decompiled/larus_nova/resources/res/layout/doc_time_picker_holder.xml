<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@drawable/docs_bg_top_round_conner_color_bg_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/count_down_time_view_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/countdown_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            layout="@layout/doc_layout_dialog_header"/>
        <View
            android:id="@+id/countdown_divider"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toBottomOf="@+id/countdown_header"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/countdown_wheel_view_container"
                android:background="@drawable/docs_bg_round_conner_color_bg_float"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/countdown_hour_wheel_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:wheelView_cyclic="false"
                    app:wheelView_dividerColor="@color/line_border_card"
                    app:wheelView_textSizeCenter="17dp"/>
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/countdown_minutes_wheel_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:wheelView_cyclic="false"
                    app:wheelView_dividerColor="@color/line_border_card"
                    app:wheelView_textSizeCenter="17dp"/>
            </LinearLayout>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="16dp"
                android:textColor="@color/function_danger_500"
                android:gravity="center"
                android:id="@+id/time_picket_delete"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/LarkCCM_Docs_MeetingAgenda_DeleteTime_Button"
                app:ud_backgroundColor="@color/ud_button_white_grey_bg"
                app:ud_radiusBottomLeft="10dp"
                app:ud_radiusBottomRight="10dp"
                app:ud_radiusTopLeft="10dp"
                app:ud_radiusTopRight="10dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
