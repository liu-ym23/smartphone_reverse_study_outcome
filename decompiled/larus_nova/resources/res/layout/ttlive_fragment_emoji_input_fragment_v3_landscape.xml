<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.common.keyboard.MeasureLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ttlive_input_shadow_view"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.interactivity.comment.newinput.framework.InputPanelSectionContainer
            android:id="@+id/input_panel_quick_comment_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.bytedance.android.livesdk.interactivity.comment.newinput.framework.InputPanelSectionContainer
                android:id="@+id/input_panel_content_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="56dp"
                android:layout_weight="1"
                android:layout_marginStart="56dp"/>
            <com.bytedance.android.livesdk.interactivity.comment.newinput.framework.InputPanelSectionContainer
                android:id="@+id/input_panel_control_view_landscape"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="56dp"/>
        </LinearLayout>
        <FrameLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.interactivity.comment.newinput.framework.InputPanelSectionContainer
                android:id="@+id/input_panel_bottom_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"/>
        </FrameLayout>
    </LinearLayout>
</com.bytedance.android.live.common.keyboard.MeasureLinearLayout>
