<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dora_device_disconnect_connect_container"
        android:background="@drawable/larus_item_dora_connect_status"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_36"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/loading_spinner"
            android:background="@drawable/larus_connect_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_17"
            android:layout_height="?attr/larus_dp_17"
            android:layout_marginEnd="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/dora_device_disconnect_connect_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_device_disconnected_btn_retry_cn"
            android:maxLines="1"/>
    </LinearLayout>
</FrameLayout>
