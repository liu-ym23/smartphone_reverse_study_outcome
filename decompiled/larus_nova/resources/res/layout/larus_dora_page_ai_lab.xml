<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:id="@+id/dora_voice_wake_group_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_ai_voice_wake_setting_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_voice_wake_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_voice_wake_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_ai_voice_wake_switch_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dora_keyword_doubao_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_24"
                    android:text="@string/larus_dora_ailab_keyword_doubao_tips_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dora_keyword_doubao_settings_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextSelector
                        android:id="@+id/dora_keyword_doubao"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_ailab_keyword_doubao_cn"/>
                    <com.larus.bmhome.view.item.ItemTextSelector
                        android:id="@+id/dora_keyword_doubao_doubao"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_ailab_keyword_doubao_doubao_cn"/>
                    <com.larus.bmhome.view.item.ItemTextSelector
                        android:id="@+id/dora_keyword_natural_wakeup"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_ailab_keyword_natural_wakeup_cn"/>
                </com.larus.bmhome.view.item.ItemGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dora_keyword_doubao_footer"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_newwakeup_subtitle_cn"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_voice_wake_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_ai_voice_wake_sub_tips_v2_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_config_auto_stop_time_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_voice_wake_tips"
                app:layout_goneMarginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_config_auto_stop_time"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_auto_stop_time_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/multi_user_mode_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/multi_user_mode_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_multi_user_mode_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/multi_user_mode_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:text="@string/larus_dora_multi_user_mode_tips_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_precapture_upload_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_precapture_upload"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_quick_chat_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_precapture_upload_group_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_g_quick_chat_detail_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_conv_sound_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_conv_start_end_sound_toggle"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_conversation_start_and_end_sound_cn"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_conv_visual_intent_toggle"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_conversation_visual_intent_sound_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_conv_visual_intent_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_28"
                android:text="@string/larus_dora_conversation_visual_intent_sound_desc_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
