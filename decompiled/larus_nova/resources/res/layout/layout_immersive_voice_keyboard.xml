<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_reply"
        android:background="@color/bg_body_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_replay_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:radius="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_close_reply"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="4dp"
                app:srcCompat="@drawable/reply_close"/>
            <View
                android:id="@+id/divider_vertical"
                android:background="@color/line_border_card"
                android:layout_width="1dp"
                android:layout_height="16dp"/>
            <com.larksuite.framework.ui.ViewTransitionContainer
                android:id="@+id/tv_root_msg_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.ss.android.lark.widget.EllipsizedEmojiconTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:textColorHint="@color/text_placeholder"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_root_msg"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:maxLines="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"/>
            </com.larksuite.framework.ui.ViewTransitionContainer>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:background="@color/bg_body_overlay"
        android:padding="@dimen/dp_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginBottom="@dimen/dp_4">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/switch_im_keyboard"
            android:background="@drawable/kb_input_round_bg"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ud_icon_menu_display_outlined"
            app:tint="@color/icon_n2"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="16sp"
            android:textColor="@color/ud_N900"
            android:gravity="center"
            android:id="@+id/entrance_audio_record"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="@string/Lark_IM_AudioMsg_HoldToRecord_Button"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:ud_backgroundColor="@color/bg_body"
            app:ud_radius="l"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
