<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shopping_bg_inflow_feed_coupon_small"
    android:layout_width="142dp"
    android:layout_height="62dp">
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_color_FE2C55"
        android:id="@+id/tv_coupon_type"
        android:background="@drawable/shopping_bg_feed_coupon_type"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_FE2C55"
        android:id="@+id/tv_coupon_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/shopping_color_FE2C55"
        android:id="@+id/tv_coupon_label_yuan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/shopping_currency_yuan"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_num"
        app:layout_constraintLeft_toRightOf="@+id/tv_coupon_num"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/shopping_color_FE2C55"
        android:id="@+id/tv_coupon_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/shopping_color_FE2C55"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_apply"
            android:background="@drawable/shopping_border_inflow_feed_coupon_button"
            android:layout_width="52dp"
            android:layout_height="24dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
