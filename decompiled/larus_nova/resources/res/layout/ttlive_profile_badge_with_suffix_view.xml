<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="4dp">
    <View
        android:id="@+id/badge_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/badge_icon"
        app:layout_constraintLeft_toLeftOf="@+id/badge_icon"
        app:layout_constraintRight_toRightOf="@+id/badge_suffix"
        app:layout_constraintTop_toTopOf="@+id/badge_icon"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/badge_suffix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/badge_icon"
        app:layout_constraintLeft_toRightOf="@+id/badge_icon"
        app:layout_constraintTop_toTopOf="@+id/badge_icon"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/badge_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
