<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/saas_coupon_dialog_v2_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bg_color="@color/white"
    app:bg_cornerRadius_TL="20dp"
    app:bg_cornerRadius_TR="20dp"
    app:rv_needClip="true">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/saas_coupon_dialog_v2_bg"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/saas_coupon_dialog_v2_close_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/saas_coupon_dialog_v2_close_icon"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/ec_color_black"
        android:id="@+id/saas_coupon_dialog_v2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/saas_coupon_dialog_v2_coupon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/saas_coupon_dialog_v2_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/saas_coupon_dialog_v2_coupon_left"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.ec.core.widget.price.PriceView
                        android:textSize="26dp"
                        android:textStyle="bold"
                        android:textColor="@color/saas_coupon_dialog_v2_color"
                        android:id="@+id/saas_coupon_dialog_v2_coupon_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        app:pv_hideYuanSymbol="true"/>
                    <TextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="@color/saas_coupon_dialog_v2_color"
                        android:id="@+id/saas_coupon_dialog_v2_coupon_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/saas_coupon_dialog_v2_color"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/saas_coupon_dialog_v2_price_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/saas_coupon_dialog_v2_coupon_right"
                android:scaleType="fitXY"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/saas_coupon_dialog_v2_text_color_161823"
                android:id="@+id/saas_coupon_dialog_v2_coupon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/saas_coupon_dialog_v2_text_color_8A8B91"
                android:id="@+id/saas_coupon_dialog_v2_coupon_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saas_coupon_dialog_v2_coupon_name"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/saas_coupon_dialog_v2_text_color_8A8B91"
                android:id="@+id/saas_coupon_dialog_v2_coupon_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saas_coupon_dialog_v2_coupon_time"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/saas_coupon_dialog_v2_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:bg_color="@color/saas_coupon_dialog_v2_color"
        app:bg_cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@+id/saas_coupon_dialog_v2_coupon">
        <ImageView
            android:id="@+id/saas_coupon_dialog_v2_douyin_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/saas_coupon_dialog_v2_douyin_icon"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/saas_coupon_dialog_v2_button_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
    </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/saas_coupon_dialog_v2_button"/>
</com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
