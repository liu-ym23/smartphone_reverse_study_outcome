<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_sms_code_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:id="@+id/cj_pay_sms_code_sent_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:text="@string/cj_pay_sms_code_sent_tip"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:ellipsize="end"
        android:id="@+id/cj_pay_sms_code_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/cj_pay_verification_code_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_14_with_half"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16_with_half"
        android:layout_below="@+id/cj_pay_sms_code_sent_tip"
        android:layout_centerHorizontal="true">
        <com.android.ttcjpaysdk.base.ui.component.input.CJSmsCodeInputView
            android:id="@+id/cj_pay_new_verification_code_edit_view"
            android:visibility="gone"
            app:CJSmsInputHideKeyboardWhenInputComplete="false"
            style="@style/CJ_Pay_New_Verification_Code_Style_Opt"/>
    </FrameLayout>
    <include
        android:id="@+id/cj_pay_agreement_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        layout="@layout/cj_pay_view_agreement_container"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_blue_04498D"
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_acquire_sms_code"
        android:paddingTop="@dimen/cj_pay_padding_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cj_pay_reacquire_sms_code_enable_tip"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/cj_pay_sms_code_loading"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/cj_pay_padding_22"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
        android:indeterminateDuration="500"
        android:indeterminateBehavior="repeat"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        android:layout_centerHorizontal="true"/>
    <include layout="@layout/cj_pay_view_custom_keyboard_layout"/>
</RelativeLayout>
