<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/custom_repeat_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <TextView
        android:id="@+id/tv_repeat_rule"
        android:layout_below="@+id/custom_repeat_title_bar"
        style="@style/CustomRepeatItemTitleText"/>
    <View
        android:id="@+id/title_divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/tv_repeat_rule"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/custom_wheel_container"
        android:background="@color/bg_body"
        android:paddingTop="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_divider">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_66"
            android:text="@string/Calendar_RRule_Every"/>
        <com.ss.android.lark.custom.repeat.widget.wheelview.WheelView
            android:id="@+id/custom_wheel_repeat_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.ss.android.lark.custom.repeat.widget.wheelview.WheelView
            android:id="@+id/custom_wheel_repeat_frequency_unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"/>
    </LinearLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/custom_wheel_container"/>
    <View
        android:id="@+id/bottom_container_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@+id/custom_repeat_bottom_container"/>
    <com.ss.android.lark.custom.repeat.widget.bottom.container.CustomRepeatBottomContainer
        android:id="@+id/custom_repeat_bottom_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <GridView
            android:id="@+id/custom_repeat_weekly"
            android:background="@color/line_border_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_225"
            android:horizontalSpacing="@dimen/dp_1"
            android:verticalSpacing="@dimen/dp_1"
            android:numColumns="3"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/monthly_tab_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <GridView
                    android:id="@+id/custom_repeat_monthly"
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_250"
                    android:horizontalSpacing="@dimen/dp_1"
                    android:verticalSpacing="@dimen/dp_1"
                    android:numColumns="7"/>
                <com.ss.android.lark.custom.repeat.widget.childview.ControlChildViewClickableLayout
                    android:id="@+id/choose_repeat_weeks_container"
                    android:background="@color/bg_body"
                    android:paddingTop="@dimen/dp_15"
                    android:paddingBottom="@dimen/dp_15"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.ss.android.lark.custom.repeat.widget.wheelview.WheelView
                        android:id="@+id/wheel_repeat_week_no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.ss.android.lark.custom.repeat.widget.wheelview.WheelView
                        android:id="@+id/wheel_repeat_weeks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </com.ss.android.lark.custom.repeat.widget.childview.ControlChildViewClickableLayout>
            </FrameLayout>
            <View
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"/>
            <LinearLayout
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:divider="@drawable/custom_repeat_divider_vertical"
                android:showDividers="middle">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/primary_fill_default"
                    android:gravity="center"
                    android:id="@+id/switch_date"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/Calendar_Common_Ondate"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/switch_week"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:text="@string/Calendar_RRule_WeeklyMobile"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.ss.android.lark.custom.repeat.widget.bottom.container.CustomRepeatBottomContainer>
</RelativeLayout>
