<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="70dp"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/deep_feed_ai_header_rec"
        android:layout_width="16dp"
        android:layout_height="13dp"
        android:src="@drawable/shopping_bg_deep_feed_ai"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/deep_feed_ai_item_header_text"
        android:layout_width="27dp"
        android:layout_height="13dp"
        android:src="@drawable/shopping_deep_feed_ai_recommend_icon"
        app:layout_constraintBottom_toBottomOf="@+id/deep_feed_ai_header_rec"
        app:layout_constraintStart_toEndOf="@+id/deep_feed_ai_header_rec"
        app:layout_constraintTop_toTopOf="@+id/deep_feed_ai_header_rec"/>
</androidx.constraintlayout.widget.ConstraintLayout>
