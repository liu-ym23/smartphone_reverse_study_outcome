<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_page_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/ttlive_bg_guest_link_main_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/player_container"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="98dp">
            <ViewStub
                android:id="@+id/live_player_view_container"
                android:layout="@layout/ttlive_guest_link_player_vew"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/live_surface_view_container"
                android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.bytedance.android.live.ui.ClipImageView
            android:id="@+id/main_page_bg"
            android:background="@drawable/ttlive_bg_guest_link_main_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_page"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/fl_top_container"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_back_press_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_ic_guest_link_back_press_arrow"
                    app:failureImage="@drawable/ttlive_ic_guest_link_back_press_arrow"
                    app:placeholderImage="@drawable/ttlive_ic_guest_link_back_press_arrow"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_guest_link_title_for_audience"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/button_help"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ttlive_ic_guest_link_help"
                    app:failureImage="@drawable/ttlive_ic_guest_link_help"
                    app:placeholderImage="@drawable/ttlive_ic_guest_link_help"/>
                <LinearLayout
                    android:gravity="end"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ttlive_white_60"
                        android:gravity="center_vertical"
                        android:id="@+id/button_report"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_guest_link_report"/>
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/button_divider"
                        android:background="#57ffffff"
                        android:visibility="gone"
                        android:layout_width="2dp"
                        android:layout_height="9dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/button_suspend"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ttlive_white_60"
                        android:gravity="center_vertical"
                        android:id="@+id/button_suspend"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_guest_link_suspend"/>
                </LinearLayout>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/button_finish_channel"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ttlive_ic_guest_link_finish_channel"
                    app:failureImage="@drawable/ttlive_ic_guest_link_finish_channel"
                    app:placeholderImage="@drawable/ttlive_ic_guest_link_finish_channel"/>
            </FrameLayout>
            <View
                android:id="@+id/view_divider"
                android:background="@color/ttlive_white_05"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_top_container"/>
            <FrameLayout
                android:id="@+id/fl_channel_info_container"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_divider">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/ll_audience_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_audience_1"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="2dp"
                        app:failureImage="@drawable/ttlive_guest_link_default_head"
                        app:placeholderImage="@drawable/ttlive_guest_link_default_head"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_audience_2"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="2dp"
                        app:failureImage="@drawable/ttlive_guest_link_default_head"
                        app:placeholderImage="@drawable/ttlive_guest_link_default_head"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_audience_3"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="2dp"
                        app:failureImage="@drawable/ttlive_guest_link_default_head"
                        app:placeholderImage="@drawable/ttlive_guest_link_default_head"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ttlive_white_50"
                        android:id="@+id/tv_audience_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:text="@string/ttlive_guest_link_channel_info"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_channel_info_arrow"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ttlive_ic_guest_link_channel_info_arrow"
                        app:failureImage="@drawable/ttlive_ic_guest_link_channel_info_arrow"
                        app:placeholderImage="@drawable/ttlive_ic_guest_link_channel_info_arrow"/>
                </LinearLayout>
                <com.bytedance.android.live.liveinteract.revenue.guestlink.ui.GiftMarqueeContainer
                    android:layout_gravity="center"
                    android:id="@+id/gift_marquee_container"
                    android:layout_width="190dp"
                    android:layout_height="20dp"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_user_info_container"
                android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_container"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:layout_marginTop="15dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_channel_info_container">
                <include
                    android:id="@+id/container_user_1_audio"
                    android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="@+id/user_info_container_line"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/ttlive_view_guest_link_user_info_audio"/>
                <include
                    android:id="@+id/container_user_1_video"
                    android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="@+id/user_info_container_line"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/ttlive_view_guest_link_user_info_video_left"/>
                <View
                    android:id="@+id/user_info_container_line"
                    android:background="#14ffffff"
                    android:layout_width="1.5dp"
                    android:layout_height="147dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <include
                    android:id="@+id/container_user_2_audio"
                    android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="@+id/user_info_container_line"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/ttlive_view_guest_link_user_info_audio"/>
                <include
                    android:id="@+id/container_user_2_video"
                    android:background="@drawable/ttlive_bg_guest_link_main_page_user_info_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="@+id/user_info_container_line"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/ttlive_view_guest_link_user_info_video_right"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_timer"
                android:background="@drawable/ttlive_guest_link_timer"
                android:layout_width="65dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:text=""
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ll_user_info_container"/>
            <Button
                android:textSize="15sp"
                android:textColor="#bfc1c5"
                android:id="@+id/button_1"
                android:background="@drawable/ttlive_bg_guest_link_main_page_negative_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="16dp"
                android:text="@string/ttlive_guest_link_finish_channel"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/button_2"
                app:layout_constraintTop_toBottomOf="@+id/ll_user_info_container"/>
            <Button
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/button_2"
                android:background="@drawable/ttlive_bg_guest_link_main_page_positive_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:text="@string/ttlive_guest_link_send_gift"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/button_1"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_user_info_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>
