<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:id="@+id/tv_rank_num"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:minWidth="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_circle"
        app:layout_constraintLeft_toLeftOf="@+id/iv_live_circle"
        app:layout_constraintRight_toRightOf="@+id/iv_live_circle"
        app:layout_constraintTop_toTopOf="@+id/iv_live_circle"/>
    <com.bytedance.android.livesdkapi.view.SaasLiveCircleView
        android:id="@+id/iv_live_circle"
        android:padding="1dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_rank_num"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="0dp"
        app:live_strokeWidth="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/live_tag_layout"
        android:background="@drawable/ttlive_feed_bg_follow_sky_live_tag"
        android:layout_width="48dp"
        android:layout_height="17dp"
        android:layout_marginTop="45dp"
        app:layout_constraintLeft_toLeftOf="@+id/iv_avatar"
        app:layout_constraintRight_toRightOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar">
        <View
            android:id="@+id/iv_douyin_label"
            android:background="@drawable/ttlive_ic_rank_douyin_label"
            android:layout_width="10dp"
            android:layout_height="10dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="center"
            android:id="@+id/tv_live_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_on_live"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/view_name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="23dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_live_circle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_feed_black_text"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:maxWidth="50dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_content_label"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/tv_anchor_name"/>
    </RelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_feed_open_d2_69"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_room_title"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="23dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/view_name_container"
        app:layout_constraintRight_toLeftOf="@+id/tv_audience_count"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_feed_open_d2_69"
        android:id="@+id/tv_audience_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
