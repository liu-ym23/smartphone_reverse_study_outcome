<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_bg_ffffff_corner_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_highlight_permission_dialog_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_highlight_permission_dialog_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_title"/>
    <View
        android:id="@+id/divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <Button
            android:textSize="15sp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/left_button"
            android:background="@drawable/shape_bg_ffffff_corner_16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_highlight_permission_dialog_left_btn"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
        <View
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/right_button"
            android:background="@drawable/shape_bg_ffffff_corner_16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_highlight_permission_dialog_right_btn"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
