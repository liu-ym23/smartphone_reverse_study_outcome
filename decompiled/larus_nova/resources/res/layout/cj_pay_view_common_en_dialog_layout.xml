<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_common_dialog"
    android:layout_width="@dimen/cj_pay_height_270"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_common_dialog_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_black_34"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_title_view"
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/cj_pay_padding_3"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_black_34"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_sub_title_view"
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_content_view"
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="1dp"/>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_common_dialog_divider"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_below="@+id/cj_pay_common_dialog_title_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_common_dialog_divider">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_new_blue"
            android:gravity="center"
            android:id="@+id/cj_pay_common_dialog_confirm_btn_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:text="@string/cj_pay_common_dialog_confirm"
            android:singleLine="true"
            android:layout_weight="1"/>
        <View
            android:id="@+id/cj_pay_common_dialog_vertical_divider"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_new_blue"
            android:gravity="center"
            android:id="@+id/cj_pay_common_dialog_cancel_btn_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:text="@string/cj_pay_common_dialog_cancel"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_17"
        android:textColor="@color/cj_pay_color_new_blue"
        android:gravity="center"
        android:id="@+id/cj_pay_common_dialog_single_btn_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44"
        android:text="@string/cj_pay_i_know"
        android:layout_below="@+id/cj_pay_common_dialog_divider"/>
</RelativeLayout>
