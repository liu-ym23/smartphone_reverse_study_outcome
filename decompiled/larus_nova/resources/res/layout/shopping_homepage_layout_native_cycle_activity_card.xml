<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cycle_activity_layout"
    android:background="@color/ec_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/cycle_activity_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/cycle_activity_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_activity_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cycle_activity_tag">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_hours"
            android:background="@color/shopping_home_color_FFE1DF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_dot_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_minutes"
            android:background="@color/shopping_home_color_FFE1DF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_dot_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_home_color_FF3344"
            android:id="@+id/cycle_activity_countdown_seconds"
            android:background="@color/shopping_home_color_FFE1DF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cycle_activity_countdown_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cycle_activity_product_items"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cycle_activity_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
