<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_multi_enlarge_white_dialog_r20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/operate_changed_tv"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/ttlive_dialog_multi_enlarge_operate_changed"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/operate_append_tv"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/ttlive_dialog_multi_enlarge_operate_append"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/operate_changed_tv"/>
    <View
        android:background="#0d161823"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toTopOf="@+id/operate_cancel_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/operate_append_tv"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/operate_cancel_tv"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
