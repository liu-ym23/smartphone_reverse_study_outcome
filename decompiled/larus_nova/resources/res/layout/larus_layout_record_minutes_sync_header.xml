<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_58">
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_vertical"
        android:id="@+id/sync_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="?attr/larus_dp_8"
        android:drawableStart="@drawable/larus_ic_album_real_sync"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/sync_progress_bar"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_3"
        android:progress="0"
        android:progressTint="@color/larus_primary_50"
        android:progressBackgroundTint="@color/larus_primary_transparent_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <View
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
