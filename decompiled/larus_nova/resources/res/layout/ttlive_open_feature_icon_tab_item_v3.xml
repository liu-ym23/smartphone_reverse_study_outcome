<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/action_area"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="86dp">
    <RelativeLayout
        android:id="@+id/icon_game"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon_game_img"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            app:roundedCornerRadius="8dp"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/category_tag"
            android:background="@drawable/ttlive_open_feature_category_tag_bg"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:minHeight="14dp"
            android:layout_alignTop="@+id/icon_game_img"
            android:textAlignment="center"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_alignStart="@+id/icon_game_img"/>
        <ImageView
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_ic_red_dot_v3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-6dp"
            android:layout_alignTop="@+id/icon_game_img"
            android:layout_alignRight="@+id/icon_game_img"
            android:layout_marginEnd="-6dp"
            android:layout_alignEnd="@+id/icon_game_img"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_color_161823"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/txt_game_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_color_161823_alpha60"
                android:gravity="center_vertical"
                android:id="@+id/txt_title_label"
                android:background="@drawable/ttlive_feature_title_label_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/feature_label_layout"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_color_161823_alpha75"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/txt_game_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/img_game_summary"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/feature_start_btn"
        android:background="@drawable/ttlive_feature_start_btn_bg"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:minWidth="64dp"/>
</LinearLayout>
