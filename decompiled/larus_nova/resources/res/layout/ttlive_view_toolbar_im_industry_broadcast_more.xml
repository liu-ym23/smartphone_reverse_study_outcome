<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/ttlive_broadcast_more_action_root_height"
    android:minHeight="@dimen/ttlive_broadcast_more_action_root_height">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/ttlive_broadcast_more_action_width"
        android:layout_height="63dp"
        android:minWidth="@dimen/ttlive_broadcast_more_action_root_height"
        android:minHeight="@dimen/ttlive_broadcast_more_action_root_height"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:id="@+id/toolbar_icon_root"
            android:background="@drawable/ttlive_bg_toolbar_audience_interact"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="36dp"
            android:layout_height="36dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"
                android:alpha="0.7"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/live_color_toolbar_im_count"
                android:gravity="center"
                android:id="@+id/tv_im_unread_count"
                android:background="@drawable/ttlive_shap_im_entrance_unread_bg"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="-4dp"
                android:layout_marginRight="-4dp"
                android:minWidth="16dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_marginEnd="-4dp"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/im_unread_count_zero"
                android:background="@drawable/ttlive_bg_im_toolbar_unread_zero"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ttlive_broadcast_more_action_hint_margin_top"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
