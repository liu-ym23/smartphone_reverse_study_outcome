<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/drive_select_action_root"
    android:paddingTop="?attr/larus_dp_4"
    android:paddingBottom="?attr/larus_dp_4"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="?attr/larus_dp_64"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <ImageView
        android:id="@+id/drive_select_action_icon"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/drive_select_action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:includeFontPadding="false"/>
</LinearLayout>
