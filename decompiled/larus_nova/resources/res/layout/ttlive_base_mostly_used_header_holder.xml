<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white_50"
        android:id="@+id/mostly_used_edit_gift_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="长按礼物进行添加/移除"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mostly_used_hint_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_s_s_infocircle"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mostly_used_edit_gift_hint"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white_75"
        android:id="@+id/switch_pinup_status_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设为首栏"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/pinup_switch_button"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/switch_pinup_status_hint"
        app:layout_constraintTop_toTopOf="parent"
        app:lsb_background="@color/ttlive_white_20"
        app:lsb_border_width="2dp"
        app:lsb_button_color="@color/ttlive_white"
        app:lsb_checked_color="#ff004f"
        app:lsb_shadow_effect="false"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
