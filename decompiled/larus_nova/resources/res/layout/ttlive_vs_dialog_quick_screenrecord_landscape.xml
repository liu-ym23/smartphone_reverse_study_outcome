<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_vs_dialog_container"
    android:background="@drawable/ttlive_bg_quick_shot_landscape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintCircleRadius="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ttlive_vs_dialog_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp">
        <FrameLayout
            android:id="@+id/ttlive_vs_quick_record_snapshot"
            android:layout_width="100dp"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/ttlive_vs_quick_screenshot_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="5"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ttlive_vs_quick_record_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_ic_quick_screen_record_landscape"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_share"
            android:background="@drawable/ttlive_quick_shot_landscape_share_btn"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:height="16dp"
            android:layout_weight="2"
            style="@style/uicomponent_button_style_primary_l">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/ttlive_ic_quick_shot_share"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_vs_dialog_quick_screenrecord_share"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
