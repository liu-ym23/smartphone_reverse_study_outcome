<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_play_with_download"
    android:background="@drawable/gamecp_bg_play_with_download"
    android:layout_width="match_parent"
    android:layout_height="24dp">
    <ImageView
        android:id="@+id/ic_flash"
        android:layout_width="12dp"
        android:layout_height="13dp"
        android:src="@drawable/gamecp_ic_flash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_start_cloud_game"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_white"
        android:id="@+id/tv_start_cloud_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gamecp_play_with_download"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ic_flash"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
