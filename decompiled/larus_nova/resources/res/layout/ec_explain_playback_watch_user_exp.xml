<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginRight="12dp"
    android:layout_marginEnd="12dp">
    <com.bytedance.android.ui.ec.widget.button.ECButton
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/online_info"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:bg_color="#33000000"
        app:bg_cornerRadius="30dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/close_in_top_container"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ttlive_close_in_top_container_shadow"
        android:layout_marginStart="2dp"/>
</LinearLayout>
