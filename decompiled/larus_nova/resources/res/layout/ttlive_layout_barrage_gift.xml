<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gift_barrage_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/gift_content_layout"
        android:paddingLeft="28dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_gift_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:includeFontPadding="false"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="italic|bold"
            android:textColor="@color/white"
            android:id="@+id/tv_gift_combo_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="x"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/tv_gift_description"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="italic|bold"
            android:textColor="@color/white"
            android:id="@+id/tv_gift_combo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/tv_gift_combo_prefix"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_gift_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/gift_group_count_layout"
        android:background="@drawable/ttlive_bg_landscape_gift_group_count"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:translationY="1px">
        <TextView
            android:textSize="8dp"
            android:textStyle="italic|bold"
            android:textColor="@color/white"
            android:id="@+id/tv_gift_group_count_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:text="x"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="8dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_gift_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
