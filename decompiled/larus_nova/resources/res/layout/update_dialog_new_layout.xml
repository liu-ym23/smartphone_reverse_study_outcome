<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:layout_width="294dp"
    android:layout_height="409dp"
    android:adjustViewBounds="true"
    android:minHeight="323dp">
    <RelativeLayout
        android:id="@+id/update_root"
        android:background="@drawable/update_check_white_bg"
        android:clipChildren="false"
        android:layout_width="272dp"
        android:layout_height="378dp"
        android:adjustViewBounds="true"
        android:minHeight="314dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/scroll_view_container"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="22dp"
            android:layout_marginBottom="92dp"
            android:layout_below="@+id/update_sdk_title">
            <ScrollView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/scroll_view"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/update_content_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/update_sdk_title"
            android:background="@drawable/update_check_white_bg"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <ImageView
                android:id="@+id/update_check_cancel_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/btn_appupdate_close"
                android:layout_alignParentRight="true"
                android:contentDescription="@string/description_close_button"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/update_rocket_lottie"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_marginTop="-37dp"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="19sp"
                android:textColor="#222204"
                android:gravity="left"
                android:id="@+id/update_title_txt"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/update_version_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/update_title_txt"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="123dp"
            android:layout_alignParentBottom="true">
            <View
                android:background="@drawable/update_scroll_bg"
                android:layout_width="wrap_content"
                android:layout_height="79dp"
                android:layout_alignParentTop="true"/>
            <RelativeLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bind_app_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginBottom="17dp"
                android:layout_above="@+id/update_check_ok_btn">
                <ImageView
                    android:id="@+id/hint_check"
                    android:background="@drawable/bg_new_bind_app_checkbox"
                    android:duplicateParentState="true"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/bg_new_bind_app_checkbox_popping"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:id="@+id/hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/hint_check"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bg_auto_download_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginBottom="17dp"
                android:layout_above="@+id/update_check_ok_btn">
                <ImageView
                    android:id="@+id/bg_auto_download_check"
                    android:background="@drawable/bg_new_bind_app_checkbox"
                    android:duplicateParentState="true"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/bg_new_bind_app_checkbox_popping"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f04142"
                    android:id="@+id/bg_auto_download_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_auto_download_string"
                    android:layout_toRightOf="@+id/bg_auto_download_check"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/update_check_ok_btn"
                android:background="@drawable/update_check_ok_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/update_download"
                android:layout_alignParentBottom="true"/>
            <ProgressBar
                android:id="@+id/update_progress"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:progressDrawable="@drawable/update_download_progress"
                android:layout_alignParentBottom="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/update_download_text"
                android:background="@drawable/update_downloading_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/update_downloading"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
