<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gift_empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_panel_view"
        android:background="@drawable/ttlive_bg_gift_new_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_operation_container"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="8dp"/>
    <FrameLayout
        android:id="@+id/top_view_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="300dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@+id/top_operation_container"/>
    <FrameLayout
        android:id="@+id/forbiden_notice"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/space"/>
    <FrameLayout
        android:id="@+id/group_live_room_widget"
        android:visibility="visible"
        android:layout_width="191dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toTopOf="@+id/top_operation_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/select_receiver_container"
        android:visibility="visible"
        android:layout_width="180dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toTopOf="@+id/top_operation_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/top_operation_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_top_operation_container_height"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <com.bytedance.android.livesdk.widget.PublicScreenEdgeTransparentView
        android:id="@+id/gift_list_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cash_exchange_container"
        app:layout_constraintLeft_toLeftOf="@+id/gift_panel_view"
        app:layout_constraintRight_toRightOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_container_height"
        app:layout_constraintBottom_toTopOf="@+id/gift_list_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/cash_exchange_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/first_charge_tip_container"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/gift_combo_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
