<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_limit_purchase_dialog_1383972963"
    android:background="@drawable/ec_commerce_bg_white_radius_2dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ec_commerce_limit_purchase_dialog_55904300"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:text="@string/shopping_tip_limit_purchase_dialog_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/font_size_34"/>
    <TextView
        android:textColor="@color/TextReverse2"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/commerce_tv_limit_purchase_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/font_size_28"/>
    <View
        android:background="@color/shopping_std_line_black_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="32dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textColor="@color/TextReverse2"
            android:gravity="center"
            android:id="@+id/commerce_tv_limit_purchase_info_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/shopping_tip_limit_purchase_i_know"
            android:layout_weight="1"/>
        <View
            android:background="@color/shopping_std_line_black_2"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:gravity="center"
            android:id="@+id/commerce_tv_limit_purchase_unpay_order"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/shopping_tip_limit_purchase_unpay_order"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
