<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="150dp">
    <View
        android:id="@+id/v_game_header_full_anim_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/v_game_header_full_anim_shape_container"
        android:layout_width="match_parent"
        android:layout_height="128dp">
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/v_game_header_full_anim_img"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gamecp_detail_full_image_height"
            app:actualImageScaleType="centerCrop"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/v_game_header_full_anim_shape_sub1"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/v_game_header_full_anim_shape_sub2"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
    </FrameLayout>
</FrameLayout>
