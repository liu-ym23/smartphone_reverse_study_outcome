<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/container">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/switch_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/switch_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="1dp"
            android:includeFontPadding="false"
            android:layout_marginEnd="1dp"/>
        <ImageView
            android:id="@+id/switch_rule"
            android:visibility="gone"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ttlive_ktv_intro_rule_icon"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.ktvimpl.ktvcomponent.dialog.common.setting.SwitchFrameLayout
        android:layout_gravity="center"
        android:id="@+id/switch_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp">
        <Switch
            android:id="@+id/switch_button"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:importantForAccessibility="no"/>
    </com.bytedance.android.livesdk.ktvimpl.ktvcomponent.dialog.common.setting.SwitchFrameLayout>
</merge>
