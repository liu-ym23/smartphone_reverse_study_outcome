<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_loading_outer_layout"
    android:background="@color/cj_pay_color_white"
    android:paddingTop="@dimen/cj_pay_height_100"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/cj_pay_titlebar_root_view">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_loading_layout"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_height_60"
            android:layout_height="@dimen/cj_pay_height_60">
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_loading_view"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_34"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_loading_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:text="@string/cj_pay_integrated_wait_pay_result"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
