<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/product_img"
        android:layout_width="110dp"
        android:layout_height="110dp"
        app:cornerRadius="6dp"
        app:layoutMode="square"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/commerce_promotion_place_holder"
        app:placeholderImageScaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/product_img"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/product_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#b0774c"
            android:layout_gravity="center_vertical"
            android:id="@+id/selling_points_info"
            android:background="@drawable/ec_commerce_selling_point_info_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_container_ll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#fe496a"
                android:layout_gravity="bottom"
                android:id="@+id/min_price_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_discount_min_price_character"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#fe496a"
                android:layout_gravity="bottom"
                android:id="@+id/min_price_int_places_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="1dp"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#fe496a"
                android:layout_gravity="bottom"
                android:id="@+id/min_price_decimal_places_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_container_cl"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/line_dv"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="1dp"
                android:scaleType="fitXY"
                app:actualImageScaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="-4dp"
                app:layout_constraintLeft_toLeftOf="@+id/line_dv"
                app:layout_constraintTop_toTopOf="@+id/line_dv">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:src="@drawable/ec_commerce_ring_icon"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#99161823"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ec_min_price"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#99161823"
                        android:id="@+id/min_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationY="-1dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/line_dv"
                app:layout_constraintRight_toRightOf="@+id/line_dv">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                        android:id="@+id/discount_min_price_bg"
                        android:layout_width="72dp"
                        android:layout_height="43dp"
                        android:scaleType="fitXY"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="11dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/discount_min_price_character"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ec_discount_min_price_character"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/discount_min_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_marginStart="1dp"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="#ffffff"
                            android:id="@+id/discount_min_price_sku"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ec_sku_text"
                            android:maxLines="1"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffff"
                        android:id="@+id/discount_min_price_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ec_commerce_cycle_icon"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
