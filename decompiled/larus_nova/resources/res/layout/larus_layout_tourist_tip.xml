<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tourist_tip_view"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_60">
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tourist_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_guest_login_top_note"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_68"
        android:layout_marginEnd="?attr/larus_dp_68"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/tourist_close"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="match_parent"
        android:contentDescription="@string/larus_accessibility_logInHome_useTourist">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_ic_tourist_close"
            android:contentDescription="@null"/>
    </FrameLayout>
</FrameLayout>
