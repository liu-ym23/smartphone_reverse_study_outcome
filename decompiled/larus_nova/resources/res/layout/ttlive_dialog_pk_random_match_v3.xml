<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="23dp"
        android:text="@string/ttlive_pk_random_dialog_v2_title1"
        android:layout_marginStart="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/ttlive_pk_random_view_text_color"
        android:gravity="center"
        android:id="@+id/tv_top_left_sec"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="22dp"
        android:includeFontPadding="false"
        android:layout_marginStart="5dp"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ttlive_pk_random_cancel_text_size"
        android:textColor="@color/ttlive_pk_random_cancel_text_color"
        android:gravity="center"
        android:id="@+id/quit"
        android:background="@drawable/ttlive_bg_pk_random_cancel"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_pk_random_cancel_match"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/col_random_match"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView
                android:id="@+id/shadow_view"
                android:layout_width="match_parent"
                android:layout_height="123dp"
                app:dy="0dp"
                app:layout_scrollFlags="scroll"
                app:leftShow="false"
                app:rightShow="false"
                app:shadowColor="#33cad4e0"
                app:shadowLimit="8dp"
                app:topShow="false">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="113dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_horizontal"
                    android:id="@+id/random_rank_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="113dp">
                    <ImageView
                        android:id="@+id/random_icon"
                        android:focusable="false"
                        android:layout_width="44dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="32dp"
                        android:src="@drawable/ttlive_new_random_pk_icon"
                        android:importantForAccessibility="no"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
                        android:id="@+id/random_avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginRight="22dp"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@+id/random_icon"
                        app:layout_constraintRight_toLeftOf="@+id/random_icon"
                        app:layout_constraintTop_toTopOf="@+id/random_icon"
                        app:roundAsCircle="true"
                        app:roundingBorderColor="@color/white"
                        app:roundingBorderWidth="1dp"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/random_guest_anim"
                        android:layout_width="53dp"
                        android:layout_height="32dp"
                        android:layout_marginLeft="22dp"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="22dp"
                        app:layout_constraintBottom_toBottomOf="@+id/random_icon"
                        app:layout_constraintLeft_toRightOf="@+id/random_icon"
                        app:layout_constraintTop_toTopOf="@+id/random_icon"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#80161823"
                        android:id="@+id/random_over_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/ttlive_pk_random_rank_over_tip"
                        app:layout_constraintLeft_toLeftOf="@+id/random_icon"
                        app:layout_constraintRight_toRightOf="@+id/random_icon"
                        app:layout_constraintTop_toBottomOf="@+id/random_icon"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/random_common_ll"
                    android:layout_width="match_parent"
                    android:layout_height="113dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#80161823"
                        android:id="@+id/tv_wait_sec_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/ttlive_pk_random_dialog_wait_sec_title"/>
                    <TextView
                        android:textSize="32sp"
                        android:textColor="#161823"
                        android:id="@+id/tv_left_sec"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="24dp"
                        android:textStyle="bold"
                        android:textColor="#161823"
                        android:id="@+id/tv_waitting"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/ttlive_pk_random_dialog_waitting_tips"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80161823"
                        android:gravity="center"
                        android:id="@+id/tv_pk_about_start"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/ttlive_pk_random_dialog_pk_almost_starting"
                        app:layout_constraintTop_toBottomOf="@+id/tv_left_sec"/>
                </LinearLayout>
            </com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView>
        </com.google.android.material.appbar.AppBarLayout>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
