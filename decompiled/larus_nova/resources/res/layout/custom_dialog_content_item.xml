<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/content_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/icon_custom_default"/>
        <TextView
            android:textAppearance="@style/UDText.Body1"
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/custom_dialog_content_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/UDText.Body0"
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/custom_dialog_content_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/custom_dialog_content_handler_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:alignContent="stretch"
        app:alignItems="stretch"
        app:dividerDrawable="@drawable/content_button_divider"
        app:flexWrap="wrap"
        app:showDivider="middle"/>
</merge>
