<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_page_list_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/home_page_list_guide_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_page_list_guide_gif"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_HomeDashboard_RecentDisplayHere_Desc"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/home_page_list_guide_line"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="17dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:orientation="horizontal"
                android:id="@+id/home_page_list_cover_create"
                android:background="@drawable/bitable_home_page_list_guide_add_bg"
                android:layout_width="86dp"
                android:layout_height="32dp"
                android:layout_marginBottom="7dp"
                android:layout_marginEnd="24dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/ud_icon_add_middle_outlined"
                    app:tint="@color/text_title"/>
                <com.larksuite.framework.ui.CompatDrawableTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_HomeDashboard_CreateNew_Button"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/home_page_list_cover_gradient"
        android:background="@drawable/bitable_home_page_v4_list_cover_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bitable_homepage_list_cover_height"/>
</FrameLayout>
