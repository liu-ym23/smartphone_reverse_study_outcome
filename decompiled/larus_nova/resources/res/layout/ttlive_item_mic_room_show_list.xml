<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="162dp">
    <View
        android:id="@+id/ttlive_line"
        android:background="@color/ttlive_official_mic_room_dialog_line"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dot"
        android:background="@drawable/ttlive_ic_mic_room_dialog_circle"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="22dp"
        app:layout_constraintLeft_toLeftOf="@+id/ttlive_line"
        app:layout_constraintRight_toRightOf="@+id/ttlive_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_official_mic_room_profile_title"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toRightOf="@+id/dot"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/time_divider"
        android:background="@color/ttlive_official_mic_room_dialog_line"
        android:layout_width="0.5dp"
        android:layout_height="10dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintLeft_toRightOf="@+id/tv_time"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/play_animation"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="10dp"
        android:layout_marginLeft="7dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintLeft_toRightOf="@+id/time_divider"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_official_mic_room_profile_title"
        android:id="@+id/tv_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/ttlive_mic_room_dialog_playing"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintLeft_toRightOf="@+id/play_animation"
        app:layout_constraintTop_toTopOf="@+id/tv_time"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_layout"
        android:background="@drawable/ttlive_bg_mic_room_dialog_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ttlive_line"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_card_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.3"
            app:roundedCornerRadius="2dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_card_cover"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/card_animation"
            android:background="@drawable/ttlive_bg_show_list_card_animation"
            android:paddingLeft="5dp"
            android:paddingTop="3dp"
            android:paddingRight="5dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="18dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="@+id/iv_card_cover"
            app:layout_constraintTop_toTopOf="@+id/iv_card_cover"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:maxEms="7"
            app:layout_constraintLeft_toRightOf="@+id/iv_card_cover"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_official_mic_room_text"
            android:ellipsize="end"
            android:id="@+id/tv_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_card_cover"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/follow"
            android:background="@drawable/ttlive_bg_mic_room_card_button"
            android:layout_width="73dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_ic_follow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="-3dp"
                android:src="@drawable/ttlive_mic_room_add"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:id="@+id/tv_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_follow_broadcaster"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
