<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/search_title_top_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_8"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/search_title_name"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Space
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/search_title_all"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chatlist_search_section_viewalll"/>
    </LinearLayout>
</LinearLayout>
