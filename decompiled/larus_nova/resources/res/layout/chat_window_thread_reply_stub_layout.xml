<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/thread_reply_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larksuite.framework.ui.SpareLayout
        android:id="@+id/thread_reply_left_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/thread_reply_bubble"
                android:background="@drawable/chat_chat_bubble_reply_mark_bg"
                android:layout_width="2dp"
                android:layout_height="14dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_link_normal"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/thread_reply_name"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/thread_reply_image_container"
            android:background="@color/ud_N00"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/thread_reply_content_image"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    </com.larksuite.framework.ui.SpareLayout>
    <FrameLayout
        android:id="@+id/thread_reply_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/thread_reply_left_layout">
        <com.ss.android.lark.widget.EllipsizedEmojiconTextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/thread_reply_content_text"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </FrameLayout>
</RelativeLayout>
