<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/task_list_event_item_background_round"
    android:padding="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/task_event_target_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8">
        <ImageView
            android:id="@+id/task_event_target_icon"
            android:layout_width="12sp"
            android:layout_height="12sp"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="@dimen/dp_6"
            app:srcCompat="@drawable/ud_icon_tab_todo_filled"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_caption"
            android:id="@+id/task_event_target_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.universe_design.image.UDAvatar
            android:id="@+id/task_event_operator"
            android:layout_width="26sp"
            android:layout_height="26sp"
            android:layout_marginEnd="@dimen/dp_8"
            app:ud_avatar_size="26sp"
            style="@style/UDAvatar.Circle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.ss.android.lark.widget.EllipsizeFrameLayout
                    android:layout_gravity="start"
                    android:id="@+id/task_event_content_ellipsize_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:enableEllipsize="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            android:textColor="@color/text_title"
                            android:id="@+id/task_event_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_6"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/task_event_description_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_6">
                            <View
                                android:background="@color/text_caption"
                                android:layout_width="2sp"
                                android:layout_height="14sp"
                                android:layout_marginEnd="@dimen/dp_4"/>
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/text_caption"
                                android:id="@+id/task_event_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"/>
                        </LinearLayout>
                        <com.ss.android.lark.widget.richtext.RichTextView
                            android:id="@+id/task_event_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_6"
                            app:richTextColor="@color/text_title"
                            app:richTextSize="14sp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_gravity="start"
                            android:id="@+id/task_event_images"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_gravity="start"
                            android:id="@+id/task_event_attachments"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.ss.android.lark.widget.EllipsizeFrameLayout>
                <View
                    android:id="@+id/task_event_show_more"
                    android:background="@drawable/task_list_event_item_show_more_background"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    app:layout_constraintBottom_toBottomOf="@+id/task_event_content_ellipsize_layout"
                    app:layout_constraintEnd_toEndOf="@+id/task_event_content_ellipsize_layout"
                    app:layout_constraintStart_toStartOf="@+id/task_event_content_ellipsize_layout"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/task_event_show_more_text"
                    android:background="@drawable/chat_post_bg_show_more"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-5dp"
                    android:text="@string/Lark_Legacy_ChatShowMore"
                    app:layout_constraintBottom_toBottomOf="@+id/task_event_content_ellipsize_layout"
                    app:layout_constraintEnd_toEndOf="@+id/task_event_content_ellipsize_layout"
                    app:layout_constraintStart_toStartOf="@+id/task_event_content_ellipsize_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_placeholder"
                android:id="@+id/task_event_time_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
