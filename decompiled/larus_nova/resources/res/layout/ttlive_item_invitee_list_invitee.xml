<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp">
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/contact_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:circleCenterLeftMargin="30dp"
            app:circleCenterTopMargin="30dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/conversation_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:circleCenterLeftMargin="30dp"
            app:circleCenterTopMargin="30dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/contact_active"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </FrameLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.bytedance.android.uicomponent.compoundbutton.TranslucentCheckBox
        android:id="@+id/contact_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        style="@style/ttlive_standard_check_box_style"/>
</LinearLayout>
