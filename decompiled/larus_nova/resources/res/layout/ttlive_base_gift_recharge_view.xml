<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_gift_bottom_tab_normal_color"
        android:gravity="center"
        android:id="@+id/income_to_coins_label"
        android:background="@drawable/ttlive_base_gift_bottom_charge_board"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/charge_layout"
        app:layout_constraintRight_toLeftOf="@+id/charge_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="8dp"
        android:textStyle="bold"
        android:textColor="#8b4700"
        android:gravity="center"
        android:id="@+id/income_to_coins_num_tv"
        android:background="@drawable/ttlive_gift_income_to_coins_num_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginBottom="24dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="29dp"
        app:layout_constraintBottom_toBottomOf="@+id/income_to_coins_label"
        app:layout_constraintEnd_toStartOf="@+id/charge_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/charge_layout"
        android:background="@drawable/ttlive_base_gift_bottom_charge_board"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="9dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/dummy_left"
            android:layout_width="7dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/coin_icon"
            android:visibility="visible"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dummy_left"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/recharge_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coin_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/recharge_arrow"
            android:background="@drawable/ttlive_gift_bottom_recharge_arrow"
            android:layout_width="12dp"
            android:layout_height="14dp"
            android:layout_marginRight="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/anchor_panel_switch"
        android:visibility="gone"
        android:layout_width="89dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/anchor_panel_switch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
