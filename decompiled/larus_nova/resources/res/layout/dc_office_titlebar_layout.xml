<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doc_appbar_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:elevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/titleContentLayout"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:gravity="center_vertical"
            android:id="@+id/doc_main_titlebar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="title_bar"/>
        <ViewStub
            android:id="@+id/doc_main_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.appbar.AppBarLayout>
