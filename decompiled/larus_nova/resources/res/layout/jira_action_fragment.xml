<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/jira_action_drag_view"
        android:background="@drawable/facade_card_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/jira_action_top_bar"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/facade_dragview_handler"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:tag="Jira"
                android:paddingTop="5dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:srcCompat="@drawable/icon_mobile_jira"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="24dp">
                    <TextView
                        android:textSize="@dimen/space_kit_font_16"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:layout_gravity="start|top"
                        android:tag="title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="@dimen/space_kit_font_12"
                        android:textColor="@color/text_caption"
                        android:ellipsize="end"
                        android:layout_gravity="start|bottom"
                        android:tag="desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/bg_float_overlay"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_jira_action"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</FrameLayout>
