<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_feedback_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tag_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_black"
            android:id="@+id/tag_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_talk_room_feedback_tag_title2"/>
        <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
            android:id="@+id/tags_random"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:hSpacing="8dp"
            app:vSpacing="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_tag_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_black"
            android:id="@+id/sub_tag_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_talk_room_feedback_sub_tag_title"/>
        <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
            android:id="@+id/sub_tags_random"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:hSpacing="8dp"
            app:vSpacing="8dp"/>
        <EditText
            android:textSize="13dp"
            android:textColor="#303030"
            android:textColorHint="#1f404040"
            android:gravity="start"
            android:id="@+id/other_et"
            android:background="@drawable/ttlive_bg_et_pk_feedback"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:hint="@string/ttlive_talk_room_feedback_hint"/>
    </LinearLayout>
</LinearLayout>
