<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/xplay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/ic_sei_delay"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ttlive_ic_sei_delay"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_sei_delay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="6dp"/>
    <FrameLayout
        android:id="@+id/anchor_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/clear_screen_container"
        android:background="@drawable/ttlive_bg_interact_play_clear_screen"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="11dp">
        <ImageView
            android:id="@+id/iv_clear_screen"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_ic_interact_play_exit_clear_sn_light"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#e6ffffff"
            android:id="@+id/tv_clear_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_exit_clear_screen"/>
    </LinearLayout>
</FrameLayout>
