<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/image_avatar"
        android:background="@drawable/ttlive_bg_circle_head"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/image_avatar_bound"
        android:background="@drawable/ttlive_bg_anchor_link_living"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/image_avatar"
        app:layout_constraintRight_toRightOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/tv_status"
        android:background="@drawable/ttlive_bg_multi_anchor_link_status"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:text="@string/ttlive_anchor_link_window_inviting"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/image_avatar"
        app:layout_constraintRight_toRightOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/iv_close"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ttlive_ic_multi_anchor_link_close"
        app:layout_constraintRight_toRightOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="70dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/image_avatar"
        app:layout_constraintRight_toRightOf="@+id/image_avatar"
        app:layout_constraintTop_toBottomOf="@+id/image_avatar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/change_team_click_area"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/image_avatar"
        app:layout_constraintRight_toRightOf="@+id/image_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/image_change_team"
            android:background="@drawable/ttlive_team_pk_view_change_team_selector"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_multi_pk_panel_change_team_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_change_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_team_pk_change_team"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
