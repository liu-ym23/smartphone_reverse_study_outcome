<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/combine_pay_limit_dialog_layout"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/cj_pay_dialog_close"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:singleLine="true"
        style="@style/CJPayShadowTextStyle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="center"
        android:id="@+id/cj_pay_dialog_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:lineSpacingExtra="2dp"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15dp"
        android:gravity="center"
        android:id="@+id/cj_pay_dialog_confirm_btn"
        android:background="@drawable/cj_pay_bg_red_btn_radius_4_fe2c55"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"/>
</LinearLayout>
