<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/first_more_anchor_layout"
    android:background="@drawable/ttlive_bg_first_more_anchor"
    android:layout_width="138dp"
    android:layout_height="44dp"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_more_anchor_notification"
        android:includeFontPadding="false"
        android:paddingStart="12dp"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="17dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="17dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_left"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="0dp"
            android:layout_alignParentLeft="true"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/ttlive_more_anchor_img_round"
            app:roundingBorderWidth="0.5dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_middle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="13dp"
            android:layout_alignParentLeft="true"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/ttlive_more_anchor_img_round"
            app:roundingBorderWidth="0.5dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_right"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="26dp"
            android:layout_alignParentLeft="true"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/ttlive_more_anchor_img_round"
            app:roundingBorderWidth="0.5dp"/>
    </RelativeLayout>
</LinearLayout>
