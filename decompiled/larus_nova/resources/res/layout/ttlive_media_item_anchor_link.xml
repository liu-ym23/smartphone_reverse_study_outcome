<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp">
    <FrameLayout
        android:id="@+id/iv_avatar_gender"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/iv_avatar"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="bottom|right"
            android:id="@+id/iv_gender"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ttlive_gender_male_icon"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_invite"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar_gender"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/tv_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="5"
                android:singleLine="true"
                android:lineSpacingExtra="5dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_location"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ttlive_ic_anchor_location"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="13dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/bt_invite_or_apply"
        android:background="@drawable/ttlive_bg_media_anchor_link_invite_available"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_media_anchor_link_invite_link"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
