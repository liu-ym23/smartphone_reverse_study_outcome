<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_album_thumbnail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_65">
    <ImageView
        android:id="@+id/diary_calendar_close"
        android:padding="?attr/larus_dp_10"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:src="@drawable/larus_ic_close"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:id="@+id/diary_calendar_month_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/diary_calendar_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/diary_calendar_close"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/neutral_100"
        android:gravity="center"
        android:id="@+id/diary_calendar_today"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_44"
        android:text="@string/larus_dora_personal_diary_calendar_view_today_cn"
        app:layout_constraintBottom_toBottomOf="@+id/diary_calendar_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/diary_calendar_close"/>
    <include
        android:gravity="center_vertical"
        android:id="@+id/diary_calendar_week_header"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginLeft="?attr/larus_dp_13"
        android:layout_marginRight="?attr/larus_dp_13"
        app:layout_constraintTop_toBottomOf="@+id/diary_calendar_close"
        layout="@layout/larus_item_diary_calendar_week_header"/>
    <View
        android:id="@+id/diary_calendar_divider"
        android:background="@color/neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diary_calendar_week_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/diary_calendar_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_13"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginRight="?attr/larus_dp_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diary_calendar_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
