<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootLL"
    android:background="@color/ttlive_transparent"
    android:layout_width="228dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_co_host_comment_detail_top"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/castLL"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/castIconIV"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/ttlive_ic_co_host_comment_head"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="大家在评论"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/castFoldIV"
            android:paddingLeft="8dp"
            android:paddingRight="10dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_ic_co_host_comment_fold"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/detailContainer"
        android:background="@drawable/ttlive_bg_co_host_comment_detail"
        android:layout_width="match_parent"
        android:layout_height="137dp"/>
</LinearLayout>
