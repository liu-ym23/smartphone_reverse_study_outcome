<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textColor="@color/reverse_tPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:avFontType="medium"
        style="@style/tools_font_size_34"/>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textColor="@color/reverse_tTertiary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/tools_font_size_28"/>
</merge>
