<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="100dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/bg_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="2dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/ttlive_feed_drawer_history_item_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/history_delete"
        android:background="@drawable/ttlive_feed_drawer_history_close"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/living_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/living_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="70dp"
            android:maxLines="1"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/not_living_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/not_living_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="55dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#80ffffff"
            android:id="@+id/status_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:text="@string/ttlive_feed_drawer_live_history_not_living"/>
    </LinearLayout>
</FrameLayout>
