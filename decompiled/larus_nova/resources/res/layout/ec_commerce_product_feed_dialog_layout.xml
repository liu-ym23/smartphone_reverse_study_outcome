<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_feed_dialog_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/product_feed_dialog_bg"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <View
        android:id="@+id/product_feed_strengthen_card_segmentation_bg_half"
        android:background="@drawable/commerce_inner_flow_strength_segmentation_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinator"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/touch_outside"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:soundEffectsEnabled="false"
                android:importantForAccessibility="no"/>
            <View
                android:id="@+id/commerce_touch_out_feed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/commerce_design_bottom_sheet"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.bytedance.android.shopping.feed.fragment.CustomNestedRollingChildBehavior"
                style="?attr/bottomSheetStyle"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
    <com.bytedance.android.shopping.feed.view.CouponView
        android:layout_gravity="bottom"
        android:id="@+id/product_feed_bottom_view"
        android:background="@drawable/ec_inflow_freshman_coupon_view_parent_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="35dp"
        android:alpha="0"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="2.5dp"/>
</FrameLayout>
