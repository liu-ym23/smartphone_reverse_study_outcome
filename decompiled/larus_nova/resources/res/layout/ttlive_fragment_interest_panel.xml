<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/ttlive_bg_interactivity_share_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textColor="@color/ttlive_60_161823"
                android:id="@+id/tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_input_more_panel_interest_tips"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <ImageView
                android:textColor="@color/ttlive_60_161823"
                android:background="@drawable/ttlive_input_panel_interest_refresh_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <TextView
                android:textColor="@color/ttlive_60_161823"
                android:id="@+id/refresh_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_input_more_panel_interest_refresh"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/interest_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/ttlive_more_panel_button_left_and_right_margin"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/ttlive_more_panel_button_left_and_right_margin"
            android:layout_marginBottom="12dp"
            android:overScrollMode="never"/>
    </LinearLayout>
    <LinearLayout
        android:textSize="13dp"
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/error_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/frequent_chat_api_error_hint_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_color_99_161823"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:text="@string/frequent_chat_api_error_hint_text"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center"
            android:id="@+id/error_button"
            android:background="@drawable/ttlive_bg_frequent_chat_fresh_btn"
            android:layout_width="165dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/frequent_chat_refresh"/>
    </LinearLayout>
</FrameLayout>
