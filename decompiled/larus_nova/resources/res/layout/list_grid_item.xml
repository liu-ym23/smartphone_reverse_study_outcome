<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/grid_item"
    android:background="@drawable/list_grid_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_grid_item_height">
    <View
        android:background="@drawable/list_grid_item_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:backgroundTint="@color/bg_body"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_grid_thumbnail"
        android:background="@drawable/list_grid_item_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:backgroundTint="@color/bg_body"
        app:srcCompat="@drawable/list_grid_placeholder"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_grid_folder_thumbnail"
        android:visibility="gone"
        android:layout_width="41dp"
        android:layout_height="32dp"
        android:layout_marginTop="26dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_file_sharefolder_colorful"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_grid_pin"
        android:background="@drawable/ic_icon_notification_shape"
        android:padding="3dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:tint="@color/colorful_yellow"
        android:layout_marginEnd="9dp"
        app:layout_constraintRight_toLeftOf="@+id/list_external_notice"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_collect_filled"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_external_notice"
        android:background="@drawable/ic_icon_notification_shape"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:tint="@color/icon_disable"
        android:layout_marginEnd="9dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_warning_outlined"/>
    <View
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/list_grid_item_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/list_grid_item_container"
        android:background="@drawable/list_pin_item_container_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="1dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/list_grid_item_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_file_round_doc_colorful"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/list_grid_item_shortcut"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/list_grid_item_type"
            app:layout_constraintLeft_toLeftOf="@+id/list_grid_item_type"
            app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
        <com.bytedance.ee.bear.list.docstate.SyncStateView
            android:id="@+id/list_grid_item_sync_state"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/list_grid_item_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/list_grid_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/list_grid_item_tag"
            app:layout_constraintLeft_toRightOf="@+id/list_grid_item_type"
            app:layout_constraintRight_toLeftOf="@+id/list_grid_more"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
            android:id="@+id/list_grid_item_tag"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/list_grid_item_type"
            app:layout_constraintRight_toLeftOf="@+id/list_grid_more"
            app:layout_constraintTop_toBottomOf="@+id/list_grid_item_title"
            app:titleTagMargin="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/list_grid_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/list_grid_more_dot"
            app:tint="@color/icon_n3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
