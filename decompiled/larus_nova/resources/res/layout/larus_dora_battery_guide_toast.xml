<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="?attr/larus_dp_10"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/larus_dora_battery_guide_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/larus_base_3"
        app:cardCornerRadius="?attr/larus_dp_33"
        app:cardElevation="?attr/larus_dp_4"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/larus_dora_battery_guide_toast_root"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_66"
            android:paddingStart="?attr/larus_dp_28"
            android:paddingEnd="?attr/larus_dp_16">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/larus_dora_battery_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="?attr/larus_dp_160"
                android:maxLines="1"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/larus_dora_battery_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/larus_dora_battery_guide_title">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/larus_dora_battery_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/larus_dora_battery_left_hint_icon"
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_dora_onboarding_ic_left"
                        app:tint="?attr/larus_neutral_50"/>
                    <com.lynx.lottieadapter.LottieAdapterView
                        android:id="@+id/larus_dora_battery_left_lottie"
                        android:layout_width="?attr/larus_dp_24"
                        android:layout_height="?attr/larus_dp_24"
                        android:layout_marginStart="?attr/larus_dp_4"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_12"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/larus_dora_battery_left_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="?attr/larus_dp_4"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/larus_dora_battery_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="?attr/larus_dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/larus_dora_battery_left"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="?attr/larus_dp_0">
                    <ImageView
                        android:id="@+id/larus_dora_battery_right_hint_icon"
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_dora_onboarding_ic_right"
                        app:tint="?attr/larus_neutral_50"/>
                    <com.lynx.lottieadapter.LottieAdapterView
                        android:id="@+id/larus_dora_battery_right_lottie"
                        android:layout_width="?attr/larus_dp_24"
                        android:layout_height="?attr/larus_dp_24"
                        android:layout_marginStart="?attr/larus_dp_4"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_12"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/larus_dora_battery_right_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="?attr/larus_dp_4"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/larus_dora_battery_text_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/larus_dora_battery_guide_device_image"
                android:layout_width="?attr/larus_dp_64"
                android:layout_height="?attr/larus_dp_48"
                android:scaleType="centerInside"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/larus_dora_battery_text_barrier"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
