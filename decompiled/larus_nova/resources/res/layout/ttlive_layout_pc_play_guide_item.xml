<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flPcTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivPcIcon"
        android:background="@drawable/live_pc_play_guide_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="21dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_161823"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvPcTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:text="@string/ttlive_pad_and_pc_pc_guide_title_new"
        app:layout_constraintBottom_toBottomOf="@+id/ivPcIcon"
        app:layout_constraintLeft_toRightOf="@+id/ivPcIcon"
        app:layout_constraintTop_toTopOf="@+id/ivPcIcon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_color_80_161823"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvSubPcTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="37dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_pad_and_pc_pc_guide_sub_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvPcTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPcTitle"/>
    <ImageView
        android:id="@+id/ivPcArrow"
        android:background="@drawable/ttlive_ic_pad_pc_play_arrow_light_theme"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
