<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/card_container"
    android:background="@color/POIBgPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/poi_ll_collect_recommend"
        android:background="@drawable/poi_bg_collect_recommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="52dp">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="@color/POIPrimary"
                android:ellipsize="end"
                android:id="@+id/poi_collect_recommend_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/poi_collect_recommend_anchor"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/poi_collect_recommend_back"
            android:padding="5dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/off"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_s_s_xmark_outlined"
            app:tint="@color/POITextPrimary"/>
    </RelativeLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/POITextTertiary"
        android:id="@+id/tv_guess_u_wanna_go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/poi_detail_guess_you_wanna_go"
        style="@style/font_size_24_sp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/poi_collect_recommend_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
