<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="104dp"
    android:layout_height="168dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_live_interact_list"
        android:layout_width="104dp"
        android:layout_height="152dp"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="104dp"
            android:layout_height="116dp">
            <com.bytedance.android.livesdk.chatroom.widget.AvatarIconView
                android:id="@+id/avatar_level"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                app:ttlive_avatar_size="52dp"
                app:ttlive_icon_size="16dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/ttlive_core_hs_c1"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:maxWidth="82dp"
                android:maxLines="1"
                android:fontFamily="sans-serif"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="normal"
                android:textColor="@color/ttlive_core_hs_c3"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:id="@+id/description"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/connect"
            android:background="@drawable/ttlive_bg_interact_wait_connect"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="24dp"
            android:layout_marginBottom="12dp">
            <com.bytedance.android.live.core.widget.FitTextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/ttlive_hs_w1"
                android:gravity="center"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_wait_connect"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.live.core.widget.FitTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/disconnect"
            android:background="@drawable/ttlive_bg_interact_wait_disconnect"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_live_interact_wait_disconnect"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
