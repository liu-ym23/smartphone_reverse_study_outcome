<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mtm_task_ongoing_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/mtm_task_fold_stack_bg"
        android:background="@drawable/larus_mtm_card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mtm_task_ongoing_item_content"
        android:background="@drawable/larus_mtm_card_bg_with_press"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64">
        <FrameLayout
            android:id="@+id/mtm_task_icon_bg"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/mtm_task_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/larus_mtm_task_avatar_ongoing"/>
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/mtm_task_icon_lottie"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:lottie_loop="true"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/mtm_task_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_0"
            app:layout_constraintEnd_toStartOf="@+id/mtm_task_close"
            app:layout_constraintStart_toEndOf="@+id/mtm_task_icon_bg"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/mtm_task_close"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_mtm_ic_close"
            android:contentDescription="@null"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/larus_neutral_transparent_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
