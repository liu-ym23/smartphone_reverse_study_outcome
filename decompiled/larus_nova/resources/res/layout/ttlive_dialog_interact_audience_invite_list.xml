<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="72dp"
            android:src="@drawable/ttlive_ic_video_talk_place_holder_empty"/>
        <TextView
            android:textColor="#88000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_user_rank_no_network_below_tip"/>
        <TextView
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refresh"
            android:background="@drawable/ttlive_bg_interact_text"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_network_refresh"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="113dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#88000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/ttlive_interact_video_talk_apply_empty"/>
    </LinearLayout>
</FrameLayout>
