<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/custom_album_status_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <com.bytedance.locallife.biz.widget.SimpleLynxView
            android:id="@+id/custom_album_top_bar_lynx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.ies.dmt.ui.widget.tablayout.DmtTabLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/custom_album_tab_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabBackground="@null"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/POIPrimary2"
            app:tabIndicatorHeight="2dp"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/custom_album_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.ies.dmt.ui.widget.DmtStatusView
                android:id="@+id/custom_album_status_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <com.bytedance.locallife.biz.widget.SimpleLynxView
        android:id="@+id/custom_album_bottom_bar_lynx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
