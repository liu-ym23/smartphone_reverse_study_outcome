<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/open_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/ttlive_interact_audience_open_bg_img"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="46dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_video_interact_open_tips"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_open_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:text="@string/ttlive_video_interact_open_description"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/open_link"
            android:background="@drawable/ttlive_bg_interact_audience_open_btn"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:layout_marginTop="37dp"
            android:text="@string/ttlive_live_interact_confirm_bt"/>
    </LinearLayout>
</FrameLayout>
