<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/larus_correction_container_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/larus_correction_image_view"
        android:padding="?attr/larus_dp_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <FrameLayout
        android:id="@+id/larus_correction_failed_container"
        android:background="@drawable/larus_correction_item_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:scaleType="fitCenter"
                app:srcCompat="?attr/larus_ic_correction_failed"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_30"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_21"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_preview_status_tag_fail"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_correction_loading_container"
        android:background="@drawable/larus_correction_item_bg"
        android:padding="?attr/larus_dp_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/larus_correction_loading_image_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <View
            android:id="@+id/larus_correction_loading_image_view_cover"
            android:background="@drawable/larus_correction_image_loading_cover"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/larus_correction_loading_image"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_33"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:src="@drawable/larus_ic_correction_loading"
                android:scaleType="fitCenter"/>
            <com.larus.bmhome.chat.layout.widget.ShimmerTextView
                android:textSize="?attr/larus_sp_14"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/larus_correction_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_21"
                android:text="@string/larus_preview_status_tag_check"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/larus_correction_retry_container"
        android:background="@drawable/larus_correction_item_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/larus_correction_retry_image"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:scaleType="fitCenter"
                app:srcCompat="?attr/larus_ic_correction_retry"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_30"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_21"
                android:text="@string/larus_loading_error_msg"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:background="?attr/larus_correction_image_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
