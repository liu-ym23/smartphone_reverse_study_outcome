<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/last_read_hint_mask"
        android:background="@color/ao_bgsecondary3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/follow_feed_no_follow_img"
        android:background="@drawable/follow_feed_no_follow_img"
        android:layout_width="192dp"
        android:layout_height="128dp"
        android:layout_marginTop="241dp"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/ConstTextInverse"
        android:gravity="center"
        android:id="@+id/follow_feed_no_follow_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/common_feed_tab_no_follow_desc"
        android:layout_below="@+id/follow_feed_no_follow_img"
        style="@style/font_size_34"/>
    <TextView
        android:textColor="@color/aos_reverse_t_tertiary"
        android:gravity="center"
        android:id="@+id/follow_feed_no_follow_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/common_feed_tab_to_follow_desc"
        android:layout_below="@+id/follow_feed_no_follow_title"
        style="@style/font_size_28"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/no_follow_back_layout"
        android:background="@drawable/follow_feed_bg_follow_feed_last_read_hint"
        android:layout_width="143dp"
        android:layout_height="44dp"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/follow_feed_no_follow_desc"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/last_read_back_left"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/follow_feed_ic_last_read_back_left"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/TextReverse"
                android:id="@+id/last_read_back_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="@string/follow_feed_to_recommend_reinforce"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/font_size_30"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/last_read_back_right"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/follow_feed_bg_last_view_arrow"
                android:scaleType="fitXY"/>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
