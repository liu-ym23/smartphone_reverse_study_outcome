<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="@drawable/ttlive_bg_cash_exchange_dialog_gift_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-56dp"
        android:layout_below="@+id/gift_icon">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/exchange_img_close"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/ttlive_cash_exchange_gift_close"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_content_new"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/ttlive_cash_exchange_gift_send_title_new"
            android:includeFontPadding="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/task_award_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/task_award_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                app:placeholderImage="@drawable/ttlive_task_award_gold_ic_saas"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#f58900"
                android:id="@+id/task_award_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_content_new"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_content_new"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cost_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ttlive_cash_exchange_cost_balance"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/toggle_btn_container"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="22dp">
            <ToggleButton
                android:id="@+id/toggle_btn"
                android:background="@drawable/ttlive_cash_exchange_attention"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:checked="true"
                android:textOn=""
                android:textOff=""/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_cash_exchange_gift_dialog_content_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:includeFontPadding="false"
                android:alpha="0.7"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <Button
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/exchange_button_confirm"
            android:background="@drawable/ttlive_bg_cash_exchange_dialog_btn_new"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_content_new"
            android:layout_gravity="center_horizontal"
            android:id="@+id/exchange_button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:text="@string/ttlive_cash_exchange_gift_send_ignore"
            android:alpha="0.8"/>
    </LinearLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
