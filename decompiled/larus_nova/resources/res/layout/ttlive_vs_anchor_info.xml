<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/ttlive_vs_anchor_info_bg"
    android:paddingRight="2dp"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/vs_anchor_avatar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="2dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/vs_anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxLines="1"
        android:maxEms="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/vs_anchor_verify"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/vs_anchor_name"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_name"
        app:layout_constraintTop_toTopOf="@+id/vs_anchor_name"/>
    <com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/marquee_anchor_name_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.common.MarqueeTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/marquee_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/marquee_anchor_verify"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="4dp"/>
    </com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/vs_follow_container"
        android:background="@drawable/ttlive_bg_live_follow_red"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_verify"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/vs_anchor_follow"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="@string/ttlive_follow_label"
            android:maxLines="1"
            android:textAlignment="center"/>
        <ProgressBar
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/vs_follow_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ttlive_follow_botton_progress_bar"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/vs_followed_container"
        android:background="@drawable/ttlive_bg_live_vs_followed"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_verify"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/vs_anchor_followed"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="@string/ttlive_follow_label_success"
            android:maxLines="1"
            android:textAlignment="center"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/vs_fans_container"
        android:layout_width="35dp"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_anchor_verify"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
