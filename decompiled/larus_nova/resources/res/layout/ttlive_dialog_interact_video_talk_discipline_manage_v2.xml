<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/self_discipline_manage_dialog_view"
    android:background="@drawable/ttlive_bg_self_discipline_manage_dialog"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="341dp">
    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="17dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_ic_more_dialog_help"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ttlive_icon_apply_close"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white_90"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_self_discipline_manage_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_white_50"
        android:id="@+id/tv_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ttlive_self_discipline_manage_dialog_sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/self_discipline_target_container"
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub_title">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white_90"
            android:layout_gravity="start"
            android:id="@+id/tv_self_discipline_target_hint"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_self_discipline_theme"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/self_discipline_target_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/self_discipline_duration_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/self_discipline_target_container">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white_90"
            android:layout_gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_self_discipline_target"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_white_50"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_self_discipline_duration_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginEnd="5dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/intro_arrow"
            android:background="@drawable/ttlive_guest_battle_panel_right_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </LinearLayout>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_self_discipline_panel_operation_color"
        android:gravity="center"
        android:id="@+id/btn_operation"
        android:background="@drawable/ttlive_guest_battle_panel_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_self_discipline_manage_dialog_start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
