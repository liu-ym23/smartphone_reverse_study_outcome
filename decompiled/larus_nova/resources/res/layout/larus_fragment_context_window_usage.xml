<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/context_window_root"
    android:paddingTop="?attr/larus_dp_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/context_window_header"
        layout="@layout/larus_layout_context_window_header"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/context_window_scroll"
        android:paddingBottom="?attr/larus_dp_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:fillViewport="false"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/context_window_content"
            android:background="@drawable/larus_bg_context_window_card"
            android:paddingTop="?attr/larus_dp_14"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_24">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/larus_neutral_50"
                    android:id="@+id/context_window_context_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_input_contextWindow"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/larus_neutral_50"
                    android:id="@+id/context_window_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ProgressBar
                    android:id="@+id/context_window_context_loading"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_12"
                    android:layout_height="?attr/larus_dp_12"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="?attr/larus_dp_4"
                    android:indeterminateTint="?attr/larus_primary_50"
                    style="?android:attr/progressBarStyleSmall"/>
            </LinearLayout>
            <com.larus.contextwindow.impl.ui.ContextWindowSegmentedProgressView
                android:id="@+id/context_window_progress"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_6"
                android:layout_marginTop="?attr/larus_dp_8"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/context_window_detail_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:divider="@drawable/larus_divider_context_window_detail_spacing"
                android:showDividers="middle">
                <include
                    android:id="@+id/context_window_messages_row"
                    layout="@layout/larus_item_context_window_usage_detail"/>
                <include
                    android:id="@+id/context_window_system_prompt_row"
                    layout="@layout/larus_item_context_window_usage_detail"/>
                <include
                    android:id="@+id/context_window_tools_row"
                    layout="@layout/larus_item_context_window_usage_detail"/>
                <include
                    android:id="@+id/context_window_skills_row"
                    layout="@layout/larus_item_context_window_usage_detail"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/context_window_membership_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="?attr/larus_neutral_transparent_1"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_1"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:layout_marginBottom="?attr/larus_dp_16"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/context_window_membership_header"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_24"
                    android:importantForAccessibility="yes">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/context_window_membership_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_input_contextWindow_member"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:fontFamily="sans-serif-medium"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/context_window_membership_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="?attr/larus_dp_24"
                        android:importantForAccessibility="noHideDescendants"
                        android:paddingStart="?attr/larus_dp_12"
                        android:paddingEnd="0dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="?attr/larus_neutral_50"
                            android:id="@+id/context_window_membership_status_text"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ProgressBar
                            android:id="@+id/context_window_membership_loading"
                            android:visibility="gone"
                            android:layout_width="?attr/larus_dp_12"
                            android:layout_height="?attr/larus_dp_12"
                            android:layout_marginStart="?attr/larus_dp_4"
                            android:indeterminateTint="?attr/larus_primary_50"
                            style="?android:attr/progressBarStyleSmall"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/context_window_membership_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:divider="@drawable/larus_divider_context_window_membership_spacing"
                    android:showDividers="middle"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
