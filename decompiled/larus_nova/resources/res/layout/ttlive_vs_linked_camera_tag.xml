<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/camera_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/camera_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            app:actualImageResource="@drawable/ttlive_icon_multi_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/camera_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/camera_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/paid_tips"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="14dp"
            android:src="@drawable/ttlive_vs_paid_camera"
            android:translationX="17dp"
            android:translationY="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/linked_room_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/linked_image_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/linked_image"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ttlive_game_live_linked_room"
                app:actualImageScaleType="centerCrop"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="end|bottom"
                android:id="@+id/living_view"
                android:tag="living_view"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="9dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/linked_room_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/linked_image_container"
            app:layout_constraintLeft_toRightOf="@+id/linked_image_container"
            app:layout_constraintTop_toTopOf="@+id/linked_image_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
