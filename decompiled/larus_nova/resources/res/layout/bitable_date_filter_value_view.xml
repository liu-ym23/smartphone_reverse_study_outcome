<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_float_base"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/durations_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
            android:orientation="vertical"
            android:id="@+id/durations_group_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_kit_len_16"
            style="@style/BitableSettingGroupLayoutStyle"/>
    </androidx.core.widget.NestedScrollView>
    <com.larksuite.component.universe_design.timepicker.UDTimePicker
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/date_picker_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ud_timePicker_datePickerMode="yearMonthDay"
        app:ud_timePicker_itemVisibleNum="5"/>
</FrameLayout>
