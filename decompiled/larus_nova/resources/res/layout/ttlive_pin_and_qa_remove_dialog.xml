<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_message_bottom_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/bottom_dialog_btn_color"
        android:gravity="center"
        android:id="@+id/tv_remove_item"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_remove_pin_content_item"/>
    <View
        android:background="#161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0.05"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_link_text_color"
        android:gravity="center"
        android:id="@+id/tv_remove_all"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_remove_pin_content_all"/>
    <View
        android:background="#161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:alpha="0.05"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_link_text_color"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_text_cancel"/>
</LinearLayout>
