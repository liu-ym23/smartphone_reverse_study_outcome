<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <View
            android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
            android:layout_width="147dp"
            android:layout_height="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/life_pdp_head_image_rate_loading_bg_8"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                    <View
                        android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                        android:layout_width="50dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <View
                    android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"/>
                <View
                    android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="70dp"/>
            </LinearLayout>
            <View
                android:background="@drawable/life_pdp_head_image_rate_loading_bg_8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/life_pdp_head_image_rate_loading_bg_8"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                    <View
                        android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                        android:layout_width="50dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <View
                    android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"/>
                <View
                    android:background="@drawable/life_pdp_head_image_rate_loading_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="70dp"/>
            </LinearLayout>
            <View
                android:background="@drawable/life_pdp_head_image_rate_loading_bg_8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/loading_bottom_split"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="#ff161823"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看全部评价"
                android:maxLines="1"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/loading_right_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
