<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_view_pay_type_recommend_layout"
    android:background="?attr/cj_pay_type_recommend_bg"
    android:paddingLeft="@dimen/cj_pay_font_size_16"
    android:paddingTop="20dp"
    android:paddingRight="@dimen/cj_pay_font_size_16"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cj_pay_iv_pay_icon"
        android:visibility="gone"
        android:layout_width="@dimen/cj_pay_font_size_14"
        android:layout_height="@dimen/cj_pay_font_size_14"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_tv_recommend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_tv_recommend"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/cj_pay_text_secondary"
        android:ellipsize="end"
        android:id="@+id/cj_pay_tv_recommend"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="32dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_tv_voucher_msg"
        app:layout_constraintEnd_toStartOf="@+id/cj_pay_use"
        app:layout_constraintStart_toEndOf="@+id/cj_pay_iv_pay_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginRight="32dp"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textSize="11dp"
        android:textColor="?attr/cj_pay_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/cj_pay_tv_voucher_msg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cj_pay_use"
        app:layout_constraintStart_toStartOf="@+id/cj_pay_tv_recommend"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_tv_recommend"
        app:layout_goneMarginRight="32dp"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="?attr/cj_pay_text_secondary"
        android:id="@+id/cj_pay_use"
        android:background="@drawable/cj_pay_bg_border_34161823_radius_4"
        android:paddingLeft="@dimen/cj_pay_padding_12"
        android:paddingTop="@dimen/cj_pay_padding_2"
        android:paddingRight="@dimen/cj_pay_padding_12"
        android:paddingBottom="@dimen/cj_pay_padding_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
