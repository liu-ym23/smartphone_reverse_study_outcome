<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/task_list_member_role_dialog_bg_panel"
        android:layout_width="match_parent"
        android:layout_height="466dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/close_icon"
                android:layout_width="@dimen/sp_24"
                android:layout_height="@dimen/sp_24"
                android:tint="@color/icon_n1"
                android:layout_marginStart="@dimen/dp_16"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_40">
                <TextView
                    android:textSize="@dimen/sp_17"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_TaskSection_SelectASection_Title"/>
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/text_caption"
                    android:gravity="center"
                    android:id="@+id/owned_section_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_New_OwnedByMe_TabTitle"/>
            </LinearLayout>
        </LinearLayout>
        <com.suite.lark.emm.design.edittext.SCEditText
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:id="@+id/search_text"
            android:background="@drawable/detail_task_list_search_bg"
            android:paddingTop="@dimen/dp_9"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/Todo_SearchSection_Placeholder"
            android:singleLine="true"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/ud_icon_search_outlined"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/section_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"/>
    </LinearLayout>
</LinearLayout>
