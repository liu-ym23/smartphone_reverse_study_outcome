<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_bg_white_radius_2dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/tv_coupon_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_coupon_grow_ago"
        android:background="@drawable/ec_bg_coupon_grow"
        android:layout_width="69dp"
        android:layout_height="83dp"
        android:layout_marginStart="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/ec_rmb_symbol"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/tv_grow_ago_coupon_num"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grow_ago_coupon_info"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="1dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_ago_coupon_prefix"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_grow_ago_coupon_prefix"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/ec_base_coupon"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_coupon_grow_after"
        android:background="@drawable/ec_bg_coupon_grow"
        android:layout_width="78dp"
        android:layout_height="94dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_title">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ec_rmb_symbol"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/tv_grow_after_coupon_num"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grow_after_coupon_info"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="1dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_after_coupon_prefix"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_grow_after_coupon_prefix"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="@string/ec_grow_coupon"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_width="26dp"
        android:layout_height="19dp"
        android:src="@drawable/ec_coupon_grow_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_coupon_grow_after"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/ec_color_1f_161823"
        android:layout_width="280dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_coupon_grow_after"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="280dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/view_line">
        <TextView
            android:textColor="@color/ec_color_black_161823_75"
            android:gravity="center"
            android:id="@+id/tv_ec_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ec_direct_leave"
            android:layout_weight="1"/>
        <View
            android:background="@color/ec_color_1f_161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/ec_color_black_161823"
            android:gravity="center"
            android:id="@+id/tv_ec_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
