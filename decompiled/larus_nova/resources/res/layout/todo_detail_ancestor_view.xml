<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ancestor_status_container"
        android:background="@color/function_danger_fill_solid_02"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp_16">
        <ImageView
            android:id="@+id/ancestor_status_icon"
            android:layout_width="16sp"
            android:layout_height="16sp"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:id="@+id/ancestor_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_ParentTaskDeleted_Text"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_ancestor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/layout_ancestor_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_20"
            layout="@layout/todo_detail_ancestor_item_view"/>
        <include
            android:id="@+id/layout_ancestor_2"
            android:visibility="gone"
            layout="@layout/todo_detail_ancestor_item_view"/>
        <include
            android:id="@+id/layout_ancestor_3"
            android:visibility="gone"
            layout="@layout/todo_detail_ancestor_item_view"/>
        <include
            android:id="@+id/layout_ancestor_4"
            android:visibility="gone"
            layout="@layout/todo_detail_ancestor_item_view"/>
    </LinearLayout>
</LinearLayout>
