<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/store_product_card"
    android:background="@color/shopping_std_bg_primary_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="6dp">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="136dp"
        android:layout_height="136dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/ec_shop_product_placeholder_color"
                app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/window_product_card_image_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/shopping_std_bg_black_1"
                app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
            <FrameLayout
                android:id="@+id/ec_shop_tag_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_tag_watch_play_back"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:layoutMode="width_self_adjust"
                    app:placeholderImage="@drawable/ec_shop_ic_inner_flow_play_back"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_video_watch_explain"
                    android:paddingStart="1dp"/>
            </LinearLayout>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">
        <com.bytedance.android.ec.window.base.widget.WindowBreakWordTextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="end"
            android:layout_gravity="left"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"/>
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/ec_window_product_card_info_price"/>
            <include
                android:textSize="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                layout="@layout/ec_window_product_card_info_taglist"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
