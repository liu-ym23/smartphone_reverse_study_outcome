<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/included_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textColor="@color/tools_std_const_text_inverse"
        android:gravity="start|center_vertical"
        android:layout_gravity="end|bottom"
        android:id="@+id/duration_view"
        android:background="@null"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@color/s6_60"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:importantForAccessibility="no"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:ts_enable_text_color="false"
        style="@style/tools_font_size_24"/>
    <View
        android:id="@+id/shadow_view"
        android:background="@color/larus_tools_media_item_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/fl_image_select_indicator"
        android:background="@drawable/larus_tools_media_import_bg_media_select_indicator"
        android:layout_width="64dp"
        android:layout_height="64dp">
        <com.ss.android.ugc.tools.view.style.StyleTextView
            android:textColor="@color/tools_std_const_text_inverse"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/image_select_indicator"
            android:background="@drawable/larus_tools_media_import_bg_image_select"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"
            app:ts_enable_text_color="false"
            style="@style/tools_font_size_30"/>
    </FrameLayout>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textStyle="bold"
        android:textColor="@color/tools_std_text_reverse_2"
        android:gravity="center"
        android:id="@+id/txt_multi_selected"
        android:background="@drawable/larus_tools_media_import_bg_multi_selected"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="6dp"
        android:text="@string/larus_album_select_btn"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginStart="4dp"
        app:ts_enable_text_color="false"
        style="@style/tools_font_size_20"/>
</FrameLayout>
