<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_red"
            android:layout_width="190dp"
            android:layout_height="26dp"
            android:alpha="0.05"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
            android:layout_width="59dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"/>
    <View
        android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
        android:layout_width="160dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"/>
    <View
        android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp">
        <View
            android:id="@+id/view"
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
            android:layout_width="30dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/view2"
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/view"/>
        <View
            android:id="@+id/view3"
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/view2"/>
        <View
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_grey"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/view3"/>
        <View
            android:id="@+id/view4"
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_red_half_radius_left"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:alpha="0.05"
            app:layout_constraintEnd_toStartOf="@+id/view5"/>
        <View
            android:id="@+id/view5"
            android:background="@drawable/ec_feed_product_detail_card_skeleton_bg_red_half_radius"
            android:layout_width="101dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
