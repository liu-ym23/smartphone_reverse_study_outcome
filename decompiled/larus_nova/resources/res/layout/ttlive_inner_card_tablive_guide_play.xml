<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_inner_tablive_guide_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="#bfffffff"
        android:id="@+id/tablive_guide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:text="直播频道·可能感兴趣"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/often_living_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="你常看的n人正在直播"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablive_guide_title"/>
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/dislike_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/often_living_sub_title">
        <FrameLayout
            android:background="@drawable/ttlive_inner_tablive_guide_mask_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/often_skylight_recyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:layout_marginStart="18dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/dislike_button"
        android:background="@drawable/ttlive_inner_tablive_guide_dislike_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="30dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/slide_up_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.44">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="不感兴趣"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/goto_see_button"
        android:background="@drawable/ttlive_inner_tablive_guide_look_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/slide_up_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.44">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去看看"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/slide_up_container"
        android:layout_width="match_parent"
        android:layout_height="41dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_inner_tablive_guide_slide_up"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#57ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上滑继续看"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/gesture_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
