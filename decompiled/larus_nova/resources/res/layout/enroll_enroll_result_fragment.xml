<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.bmhome.view.NovaTitleBarEx
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/result_guideline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintGuide_begin="96dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guide_page"
            android:background="@color/enroll_transparent"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/result_guideline">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/guide_content_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/result_hint_section"
                    android:background="@color/enroll_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/page_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/dp_26"
                        android:textColor="?attr/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/page_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_21"
                        android:text="@string/enroll_record_completed"
                        android:lines="1"
                        android:fontFamily="sans-serif-medium"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="?attr/larus_neutral_70"
                        android:gravity="center"
                        android:id="@+id/page_tips"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/enroll_failed_tips_record_again"
                        android:lines="2"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_62"
                    android:layout_marginBottom="@dimen/dp_91"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.larus.common_ui.venus.ShapeButton
                        android:textSize="?attr/larus_sp_17"
                        android:textColor="?attr/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/know_button"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_338"
                        android:layout_height="@dimen/dp_52"
                        android:text="@string/enroll_enroll_know"
                        app:larus_sb_cornerRadius="@dimen/dp_16"
                        app:larus_sb_fillColor="?attr/larus_neutral_50"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.larus.common_ui.venus.ShapeButton
                        android:textSize="?attr/larus_sp_17"
                        android:textColor="?attr/larus_static_white"
                        android:gravity="center"
                        android:id="@+id/finish_button"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_338"
                        android:layout_height="@dimen/dp_52"
                        android:text="@string/enroll_enroll_done"
                        app:larus_sb_cornerRadius="@dimen/dp_16"
                        app:larus_sb_fillColor="?attr/larus_primary_50"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
