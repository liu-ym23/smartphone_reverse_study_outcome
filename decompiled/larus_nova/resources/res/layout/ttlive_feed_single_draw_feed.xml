<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_feed_single_drawer_background"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/single_drawer_top_container"
        android:paddingTop="30dp"
        android:paddingBottom="15dp"
        android:layout_width="112dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/single_drawer_top_action_container"
            android:background="@drawable/ttlive_bg_single_draw_top_action"
            android:layout_width="89dp"
            android:layout_height="32dp">
            <ImageView
                android:id="@+id/single_drawer_search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_feed_ic_searshbar_search"
                android:layout_centerInParent="true"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ttlive_bg_single_draw_top_slipe"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/single_drawer_history_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_ic_searshbar_history"/>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/single_drawer_yellow_point"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/ttlive_bg_yellow_point"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/single_drawer_tab_recom_container"
            android:background="@drawable/ttlive_bg_single_draw_top_recom"
            android:layout_width="80dp"
            android:layout_height="36dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#e5ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/single_drawer_selected_tab_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="35dp"
                android:maxLines="1"
                android:layout_marginStart="19dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="54dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/single_drawer_selected_top_up_ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ttlive_feed_ic_single_draw_top_up"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/single_drawer_selected_top_down_ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ttlive_feed_ic_single_draw_top_down"
                    android:layout_marginStart="5dp"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/single_drawer_recyclerview_container_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.livesdk.chatroom.ui.pullrefresh.DoubleBallSwipeRefreshLayout
                android:id="@+id/single_drawer_recyclerview_layout_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.live.ui.FadingEdgeRecyclerview
                    android:id="@+id/single_drawer_recyclerview_room"
                    android:fadingEdgeLength="35dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:requiresFadingEdge="vertical"/>
            </com.bytedance.android.livesdk.chatroom.ui.pullrefresh.DoubleBallSwipeRefreshLayout>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/single_draw_login_layout"
            android:background="@drawable/ttlive_feed_single_drawer_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="13dp"
                android:textColor="#ff77787f"
                android:id="@+id/single_draw_login_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/ttlive_feed_single_not_login"
                app:layout_constraintBottom_toTopOf="@+id/single_draw_login_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textStyle="bold"
                android:textColor="#e5ffffff"
                android:gravity="center"
                android:id="@+id/single_draw_login_button"
                android:background="@drawable/ttlive_bg_single_drawer_login_button"
                android:layout_width="68dp"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_feed_single_login"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/single_drawer_recyclerview_tab_container"
            android:background="@drawable/ttlive_feed_single_drawer_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.ui.FadingEdgeRecyclerview
                android:id="@+id/single_drawer_recyclerview_tab"
                android:fadingEdgeLength="35dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="22dp"
                android:requiresFadingEdge="vertical"
                app:layout_constraintBottom_toTopOf="@+id/single_drawer_top_action_container_bottom"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/single_drawer_top_action_container_bottom"
                android:background="@drawable/ttlive_bg_single_draw_top_action"
                android:layout_width="89dp"
                android:layout_height="32dp"
                android:layout_marginBottom="44dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <ImageView
                    android:id="@+id/single_drawer_search_icon_bottom"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_feed_ic_searshbar_search"
                    android:layout_centerInParent="true"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ttlive_bg_single_draw_top_slipe"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/single_drawer_history_icon_bottom"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ttlive_ic_searshbar_history"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/single_drawer_yellow_point_bottom"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:src="@drawable/ttlive_bg_yellow_point"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</LinearLayout>
