<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ec_commerce_ll_kol_view_whole"
    android:layout_width="match_parent"
    android:layout_height="106dp">
    <FrameLayout
        android:layout_width="106dp"
        android:layout_height="106dp">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.MediaBoxElementView
            android:id="@+id/anchor_v4_kol_review_media"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/anchor_v4_kol_review_bottom_mask"
            android:background="@drawable/ec_commerce_kol_review_shader"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v4_kol_type_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:layout_gravity="top|right"
            android:id="@+id/anchor_v4_kol_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_weight="1">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
            android:layout_gravity="top|right"
            android:id="@+id/anchor_v4_kol_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|left"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_kol_user"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
                android:id="@+id/anchor_v4_kol_follow_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
