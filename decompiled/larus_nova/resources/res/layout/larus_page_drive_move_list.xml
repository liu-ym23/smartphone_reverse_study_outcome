<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/static_black_transparent_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_drive_move_list_panel"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/larus_drive_move_list_panel_title_bar"
            android:background="@drawable/larus_bg_drive_upload_list_panel"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            app:layout_constraintBottom_toTopOf="@+id/larus_drive_move_list_container">
            <ImageView
                android:id="@+id/larus_drive_move_list_panel_back_btn"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_drive_move_back"
                android:contentDescription="@null"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/larus_drive_move_list_panel_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_drive_move_header"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="?attr/larus_dp_8"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/larus_drive_move_list_panel_close_btn"
                app:layout_constraintStart_toEndOf="@+id/larus_drive_move_list_panel_back_btn"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/larus_drive_move_list_panel_close_btn"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_drive_move_close"
                android:contentDescription="@null"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/larus_drive_move_list_container"
            android:background="@color/larus_base_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/larus_drive_move_bottom_area"/>
        <FrameLayout
            android:id="@+id/larus_drive_move_bottom_area"
            android:background="@color/larus_base_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:layout_gravity="top"
                android:background="@color/larus_neutral_transparent_1"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_1"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:id="@+id/larus_drive_move_confirm_btn"
                android:background="@drawable/larus_bg_drive_move_button"
                android:layout_width="?attr/larus_dp_96"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:text="@string/larus_drive_move_btn"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
