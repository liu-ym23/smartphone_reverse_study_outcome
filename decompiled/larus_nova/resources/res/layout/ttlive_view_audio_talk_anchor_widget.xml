<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="116dp">
    <View
        android:id="@+id/stub"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_avatar_view"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/radio_effect"
        app:layout_constraintEnd_toEndOf="@+id/radio_effect"
        app:layout_constraintStart_toStartOf="@+id/radio_effect"
        app:layout_constraintTop_toTopOf="@+id/radio_effect"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/ttlive_anchor_avatar_border"
        android:background="@drawable/ttlive_bg_team_fight_blue_team_avatar_border_anchor"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/radio_effect"
        app:layout_constraintEnd_toEndOf="@+id/radio_effect"
        app:layout_constraintStart_toStartOf="@+id/radio_effect"
        app:layout_constraintTop_toTopOf="@+id/radio_effect"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/radio_effect"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/ttlive_avatar_right_top_widget_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:translationX="30dp"
        android:translationY="-30dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_right_top_widget"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:maxEms="8"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_avatar_view"/>
    <com.bytedance.android.live.ui.LinkGuestSendGiftView
        android:id="@+id/link_guest_fans_ticket_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
        android:id="@+id/guest_seat_linkmic_quick_interact"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
        android:id="@+id/team_fight_score_view"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
        android:id="@+id/ttlive_themed_competition_score"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <com.bytedance.android.livesdk.common.AnchorPauseTipsView
        android:id="@+id/pause_tip_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toTopOf="@+id/ttlive_avatar_view"/>
    <com.bytedance.android.live.liveinteract.view.PositionNameTv
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_position_name"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="4"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"/>
    <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pos_tag_label"
        android:background="@drawable/ttllive_audio_talk_seat_host_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:includeFontPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/guide_avatar_effect"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/guide_anchor_info_left_layout"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_bubble"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintHorizontal_bias="1">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guide_anchor_info_left_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="1dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/guide_anchor_info_left_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="84dp"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/guide_anchor_info_right_layout"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_bubble"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toTopOf="@+id/ttlive_avatar_view">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guide_anchor_info_right_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="1dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/guide_anchor_info_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="84dp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/guide_anchor_description_tv"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_desc"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="238dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.SeatAnimationView
        android:id="@+id/seat_anim_view"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="@+id/radio_effect"
        app:layout_constraintStart_toStartOf="@+id/radio_effect"
        app:layout_constraintTop_toTopOf="@+id/radio_effect"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.seat.layer.interactivesong.RequestSongMicSeatView
        android:id="@+id/request_song_micseat_view"
        android:layout_width="@dimen/ttlive_voice_chat_guest_seat_effect_extend_size_large"
        android:layout_height="@dimen/ttlive_voice_chat_guest_seat_effect_extend_size_large"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
