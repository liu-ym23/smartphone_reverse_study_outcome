<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_caption"
        android:id="@+id/desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/CreationMobile_SecureLabel_Edit_ModifySubtitle"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/btnLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/cancelBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/Doc_Facade_Cancel"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:ud_backgroundColor="@color/ud_button_white_blue_bg"
                    app:ud_radius="l"
                    app:ud_strokeColor="@color/line_border_component"
                    app:ud_strokeWidth="1dp"
                    style="@style/UDButton.Small.Primary"/>
                <com.larksuite.component.universe_design.button.UDButton
                    android:enabled="true"
                    android:textSize="16sp"
                    android:textColor="@color/static_white"
                    android:id="@+id/doneBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/Doc_List_Filter_Done"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    app:ud_backgroundColor="@color/ud_button_blue_bg"
                    app:ud_radius="l"
                    style="@style/UDButton.Small.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
