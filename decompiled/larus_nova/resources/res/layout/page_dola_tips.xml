<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/dola_tips_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_btn"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/ic_dola_close"/>
    <ImageView
        android:id="@+id/dola_icon"
        android:layout_width="?attr/larus_dp_70"
        android:layout_height="?attr/larus_dp_70"
        android:layout_marginTop="?attr/larus_dp_40"
        android:src="@drawable/dola_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/dola_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_nameChange_bottomsheet_title"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dola_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/dola_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_nameChange_bottomsheet_desc"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dola_title"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/start_with_dola"
        android:background="?attr/ic_dola_button_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_nameChange_bottomsheet_btn"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dola_sub_title"/>
    <View
        android:background="?attr/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_with_dola"/>
</androidx.constraintlayout.widget.ConstraintLayout>
