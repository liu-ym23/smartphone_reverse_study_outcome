<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_ltm_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/top_icon"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="@drawable/larus_icon_chat_ltm_hit_top_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_41"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_1_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_42"
        android:src="@drawable/larus_icon_chat_ltm_hit_1"
        android:layout_marginStart="?attr/larus_dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/item_1_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_42"
        android:text="@string/larus_memory_store_convo_header"
        android:layout_marginStart="?attr/larus_dp_14"
        app:layout_constraintStart_toEndOf="@+id/item_1_icon"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/item_1_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:lineSpacingExtra="?attr/larus_sp_1"
        android:layout_marginStart="?attr/larus_dp_70"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_1_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_2_icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_14"
        android:src="@drawable/larus_icon_chat_ltm_hit_2"
        android:layout_marginStart="?attr/larus_dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_1_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/item_2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_14"
        android:text="@string/larus_memory_smarter_header"
        android:layout_marginStart="?attr/larus_dp_14"
        app:layout_constraintStart_toEndOf="@+id/item_2_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_1_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/item_2_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:lineSpacingExtra="?attr/larus_sp_1"
        android:layout_marginStart="?attr/larus_dp_70"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_2_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_3_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_14"
        android:src="@drawable/larus_icon_chat_ltm_hit_3"
        android:layout_marginStart="?attr/larus_dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_2_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/item_3_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_14"
        android:text="@string/larus_memory_set_preference_header"
        android:layout_marginStart="?attr/larus_dp_14"
        app:layout_constraintStart_toEndOf="@+id/item_2_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_2_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/item_3_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:text="@string/larus_memory_set_preference_description"
        android:lineSpacingExtra="?attr/larus_sp_1"
        android:layout_marginStart="?attr/larus_dp_70"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_3_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/left_know"
        android:background="@drawable/larus_bg_ltm_hit_left"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_54"
        android:text="@string/larus_got_it_btn"
        android:paddingStart="?attr/larus_dp_57"
        android:paddingEnd="?attr/larus_dp_57"
        android:layout_marginStart="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_3_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/right_go_settings"
        android:background="@drawable/larus_bg_ltm_hit_right"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_54"
        android:text="@string/larus_set_up_btn"
        android:paddingStart="?attr/larus_dp_57"
        android:paddingEnd="?attr/larus_dp_57"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_know"
        app:layout_constraintTop_toBottomOf="@+id/item_3_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
