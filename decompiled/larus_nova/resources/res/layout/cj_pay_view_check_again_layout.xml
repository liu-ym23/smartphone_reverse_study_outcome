<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="375dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ll_title_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_back_view"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_round_close"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_title_icon"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
            android:gravity="center"
            android:id="@+id/cj_pay_check_again_left_btn"
            android:background="@drawable/cj_pay_bg_0d161823_btn_radis_8"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_check_again_right_btn"
            android:background="@drawable/cj_pay_bg_fe2c55_btn_radis_8"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
