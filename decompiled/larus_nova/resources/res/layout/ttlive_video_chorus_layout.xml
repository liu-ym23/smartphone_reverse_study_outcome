<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.ktvimpl.realtimechorus.VerticalDragFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:id="@+id/video_chorus_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/video_chorus_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/chorus_midi_root"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/ttlive_video_chorus_midi_container_width"
            android:layout_height="72dp"
            android:layout_marginRight="11dp">
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/midi_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/ttlive_video_chorus_midi_container_width"
                android:layout_height="@dimen/ttlive_ktv_video_chorus_midi_height"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/lyric_container"
            android:layout_width="@dimen/ttlive_video_chorus_lyric_container_width"
            android:layout_height="@dimen/ttlive_ktv_video_chorus_lyric_height"
            android:layout_marginTop="10dp"
            android:layout_marginRight="11dp"/>
        <FrameLayout
            android:id="@+id/video_chorus_lynx_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_ktv_video_chorus_lynx_height"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</com.bytedance.android.livesdk.ktvimpl.realtimechorus.VerticalDragFrameLayout>
