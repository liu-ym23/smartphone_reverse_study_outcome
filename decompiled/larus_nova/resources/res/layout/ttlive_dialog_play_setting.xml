<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg_border"
        android:background="@drawable/ttlive_bg_broadcast_more_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/setting_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/more_dialog_title"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#b3ffffff"
        android:id="@+id/more_dialog_title"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_toolbar_play_setting"
        android:contentDescription="设置 标题"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setting_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/more_dialog_title">
        <View
            android:background="@color/ttlive_play_setting_dividing_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_play_setting_divider_line_height"/>
        <RelativeLayout
            android:id="@+id/allow_receive_gift"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="15dp"
                android:textColor="#e6ffffff"
                android:id="@+id/allow_receive_gift_title"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginTop="13dp"
                android:text="@string/ttlive_allow_receive_gift_title"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/allow_receive_gift_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_marginTop="25dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80ffffff"
                android:id="@+id/allow_receive_gift_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ttlive_allow_receive_gift_valid_desc"
                android:layout_below="@+id/allow_receive_gift_title"/>
            <RelativeLayout
                android:id="@+id/allow_receive_invalid_layout"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/allow_receive_gift_title">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80ffffff"
                    android:id="@+id/allow_receive_invalid_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ttlive_allow_receive_gift_invalid_desc"/>
                <LinearLayout
                    android:id="@+id/verify_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_toRightOf="@+id/allow_receive_invalid_desc">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#ecc316"
                        android:id="@+id/allow_receive_verify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_allow_receive_gift_verify"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ttlive_audience_verify_arrow"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/allow_anchor_see_history_about_me"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#e6ffffff"
                android:id="@+id/allow_anchor_see_history_about_me_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginRight="85dp"
                android:text="@string/ttlive_anchor_see_history_about_me_title"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/allow_anchor_see_history_about_me_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="85dp"
                android:text="@string/ttlive_anchor_see_history_about_me_desc"
                android:layout_below="@+id/allow_anchor_see_history_about_me_title"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
