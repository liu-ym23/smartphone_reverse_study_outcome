<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/file_icon_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oval="false"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/preview_video_bg"
        android:layout_width="40dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/file_icon_iv"
        app:layout_constraintEnd_toEndOf="@+id/file_icon_iv"
        app:layout_constraintStart_toStartOf="@+id/file_icon_iv"
        app:srcCompat="@drawable/video_preview_list_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/preview_video_play_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/file_icon_iv"
        app:layout_constraintEnd_toEndOf="@+id/file_icon_iv"
        app:srcCompat="@drawable/ud_icon_video_filled"
        app:tint="@color/static_white"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:ellipsize="middle"
        android:id="@+id/file_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/file_icon_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/file_subtitle_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/file_title_tv"
        app:layout_constraintStart_toStartOf="@+id/file_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/file_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
