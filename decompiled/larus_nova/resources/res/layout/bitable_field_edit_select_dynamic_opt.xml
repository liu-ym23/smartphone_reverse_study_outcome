<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_SingleOption_SubsetSettingsTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/optionSelectTableLayout"
            android:background="@drawable/facade_round_top_xl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_48"
            android:paddingStart="@dimen/space_kit_len_16"
            android:paddingEnd="@dimen/space_kit_len_16"
            android:backgroundTint="@color/facade_selector_item_float">
            <TextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/ud_title_color"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_SingleOption_TargetTable_Mobile"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/tableSelectWarningIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/space_kit_len_18"
                    android:layout_height="@dimen/space_kit_len_18"
                    android:layout_marginLeft="5dp"
                    app:srcCompat="@drawable/ud_icon_warning_colorful"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/bitalbe_field_placeholder_color_with_disabled"
                    android:ellipsize="end"
                    android:id="@+id/tableSelectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/Bitable_Field_Select"
                    android:singleLine="true"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/optionSelectFieldLayout"
            android:background="@drawable/facade_round_bottom_xl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_48"
            android:paddingStart="@dimen/space_kit_len_16"
            android:paddingEnd="@dimen/space_kit_len_16"
            android:backgroundTint="@color/facade_selector_item_float">
            <TextView
                android:enabled="false"
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/bitable_field_titlecolor_with_disable"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_SingleOption_TargetField_Mobile"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/fieldSelectWarningIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/space_kit_len_18"
                    android:layout_height="@dimen/space_kit_len_18"
                    android:layout_marginLeft="5dp"
                    app:srcCompat="@drawable/ud_icon_warning_colorful"/>
                <TextView
                    android:enabled="false"
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/bitalbe_field_placeholder_color_with_disabled"
                    android:ellipsize="end"
                    android:id="@+id/fieldSelectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/Bitable_Field_Select"
                    android:singleLine="true"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_SingleOption_SubsetCondition"/>
    <ViewSwitcher
        android:id="@+id/conditionSwitcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.filter.view.FilterConjunctionView
                android:id="@+id/conjunctionView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <com.bytedance.ee.bear.bitable.common.widgets.conditioncard.ConditionListView
                android:id="@+id/conditionContainerLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/addNewRuleBtn"
                android:background="@drawable/facade_round_around_xl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:layout_marginBottom="@dimen/space_kit_len_16"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16"
                android:backgroundTint="@color/facade_selector_item_float">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/addBtnIcon"
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    android:tint="@color/bitable_field_primary_pri_500_with_disableed"
                    app:srcCompat="@drawable/ud_icon_add_outlined"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/bitable_field_primary_pri_500_with_disableed"
                    android:ellipsize="end"
                    android:id="@+id/addBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_SingleOption_AddCondition_Mobile"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/space_kit_len_12"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/facade_round_around_xl"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_kit_len_16"
            android:backgroundTint="@color/facade_selector_item_float">
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_SingleOption_UnableToViewConditionSetting_Mobile"/>
        </LinearLayout>
    </ViewSwitcher>
</merge>
