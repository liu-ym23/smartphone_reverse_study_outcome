<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_payment_tool_root_view"
    android:background="@drawable/cj_pay_bg_card_container"
    android:paddingBottom="6dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/cj_pay_method_card_bg_layout"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="1dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#80161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
        android:id="@+id/cj_pay_method_able_container"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
</LinearLayout>
