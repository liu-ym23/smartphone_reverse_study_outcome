<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/photo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/photo_image_container"
                android:layout_width="?attr/larus_dp_84"
                android:layout_height="?attr/larus_dp_84"
                app:cardCornerRadius="?attr/larus_dp_8"
                app:cardElevation="?attr/larus_dp_0">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="?attr/larus_base_2_overlay"
                    app:roundedCornerRadius="?attr/larus_dp_8"/>
                <View
                    android:id="@+id/image_border"
                    android:background="?attr/larus_bg_resource_success_border"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end"
                android:id="@+id/button_close_photo"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_6"
                android:layout_width="?attr/larus_dp_30"
                android:layout_height="?attr/larus_dp_30"
                android:paddingStart="?attr/larus_dp_6"
                android:paddingEnd="?attr/larus_dp_4"
                app:srcCompat="@drawable/larus_resource_item_remove"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/file_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:paddingTop="?attr/larus_dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="?attr/larus_dp_4">
                <RelativeLayout
                    android:background="?attr/larus_bg_send_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="?attr/larus_dp_12">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/file_icon_container"
                        android:background="@color/larus_static_white"
                        android:layout_width="?attr/larus_dp_36"
                        android:layout_height="?attr/larus_dp_36"
                        android:layout_marginTop="?attr/larus_dp_10"
                        android:layout_marginBottom="?attr/larus_dp_10"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="?attr/larus_dp_8"
                        app:cardElevation="?attr/larus_dp_0">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@+id/file_icon_view"
                            android:layout_width="?attr/larus_dp_24"
                            android:layout_height="?attr/larus_dp_24"/>
                    </androidx.cardview.widget.CardView>
                    <com.larus.bmhome.view.FileNameView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_100"
                        android:id="@+id/file_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="?attr/larus_dp_252"
                        android:minWidth="?attr/larus_dp_78"
                        android:maxLines="2"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="?attr/larus_dp_8"
                        android:layout_marginEnd="?attr/larus_dp_20"
                        android:layout_toEndOf="@+id/file_icon_container"/>
                </RelativeLayout>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end"
                android:id="@+id/button_close_file"
                android:paddingTop="?attr/larus_dp_8"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="?attr/larus_dp_30"
                android:layout_height="?attr/larus_dp_30"
                android:layout_marginTop="?attr/larus_dp_8"
                android:paddingStart="?attr/larus_dp_4"
                android:paddingEnd="?attr/larus_dp_8"
                app:srcCompat="@drawable/larus_ic_close_attachment"/>
        </FrameLayout>
    </LinearLayout>
</merge>
