<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_album_thumbnail"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/closeIcon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_margin="?attr/larus_dp_10"
            android:src="@drawable/larus_ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_album_pending_media_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/primary_50"
            android:gravity="center"
            android:id="@+id/select_all"
            android:paddingLeft="?attr/larus_dp_20"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_20"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_album_deselect_all_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/sync_number"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_58"
        android:drawableLeft="@drawable/larus_ic_album_real_sync"
        android:drawablePadding="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/album_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_4"
        android:nestedScrollingEnabled="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintTop_toBottomOf="@+id/sync_number"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_72"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/delete_btn"
            android:paddingLeft="?attr/larus_dp_10"
            android:paddingRight="?attr/larus_dp_10"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/deleteIcon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_icon_delete"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/neutral_100"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/delete_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_album_delete_cn"
                android:layout_marginStart="?attr/larus_dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/deleteIcon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/start_sync"
            android:background="@drawable/larus_button_sync_bg"
            android:paddingLeft="?attr/larus_dp_20"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_20"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="?attr/larus_dp_252"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_dora_album_start_sync_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
