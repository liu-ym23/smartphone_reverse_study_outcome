<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="46dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_identity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_userName"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:maxEms="8"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_identity"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_interact_follow_you"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/tv_userName"
        app:layout_constraintTop_toBottomOf="@+id/tv_identity"/>
    <Button
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/btn_follow"
        android:background="@drawable/ttlive_btn_follow"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="63dp"
        android:layout_height="28dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="16dp"
        android:minWidth="63dp"
        android:text="@string/ttlive_interact_follow_back"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
