<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/field_wrapper"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:id="@+id/marginLeftPlaceholder"
            android:layout_width="36dp"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/field_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.6sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/udtoken_tag_text_s_indigo"
            android:gravity="top|center_horizontal"
            android:id="@+id/field_tag"
            android:background="@drawable/bitable_grid_field_tag_ai"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:lines="1"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.6sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/desc_icon"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"
            android:tint="@color/icon_n2"
            app:srcCompat="@drawable/ud_icon_info_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/warning_icon"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"
            app:srcCompat="@drawable/ud_icon_warning_colorful"/>
        <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
            android:id="@+id/loading_icon"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
</FrameLayout>
