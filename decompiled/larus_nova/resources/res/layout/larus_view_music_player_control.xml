<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_previous_song"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/larus_ic_music_player_detail_previous_song_disable"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/btn_pause"
        app:layout_constraintEnd_toStartOf="@+id/btn_pause"
        app:layout_constraintTop_toTopOf="@+id/btn_pause"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_pause"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_music_player_detail_pause"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_play"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_music_player_detail_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_next_song"
        android:padding="?attr/larus_dp_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/larus_ic_music_player_detail_next_song_disable"
        android:layout_marginStart="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/btn_pause"
        app:layout_constraintStart_toEndOf="@+id/btn_pause"
        app:layout_constraintTop_toTopOf="@+id/btn_pause"/>
</androidx.constraintlayout.widget.ConstraintLayout>
