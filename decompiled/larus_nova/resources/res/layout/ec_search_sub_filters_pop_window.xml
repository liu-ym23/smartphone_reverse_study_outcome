<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:background="@color/BGPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.ugc.aweme.search.filter.view.MaxHeightRecyclerView
        android:id="@+id/sub_filters_container"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:adjustViewBounds="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/divider"
        android:background="@color/LinePrimary"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_filters_container"/>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/TextPrimary"
        android:gravity="center"
        android:id="@+id/reset"
        android:background="@color/BGInput"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/search_clear"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/sub_filters_container"
        app:layout_constraintRight_toLeftOf="@+id/text_gap"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <View
        android:id="@+id/text_gap"
        android:layout_width="8dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reset"
        app:layout_constraintLeft_toRightOf="@+id/reset"
        app:layout_constraintRight_toLeftOf="@+id/examine_new_result_background"
        app:layout_constraintTop_toTopOf="@+id/reset"/>
    <com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView
        android:gravity="center"
        android:id="@+id/examine_new_result_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/text_gap"
        app:layout_constraintRight_toRightOf="@+id/sub_filters_container"
        app:layout_constraintTop_toTopOf="@+id/reset">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/examine_new_result"
            android:background="@color/Primary"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_examine_new_result"
            app:layout_constraintLeft_toRightOf="@+id/text_gap"
            app:layout_constraintRight_toRightOf="@+id/sub_filters_container"
            app:layout_constraintTop_toTopOf="@+id/reset"/>
    </com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView>
</androidx.constraintlayout.widget.ConstraintLayout>
