<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/keyboard_toolbar_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/bitable_cell_edit_panel_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_16"/>
    <RelativeLayout
        android:id="@+id/keyboard_toolbar_view"
        android:background="@color/bg_float"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_44">
        <View
            android:id="@+id/keyboard_toolbar_divider"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/bitable_cell_edit_panel_text_color"
            android:gravity="center"
            android:id="@+id/keyboard_toolbar_done_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Bitable_Common_ButtonDone"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/space_kit_len_16"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
        android:id="@+id/keyboard_placeholder_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
