<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:paddingBottom="15dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_talk_room_emoji_dialog_interact_title"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/img_avatar"
            android:background="@drawable/ttlive_profile_avatar_bg_oval_black"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:actualImageScaleType="fitCenter"
            app:overlayImage="@drawable/ttlive_profile_avatar_overlay_mask"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/bullet_color_161823"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="58dp"/>
        <com.bytedance.android.live.liveinteract.view.GuestHonorView
            android:id="@+id/view_guest_honor"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="58dp"/>
        <LinearLayout
            android:gravity="top"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="#7f000000"
                android:id="@+id/tv_setting"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_settings"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/divider"
                android:background="#7f000000"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#7f000000"
                android:id="@+id/tv_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_audio_disconnect"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#7f000000"
                android:id="@+id/tv_paid_count_down"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:minWidth="40dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#7f000000"
            android:layout_gravity="end"
            android:id="@+id/tv_set_position_name"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_edit_linkmic_set_position_name"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/banner_container"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/talk_room_action_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_action_list"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner_container"/>
    <View
        android:id="@+id/guide_line"
        android:background="#11000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_action_list"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#525252"
        android:gravity="center"
        android:id="@+id/empty_list_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:text="@string/ttlive_talk_room_emoji_list_error_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/list_loading_webp_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_emoji_list"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <com.bytedance.android.uicomponent.button.UIButton
        android:textSize="15dp"
        android:textColor="@color/ttlive_voice_chat_pre_online_apply_text_color"
        android:id="@+id/preOnlineApplyBtn"
        android:background="@drawable/ttlive_voice_chat_pre_online_apply_bg_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pager_bottom_shower"
        style="@style/uicomponent_button_base_style_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
