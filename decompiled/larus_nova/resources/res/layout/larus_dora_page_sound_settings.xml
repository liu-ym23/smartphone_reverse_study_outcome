<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scroll_view"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_8"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="?attr/larus_dp_12"
            android:paddingEnd="?attr/larus_dp_12">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="?attr/larus_dp_56"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/dora_sound_ambient_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_sound_ambient_volume_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dora_sound_ambient_volume_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/dora_sound_ambient_volume_switch"
                        android:background="@drawable/larus_bg_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_sound_ambient_volume_adaptive_cn"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/dora_sound_ambient_snr_group"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:paddingLeft="?attr/larus_dp_8"
                            android:paddingRight="?attr/larus_dp_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.larus.bmhome.view.item.ItemGroupTitle
                                android:layout_gravity="start|center_vertical"
                                android:id="@+id/dora_sound_ambient_snr_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SNR"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="?attr/larus_sp_13"
                                android:textColor="@color/larus_neutral_70"
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/dora_sound_ambient_snr_progress_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"/>
                        </FrameLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:paddingLeft="?attr/larus_dp_8"
                            android:paddingRight="?attr/larus_dp_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="?attr/larus_sp_13"
                                android:textColor="@color/larus_neutral_50"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/dora_sound_ambient_snr_left_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"/>
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp">
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="5"/>
                                    <View
                                        android:layout_gravity="center_vertical"
                                        android:background="@drawable/larus_bg_shape_dora_speak_voice"
                                        android:layout_width="?attr/larus_dp_3"
                                        android:layout_height="?attr/larus_dp_10"
                                        android:layout_marginRight="?attr/larus_dp_33"/>
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="7"/>
                                </LinearLayout>
                                <SeekBar
                                    android:id="@+id/dora_sound_ambient_snr_progress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="?attr/larus_dp_8"
                                    android:max="12"
                                    android:progress="5"
                                    android:progressDrawable="@drawable/larus_voice_general_progress"
                                    android:layout_weight="1"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    style="@style/larus_mix_seekbar_style"/>
                            </RelativeLayout>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="?attr/larus_sp_13"
                                android:textColor="@color/larus_neutral_50"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/dora_sound_ambient_snr_right_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.larus.bmhome.view.item.ItemGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dora_multi_devices_switch_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_sound_ambient_volume_adaptive_tips_cn"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <View
                    android:id="@+id/dora_sound_ambient_interval"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_12"/>
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/sound_cuetone_volume"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_sound_cuetone_volume_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dora_sound_assistant_volume_group"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingLeft="?attr/larus_dp_8"
                        android:paddingRight="?attr/larus_dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/voice_left_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/larus_voice_left_subtract"/>
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp">
                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="4"/>
                                <View
                                    android:layout_gravity="center_vertical"
                                    android:background="@drawable/larus_bg_shape_dora_speak_voice"
                                    android:layout_width="?attr/larus_dp_3"
                                    android:layout_height="?attr/larus_dp_10"
                                    android:layout_marginRight="?attr/larus_dp_33"/>
                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2"/>
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/voice_rate_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="?attr/larus_dp_8"
                                android:max="5"
                                android:progress="4"
                                android:progressDrawable="@drawable/larus_voice_general_progress"
                                android:layout_weight="1"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                style="@style/larus_mix_seekbar_style"/>
                        </RelativeLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/voice_right_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/larus_voice_right_subtract"/>
                    </LinearLayout>
                </com.larus.bmhome.view.item.ItemGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dora_sound_cuetone_volume_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_sound_cuetone_volume_desc"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <View
                    android:id="@+id/dora_sound_anti_leak_interval"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_12"/>
                <com.larus.bmhome.view.item.ItemGroupTitle
                    android:id="@+id/sound_anti_leak_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_antiaudioleak_title_cn"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dorag_anti_sound_leak_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/dorag_anti_sound_leak_switch"
                        android:background="@drawable/larus_bg_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_antiaudioleak_title_cn"/>
                </com.larus.bmhome.view.item.ItemGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dorag_anti_sound_leak_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_antisoundleak_button_cn"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/dora_page_mask"
            android:background="@color/larus_dora_page_mask_color"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
