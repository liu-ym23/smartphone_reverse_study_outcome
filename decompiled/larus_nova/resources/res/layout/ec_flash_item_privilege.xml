<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="14.5dp"
    android:paddingRight="16dp"
    android:paddingBottom="14.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ec_color_black_161823"
        android:ellipsize="end"
        android:id="@+id/tv_label"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_privilege"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/tv_label"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ui.ec.widget.checkbox.ECCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/cb_privilege"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            app:checkBoxSize="small"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ec_color_black_161823"
            android:id="@+id/tv_privilege_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#57161823"
        android:id="@+id/tv_privilege_submsg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toEndOf="@+id/tv_label"
        app:layout_constraintTop_toBottomOf="@+id/ll_privilege"/>
</androidx.constraintlayout.widget.ConstraintLayout>
