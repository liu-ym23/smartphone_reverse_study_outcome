<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_2"
    android:paddingEnd="?attr/larus_dp_4">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group_title_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/group_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/group_inline_action_container"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_33"
            android:paddingStart="?attr/larus_dp_12"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/group_expand_arrow"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/group_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/group_inline_action"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_26"
                android:layout_height="?attr/larus_dp_14"
                android:src="@drawable/larus_icon_close"
                android:contentDescription="@string/larus_accessibility_icon_close"
                android:paddingEnd="?attr/larus_dp_12"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/group_expand_arrow"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_12"
            android:layout_height="?attr/larus_dp_12"
            android:src="@drawable/larus_ic_text_right_arrow"
            android:contentDescription="@null"
            android:layout_marginStart="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_inline_action_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/group_action"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_dp_11"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/group_red_badge"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:includeFontPadding="false"/>
        <ImageView
            android:id="@+id/group_more"
            android:padding="?attr/larus_dp_9"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="?attr/larus_ic_more_gray"
            android:contentDescription="@string/larus_accessibility_adjustGroup"
            app:tint="?attr/larus_neutral_30"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
