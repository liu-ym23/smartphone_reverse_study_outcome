<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/double_tts_speaker_setting_view"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/old_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_left_back"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tablayout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="@+id/back_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/back_icon"
                app:tabGravity="fill"
                app:tabIndicator="?attr/larus_tab_bottom"
                app:tabIndicatorColor="?attr/larus_neutral_100"
                app:tabIndicatorFullWidth="false"
                app:tabMaxWidth="?attr/larus_dp_200"
                app:tabMinWidth="?attr/larus_dp_10"
                app:tabMode="fixed"
                app:tabPaddingEnd="?attr/larus_dp_16"
                app:tabPaddingStart="?attr/larus_dp_16"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="?attr/larus_neutral_100"
                app:tabTextAppearance="@style/larus_multi_tab_layout"
                app:tabTextColor="?attr/larus_neutral_50"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/old_title_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_bot_voice_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mute_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_voice_unmute"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/new_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/larus_tts_speaker_title_new_style"/>
    </FrameLayout>
    <include
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        layout="@layout/larus_tts_speaker_content_new_style"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <View
        android:id="@+id/create_ugc_voice_btn"
        android:background="?attr/larus_bg_create_ugc_voice_btn"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_176"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_50"
        android:contentDescription="@string/larus_create_my_voice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/create_ugc_voice_btn_icon"
        android:padding="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/create_ugc_voice_btn"
        app:layout_constraintEnd_toStartOf="@+id/create_ugc_voice_btn_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/create_ugc_voice_btn"
        app:layout_constraintTop_toTopOf="@+id/create_ugc_voice_btn"
        app:srcCompat="@drawable/larus_ic_voice_clone"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/create_ugc_voice_btn_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_create_my_voice"
        app:layout_constraintBottom_toBottomOf="@+id/create_ugc_voice_btn_icon"
        app:layout_constraintEnd_toEndOf="@+id/create_ugc_voice_btn"
        app:layout_constraintStart_toEndOf="@+id/create_ugc_voice_btn_icon"
        app:layout_constraintTop_toTopOf="@+id/create_ugc_voice_btn_icon"/>
    <View
        android:id="@+id/create_btn_mask"
        android:background="?attr/larus_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/create_bot_btn"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/create_bot_btn"
        android:background="?attr/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_button"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
