<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/content_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/message_right_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/message_left_container"
        app:layout_constraintTop_toBottomOf="@+id/message_top_container"/>
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/message_left_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/content_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content_view"/>
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/message_top_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/content_view"
        app:layout_constraintStart_toStartOf="@+id/content_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/message_right_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/content_view"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/message_fork_relation_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_view"/>
    <com.larus.bmhome.chat.cell.view.CustomStubView
        android:id="@+id/message_bottom_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="@+id/content_view"
        app:layout_constraintTop_toBottomOf="@+id/message_fork_relation_container"
        app:layout_goneMarginTop="?attr/larus_dp_8"/>
</merge>
