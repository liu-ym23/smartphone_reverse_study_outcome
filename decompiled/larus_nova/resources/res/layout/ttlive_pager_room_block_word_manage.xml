<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_word_container"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_commonui_white_50"
        android:id="@+id/tv_block_word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"/>
    <ImageView
        android:id="@+id/block_word_red_dot"
        android:background="@drawable/ttlive_ic_red_point_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/tv_block_word_count"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="16dp"
        android:layout_below="@+id/tv_block_word_count"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <com.bytedance.android.livesdk.widget.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/block_word_display_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/btn_add_block_word"
                android:background="@drawable/ttlive_room_block_word_background"
                android:layout_width="55dp"
                android:layout_height="28dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ttlive_room_block_word_add"
                    android:contentDescription="@string/ttlive_add_transform"/>
            </FrameLayout>
        </com.bytedance.android.livesdk.widget.FlowLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/block_word_input_area"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_alignParentBottom="true">
        <com.bytedance.android.live.core.widget.LiveEditText
            android:textSize="15dp"
            android:textColor="@color/black"
            android:textColorHint="#3d000000"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/block_word_edit_text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|actionSend"
            android:textCursorDrawable="@drawable/ttlive_edit_text_cursor_drawable"
            android:textAlignment="viewStart"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#3d000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_input_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</RelativeLayout>
