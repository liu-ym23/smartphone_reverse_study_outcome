<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_second_icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/file_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_play_audio"
        app:layout_constraintStart_toEndOf="@+id/iv_second_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/neutral_100"
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="PingFang SC"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/neutral_50"
            android:ellipsize="end"
            android:id="@+id/tv_file_type"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"/>
    </LinearLayout>
    <com.larus.bmhome.chat.standarduikit.fileblock.view.FileAudioButtonView
        android:id="@+id/iv_play_audio"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:contentDescription="@string/larus_aiPodcast_play_cn"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
