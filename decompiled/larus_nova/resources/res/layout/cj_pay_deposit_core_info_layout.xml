<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_deposit_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/cj_deposit_fund_container"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:baselineAligned="false">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center_vertical"
                android:id="@+id/cj_deposit_amount_unit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/cj_pay_currency_unit"/>
            <TextView
                android:textSize="40sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center_vertical"
                android:id="@+id/cj_deposit_amount_value"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
        <View
            android:id="@+id/cj_deposit_content_divider"
            android:background="#14161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <include layout="@layout/cj_pay_layout_sign_service_info_section"/>
    </LinearLayout>
</merge>
