<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="168dp">
    <View
        android:id="@+id/double_talk"
        android:background="@drawable/ttlive_double_talk_bg"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_interact"
        android:layout_width="55dp"
        android:layout_height="32dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/ttlive_double_talk_icon"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_interact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="61dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_live_interact_title_audience"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_interact_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="83dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_tips_scene_init_double_talk"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <View
        android:id="@+id/video_talk_room"
        android:background="@drawable/ttlive_video_talkroom_bg"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toRightOf="@+id/double_talk"
        app:layout_constraintRight_toLeftOf="@+id/video_ktv_room"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_talk_room_icon"
        android:layout_width="55dp"
        android:layout_height="32dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/ttlive_video_talkroom_icon"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_video_talk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="59dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_video_talk_room"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_video_talk_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_tips_scene_init_talk_room"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
    <View
        android:id="@+id/video_ktv_room"
        android:background="@drawable/ttlive_video_ktv_bg"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toRightOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_ktv_room_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ttlive_video_ktvroom_icon"
        app:layout_constraintLeft_toLeftOf="@+id/video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/video_ktv_room"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_video_ktv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="59dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_live_interact_confirm_ktvroom_title"
        app:layout_constraintLeft_toLeftOf="@+id/video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/video_ktv_room"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_video_ktv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_tips_scene_init_ktv"
        app:layout_constraintLeft_toLeftOf="@+id/video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/video_ktv_room"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_double_talk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="double_talk,iv_interact,tv_interact,tv_interact_desc"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_video_ktv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="video_ktv_room,video_ktv_room_icon,tv_video_ktv_title,tv_video_ktv_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
