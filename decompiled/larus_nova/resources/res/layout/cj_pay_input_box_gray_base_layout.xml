<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_label"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_12"
            android:layout_height="@dimen/cj_pay_padding_12"
            android:layout_marginRight="@dimen/cj_pay_padding_4"/>
        <TextView
            android:textSize="?attr/cj_pay_page_size_12"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/iv_icon"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/cj_pay_input_box_relative_layout"
        android:background="@drawable/cj_pay_input_box_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_64"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/layout_label">
        <TextView
            android:textSize="?attr/cj_pay_page_size_16"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:textColorHint="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/tv_input_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:includeFontPadding="false"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayPasteAwareEditText
            android:textSize="?attr/cj_pay_page_size_16"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/et_input"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:textCursorDrawable="@drawable/cj_pay_bg_universal_cursor"/>
        <ImageView
            android:id="@+id/iv_close"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:src="@drawable/cj_pay_icon_delete_gray_background"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
