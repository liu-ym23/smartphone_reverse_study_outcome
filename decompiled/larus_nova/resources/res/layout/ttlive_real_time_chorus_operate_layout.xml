<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.bytedance.android.livesdk.ktvimpl.realtimechorus.RealtimeChorusProgressImageView
        android:gravity="center"
        android:id="@+id/chorus_btn_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="83dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chorus_order_song_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/chorus_btn_container"
        app:layout_constraintStart_toEndOf="@+id/chorus_btn_container">
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/chorus_order_song"
            android:background="@drawable/ttlive_real_time_chorus_operate_bg_circle_dark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="@string/ttlive_real_time_chorus_order_song"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/chorus_order_song_count"
            android:background="@drawable/ttlive_real_time_chorus_ordered_song_count_bg"
            android:paddingLeft="3.13dp"
            android:paddingRight="3.13dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:minWidth="12dp"
            android:includeFontPadding="false"
            app:layout_constraintRight_toRightOf="@+id/chorus_order_song_container"
            app:layout_constraintTop_toTopOf="@+id/chorus_order_song_container"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:id="@+id/chorus_order_song_red_dot"
            android:background="@drawable/ttlive_real_time_chorus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintRight_toRightOf="@+id/chorus_order_song"
            app:layout_constraintTop_toTopOf="@+id/chorus_order_song"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/chorus_adjust"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ttlive_real_time_chorus_operate_adjust"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chorus_order_song_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/chorus_mic_container"
        android:background="@drawable/ttlive_chorus_mic_bg"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chorus_adjust"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/chorus_mic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_real_time_chorus_mic_on_img"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
