<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:id="@+id/cj_pay_forget_password_view"
        android:paddingTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cj_pay_forget_password"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_pwd_view"
        android:layout_alignRight="@+id/cj_pay_pwd_view"/>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red"
        android:id="@+id/cj_pay_password_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_8"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_pwd_view"
        android:layout_alignLeft="@+id/cj_pay_pwd_view"/>
    <com.android.ttcjpaysdk.base.ui.widget.TalkbackKeyboardNoiseReductionView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:keepScreenOn="true"/>
    <include layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
