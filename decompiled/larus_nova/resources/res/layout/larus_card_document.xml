<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expand_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_7"
            android:layout_marginBottom="?attr/larus_dp_7"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="?attr/larus_neutral_70"
                android:ellipsize="end"
                android:id="@+id/expand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/copy_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_card_deep_research_report_copy"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/export_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_card_deep_research_report_export"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/full_screen_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:srcCompat="?attr/larus_ic_card_deep_research_report_full_screen"/>
        </LinearLayout>
        <View
            android:id="@+id/line"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            app:layout_constraintTop_toBottomOf="@+id/header_container"/>
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/line">
            <com.larus.bmhome.view.textview.impl.CustomMarkdownTextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/markdown_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_15"
                android:layout_marginRight="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_42"
                android:maxHeight="?attr/larus_dp_324"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/doc_loading"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
                    android:id="@+id/shimmer_view_1"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
                    android:id="@+id/shimmer_view_2"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_12"
                    app:layout_constraintEnd_toStartOf="@+id/guidelineHalf"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/shimmer_view_1"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guidelineHalf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/expand_tip"
            android:background="?attr/larus_card_deep_search_report_mask_gradient"
            android:paddingTop="?attr/larus_dp_42"
            android:paddingBottom="?attr/larus_dp_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_aiDoc_msgCard_viewDoc"
            app:layout_constraintBottom_toBottomOf="@+id/content_container"/>
        <View
            android:id="@+id/click_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/expand_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/collapse_card"
        android:layout="@layout/larus_layout_document_collapse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
