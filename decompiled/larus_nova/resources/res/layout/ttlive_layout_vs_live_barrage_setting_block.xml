<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.barrage.setting.InterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingLeft="34dp"
    android:layout_width="match_parent"
    android:layout_height="93dp"
    android:paddingStart="34dp">
    <TextView
        android:textSize="11dp"
        android:textColor="#80ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_barrage_setting_block"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/live_barrage_giftmessage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ttlive_barrage_vs_barrage_gift"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:id="@+id/ttlive_barrage_setting_gift_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_barrage_setting_giftmessage"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/live_barrage_carnival_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp">
            <ImageView
                android:id="@+id/live_barrage_carnival_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ttlive_barrage_vs_barrage_carnival"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:id="@+id/live_barrage_carnival_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_barrage_setting_carnival_barrage"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.livesdk.interactivity.barrage.setting.InterceptConstraintLayout>
