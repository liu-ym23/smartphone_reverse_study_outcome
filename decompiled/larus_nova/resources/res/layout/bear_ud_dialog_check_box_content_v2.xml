<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/UDText.Body0"
        android:textColor="@color/text_title"
        android:id="@+id/ud_dialog_content_message_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ud_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/ud_dialog_padding_left_right"/>
    <TextView
        android:textSize="@dimen/ud_text_body1"
        android:textColor="@color/text_caption"
        android:id="@+id/ud_dialog_content_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginStart="@dimen/ud_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/ud_dialog_padding_left_right"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ud_dialog_checkbox_layout"
        android:paddingTop="@dimen/space_kit_len_12"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_kit_len_20"
        android:paddingEnd="@dimen/space_kit_len_20">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:id="@+id/ud_dialog_checkbox"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_kit_len_8"
            app:ud_checkbox_size="small"
            app:ud_checkbox_type="check_box"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:layout_gravity="center_vertical"
            android:id="@+id/ud_dialog_checkbox_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
