<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="6dp">
    <RelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="4dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="166dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/ec_shop_product_placeholder_color"/>
            <RelativeLayout
                android:id="@+id/store_product_card_video_wrapper"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
        <androidx.cardview.widget.CardView
            android:gravity="center_vertical"
            android:id="@+id/ec_shop_play_info_group"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minWidth="54dp"
            android:minHeight="18dp"
            app:cardBackgroundColor="@color/ec_shop_recommend_watch_playback_bg_color"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:contentPaddingBottom="3dp"
            app:contentPaddingLeft="3dp"
            app:contentPaddingRight="3dp"
            app:contentPaddingTop="3dp">
            <com.bytedance.android.ec.core.widget.CircleImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/shopping_window_video_card_play_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:actualImageScaleType="fitXY"
                app:placeholderImage="@drawable/ec_shop_ic_inner_flow_play_back"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_white_1"
                android:ellipsize="end"
                android:id="@+id/shopping_window_video_card_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_shop_video_explain"
                android:maxLines="1"
                android:layout_marginStart="14dp"/>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/shopping_std_bg_primary_white"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="none"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            layout="@layout/ec_window_product_card_info_price"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            layout="@layout/ec_window_product_card_info_taglist"/>
    </LinearLayout>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
