<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appointment_select_root"
    android:background="@drawable/ttlive_bg_poi_select_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/appointment_select_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ttlive_broadcast_poi_select_back"
        android:scaleType="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_appointment_select_dialog_title"
        android:id="@+id/appointment_select_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_poi_select_dialog_title"
        app:layout_constraintBottom_toBottomOf="@+id/appointment_select_back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appointment_select_back"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_appointment_select_dialog_show_text"
        android:id="@+id/appointment_select_show_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="26dp"
        android:text="@string/ttlive_appointment_select_dialog_show_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appointment_select_back"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/appointment_select_switch_button"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appointment_select_back"
        app:lsb_background="@color/ttlive_room_intro_switch_button_unchecked_bg"
        app:lsb_button_color="@color/commonui_white"
        app:lsb_checked_color="@color/ttlive_room_intro_switch_button_checked_bg"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="@color/commonui_white"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_appointment_select_dialog_description_text"
        android:id="@+id/appointment_scheduled_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/appointment_select_show_text"
        app:layout_constraintTop_toBottomOf="@+id/appointment_select_show_text"/>
    <View
        android:id="@+id/appointment_select_switch_divider"
        android:background="@color/ttlive_std_line_black_3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appointment_scheduled_time_text"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_appointment_select_dialog_description_text"
        android:id="@+id/appointment_select_intro_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appointment_select_switch_divider"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/appointment_select_intro_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appointment_select_intro_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
