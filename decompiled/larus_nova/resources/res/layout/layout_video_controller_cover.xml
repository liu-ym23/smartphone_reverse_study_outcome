<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_cover"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="show_video_share_element"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/center_play_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/Lark_Legacy_PlayVideoButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/video_play"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/function_top_layout"
        android:background="@drawable/video_control_top_bg"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="54dp"
            android:tint="@color/static_white"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_close_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/enter_pip_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/static_white"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/close_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/close_btn"
            app:srcCompat="@drawable/ud_icon_minisize_video_outlined"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/function_bottom_layout"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <include
            android:id="@+id/video_control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toTopOf="@+id/function_bottom_btns_layout"
            layout="@layout/layout_video_control_bar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:layout_constraintBottom_toTopOf="@+id/function_bottom_btns_layout"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/function_bottom_btns_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/speed_btn"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="32dp"
                android:layout_marginEnd="12dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/download_btn"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/ud_icon_download_outlined"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/album_btn"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/ud_icon_photo_album_filled"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/more_action_btn"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/pip_mode_progress_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/video_seek_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
