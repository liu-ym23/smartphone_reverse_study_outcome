<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/center_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/guide_view_volume_container"
        android:layout_width="135dp"
        android:layout_height="135dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toTopOf="@+id/center_guide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="116dp"
        android:layout_height="116dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_view_volume_container"
        app:layout_constraintEnd_toEndOf="@+id/guide_view_volume_container"
        app:layout_constraintStart_toStartOf="@+id/guide_view_volume_container"
        app:layout_constraintTop_toTopOf="@+id/guide_view_volume_container"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_guest_avatar"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="116dp"
        android:layout_height="116dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_volume_Anim"
        android:layout_width="135dp"
        android:layout_height="135dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_view_volume_container"
        app:layout_constraintEnd_toEndOf="@+id/guide_view_volume_container"
        app:layout_constraintStart_toStartOf="@+id/guide_view_volume_container"
        app:layout_constraintTop_toTopOf="@+id/guide_view_volume_container"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/ttlive_avatar_right_top_widget_container"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:translationX="58dp"
        android:translationY="-58dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_right_top_widget"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ttlive_guest_name_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar">
        <View
            android:id="@+id/ttlive_guest_identification"
            android:background="@drawable/ttlive_ic_audio_chat_room_admin"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="10"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.common.AnchorPauseTipsView
        android:id="@+id/ttlive_leave_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
    <FrameLayout
        android:id="@+id/random_emoji_container"
        android:layout_width="75dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_volume_Anim"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_volume_Anim"
        app:layout_constraintStart_toStartOf="@+id/ttlive_volume_Anim"
        app:layout_constraintTop_toTopOf="@+id/ttlive_volume_Anim"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
        android:id="@+id/ttlive_guest_fans_ticket_count"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
