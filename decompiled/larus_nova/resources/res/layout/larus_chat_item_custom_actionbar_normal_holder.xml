<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_action_bar_item_height"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12"
    app:rv_backgroundColor="@android:color/transparent"
    app:rv_backgroundPressColor="?attr/larus_press"
    app:rv_cornerRadius="?attr/larus_dp_8"
    app:rv_strokeColor="?attr/larus_neutral_transparent_2"
    app:rv_strokePressColor="?attr/larus_press"
    app:rv_strokeWidth="?attr/larus_dp_1">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ic_item_img"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/larus_neutral_transparent_1"/>
    <ProgressBar
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:indeterminate="true"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/ic_item_lottie"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:placeholderImage="?attr/larus_neutral_transparent_1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_item_red_dot"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_action_bar_red_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_11"
        android:textStyle="bold"
        android:textColor="?attr/larus_primary_50"
        android:gravity="center"
        android:id="@+id/tv_item_update_dot"
        android:background="?attr/larus_action_bar_blue_update_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_18"
        android:paddingStart="?attr/larus_dp_4"
        android:paddingEnd="?attr/larus_dp_4"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="end"/>
    <ImageView
        android:id="@+id/iv_left_bold"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_4"
        android:layout_height="?attr/larus_dp_11"
        android:src="@drawable/larus_ic_action_bar_menu_arrow"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_end"
        app:layout_constraintTop_toTopOf="parent"/>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
