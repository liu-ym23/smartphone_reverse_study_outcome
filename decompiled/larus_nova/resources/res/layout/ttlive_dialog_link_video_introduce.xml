<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_link_video_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/back"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/link_video_back_icon"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#161823"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/ttlive_text_link_video_introduce_title"
            android:layout_centerInParent="true"
            android:fontFamily="PingFangSC"/>
        <View
            android:id="@+id/nav_line"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/link_video_introduce_rv"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="0dp"
        android:layout_above="@+id/link_video_introduce_option"
        android:layout_below="@+id/title_layout"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="20dp"/>
    <include
        android:id="@+id/link_video_introduce_option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/ttlive_dialog_link_video_introduce_option"/>
</RelativeLayout>
