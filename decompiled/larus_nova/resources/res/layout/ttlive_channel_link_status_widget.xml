<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="38dp"
    android:layout_height="38dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/link_status_iv"
        android:focusable="true"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ttlive_room_channel_toolbar_mic_status_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/link_volume_view"
        android:visibility="gone"
        android:layout_width="5dp"
        android:layout_height="10.5dp"
        android:layout_marginTop="10dp"
        android:progress="100"
        app:layout_constraintEnd_toEndOf="@+id/link_status_iv"
        app:layout_constraintStart_toStartOf="@+id/link_status_iv"
        app:layout_constraintTop_toTopOf="@+id/link_status_iv"
        style="@style/ttlive_room_link_progress_bar_style_ver"/>
</androidx.constraintlayout.widget.ConstraintLayout>
