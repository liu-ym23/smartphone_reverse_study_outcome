<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="36dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_cash_exchange_guide"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_bg_cash_exchange_guide_img"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ttlive_cash_exchange_coins"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_bg_cash_exchange_guide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ttlive_bg_cash_exchange_guide_arrow"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:layout_marginLeft="53dp"
        android:layout_marginTop="-1dp"
        android:src="@drawable/ttlive_cash_exchange_guide_bottom_arrow"
        android:scaleType="fitXY"
        android:layout_marginStart="53dp"/>
</LinearLayout>
