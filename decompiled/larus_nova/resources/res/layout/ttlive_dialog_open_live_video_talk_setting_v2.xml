<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/setting_content"
    android:background="@drawable/ttlive_bg_open_live_video_talk"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/video_talk_room_setting_title"
        android:padding="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_video_talk_scene_multi_link"/>
    <FrameLayout
        android:id="@+id/fl_open_talk_room"
        android:background="@drawable/ttlive_bg_live_interact_list"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_open_talk_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_open_live_multi_link"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_open_talk_room"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/tv_layout_setting_linkmode"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_live_talk_room_setting_title_selectmode"
        android:paddingStart="32dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_linkmode_switch"
        android:background="@drawable/ttlive_bg_live_interact_list"
        android:padding="16dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="82dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/empty_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_playmode_guest_link_layout"
            android:background="@drawable/ttlive_video_talk_switch_scene_selected_bg"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/ttlive_video_talk_camera_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_playmode_talkroom_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_guest_link_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_playmode_guest_link_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_playmode_guest_link_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_playmode_guest_link_layout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_guest_link_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_interact_guest_link_playmode"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_playmode_talkroom_layout"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/ttlive_video_talk_equal_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:layout_marginStart="15dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_playmode_guest_link_layout"
            app:layout_constraintRight_toLeftOf="@+id/empty_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_talkroom_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_playmode_talkroom_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_playmode_talkroom_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_playmode_talkroom_layout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_talk_room_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_interact_talk_room_playmode"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#99161823"
            android:id="@+id/tv_layout_setting_linklayout"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_select_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_playmode_guest_link_layout"/>
        <ImageView
            android:id="@+id/iv_layout_big_window_layout"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/ttlive_video_talk_camera_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_layout_dynamic_layout"
            app:layout_constraintTop_toBottomOf="@+id/tv_layout_setting_linklayout"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_layout_big_window_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_layout_big_window_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_layout_big_window_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_layout_big_window_layout">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_big_window_layout_iv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_guestlink_big_window_layout_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#161823"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_interact_bit_window_layout"
                android:importantForAccessibility="no"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_layout_dynamic_layout"
            android:background="@drawable/ttlive_video_talk_switch_scene_selected_bg"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/ttlive_video_talk_camera_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:layout_marginStart="2dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_layout_big_window_layout"
            app:layout_constraintRight_toLeftOf="@+id/iv_layout_fixed_layout"
            app:layout_constraintTop_toBottomOf="@+id/tv_layout_setting_linklayout"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_layout_dynamic_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_layout_dynamic_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_layout_dynamic_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_layout_dynamic_layout">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_dynamic_layout_iv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_guestlink_dynamic_layout_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#161823"
                android:gravity="center_vertical"
                android:id="@+id/layout_dynamic_layout_tv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_interact_guestlink_dynamic_layout"
                android:importantForAccessibility="no"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_layout_fixed_layout"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/ttlive_video_talk_equal_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:layout_marginStart="2dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_layout_dynamic_layout"
            app:layout_constraintRight_toLeftOf="@+id/empty_view"
            app:layout_constraintTop_toTopOf="@+id/iv_layout_dynamic_layout"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_layout_fixed_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_layout_fixed_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_layout_fixed_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_layout_fixed_layout">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_fixed_layout_iv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_guestlink_fixed_layout_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#161823"
                android:gravity="center_vertical"
                android:id="@+id/layout_fixed_layout_tv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_interact_guestlink_fixed_layout"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
