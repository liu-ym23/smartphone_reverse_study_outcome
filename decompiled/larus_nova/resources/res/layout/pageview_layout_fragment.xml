<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/leftIconIV"
        android:paddingRight="@dimen/space_kit_font_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_48"
        android:scaleType="centerInside"
        android:tint="@color/facade_selector_icon_n1"
        android:paddingStart="@dimen/space_kit_len_16"
        app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
    <TextView
        android:textSize="@dimen/space_kit_font_17"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/CreationMobile_Stats_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reloading"
        android:visibility="invisible"
        android:layout_width="@dimen/space_kit_len_48"
        android:layout_height="@dimen/space_kit_len_48"
        android:scaleType="centerInside"
        android:tint="@color/primary_fill_default"
        android:layout_alignParentRight="true"
        app:srcCompat="@drawable/ud_icon_refresh_outlined"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/title_subhead_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:text="@string/CreationMobile_Stats_Basic_tab"
                app:layout_constraintTop_toBottomOf="@+id/parent"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:id="@+id/subtitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/Doc_More_DocumentOwner"
                app:layout_constraintLeft_toLeftOf="@+id/title_subhead_1"
                app:layout_constraintTop_toBottomOf="@+id/title_subhead_1"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle1"
                app:layout_constraintLeft_toRightOf="@+id/subtitle1"
                app:layout_constraintTop_toTopOf="@+id/subtitle1"/>
            <com.larksuite.component.universe_design.image.UDAvatar
                android:id="@+id/subtitle1_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle1"
                app:layout_constraintLeft_toRightOf="@+id/subtitle1"
                app:layout_constraintTop_toTopOf="@+id/subtitle1"
                app:ud_avatar_borderWidth="0dp"
                app:ud_avatar_size="mini"
                style="@style/UDAvatar.Circle"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:id="@+id/subtitle1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle1"
                app:layout_constraintLeft_toRightOf="@+id/subtitle1_img"
                app:layout_constraintTop_toTopOf="@+id/subtitle1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subtitle_creator_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintLeft_toLeftOf="@+id/subtitle1"
                app:layout_constraintTop_toBottomOf="@+id/subtitle1">
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LarkCCM_Docs_DocDetails_Creator_Title"
                    app:layout_constraintLeft_toLeftOf="@+id/subtitle_creator_container"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_creator_container"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle_creator"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle_creator"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_creator"/>
                <com.larksuite.component.universe_design.image.UDAvatar
                    android:id="@+id/subtitle_creator_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle_creator"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle_creator"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_creator"
                    app:ud_avatar_borderWidth="0dp"
                    app:ud_avatar_size="mini"
                    style="@style/UDAvatar.Circle"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle_creator_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle_creator"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle_creator_img"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_creator"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:id="@+id/subtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/Doc_More_CreationTime"
                app:layout_constraintLeft_toLeftOf="@+id/subtitle_creator_container"
                app:layout_constraintTop_toBottomOf="@+id/subtitle_creator_container"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle2"
                app:layout_constraintLeft_toRightOf="@+id/subtitle2"
                app:layout_constraintTop_toTopOf="@+id/subtitle2"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_title"
                android:id="@+id/subtitle2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle2"
                app:layout_constraintLeft_toRightOf="@+id/subtitle2"
                app:layout_constraintTop_toTopOf="@+id/subtitle2"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subtitle_last_modified_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintLeft_toLeftOf="@+id/subtitle2"
                app:layout_constraintTop_toBottomOf="@+id/subtitle2">
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle_last_modified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LarkCCM_Docs_DocDetails_LastModified_Title"
                    app:layout_constraintLeft_toLeftOf="@+id/subtitle_last_modified_container"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_last_modified_container"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle_last_modified"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle_last_modified"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_last_modified"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/subtitle_last_modified_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle_last_modified"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle_last_modified"
                    app:layout_constraintTop_toTopOf="@+id/subtitle_last_modified"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/divider2"
                android:background="@color/line_divider_default"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintLeft_toLeftOf="@+id/subtitle_last_modified_container"
                app:layout_constraintTop_toBottomOf="@+id/subtitle_last_modified_container"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_subhead_2_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/divider2">
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:id="@+id/title_subhead_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:text="@string/LarkCCM_Docs_DocDetails_Statistics_Title"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/Doc_Doc_WordsCount"
                    app:layout_constraintLeft_toLeftOf="@+id/title_subhead_2"
                    app:layout_constraintTop_toBottomOf="@+id/title_subhead_2"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle3_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle3"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle3"
                    app:layout_constraintTop_toTopOf="@+id/subtitle3"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle3_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle3"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle3"
                    app:layout_constraintTop_toTopOf="@+id/subtitle3"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/Doc_Doc_CharacterCount"
                    app:layout_constraintLeft_toLeftOf="@+id/subtitle3"
                    app:layout_constraintTop_toBottomOf="@+id/subtitle3"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle4_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle4"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle4"
                    app:layout_constraintTop_toTopOf="@+id/subtitle4"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle4_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle4"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle4"
                    app:layout_constraintTop_toTopOf="@+id/subtitle4"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/LarkCCM_CM_Storage_SortSize_List"
                    app:layout_constraintLeft_toLeftOf="@+id/subtitle4"
                    app:layout_constraintTop_toBottomOf="@+id/subtitle4"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle5_divider"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle5"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle5"
                    app:layout_constraintTop_toTopOf="@+id/subtitle5"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/subtitle5_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/subtitle5"
                    app:layout_constraintLeft_toRightOf="@+id/subtitle5"
                    app:layout_constraintTop_toTopOf="@+id/subtitle5"/>
                <View
                    android:id="@+id/divider3"
                    android:background="@color/line_divider_default"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="@+id/subtitle3"
                    app:layout_constraintTop_toBottomOf="@+id/subtitle5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/title_subhead_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/CreationMobile_Stats_Basic_reactions"
                app:layout_constraintTop_toBottomOf="@+id/title_subhead_2_container"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_subhead_3_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/title_subhead_3"
                app:layout_constraintTop_toBottomOf="@+id/title_subhead_3">
                <com.bytedance.ee.bear.more.pageview2.PageviewItemView
                    android:id="@+id/item_ret_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"/>
                <com.bytedance.ee.bear.more.pageview2.PageviewItemView
                    android:id="@+id/item_ret_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"/>
                <com.bytedance.ee.bear.more.pageview2.PageviewItemView
                    android:id="@+id/item_ret_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"/>
                <com.bytedance.ee.bear.more.pageview2.PageviewItemView
                    android:id="@+id/item_ret_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:id="@+id/divider4"
                android:background="@color/line_divider_default"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="@+id/title_subhead_3_content"
                app:layout_constraintTop_toBottomOf="@+id/title_subhead_3_content"/>
            <com.bytedance.ee.bear.more.pageview2.PageviewTextView
                android:id="@+id/item_text_1"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider4"
                layout="@layout/more_item_text_v2"/>
            <com.bytedance.ee.bear.more.pageview2.PageviewTextView
                android:id="@+id/operation_detail_item"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_text_1"/>
            <com.bytedance.ee.bear.more.pageview2.PageviewTextView
                android:id="@+id/item_text_2"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginBottom="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/operation_detail_item"
                layout="@layout/more_item_text_v2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/empty_state"
        android:background="@color/bg_body"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/divider"
        android:elevation="2dp"
        app:ud_empty_desc="@string/CreationMobile_Stats_FailedToLoad_desc1"
        app:ud_empty_primaryText="@string/CreationMobile_Stats_FailedToLoad_desc2"
        app:ud_empty_title="@string/CreationMobile_Stats_FailedToLoad_title"/>
</RelativeLayout>
