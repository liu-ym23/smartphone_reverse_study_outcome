<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_multi_enlarge_change_select_dialog_r20"
    android:layout_width="match_parent"
    android:layout_height="344dp">
    <View
        android:id="@+id/close_btn"
        android:padding="12dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_dialog_multi_enlarge_change_select_title"
        app:layout_constraintBottom_toBottomOf="@+id/close_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/close_btn"/>
    <View
        android:id="@+id/guide_line"
        android:layout_width="0.5dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.enlarge.widget.MultiEnlargeSelectView
        android:id="@+id/first_enlarge_container"
        android:layout_width="120dp"
        android:layout_height="146dp"
        android:layout_marginRight="13dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toStartOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/guide_line"/>
    <com.bytedance.android.live.liveinteract.enlarge.widget.MultiEnlargeSelectView
        android:id="@+id/second_enlarge_container"
        android:layout_width="120dp"
        android:layout_height="146dp"
        android:layout_marginLeft="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintStart_toEndOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/guide_line"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/send_invite_btn"
        android:background="@drawable/ttlive_bg_multi_enlarge_red_dialog_r8"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="254dp"
        android:text="@string/ttlive_dialog_multi_enlarge_change_select_send_invite"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
