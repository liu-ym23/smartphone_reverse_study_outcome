<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/larus_base_1_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="?attr/larus_dp_14"
        android:paddingBottom="?attr/larus_dp_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_70"
            android:gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_globalSearch_searchPage_header_searchHistory"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:layout_gravity="end"
            android:id="@+id/history_manage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_globalSearch_searchPage_btn_manageSearchHistory"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/history_manage_action_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/history_delete_all_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_globalSearch_searchPage_btn_clearSearchHistory"/>
            <View
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_1"
                android:layout_height="?attr/larus_dp_12"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/history_manage_done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_globalSearch_searchPage_btn_done"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.larus.extension.aggregate_search_ui.impl.view.SearchWrapLayout
        android:id="@+id/history_wrap_layout"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"/>
</LinearLayout>
