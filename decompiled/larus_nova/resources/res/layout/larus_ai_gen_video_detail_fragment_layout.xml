<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_centerInParent="true"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="@color/larus_static_black_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/background"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            custom:layout_constraintBottom_toBottomOf="parent"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/retry_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/big_image_blank_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_refresh_white"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_photo_loading_retry"
            android:layout_below="@+id/big_image_blank_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.larus.bmhome.video.view.AiGenVideoPlayControlView
        android:id="@+id/video_play_control_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toTopOf="@+id/bottom_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:paddingLeft="?attr/larus_dp_11"
        android:paddingRight="?attr/larus_dp_11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent">
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/download_view"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:contentDescription="@string/larus_accessibility_save"
            android:layout_marginEnd="?attr/larus_dp_8"
            custom:layout_constraintEnd_toStartOf="@+id/creation_view"
            custom:layout_constraintHorizontal_weight="1"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toTopOf="parent"/>
        <com.larus.bmhome.view.CreationOperateContainerView
            android:id="@+id/creation_view"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            custom:layout_constraintEnd_toEndOf="parent"
            custom:layout_constraintHorizontal_weight="1"
            custom:layout_constraintStart_toEndOf="@+id/download_view"
            custom:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
