<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:baselineAligned="false">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white_90"
        android:gravity="top"
        android:id="@+id/tv_switch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:lineSpacingExtra="0dp"
        android:translationY="-0.21dp"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_ic_red_point_tip"
        android:layout_toRightOf="@+id/tv_switch_title"
        android:layout_alignTop="@+id/tv_switch_title"
        android:layout_toEndOf="@+id/tv_switch_title"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ttlive_ic_right_arrow"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_commonui_white_50"
        android:gravity="end"
        android:id="@+id/tv_switch_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-12dp"
        android:layout_toLeftOf="@+id/iv_arrow"
        android:layout_toRightOf="@+id/tv_switch_title"
        android:layout_centerVertical="true"
        android:layout_marginEnd="-12dp"
        android:layout_toStartOf="@+id/iv_arrow"
        android:layout_toEndOf="@+id/tv_switch_title"/>
</RelativeLayout>
