<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center"
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:overlayImage="?attr/larus_bg_base_6"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center"
        android:id="@+id/iv_analysis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:placeholderImage="@android:color/transparent"
        app:roundedCornerRadius="?attr/larus_dp_4"
        app:roundingBorderColor="?attr/larus_base_2"
        app:roundingBorderWidth="?attr/larus_dp_4"/>
    <com.larus.common_ui.widget.shimmer.ShimmerMaskView
        android:layout_gravity="center"
        android:id="@+id/mask_analysis"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
