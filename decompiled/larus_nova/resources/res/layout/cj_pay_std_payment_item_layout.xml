<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_finance_item_credit_pay"
    android:background="?attr/cj_pay_bg_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/cj_pay_std_asset_split_line"
        android:background="?attr/cj_pay_border_divider_grey_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/cj_pay_std_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">
        <RelativeLayout
            android:id="@+id/cj_pay_std_asset_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/cj_pay_asset_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="16dp"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/cj_pay_asset_icon_disable_mask"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/cj_pay_text_primary"
                android:ellipsize="end"
                android:id="@+id/cj_pay_std_asset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="44dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_white"
                android:ellipsize="end"
                android:id="@+id/cj_pay_std_recommend_tag"
                android:background="@drawable/cj_pay_bg_recommend_red_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="40dp"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/cj_pay_std_asset_title"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:gravity="right"
                android:id="@+id/cj_pay_std_asset_guide"
                android:paddingLeft="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
                android:id="@+id/cj_pay_std_asset_checkbox"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="16dp"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayStandardCircleCheckbox
                android:id="@+id/cj_pay_std_asset_checkbox_standard"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="16dp"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/cj_pay_std_asset_arrow"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="16dp"
                android:src="?attr/cj_pay_icon_right_arrow_noise_reduction"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"/>
            <ProgressBar
                android:id="@+id/cj_pay_std_asset_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="13dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_method_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
            android:gravity="left"
            android:id="@+id/cj_pay_std_asset_voucher"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:ellipsize="end"
                android:id="@+id/cj_pay_std_asset_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="44dp"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/cj_pay_std_asset_subtitle_info_icon"
                android:paddingLeft="10dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="17dp"
                android:layout_marginLeft="-6dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/cj_pay_info_icon"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <HorizontalScrollView
            android:id="@+id/cj_pay_std_sub_asset_scroll_layout"
            android:paddingRight="16dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:layout_marginTop="@dimen/cj_pay_padding_12">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_std_sub_asset_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <TextView
            android:textSize="11sp"
            android:textColor="?attr/cj_pay_text_quaternary"
            android:id="@+id/cj_pay_std_asset_desc_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:layout_marginTop="@dimen/cj_pay_padding_6"/>
        <com.android.ttcjpaysdk.base.ui.component.agreement.CJRowSwitchText
            android:id="@+id/cj_pay_bank_card_points_selection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            app:CJRowSwitchChecked="false"
            app:CJRowSwitchContent=""/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_method_fold_layout"
        android:layout_width="match_parent"
        android:layout_height="41dp">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_std_asset_footer_fold_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:text="@string/cj_pay_method_bottom_text_folded_left_expand"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_std_asset_footer_fold_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="?attr/cj_pay_icon_arrow_down"/>
    </LinearLayout>
</LinearLayout>
