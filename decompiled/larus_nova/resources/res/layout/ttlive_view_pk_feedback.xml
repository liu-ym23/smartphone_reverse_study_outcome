<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp">
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_black"
        android:id="@+id/tv_random"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_pk_feedback_random_title"/>
    <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
        android:id="@+id/tags_random"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/tv_random"
        app:hSpacing="8dp"
        app:vSpacing="8dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_black"
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/ttlive_pk_feedback_title"
        android:layout_below="@+id/tags_random"/>
    <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
        android:id="@+id/tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title"
        app:hSpacing="8dp"
        app:vSpacing="8dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_black"
        android:id="@+id/tv_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_pk_feedback_subtitle"
        android:layout_below="@+id/tags"
        android:verticalScrollbarPosition="right"/>
    <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
        android:id="@+id/subTags"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/tv_subtitle"
        app:hSpacing="8dp"
        app:vSpacing="8dp"/>
    <EditText
        android:textSize="13dp"
        android:textColorHint="#4d161823"
        android:gravity="start"
        android:id="@+id/et"
        android:background="@drawable/ttlive_bg_et_pk_feedback"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:hint="@string/ttlive_pk_feedback_hint"
        android:layout_below="@+id/tv_subtitle"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_black"
        android:id="@+id/tv_report_et_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_pk_feedback_text_reason_title"
        android:layout_below="@+id/subTags"
        android:verticalScrollbarPosition="right"/>
    <EditText
        android:textSize="13dp"
        android:textColorHint="#4d161823"
        android:gravity="start"
        android:id="@+id/report_et"
        android:background="@drawable/ttlive_bg_et_pk_feedback"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:hint="@string/ttlive_pk_feedback_hint"
        android:layout_below="@+id/tv_report_et_title"/>
</RelativeLayout>
