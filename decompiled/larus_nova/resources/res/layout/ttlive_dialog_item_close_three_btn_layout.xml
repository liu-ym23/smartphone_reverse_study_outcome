<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/room_center_button_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_left"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginRight="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginEnd="1dp"/>
    <View
        android:id="@+id/middle_btn_line"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <Button
        android:textSize="15dp"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_middle"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_bottom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="1dp"/>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <Button
        android:textSize="15dp"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_right"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_bottom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="1dp"/>
</LinearLayout>
