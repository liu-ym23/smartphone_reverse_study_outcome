<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/phone_title"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_97"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/edit_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintTop_toBottomOf="@+id/phone_title">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/phone_edit"
            android:background="@drawable/larus_bg_phone_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_48"
            android:layoutDirection="ltr"
            android:paddingEnd="?attr/larus_dp_12"
            android:layout_marginStart="?attr/larus_dp_32"
            android:layout_marginEnd="?attr/larus_dp_32">
            <com.larus.common_ui.widget.SeparatedEditText
                android:layout_gravity="center_horizontal"
                android:id="@+id/edit_solid"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_328"
                android:layout_height="?attr/larus_dp_48"
                android:inputType="number"
                app:larus_blockColor="@color/larus_base_2_overlay"
                app:larus_blockSpacing="?attr/larus_dp_8"
                app:larus_borderColor="@color/larus_neutral_100"
                app:larus_borderWidth="?attr/larus_dp_5"
                app:larus_corner="?attr/larus_dp_16"
                app:larus_cursorColor="@color/larus_primary_50"
                app:larus_cursorDuration="1000"
                app:larus_cursorWidth="?attr/larus_dp_2"
                app:larus_maxLength="6"
                app:larus_separateEqual="false"
                app:larus_separateType="@integer/larus_type_solid"
                app:larus_showKeyboard="true"
                app:larus_textColor="@color/larus_neutral_100"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/click_country_picker"
                android:paddingTop="?attr/larus_dp_18"
                android:paddingBottom="?attr/larus_dp_18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/country_code_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+86"
                    android:layout_marginStart="?attr/larus_dp_16"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/larus_ic_arrow_down"
                    android:layout_marginStart="?attr/larus_dp_4"/>
            </LinearLayout>
            <EditText
                android:textSize="?attr/larus_dp_16"
                android:textColorHint="@color/larus_neutral_30"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/larus_phone_number_placeholder"
                android:maxLines="1"
                android:inputType="number"
                android:imeOptions="flagNoExtractUi"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_25"
                style="@style/larus_EditTextStyle"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintTop_toBottomOf="@+id/edit_container">
        <CheckBox
            android:gravity="top"
            android:id="@+id/select_privacy_circle_view"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/larus_select_circle_view"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:gravity="top"
            android:layout_gravity="center"
            android:id="@+id/privacy_policy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_0_5"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"/>
    </LinearLayout>
    <Button
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_base_1"
        android:id="@+id/button_login"
        android:background="@drawable/larus_bg_align_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_96"
        android:textAllCaps="false"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@+id/edit_container"
        app:layout_goneMarginTop="?attr/larus_dp_48"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_primary_50"
        android:gravity="center"
        android:id="@+id/login_note"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/dialogFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
