<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="24dp">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/count_down_text_normal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_mic_center_count_down_number"
        android:maxLines="1"
        android:layout_marginEnd="1dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_white_70"
        android:gravity="bottom"
        android:id="@+id/count_down_tips"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_mic_center_count_down_string"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</LinearLayout>
