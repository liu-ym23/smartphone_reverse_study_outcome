<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.android.ttcjpaysdk.base.ui.component.CJCarouselView
        android:id="@+id/cj_pay_carousel_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_marginRight="90dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_alignParentStart="true"/>
    <com.android.ttcjpaysdk.thirdparty.view.CJPayCircularImageView
        android:id="@+id/iv_avatar"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/cj_pay_icon_user_avatar_default"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
