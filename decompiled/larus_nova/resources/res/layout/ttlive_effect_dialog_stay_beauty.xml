<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_effect_bg_stay_beauty_corner"
    android:layout_width="280dp"
    android:layout_height="172dp">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_width="240dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_effect_dialog_stay_beauty_title_content"
        android:contentDescription="@string/ttlive_effect_dialog_stay_beauty_title_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/stay_beauty_no_notice"
            android:background="@drawable/ttlive_bg_official_channel_grab_mic_show_never_notice_unselected"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#99161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ttlive_effect_dialog_stay_beauty_no_notice"
            android:contentDescription="@string/ttlive_effect_dialog_stay_beauty_no_notice"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/stay_beauty_no_notice"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="@drawable/ttlive_dialog_divider_horizontal"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/stay_beauty_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_effect_dialog_stay_beauty_cancel_button"
            android:contentDescription="@string/ttlive_effect_dialog_stay_beauty_cancel_button"
            app:layout_constraintEnd_toEndOf="@+id/center_divider"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/center_divider"
            android:background="@drawable/ttlive_dialog_divider_vertical"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/stay_beauty_continue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_effect_dialog_stay_beauty_continue_button"
            android:contentDescription="@string/ttlive_effect_dialog_stay_beauty_continue_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/center_divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
