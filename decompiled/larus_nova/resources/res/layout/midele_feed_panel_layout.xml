<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pop_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_bg"
        android:layout_width="match_parent"
        android:layout_height="387dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout
        android:id="@+id/shadow_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"
        app:layout_constraintVertical_weight="1"
        style="@style/UDShadow.L.Up">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content"
            android:background="@drawable/facade_round_top_xxl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:backgroundTint="@color/bg_body">
            <View
                android:id="@+id/rl_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_60"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/close_btn"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_24"
                android:layout_height="@dimen/space_kit_len_24"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="@+id/rl_title"
                app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"
                app:srcCompat="@drawable/ud_icon_close_outlined"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="@dimen/font_size_17"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:gravity="center"
                android:id="@+id/tv_page_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:text="@string/Doc_Feed_FeedTitle"
                app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/more_btn"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_24"
                android:layout_height="@dimen/space_kit_len_24"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/rl_title"
                app:layout_constraintTop_toBottomOf="@+id/comment_top_divider"
                app:srcCompat="@drawable/ud_icon_more_outlined"
                app:tint="@color/icon_n1"/>
            <View
                android:id="@+id/comment_top_divider"
                android:background="@drawable/facade_dragview_handler"
                android:visibility="visible"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rl_title"/>
            <View
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ud_divider_size"
                app:layout_constraintTop_toBottomOf="@+id/rl_title"/>
            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/sidebar_smart_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rl_title"
                app:srlEnableLoadMore="false"
                app:srlEnableRefresh="false">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rl_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.scwang.smartrefresh.layout.SmartRefreshLayout>
            <com.bytedance.ee.bear.facade.common.empty.EmptyView
                android:id="@+id/list_no_data_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:content="@layout/middle_feed_message_empty"
                app:layout_constraintBottom_toBottomOf="@+id/sidebar_smart_refresh_layout"
                app:layout_constraintTop_toTopOf="@+id/sidebar_smart_refresh_layout"/>
            <View
                android:id="@+id/mask_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rl_title"/>
            <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                android:orientation="vertical"
                android:id="@+id/no_auth_view"
                android:background="@color/bg_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rl_title"
                app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_preview"
                app:ud_empty_title="@string/CreationMobile_Docs_UnableToAccess_SecurityReason"
                style="@style/SpaceEmptyStatusStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
