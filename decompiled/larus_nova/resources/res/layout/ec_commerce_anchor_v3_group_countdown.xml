<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end"
    android:orientation="vertical"
    android:id="@+id/ll_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#bfffffff"
        android:id="@+id/tv_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/font_size_24"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_ip_activity_logo_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_group_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:id="@+id/anchor_v3_tv_ip_activity_end_tips_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            style="@style/font_size_24"/>
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/tv_hours"
            android:background="@drawable/ec_commerce_bg_anchor_v3_group_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/font_size_24"/>
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:text=":"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            style="@style/font_size_24"/>
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/tv_min"
            android:background="@drawable/ec_commerce_bg_anchor_v3_group_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/font_size_24"/>
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:text=":"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            style="@style/font_size_24"/>
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/tv_sec"
            android:background="@drawable/ec_commerce_bg_anchor_v3_group_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/font_size_24"/>
    </LinearLayout>
</LinearLayout>
