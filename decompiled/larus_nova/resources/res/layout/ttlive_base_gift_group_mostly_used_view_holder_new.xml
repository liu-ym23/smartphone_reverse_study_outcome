<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="94dp"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="94dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/gift_group_bg"
            android:background="@drawable/ttlive_bg_group_top_mostly_used"
            android:layout_width="86dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/iv_loading"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="16dp"
            android:src="@drawable/ttlive_live_img_loading"
            app:layout_constraintBottom_toBottomOf="@+id/gift_group_bg"
            app:layout_constraintEnd_toEndOf="@+id/gift_group_bg"
            app:layout_constraintStart_toStartOf="@+id/gift_group_bg"
            app:layout_constraintTop_toTopOf="@+id/gift_group_bg"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/gift_group_mostly_used_edit_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/gift_group_bg"
            app:layout_constraintEnd_toEndOf="@+id/gift_group_bg"
            app:layout_constraintStart_toStartOf="@+id/gift_group_bg"
            app:layout_constraintTop_toTopOf="@+id/gift_group_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
