<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="68dp"
    android:layout_height="40dp">
    <TextView
        android:textSize="9dp"
        android:textColor="@color/ttlive_lottery_temp_status_text_color"
        android:id="@+id/tv_participation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.18dp"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_lottery_temp_status_text_color"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_participation"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_lottery_temp_status_text_color2"
        android:id="@+id/tv_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/tv_desc"
        android:layout_alignTop="@+id/tv_desc"
        android:layout_toEndOf="@+id/tv_desc"/>
</RelativeLayout>
