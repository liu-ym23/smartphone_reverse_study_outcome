<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bot_maker_bg"
    android:layout_width="?attr/larus_dp_343"
    android:layout_height="?attr/larus_dp_160"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/fl_header"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:layout_marginTop="?attr/larus_dp_16"
            app:cardCornerRadius="?attr/larus_dp_30"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.bmhome.view.RoundAvatarImageView
                android:id="@+id/iv_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:avatar_placeholder="?attr/larus_bg_bot_create_avatar_loading"/>
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/avatar_loading"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_195"
            android:text="bot maker"
            android:maxLines="2"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/fl_header"
            app:layout_constraintStart_toEndOf="@+id/fl_header"
            app:layout_constraintTop_toTopOf="@+id/fl_header"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/fl_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fl_header"
            app:srcCompat="?attr/larus_ic_arrow"/>
        <View
            android:background="?attr/larus_item_divider"
            android:layout_width="?attr/larus_dp_311"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_container"
            android:background="?attr/larus_bg_edit_button"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/button_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_bot_maker_card_edit"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/create_container"
            android:background="?attr/larus_bg_create_button"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_weight="1"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/edit_container">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_static_white"
                android:id="@+id/button_create"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_bot_maker_card_complete"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
