<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.itemview.record.ItemViewRecordCover
        android:id="@+id/record_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/record_cover"/>
    <com.bytedance.ee.bear.bitable.itemview.record.ItemViewRecordCatalog
        android:orientation="vertical"
        android:id="@+id/record_catalog"
        android:background="@drawable/bitable_card_page_record_title_round_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"/>
</merge>
