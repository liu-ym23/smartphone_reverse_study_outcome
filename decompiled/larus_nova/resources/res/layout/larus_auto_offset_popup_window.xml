<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideBubbleLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larus.common_ui.popupwindow.ShadowConstraintLayout
        android:id="@+id/shadowLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topIndicator"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="7dp"
        app:layout_constraintBottom_toTopOf="@+id/contentLayout"
        app:layout_constraintEnd_toEndOf="@+id/contentLayout"
        app:layout_constraintStart_toStartOf="@+id/contentLayout"
        app:srcCompat="?attr/larus_auto_offset_popup_window_top_indicator"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/botIndicator"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="7dp"
        app:layout_constraintEnd_toEndOf="@+id/contentLayout"
        app:layout_constraintStart_toStartOf="@+id/contentLayout"
        app:layout_constraintTop_toBottomOf="@+id/contentLayout"
        app:srcCompat="?attr/larus_auto_offset_popup_window_bot_indicator"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:background="?attr/larus_popup_window_bg"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/placeHolder_3"
        app:layout_constraintEnd_toStartOf="@+id/placeHolder_2"
        app:layout_constraintStart_toEndOf="@+id/placeHolder_1"
        app:layout_constraintTop_toBottomOf="@+id/placeHolder_4">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/closeView"
            android:clickable="true"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_popup_window_close"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/descText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:maxWidth="272dp"
            android:maxLines="3"
            android:fontFamily="sans-serif-medium"
            app:autoSizeMaxTextSize="?attr/larus_sp_16"
            app:autoSizeMinTextSize="?attr/larus_sp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/placeHolder_1"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/contentLayout"/>
    <View
        android:id="@+id/placeHolder_2"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/contentLayout"/>
    <View
        android:id="@+id/placeHolder_3"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/contentLayout"
        app:layout_constraintStart_toStartOf="@+id/contentLayout"/>
    <View
        android:id="@+id/placeHolder_4"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="@+id/contentLayout"
        app:layout_constraintTop_toBottomOf="@+id/contentLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
