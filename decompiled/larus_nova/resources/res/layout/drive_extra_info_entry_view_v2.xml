<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drive_main_page_file_extra_view">
    <View
        android:background="@drawable/space_facade_bg_shadow_default_sm"
        android:layout_width="match_parent"
        android:layout_height="5dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/bg_body"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.drive.biz.extra_info.LikeCircleImageView
            android:id="@+id/drive_like_circle_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.drive.biz.extra_info.LikeInfoView
            android:gravity="center"
            android:id="@+id/drive_like_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/drive_like_circle_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.drive.biz.extra_info.CommentInfoView
            android:id="@+id/comment_card_layout"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/drive_like_item"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDriveCommentInputContainer"
            android:background="@drawable/bg_drive_comment_bar_input_container"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginRight="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/comment_card_layout"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDriveCommentAreaMarker"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_box_comment_outlined"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/tv_comment_enter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Drive_Drive_EnterComment"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ivDriveCommentAreaMarker"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
