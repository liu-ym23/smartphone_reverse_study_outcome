<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_timezone_container"
    android:background="@color/imtoken_message_bg_chat"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="32dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_timezone_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/ud_icon_time_outlined"
            app:tint="@color/icon_n2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_timezone_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_entry"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/icon_n2"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintHorizontal_bias="0"
            app:srcCompat="@drawable/ud_icon_down_right_outlined"/>
    </LinearLayout>
</FrameLayout>
