<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/larus_bg_panel_row"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <FrameLayout
        android:id="@+id/panel_row_icon_container"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/panel_row_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="?attr/larus_sp_18"
            android:textColor="#3370ff"
            android:gravity="center"
            android:id="@+id/panel_row_icon_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/panel_row_icon_border"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_8">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/panel_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/panel_row_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_8"
            android:singleLine="true"
            android:layout_weight="1"
            android:alpha="0.55"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/panel_row_trailing_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:contentDescription="@null"/>
</LinearLayout>
