<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.replay.view.ReplayDragRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_drag_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/float_edge"
        android:background="@drawable/ttlive_replay_float_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/float_round_corner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        app:ttlive_allRadius="4dp">
        <FrameLayout
            android:id="@+id/float_playing_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/float_video_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="end|bottom"
                android:id="@+id/float_mute"
                android:background="@drawable/ttlive_replay_float_mute_selector"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
        <View
            android:layout_gravity="start|bottom"
            android:id="@+id/float_backward"
            android:background="@drawable/ttlive_vs_float_window_back"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="36dp"
            android:layout_marginStart="6dp"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/float_forward"
            android:background="@drawable/ttlive_vs_float_window_forward"
            android:visibility="visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="36dp"
            android:layout_marginEnd="6dp"/>
        <com.bytedance.android.livesdk.chatroom.replay.player.ReplayPlayPauseView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="36dp"/>
        <View
            android:layout_gravity="end|top"
            android:id="@+id/float_close"
            android:background="@drawable/ttlive_replay_ic_float_close"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
</com.bytedance.android.livesdk.chatroom.replay.view.ReplayDragRelativeLayout>
