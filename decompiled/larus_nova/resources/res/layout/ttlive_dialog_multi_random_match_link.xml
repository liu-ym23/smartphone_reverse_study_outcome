<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:text="@string/ttlive_multi_team_pk_matching_dialog_title"
            android:layout_marginStart="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/ttlive_pk_random_cancel_text_size"
            android:textColor="@color/ttlive_pk_random_cancel_text_color"
            android:gravity="center"
            android:id="@+id/cancel_match_btn"
            android:background="@drawable/ttlive_bg_pk_random_cancel"
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_pk_random_cancel_match"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="#1a000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView
            android:id="@+id/shadow_view"
            android:layout_width="match_parent"
            android:layout_height="123dp"
            app:dy="0dp"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:layout_scrollFlags="scroll"
            app:leftShow="false"
            app:rightShow="false"
            app:shadowColor="#33cad4e0"
            app:shadowLimit="8dp"
            app:topShow="false">
            <com.bytedance.android.live.core.widget.HSImageView
                android:background="@color/white"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="113dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_wait_webp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="113dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="113dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_wait_sec_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/ttlive_pk_random_dialog_wait_sec_title"/>
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:id="@+id/tv_waiting"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ttlive_pk_random_dialog_waitting_tips"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_speed_status_container"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_left_sec">
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/ll_speed_up_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#80161823"
                            android:id="@+id/auto_match_panel_sub_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_multi_team_pk_matching_dialog_high_speed_title"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView>
        <View
            android:layout_width="match_parent"
            android:layout_height="33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shadow_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
