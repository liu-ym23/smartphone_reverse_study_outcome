<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/flow_ud_bg_base_3"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <include
        android:id="@+id/organization_checkbox"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/doubao_checkbox"/>
    <FrameLayout
        android:id="@+id/department_icon_container"
        android:background="@drawable/bg_doubao_organization_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_doubao_organization"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/organization_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/organization_checkbox"
        app:layout_constraintStart_toEndOf="@+id/department_icon_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/doubao_picker_title_text"
            android:ellipsize="end"
            android:id="@+id/organization_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/doubao_primary_50"
            android:id="@+id/organization_item_subtitle"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/organization_item_divider"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/organization_text_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
