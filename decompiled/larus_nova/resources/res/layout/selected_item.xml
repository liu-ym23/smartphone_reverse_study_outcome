<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="46dp"
    android:layout_height="56dp"
    android:paddingStart="0dp"
    android:paddingEnd="6dp">
    <com.larksuite.component.ui.avatar.v2.LarkAvatarView
        android:id="@+id/selected_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        app:civ_border_width="0dp"
        app:civ_oval="true"/>
    <com.larksuite.component.ui.avatar.v2.LarkAvatarView
        android:id="@+id/mini_avatar"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:scaleType="centerCrop"
        android:layout_alignBottom="@+id/selected_avatar"
        android:layout_alignEnd="@+id/selected_avatar"
        app:civ_border_width="0dp"
        app:civ_oval="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/selected_team_badge"
        android:background="@drawable/picker_user_team_badge_bg"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignBottom="@+id/selected_avatar"
        android:layout_alignEnd="@+id/selected_avatar"
        app:srcCompat="@drawable/ud_icon_group_filled"
        app:tint="@color/static_white"/>
</RelativeLayout>
