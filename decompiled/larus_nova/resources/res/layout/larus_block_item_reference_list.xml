<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/deep_research_item_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/deep_research_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.larus.bmhome.chat.layout.widget.AtMostHeightRecyclerView
        android:id="@+id/research_reference_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_5"
        android:layout_marginStart="?attr/larus_dp_16"/>
</LinearLayout>
