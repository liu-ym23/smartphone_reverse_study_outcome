<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/larus_bg_discovery_button"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginBottom="?attr/larus_dp_12"
    android:paddingStart="?attr/larus_dp_18"
    android:paddingEnd="?attr/larus_dp_24"
    android:layout_marginStart="?attr/larus_dp_16"
    android:layout_marginEnd="?attr/larus_dp_16"
    android:elevation="?attr/larus_dp_2">
    <ImageView
        android:id="@+id/image"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:src="@drawable/larus_ic_bot_discovery"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_8"/>
</LinearLayout>
