<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_v_mg_mount_task_change_dialog_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:id="@+id/price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_v_mg_mount_task_desc_price"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:id="@+id/settlement_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_v_mg_mount_task_desc_settlement"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#04498d"
        android:id="@+id/open_detail_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="查看详情"
        android:drawableEnd="@drawable/ttlive_mg_task_change_dialog_ic_arrow_right"/>
</LinearLayout>
