<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/link_video_bottom_introduce_option_area_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <View
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="12dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:text="@string/ttlive_text_link_video_introduce_info"/>
        <Button
            android:textColor="@color/ttlive_color_link_video_introduce_info_text"
            android:id="@+id/link_video_bottom_introduce_option_area_btn"
            android:background="@drawable/ttlive_bg_link_video_introduce_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="34dp"
            android:text="@string/ttlive_text_link_video_introduce_btn_text"/>
    </LinearLayout>
</LinearLayout>
