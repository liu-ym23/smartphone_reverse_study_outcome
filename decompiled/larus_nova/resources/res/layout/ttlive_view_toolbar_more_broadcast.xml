<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttlive_broadcast_toolbar_more"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <com.facebook.drawee.view.SimpleDraweeView xmlns:fresco="http://schemas.android.com/apk/res-auto"
        android:id="@+id/more_toolbar_icon_animation"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        fresco:actualImageScaleType="center"/>
    <FrameLayout
        android:id="@+id/avatar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="top|right"
            android:id="@+id/avatar_right_top"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom|left"
            android:id="@+id/avatar_left_bottom"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="4dp"/>
    </FrameLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/more_toolbar_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_ic_more_broadcast"/>
    <com.bytedance.android.livesdk.chatroom.widget.LiveCircleProgressView
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.RedDotView
        android:id="@+id/view_red_dot"
        android:background="@drawable/ttlive_ic_filter_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
