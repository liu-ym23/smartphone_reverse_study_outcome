<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.ss.android.update.MaxSizeLinearLayout
        android:orientation="vertical"
        android:background="@drawable/mail_upgrade_introduce"
        android:paddingLeft="40dp"
        android:paddingTop="0dp"
        android:paddingRight="40dp"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="240dp"
        app:maxWidth="320dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="23sp"
                android:textColor="#464646"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/divider1"
                android:background="#707070"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="4dp"/>
            <View
                android:id="@+id/divider2"
                android:background="#707070"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ScrollView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="100dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff6d6d"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/downloaded_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/update_already_download_hint"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#464646"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"/>
            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/update_btn_layout"
            android:layout_width="@dimen/update_btn_width"
            android:layout_height="@dimen/update_btn_width"
            android:layout_marginBottom="28dp">
            <ImageView
                android:id="@+id/update_bg"
                android:background="@drawable/default_upgrade_introduce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:id="@+id/update_progress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/update_btn_width"
                android:maxHeight="@dimen/update_btn_width"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/update_dlg_progress"
                android:indeterminateDuration="750"
                android:minWidth="@dimen/update_btn_width"
                android:minHeight="@dimen/update_btn_width"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/update_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.1"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/update_progress_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/updating_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/label_updating"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff6d6d"
            android:layout_gravity="center_horizontal"
            android:id="@+id/later_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"/>
    </com.ss.android.update.MaxSizeLinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bind_app_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:background="@drawable/bg_bind_app_checkbox"
            android:duplicateParentState="true"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/bg_bind_app_checkbox_popping"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
