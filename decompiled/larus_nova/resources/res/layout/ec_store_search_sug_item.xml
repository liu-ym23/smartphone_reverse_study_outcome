<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/store_search_icon"
        android:layout_width="16sp"
        android:layout_height="16sp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/store_search_icon"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/shopping_color_161823"
        android:ellipsize="end"
        android:id="@+id/store_search_sug_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="2dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/store_search_sug_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/store_search_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:gravity="center"
        android:id="@+id/store_search_sug_icon"
        android:visibility="gone"
        android:layout_width="16sp"
        android:layout_height="16sp"
        android:layout_marginTop="1dp"
        android:layout_marginStart="4dp"
        app:actualImageScaleType="focusCrop"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/store_search_sug_completion"
        app:layout_constraintStart_toEndOf="@+id/store_search_sug_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/store_search_sug_completion"
        android:visibility="visible"
        android:layout_width="16sp"
        android:layout_height="16sp"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/shopping_ic_search_sug_completion"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="#1a161823"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
