<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_obric_g_gesture_options_title_bar">
        <ScrollView
            android:id="@+id/dora_obric_g_gesture_options_scroll_view"
            android:scrollbars="none"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dora_obric_g_gesture_options_content"
                android:paddingTop="8dp"
                android:paddingBottom="56dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/dora_obric_g_gesture_options_preview_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="189dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp">
                    <ImageView
                        android:id="@+id/dora_obric_g_gesture_options_device_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/dora_obric_g_gesture_options_device_lottie"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>
                </androidx.cardview.widget.CardView>
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:id="@+id/dora_obric_g_gesture_options_group_title"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/dora_obric_g_gesture_options_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/dora_obric_g_gesture_options_page_mask"
            android:background="@color/larus_dora_page_mask_color"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/dora_obric_g_gesture_options_title_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
