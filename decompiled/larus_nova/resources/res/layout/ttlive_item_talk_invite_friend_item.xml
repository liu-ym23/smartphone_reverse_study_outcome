<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:maxHeight="104dp">
    <FrameLayout
        android:id="@+id/img_avatar_panel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/inviter_avatar"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="end|bottom"
            android:id="@+id/inviter_gender_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_invite"
        android:background="@drawable/ttlive_friend_invite_enable"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_invite"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_info_panel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        android:layout_toLeftOf="@+id/btn_invite"
        android:layout_toRightOf="@+id/img_avatar_panel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/btn_invite"
        android:layout_toEndOf="@+id/img_avatar_panel">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/img_rank_top"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/img_honor_badge"
                android:visibility="gone"
                android:layout_width="31dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/img_fans_panel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp">
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ttlive_white"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/img_fans_content"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:lines="1"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#a2a3a7"
            android:id="@+id/tv_dou_money"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</RelativeLayout>
