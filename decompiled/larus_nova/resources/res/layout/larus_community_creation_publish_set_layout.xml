<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/larus_base_2"
    app:rv_cornerRadius="?attr/larus_dp_16">
    <View
        android:id="@+id/loading_view1"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/loading_view2"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_199"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loading_view1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_prompt"
        android:padding="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:ellipsize="end"
            android:id="@+id/tv_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="?attr/larus_dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/distance_view"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_prompt"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ref_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/distance_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_prompt"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_creation"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/tv_creation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_image_publish_toggle_reference_public"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_info_icon"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:src="@drawable/larus_icon_publish_ref_info"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_creation"
            app:layout_constraintStart_toEndOf="@+id/tv_creation"
            app:layout_constraintTop_toTopOf="@+id/tv_creation"/>
        <com.larus.bmhome.view.item.CustomSwitchCompat
            android:id="@+id/toggle"
            android:layout_width="?attr/larus_dp_51"
            android:layout_height="?attr/larus_dp_31"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
