<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/effect_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.ugc.aweme.views.CircleDraweeView
        android:layout_gravity="center"
        android:id="@+id/effect_resource_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="start|top"
        android:id="@+id/iv_sticker_state"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/av_ic_effects_speaker_mute"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/shadow_view"
        android:background="@color/tools_media_item_shadow"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/fl_image_select_indicator"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/tools_const_tInverse"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/image_select_indicator"
            android:background="@drawable/av_ic_new_preview_index_bg"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/img_sticker_loading"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_margin="1dp"
        android:src="@drawable/av_ic_effects_download"
        android:scaleType="fitXY"/>
    <com.ss.android.ugc.tools.view.widget.CircleProgressView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_loading"
        android:background="@drawable/av_ic_effects_downloading_bg"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_margin="1dp"
        app:ts_loading_circle_radius="5dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_loading_center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textSize="13sp"
        android:textColor="@color/tools_std_text_primary"
        android:layout_gravity="end|bottom"
        android:id="@+id/tv_time_stamp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="ProximaNova-Semibold"/>
</FrameLayout>
