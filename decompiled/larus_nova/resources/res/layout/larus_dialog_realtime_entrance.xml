<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_bg_dialog_realtime_entrance_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_video_call_entrance"
        android:background="?attr/larus_bg_realtime_entrance_item_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/larus_icon_dialog_video_call"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_call_videoCall_title"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:id="@+id/fl_video_call_entrance_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_voice_call_entrance"
        android:background="?attr/larus_bg_realtime_entrance_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/larus_icon_dialog_phone_call"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_call_voiceCall_title"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:id="@+id/fl_voice_call_entrance_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_share_screen_entrance"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/larus_icon_dialog_share_screen"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_call_shareScreen_title"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <View
        android:id="@+id/fl_share_screen_entrance_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_call_scene_entrance"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/larus_icon_dialog_call_scene"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_call_scene"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_call_callScene_title"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <View
        android:background="?attr/larus_base_2_overlay"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_videoVoiceCall_sheet_cancel"/>
</LinearLayout>
