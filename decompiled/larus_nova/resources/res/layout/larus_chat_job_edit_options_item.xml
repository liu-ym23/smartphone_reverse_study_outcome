<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_chat_job_edit_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_repeat_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:id="@+id/larus_chat_job_edit_repeat_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_repeat_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowLabelStyle"/>
        <TextView
            android:id="@+id/larus_chat_job_edit_repeat_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_repeat_arrow"
            app:layout_constraintStart_toEndOf="@+id/larus_chat_job_edit_repeat_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowValueStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_chat_job_edit_repeat_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_chat_job_edit_chevron_right_ic"
            app:tint="?attr/larus_neutral_30"
            style="@style/Larus.ChatJobEditRowArrowStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/larus_chat_job_edit_repeat_divider"
        style="@style/Larus.ChatJobEditRowDividerStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_run_time_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:id="@+id/larus_chat_job_edit_run_time_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_run_time_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowLabelStyle"/>
        <TextView
            android:id="@+id/larus_chat_job_edit_run_time_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_run_time_arrow"
            app:layout_constraintStart_toEndOf="@+id/larus_chat_job_edit_run_time_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowValueStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_chat_job_edit_run_time_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_chat_job_edit_chevron_right_ic"
            app:tint="?attr/larus_neutral_30"
            style="@style/Larus.ChatJobEditRowArrowStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/larus_chat_job_edit_run_time_divider"
        style="@style/Larus.ChatJobEditRowDividerStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_model_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:id="@+id/larus_chat_job_edit_model_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_model_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowLabelStyle"/>
        <TextView
            android:id="@+id/larus_chat_job_edit_model_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_model_arrow"
            app:layout_constraintStart_toEndOf="@+id/larus_chat_job_edit_model_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowValueStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_chat_job_edit_model_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_chat_job_edit_chevron_right_ic"
            app:tint="?attr/larus_neutral_30"
            style="@style/Larus.ChatJobEditRowArrowStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/larus_chat_job_edit_model_divider"
        style="@style/Larus.ChatJobEditRowDividerStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_environment_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:id="@+id/larus_chat_job_edit_environment_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_environment_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowLabelStyle"/>
        <TextView
            android:id="@+id/larus_chat_job_edit_environment_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_environment_arrow"
            app:layout_constraintStart_toEndOf="@+id/larus_chat_job_edit_environment_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowValueStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_chat_job_edit_environment_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_chat_job_edit_chevron_right_ic"
            app:tint="?attr/larus_neutral_30"
            style="@style/Larus.ChatJobEditRowArrowStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/larus_chat_job_edit_environment_divider"
        style="@style/Larus.ChatJobEditRowDividerStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/larus_chat_job_edit_project_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <TextView
            android:id="@+id/larus_chat_job_edit_project_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_project_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowLabelStyle"/>
        <TextView
            android:id="@+id/larus_chat_job_edit_project_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/larus_chat_job_edit_project_arrow"
            app:layout_constraintStart_toEndOf="@+id/larus_chat_job_edit_project_label"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Larus.ChatJobEditRowValueStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/larus_chat_job_edit_project_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_chat_job_edit_chevron_right_ic"
            app:tint="?attr/larus_neutral_30"
            style="@style/Larus.ChatJobEditRowArrowStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
