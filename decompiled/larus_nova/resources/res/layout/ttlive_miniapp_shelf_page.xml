<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shelf_page_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="592dp"
    android:minHeight="300dp">
    <ViewStub
        android:id="@+id/top_view_stub"
        android:inflatedId="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.MaxHeightRecyclerView
        android:id="@+id/shelf_page_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_view"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
