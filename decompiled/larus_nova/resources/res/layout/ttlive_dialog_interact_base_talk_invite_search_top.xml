<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="12dp">
    <RelativeLayout
        android:id="@+id/dummy_edit"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/dummy_invite_search_edt"
            android:background="@drawable/ttlive_bg_interact_audio_talk_search_top"
            android:paddingLeft="4dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_audio_talk_invite_search_hint"
            android:drawableLeft="@drawable/ttlive_interact_ic_search"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/really_rl"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">
        <EditText
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_1"
            android:gravity="center_vertical"
            android:id="@+id/invite_search_edt"
            android:background="@drawable/ttlive_bg_interact_audio_talk_search_top"
            android:paddingLeft="4dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:drawableLeft="@drawable/ttlive_interact_ic_search"
            android:inputType="text"
            android:imeOptions="actionSearch"/>
        <TextView
            android:id="@+id/hint_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:text="@string/ttlive_audio_talk_invite_search_hint"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/clear_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:src="@drawable/ttlive_interact_ic_pk_rivals_search_clear"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_audio_talk_search_btn"
        android:id="@+id/close_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="@string/ttlive_audio_talk_invite_search_close"/>
</LinearLayout>
