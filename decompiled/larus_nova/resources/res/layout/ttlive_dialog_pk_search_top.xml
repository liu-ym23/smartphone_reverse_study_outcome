<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="9dp"
        android:layout_weight="1"
        android:layout_marginStart="9dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/search_bt"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:src="@drawable/ttlive_ic_pk_search_list"/>
        <EditText
            android:textSize="14dp"
            android:textColor="@color/black"
            android:textColorHint="@color/ttlive_interact_default_text_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_edit"
            android:background="#00161823"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:hint="@string/ttlive_live_pk_search"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/ttlive_bg_pk_rivals_edit_cursor"/>
        <ImageView
            android:id="@+id/clear_bt"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_ic_pk_rivals_search_clear"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/cancel"
        android:layout_width="62dp"
        android:layout_height="36dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
