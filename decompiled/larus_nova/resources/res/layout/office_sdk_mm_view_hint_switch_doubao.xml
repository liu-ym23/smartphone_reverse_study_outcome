<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
        android:textSize="17sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:id="@+id/setting_item_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="5"
        app:layout_constraintBottom_toTopOf="@+id/setting_item_content_desc"
        app:layout_constraintEnd_toStartOf="@+id/item_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ux_line_height="22sp"/>
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/flow_ud_neutral_50"
        android:id="@+id/setting_item_content_desc"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_item_content"
        app:ux_line_height="@dimen/dp_20"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/item_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="setting_item_switch,setting_item_icon_desc,setting_item_icon,setting_item_mask,setting_icon_item_mask"/>
    <com.ss.android.lark.foundation.widget.FlowSwitch
        android:id="@+id/setting_item_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_barrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/setting_item_mask"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_barrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/flow_ud_neutral_50"
        android:id="@+id/setting_item_icon_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="137.5dp"
        android:maxLines="10"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/setting_item_icon"
        app:layout_constraintStart_toEndOf="@+id/item_barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:ux_line_height="@dimen/dp_20"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/setting_item_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/setting_item_icon_desc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        app:srcCompat="@drawable/office_sdk_mm_ic_right_doubao"
        app:tint="@color/flow_ud_neutral_30"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/setting_item_check_icon"
        android:padding="@dimen/dp_2"
        android:visibility="gone"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
        app:tint="@color/flow_ud_primary_50"/>
    <View
        android:id="@+id/setting_icon_item_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/setting_item_icon"
        app:layout_constraintStart_toStartOf="@+id/item_barrier"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
