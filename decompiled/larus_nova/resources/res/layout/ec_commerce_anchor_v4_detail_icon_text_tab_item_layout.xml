<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v4_detail_icon_text_tab_item_layout_1523043028"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:id="@+id/selector_bg"
        android:background="@drawable/ec_commerce_anchor_v4_detail_icontext_selector_bg"
        android:layout_width="100dp"
        android:layout_height="100dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/image_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tab_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundedCornerRadius="10dp"
            fresco:roundingBorderColor="@color/commerce_color_33161823"
            fresco:roundingBorderWidth="1dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tab_cover_img"
            android:background="@drawable/anchor_v4_properties_icon_bkg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundedCornerRadius="10dp"
            fresco:roundingBorderColor="@color/commerce_color_33161823"
            fresco:roundingBorderWidth="1dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tab_text"
        android:background="@drawable/ec_commerce_anchor_v4_detail_icontext_text_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="98dp"
        android:layout_height="24dp"
        android:singleLine="true"/>
</FrameLayout>
