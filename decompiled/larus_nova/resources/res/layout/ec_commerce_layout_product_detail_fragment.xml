<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/anchor_v4_status_bar_space_keeper"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"/>
    <com.bytedance.android.shopping.anchorv4.widgets.PdpCoordinateLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/touch_outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:soundEffectsEnabled="false"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:id="@+id/layout_bottom_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/commerce_design_bottom_sheet"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.bytedance.android.shopping.anchorv3.compat.ToggleBottomSheetBehavior"
            style="?attr/bottomSheetStyle"/>
    </com.bytedance.android.shopping.anchorv4.widgets.PdpCoordinateLayout>
    <FrameLayout
        android:id="@+id/layout_top_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout>
