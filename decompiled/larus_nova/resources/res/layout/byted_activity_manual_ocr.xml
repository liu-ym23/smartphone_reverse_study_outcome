<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.bytedcert.view.camera.MyPreview
        android:id="@+id/ocr_take_photo_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/byted_transparent_gray_72"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ocr_take_photo_return_back"
            android:padding="5dp"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:layout_marginLeft="19dp"
            android:layout_marginTop="60dp"
            android:src="@mipmap/byted_return_white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.ss.android.bytedcert.view.ClipHoleView
            android:id="@+id/clip_hole_view"
            android:layout_width="252dp"
            android:layout_height="414dp"
            android:layout_marginBottom="130dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/byted_front_new"
            android:layout_width="414dp"
            android:layout_height="252dp"
            android:layout_marginBottom="130dp"
            android:src="@mipmap/byted_id_card_front_mask"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/byted_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/ocr_take_photo_prompt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/byted_ocr_take_front"
            android:maxLines="1"
            android:rotation="90"
            app:layout_constraintBottom_toBottomOf="@+id/byted_front_new"
            app:layout_constraintLeft_toLeftOf="@+id/byted_front_new"
            app:layout_constraintRight_toRightOf="@+id/byted_front_new"
            app:layout_constraintTop_toTopOf="@+id/byted_front_new"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/byted_white"
            android:layout_gravity="center"
            android:id="@+id/ocr_take_photo_prompt_bottom_text"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="@string/byted_take_front_photo_prompt_text"
            app:layout_constraintBottom_toTopOf="@+id/ocr_take_photo_take"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/byted_white"
            android:layout_gravity="center"
            android:id="@+id/ocr_take_photo_take"
            android:background="@color/byted_red_FE2C55"
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:layout_marginBottom="30dp"
            android:text="开始拍摄"
            app:layout_constraintBottom_toTopOf="@+id/ocr_from_ablum_txt"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/byted_white"
            android:gravity="center"
            android:id="@+id/ocr_from_ablum_txt"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="50dp"
            android:text="@string/byted_take_front_photo_try_ablum_upload"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
