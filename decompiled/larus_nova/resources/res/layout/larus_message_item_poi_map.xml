<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_card_common_height"
    app:cardBackgroundColor="?attr/larus_base_1"
    app:cardCornerRadius="?attr/larus_card_common_radius"
    app:cardElevation="0dp">
    <com.larus.bmhome.chat.map.PoiMapConstraintLayout
        android:id="@+id/cl_map_container"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_card_common_height">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_poi_container"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_card_poi_item_height"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sdv_poi_image"
                android:layout_width="?attr/larus_card_poi_avatar_size"
                android:layout_height="?attr/larus_card_poi_avatar_size"
                android:layout_marginStart="?attr/larus_card_common_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="?attr/larus_poi_image_loading"
                app:roundedCornerRadius="?attr/larus_card_poi_avatar_radius"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_poi_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_card_common_margin"
                app:layout_constraintBottom_toBottomOf="@+id/sdv_poi_image"
                app:layout_constraintLeft_toRightOf="@+id/sdv_poi_image"
                app:layout_constraintTop_toTopOf="@+id/sdv_poi_image">
                <TextView
                    android:textSize="?attr/larus_poi_title_sp"
                    android:textColor="?attr/larus_neutral_100"
                    android:ellipsize="end"
                    android:id="@+id/tv_poi_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="?attr/larus_poi_title_max_width"
                    android:lines="1"/>
                <TextView
                    android:textSize="?attr/larus_poi_hint_sp"
                    android:textColor="?attr/larus_neutral_70"
                    android:ellipsize="end"
                    android:id="@+id/tv_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="?attr/larus_poi_title_max_width"
                    android:lines="1"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_score_container"
                        android:layout_width="wrap_content"
                        android:layout_height="?attr/larus_poi_score_height"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="?attr/larus_poi_hint_sp"
                        android:textColor="?attr/larus_neutral_70"
                        android:id="@+id/tv_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="?attr/larus_poi_score_divider_size"
                        app:layout_constraintBottom_toBottomOf="@+id/ll_score_container"
                        app:layout_constraintStart_toEndOf="@+id/ll_score_container"
                        app:layout_constraintTop_toTopOf="@+id/ll_score_container"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="?attr/larus_poi_jump_img_size"
                android:layout_height="?attr/larus_poi_jump_img_size"
                android:src="@drawable/larus_poi_jump"
                android:layout_marginEnd="?attr/larus_card_common_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.bmhome.chat.map.PoiMapConstraintLayout>
</androidx.cardview.widget.CardView>
