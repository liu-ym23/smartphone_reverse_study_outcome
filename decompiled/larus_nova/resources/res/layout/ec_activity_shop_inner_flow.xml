<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/ec_shop_inner_flow_toolbar"
        layout="@layout/ec_shop_layout_inner_flow_toolbar"/>
    <FrameLayout
        android:id="@+id/ec_shop_inner_flow_fl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.window.shop.innerflow.widget.ECWindowInnerFlowRecyclerView
            android:id="@+id/ec_shop_inner_flow_recyclerview"
            android:background="@color/ec_shop_inner_flow_background_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.window.shop.widget.WindowStatusView
            android:id="@+id/ec_shop_inner_flow_status_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
