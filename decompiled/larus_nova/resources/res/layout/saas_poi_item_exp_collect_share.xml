<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@color/POIBgPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12sp"
            android:textColor="@color/POITextPrimary"
            android:ellipsize="end"
            android:id="@+id/poi_collect_share_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/poi_ic_more_right_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/poi_collect_share_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_image_view"
            android:padding="5dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_xmark_outlined"
            app:tint="@color/POITextPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar_container"
        android:background="@drawable/poi_bg_collect_share"
        android:layout_width="216dp"
        android:layout_height="100dp"
        android:layout_marginTop="17dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/three_avatar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.locallife.poi.newdetail.widget.HollowClipCircleImageView
                android:id="@+id/second_avatar_in_three_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="92dp"
                app:clip_radius="34dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="20dp"
                app:x_offset="66dp"
                app:y_offset="20dp"/>
            <com.bytedance.locallife.poi.newdetail.widget.HollowClipCircleImageView
                android:id="@+id/third_avatar_in_three_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="92dp"
                app:clip_radius="34dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="20dp"
                app:x_offset="-26dp"
                app:y_offset="20dp"/>
            <com.bytedance.locallife.poi.newdetail.widget.CircleImageView
                android:id="@+id/first_avatar_in_three_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="30dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/two_avatar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.locallife.poi.newdetail.widget.HollowClipCircleImageView
                android:id="@+id/second_avatar_in_two_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="52dp"
                app:clip_radius="34dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="30dp"
                app:x_offset="-22dp"
                app:y_offset="30dp"/>
            <com.bytedance.locallife.poi.newdetail.widget.CircleImageView
                android:id="@+id/first_avatar_in_two_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="52dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="30dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/one_avatar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.locallife.poi.newdetail.widget.CircleImageView
                android:id="@+id/first_avatar_in_one_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="30dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <com.bytedance.locallife.dito.baseview.RoundFrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/share_button"
        android:background="@color/POIPrimary"
        android:layout_width="165dp"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="20dp"
        app:rounded_radius="4dp">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15sp"
            android:textColor="@color/ConstTextInverse"
            android:layout_gravity="center"
            android:id="@+id/share_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/poi_collect_share_btn_text"/>
    </com.bytedance.locallife.dito.baseview.RoundFrameLayout>
</LinearLayout>
