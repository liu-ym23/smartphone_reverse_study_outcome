<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.GestureDetectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:countDown="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/zeroth_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom"
            android:id="@+id/bg_anchor_interact"
            android:background="#303342"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/anchor_interact_play_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/virtual_live_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/multi_anchor_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/media_multi_anchor_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/screen_live_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ai_mv_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_theme_bg_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/radio_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/audio_scene_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/top_atmosphere_effect_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/audio_ktv_room_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/normal_interact_window_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_talkroom_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/new_video_talkroom_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mic_seat_ui_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_debug_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_multi_container"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_multi_container_preload_ui"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/virtual_live_preview_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/cloud_group_live_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_revenue_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/revenue_load_service_holder"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_screen_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_pk_audience_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/game_debug_test_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/first_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/end_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/broadcast_pause_page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/draw_guess_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/open_game_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/live_decoration_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/pk_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ceremony_border_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mic_room_count_down_widget"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:layout_gravity="center"
            android:id="@+id/anchor_pause_tips_view"
            android:visibility="gone"
            android:layout_width="188dp"
            android:layout_height="166dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/filter_style"
            android:paddingTop="@dimen/ttlive_filter_margin_top"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
                android:id="@+id/view_filter_arrow1"
                android:visibility="gone"
                android:layout_width="@dimen/ttlive_filter_switch_arrow_size"
                android:layout_height="@dimen/ttlive_filter_switch_arrow_size"
                android:src="@drawable/ttlive_live_img_arrow_filterswitch_left"/>
            <TextView
                android:textSize="@dimen/ttlive_filter_text_size"
                android:textColor="@color/ttlive_core_hs_s5"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/filter_style_text"
                android:layout_width="192dp"
                android:layout_height="32dp"
                android:layout_marginLeft="@dimen/ttlive_filter_text_margin"
                android:layout_marginRight="@dimen/ttlive_filter_text_margin"
                android:text="@string/ttlive_slide_right_and_left_to_switch_filter"
                android:shadowColor="@color/ttlive_filter_name_shadow_color"
                android:shadowDx="1"
                android:shadowDy="1"
                android:lineSpacingExtra="8dp"
                android:layout_marginStart="@dimen/ttlive_filter_text_margin"
                android:layout_marginEnd="@dimen/ttlive_filter_text_margin"/>
            <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
                android:id="@+id/view_filter_arrow2"
                android:visibility="gone"
                android:layout_width="@dimen/ttlive_filter_switch_arrow_size"
                android:layout_height="@dimen/ttlive_filter_switch_arrow_size"
                android:src="@drawable/ttlive_live_img_arrow_filterswitch_right"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_hint_face_detect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="152dp">
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ttlive_img_facial_recognition"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#b3ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_live_no_face_detected"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/gesture_magic_tip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/font_layer_master_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/interaction_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ktv_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <FrameLayout
            android:id="@+id/inroom_pk_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_animate_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/paid_profile_card_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/midi_score_debug_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/live_layer_master_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/floating_layer_master_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/mock_video_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.chatroom.widget.CountDownView
                android:layout_gravity="center"
                android:id="@+id/count_down_view"
                android:background="@drawable/ttlive_bg_circle_s1_50"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@string/ttlive_broadcast_count_down_desc"
                countDown:count_down="4000"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/anchor_hint"
                android:visibility="gone"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="小贴士：出镜在画面中心能让观看体验更好"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/clean_screen_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/preview_start_zoom_container"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </FrameLayout>
</com.bytedance.android.livesdk.widget.GestureDetectLayout>
