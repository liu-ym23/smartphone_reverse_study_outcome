<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="?attr/cj_pay_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_tips_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJMaxHeightScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:maxHeight="256dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_tips_dialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
    </com.android.ttcjpaysdk.base.ui.widget.CJMaxHeightScrollView>
    <View
        android:id="@+id/cj_pay_tips_dialog_divider"
        android:background="?attr/cj_pay_border_divider_grey_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_below="@+id/cj_pay_tips_dialog_content"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/cj_pay_text_primary"
        android:gravity="center"
        android:id="@+id/cj_pay_tips_dialog_single_btn_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_below="@+id/cj_pay_tips_dialog_divider"/>
</LinearLayout>
