<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/bg_base"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:layout_gravity="start|bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/Lark_Bio_Visibility_SelectContact_Desc"
            android:layout_marginStart="16dp"/>
    </FrameLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/picker_scenario_entry_personnel_type"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/colorful_green"
            app:srcCompat="@drawable/ud_icon_personal_info_outlined"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Bio_Visibility_AddByWorkforceType_Button"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/picker_scenario_entry_permission_group"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/colorful_blue"
            app:srcCompat="@drawable/ud_icon_group_outlined"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Bio_Visibility_AddUserGroup_Button"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</LinearLayout>
