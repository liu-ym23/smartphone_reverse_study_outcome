<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
        android:layout_gravity="bottom"
        android:id="@+id/dragView"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:panel_background_color="@color/bg_float"
        app:panel_enable_drag="false"
        app:panel_right_menu_type="text"
        app:panel_right_text="@string/Bitable_Common_ButtonDone"
        app:panel_right_text_color="@color/primary_content_default"
        app:panel_show_divider="false"
        app:panel_show_drag_handler="false"
        app:panel_show_left_icon="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/inputBarParent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_placeholder"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/inputBarCode"
                    android:paddingLeft="@dimen/space_kit_len_12"
                    android:paddingRight="@dimen/space_kit_len_12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_48"
                    android:layout_marginTop="@dimen/space_kit_len_4"
                    android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
                    android:singleLine="true"
                    android:lineSpacingMultiplier="1.2"
                    android:imeOptions="actionDone"
                    android:layout_marginStart="@dimen/space_kit_len_16"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    app:ud_backgroundColor="@color/bitable_page_cell_barcode_input_bg_color"
                    app:ud_radius="m"
                    app:ud_strokeColor="@color/bitable_field_edittext_stroke_color"
                    app:ud_strokeWidth="@dimen/space_kit_len_1"
                    style="@style/SpaceEditTextStyle"/>
            </FrameLayout>
            <com.larksuite.component.universe_design.button.UDButton
                android:textColor="@color/text_title"
                android:id="@+id/scanInputBtn"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_kit_len_17"
                android:layout_marginBottom="@dimen/space_kit_len_24"
                android:layout_marginStart="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                app:ud_backgroundColor="@color/bitable_cell_edit_panel_btn_bg"
                app:ud_strokeColor="@color/line_border_component"
                app:ud_strokeWidth="1dp"
                style="@style/UDButton.Big.Primary"/>
            <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView>
</FrameLayout>
