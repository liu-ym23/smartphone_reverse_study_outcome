<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/invisible_cover_placeholder"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_32"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/playlist_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:lines="1"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/edit_music_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invisible_cover_placeholder"/>
    <ImageView
        android:id="@+id/edit_music_name"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_21"
        android:layout_height="?attr/larus_dp_21"
        android:layout_marginStart="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toStartOf="@+id/op_container"
        app:layout_constraintStart_toEndOf="@+id/title_text"
        app:layout_constraintTop_toTopOf="@+id/title_text"
        app:srcCompat="@drawable/larus_ic_edit_white"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="start|top"
        android:id="@+id/author_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        app:layout_constraintEnd_toEndOf="@+id/title_text"
        app:layout_constraintStart_toStartOf="@+id/title_text"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <FrameLayout
        android:id="@+id/op_container"
        android:padding="?attr/larus_dp_7"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginEnd="?attr/larus_dp_25"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_text">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_btn"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_42"
            android:layout_height="?attr/larus_dp_42"
            app:srcCompat="@drawable/larus_ic_music_player_detail_play"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pause_btn"
            android:layout_width="?attr/larus_dp_42"
            android:layout_height="?attr/larus_dp_42"
            app:srcCompat="@drawable/larus_ic_music_player_detail_pause"/>
    </FrameLayout>
    <com.larus.bmhome.music.widget.MusicPlayerLyricView
        android:id="@+id/lyric_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_111"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_18"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_34"
        app:layout_constraintTop_toBottomOf="@+id/author_text"/>
</merge>
