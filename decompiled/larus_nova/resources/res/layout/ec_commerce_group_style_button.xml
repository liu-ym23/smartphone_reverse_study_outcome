<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_group_style_button_1619487919"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.AutoResizePriceContainer
        android:id="@+id/group_discount_price_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            style="@style/font_size_20"/>
        <Space
            android:id="@+id/group_discount_space"
            android:layout_width="2dp"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_discount"
            android:layout_toEndOf="@+id/tv_discount"/>
        <com.bytedance.android.shopping.widget.PriceView
            android:id="@+id/price_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/group_discount_space"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/group_discount_space"
            app:extraTextSize="10dp"
            app:priceBold="true"
            app:priceTextSize="14dp"
            app:spaceSize="2dp"/>
    </com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="2dp"/>
    <TextView
        android:textSize="12sp"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:lineSpacingExtra="2dp"/>
</LinearLayout>
