<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_interact_flex_history_circle"
            android:layout_width="9dp"
            android:layout_height="9dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_daily_pair_rank_top_default"
            android:layout_gravity="center_vertical"
            android:id="@+id/battle_start_time"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:minWidth="28dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/ttlive_interact_flex_history_line"
        android:layout_width="9dp"
        android:layout_height="72dp"
        android:layout_marginLeft="16dp"
        android:layerType="software"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_container"
        android:background="@drawable/ttlive_interact_flex_history_info"
        android:layout_width="327dp"
        android:layout_height="60dp"
        android:layout_marginLeft="29dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_container">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/opposite_headview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="42dp"
            android:layout_marginTop="10dp"
            app:layout_constraintLeft_toLeftOf="@+id/info_container"
            app:layout_constraintTop_toTopOf="@+id/info_container"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/opposite_ring"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_interact_flex_history_headring"
            app:layout_constraintLeft_toLeftOf="@+id/opposite_headview"
            app:layout_constraintTop_toTopOf="@+id/opposite_headview"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/my_headview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintLeft_toLeftOf="@+id/info_container"
            app:layout_constraintTop_toTopOf="@+id/info_container"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/my_ring"
            android:background="@drawable/ttlive_interact_flex_history_headring2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintLeft_toLeftOf="@+id/my_headview"
            app:layout_constraintTop_toTopOf="@+id/my_headview"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/result_text"
            android:background="@drawable/ttlive_interact_flex_history_result2"
            android:layout_width="36dp"
            android:layout_height="14dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="27dp"
            android:text="@string/ttlive_interact_link_room_fight_history_win"
            app:layout_constraintLeft_toLeftOf="@+id/my_headview"
            app:layout_constraintTop_toTopOf="@+id/my_headview"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_pk_time_choose_cancel"
            android:gravity="center_vertical"
            android:id="@+id/name_text"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:maxWidth="233dp"
            android:singleLine="true"
            app:layout_constraintLeft_toRightOf="@+id/opposite_headview"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_pk_feedback_tag_unselected"
            android:gravity="center_vertical"
            android:id="@+id/my_score"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="1dp"
            app:layout_constraintLeft_toRightOf="@+id/opposite_headview"
            app:layout_constraintTop_toBottomOf="@+id/name_text"/>
        <View
            android:id="@+id/pk_icon"
            android:background="@drawable/ttlive_interact_flex_icon"
            android:layout_width="10dp"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toRightOf="@+id/my_score"
            app:layout_constraintTop_toBottomOf="@+id/name_text"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_pk_feedback_tag_unselected"
            android:gravity="center_vertical"
            android:id="@+id/opposite_score"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="1dp"
            app:layout_constraintLeft_toRightOf="@+id/pk_icon"
            app:layout_constraintTop_toBottomOf="@+id/name_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
