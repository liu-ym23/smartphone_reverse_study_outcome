<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:rtv="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_rectangle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/facade_selector_item_transparent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_48">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:id="@+id/check_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            rtv:ud_checkbox_size="normal"/>
        <FrameLayout
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_12">
            <com.bytedance.ee.bear.bitable.card.view.cell.select.SelectTextViewV2
                android:textSize="@dimen/space_kit_font_14"
                android:ellipsize="end"
                android:id="@+id/option_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="10"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/more_operation_icon"
            android:padding="@dimen/space_kit_len_14"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="@dimen/space_kit_len_2"
            rtv:srcCompat="@drawable/ud_icon_more_vertical_outlined"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_divider"/>
</LinearLayout>
