<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/first_screen_loading_view"
        android:background="@drawable/sku_buy_loading_bg"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sku_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/sku_main_container"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sku_main_container"
            android:background="@drawable/sku_fragment_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sku_content_container"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sku_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/sku_body"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sku_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
                android:orientation="vertical"
                android:id="@+id/sku_skeleton_loading_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:bg_cornerRadius_TL="20dp"
                app:bg_cornerRadius_TR="20dp">
                <ImageView
                    android:id="@+id/sku_skeleton_loading_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sku_loading_view"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/sku_skeleton_loading_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/sku_buy_loading_bottom_view"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/sku_skeleton_loading_moving_anime"
                    android:visibility="gone"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/sku_buy_skeleton_anime"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
            </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/sku_double_ball_loading_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/sku_error_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/ec_common_layout_error"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/sku_biz_error_invalid"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/sku_invalid_view"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/debug_btn_native"
                android:background="#fe496a"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:alpha="0.3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/debug_btn_select_sku"
                android:background="#0095ff"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选第一个SKU"
                android:alpha="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/debug_btn_native"/>
            <ImageView
                android:id="@+id/sku_iv_close"
                android:paddingTop="12dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/sku_icon_circle_close"
                android:paddingEnd="12dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/popup_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
