<?xml version="1.0" encoding="utf-8"?>
<com.obric.assistant.component.task.MaxHeightLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/cl_collapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_collapsed_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/obric_task_center_main_text_color"
            android:ellipsize="end"
            android:id="@+id/tv_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/fl_collapsed_status_container"
            app:layout_constraintStart_toEndOf="@+id/iv_collapsed_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="14dp"
            app:layout_goneMarginStart="12dp"/>
        <FrameLayout
            android:id="@+id/fl_collapsed_status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:id="@+id/pb_collapsed_loading"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:max="100"
                android:indeterminate="false"
                android:progressDrawable="@drawable/obric_circular_progress_determinate"
                android:layout_marginEnd="3dp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_collapsed_done"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/obric_ic_task_completed_success"
                android:layout_marginEnd="3dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_expand_arrow"
                android:background="@drawable/obric_ic_task_center_click_drop_bg"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/obric_ic_task_center_click_drop"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.obric.assistant.component.task.TaskPanelRecyclerView
        android:id="@+id/rv_expanded"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</com.obric.assistant.component.task.MaxHeightLinearLayout>
