<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/drive_office_space_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/drive_office_space_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:indeterminateDrawable="@drawable/larus_drivebiz_ic_drive_loading_more"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/drive_office_space_retry_container"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:src="@drawable/larus_ic_drive_load_more_retry"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_AI_generate_reload"/>
    </LinearLayout>
</FrameLayout>
