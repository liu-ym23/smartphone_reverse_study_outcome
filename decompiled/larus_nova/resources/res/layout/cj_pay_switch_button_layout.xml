<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/sign_switch_button_bg"
    android:background="@drawable/cj_pay_sign_switch_btn_bg"
    android:layout_width="43dp"
    android:layout_height="25dp">
    <View
        android:id="@+id/sign_switch_btn_left_space_view"
        android:background="@drawable/cj_pay_trans_padding_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/sign_switch_button_icon"
        android:background="@drawable/cj_pay_sign_switch_btn_icon"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</LinearLayout>
