<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/thread_reply_count_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="thread_reply_count, reply_count_divider"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_link_normal"
        android:id="@+id/thread_reply_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/reply_count_divider"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/thread_reply_count"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/thread_reply_count"
        app:layout_constraintTop_toTopOf="@+id/thread_reply_count"/>
    <View
        android:id="@+id/no_more_reply_divider"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.chat.chatwindow.chat.message.cell.mergeforward.ThreadReplyExposureView
        android:id="@+id/replies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thread_reply_count"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/reply_thread_button"
        android:paddingTop="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_IM_SwitchedTopicGroup_ReplyToTopic_Button"
        android:maxLines="1"
        android:drawablePadding="6dp"
        android:paddingStart="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/replies"/>
</androidx.constraintlayout.widget.ConstraintLayout>
