<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/open_card_menu_item"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/lkui_dialog_content_item_tv"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:layout_gravity="end|center_vertical"
        android:id="@+id/lkui_dialog_content_item_cb"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="check_mark"/>
</FrameLayout>
