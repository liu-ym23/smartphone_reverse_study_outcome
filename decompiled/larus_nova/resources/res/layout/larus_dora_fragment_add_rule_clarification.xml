<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_28"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_40"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="545dp">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_broadcast_half_dialog_confirm_rule_title_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_dora_broadcast_half_dialog_confirm_rule_desc_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/original_desc_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_dora_broadcast_half_dialog_confirm_rule_original_desc_label_cn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/original_desc_text"
        android:background="@drawable/larus_dora_bg_original_desc"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintTop_toBottomOf="@+id/original_desc_label"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/generated_count_text"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/original_desc_text"/>
    <com.larus.common_ui.widget.MaxHeightRecyclerView
        android:id="@+id/preview_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_container"
        app:layout_constraintTop_toBottomOf="@+id/generated_count_text"
        app:layout_constraintVertical_bias="0"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/re_describe_btn"
            android:background="@drawable/larus_dora_btn_secondary_bg"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_dora_broadcast_half_dialog_confirm_rule_btn_redescribe_cn"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_12"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/confirm_add_btn_ll"
            android:background="@drawable/larus_dora_btn_primary_bg_rule"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_56"
            android:layout_weight="1">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/confirm_add_btn_pb"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:indeterminateDrawable="@drawable/larus_dora_progressbar_loading"
                android:indeterminateDuration="750"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/confirm_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_half_dialog_confirm_rule_btn_confirm_add_cn"
                android:layout_marginStart="?attr/larus_dp_5"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
