<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_rootview"
    android:background="@drawable/ttlive_ic_live_default_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/riv_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.7"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/video_talk_cover"
        android:background="@drawable/ttlive_video_talk_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.7"/>
    <FrameLayout
        android:id="@+id/player_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/ttlive_preview_audio_live"/>
    <include layout="@layout/ttlive_preview_video_talkroom"/>
    <FrameLayout
        android:id="@+id/fl_interact_feed_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/gradual_top"
        android:background="@drawable/ttlive_common_feed_bg_gradual_top"
        android:layout_width="match_parent"
        android:layout_height="282dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/gradual_bottom"
        android:background="@drawable/ttlive_common_feed_bg_gradual_bottom"
        android:layout_width="match_parent"
        android:layout_height="282dp"/>
    <FrameLayout
        android:id="@+id/fl_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/ll_content_container"
            android:padding="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/rl_auto_enter_container"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_tips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/bg_auto_enter"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_auto_enter_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="@string/ttlive_click_enter_live_room"/>
                    <com.bytedance.android.livesdk.preview.RollTextView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/roll_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="12dp"/>
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/view_divide_line"
                        android:background="#80ffffff"
                        android:visibility="gone"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#b3ffffff"
                        android:id="@+id/tv_cancel_auto_enter"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_live_schema_cancel"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/live_animation_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">
                <View
                    android:id="@+id/view_divide_line_left"
                    android:background="#33ffffff"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/lav_live_playing"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="8dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="ttlive_feed_live_volume_icon_lottie.json"
                    app:lottie_loop="true"/>
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_live_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/ttlive_click_enter_live_room"/>
                <View
                    android:id="@+id/view_divide_line_right"
                    android:background="#33ffffff"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_live_tag_and_from_douyin"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="8dp">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_status_layout_bg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/live_status_layout"
                    app:layout_constraintEnd_toEndOf="@+id/live_status_layout"
                    app:layout_constraintStart_toStartOf="@+id/live_status_layout"
                    app:layout_constraintTop_toTopOf="@+id/live_status_layout"
                    app:roundedCornerRadius="3dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/live_status_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:paddingStart="3dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_live_status"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_live_icon"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/ttlive_living"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="5dp"/>
                </LinearLayout>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/live_status_label_whole"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:paddingStart="3dp"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/label_1_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="end"
                    app:constraint_referenced_ids="live_status_layout,live_status_label_whole"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_assist_label_layout_bg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/live_assist_label_layout"
                    app:layout_constraintEnd_toEndOf="@+id/live_assist_label_layout"
                    app:layout_constraintStart_toStartOf="@+id/live_assist_label_layout"
                    app:layout_constraintTop_toTopOf="@+id/live_assist_label_layout"
                    app:roundedCornerRadius="3dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/live_assist_label_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:paddingStart="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/label_1_barrier"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_assist_label_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_assist_label_text"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="5dp"/>
                </LinearLayout>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/live_assist_label_whole"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:paddingStart="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/label_1_barrier"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/live_head_cover"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    app:actualImageScaleType="focusCrop"/>
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_live_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="212dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:lineSpacingExtra="2dp"/>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/layout_from_douyin"
                    android:background="@drawable/ttlive_bg_preview_label"
                    android:layout_width="48dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="8dp">
                    <ImageView
                        android:id="@+id/iv_douyin_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ttlive_ic_from_douyin"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:text="@string/ttlive_from_douyin"
                        android:layout_toRightOf="@+id/iv_douyin_icon"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="15dp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_live_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginRight="87dp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
