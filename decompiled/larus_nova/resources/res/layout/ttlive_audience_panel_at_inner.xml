<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_ps_panel_white_round_corner"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_audience_item_inner_area_height">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/item_icon"
        android:background="@drawable/ttlive_audience_reply_inner_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="16dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_color_161823"
        android:layout_gravity="center_vertical"
        android:id="@+id/item_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:includeFontPadding="false"/>
</LinearLayout>
