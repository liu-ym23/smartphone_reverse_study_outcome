<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="16dp">
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:id="@+id/flagship_banner_right_bg"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginLeft="48dp"
        app:layout_constraintLeft_toLeftOf="@+id/flagship_banner_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:rounded_radius="2dp"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/flagship_banner_icon"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layoutMode="width_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/flagship_banner_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2.6dp"
        android:layout_marginRight="6dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/flagship_banner_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
