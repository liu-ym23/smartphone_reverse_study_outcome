<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#57000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/anim_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie/ttlive_image_recognition_loading.json"
        app:lottie_imageAssetsFolder="lottie/images/"
        app:lottie_loop="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_area"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="83dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/ttlive_bg_image_recognition_cancel_button"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginTop="7dp"
            android:text="@string/ttlive_button_cancel"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
