<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bitable_homepage_chart_bg_color"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bottom_left_radius="20dp"
    app:bottom_right_radius="20dp"
    app:top_left_radius="0dp"
    app:top_right_radius="0dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hp_chart_error_icon"
            android:layout_width="188dp"
            android:layout_height="140dp"
            android:layout_marginTop="48dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_HomeDashboard_LoadFailed_Desc"/>
        <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
            android:id="@+id/hp_chart_refresh_button"
            android:background="@color/primary_fill_default"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="60dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:bottom_left_radius="8dp"
            app:bottom_right_radius="8dp"
            app:top_left_radius="8dp"
            app:top_right_radius="8dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/refresh_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:tint="@color/primary_on_primary_fill"
                    app:srcCompat="@drawable/ud_icon_refresh_outlined"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_on_primary_fill"
                    android:gravity="center"
                    android:id="@+id/add_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_HomeDashboard_Reload_Button"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
    </LinearLayout>
</com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
