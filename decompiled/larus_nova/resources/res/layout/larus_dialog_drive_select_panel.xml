<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/drive_select_divider"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drive_select_recycler"
        android:paddingTop="?attr/larus_dp_24"
        android:paddingBottom="?attr/larus_dp_24"
        android:clipToPadding="false"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="?attr/larus_dp_8"
        android:paddingEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drive_select_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
