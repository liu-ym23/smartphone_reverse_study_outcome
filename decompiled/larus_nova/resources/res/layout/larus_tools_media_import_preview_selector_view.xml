<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/preview_top_mask_with_docker"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="91dp"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/preview_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="148.5dp">
        <FrameLayout
            android:id="@+id/selection_list_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
        <View
            android:background="#cd252525"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/select_layout"
            android:paddingLeft="16dp"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true">
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textColor="@color/tools_std_const_text_inverse"
                android:gravity="center"
                android:id="@+id/index_txt"
                android:background="?attr/larus_tools_media_import_selector_image_select"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:ts_enable_text_color="false"
                style="@style/tools_font_size_24"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:id="@+id/tip_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/larus_album_select_btn"
                android:layout_marginStart="8dp"
                app:ts_enable_text_color="false"
                style="@style/tools_font_size_30"/>
        </LinearLayout>
        <com.ss.android.ugc.tools.view.style.StyleTextView
            android:textStyle="bold"
            android:textColor="@color/larus_tools_media_import_preview_selector_next_step_text_color"
            android:gravity="center"
            android:id="@+id/sure_view"
            android:background="?attr/larus_tools_media_import_preview_selector_next_step_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/larus_album_next_btn"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:ts_enable_text_color="false"
            app:ts_font_type="medium"
            style="@style/tools_font_size_30"/>
    </RelativeLayout>
</FrameLayout>
