<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/guide_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_mob_ccBot_AIReplica_GenerateScreen_header_photoTips"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/guide_title_text">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toStartOf="@+id/linear2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="?attr/larus_dp_110"
            app:layout_constraintWidth_percent="0.235">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/scan_example1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageResource="@drawable/larus_digital_avatar_guide_item_1_new"
                app:roundedCornerRadius="?attr/larus_dp_8"
                app:viewAspectRatio="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tips1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_replica_genTips_singleFace"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/linear3"
            app:layout_constraintStart_toEndOf="@+id/linear1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="?attr/larus_dp_110"
            app:layout_constraintWidth_percent="0.235">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/scan_example3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageResource="@drawable/larus_digital_avatar_guide_item_2_new"
                app:roundedCornerRadius="?attr/larus_dp_8"
                app:viewAspectRatio="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tips3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_replica_genTips_multipleBgs"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/linear4"
            app:layout_constraintStart_toEndOf="@+id/linear2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="?attr/larus_dp_110"
            app:layout_constraintWidth_percent="0.235">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/scan_example4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageResource="@drawable/larus_digital_avatar_guide_item_3_new"
                app:roundedCornerRadius="?attr/larus_dp_8"
                app:viewAspectRatio="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tips4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_replica_genTips_faceBlocked"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintStart_toEndOf="@+id/linear3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="?attr/larus_dp_110"
            app:layout_constraintWidth_percent="0.235">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/scan_example2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageResource="@drawable/larus_digital_avatar_guide_item_4_new"
                app:roundedCornerRadius="?attr/larus_dp_8"
                app:viewAspectRatio="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center_horizontal"
                android:id="@+id/tips2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_replica_genTips_faceSmall"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/upload_guide_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_48"
        android:text="@string/larus_mob_ccBot_AIReplica_GenerateScreen_header_uploadPhotos"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_container"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_70"
        android:ellipsize="end"
        android:id="@+id/upload_guide_content_text"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_guide_title_text"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/upload_guide_content_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/create_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_guide_content_text"
        app:rv_backgroundColor="@color/larus_base_2"
        app:rv_cornerRadius="?attr/larus_dp_16">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/add_photo_icon"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:src="@drawable/larus_icon_add_photo_fill"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_primary_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_32"
                android:text="@string/larus_mob_ccBot_AIReplica_GenerateScreen_btn_upload"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"/>
        </LinearLayout>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chosen_photo_recycler_view"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_guide_content_text"/>
    <FrameLayout
        android:id="@+id/create_btn"
        android:background="@drawable/larus_bg_confirm_btn_r16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="center"
            android:id="@+id/create_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_mob_ccBot_AIReplica_GenerateScreen_btn_generate"
            android:fontFamily="sans-serif-medium"/>
        <com.larus.avatar.impl.upload.widget.RotateImageView
            android:layout_gravity="center"
            android:id="@+id/create_loading_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
