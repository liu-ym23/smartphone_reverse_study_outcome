<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_parent"
    android:paddingLeft="@dimen/empty_page_padding"
    android:paddingRight="@dimen/empty_page_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_empty"
        android:layout_width="@dimen/default_image_width"
        android:layout_height="@dimen/default_image_height"/>
    <include layout="@layout/view_default_text"/>
</LinearLayout>
