<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="36dp"
    android:layout_height="36dp">
    <ImageView
        android:id="@+id/initial_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_ic_toolbar_audience_record_initial60_land"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/progress_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/progress_record_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ic_toolbar_audience_record_progress_land"
            android:layout_centerInParent="true"/>
        <com.bytedance.android.livesdk.chatroom.widget.LiveCircleProgressView
            android:id="@+id/progress"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="7dp"
            android:layout_alignLeft="@+id/progress_record_icon"
            android:layout_alignBottom="@+id/progress_record_icon"
            android:layout_alignStart="@+id/progress_record_icon"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/finished_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_ic_toolbar_audience_record_finished_land"
        android:layout_centerInParent="true"/>
</RelativeLayout>
