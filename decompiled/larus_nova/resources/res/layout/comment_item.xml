<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">
    <FrameLayout
        android:id="@+id/content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.image.UDAvatar
                android:id="@+id/user_msg_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ud_avatar_borderWidth="0dp"
                app:ud_avatar_size="middle"
                style="@style/UDAvatar.Circle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/tv_name"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="10"
                android:includeFontPadding="false"
                android:layout_marginStart="12dp"
                app:layout_constraintLeft_toRightOf="@+id/user_msg_image"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTimeText
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:ellipsize="end"
                android:layout_gravity="top"
                android:id="@+id/tv_create_at"
                android:paddingTop="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                app:layout_constraintLeft_toRightOf="@+id/tv_name"
                app:layout_constraintRight_toLeftOf="@+id/tv_opt_comment"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
                android:textSize="16dp"
                android:textColor="@color/text_title"
                android:id="@+id/tv_content"
                android:paddingLeft="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
                android:textSize="16dp"
                android:textColor="@color/text_title"
                android:id="@+id/tv_content_translate"
                android:background="@drawable/facade_round_around_xs"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="2dp"
                android:backgroundTint="@color/bg_filler"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:id="@+id/iv_translate"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_content_translate"
                app:layout_constraintRight_toRightOf="parent"
                app:lottie_autoPlay="false"
                app:lottie_fileName="translate_ing.json"
                app:lottie_loop="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comment_image_list"
                android:padding="0dp"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_10"
                android:layout_marginBottom="@dimen/space_kit_len_10"
                app:layout_constraintStart_toStartOf="@+id/tv_content"
                app:layout_constraintTop_toBottomOf="@+id/iv_translate"/>
            <com.ss.android.lark.reaction.widget.flowlayout.ReactionFlowLayout
                android:id="@+id/reaction_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginStart="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_comment_image_list"
                app:layout_goneMarginTop="@dimen/dp_4"/>
            <ImageView
                android:id="@+id/tv_opt_comment"
                android:paddingTop="-5dp"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_34"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:tint="@color/facade_selector_icon_n2"
                android:contentDescription="item_comment_opt"
                android:paddingStart="14dp"
                android:paddingEnd="0dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
            <View
                android:id="@+id/comment_loading_mask"
                android:background="@drawable/comment_loading_background"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_content"
                app:layout_constraintRight_toRightOf="@+id/tv_content"/>
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:id="@+id/comment_loading"
                android:paddingLeft="2dp"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="14dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_fileName="rotate_lottie.json"
                app:lottie_loop="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/content_mask"
            android:background="@color/bg_float"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/delete_comment"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:tint="@color/icon_n3"
            android:contentDescription="item_delete_comment"
            app:srcCompat="@drawable/ud_icon_delete_trash_outlined"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/retry_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_wrapper">
        <ImageView
            android:id="@+id/comment_fail_img"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:scaleType="centerInside"
            android:layout_marginStart="50dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_warning_red_colorful"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_caption"
            android:id="@+id/comment_send_fail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/Doc_Comment_CommentSendFailed"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toRightOf="@+id/comment_fail_img"
            app:layout_constraintTop_toTopOf="@+id/comment_fail_img"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorful_blue"
            android:id="@+id/comment_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Doc_Comment_Retry"
            app:layout_constraintLeft_toLeftOf="@+id/comment_fail_img"
            app:layout_constraintTop_toBottomOf="@+id/comment_send_fail"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
