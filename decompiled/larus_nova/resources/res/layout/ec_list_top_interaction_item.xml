<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/top_interaction_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="wrap">
        <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/top_interaction_layout_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ec_allRadius="6dp">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/top_interaction_cover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.ui.base.widget.round.RoundFrameLayoutLite
                android:id="@+id/top_interaction_fl_index"
                android:background="@color/shopping_color_73161823"
                android:layout_width="12dp"
                android:layout_height="10dp"
                app:left_bottom_radius="6dp"
                app:left_top_radius="6dp">
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/shopping_std_text_white_1"
                    android:gravity="center"
                    android:id="@+id/top_interaction_tv_index"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:includeFontPadding="false"/>
            </com.bytedance.android.ui.base.widget.round.RoundFrameLayoutLite>
        </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/top_interaction_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
