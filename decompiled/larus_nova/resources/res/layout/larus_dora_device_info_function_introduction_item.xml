<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_180"
    android:layout_marginBottom="?attr/larus_dp_12"
    app:rv_cornerRadius="?attr/larus_dp_16">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/larus_dora_device_info_function_introduction_item_image"
        android:background="@color/larus_static_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/larus_dora_device_info_function_introduction_item_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_4"
        android:src="@drawable/larus_dora_device_info_function_introduction_set_new"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/function_introduction_item_title"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="start|center_vertical"
        android:id="@+id/function_introduction_item_title"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_0"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/function_introduction_item_subtitle"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_static_white"
        android:gravity="start|center_vertical"
        android:id="@+id/function_introduction_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_23"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
