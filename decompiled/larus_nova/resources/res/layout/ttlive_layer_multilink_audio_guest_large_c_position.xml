<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_line_stub_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.77"/>
    <View
        android:id="@+id/stub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_line_stub_bottom"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_volume_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_volume_container"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_volume_container"
        app:layout_constraintHorizontal_weight="5"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"
        app:layout_constraintVertical_weight="5"/>
    <View
        android:id="@+id/guide_view_volume_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_volume_bottom"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_volume_bottom"
        app:layout_constraintHorizontal_weight="80"
        app:layout_constraintStart_toEndOf="@+id/guide_view_volume_top"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_volume_top"
        app:layout_constraintVertical_weight="80"/>
    <View
        android:id="@+id/guide_view_volume_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintHorizontal_weight="5"
        app:layout_constraintStart_toEndOf="@+id/guide_view_volume_container"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_volume_container"
        app:layout_constraintVertical_weight="5"/>
    <View
        android:id="@+id/guide_view_avatar_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintHorizontal_weight="15"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"
        app:layout_constraintVertical_weight="15"/>
    <View
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_avatar_bottom"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_avatar_bottom"
        app:layout_constraintHorizontal_weight="60"
        app:layout_constraintStart_toEndOf="@+id/guide_view_avatar_top"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_avatar_top"
        app:layout_constraintVertical_weight="60"/>
    <View
        android:id="@+id/guide_view_avatar_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintHorizontal_weight="15"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintVertical_weight="15"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_guest_avatar"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_volume_Anim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_view_volume_container"
        app:layout_constraintEnd_toEndOf="@+id/guide_view_volume_container"
        app:layout_constraintStart_toStartOf="@+id/guide_view_volume_container"
        app:layout_constraintTop_toTopOf="@+id/guide_view_volume_container"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/ttlive_avatar_right_top_widget_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:translationX="30dp"
        android:translationY="-30dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_right_top_widget"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ttlive_guest_name_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar">
        <View
            android:id="@+id/ttlive_guest_identification"
            android:background="@drawable/ttlive_ic_audio_chat_room_admin"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="10"/>
    </LinearLayout>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
        android:id="@+id/ttlive_guest_fans_ticket_count"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_name_container"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
        android:id="@+id/ttlive_themed_competition_score"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_name_container"/>
    <com.bytedance.android.livesdk.common.AnchorPauseTipsView
        android:id="@+id/ttlive_leave_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
    <com.bytedance.android.live.liveinteract.view.PositionNameTv
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_position_name"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="4"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"/>
    <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pos_tag_label"
        android:background="@drawable/ttllive_audio_talk_seat_host_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:includeFontPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"/>
    <FrameLayout
        android:id="@+id/random_emoji_container"
        android:layout_width="75dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_volume_Anim"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_volume_Anim"
        app:layout_constraintStart_toStartOf="@+id/ttlive_volume_Anim"
        app:layout_constraintTop_toTopOf="@+id/ttlive_volume_Anim"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/guide_avatar_effect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/guide_anchor_info_left_layout"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_bubble"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintHorizontal_bias="1">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guide_anchor_info_left_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="1dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/guide_anchor_info_left_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="84dp"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/guide_anchor_info_right_layout"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_bubble"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guide_anchor_info_right_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="1dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/guide_anchor_info_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="84dp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/guide_anchor_description_tv"
        android:background="@drawable/ttlive_bg_audio_guide_anchor_desc"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="238dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_name_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
