<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/image_container"
    android:background="@color/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/larus_neutral_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:placeholderImage="@color/larus_neutral_transparent_1"/>
    <View
        android:id="@+id/avatar_desc_mask"
        android:background="@drawable/larus_community_bg_avatar_desc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/creation_group_size"
        android:background="@drawable/larus_community_bg_creation_group_size"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_static_white"
        android:id="@+id/avatar_desc"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:fontFamily="sans-serif"
        android:paddingStart="?attr/larus_dp_6"
        android:paddingEnd="?attr/larus_dp_6"
        android:letterSpacing="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/avatar_create_desc_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.57"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/neutral_50"
        android:gravity="center"
        android:id="@+id/avatar_create_desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        android:text="@string/larus_credit_history_replica"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar_create_desc_top_guideline"/>
    <ImageView
        android:id="@+id/music_label"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_2"
        android:src="@drawable/larus_community_ic_music_label"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_community_ic_video_icon"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
