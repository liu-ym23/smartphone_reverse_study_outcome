<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start|bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="22sp">
    <com.bytedance.android.livesdk.interactivity.enteranim.view.UserEnterLevelView
        android:layout_gravity="center_vertical"
        android:id="@+id/view_user_entry"
        android:layout_width="wrap_content"
        android:layout_height="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/view_user_entry_overlay"
        android:visibility="gone"
        android:layout_width="214dp"
        android:layout_height="22sp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/view_user_entry"
        app:layout_constraintLeft_toLeftOf="@+id/view_user_entry"
        app:layout_constraintTop_toTopOf="@+id/view_user_entry"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/view_user_entry_webp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/view_user_entry"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/anim_icon"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/view_user_entry"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
