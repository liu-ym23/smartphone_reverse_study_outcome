<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ec_commerce_same_product_bg_commission_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:gravity="center_horizontal"
        android:id="@+id/ec_commission_dialog_tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center_horizontal"
        android:id="@+id/ec_commission_dialog_tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"/>
    <View
        android:background="@color/shopping_color_1F161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:gravity="center"
        android:id="@+id/ec_commission_dialog_tv_button_text"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>
</LinearLayout>
