<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout
        android:orientation="horizontal"
        android:id="@+id/store_product_card"
        android:background="@color/shopping_std_bg_primary_white"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="8dp">
        <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
            android:id="@+id/store_product_card_image_above"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginLeft="8dp"
            app:rounded_radius="8dp">
            <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
                android:id="@+id/store_product_card_image_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="@color/ec_shop_product_placeholder_color"
                    app:roundedCornerRadius="6dp"/>
                <View
                    android:background="@color/shopping_std_bg_black_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/shopping_std_text_white_1"
                android:gravity="center_horizontal"
                android:id="@+id/shop_hotsale_product_rank"
                android:paddingTop="13dp"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="38dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/ec_shop_play_info_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:minWidth="62dp"
                android:minHeight="20dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                app:cardBackgroundColor="@color/ec_shop_livehot_watch_playback_bg_color"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <com.bytedance.android.ec.core.widget.CircleImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/shopping_window_video_card_play_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4.5dp"
                    app:actualImageScaleType="fitXY"
                    app:placeholderImage="@drawable/ec_shop_ic_inner_flow_play_back"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/shopping_std_text_white_1"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/shopping_window_video_card_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_video_watch_explain"
                    android:maxLines="1"
                    android:layout_marginStart="17.5dp"
                    android:layout_marginEnd="4.5dp"/>
            </androidx.cardview.widget.CardView>
        </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/shopping_std_text_black_1"
                android:ellipsize="end"
                android:id="@+id/store_product_card_title"
                android:paddingTop="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ec_window_sub_text_color"
                android:ellipsize="end"
                android:id="@+id/store_product_card_recommend_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
            <FrameLayout
                android:id="@+id/window_product_card_recommend_area"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/cl_shopping_hotsale_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iv_shopping_hotsale_fire"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ec_shop_live_hotsale_fire"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="@+id/store_product_card_sale"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/store_product_card_sale"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/shopping_std_text_modal_6"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/store_product_card_sale"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toTopOf="@+id/store_product_card_price"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toRightOf="@+id/iv_shopping_hotsale_fire"/>
                <com.bytedance.android.ec.core.widget.price.PriceView
                    android:textSize="17dp"
                    android:ellipsize="end"
                    android:id="@+id/store_product_card_price"
                    android:paddingTop="2dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:lineSpacingExtra="2dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:pv_hideYuanSymbol="false"
                    app:pv_prefixMarginRight="4dp"
                    app:pv_prefixTextBold="false"
                    app:pv_prefixTextColor="@color/shopping_std_brand"
                    app:pv_prefixTextSizeRatio="0.647"
                    app:pv_priceBold="true"
                    app:pv_priceTextColor="@color/shopping_std_brand"
                    app:pv_yuanSymbolBold="false"
                    app:pv_yuanSymbolMarginRight="1dp"
                    app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
                <com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ec_ll_submit_order_group"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_alignParentBottom="true"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintLeft_toRightOf="@+id/store_price_sale_group"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintWidth_min="70dp"
                    app:rounded_radius="4dp">
                    <ImageView
                        android:id="@+id/store_product_card_add_to_cart"
                        android:background="@color/commerce_color_0DFE2C55"
                        android:padding="6dp"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ec_shop_window_ic_add_to_cart"/>
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/ec_element_tv_buy_product"
                        android:background="@color/ec_shop_inner_flow_to_buy_background"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="70dp"
                        android:text="@string/ec_shop_go_buying"
                        android:maxLines="1"/>
                </com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
                <LinearLayout
                    android:id="@+id/store_product_card_extra_info_area"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp">
                    <LinearLayout
                        android:id="@+id/store_product_card_seckill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
</LinearLayout>
