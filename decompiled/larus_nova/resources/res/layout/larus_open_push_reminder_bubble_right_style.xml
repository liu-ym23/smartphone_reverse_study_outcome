<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_10"
    android:paddingEnd="?attr/larus_dp_10">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_push_reminder_bubble_right_style_sub_avatar"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:src="@drawable/larus_icon_push_reminder_bubble_doubao_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_right_style_title"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_4"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv_push_reminder_bubble_right_style_time"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iv_push_reminder_bubble_right_style_sub_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_right_style_time"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_4"
        android:minWidth="?attr/larus_dp_40"
        android:layout_marginStart="?attr/larus_dp_5"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/iv_push_reminder_bubble_right_style_avatar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_push_reminder_bubble_right_style_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_push_reminder_bubble_right_style_brief"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_20"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_push_reminder_bubble_right_style_avatar"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/iv_push_reminder_bubble_right_style_avatar"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginTop="?attr/larus_dp_8"
        app:failureImage="@color/larus_base_2_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_base_2_overlay"/>
</androidx.constraintlayout.widget.ConstraintLayout>
