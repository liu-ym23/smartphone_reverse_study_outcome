<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:paddingLeft="@dimen/space_kit_len_16"
    android:paddingRight="@dimen/space_kit_len_16"
    android:paddingBottom="@dimen/space_kit_len_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/bg_float_base">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:text="@string/LarkCCM_Docs_CommentPerm_FilterCmt_Title"/>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerPaddingLeft="40dp"
        app:itemBackgroundColor="@color/bg_float">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/allItem"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/allCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/primary_content_default"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/allTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Docs_CommentPerm_VisibleToAll_Menu"
                android:layout_weight="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
            <com.larksuite.component.universe_design.badge.UDBadgeView
                android:id="@+id/allCount"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                app:ud_badge_color="@color/ud_N200"
                app:ud_badge_textColor="@color/text_caption"
                app:ud_badge_textMaxLength="6"
                app:ud_badge_textSize="@dimen/space_kit_font_10"
                app:ud_badge_textWidthPadding="8dp"
                style="@style/UDBadge.Text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/partItem"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/partCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/primary_content_default"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/partTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Docs_CommentPerm_VisibleToSelected_Menu"
                android:layout_weight="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
            <com.larksuite.component.universe_design.badge.UDBadgeView
                android:id="@+id/partCount"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                app:ud_badge_color="@color/ud_N200"
                app:ud_badge_textColor="@color/text_caption"
                app:ud_badge_textMaxLength="6"
                app:ud_badge_textSize="@dimen/space_kit_font_10"
                app:ud_badge_textWidthPadding="8dp"
                style="@style/UDBadge.Text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/meItem"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/meCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/primary_content_default"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/meTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Docs_CommentPerm_Private_Menu"
                android:layout_weight="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
            <com.larksuite.component.universe_design.badge.UDBadgeView
                android:id="@+id/meCount"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                app:ud_badge_color="@color/ud_N200"
                app:ud_badge_textColor="@color/text_caption"
                app:ud_badge_textMaxLength="6"
                app:ud_badge_textSize="@dimen/space_kit_font_10"
                app:ud_badge_textWidthPadding="8dp"
                style="@style/UDBadge.Text"/>
        </LinearLayout>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
</LinearLayout>
