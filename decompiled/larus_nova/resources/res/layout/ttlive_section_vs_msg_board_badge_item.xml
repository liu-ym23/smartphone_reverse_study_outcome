<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:id="@+id/badge_card_view"
        android:layout_width="96dp"
        android:layout_height="66dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="1dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_allRadius="12dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_vs_badge_item_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ttlive_ve_badge_item_select_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_vs_dress_item_select_layer"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
    <ImageView
        android:id="@+id/ttlive_vs_badge_item_paid_tag"
        android:layout_width="25dp"
        android:layout_height="13dp"
        android:src="@drawable/ttlive_ic_dress_paid_tag"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/badge_name"
        android:layout_width="99dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/badge_card_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
