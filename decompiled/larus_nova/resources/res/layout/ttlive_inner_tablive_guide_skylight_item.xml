<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="76dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatar_area"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true">
        <com.bytedance.android.live.core.view.LiveCircleView
            android:layout_gravity="center"
            android:id="@+id/iv_border_circle"
            android:padding="5dp"
            android:layout_width="70dp"
            android:layout_height="70dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/skylight_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/live_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_bottom_img_tag"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="57dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#e6ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/nick_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="xxxxx"
        android:maxLines="1"
        android:includeFontPadding="true"
        android:layout_below="@+id/avatar_area"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</RelativeLayout>
