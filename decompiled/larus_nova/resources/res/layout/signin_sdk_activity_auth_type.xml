<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.passport.flow.core.widget.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flow_tb_right_text_color="@color/primary_fill_default"
        app:flow_tb_right_text_size="@dimen/signin_sdk_font_size_16"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.ss.android.lark.flow.passport.ui.widget.layout.MaxWidthLinerLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/signin_sdk_margin_20"
                style="@style/SignInTitleStyle"/>
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/dp_12"
                style="@style/SignInSubTitleStyle"/>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_20"
                android:fillViewport="true"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_verify_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/tv_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/primary_content_default"
                    android:gravity="center"
                    android:id="@+id/tv_bottom_button"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"/>
            </LinearLayout>
        </com.ss.android.lark.flow.passport.ui.widget.layout.MaxWidthLinerLayout>
    </FrameLayout>
</LinearLayout>
