<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_project_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/project_header"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/larus_layout_bottom_sheet_header"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/project_section"
        android:background="@drawable/larus_bg_task_project_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/project_header"
        app:layout_constraintVertical_bias="0">
        <FrameLayout
            android:id="@+id/project_list_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/project_fixed_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_projects"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <include
                android:layout_gravity="center"
                android:id="@+id/project_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/larus_layout_task_skill_state"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/project_fixed_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <include
                android:id="@+id/create_project_item"
                layout="@layout/larus_item_task_project"/>
            <include
                android:id="@+id/clear_project_item"
                layout="@layout/larus_item_task_project"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
