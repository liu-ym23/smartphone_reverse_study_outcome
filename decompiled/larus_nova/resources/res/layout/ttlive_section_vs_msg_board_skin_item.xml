<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:id="@+id/skin_card_view"
        android:layout_width="96dp"
        android:layout_height="66dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="1dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_allRadius="12dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_vs_skin_item_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_bg_dress_skin_default"/>
        <ImageView
            android:id="@+id/ttlive_ve_skin_item_select_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_vs_dress_item_select_layer"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
            android:id="@+id/ttlive_vs_skin_item_sub_bg"
            android:background="@color/transparent"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:elevation="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_allRadius="6dp">
            <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
                android:id="@+id/ttlive_vs_skin_item_head"
                android:background="@drawable/ttlive_vs_bg_skin_item_head_default"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/ttlive_vs_skin_user_name"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:maxLines="1"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toRightOf="@+id/ttlive_vs_skin_item_head"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
    <ImageView
        android:id="@+id/ttlive_vs_skin_item_paid_tag"
        android:layout_width="25dp"
        android:layout_height="13dp"
        android:src="@drawable/ttlive_ic_dress_paid_tag"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/skin_name"
        android:layout_width="99dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skin_card_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
