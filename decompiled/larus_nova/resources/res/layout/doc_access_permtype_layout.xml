<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:backgroundTint="@color/bg_base"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_left_title=""
        app:widget_widgets_tb_title="@string/LarkCCM_IM_SharingSuggestions_DefaultPermissionOfNewDocs_Text_Mob"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/only_layout"
        android:background="@drawable/doc_setting_group_item_round_top"
        android:paddingTop="15dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        style="@style/DocSettingItemConstraintLayout">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/only_ck"
            android:padding="@dimen/dp_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            app:ud_checkbox_size="small"
            app:ud_checkbox_type="radio"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/LarkCCM_IM_SharingSuggestions_OnlyInvitedUserCanAccess_Radio_Mob"
            android:layout_alignParentLeft="true"/>
    </LinearLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_05"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/any_layout"
        android:background="@drawable/doc_setting_group_item_round_bottom"
        android:paddingTop="15dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        style="@style/DocSettingItemConstraintLayout">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/any_ck"
            android:padding="@dimen/dp_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            app:ud_checkbox_size="small"
            app:ud_checkbox_type="radio"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:id="@+id/any_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/LarkCCM_IM_SharingSuggestions_AnyoneWithLinkCanView_Radio_Mob"
            android:layout_alignParentLeft="true"/>
    </LinearLayout>
</LinearLayout>
