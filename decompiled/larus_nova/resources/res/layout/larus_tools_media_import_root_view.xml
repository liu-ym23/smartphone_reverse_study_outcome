<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/media_design_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/title_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/media_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/media_list_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/pager_content"
                    android:background="?attr/larus_base_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/selector_view_content">
                    <com.ss.android.ugc.aweme.shortvideo.sticker.widget.tablayout.TabLayout
                        android:id="@+id/media_tab"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="8dp"
                        app:tabBackground="?attr/larus_base_1"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/tools_std_text_reverse"
                        app:tabIndicatorHeight="2dp"
                        app:tabMaxWidth="0dp"
                        app:tabMode="fixed"
                        app:tabPaddingEnd="0dp"
                        app:tabPaddingStart="0dp"/>
                    <com.bytedance.creativex.mediaimport.widget.viewpager.LazyViewPager
                        android:id="@+id/media_viewpager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/selector_view_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/folder_list_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
