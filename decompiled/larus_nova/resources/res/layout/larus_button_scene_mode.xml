<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_38">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/scene_icon"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        android:layout_marginStart="?attr/larus_dp_16"
        app:actualImageScaleType="centerInside"
        app:placeholderImage="@drawable/larus_ic_scene_choose_dark"/>
    <ProgressBar
        android:id="@+id/scene_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        android:layout_marginStart="?attr/larus_dp_16"
        android:indeterminateTint="@color/larus_static_white"
        style="@style/larus_LoadingProgressBar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/larus_static_white"
        android:id="@+id/scene_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_voice_call_select_theme_btn"
        android:layout_marginStart="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_16"/>
    <View
        android:id="@+id/exit_divider"
        android:background="@color/static_white_transparent_2"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_1"
        android:layout_height="?attr/larus_dp_18"
        android:layout_marginStart="-4dp"/>
    <ImageView
        android:id="@+id/exit_icon"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingBottom="?attr/larus_dp_10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_scene_exit_dark"
        android:contentDescription="@string/larus_accessibility_call_exitScenario"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="10dp"/>
</merge>
