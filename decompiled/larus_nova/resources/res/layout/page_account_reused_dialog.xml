<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/account_tips_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/feed_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_17"
        android:text="@string/larus_account_risk_modal_tag_helpCenter"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/img_icon"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginTop="?attr/larus_dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"/>
    <ImageView
        android:id="@+id/button_waring"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:src="@drawable/ic_warning"
        android:translationX="?attr/larus_dp_2"
        android:translationY="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon"
        app:layout_constraintEnd_toEndOf="@+id/img_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tips_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_account_risk_modal_title_risk"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/tips_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_account_risk_modal_desc_risk"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tips_title"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_base_1"
        android:gravity="center"
        android:id="@+id/start_bind"
        android:background="@drawable/ic_account_bind_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_36"
        android:text="@string/larus_account_risk_modal_btn_link"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tips_sub_title"/>
    <View
        android:background="@color/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_bind"/>
</androidx.constraintlayout.widget.ConstraintLayout>
