<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkbox_minor_mode_disclaimer_group"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_32"
    android:layout_marginTop="?attr/larus_dp_24"
    app:layout_constraintBottom_toTopOf="@+id/set_password"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/edit_solid">
    <com.larus.bmhome.chat.layout.widget.ChatCheckBox
        android:id="@+id/checkbox_minor_mode_disclaimer"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:checked="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="14sp"
        android:textColor="@color/neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/minor_mode_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_8"
        app:larus_linkColor="@color/primary_50"
        app:larus_linkUnderLine="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkbox_minor_mode_disclaimer"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
