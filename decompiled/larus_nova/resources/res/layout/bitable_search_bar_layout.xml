<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@drawable/bitable_search_bar_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:paddingStart="@dimen/space_kit_len_12"
    android:layout_marginStart="@dimen/space_kit_len_16"
    android:layout_marginEnd="@dimen/space_kit_len_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:layout_width="@dimen/space_kit_len_16"
        android:layout_height="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_8"
        app:srcCompat="@drawable/ud_icon_search_outlined"
        app:tint="@color/icon_n2"/>
    <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableSpaceEditText
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/left_edit_text"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
    <FrameLayout
        android:id="@+id/right_icon_wrapper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/space_kit_len_8"
        android:paddingEnd="@dimen/space_kit_len_8">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="@dimen/space_kit_len_28"
            android:layout_height="@dimen/space_kit_len_28">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/right_icon"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                app:srcCompat="@drawable/ud_icon_close_filled"
                app:tint="@color/icon_disable"/>
        </FrameLayout>
    </FrameLayout>
    <com.bytedance.ee.bear.bitable.uikit.simpleitem.SearchConfigIcon
        android:id="@+id/search_config"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"/>
</LinearLayout>
