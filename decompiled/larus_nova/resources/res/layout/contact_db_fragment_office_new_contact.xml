<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.contact.customized.common.view.ContactOfficeTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:rightIcon="@drawable/contact_db_add_friends"
        app:title="@string/LarkIM_Friend_NewContact_Title"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout
            android:id="@+id/new_contact_ptr_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lkui_ptr_duration_to_close_either="500"
            app:lkui_ptr_keep_header_when_refresh="true"
            app:lkui_ptr_mode="loadMore"
            app:lkui_ptr_pull_to_fresh="false"
            app:lkui_ptr_ratio_of_header_height_to_refresh="0.5"
            app:lkui_ptr_resistance="1.7">
            <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
                android:id="@+id/new_contact_rv"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
        <FrameLayout
            android:id="@+id/new_contact_state_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.contact.customized.common.view.ContactOfficeEmptyStateView
                android:id="@+id/new_contact_state_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/new_contact_loading_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
