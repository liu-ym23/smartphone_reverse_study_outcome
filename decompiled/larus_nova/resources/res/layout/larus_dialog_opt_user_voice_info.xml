<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/larus_bg_bottom_sheet"
        android:paddingBottom="?attr/larus_dp_28"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginStart="?attr/larus_dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_back_dialog"/>
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/larus_ugc_voice_finish"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:layout_width="?attr/larus_dp_108"
            android:layout_height="?attr/larus_dp_100"
            android:layout_marginTop="?attr/larus_dp_134"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/voice_avatar"
                android:layout_width="?attr/larus_dp_100"
                android:layout_height="?attr/larus_dp_100"
                android:scaleType="centerCrop"
                app:placeholderImage="?attr/larus_base_2_overlay"
                app:roundBottomEnd="true"
                app:roundBottomStart="true"
                app:roundTopEnd="true"
                app:roundTopStart="true"
                app:roundedCornerRadius="?attr/larus_dp_20"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/avatar_add"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                app:srcCompat="?attr/larus_ic_add_header"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_progress_bar"
            android:background="?attr/larus_bg_voice_info_progress"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_262"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginStart="?attr/larus_dp_18"
                style="@style/larus_LoadingProgressBar"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_ugc_voice_process"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_play_bar"
            android:background="?attr/larus_bg_voice_info_play"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_262"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/play_lottie"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginStart="?attr/larus_dp_16"
                app:lottie_fileName="lottie/voice_playing_ae_export_v2.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_primary_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_ugc_voice_demo"
                android:layout_marginStart="?attr/larus_dp_18"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_error_bar"
            android:background="@drawable/larus_bg_voice_info_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_262"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/error_icon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_ic_voice_progress_error"
                android:layout_marginStart="?attr/larus_dp_18"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_danger_50"
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_ugc_voice_retry_1"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_edit_area"
            android:background="?attr/larus_bg_voice_edit"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_334"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/voice_name_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="sjjjjjjjj"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/edit_icon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_ic_voice_edit"
                android:layout_marginStart="?attr/larus_dp_18"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/permission_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:text="@string/larus_ugc_voice_who_use"
            android:layout_marginStart="?attr/larus_dp_28"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_edit_area"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_permission_private"
            android:background="?attr/larus_bg_voice_permission_top"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/permission_hint">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="?attr/larus_icon_bot_permission_private"
                android:layout_marginStart="?attr/larus_dp_16"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_ugc_voice_me"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_18"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/private_state"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_ic_voice_selector"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/voice_permission_public"
            android:background="?attr/larus_bg_voice_permission_bottom"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_permission_private">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="?attr/larus_icon_bot_permission_public"
                android:layout_marginStart="?attr/larus_dp_16"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_ugc_voice_all"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_18"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/public_state"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_ic_voice_selector"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            android:layout_marginStart="?attr/larus_dp_74"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_permission_private"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/permission_private_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_Voice_open_warning"
            android:layout_marginStart="?attr/larus_dp_27"
            android:layout_marginEnd="?attr/larus_dp_27"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_permission_public"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/complete_button"
            android:background="?attr/larus_bg_voice_info_complete"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="28dp"
            android:text="@string/larus_ugc_voice_release"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/permission_private_hint"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
