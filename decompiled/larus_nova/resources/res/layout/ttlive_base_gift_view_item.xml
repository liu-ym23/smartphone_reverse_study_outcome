<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_image"
        android:layout_width="@dimen/ttlive_gift_panel_icon_size"
        android:layout_height="@dimen/ttlive_gift_panel_icon_size"
        android:layout_marginTop="15dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
        android:id="@+id/gift_image_mask_view"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exposure_image"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_gift_panel_icon_size"
        android:layout_height="@dimen/ttlive_gift_panel_icon_size"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/gift_image"
        app:layout_constraintEnd_toEndOf="@+id/gift_image"
        app:layout_constraintStart_toStartOf="@+id/gift_image"
        app:layout_constraintTop_toTopOf="@+id/gift_image"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_image_bottom_label"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_gift_panel_scene_label_width"
        android:layout_height="@dimen/ttlive_gift_panel_scene_label_height"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/gift_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/left_logo"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_gift_left_logo_width"
        android:layout_height="@dimen/ttlive_gift_left_logo_height"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.GiftLabelTextView
        android:textSize="8dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/gift_label"
        android:background="@drawable/ttlive_bg_gift_label_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatar_logo_for_label"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/gift_label"
        app:layout_constraintStart_toStartOf="@+id/gift_label"
        app:layout_constraintTop_toTopOf="@+id/gift_label"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/gift_name_container"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_image">
        <ImageView
            android:id="@+id/gift_lock_icon"
            android:visibility="gone"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ttlive_gift_preview_lock_icon"
            app:layout_constraintEnd_toStartOf="@+id/gift_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="center_vertical"
            android:id="@+id/gift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.9"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/diamond_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_name_container">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/diamond_left_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="8dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/ttlive_base_gift_panel_diamond"
            android:layout_gravity="center_horizontal"
            android:id="@+id/diamond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
