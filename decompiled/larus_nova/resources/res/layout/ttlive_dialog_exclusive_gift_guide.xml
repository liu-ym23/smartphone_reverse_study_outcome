<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_area"
        android:background="@drawable/ttlive_pop_up_gift_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="107dp"
        android:layout_marginBottom="248dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:background="#b3000000"
        android:layout_width="match_parent"
        android:layout_height="248dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/close_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_area"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/pop_up_image"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_area"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/display_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pop_up_image"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/pop_up_button_image"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/display_text"/>
    <View
        android:id="@+id/close"
        android:background="@drawable/ttlive_pop_up_dialog_close"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pop_up_button_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
