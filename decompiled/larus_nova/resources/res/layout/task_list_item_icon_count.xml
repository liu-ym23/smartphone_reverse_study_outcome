<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/icon_divider"
        android:background="@color/line_divider_default"
        android:layout_width="@dimen/dp_1"
        android:layout_height="12sp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/subtask_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8">
        <ImageView
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="16sp"
            android:layout_height="20sp"
            android:tint="@color/text_placeholder"
            android:paddingEnd="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_subtasks_outlined"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/subtask_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/attachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8">
        <ImageView
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="16sp"
            android:layout_height="20sp"
            android:tint="@color/text_placeholder"
            android:paddingEnd="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_attachment_outlined"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/attachment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8">
        <ImageView
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="16sp"
            android:layout_height="20sp"
            android:tint="@color/text_placeholder"
            android:paddingEnd="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_add_comment_outlined"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
