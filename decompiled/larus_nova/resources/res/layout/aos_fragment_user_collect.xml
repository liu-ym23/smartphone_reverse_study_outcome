<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/aos_bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/aos_collect_background"/>
    <com.bytedance.awemeopen.apps.framework.base.view.scrollablelayout.DampScrollableLayout
        android:orientation="vertical"
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:tabs_marginTop="0dp">
        <include layout="@layout/aos_fragment_user_collect_header"/>
        <include layout="@layout/aos_fragment_user_collect_bottom"/>
    </com.bytedance.awemeopen.apps.framework.base.view.scrollablelayout.DampScrollableLayout>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtStatusView
        android:id="@+id/status_view"
        android:background="@color/aos_bg_primary"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/aos_fragment_user_collect_title_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
