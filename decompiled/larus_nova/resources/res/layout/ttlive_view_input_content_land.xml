<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/input_section_v3"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/content_danmaku_switch"
        android:background="@drawable/ttlive_input_v3_danmaku_off"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"/>
    <com.bytedance.android.livesdk.interactivity.comment.view.BarrageView
        android:layout_gravity="center_vertical"
        android:id="@+id/barrage_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/input_container_background"
            android:background="@drawable/ttlive_ic_new_comment_input_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_text_container"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#b0b0b0"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_text_hint"
            android:background="@null"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:singleLine="true"
            android:importantForAccessibility="no"
            android:textAlignment="viewStart"
            android:paddingStart="17dp"
            android:paddingEnd="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/associate_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:layout_marginEnd="2dp"/>
    </FrameLayout>
</LinearLayout>
