<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView
        android:id="@+id/scroll_view_gantt_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_todo_gantt_container"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="@dimen/sp_14"
                android:textStyle="normal"
                android:textColor="@color/udtoken_tag_text_s_red"
                android:id="@+id/btn_todo_milestone"
                android:paddingLeft="@dimen/dp_4"
                android:paddingTop="5dp"
                android:paddingRight="@dimen/dp_4"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_11"
                android:text="@string/Todo_GanttView_Milestone_Button"
                android:drawableLeft="@drawable/todo_svg_icon_milestone_tint"
                android:drawablePadding="@dimen/dp_4"
                android:textAllCaps="false"
                app:ud_backgroundColor="@color/udtoken_tag_bg_red"
                app:ud_radius="s"
                style="@style/UDButton.Default"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="@dimen/sp_14"
                android:textStyle="normal"
                android:textColor="@color/udtoken_tag_text_s_green"
                android:id="@+id/btn_task_pre_dependent"
                android:paddingLeft="@dimen/dp_4"
                android:paddingTop="5dp"
                android:paddingRight="@dimen/dp_4"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_11"
                android:drawableLeft="@drawable/ud_icon_task_preliminary_outlined"
                android:drawablePadding="@dimen/dp_4"
                android:textAllCaps="false"
                app:ud_backgroundColor="@color/udtoken_tag_bg_green"
                app:ud_radius="s"
                style="@style/UDButton.Default"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="@dimen/sp_14"
                android:textStyle="normal"
                android:textColor="@color/udtoken_tag_text_s_green"
                android:id="@+id/btn_task_next_dependent"
                android:paddingLeft="@dimen/dp_4"
                android:paddingTop="5dp"
                android:paddingRight="@dimen/dp_4"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ud_icon_task_follow_up_outlined"
                android:drawablePadding="@dimen/dp_4"
                android:textAllCaps="false"
                app:ud_backgroundColor="@color/udtoken_tag_bg_green"
                app:ud_radius="s"
                style="@style/UDButton.Default"/>
        </LinearLayout>
    </com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_16">
        <RelativeLayout
            android:id="@+id/todo_check_box_container"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_2">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/todo_check_box"
                android:padding="6dp"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/todo_svg_icon_uncheck_new"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/todo_check_box_lottie"
                android:visibility="gone"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"/>
        </RelativeLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_2"
            layout="@layout/todo_detail_content_editor_summary2"/>
    </LinearLayout>
</LinearLayout>
