<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bitable_superagent_panel_window"
    android:background="@color/static_black_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bitable_superagent_panel_root"
        android:background="@drawable/bitable_homepage_add_chart_container_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bitable_superagent_panel_title_bar"
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/bitable_superagent_panel_title_left_icon"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:tint="@color/icon_n2"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/bitable_superagent_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="84dp"
                android:layout_marginEnd="84dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/bitable_superagent_panel_title_right_secondary_icon"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:tint="@color/icon_n2"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/bitable_superagent_panel_title_right_primary_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/bitable_superagent_panel_title_right_primary_icon"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:tint="@color/icon_n2"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bitable_superagent_panel_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.ee.bear.bitable.superagent.BitableSuperAgentLynxContainer
                android:id="@+id/bitable_superagent_panel_lynx_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bitable_superagent_panel_input_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/bitable_superagent_glow_bottom_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="top"
                app:barrierMargin="50dp"
                app:constraint_referenced_ids="bitable_superagent_panel_input_container"/>
            <com.bytedance.ee.bear.bitable.superagent.BitableSuperAgentGlowAnimationView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:layout_constraintBottom_toTopOf="@+id/bitable_superagent_glow_bottom_barrier"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/bitable_superagent_panel_input_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <include
                    android:id="@+id/bitable_superagent_panel_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/bitable_superagent_panel_input"/>
            </LinearLayout>
            <com.bytedance.ee.bear.bitable.superagent.at.BitableSuperAgentAtView
                android:id="@+id/atView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bitable_superagent_panel_input_container"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintHeight_max="320dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
