<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_float_base"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.timepicker.UDTimePicker
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/date_picker_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ud_timePicker_datePickerMode="yearMonthDay"
        app:ud_timePicker_itemVisibleNum="5"/>
</FrameLayout>
