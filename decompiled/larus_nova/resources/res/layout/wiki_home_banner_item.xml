<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wiki_banner_card_view"
    android:layout_width="100dp"
    android:layout_height="137dp"
    app:cardCornerRadius="@dimen/space_radius_l"
    app:cardElevation="0dp">
    <RelativeLayout
        android:id="@+id/wiki_banner_content"
        android:background="@drawable/wiki_list_view_item_border_new_v2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/wiki_banner_background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/space_kit_font_15"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/tv_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:maxLines="4"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_banner_star"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:tint="@color/lkui_Y500"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_collect_filled"/>
        <FrameLayout
            android:id="@+id/scope_content"
            android:background="@drawable/ic_wiki_public_tag_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_kit_len_18"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/udtoken_tag_neutral_text_inverse"
                android:ellipsize="end"
                android:id="@+id/tv_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="8dp"
                android:text="@string/Doc_Wiki_Home_Public"
                android:maxLines="1"/>
        </FrameLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
