<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_bg_root"
    android:background="@color/cj_pay_color_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_complete_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <include layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    </LinearLayout>
</FrameLayout>
