<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerContainer"
    android:background="@drawable/bg_banner_info"
    android:paddingLeft="14dp"
    android:paddingTop="9dp"
    android:paddingRight="14dp"
    android:paddingBottom="9dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/text_button_container_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_chat_close"
        app:layout_constraintStart_toEndOf="@+id/tv_chat_banner_title"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_content_default"
            android:id="@+id/tv_chat_action_btn_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_content_default"
            android:id="@+id/tv_chat_info_btn_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/text_button_container_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_chat_close"
        app:layout_constraintStart_toEndOf="@+id/iv_chat_info_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_chat_banner_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_content_default"
            android:id="@+id/tv_chat_action_btn_bottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_content_default"
            android:id="@+id/tv_chat_info_btn_bottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ud_title_color"
        android:id="@+id/tv_chat_banner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_IM_LargeGroupAutoMuted_Text"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/text_button_container_bottom"
        app:layout_constraintEnd_toStartOf="@+id/text_button_container_right"
        app:layout_constraintStart_toEndOf="@+id/iv_chat_info_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_chat_close"
        android:padding="4dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_close_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_chat_info_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_info_hollow_filled"
        app:tint="@color/function_warning_fill_default"/>
</androidx.constraintlayout.widget.ConstraintLayout>
