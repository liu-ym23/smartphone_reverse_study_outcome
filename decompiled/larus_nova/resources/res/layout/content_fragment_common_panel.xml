<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout
        android:layout_gravity="bottom"
        android:id="@+id/title_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:panel_background_color="@color/bg_float_base"
        app:panel_title="@string/Doc_List_SortBy"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/primary_content_default"
        android:id="@+id/tv_reset"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/space_kit_len_10"
        android:layout_marginBottom="@dimen/space_kit_len_12"
        android:text="@string/LarkCCM_NewCM_Default_Button"
        app:layout_constraintBottom_toBottomOf="@+id/title_panel"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content_panel"
        android:background="@color/bg_float_base"
        android:padding="@dimen/space_kit_len_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_panel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
