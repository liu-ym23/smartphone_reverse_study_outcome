<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="388dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fl_banner_lynx_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/waiting_list_rlv"
            android:background="@color/ttlive_core_hs_w1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/waiting_user_info_layout"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            app:cardBackgroundColor="@color/ttlive_core_hs_w1"
            app:cardElevation="16dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="98dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#56000000"
                    android:gravity="center"
                    android:id="@+id/tv_current_position"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="12dp"
                    app:actualImageScaleType="fitXY"
                    app:layout_constraintStart_toEndOf="@+id/tv_current_position"
                    app:layout_constraintTop_toTopOf="parent"
                    app:placeholderImageScaleType="fitXY"
                    app:roundAsCircle="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
                    app:layout_constraintLeft_toRightOf="@+id/iv_avatar"
                    app:layout_constraintTop_toTopOf="@+id/iv_avatar">
                    <TextView
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="#161823"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_gravity="start"
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:maxLines="1"
                        android:maxEms="7"
                        android:layout_marginStart="12dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#80161823"
                        android:gravity="start"
                        android:layout_gravity="start"
                        android:id="@+id/tv_user_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#80161823"
                    android:gravity="end"
                    android:id="@+id/desc_text_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="8dp"
                    android:text="@string/try_fast_link"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/one_click_to_apply"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#80161823"
                    android:gravity="end"
                    android:id="@+id/desc_text_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/no_need_to_wait"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/one_click_to_apply"
                    app:layout_constraintTop_toBottomOf="@+id/desc_text_1"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/one_click_to_apply"
                    android:background="@drawable/ttlive_btn_match_chat"
                    android:layout_width="64dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:minWidth="63dp"
                    android:text="@string/ttlive_interact_match_oneclick"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/waiting_list_empty_tips"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:layout_width="180dp"
            android:layout_height="156dp"
            android:layout_marginTop="72dp">
            <View
                android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
                android:layout_width="match_parent"
                android:layout_height="120dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80161823"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/ttlive_apple_panel_nobody_in_waiting_list"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
