<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="20dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center"
        android:id="@+id/recommend_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_window_sub_text_color"
        android:id="@+id/recommend_text"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="0.5dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_window_sub_text_color"
        android:id="@+id/rank_text"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginBottom="0.5dp"
        android:layout_weight="1"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center"
        android:id="@+id/recommend_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginRight="5dp"
        app:placeholderImage="@drawable/ec_window_recommend_brown_arrow"/>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
