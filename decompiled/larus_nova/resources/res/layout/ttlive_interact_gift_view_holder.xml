<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gift_view_holder_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="84dp"
    android:layout_height="110dp"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_view"
        android:background="@drawable/ttlive_interact_gift_lock_bg"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="9dp"
            android:textColor="#ccffffff"
            android:id="@+id/tag_view"
            android:background="@drawable/ttlive_gift_interact_gift_tag_bg"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="@+id/container_view"
            app:layout_constraintTop_toTopOf="@+id/container_view"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_image"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:scaleType="fitXY"
            app:failureImage="@drawable/ttlive_ic_default_gift"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_ic_default_gift"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gift_name_container"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_image">
            <TextView
                android:textSize="12dp"
                android:textColor="#ccffffff"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/gift_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:maxLines="1"
                android:alpha="0.9"
                android:layout_marginStart="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/diamond_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_name_container">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/diamond_left_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="8dp"
                android:layout_marginRight="2dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/diamond"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="9dp"
                android:textColor="#ffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/diamond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/send_gift_animation_view"
        android:clipChildren="false"
        android:layout="@layout/ttlive_layout_gift_select_view"
        android:inflatedId="@+id/gift_view_holder_container"
        android:layout_width="88dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
