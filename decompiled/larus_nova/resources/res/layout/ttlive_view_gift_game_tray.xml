<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="28dp">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:id="@+id/normal_gift_bg_view"
        android:layout_width="168dp"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:scaleType="centerCrop"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="yes"
        android:layout_alignStart="@+id/dummy_start"
        android:layout_alignEnd="@+id/dummy_end"
        app:ttlive_allRadius="12dp"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:id="@+id/normal_gift_bg_view_temp"
        android:visibility="visible"
        android:layout_width="168dp"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:scaleType="centerCrop"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="yes"
        android:layout_alignStart="@+id/dummy_start"
        android:layout_alignEnd="@+id/dummy_end"
        app:ttlive_allRadius="12dp"/>
    <View
        android:id="@+id/dummy_start"
        android:layout_width="@dimen/ttlive_gift_game_tray_height"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="12dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"/>
    <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
        android:id="@+id/gift_icon_animation_view"
        android:layout_width="@dimen/ttlive_gift_game_tray_height"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="14dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/dynamic_gift_icon"
        android:layout_width="@dimen/ttlive_gift_game_tray_height"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="14dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="6dp"
        android:maxWidth="78dp"
        android:lines="1"
        android:maxEms="6"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/dummy_start"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/gift_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="4dp"
        android:maxWidth="78dp"
        android:lines="1"
        android:maxEms="6"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/user_name_tv"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#ffffff"
        android:id="@+id/group_count"
        android:background="@drawable/ttlive_bg_gift_game_tray_group"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="1dp"
        android:text="@string/ttlive_gift_count"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="26dp"/>
    <View
        android:id="@+id/dummy_end"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_toEndOf="@+id/gift_description_tv"
        android:layout_alignEnd="@+id/combo_body"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/combo_body"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_gift_game_tray_height"
        android:layout_marginLeft="4dp"
        android:layout_alignParentBottom="true"
        android:paddingEnd="6dp"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/gift_description_tv">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:id="@+id/combo_count_x"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_gift_game_tray_height"
            android:text="@string/ttlive_gift_count"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:id="@+id/combo_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_gift_game_tray_height"
            android:layout_marginLeft="2dp"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</RelativeLayout>
