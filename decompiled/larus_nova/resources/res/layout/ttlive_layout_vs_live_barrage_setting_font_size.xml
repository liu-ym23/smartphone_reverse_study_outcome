<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.barrage.setting.InterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingLeft="31dp"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="31dp">
    <TextView
        android:textSize="13dp"
        android:textColor="#e5ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_barrage_fontsize"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.rangeseekbar.RangeSeekBar
        android:id="@+id/size_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/font_size"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/font_size"
        app:layout_constraintTop_toTopOf="@+id/font_size"
        app:rsb_gravity="center"
        app:rsb_indicator_show_mode="alwaysHide"
        app:rsb_mode="single"
        app:rsb_progress_color="#face15"
        app:rsb_progress_default_color="#4dffffff"
        app:rsb_progress_height="3dp"
        app:rsb_progress_radius="2dp"
        app:rsb_step_circle_style="true"
        app:rsb_step_color="#ffffff"
        app:rsb_step_height="3dp"
        app:rsb_step_width="3dp"
        app:rsb_thumb_height="14dp"
        app:rsb_thumb_width="14dp"/>
    <TextView
        android:textColor="#e5ffffff"
        android:id="@+id/font_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/ttlive_barrage_setting_midsize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</com.bytedance.android.livesdk.interactivity.barrage.setting.InterceptConstraintLayout>
