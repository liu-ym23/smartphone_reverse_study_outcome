<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout_fullscreen_face_live"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/cj_pay_view_standard_titlebar_layout"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="86dp"
        android:src="@drawable/cj_pay_icon_face_live"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_20"
        android:textColor="@color/cj_pay_color_black_34"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cj_pay_face_live_title"
        android:includeFontPadding="false"
        style="@style/CJPayShadowTextStyle"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="@color/cj_pay_color_gray_153"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/cj_pay_face_live_sub_title"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:paddingLeft="@dimen/cj_pay_padding_24"
        android:paddingRight="@dimen/cj_pay_padding_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/iv_agreement_checkbox"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_gray_153"
            android:id="@+id/tvProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_face_live_goto_protocol"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_custom_button_height_44"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        layout="@layout/cj_pay_common_loading_btn"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        app:theme_type="0"/>
</LinearLayout>
