<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_security_dialog_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="124dp"
        android:layout_height="120dp">
        <ImageView
            android:id="@+id/loading_gif_bg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cj_pay_security_dialog_loading_bg"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/cj_pay_loading_close"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_margin="8dp"
            android:src="@drawable/cj_pay_icon_dialog_loading_close"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/loading_gif_view"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"/>
            <com.bytedance.caijing.sdk.infra.base.api.lottie.LottieAnimationViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_brand_loading_view"
                android:visibility="gone"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"/>
            <ImageView
                android:id="@+id/cj_pay_loading_to_toast_icon"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="9dp"
                android:scaleType="centerCrop"
                android:layout_centerHorizontal="true"/>
            <com.android.ttcjpaysdk.bdpay.security.loading.view.CJScanningTextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_white_90"
                android:layout_gravity="center_horizontal"
                android:id="@+id/loading_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/cj_pay_color_white_90"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_loading_status_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="dddd"
                android:maxLines="1"
                android:alpha="0.5"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
