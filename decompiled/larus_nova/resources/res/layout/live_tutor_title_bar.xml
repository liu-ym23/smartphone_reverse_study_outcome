<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_44">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/live_tutor_iv_close"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="@dimen/dp_64"
        android:layout_height="match_parent"
        android:src="@drawable/live_tutor_back"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/black"
        android:id="@+id/live_tutor_iv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_tutor_title_cn"
        android:fontFamily="&apos;sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/ai_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dp_11"
        android:textColor="@color/live_tutor_ai_tips"
        android:id="@+id/ai_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_tutor_ai_generate_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_tutor_iv_title"/>
    <ImageView
        android:id="@+id/live_tutor_iv_settings"
        android:layout_width="55dp"
        android:layout_height="match_parent"
        android:src="@drawable/live_tutor_settings_btn"
        android:paddingStart="11dp"
        android:paddingEnd="20dp"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/live_tutor_iv_save_img"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="46dp"
        android:layout_height="match_parent"
        android:src="@drawable/live_tutor_save_board_btn"
        app:layout_constraintRight_toLeftOf="@+id/live_tutor_iv_settings"/>
</androidx.constraintlayout.widget.ConstraintLayout>
