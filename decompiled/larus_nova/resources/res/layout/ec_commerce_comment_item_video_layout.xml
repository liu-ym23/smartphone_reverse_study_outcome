<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_comment_video_rootview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.videoshop.mediaview.VideoPatchLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/ec_comment_video_patch_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_comment_sv_video_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ec_comment_video_play_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ec_commerce_icon_play_video"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_comment_video_maxheight_shadow"
        android:background="@drawable/commerce_comment_bg_top_shadow_view"
        android:layout_width="match_parent"
        android:layout_height="321dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView
            android:textSize="24dp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ec_comment_tv_video_play_duration"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>
        <com.bytedance.android.shopping.commentfeed.widget.VideoPlaySeekBar
            android:id="@+id/ec_comment_video_seekbar"
            android:background="@null"
            android:paddingTop="11dp"
            android:paddingBottom="28dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="2dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/ec_commerce_comment_video_seekbar_layer_progress"
            android:minHeight="2dp"
            android:thumb="@drawable/ec_commerce_comment_video_seekbar_thumb"
            android:thumbOffset="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"/>
    </LinearLayout>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:layout_gravity="center"
        android:id="@+id/ec_comment_video_load_status_icon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
</FrameLayout>
