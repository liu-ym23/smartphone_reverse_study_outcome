<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dora_o_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/memory_detail_scroll"
        android:paddingBottom="?attr/larus_dp_48"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_20"
            android:paddingEnd="?attr/larus_dp_20">
            <TextView
                android:textSize="?attr/larus_sp_20"
                android:textColor="@color/dora_o_text_primary"
                android:id="@+id/memory_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_secondary"
                android:id="@+id/memory_detail_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_primary"
                android:id="@+id/memory_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:lineSpacingExtra="?attr/larus_dp_6"/>
        </LinearLayout>
    </ScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/memory_detail_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
