<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intent_card_container"
    android:background="@drawable/weather_clear_day_rounded"
    android:layout_width="match_parent"
    android:layout_height="197dp"
    android:outlineProvider="background">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/weather_logo"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_app_name"
        android:layout_alignTop="@+id/logo"
        android:layout_alignBottom="@+id/logo"
        android:layout_toEndOf="@+id/logo"
        style="@style/Label_M_Thin"/>
    <FrameLayout
        android:id="@+id/divider"
        android:background="@color/assistant_card_static_white_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/logo"/>
    <TextView
        android:textColor="@color/oui_on_dark_text_1"
        android:id="@+id/location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="218dp"
        android:layout_below="@+id/divider"
        android:layout_marginStart="16dp"
        style="@style/Body_1_Medium"/>
    <ImageView
        android:id="@+id/weather_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_below="@+id/location"
        android:layout_alignStart="@+id/location"/>
    <TextView
        android:textColor="@color/oui_on_dark_text_1"
        android:id="@+id/weather_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxWidth="218dp"
        android:layout_below="@+id/weather_icon"
        android:layout_alignStart="@+id/weather_icon"
        style="@style/Subtitle_2_Medium"/>
    <TextView
        android:textColor="@color/oui_on_dark_text_1"
        android:id="@+id/temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/location"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        style="@style/Body_1_Medium"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/divider_between_weather_text_and_location"
        android:background="@drawable/divider_between_temp_and_time"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_alignTop="@+id/temp"
        android:layout_alignBottom="@+id/temp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/temp"/>
    <TextView
        android:textColor="@color/oui_on_dark_text_1"
        android:gravity="center_vertical"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/divider_between_weather_text_and_location"
        android:layout_alignBottom="@+id/divider_between_weather_text_and_location"
        android:layout_toStartOf="@+id/divider_between_weather_text_and_location"
        style="@style/Body_1_Medium"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hourly_info_container_outer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hourly_info_container_inner_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/oui_on_dark_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_time_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Subtitle_2_Regular"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_weather_icon_5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:textColor="@color/oui_on_accent_text_1_dark_on_image"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hourly_temp_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textColor="@color/oui_on_dark_text_1"
        android:id="@+id/temp_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_above="@+id/hourly_info_container_outer"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        style="@style/Display_1_Medium"/>
</RelativeLayout>
