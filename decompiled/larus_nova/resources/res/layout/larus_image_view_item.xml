<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.view.CustomTransitionPhotoDraweeView
        android:id="@+id/big_image_photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/larus_accessibility_message_photo"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/gallery_process"
        android:background="@drawable/larus_gallery_process_bg"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_91">
        <ProgressBar
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_album_smart_optimize"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <View
        android:id="@+id/big_image_photo_view_uplayer"
        android:background="@color/larus_static_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/big_image_loading"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_64"
        android:indeterminate="true"
        android:indeterminateDuration="750"
        android:indeterminateTint="@color/larus_neutral_50"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/big_image_retry_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/big_image_blank_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_refresh_white"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_photo_loading_retry"
            android:layout_below="@+id/big_image_blank_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
