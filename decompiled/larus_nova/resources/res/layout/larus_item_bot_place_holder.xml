<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <View
        android:id="@+id/avatar"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:layout_marginTop="?attr/larus_dp_2"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_toStartOf="@+id/add_bot"
        android:layout_toEndOf="@+id/avatar">
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="?attr/larus_dp_120"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_4"/>
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_4"/>
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:id="@+id/add_bot"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginTop="?attr/larus_dp_17"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
