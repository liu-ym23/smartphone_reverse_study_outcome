<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/input_container"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/input_control_scroll_view"
        android:scrollbars="none"
        android:clickable="false"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_send_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="44dp">
            <FrameLayout
                android:id="@+id/control_emoji_container"
                android:layout_width="29dp"
                android:layout_height="29dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/control_emoji"
                    android:background="@drawable/ttlive_control_emoji_toggle"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:button="@null"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/control_skin_container"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_marginLeft="25dp">
                <ImageView
                    android:layout_gravity="top|right"
                    android:id="@+id/red_dot_skin"
                    android:background="@drawable/ttlive_ic_red_point_tip_skin"
                    android:layout_width="6dp"
                    android:layout_height="6dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/control_skin"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ttlive_control_skin_toggle"/>
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/input_send_container"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/input_control_scroll_view"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/input_control_delete"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ttlive_input_v3_emoji_delete_off"/>
        <ImageView
            android:id="@+id/input_control_send_iv"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="1.5dp"
            android:src="@drawable/ttlive_input_v3_send_off"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@drawable/ttlive_color_msg_board_send_btn_toggle"
            android:gravity="center"
            android:id="@+id/input_control_send_tv"
            android:background="@drawable/ttlive_bg_msg_board_send_btn_toggle"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:text="@string/ttlive_sned_msg_board_send"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
