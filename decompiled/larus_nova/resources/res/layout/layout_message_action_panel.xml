<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chat.message.menu.v2.MessageActionPanelContainerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/lkui_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/animation_mask"
        android:background="@drawable/bg_message_action_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/action_panel_shadow"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_shadow_radius="12dp"
        style="@style/MessageActionPanelShadow">
        <com.ss.android.lark.chat.message.menu.v2.DragPanelLayout
            android:id="@+id/action_panel_container"
            android:background="@drawable/bg_message_action_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp">
            <include layout="@layout/layout_first_level_message_actions"/>
            <include layout="@layout/layout_second_level_message_actions"/>
        </com.ss.android.lark.chat.message.menu.v2.DragPanelLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/emoji_panel_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_shadow_radius="12dp"
        style="@style/MessageActionPanelShadow">
        <com.ss.android.lark.chat.message.menu.v2.DragPanelLayout
            android:id="@+id/emoji_panel_container"
            android:background="@drawable/bg_message_action_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_horizontal_bar_message_panel"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>
                <FrameLayout
                    android:id="@+id/all_emoji_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </com.ss.android.lark.chat.message.menu.v2.DragPanelLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/partial_select_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_shadow_radius="10dp"
        style="@style/UDShadow.S5.Down">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/partial_message_action_rv"
            android:background="@drawable/bg_partial_select_message_action_panel"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</com.ss.android.lark.chat.message.menu.v2.MessageActionPanelContainerLayout>
