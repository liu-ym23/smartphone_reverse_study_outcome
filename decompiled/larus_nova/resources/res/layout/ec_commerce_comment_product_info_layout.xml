<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_comment_product_info_layout_1908136245"
    android:background="@drawable/commerce_product_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.widget.RemoteRoundImageView
        android:id="@+id/comment_product_card_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"/>
    <TextView
        android:textColor="@color/commerce_color_BF161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/comment_product_card_title"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintLeft_toRightOf="@+id/comment_product_card_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/font_size_24"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="12sp"
        android:gravity="center_vertical"
        android:id="@+id/comment_product_card_price"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/comment_product_card_image"
        app:layout_constraintLeft_toRightOf="@+id/comment_product_card_image"
        app:layout_constraintTop_toBottomOf="@+id/comment_product_card_title"
        app:pv_prefixMarginRight="6dp"
        app:pv_prefixTextSizeRatio="0.54"
        app:pv_priceInFen="232353466"
        app:pv_priceTextColor="@color/commerce_color_FE2C55"
        app:pv_suffixTextMarginLeft="0dp"
        app:pv_suffixTextSizeRatio="1"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.75"/>
    <TextView
        android:textColor="@color/commerce_color_57161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/comment_product_card_good_rate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/comment_product_card_price"
        app:layout_constraintTop_toBottomOf="@+id/comment_product_card_title"
        style="@style/font_size_20"/>
    <TextView
        android:textColor="@color/commerce_color_80161823"
        android:gravity="center"
        android:id="@+id/comment_product_card_sale_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="9dp"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_product_card_title"
        style="@style/font_size_20"/>
</androidx.constraintlayout.widget.ConstraintLayout>
