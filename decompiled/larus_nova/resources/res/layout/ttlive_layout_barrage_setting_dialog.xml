<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="340dp"
    android:layout_height="375dp">
    <TextView
        android:id="@+id/ttlive_barrage_setting_blank_area"
        android:layout_width="92dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="205dp"
        android:layout_height="375dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#e5ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="@string/ttlive_barrage_setting"/>
            <Button
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/live_barrage_setting_default"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="104dp"
                android:text="@string/ttlive_barrage_setting_default"
                android:layout_marginStart="104dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#e5ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_barrage_setting_area"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/live_area_radiobutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <RadioButton
                    android:textSize="11dp"
                    android:textColor="@drawable/ttlive_selector_barrage_font"
                    android:gravity="center"
                    android:id="@+id/live_barrage_setting_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/ttlive_barrage_setting_close"
                    android:drawableTop="@drawable/ttlive_selector_barrage_close_toggle"
                    android:drawablePadding="4dp"/>
                <RadioButton
                    android:textSize="11dp"
                    android:textColor="@drawable/ttlive_selector_barrage_font"
                    android:gravity="center"
                    android:id="@+id/live_barrage_setting_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:button="@null"
                    android:text="@string/ttlive_barrage_setting_top"
                    android:drawableTop="@drawable/ttlive_selector_barrage_top_toggle"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="20dp"/>
                <RadioButton
                    android:textSize="11dp"
                    android:textColor="@drawable/ttlive_selector_barrage_font"
                    android:gravity="center"
                    android:id="@+id/live_barrage_setting_half"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:button="@null"
                    android:text="@string/ttlive_barrage_setting_half"
                    android:drawableTop="@drawable/ttlive_selector_barrage_half_toggle"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="20dp"/>
                <RadioButton
                    android:textSize="11dp"
                    android:textColor="@drawable/ttlive_selector_barrage_font"
                    android:gravity="center"
                    android:id="@+id/live_barrage_setting_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:button="@null"
                    android:text="@string/ttlive_barrage_setting_full"
                    android:drawableTop="@drawable/ttlive_selector_barrage_fullscreen_toggle"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="20dp"/>
            </RadioGroup>
        </LinearLayout>
        <com.bytedance.android.livesdk.interactivity.common.InterceptLinearLayout
            android:orientation="vertical"
            android:id="@+id/ttlive_half_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#e5ffffff"
                    android:id="@+id/ttlive_barrage_setting_fontsize_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_barrage_setting_fontsize"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/live_font_radiobutton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp">
                    <RadioButton
                        android:textSize="11dp"
                        android:textColor="@drawable/ttlive_selector_barrage_font"
                        android:gravity="center"
                        android:id="@+id/live_barrage_font_big"
                        android:layout_width="44dp"
                        android:layout_height="25dp"
                        android:checked="true"
                        android:button="@null"
                        android:text="@string/ttlive_barrage_setting_bigsize"/>
                    <RadioButton
                        android:textSize="11dp"
                        android:textColor="@drawable/ttlive_selector_barrage_font"
                        android:gravity="center"
                        android:id="@+id/live_barrage_font_mid"
                        android:layout_width="44dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="32dp"
                        android:button="@null"
                        android:text="@string/ttlive_barrage_setting_midsize"
                        android:layout_marginStart="32dp"/>
                    <RadioButton
                        android:textSize="11dp"
                        android:textColor="@drawable/ttlive_selector_barrage_font"
                        android:gravity="center"
                        android:id="@+id/live_barrage_font_small"
                        android:layout_width="44dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="32dp"
                        android:button="@null"
                        android:text="@string/ttlive_barrage_setting_smallsize"
                        android:layout_marginStart="32dp"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#e5ffffff"
                    android:id="@+id/ttlive_barrage_setting_alpha_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_barrage_setting_alpha"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp">
                    <SeekBar
                        android:id="@+id/live_barrage_alpha_seekbar"
                        android:background="@color/transparent"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="2dp"
                        android:progress="30"
                        android:progressDrawable="@drawable/ttlive_alpha_progress_drawable"
                        android:thumb="@drawable/ttlive_barrage_thumb_seek_bar"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/live_barrage_alpha_seekbar_process"
                        android:paddingLeft="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingStart="12dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#e5ffffff"
                    android:id="@+id/ttlive_barrage_setting_gift_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_barrage_setting_giftmessage"/>
                <ToggleButton
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_barrage_giftmessage"
                    android:background="@drawable/ttlive_selector_barrage_gift_toggle"
                    android:layout_width="40dp"
                    android:layout_height="25dp"
                    android:layout_marginLeft="109dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:layout_marginStart="109dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ttlive_barrage_setting_lottery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#e5ffffff"
                    android:id="@+id/ttlive_barrage_setting_lottery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_barrage_setting_lottery_barrage"/>
                <ToggleButton
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_barrage_lottery"
                    android:background="@drawable/ttlive_selector_barrage_gift_toggle"
                    android:layout_width="40dp"
                    android:layout_height="25dp"
                    android:layout_marginLeft="109dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:layout_marginStart="109dp"/>
            </LinearLayout>
        </com.bytedance.android.livesdk.interactivity.common.InterceptLinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/ttlive_barrage_setting_safe_area"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"/>
</LinearLayout>
