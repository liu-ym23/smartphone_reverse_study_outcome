<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forward_activity_root"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bg_mask"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_sheet_container"
        android:background="@drawable/doubao_forward_sheet_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rl_radius_left_bottom="0dp"
        app:rl_radius_left_top="24dp"
        app:rl_radius_right_bottom="0dp"
        app:rl_radius_right_top="24dp">
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
</FrameLayout>
