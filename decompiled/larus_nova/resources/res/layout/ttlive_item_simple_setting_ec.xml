<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="77dp"
    android:baselineAligned="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/replay_detail_setting_layout"
        android:background="@color/transparent"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_dark_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_switch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/ttlive_live_setting_replay"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/tv_switch_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_prelive_setting_dark_tips"
            android:id="@+id/tv_switch_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_anchor_replay_to_profile"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_switch_title"/>
        <ImageView
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_ic_red_point_tip"
            app:layout_constraintLeft_toRightOf="@+id/tv_switch_title"
            app:layout_constraintTop_toTopOf="@+id/tv_switch_title"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="22dp"
            android:layout_height="52dp"
            android:src="@drawable/ttlive_ic_right_arrow"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
