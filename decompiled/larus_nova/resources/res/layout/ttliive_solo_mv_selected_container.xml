<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="203dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_official"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="推荐背景"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/liveuikit_gray"
            android:gravity="center"
            android:id="@+id/tv_personal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:text="我的作品"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="163dp"
        android:layout_marginTop="40dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/offical_mv_container"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_vertical"
                android:id="@+id/official_mv_list"
                android:layout_width="match_parent"
                android:layout_height="115dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/personal_mv_list"
            android:layout_width="match_parent"
            android:layout_height="115dp"/>
        <ViewStub
            android:id="@+id/error_view_stub"
            android:layout="@layout/layout_solo_template_mv_list_error_view"
            android:inflatedId="@+id/error_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
