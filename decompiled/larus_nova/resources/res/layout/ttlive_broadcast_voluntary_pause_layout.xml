<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/pause_bg_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <View
        android:id="@+id/pause_bg_mark"
        android:background="#57000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/broadcast_pause_anchor_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="158dp"
        android:layout_marginRight="12dp">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/pause_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_broadcast_voluntary_pause_anchor_hint"
            android:alpha="0.9"/>
        <TextView
            android:textSize="48dp"
            android:textColor="@color/white"
            android:id="@+id/pause_countdown_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/pause_countdown_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_broadcast_voluntary_pause_countdown_hint"
            android:alpha="0.7"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/recover_live_view"
            android:background="@drawable/ttlive_bg_broadcast_voluntary_pause_recover"
            android:layout_width="178dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_broadcast_voluntary_pause_recover_live"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.common.AnchorPauseTipsView
        android:layout_gravity="center"
        android:id="@+id/broadcast_pause_audience_card"
        android:visibility="gone"
        android:layout_width="188dp"
        android:layout_height="166dp"/>
</FrameLayout>
