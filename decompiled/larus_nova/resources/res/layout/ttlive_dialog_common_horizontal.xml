<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_title"
        android:gravity="start"
        android:id="@+id/live_dialog_title"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center"
        android:id="@+id/live_dialog_message"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/live_dialog_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.bytedance.android.livesdk.widget.FitButton
            android:id="@+id/live_dialog_btn_2"
            style="@style/ttlive_live_dialog_button_horizontal"/>
        <com.bytedance.android.livesdk.widget.FitButton
            android:textStyle="bold"
            android:id="@+id/live_dialog_btn_1"
            style="@style/ttlive_live_dialog_button_horizontal"/>
    </LinearLayout>
</LinearLayout>
