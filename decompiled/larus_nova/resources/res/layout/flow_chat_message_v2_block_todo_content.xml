<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/flow_ud_neutral_50"
        android:id="@+id/todo_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/todo_title_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:ellipsize="end"
            android:id="@+id/todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:ellipsize="end"
        android:id="@+id/todo_assignee"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="26dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/todo_due_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="26dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_neutral_70"
            android:ellipsize="end"
            android:id="@+id/todo_due"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/todo_reminder"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/todo_actions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_primary_50"
            android:gravity="center"
            android:id="@+id/todo_follow"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="64dp"
            android:text="@string/Todo_Task_FollowButton"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_primary_50"
            android:gravity="center"
            android:id="@+id/todo_detail"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="76dp"
            android:text="@string/Todo_Task_ViewDetails"/>
    </LinearLayout>
</LinearLayout>
