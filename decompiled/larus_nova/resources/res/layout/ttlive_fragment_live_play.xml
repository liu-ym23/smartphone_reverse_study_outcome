<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.FitSysWinOptFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/recommend_swipe_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.view.LiveFrameLayout
        android:id="@+id/live_play_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            custom:failureImage="@drawable/ttlive_ic_live_default_bg"
            custom:failureImageScaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/switch_video_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            custom:failureImageScaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_landscape_background"
            android:background="@color/ttlive_black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/match_portrait_background_layer2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            custom:failureImageScaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/match_landscape_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_talk_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/video_background_foreground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/pk_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/sticker_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/player_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mask_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/top_mask_view"
                android:background="@drawable/ttlive_bg_live_interaction_top"
                android:layout_width="match_parent"
                android:layout_height="96dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/media_replay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/transition_transform"
            android:background="@color/black"
            android:visibility="gone"
            android:layout="@layout/ttlive_fragment_camera_transition"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/live_background_view"
            android:background="@drawable/ttlive_ic_live_default_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/live_background_cover"
            android:background="#99000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/radio_avatar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/radio_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <com.bytedance.android.live.liveinteract.bgComponent.theme.VideoThemeView
            android:id="@+id/radio_video_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/radio_animated"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/radio_ktv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <View
            android:id="@+id/radio_cover_dark_background"
            android:background="#66000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/draw_guess_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/bottom_befview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/interact_rev_feed_frame_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitStart"/>
        <ImageView
            android:id="@+id/interact_feed_frame_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitStart"/>
        <FrameLayout
            android:id="@+id/interact_rev_feed_frame_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/interact_feed_frame_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/interact_preload_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/interaction_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/interaction_layer_top_margin_bg"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"/>
            <FrameLayout
                android:id="@+id/fragment_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/interaction_bottom_container_view"
                android:background="#4c000000"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/live_loading_view_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.chatroom.ui.LoadingAnimView
                android:id="@+id/live_loading_webp_view"
                android:visibility="invisible"
                android:layout_width="90dp"
                android:layout_height="90dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_core_loading_text"
                android:layout_gravity="center"
                android:id="@+id/live_loading_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/ttlive_live_loading"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom|right"
            android:orientation="horizontal"
            android:id="@+id/live_preload_toolbar_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:layout_gravity="top|left"
            android:orientation="horizontal"
            android:id="@+id/live_preload_userinfo_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/center_dialog_stub"
            android:layout="@layout/ttlive_module_live_room_center_dialog"
            android:layout_width="300dp"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/live_follow_recommend_btn_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/paid_live_mask_v2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/live_landscape_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.live.core.view.LiveFrameLayout>
</com.bytedance.android.livesdk.widget.FitSysWinOptFrameLayout>
