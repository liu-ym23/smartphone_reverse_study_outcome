<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/ttlive_voice_chat_guest_seat_row_width"
    android:layout_height="@dimen/ttlive_voice_chat_guest_seat_row_height">
    <View
        android:id="@+id/guide_view_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_empty_content"
        app:layout_constraintHorizontal_weight="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0"
        app:layout_constraintStart_toEndOf="@+id/ttlive_empty_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_empty_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_right"
        app:layout_constraintHorizontal_weight="64"
        app:layout_constraintStart_toEndOf="@+id/guide_view_left"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/guide_content_view_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="2"/>
        <View
            android:id="@+id/guide_content_view_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintVertical_weight="2"/>
        <View
            android:id="@+id/guide_content_view_point"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_right"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_right"
            app:layout_constraintHorizontal_weight="40"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_left"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_left"
            app:layout_constraintVertical_weight="40"/>
        <View
            android:id="@+id/ttlive_invite_link_guide_effect_animator"
            android:background="@drawable/ttlive_bg_radio_interact_guest_empty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ttlive_lock"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ttlive_icon_interact_position_lock"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_invite_link_guide_effect_animator"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_invite_link_guide_effect_animator"
            app:layout_constraintStart_toStartOf="@+id/ttlive_invite_link_guide_effect_animator"
            app:layout_constraintTop_toTopOf="@+id/ttlive_invite_link_guide_effect_animator"/>
        <com.bytedance.android.live.liveinteract.view.PositionNameTv
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/ttlive_position_name"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLength="4"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="#87ffffff"
        android:id="@+id/ttlive_empty_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_live_radio_interact_waiting"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_empty_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
