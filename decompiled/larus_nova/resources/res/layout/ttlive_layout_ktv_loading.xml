<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:id="@+id/douyin_loading_view"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/hotsoon_loading_view"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#80161823"
        android:id="@+id/loading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_refresh_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
