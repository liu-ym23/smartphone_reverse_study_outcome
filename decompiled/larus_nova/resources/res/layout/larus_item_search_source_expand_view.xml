<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_source_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_conditional_link_50"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_reference_index"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_16"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_conditional_link_50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_reference_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginEnd="?attr/larus_dp_16"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/tv_source_expand_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_deepThink_chat_label_expand_reference"/>
</LinearLayout>
