<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/follow_guide_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/dismiss_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dialog_view"
        android:background="@drawable/ttlive_bg_live_remind_follow"
        android:layout_width="match_parent"
        android:layout_height="178dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/avatar_position"
        android:background="@drawable/ttlive_bg_avatar_border"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_position"
        app:layout_constraintEnd_toEndOf="@+id/avatar_position"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_position"
        app:layout_constraintRight_toRightOf="@+id/avatar_position"
        app:layout_constraintStart_toStartOf="@+id/avatar_position"
        app:layout_constraintTop_toTopOf="@+id/avatar_position"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/name_container"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="110dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/anchor_level"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            app:actualImageScaleType="fitXY"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_hs_unfollow"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@+id/name_container"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/follow"
        android:background="@drawable/ttlive_bg_live_remind_follow_btn"
        android:layout_width="@dimen/ttlive_dialog_remind_follow_btn_width"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_follow_broadcaster"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/hotsoon_location_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/hotsoon_description"
        app:layout_constraintTop_toBottomOf="@+id/name_container">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/hotsoon_location_icon"
            android:background="@drawable/ttlive_ic_hotsoon_follow_guide_location"
            android:layout_width="9dp"
            android:layout_height="11dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:id="@+id/hotsoon_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#80161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/hotsoon_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_hotsoon_follow_guide_description"
        app:layout_constraintTop_toBottomOf="@+id/hotsoon_location_container"
        app:layout_goneMarginTop="8dp"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/hotsoon_follow"
        android:background="@drawable/ttlive_bg_live_remind_follow_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_follow_broadcaster_immediately"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hotsoon_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
