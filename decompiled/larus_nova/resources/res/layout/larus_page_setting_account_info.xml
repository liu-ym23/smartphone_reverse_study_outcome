<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/larus_page_setting_account_info_1341024272"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/account_info_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/account_info_scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/larus_layout_common_padding"
        android:paddingEnd="@dimen/larus_layout_common_padding">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/account_info_group"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/account_login_phone"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_account_display_phone"
                    app:larus_sub_text="@string/larus_unbound_text"
                    app:larus_sub_text_force_ltr="true"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.cardview.widget.CardView
                android:id="@+id/setting_device_management"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="?attr/larus_dp_12"
                app:cardElevation="0dp">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/device_management"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_accountSettings_listOption_device"/>
            </androidx.cardview.widget.CardView>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/advanced_setting_group"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextView
                    android:textColor="@color/larus_danger_50"
                    android:id="@+id/setting_account_logoff"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_delete_account"/>
                <com.larus.bmhome.view.item.ItemTextView
                    android:textColor="@color/larus_danger_50"
                    android:id="@+id/setting_account_logout"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_sign_out"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
