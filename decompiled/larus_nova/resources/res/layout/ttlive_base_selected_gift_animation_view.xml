<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/ttlive_base_gift_selected_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <View
        android:id="@+id/top_container"
        android:background="@drawable/ttlive_interact_gift_select_top_bg"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="0.4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container">
        <View
            android:id="@+id/bottom_bg"
            android:background="@drawable/ttlive_base_gift_selected_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/select_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="移除"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_bg"
            app:layout_constraintEnd_toEndOf="@+id/bottom_bg"
            app:layout_constraintStart_toStartOf="@+id/bottom_bg"
            app:layout_constraintTop_toTopOf="@+id/bottom_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_image"
        android:layout_width="@dimen/ttlive_gift_send_animation_view_size"
        android:layout_height="@dimen/ttlive_gift_send_animation_view_size"
        android:layout_marginTop="4dp"
        app:fadeDuration="0"
        app:failureImage="@drawable/ttlive_ic_default_gift"
        app:layout_constraintEnd_toEndOf="@+id/top_container"
        app:layout_constraintStart_toStartOf="@+id/top_container"
        app:layout_constraintTop_toTopOf="@+id/top_container"
        app:placeholderImage="@drawable/ttlive_ic_default_gift"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_image">
        <TextView
            android:textSize="9dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/gift_name_tiny_view"
            android:layout_width="match_parent"
            android:layout_height="11dp"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/gift_name"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:alpha="0.9"
            android:layout_marginStart="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/diamond"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:alpha="0.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@drawable/ttlive_base_gift_selected_bg"
        android:layout_width="match_parent"
        android:layout_height="110.75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/loading_view"
        android:background="@drawable/ttlive_interact_gift_loading_bg"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
