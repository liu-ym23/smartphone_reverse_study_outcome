<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/pinch_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/paused_image_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.awemeopen.apps.framework.feed.pinch.ui.ImageCanvasView
            android:layout_gravity="center"
            android:id="@+id/image_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/click_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="58dp"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/below_video_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="500dp"/>
    <FrameLayout
        android:layout_gravity="bottom|left"
        android:id="@+id/above_video_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/above_video_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/guide_anim_container"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginBottom="58dp"/>
    <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
        android:textColor="@color/ConstTextInverse"
        android:ellipsize="end"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pinch_view_subtitle_tv"
        android:background="@drawable/common_feed_subtitle_card_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="81dp"
        android:maxWidth="270dp"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:textSpec="P1"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/right_top_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="16dp"/>
    <com.bytedance.awemeopen.apps.framework.feed.pinch.ui.TouchFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/button_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:splitMotionEvents="false">
        <FrameLayout
            android:id="@+id/video_btn_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_btn_bar_long_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/slides_btn_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.awemeopen.apps.framework.feed.pinch.ui.TouchFrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_view"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fast_speed_view"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:splitMotionEvents="false">
        <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
            android:textStyle="bold"
            android:textColor="@color/aos_white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/familiar_pinch_fast_speed_desc"/>
    </FrameLayout>
    <com.bytedance.awemeopen.apps.framework.base.view.seekbar.SupportSeekBarFrameLayout
        android:id="@+id/seek_bar_frame_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.seekbar.SupportSeekBarFrameLayout
        android:id="@+id/seek_bar_relative_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/related_dialog_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
