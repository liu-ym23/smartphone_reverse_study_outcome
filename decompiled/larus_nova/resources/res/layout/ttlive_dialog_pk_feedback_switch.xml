<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_feedback_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="192dp">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/feedback_back"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="12dp"
                android:src="@drawable/ttlive_ic_pk_back"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_black"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_pk_feedback_dialog_title_any_problem"/>
        </FrameLayout>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkFeedbackView
            android:id="@+id/pk_feedback"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="#a3a3a3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/net_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_core_load_status_network_error"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_submit"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_submit_text"/>
    </LinearLayout>
</LinearLayout>
