<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.bytedance.android.live.core.widget.CustomFontTextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_core_hs_d1"
            android:gravity="center_horizontal"
            android:id="@+id/follower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_core_hs_g4"
            android:gravity="center_horizontal"
            android:id="@+id/follower_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_replay_profile_follower"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/following_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.bytedance.android.live.core.widget.CustomFontTextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_core_hs_d1"
            android:gravity="center_horizontal"
            android:id="@+id/following"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.live.core.widget.FitTextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_core_hs_g4"
            android:gravity="center_horizontal"
            android:id="@+id/following_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_replay_profile_following"/>
    </LinearLayout>
</LinearLayout>
