<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bottom_bar_view"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ff2200"
        android:id="@+id/recharge_guide_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_view"
        app:layout_constraintLeft_toLeftOf="@+id/bottom_bar_view"
        app:layout_constraintStart_toStartOf="@+id/bottom_bar_view"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_view"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/recharge_guide_button"
        android:background="@drawable/ttlive_bg_gift_send"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_live_recharge_guide_gift_button"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_view"
        app:layout_constraintEnd_toEndOf="@+id/bottom_bar_view"
        app:layout_constraintRight_toRightOf="@+id/bottom_bar_view"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_view"/>
    <View
        android:id="@+id/recharge_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_view"
        app:layout_constraintEnd_toEndOf="@+id/charge_arrow"
        app:layout_constraintStart_toStartOf="@+id/tv_diamond"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_view"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_diamond"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_diamond"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_diamond"/>
    <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_hs_s5"
        android:gravity="center_vertical"
        android:id="@+id/tv_diamond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_view"
        app:layout_constraintStart_toEndOf="@+id/iv_diamond"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_view"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_hs_s31"
        android:id="@+id/charge_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="2dp"
        android:text="@string/ttlive_title_charge"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_diamond"
        app:layout_constraintStart_toEndOf="@+id/tv_diamond"/>
    <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
        android:id="@+id/charge_arrow"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginLeft="2dp"
        android:src="@drawable/ttlive_ic_panel_charge_arrow"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_diamond"
        app:layout_constraintStart_toEndOf="@+id/charge_btn"
        app:layout_constraintTop_toTopOf="@+id/tv_diamond"/>
    <com.bytedance.android.live.core.widget.FitTextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_hs_s5"
        android:gravity="center"
        android:id="@+id/send"
        android:background="@drawable/ttlive_bg_gift_send"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_giving"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_bar_view"
        app:layout_constraintEnd_toEndOf="@+id/bottom_bar_view"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_view"/>
    <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_hs_s5"
        android:gravity="center"
        android:id="@+id/send_group_count"
        android:background="@drawable/ttlive_bg_gift_send_left"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="-1dp"
        android:minWidth="58dp"
        android:drawableRight="@drawable/ttlive_ic_panel_gift_group_arrow"
        android:drawableEnd="@drawable/ttlive_ic_panel_gift_group_arrow"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/send"
        app:layout_constraintRight_toLeftOf="@+id/send"
        app:layout_constraintTop_toTopOf="@+id/send"/>
    <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_hs_s5"
        android:gravity="center"
        android:id="@+id/send_group_count_rtl"
        android:background="@drawable/ttlive_bg_gift_send_left"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginLeft="-1dp"
        android:minWidth="58dp"
        android:drawableRight="@drawable/ttlive_ic_panel_gift_group_arrow"
        android:drawableEnd="@drawable/ttlive_ic_panel_gift_group_arrow"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/send"
        app:layout_constraintLeft_toRightOf="@+id/send"
        app:layout_constraintTop_toTopOf="@+id/send"/>
    <com.bytedance.android.livesdk.gift.platform.core.ui.SpecialCombView
        android:id="@+id/send_repeat_special_comb_view"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_special_comb_view_width"
        android:layout_height="@dimen/ttlive_special_comb_view_height"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
