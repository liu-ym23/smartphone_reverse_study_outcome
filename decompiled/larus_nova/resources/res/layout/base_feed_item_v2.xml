<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/middle_feed_resolve_bg"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.image.UDAvatar
        android:layout_gravity="center_vertical"
        android:id="@+id/user_msg_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:ud_avatar_borderWidth="0dp"
        app:ud_avatar_size="middle"
        style="@style/UDAvatar.Circle"/>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:id="@+id/unread_ico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="3dp"
        android:layout_alignEnd="@+id/user_msg_image"
        style="@style/UDBadge.Dot.StrongReminder.Large"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/user_msg_image"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/quote_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/tv_name"
        android:layout_marginEnd="16dp"
        android:layout_alignStart="@+id/tv_name">
        <View
            android:id="@+id/comment_card_divider"
            android:background="@drawable/facade_round_around_xs"
            android:layout_width="2dp"
            android:layout_height="14dp"
            android:layout_marginLeft="@dimen/space_kit_len_1"
            android:backgroundTint="@color/udtoken_quote_bar_bg"/>
        <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/comment_card_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_kit_len_4"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:lineSpacingExtra="6sp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/sub_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/quote_layout"
        android:layout_alignStart="@+id/tv_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:id="@+id/tv_create_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="22dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_below="@+id/sub_content"
        android:layout_alignStart="@+id/sub_content"/>
    <View
        android:id="@+id/v_divider"
        android:background="@color/line_border_card"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_below="@+id/tv_create_at"
        android:layout_alignStart="@+id/tv_create_at"/>
</RelativeLayout>
