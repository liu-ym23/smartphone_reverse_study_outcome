<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_password_component_root_view"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
        android:textSize="?attr/cj_pay_page_size_24"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_34"
        android:id="@+id/cj_pay_set_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_48"
        android:text="@string/cj_pay_verify_pwd"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_13"
        android:textColor="@color/cj_pay_color_gray_153"
        android:id="@+id/cj_pay_set_pwd_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:text="@string/cj_pay_input_verify_pwd_to_identify"
        android:layout_below="@+id/cj_pay_set_pwd"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.thirdparty.view.CJPayPwdEditText
        android:id="@+id/cj_pay_pwd_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_55"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:layout_below="@+id/cj_pay_set_pwd_tip"
        android:layout_centerHorizontal="true"
        app:CJPayDotRadius="6dp"
        app:CJPayIsShowPwd="false"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_gray_206"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="@dimen/cj_pay_height_half_1"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_blue"
        android:id="@+id/cj_pay_forget_pwd_view"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:text="@string/cj_pay_forget_password"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_pwd_view"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_14"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_forget_pwd_view"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="2dp"/>
    <View
        android:id="@+id/cj_pay_keyboard_margin_bottom_view"
        android:background="@color/cj_pay_color_pwd_keyboard_gap_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_padding_1"
        android:layout_alignParentBottom="true"/>
    <com.android.ttcjpaysdk.base.ui.widget.TalkbackKeyboardNoiseReductionView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/cj_pay_keyboard_margin_bottom_view"
        android:keepScreenOn="true"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_verify_password_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
