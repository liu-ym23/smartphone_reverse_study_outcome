<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp">
        <ImageView
            android:id="@+id/loading_empty_icon"
            android:layout_width="205dp"
            android:layout_height="150dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/ttlive_empty_content_dark"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_white_50"
            android:id="@+id/loading_empty_text_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_chosen_empty_text"/>
    </LinearLayout>
</FrameLayout>
