<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_ic_skills"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="?attr/larus_icon_skills"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/action_bar_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_moveFeatures_bottomSheet_title_tools"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ic_skills"
            app:layout_constraintStart_toEndOf="@+id/iv_ic_skills"
            app:layout_constraintTop_toTopOf="@+id/iv_ic_skills"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/action_bar_panel_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_moveFeatures_bottomSheet_desc_reorderTip"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ic_skills"
            app:layout_constraintStart_toEndOf="@+id/action_bar_panel_title"
            app:layout_constraintTop_toTopOf="@+id/iv_ic_skills"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/action_bar_panel_close"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ic_skills"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_ic_skills"
            app:srcCompat="?attr/larus_ic_input_editor_close"/>
        <View
            android:id="@+id/action_bar_panel_click_area"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.common_ui.widget.MaxHeightRecyclerView
        android:id="@+id/recycler_view_action_bar_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"/>
    <View
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
