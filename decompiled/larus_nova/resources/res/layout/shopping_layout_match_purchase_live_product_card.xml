<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_card_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.anchorv3.matchpurchase.view.ExtendedHotAreaCheckBox
        android:id="@+id/cb_product_card"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/product_card_picture_container"
        app:layout_constraintEnd_toStartOf="@+id/product_card_picture_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/product_card_picture_container"/>
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:id="@+id/product_card_picture_container"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/cb_product_card"
        app:rounded_radius="4dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/product_card_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/product_card_picture_tip"
            android:background="@color/const_tSecondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp">
            <TextView
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/product_card_picture_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/font_size_28"/>
        </FrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
    <TextView
        android:textColor="@color/shopping_color_mp_product_title"
        android:ellipsize="end"
        android:id="@+id/tv_product_card_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/product_card_picture_container"
        app:layout_constraintTop_toTopOf="@+id/product_card_picture_container"
        style="@style/font_size_26"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_product_card_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_card_title">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_product_card_spec_info"
            android:background="@drawable/shopping_match_purchase_unselected_bg"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/commerce_color_BF161823"
                android:ellipsize="end"
                android:id="@+id/tv_product_card_selected_spec_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_match_purchase_product_card_default_spec"
                android:maxLines="1"
                android:alpha="0.75"
                style="@style/font_size_26"/>
            <ImageView
                android:id="@+id/iv_product_card_select_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:src="@drawable/shopping_match_purchase_select_icon"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="17sp"
        android:textColor="@color/shopping_std_brand"
        android:id="@+id/pv_product_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/product_card_picture_container"
        app:layout_constraintStart_toStartOf="@+id/tv_product_card_title"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="2dp"
        app:pv_prefixTextSizeRatio="0.588"
        app:pv_priceBold="false"
        app:pv_priceDecimalTextSizeRatio="1"
        app:pv_priceTextColor="@color/shopping_std_brand"
        app:pv_suffixTextSizeRatio="1"
        app:pv_yuanSymbolMarginRight="1dp"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.647"/>
    <TextView
        android:textColor="@color/shopping_std_text_black_3"
        android:id="@+id/tv_selected_product_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pv_product_price"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/font_size_28"/>
</androidx.constraintlayout.widget.ConstraintLayout>
