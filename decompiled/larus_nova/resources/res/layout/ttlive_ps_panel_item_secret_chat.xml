<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttlive_ps_panel_white_round_corner"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_top_item_area_height">
    <ImageView
        android:background="@drawable/ttlive_ps_panel_secret_chat_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_ps_panel_word_75_gray"
        android:id="@+id/text_secret_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="对TA说"/>
</LinearLayout>
