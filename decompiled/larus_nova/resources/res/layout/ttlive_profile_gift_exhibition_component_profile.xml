<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gift_exhibition_root"
    android:background="@drawable/ttlive_bg_gift_exhibition_profile"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="8dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_bg_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_color_BF_161823"
        android:id="@+id/gift_exhibition_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_E6_161823"
        android:id="@+id/gift_exhibition_lighted_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_title"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_E6_161823"
        android:id="@+id/gift_exhibition_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_lighted_count"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_E6_161823"
        android:id="@+id/gift_exhibition_total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_divider"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_all_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_total_count"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_icon_anim_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_total_count"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/gift_exhibition_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/gift_exhibition_icon_over_anim_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/gift_exhibition_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/ttlive_profile_gift_exhibition_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
