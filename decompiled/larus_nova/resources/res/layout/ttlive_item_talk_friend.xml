<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/img_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/v_online_state"
            android:background="@drawable/ttlive_bg_talk_invite_list_friend_online_state_white"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="-3dp"
            android:layout_marginBottom="-3dp"
            android:layout_marginEnd="-3dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_talk_invite_list_friend_online_state_green"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="88dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="88dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_invite"
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginLeft="-88dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_invite"
        android:layout_marginStart="-88dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anim_container"
        android:background="@drawable/ttlive_bg_live_grey_btn"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginLeft="-88dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="-88dp"
        android:layout_marginEnd="16dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/calling"
            android:layout_width="20dp"
            android:layout_height="16dp"
            android:layout_marginLeft="5dp"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_anchor_link_window_inviting"/>
    </LinearLayout>
</LinearLayout>
