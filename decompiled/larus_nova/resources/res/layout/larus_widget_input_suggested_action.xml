<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/larus_base_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/input_suggested_action_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"/>
    <com.larus.common_ui.view.SuggestedActionBar
        android:id="@+id/input_suggest_action_bar"
        android:padding="12dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
