<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu"
    android:background="@drawable/larus_bg_btn_r16_base_3"
    android:layout_width="?attr/larus_dp_200"
    android:layout_height="?attr/larus_dp_96"
    android:elevation="?attr/larus_dp_24">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/edit_btn"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_20">
        <ImageView
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_screen_menu_modify"
            app:tint="@color/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_broadcast_rule_action_edit_cn"
            android:layout_marginStart="?attr/larus_dp_12"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintTop_toBottomOf="@+id/edit_btn"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/delete_btn"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_48"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_20"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <ImageView
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_trash_black"
            app:tint="@color/larus_danger_50"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_danger_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_broadcast_dialog_delete_rule_btn_confirm_cn"
            android:layout_marginStart="?attr/larus_dp_12"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
