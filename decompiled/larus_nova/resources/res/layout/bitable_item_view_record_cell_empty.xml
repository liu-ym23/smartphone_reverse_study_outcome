<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/empty_add_view"
        android:background="@drawable/bitable_page_field_empty_value_icon_bg"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:tint="@color/icon_n3"
        app:srcCompat="@drawable/ud_icon_add_outlined"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/empty_dashline"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="22dp"
        android:tint="@color/icon_disable"
        app:srcCompat="@drawable/ud_icon_reduce_outlined"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/empty_placeholder"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="0dp"/>
</merge>
