<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_game_detail_title_close2"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/gamecp_game_detail_title_close_ic"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_game_detail_title_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_game_detail_title_close"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/gamecp_game_detail_title_close_ic"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/iv_game_detail_title_game_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:roundedCornerRadius="6dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gamecp_black"
            android:id="@+id/tv_game_detail_title_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</FrameLayout>
