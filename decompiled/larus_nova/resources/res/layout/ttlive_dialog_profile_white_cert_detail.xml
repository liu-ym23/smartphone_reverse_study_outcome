<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/background_icon"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/cert_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_BF_161823"
        android:id="@+id/cert_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/background_icon"
        app:layout_constraintTop_toTopOf="@+id/background_icon"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/cert_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/cert_name"
        app:layout_constraintLeft_toRightOf="@+id/cert_name"
        app:layout_constraintTop_toTopOf="@+id/cert_name"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_color_57_161823"
        android:id="@+id/cert_short_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/cert_name"
        app:layout_constraintTop_toBottomOf="@+id/cert_name"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_color_BF_161823"
        android:id="@+id/cert_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="0dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
