<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prompt_input_container"
        android:background="@drawable/larus_bg_input_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_dp_16"
            android:gravity="start|center_vertical"
            android:id="@+id/prompt_input_text"
            android:background="@android:color/transparent"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingBottom="?attr/larus_dp_12"
            android:visibility="visible"
            android:scrollbars="vertical"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_200"
            android:minHeight="?attr/larus_dp_56"
            android:hint="@string/larus_AI_generate_placeholder"
            android:inputType="textMultiLine"
            android:paddingStart="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_send"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/larus_EditTextStyle"/>
        <ImageView
            android:id="@+id/action_send"
            android:visibility="visible"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:src="@drawable/larus_ic_send"
            android:layout_marginStart="?attr/larus_dp_5"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/prompt_input_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/prompt_input_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
