<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_image_container"
    android:background="@color/white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/image_blur_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/image_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:placeholderImage="@drawable/ec_ecommerce_slogan_product_bg"
            app:placeholderImageScaleType="fitXY"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/image_layer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.SquareFrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/image_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitCenter"
                app:placeholderImage="@drawable/ec_ecommerce_slogan_product_bg"
                app:placeholderImageScaleType="centerCrop"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/image_lottieview"
                android:background="#80000000"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitXY"
                app:lottie_fileName="commodity_main_card_loading.json"
                app:lottie_imageAssetsFolder="images"
                app:lottie_loop="true"/>
            <com.bytedance.android.shopping.widget.RemoteRoundImageView
                android:id="@+id/atmosphere_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.bytedance.android.ec.core.widget.SquareFrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
    </LinearLayout>
    <com.bytedance.android.shopping.feed.view.GoodPriceStrip
        android:layout_gravity="bottom"
        android:id="@+id/good_price_strip"
        android:background="@drawable/commerce_bg_good_price_product_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:layout_marginStart="12dp"
        android:elevation="2dp"/>
    <FrameLayout
        android:id="@+id/head_image_up_layer"
        android:background="@color/ec_inner_flow_head_image_up_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/head_image_bubble_point"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ec_inflow_head_image_bubble_point"
            android:translationY="-26dp"/>
    </FrameLayout>
</FrameLayout>
