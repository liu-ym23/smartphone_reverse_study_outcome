<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="20dp"
    android:layout_width="82dp"
    android:layout_height="wrap_content">
    <com.bytedance.lighten.loader.SmartImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/new_effet"
        android:visibility="gone"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.lighten.loader.SmartCircleImageView
        android:id="@+id/audio_guest_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        app:actualImageResource="@drawable/ttlive_bg_audio_default_avatar"
        app:failureImage="@drawable/ttlive_bg_audio_default_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_audio_default_avatar"/>
    <ImageView
        android:id="@+id/audio_guest_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ttlive_ic_audio_guest_add"
        app:layout_constraintBottom_toBottomOf="@+id/audio_guest_avatar"
        app:layout_constraintEnd_toEndOf="@+id/audio_guest_avatar"
        app:layout_constraintStart_toStartOf="@+id/audio_guest_avatar"
        app:layout_constraintTop_toTopOf="@+id/audio_guest_avatar"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/audio_guest_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:lineSpacingExtra="2dp"
        android:alpha="0.9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_guest_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
