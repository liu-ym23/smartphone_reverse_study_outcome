<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/annie_title_bar_container"
    android:paddingTop="9dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/annie_title_bar_height">
        <ImageView
            android:id="@+id/annie_activity_back"
            android:visibility="gone"
            android:layout_width="@dimen/annie_container_icon_size"
            android:layout_height="@dimen/annie_container_icon_size"
            android:layout_marginLeft="@dimen/annie_container_icon_margin"
            android:src="@drawable/annie_webview_back"
            android:layout_alignParentLeft="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/annie_container_icon_margin"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/annie_activity_close_left"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/annie_container_icon_size"
            android:layout_height="@dimen/annie_container_icon_size"
            android:layout_marginLeft="@dimen/annie_container_icon_margin"
            android:src="@drawable/annie_titlebar_close_dark"
            android:layout_alignParentLeft="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/annie_container_icon_margin"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/annie_activity_close"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/annie_container_icon_size"
            android:layout_height="@dimen/annie_container_icon_size"
            android:src="@drawable/annie_titlebar_close_dark"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:layout_marginEnd="@dimen/annie_container_icon_margin"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/annie_activity_share"
            android:visibility="gone"
            android:layout_width="@dimen/annie_container_icon_size"
            android:layout_height="@dimen/annie_container_icon_size"
            android:src="@drawable/annie_ic_web_share"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:layout_marginEnd="@dimen/annie_container_icon_margin"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
