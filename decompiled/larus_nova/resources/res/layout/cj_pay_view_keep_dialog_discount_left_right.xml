<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minWidth="280dp">
    <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/keep_dialog_title_text_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/keep_dialog_subtitle_red"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:id="@+id/keep_dialog_subtitle_images_red"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="-1dp">
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image1_bg"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@color/cj_pay_color_white"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image1_red"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="1dp"
                android:alpha="0.75"
                android:layout_marginStart="1dp"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image2_bg"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="14dp"
                android:src="@color/cj_pay_color_white"
                android:layout_marginStart="14dp"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image2_red"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="1dp"
                android:alpha="0.75"
                android:layout_marginStart="15dp"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image3_bg"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="28dp"
                android:src="@color/cj_pay_color_white"
                android:layout_marginStart="28dp"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
            <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
                android:id="@+id/keep_dialog_subtitle_image3_red"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="29dp"
                android:layout_marginTop="1dp"
                android:alpha="0.75"
                android:layout_marginStart="29dp"
                app:CJPayRoundCornerImageCornerRadius="18dp"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center_horizontal"
            android:id="@+id/keep_dialog_subtitle_text_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.2"/>
    </FrameLayout>
    <View
        android:id="@+id/bottom_split_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"/>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/button_horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/exit_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
        <View
            android:id="@+id/split_line_middle"
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/continue_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
