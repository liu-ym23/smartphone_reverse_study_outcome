<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="14dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/interact_song_gold_microphone_layout"
        android:background="@drawable/ttlive_bg_request_song_gold_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp">
        <View
            android:layout_gravity="center"
            android:id="@+id/request_song_label_icon_view"
            android:background="@drawable/ttlive_icon_request_song_gold_label"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/request_song_label_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#673405"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/request_song_label_score_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#673405"
                android:layout_gravity="center"
                android:id="@+id/request_song_label_singing_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_request_song_singing_label_text"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:typeface="sans"
        android:textStyle="italic|bold"
        android:textColor="#673405"
        android:layout_gravity="center"
        android:id="@+id/request_song_label_plus_n"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
