<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radio_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/surface_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/radio_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/radio_animated_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/radio_dynamic_background_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.liveinteract.bgComponent.theme.VideoThemeView
        android:id="@+id/radio_video_theme"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/radio_cover_water_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_auditing_water_mask"/>
    <ImageView
        android:id="@+id/radio_cover_dark_mask"
        android:background="#33000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.liveinteract.radio.RadioDarkMaskView
        android:id="@+id/radio_cover_dark_mask_v2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/dynamic_layers_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/anchor_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/avatar_layout"
            android:layout_width="@dimen/ttlive_audio_live_anchor_container_height"
            android:layout_height="@dimen/ttlive_audio_live_anchor_container_height"
            android:layout_marginTop="@dimen/ttlive_audio_live_anchor_container_margin_top_normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/radio_avatar"
                android:background="@drawable/ttlive_bg_default_anchor_avatar"
                android:visibility="invisible"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/radio_effect_new"
                app:layout_constraintEnd_toEndOf="@+id/radio_effect_new"
                app:layout_constraintStart_toStartOf="@+id/radio_effect_new"
                app:layout_constraintTop_toTopOf="@+id/radio_effect_new"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/radio_effect_new"
                android:visibility="invisible"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.liveinteract.view.RadioTextBoardView
        android:id="@+id/radio_text_container"
        android:background="@drawable/ttlive_radio_text_container_background"
        android:visibility="gone"
        android:layout_width="295dp"
        android:layout_height="209dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor_info_container"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/radio_dynamic_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/multi_link_dynamic_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/dynamic_layers_front"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
