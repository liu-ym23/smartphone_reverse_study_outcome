<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="112dp"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bottom_right_banner_container_tetris"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginRight="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_marginBottom="@dimen/ttlive_top_left_banner_padding_bottom_follow_move_down_style_v2"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginEnd="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.livesdk.widget.VisibilityFrameLayout
        android:id="@+id/activity_interactive_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginRight="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_marginBottom="@dimen/ttlive_ktv_room_card_padding_bottom"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginEnd="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.livesdk.widget.VisibilityFrameLayout
        android:id="@+id/episode_interactive_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginRight="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_marginBottom="@dimen/ttlive_ktv_room_card_padding_bottom"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginEnd="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.livesdk.widget.VisibilityFrameLayout
        android:id="@+id/welfare_card_widget_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginRight="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_marginBottom="52dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_top_left_banner_padding_left"
        android:layout_marginEnd="@dimen/ttlive_top_left_banner_padding_right"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/small_illegal_dialog_layout"
        android:background="@drawable/ttlive_bg_small_illegal_dialog_layout"
        android:paddingLeft="8dp"
        android:paddingTop="14dp"
        android:paddingRight="8dp"
        android:paddingBottom="14dp"
        android:visibility="invisible"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="52dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_illegal_review_title_normal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/small_illegal_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_illegal_review_text_normal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/small_illegal_dialog_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
    </LinearLayout>
</RelativeLayout>
