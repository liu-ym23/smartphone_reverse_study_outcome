<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_ec_common_result_error"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="6dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_ec_common_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/search_ec_common_error_top_bg"
            android:layout_width="match_parent"
            android:layout_height="110dp"/>
        <View
            android:id="@+id/search_ec_common_error_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_ec_common_result_error_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28">
        <com.bytedance.dux.image.DuxImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_result_error_img"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/search_ec_common_error_img_light"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/search_color_161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_result_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ec_search_network_error_title"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14sp"
            android:textColor="@color/search_color_99161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_result_error_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ec_search_network_error_des"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/search_color_161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_ec_common_result_refresh"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/ec_search_refresh"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
