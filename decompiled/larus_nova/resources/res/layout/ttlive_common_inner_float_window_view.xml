<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/float_edge"
        android:background="@drawable/ttlive_inner_float_window_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0.5dp"
        app:ttlive_allRadius="8dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/float_stream_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/float_cover_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:id="@+id/float_cover_mask"
                android:background="#57000000"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/float_feed_view_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/float_end_view_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/float_end_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_common_inner_float_window_end_tip"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:id="@+id/float_end_count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/float_end_tip"
                android:layout_centerHorizontal="true"
                android:alpha="0.7"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/float_close_container"
            android:background="@drawable/ttlive_inner_float_window_close_bg_rect"
            android:layout_width="22dp"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp">
            <View
                android:background="@drawable/ttlive_inner_float_window_btn_close"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
        </RelativeLayout>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/lottery_wait_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/ttlive_lottery_inner_float_window_wait_tip"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/lottery_draw_tip"
            android:background="#80ff2559"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ttlive_lottery_inner_float_window_draw_tip"/>
        </RelativeLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
</FrameLayout>
