<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ec_store_info_area_second_item"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_weight="1">
    <FrameLayout
        android:id="@+id/item_value_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.shopping.store.home.view.ECShopMarqueeTextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:id="@+id/item_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:ec_scroll_mode="once"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center"
            android:id="@+id/item_value_icon"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            app:layoutMode="width_self_adjust"
            app:placeholderImage="@color/transparent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_desc_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <com.bytedance.android.shopping.store.home.view.ECShopMarqueeTextView
            android:textSize="12dp"
            android:id="@+id/item_desc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="63dp"
            android:singleLine="true"
            app:ec_scroll_mode="once"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center"
            android:id="@+id/item_desc_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginStart="3dp"
            app:layoutMode="width_self_adjust"
            app:placeholderImage="@color/transparent"/>
    </LinearLayout>
</LinearLayout>
