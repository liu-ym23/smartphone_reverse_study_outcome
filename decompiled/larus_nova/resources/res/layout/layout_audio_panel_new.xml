<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_audio_and_text_new"
    android:background="@color/bg_body_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/audio_circle_bg"
        android:background="@color/bg_body_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/audio_bg_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.widget.AudioCircleView
        android:id="@+id/audio_circle_btn"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:translationY="-12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_2_text_option"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@drawable/bg_asr_text_color"
        android:gravity="center"
        android:id="@+id/audio_2_text_option"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="5dp"
        android:layout_centerHorizontal="true"
        android:drawableEnd="@drawable/ic_text_option_icon_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/audio_bg_divider"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@drawable/bg_asr_text_color"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_cancel"
        android:visibility="gone"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:text="@string/Lark_IM_AudioToTextSelectLangugage_Cancel_Button"
        android:drawableTop="@drawable/ic_undo_outlined_selector"
        android:drawablePadding="8dp"
        android:layout_marginStart="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@drawable/bg_asr_send_all_btn_color"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_send"
        android:visibility="gone"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_Legacy_Send"
        android:drawableTop="@drawable/ic_send_all_selector"
        android:drawablePadding="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="38dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
