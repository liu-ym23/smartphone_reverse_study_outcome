<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.ui.AlwaysConsumeEventFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_inner_push_for_saas"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_margin="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/push_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="18dp"
            android:maxLines="1"
            app:layout_constraintLeft_toRightOf="@+id/push_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginLeft="16dp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14dp"
            android:textColor="#161823"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15dp"
            android:textColor="#fe2c55"
            android:id="@+id/tv_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:background="@drawable/ttlive_bg_inner_push_bar_for_saas"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.chatroom.ui.AlwaysConsumeEventFrameLayout>
