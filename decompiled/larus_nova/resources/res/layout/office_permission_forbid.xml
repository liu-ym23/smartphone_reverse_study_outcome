<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/permission_root_layout"
    android:background="@color/bg_body"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/permission_title_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <View
        android:id="@+id/permission_title_bar_tips_extra"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="128dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/forbid_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/no_data_empty_state"
            android:layout_width="332dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.28"
            app:ud_empty_imageRes="@drawable/office_permission_lock"
            app:ud_empty_imageSize="40dp"
            app:ud_empty_title="@string/Doc_Permission_AdminNotAuthorizeCross"
            style="@style/SpaceEmptyStatusStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
