<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginBottom="3dp"
    android:layout_marginEnd="4dp">
    <com.bytedance.ee.bear.bitable.card.view.cell.attachment.view.PageAttachmentCoverView
        android:id="@+id/attachment_cover_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/highlight_border"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:border_color="@color/primary_fill_default"
        app:border_width="@dimen/space_kit_len_half"
        app:radius="@dimen/space_kit_len_4"/>
</FrameLayout>
