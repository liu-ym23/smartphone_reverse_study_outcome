<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="146dp"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="@dimen/ud_radius_l"
    style="@style/UDShadow.S2.Down">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_message_full_screen_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/copy_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/ud_icon_copy_outlined"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="13dp"
                android:text="@string/Lark_Legacy_Copy"/>
        </LinearLayout>
    </LinearLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
