<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg_border"
        android:background="@drawable/ttlive_bg_broadcast_more_action"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_prelive_setting_dark_txt"
        android:gravity="center_vertical"
        android:id="@+id/audio_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="51dp"
        android:text="@string/ttlive_broadcast_toolbar_audio_comment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0.06"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_dialog_title"/>
    <FrameLayout
        android:id="@+id/audio_can_send_area"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_dark_txt"
            android:layout_gravity="center_vertical"
            android:id="@+id/can_send_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_audio_comment_can_send"
            android:includeFontPadding="false"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/can_send_audio_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_audio_comment_broadcast_switch_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/audio_auto_play_area"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_can_send_area">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_dark_txt"
            android:layout_gravity="center_vertical"
            android:id="@+id/broadcast_audio_auto_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_audio_comment_auto_play"
            android:includeFontPadding="false"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/broadcast_audio_auto_play_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_audio_comment_broadcast_switch_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
