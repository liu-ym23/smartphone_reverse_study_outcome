<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_password_input_error_tip_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_red_fe3824"
            android:id="@+id/cj_pay_password_input_error_tip_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_blue"
            android:id="@+id/cj_pay_password_input_error_tip_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_pwd_input_error_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:src="@drawable/cj_pay_icon_right_arrow_blue"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:id="@+id/cj_pay_password_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"/>
</FrameLayout>
