<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/user_info_container"
        android:paddingBottom="-2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/close_in_top_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_close_in_top_container_shadow"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ttlive_a11y_close"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/top_right_widget_container"
        android:paddingBottom="-2dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_toLeftOf="@+id/close_in_top_container"
        android:layout_toRightOf="@+id/user_info_container"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@+id/close_in_top_container"
        android:layout_toEndOf="@+id/user_info_container"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_toLeftOf="@+id/close_in_top_container"
        android:layout_toRightOf="@+id/user_info_container"
        android:layout_toStartOf="@+id/close_in_top_container"
        android:layout_toEndOf="@+id/user_info_container">
        <FrameLayout
            android:id="@+id/top_right_watch_user_container_v1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-2dp"
            android:layout_marginStart="-2dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/accessibility_dig_container"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_toRightOf="@+id/user_info_container"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/user_info_container"/>
</RelativeLayout>
