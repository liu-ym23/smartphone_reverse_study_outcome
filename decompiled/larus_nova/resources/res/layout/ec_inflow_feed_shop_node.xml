<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/shop_node_logo_dv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:borderColor="#0c161823"
        app:borderWidth="0.5dp"
        app:cornerRadius="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.feed.view.ShopTitleView
        android:id="@+id/shop_title_view"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/shop_node_logo_dv"
        app:layout_constraintRight_toLeftOf="@+id/shop_node_button_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/shop_node_bottom_container"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/shop_node_logo_dv"
        app:layout_constraintRight_toLeftOf="@+id/shop_node_button_container"
        app:layout_constraintTop_toBottomOf="@+id/shop_title_view">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/living_icon_dv"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginRight="4dp"
            app:autoPlayAnimation="true"
            app:layoutMode="width_self_adjust"/>
        <ImageView
            android:id="@+id/ec_living_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_living_icon"
            android:includeFontPadding="false"/>
        <View
            android:id="@+id/live_divider_view"
            android:background="@drawable/commerce_shop_node_divider"
            android:layout_width="1dp"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/commerce_color_80161823"
            android:ellipsize="end"
            android:id="@+id/extra_info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_node_button_container"
        android:background="@drawable/ec_commerce_shop_node_btn_bg"
        android:layout_width="80dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/commerce_color_161823"
            android:id="@+id/shop_node_button_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_inner_flow_enter_shop"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/button_node_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/button_node_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/ec_shop_card_enter_shop_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/shop_node_button_tv"
            app:layout_constraintLeft_toRightOf="@+id/shop_node_button_tv"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/shop_node_button_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
