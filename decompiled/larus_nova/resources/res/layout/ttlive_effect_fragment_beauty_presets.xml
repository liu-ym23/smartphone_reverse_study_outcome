<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/reset_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="13dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/save_preset_view"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/reset_icon"
            android:background="@drawable/ttlive_effect_ic_beauty_item_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_effect_broadcast_beauty_item_reset_color"
            android:id="@+id/reset_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_effect_live_beauty_small_reset"
            android:importantForAccessibility="no"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_preset_view"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="69dp"
        android:layout_height="81dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_save_preset"
            android:layout_width="52dp"
            android:layout_height="74dp"
            android:layout_marginTop="7dp"
            android:src="@drawable/ttlive_effect_ic_save_preset_enable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line"
            android:background="@drawable/ttlive_effect_bg_line"
            android:layout_width="0.5dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/iv_save_preset"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#80ffffff"
        android:gravity="center_vertical"
        android:id="@+id/tv_preset_reminder"
        android:visibility="gone"
        android:layout_width="242dp"
        android:layout_height="74dp"
        android:layout_marginBottom="24dp"
        android:text="@string/ttlive_effect_live_beauty_presets_remind"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/save_preset_view"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/presets_recycle_view"
        android:layout_width="0dp"
        android:layout_height="81dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/save_preset_view"/>
    <View
        android:id="@+id/toast_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/presets_recycle_view"
        app:layout_constraintEnd_toEndOf="@+id/presets_recycle_view"
        app:layout_constraintStart_toStartOf="@+id/presets_recycle_view"
        app:layout_constraintTop_toTopOf="@+id/presets_recycle_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
