<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/allow_anchor_see_history_about_me"
    android:paddingLeft="16dp"
    android:paddingBottom="16dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <TextView
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:id="@+id/allow_anchor_see_history_about_me_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="85dp"
        android:text="@string/ttlive_anchor_see_history_about_me_title"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/allow_anchor_see_history_about_me_switch"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="#67dca0"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#d9ffffff"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:id="@+id/allow_anchor_see_history_about_me_desc"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="85dp"
        android:text="@string/ttlive_anchor_see_history_about_me_desc"
        android:layout_below="@+id/allow_anchor_see_history_about_me_title"
        android:contentDescription="@string/ttlive_anchor_see_history_about_me_desc"
        android:importantForAccessibility="yes"/>
</RelativeLayout>
