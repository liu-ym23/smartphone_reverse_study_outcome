<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/loadingContainer"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.ui.loading.LKUILoadingView
        android:id="@+id/lkui_loading_view"
        android:layout_width="120dp"
        android:layout_height="120dp"/>
    <TextView
        android:textAppearance="@style/UDText.Title3"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/loadingTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Lark_Conditions_NewVerAccessStrategy_CheckDeviceInfo_EmptyTitle"
        android:layout_marginStart="62dp"
        android:layout_marginEnd="62dp"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:id="@+id/loadingMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/Lark_Conditions_Ongoing"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
