<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/video_background"
        android:background="@drawable/ttlive_bg_live_record_preview_video"
        android:layout_width="108dp"
        android:layout_height="192dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <SurfaceView
        android:layout_gravity="start|top"
        android:id="@+id/video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/video_background"
        app:layout_constraintEnd_toEndOf="@+id/video_background"
        app:layout_constraintStart_toStartOf="@+id/video_background"
        app:layout_constraintTop_toTopOf="@+id/video_background"/>
    <ImageView
        android:id="@+id/first_frame"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/video"
        app:layout_constraintLeft_toLeftOf="@+id/video"
        app:layout_constraintRight_toRightOf="@+id/video"
        app:layout_constraintTop_toTopOf="@+id/video"/>
    <View
        android:id="@+id/video_player_btn"
        android:background="@drawable/ttlive_ic_record_preview_player_btn"
        android:layout_width="35dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/video"
        app:layout_constraintEnd_toEndOf="@+id/video"
        app:layout_constraintStart_toStartOf="@+id/video"
        app:layout_constraintTop_toTopOf="@+id/video"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/video_time_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:shadowColor="#33000000"
            android:shadowRadius="1"/>
        <SeekBar
            android:id="@+id/seek_bar"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginBottom="4dp"
            android:maxHeight="1dp"
            android:max="100"
            android:thumb="@drawable/ttlive_bg_admin_record_progress_anchor"
            android:thumbOffset="0dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:progressTint="#fe2c55"
            android:progressBackgroundTint="#88ffffff"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/full_play_video_btn"
        android:paddingTop="14dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ttlive_full_play_video_expand_btn"
        android:paddingStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
