<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/container_background"
        android:background="#a3000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/container_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide_img_hsimage"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="160dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide_img_lottie"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="160dp"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
            android:textSize="18dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_slide_right_to_switch_full_screen"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
