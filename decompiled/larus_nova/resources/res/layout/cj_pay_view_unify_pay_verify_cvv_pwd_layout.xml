<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_root_container"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_pay_layout_pwd_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_20"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_view_num_keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_12"
            android:layout_marginBottom="@dimen/cj_pay_padding_108">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textColor="@color/cj_pay_color_gray_light"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_cvv_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_cvv_input_tips"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cj_pay_cvv_info_icon"
                android:clickable="true"
                android:layout_width="@dimen/cj_pay_height_12"
                android:layout_height="@dimen/cj_pay_height_12"
                android:src="@drawable/cj_pay_info_icon"
                android:layout_marginStart="@dimen/cj_pay_padding_2"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.preverify.utils.CJPayCursorTextView
            android:textSize="@dimen/cj_pay_font_size_24"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/cj_pay_cvv_edit_view"
            android:background="@drawable/cj_pay_bg_cvv_text_corner"
            android:layout_width="@dimen/cj_pay_height_180"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginBottom="@dimen/cj_pay_padding_60"
            android:fontFamily="bold"
            android:textAlignment="center"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/cj_pay_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            app:btnText="@string/cj_pay_cvv_verify_confirm"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="?attr/cj_pay_page_size_15"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.component.keyboard.CJNumKeyboardView
        android:id="@+id/cj_pay_view_num_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:CJNumKeyboardStyle="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
