<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/live_carouse_bg"
        android:background="@drawable/ec_bg_live_small_window"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.livecommerce.room.smallwindow.view.carouseview.CarouselView
        android:layout_gravity="bottom"
        android:id="@+id/live_carouse_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"/>
</FrameLayout>
