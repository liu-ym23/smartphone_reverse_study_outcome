<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_body">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/wiki_apply_move_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_50"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/LarkCCM_CM_RequestToMoveDoc_Title"
        app:widget_widgets_tb_title_color="@color/text_title"/>
    <com.bytedance.ee.bear.bizwidget.at.AtUserSupportTextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_title"
        android:id="@+id/wiki_apply_move_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:text="@string/CreationMobile_Wiki_MoveToSpace_AskOwner_Desc"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"/>
    <FrameLayout
        android:background="@drawable/facade_round_around_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_body_overlay">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:gravity="top"
            android:id="@+id/apply_move_input"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:minHeight="@dimen/space_kit_len_75"
            android:hint="@string/LarkCCM_Wiki_Move_ReqPermission_Context"
            android:maxEms="1000"
            android:layout_marginStart="@dimen/space_kit_len_12"
            android:layout_marginEnd="@dimen/space_kit_len_12"
            style="@style/UDEditText"/>
    </FrameLayout>
    <Button
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/wiki_apply_move_send"
        android:layout_height="@dimen/space_kit_len_44"
        android:layout_marginBottom="@dimen/space_kit_len_42"
        android:text="@string/Doc_Facade_ApplyFor"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/SpaceKitBtn1Level1"/>
</LinearLayout>
