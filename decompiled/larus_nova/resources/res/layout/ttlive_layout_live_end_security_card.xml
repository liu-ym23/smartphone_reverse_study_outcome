<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/security_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_hs_s5_50"
        android:id="@+id/security_card_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/security_card_title"/>
    <com.bytedance.android.livesdk.chatroom.backtrack.LiveVideoPreviewView
        android:id="@+id/security_card_video_player"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/security_card_sub_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/security_card_notice_tip"
        android:background="@drawable/ttlive_security_card_white_bg_radius_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/security_card_video_player">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_hs_sys3"
            android:ellipsize="end"
            android:id="@+id/security_card_notice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <View
            android:gravity="center"
            android:id="@+id/security_card_notice_arrow"
            android:background="@drawable/ttlive_security_card_arrrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/security_card_notice_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/security_card_sub_title">
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/ttlive_gradient_security_card_notice_mask"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/security_card_notice_see_more_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/security_card_notice_see_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看详情"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <View
                android:gravity="center"
                android:id="@+id/security_card_notice_see_more_arrow"
                android:background="@drawable/ttlive_security_card_arrrow"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
