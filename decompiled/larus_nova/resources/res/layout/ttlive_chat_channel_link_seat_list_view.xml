<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seat_list_container"
    android:layout_width="wrap_content"
    android:layout_height="34dp">
    <View
        android:id="@+id/bg_view"
        android:background="@drawable/ttlive_bg_room_channel_link_seat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content_view"
        app:layout_constraintEnd_toEndOf="@+id/content_view"
        app:layout_constraintStart_toStartOf="@+id/content_view"
        app:layout_constraintTop_toTopOf="@+id/content_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/channel_anchor_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ttlive_ic_withdraw_default_avatar"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/channel_anchor_mic_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ttlive_room_channel_link_seat_mic_bg"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/channel_anchor_view"
                app:layout_constraintEnd_toEndOf="@+id/channel_anchor_view"
                app:layout_constraintStart_toStartOf="@+id/channel_anchor_view">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/channel_anchor_mic_status_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_room_channel_seat_mic_status_open"/>
                <ProgressBar
                    android:id="@+id/channel_anchor_link_volume_view"
                    android:visibility="gone"
                    android:layout_width="3.5dp"
                    android:layout_height="5.5dp"
                    android:layout_marginTop="1.5dp"
                    android:progress="100"
                    android:layout_marginEnd="0.5dp"
                    app:layout_constraintEnd_toEndOf="@+id/channel_anchor_mic_status_iv"
                    app:layout_constraintStart_toStartOf="@+id/channel_anchor_mic_status_iv"
                    app:layout_constraintTop_toTopOf="@+id/channel_anchor_mic_status_iv"
                    style="@style/ttlive_room_link_progress_bar_style_ver"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/guide_line"
            android:background="#30ffffff"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/link_seat_rv"
            android:fadingEdgeLength="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:requiresFadingEdge="horizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/apply_user_container"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelRingView
                android:id="@+id/apply_user_anim_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ring_color="#161823"
                app:ring_width="2dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/apply_user_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ttlive_ic_withdraw_default_avatar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/total_count_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#e5ffffff"
                android:id="@+id/total_count_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ttlive_room_channel_link_seat_arrow"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
