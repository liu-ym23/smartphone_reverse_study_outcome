<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_agreement_detail_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <RelativeLayout
        android:id="@+id/cj_pay_agreement_webview_layout"
        android:background="@color/cj_pay_color_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/cj_pay_padding_72"
        android:layout_below="@+id/cj_pay_titlebar_root_view">
        <WebView
            android:id="@+id/cj_pay_agreement_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <include
            android:id="@+id/cj_pay_security_panel_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_discount_layout"
            layout="@layout/cj_pay_view_security_panel_loading_container"/>
        <include layout="@layout/cj_pay_view_h5_error_layout"/>
    </RelativeLayout>
    <FrameLayout
        android:background="@color/cj_pay_color_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="@dimen/cj_pay_font_size_15"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_agreement_detail_next_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_12"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_12"
            android:text="@string/cj_pay_agree_and_continue"/>
    </FrameLayout>
</RelativeLayout>
