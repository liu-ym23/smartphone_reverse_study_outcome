<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/text_empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/ttlive_effect_live_scrollbar_vertical_thumb"
        android:id="@+id/content_container"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/loading_status_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
