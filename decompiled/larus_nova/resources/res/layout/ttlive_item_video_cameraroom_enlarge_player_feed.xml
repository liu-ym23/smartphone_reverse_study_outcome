<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/guest_bg"
            android:background="@drawable/ttlive_video_talkroom_window_empty_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="#57000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/guest_info_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/guest_container"
                android:visibility="invisible"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:layout_constraintBottom_toBottomOf="@+id/guest_info_container"
                app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
                app:layout_constraintRight_toRightOf="@+id/guest_info_container"
                app:layout_constraintTop_toTopOf="@+id/guest_info_container"
                app:layout_constraintVertical_bias="0.33">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/guest_avatar"
                    android:background="@drawable/ttlive_build_linking_avatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/ktv_effect"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.bytedance.android.livesdk.common.AnchorPauseTipsView
                    android:layout_gravity="center"
                    android:id="@+id/leave_view"
                    android:visibility="gone"
                    android:layout_width="120dp"
                    android:layout_height="120dp"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/radio_effect"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/surface_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/enlarge_user_info_bg"
                android:background="@drawable/ttlive_bg_enlarge_user_info"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/enlarge_user_info_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/silence_video"
                    android:visibility="invisible"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/ttlive_icon_video_silence"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#e6ffffff"
                    android:ellipsize="end"
                    android:id="@+id/guest_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:maxEms="8"
                    android:singleLine="true"
                    android:layout_marginStart="4dp"/>
                <com.bytedance.android.live.ui.LinkGuestSendGiftView
                    android:id="@+id/send_gift_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/ktv_singing_label"
                    android:background="@drawable/ttlive_video_ktv_singing_tv_bg"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="@string/ttlive_live_ktv_seat_label_sing"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/guest_seat_animation"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/themed_competition_seat_animation"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.livesdk.chatroom.ui.DynamicEmojiView
                android:id="@+id/dynamic_emoji_view"
                android:visibility="visible"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="start|top"
        android:id="@+id/guest_battle_seat_big_effect"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="-15dp"
        android:layout_marginStart="-10dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:layout_gravity="start|top"
        android:id="@+id/paid_time_count_down_bar"
        android:background="@drawable/ttlive_video_talk_paid_count_down_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"/>
</FrameLayout>
