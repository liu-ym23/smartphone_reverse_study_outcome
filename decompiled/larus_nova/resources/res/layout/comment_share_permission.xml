<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/UDShadow.S4.Up">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/facade_round_top_xxl"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:backgroundTint="@color/bg_body">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:src="@drawable/ud_icon_info_colorful"
            android:layout_marginStart="@dimen/dp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="是否将文档分享给：XXX"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_icon"
            app:layout_constraintRight_toLeftOf="@+id/tv_confirm"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/primary_fill_default"
            android:id="@+id/tv_confirm"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/CreationMobile_mention_sharing_yes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout>
