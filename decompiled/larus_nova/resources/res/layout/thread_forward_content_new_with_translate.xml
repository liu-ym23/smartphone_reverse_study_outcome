<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.chatbase.view.ThreadForwardCardView
        android:id="@+id/thread_forward_card_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/thread_forward_translate_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ViewStub
        android:id="@+id/thread_forward_translate_content"
        android:layout="@layout/thread_forward_translate_content"
        android:inflatedId="@+id/thread_forward_translate_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thread_forward_card_view"/>
    <View
        android:id="@+id/thread_forward_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/thread_forward_translate_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:id="@+id/translation_feedback_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/Lark_Chat_TranslationFeedbackRateButton"
        android:includeFontPadding="false"
        android:drawablePadding="4.17dp"
        android:drawableEnd="@drawable/ic_svg_pointer2"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toStartOf="@+id/translate_more_action"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thread_forward_mask"
        app:layout_goneMarginEnd="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/translate_more_action"
        android:padding="@dimen/dp_4"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/translation_feedback_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="@+id/translation_feedback_tv"
        app:layout_goneMarginTop="24dp"
        app:srcCompat="@drawable/ud_icon_more_outlined"
        app:tint="@color/icon_n2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
