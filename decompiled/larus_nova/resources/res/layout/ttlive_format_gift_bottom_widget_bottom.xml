<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bottom_bg_view"
        android:background="@color/ttlive_new_gift_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_bottom_height"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tab_list"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="@dimen/ttlive_gift_bottom_bar_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/charge_layout"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/start_board"
        android:background="@drawable/ttlive_base_gift_bottom_board2"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_marginBottom="@dimen/ttlive_gift_bottom_bar_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/end_board"
        android:background="@drawable/ttlive_base_gift_bottom_board"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="@dimen/ttlive_gift_bottom_bar_margin_bottom"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/charge_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/charge_layout"
        android:background="@drawable/ttlive_format_gift_bottom_charge_board"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/dummy_left"
            android:layout_width="7dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/coin_icon"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dummy_left"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/recharge_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coin_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/recharge_arrow"
            android:background="@drawable/ttlive_gift_bottom_recharge_arrow"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="14dp"
            android:layout_marginRight="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/close_button"
        android:background="@drawable/ttlive_format_close_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
