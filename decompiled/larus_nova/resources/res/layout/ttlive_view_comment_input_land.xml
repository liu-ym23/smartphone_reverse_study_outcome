<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/comment_input_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginBottom="8dp"
    android:layout_weight="1"
    android:layout_marginStart="12dp">
    <RelativeLayout
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@+id/edit_btn_audience_container"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minWidth="180dp">
        <RelativeLayout
            android:id="@+id/fl_danmaku_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_danmaku_switch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <FrameLayout
                android:id="@+id/setting_container"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toRightOf="@+id/iv_danmaku_switch">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_danmaku_setting"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ttlive_ic_landscape_danmaku_setting"/>
                <com.bytedance.android.livesdk.chatroom.ui.RedDotView
                    android:layout_gravity="top|right"
                    android:id="@+id/red_dot_danmu_setting"
                    android:background="@drawable/ttlive_ic_red_point_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </RelativeLayout>
        <View
            android:id="@+id/divider"
            android:background="@drawable/ttlive_comment_input_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="10dp"
            android:layout_toRightOf="@+id/fl_danmaku_container"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/fl_danmaku_container"/>
        <RelativeLayout
            android:id="@+id/comment_interact_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/divider"
            android:layout_toEndOf="@+id/divider">
            <com.bytedance.android.live.core.widget.LiveTextView
                android:textSize="12dp"
                android:textColor="#b3ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/edit_btn_audience"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_comment_input_widget_hint"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@+id/voice_emoji_container"/>
            <LinearLayout
                android:id="@+id/voice_emoji_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/emoji_entry"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_comment_emoji_entry"
                    app:actualImageResource="@drawable/ttlive_comment_emoji_entry"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/edit_btn_anchor"
        android:background="@drawable/ttlive_bg_edit_circle_selector"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/ttlive_small_edit_btn"
        android:background="@drawable/ttlive_selector_action_btn_chat"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
</FrameLayout>
