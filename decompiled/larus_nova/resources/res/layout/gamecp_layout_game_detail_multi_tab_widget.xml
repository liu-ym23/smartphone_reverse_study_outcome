<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/layout_game_detail_common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.gamecp.common.ui.RoundRectLayout
            android:id="@+id/game_detail_round_bg"
            android:background="#f8f8f8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftTopRound="12dp"
            app:rightTopRound="12dp">
            <View
                android:id="@+id/v_game_detail_round_bg"
                android:background="@drawable/gamecp_game_detail_header_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.gamecp.common.ui.RoundRectLayout>
        <View
            android:id="@+id/game_detail_square_bg"
            android:background="#f8f8f8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="136dp"/>
    </FrameLayout>
    <com.bytedance.android.gamecp.business.gamedetail.view.NestedParentRecyclerView
        android:id="@+id/rv_game_detail_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <FrameLayout
        android:id="@+id/rl_game_detail_video_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ttlive_game_detail_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/gamecp_status_bar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
