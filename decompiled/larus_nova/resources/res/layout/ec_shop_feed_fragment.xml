<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_shop_feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shop_feed_shop_list_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/shop_feed_status_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/shop_feed_guide_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="top|left"
        android:id="@+id/shop_feed_back_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/shopping_ic_store_v2_back_black"/>
    <TextView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/shop_feed_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/shop_feed_search_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="53dp"
        android:layout_marginRight="42dp"
        android:src="@drawable/ec_shop_ic_search"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/shop_feed_share_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="53dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ec_shop_ic_share"/>
    <FrameLayout
        android:id="@+id/shop_top_info_slice_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
