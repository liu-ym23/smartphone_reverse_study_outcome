<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/poi_groupon_puchase_dialog_close_desc">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/goods_shelves_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="top"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="82dp">
                <View
                    android:id="@+id/goods_shelves_brand_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <FrameLayout
                    android:id="@+id/goods_shelves_brand_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.bytedance.locallife.live.view.RadiusFrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/goods_shelves_container"
                android:background="@drawable/poi_bg_goods_shelves_round"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="70dp"/>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_anchor_first"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="73dp"
        android:src="@drawable/live_local_life_anchor_first"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"/>
</FrameLayout>
