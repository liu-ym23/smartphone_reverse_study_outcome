<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="328dp">
    <FrameLayout
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="22dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="8dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_video_friend_pair_dialog_back_icon"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_pair_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_interact_vote_start_dialog_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_line"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_pair_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/tv_theme_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_interact_vote_start_dialog_theme_title"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:id="@+id/tv_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_interact_vote_start_dialog_theme"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_select_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_title">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_interact_vote_start_dialog_select_color"
            android:id="@+id/tv_select_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_vote_start_dialog_select_theme"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_interact_vote_select_theme_icon"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_interact_vote_start_dialog_duration_title"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_select_duration"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_duration">
        <TextView
            android:textSize="13dp"
            android:textColor="#99161823"
            android:gravity="center"
            android:id="@+id/tv_duration_300"
            android:background="@drawable/ttlive_vote_start_dialog_duration_unselect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/ttlive_interact_vote_start_dialog_duration_300"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#99161823"
            android:gravity="center"
            android:id="@+id/tv_duration_600"
            android:background="@drawable/ttlive_vote_start_dialog_duration_unselect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_interact_vote_start_dialog_duration_600"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#99161823"
            android:gravity="center"
            android:id="@+id/tv_duration_900"
            android:background="@drawable/ttlive_vote_start_dialog_duration_unselect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_interact_vote_start_dialog_duration_900"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_vote_setting_dialog_save_color"
        android:gravity="center"
        android:id="@+id/tv_save_vote"
        android:background="@drawable/ttlive_bg_vote_setting_dialog_save_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="33dp"
        android:text="@string/ttlive_interact_vote_start_dialog_save"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_start_vote"
        app:layout_constraintTop_toBottomOf="@+id/ll_select_duration"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_start_vote"
        android:background="@drawable/ttlive_bg_anchor_link_invite_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="33dp"
        android:text="@string/ttlive_interact_vote_start_dialog_open"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_save_vote"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_select_duration"/>
</androidx.constraintlayout.widget.ConstraintLayout>
