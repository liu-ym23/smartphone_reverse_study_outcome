<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_effect_bg_sticker_preview_panel"
    android:layout_width="120dp"
    android:layout_height="wrap_content">
    <Button
        android:textSize="12dp"
        android:textColor="#ffffffff"
        android:id="@+id/effect_preview_button"
        android:background="@drawable/ttlive_effect_bg_sticker_preview_button"
        android:layout_width="109dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:text="应用"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <SurfaceView
        android:id="@+id/effect_preview_surfaceView"
        android:layout_width="110dp"
        android:layout_height="196dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/effect_preview_downgrade_img"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="4dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
