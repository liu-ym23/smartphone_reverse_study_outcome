<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_20"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/diary_calendar_month_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_16"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/diary_calendar_month_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"/>
</LinearLayout>
