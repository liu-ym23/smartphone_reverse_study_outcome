<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ud_timepicker_action_panel_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textColor="@color/text_title"
            android:layout_gravity="start"
            android:id="@+id/leftActionView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <TextView
            android:textAppearance="@style/UDText.Body0"
            android:textColor="@color/primary_content_default"
            android:layout_gravity="end"
            android:id="@+id/rightActionView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.larksuite.component.universe_design.timepicker.UDTimePicker
        android:id="@+id/timePicker"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ud_timePicker_datePickerMode="monthDayHourMinute_24h"
        app:ud_timePicker_itemVisibleNum="5"/>
</LinearLayout>
