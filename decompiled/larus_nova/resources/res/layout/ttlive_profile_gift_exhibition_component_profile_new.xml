<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gift_exhibition_root"
    android:background="@drawable/ttlive_bg_gift_exhibition_profile_new"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="6dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_bg_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_gift_exhibition_title_new"
        android:id="@+id/gift_exhibition_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_all_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_title"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_exhibition_icon_anim_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_title"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_title"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_title"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_gift_exhibition_bottom_new"
        android:id="@+id/new_gift_exhibition_lit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ttlive_gift_exhibition_lit_new"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_gift_exhibition_bottom_new"
        android:id="@+id/gift_exhibition_lighted_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/new_gift_exhibition_lit"
        app:layout_constraintLeft_toRightOf="@+id/new_gift_exhibition_lit"
        app:layout_constraintTop_toTopOf="@+id/new_gift_exhibition_lit"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_gift_exhibition_bottom_new"
        android:id="@+id/gift_exhibition_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_lighted_count"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_lighted_count"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_lighted_count"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_gift_exhibition_bottom_new"
        android:id="@+id/gift_exhibition_total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/gift_exhibition_lighted_count"
        app:layout_constraintLeft_toRightOf="@+id/gift_exhibition_divider"
        app:layout_constraintTop_toTopOf="@+id/gift_exhibition_lighted_count"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/gift_exhibition_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/gift_exhibition_icon_over_anim_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
