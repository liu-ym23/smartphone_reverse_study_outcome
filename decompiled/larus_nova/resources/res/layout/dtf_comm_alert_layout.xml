<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ocr_take_photo_require_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/comm_background_shadow"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_container"
        android:background="@drawable/dtf_alert_round_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp">
        <TextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="@color/dtf_dialog_title_color"
            android:gravity="center_horizontal"
            android:id="@+id/comm_alert_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="确定退出吗？"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/dtf_dialog_msg_color"
            android:gravity="center_horizontal"
            android:id="@+id/comm_alert_message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="露个脸就能通过"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <View
            android:background="#f6f6f6"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comm_alert_button_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp">
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/dtf_dialog_cancel_color"
                    android:gravity="center"
                    android:id="@+id/comm_alert_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="取消"
                    android:layout_weight="1"/>
                <View
                    android:background="#f6f6f6"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/dtf_dialog_confirm_color"
                    android:gravity="center"
                    android:id="@+id/comm_alert_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="确定"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comm_alert_button_1"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp">
                <TextView
                    android:textSize="22dp"
                    android:textColor="#0e83e6"
                    android:gravity="center"
                    android:id="@+id/comm_alert_confirm1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="重试"
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
