<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bitable_header_catalog_container"
    android:paddingLeft="10dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bitable_header_catalog"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="36dp"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/bitable_header_catalog_more_wrapper"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bitable_header_catalog_more"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/icon_n2"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_menu_outlined"/>
    </RelativeLayout>
</FrameLayout>
