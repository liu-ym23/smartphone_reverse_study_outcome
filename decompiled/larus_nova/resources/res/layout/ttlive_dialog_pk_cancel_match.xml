<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_white_round_corner_rect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_pk_cancel_invite_title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <ImageView
        android:id="@+id/ttlive_close_icon"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ttlive_pk_end_dialog_close"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/ttlive_end"
            android:background="@drawable/ttlive_bg_pk_end_v2"
            android:layout_width="164dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:text="@string/ttlive_pk_cancel_invite"
            android:height="44dp"
            android:layout_weight="1"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/ttlive_cancel"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:layout_width="164dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_pk_wait_v2"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
