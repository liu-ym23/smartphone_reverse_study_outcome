<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_inner_auth_dialog_title"
        style="@style/uicomponent_common_alert_dialog_title_tv"/>
    <RelativeLayout
        android:id="@+id/content_area"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="start"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            style="@style/uicomponent_common_alert_dialog_content_tv"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_white"
            android:id="@+id/select_hint"
            android:background="@drawable/ttlive_above_elem_hint_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_privacy_check_hint_text"
            android:layout_above="@+id/ll_protocol_container"
            android:layout_marginStart="-17dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_protocol_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/content">
            <CheckBox
                android:id="@+id/protocol_check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/uicomponent_common_alert_dialog_content_margin_top"
                style="@style/ttlive_RedEnvelopeCheckboxStyle"/>
            <TextView
                android:gravity="start"
                android:id="@+id/link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/uicomponent_common_alert_dialog_content_tv"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/use_dy_auth_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textColor="@color/ttlive_std_link_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_inner_auth_dialog_use_dy_auth"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ttlive_vector_drawable_list_more_onlight"/>
    </LinearLayout>
</LinearLayout>
