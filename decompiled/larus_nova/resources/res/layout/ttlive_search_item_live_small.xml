<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="164dp"
    android:layout_height="200dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:placeholderImage="@drawable/ttlive_search_cover_loading"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="2dp"/>
    <View
        android:background="@drawable/ttlive_search_bg_live_feed_small"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignLeft="@+id/live_cover"
        android:layout_alignRight="@+id/live_cover"
        android:layout_alignBottom="@+id/live_cover"
        android:layout_alignStart="@+id/live_cover"
        android:layout_alignEnd="@+id/live_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_room_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        app:roundBottomLeft="false"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="false"
        app:roundedCornerRadius="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/ttlive_search_bg_double_column_live_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:layout_alignTop="@+id/live_cover"
        android:layout_alignRight="@+id/live_cover"
        android:layout_marginEnd="4dp"
        android:layout_alignEnd="@+id/live_cover">
        <ImageView
            android:id="@+id/live_type"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ttlive_icon_camera_item"
            android:layout_marginStart="3dp"/>
        <View
            android:id="@+id/live_state_ic"
            android:background="@drawable/ttlive_ic_search_live_state"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_hs_s5"
            android:gravity="center"
            android:id="@+id/live_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="@string/ttlive_search_feed_on_live"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.widget.LiveCoverOptView
        android:id="@+id/live_cover_opt_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_locate"
            android:layout_width="54dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="4dp"
            android:scaleType="fitXY"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_search_white"
            android:gravity="center_vertical"
            android:id="@+id/locate"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_search_feed_mars"
            android:singleLine="true"
            android:layout_marginStart="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="6dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_search_white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="78dp"
                android:layout_height="20dp"
                android:singleLine="true"/>
            <View
                android:id="@+id/weight_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ttlive_ic_people"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <com.bytedance.android.live.core.widget.CustomFontTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_search_hs_s5_50"
                android:gravity="center_vertical"
                android:id="@+id/audience_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/ttlive_search_live_feed_count_0"
                android:singleLine="true"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_search_white"
                android:id="@+id/live_feed_label_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_search_live_feed_people"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dislike_layout"
        android:background="#99000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_dislike"
            android:background="@drawable/ttlive_search_shape_circle"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_dislike"
            app:layout_constraintBottom_toTopOf="@+id/tv_dislike"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#e6ffff"
            android:id="@+id/tv_dislike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_search_dislike"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_dislike"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
