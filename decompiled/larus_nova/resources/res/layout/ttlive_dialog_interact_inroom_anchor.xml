<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/profile"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_live_radio_interact_show_profile"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/add_link_time"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_live_radio_interact_add_link_time"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/disconnect"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_live_radio_disconnect"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/report"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_talk_room_report"/>
    <View
        android:background="#f1f1f2"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
