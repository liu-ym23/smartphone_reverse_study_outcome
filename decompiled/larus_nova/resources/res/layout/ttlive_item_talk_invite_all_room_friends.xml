<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/expand_all_container"
        android:background="@drawable/ttlive_bg_audience_expand_more"
        android:layout_width="111dp"
        android:layout_height="26dp"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_expand_all_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_ic_interact_load_more"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</FrameLayout>
