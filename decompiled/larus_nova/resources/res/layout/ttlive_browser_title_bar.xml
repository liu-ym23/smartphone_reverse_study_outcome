<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ttlive_bg_titlebar"
    android:layout_width="0dp"
    android:layout_height="@dimen/ttlive_title_bar_height">
    <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/ttlive_bg_black_return_selector"
        android:drawableStart="@drawable/ttlive_bg_black_return_selector"
        style="@style/ttlive_browser_back_view"/>
    <ImageView
        android:id="@+id/close_all_webpage"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="10dp"/>
    <com.bytedance.android.live.core.widget.LiveTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/ttlive_browser_title_text_style"/>
    <ProgressBar
        android:id="@+id/right_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:indeterminateOnly="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true"
        style="?android:attr/progressBarStyleSmall"/>
    <ImageView
        android:id="@+id/btn_share"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:src="@drawable/ttlive_bg_share_black"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="15dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
