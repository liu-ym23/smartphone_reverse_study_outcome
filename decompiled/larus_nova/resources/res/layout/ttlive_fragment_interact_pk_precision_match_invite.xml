<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_beinvited_constraintlayout"
    android:background="@color/white"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pk_userinfo_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/left_trapezoid"
            android:background="@drawable/ttlive_interact_flex_left_trapezoid"
            android:layout_width="200dp"
            android:layout_height="110dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="174dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="174dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/right_trapezoid"
            android:background="@drawable/ttlive_interact_flex_right_trapezoid"
            android:layout_width="200dp"
            android:layout_height="110dp"
            android:layout_marginLeft="174dp"
            android:layout_marginStart="174dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ic_pk"
            android:background="@drawable/ttlive_ic_pk"
            android:layout_width="30.2dp"
            android:layout_height="17.94dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/self_head_view"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ttlive_ic_default_head_small"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_pk_time_choose_cancel"
            android:gravity="center_vertical"
            android:id="@+id/self_nick_name"
            android:layout_width="0dp"
            android:layout_height="21dp"
            android:layout_marginLeft="86dp"
            android:layout_marginTop="33dp"
            android:layout_marginRight="1dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/ic_pk"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_pk_feedback_tag_bg_unselected"
            android:gravity="center_vertical"
            android:id="@+id/self_desc"
            android:layout_width="88dp"
            android:layout_height="18dp"
            android:layout_marginLeft="86dp"
            android:layout_marginTop="58dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/oppo_head_view"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ttlive_ic_default_head_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/oppo_anim"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/oppo_head_view"
            app:layout_constraintEnd_toEndOf="@+id/oppo_head_view"
            app:layout_constraintStart_toStartOf="@+id/oppo_head_view"
            app:layout_constraintTop_toTopOf="@+id/oppo_head_view"/>
        <TextView
            android:textSize="9dp"
            android:gravity="center"
            android:id="@+id/tv_status"
            android:layout_width="36dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/oppo_anim"
            app:layout_constraintEnd_toEndOf="@+id/oppo_anim"
            app:layout_constraintStart_toStartOf="@+id/oppo_anim"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_pk_time_choose_cancel"
            android:gravity="center"
            android:id="@+id/tv_oppo_nick_name"
            android:layout_width="0dp"
            android:layout_height="21dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="56dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ic_pk"
            app:layout_constraintRight_toLeftOf="@+id/oppo_head_view"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_pk_feedback_tag_bg_unselected"
            android:gravity="center"
            android:id="@+id/oppo_desc"
            android:layout_width="88dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            app:layout_constraintRight_toLeftOf="@+id/oppo_head_view"
            app:layout_constraintTop_toBottomOf="@+id/tv_oppo_nick_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pk_userinfo_container">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/tv_reject"
            android:background="@drawable/ttlive_bg_pk_feedback_another"
            android:layout_width="167dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="4dp"
            android:text="@string/ttlive_interact_pk_precision_match_dialog_reject"
            android:height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_accept"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:layout_width="167dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="15dp"
            android:text="@string/ttlive_link_room_fight_reply_agree"
            android:height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
