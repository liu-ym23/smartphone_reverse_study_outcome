<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/wrap_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.grid.GridRecyclerView
            android:id="@+id/main_recycler_view"
            android:padding="1dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:layout_gravity="left"
            android:id="@+id/left"
            android:background="@drawable/bitable_form_grid_left_shadow_bg"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="41dp"/>
        <View
            android:layout_gravity="right"
            android:id="@+id/right"
            android:background="@drawable/bitable_form_grid_right_shadow_bg"
            android:visibility="visible"
            android:layout_width="10dp"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/highlight_border"
            android:background="@drawable/bitable_card_field_item_bg_warning2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.ee.bear.bitable.card.view.cell.formgrid.view.HorizontalScrollBar
            android:layout_gravity="bottom"
            android:id="@+id/scroll_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="43dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="3dp"/>
    </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/function_danger_fill_default"
        android:id="@+id/error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <FrameLayout
        android:id="@+id/add_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bitable_rec_1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/add_row_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_add_outlined"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:id="@+id/add_row_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
