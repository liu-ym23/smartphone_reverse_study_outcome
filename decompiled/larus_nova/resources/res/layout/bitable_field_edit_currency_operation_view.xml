<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/autonumberRuleOptContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_Currency_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/currencyCodeSelector"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/currencySymbolTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_placeholder"
            android:id="@+id/currencyNameTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_kit_len_6"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_14"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_Progress_DecimalPlaces_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/currencyDecimalSelector"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/currencyDecimalTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
</LinearLayout>
