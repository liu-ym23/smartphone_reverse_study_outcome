<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.product.flow.banner.BannerView
        android:id="@+id/ec_product_card_flow_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ec_product_flow_card_product_activity_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardPriceAndSalesView
        android:id="@+id/ec_product_flow_card_price_and_sales_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <FrameLayout
        android:id="@+id/ec_product_flow_card_product_activity_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardTitleView
        android:id="@+id/ec_product_flow_card_product_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardExtraInfoContainer
        android:orientation="vertical"
        android:id="@+id/ec_product_flow_card_product_extra_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ec_product_flow_card_bottom_container"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp">
        <com.bytedance.android.shopping.product.flow.view.bottom.ProductFlowCardAbilityBarView
            android:id="@+id/product_flow_card_ability_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="24dp"
            android:layout_marginEnd="24dp"/>
        <com.bytedance.android.shopping.product.flow.view.bottom.ProductFlowCardCartView
            android:id="@+id/product_flow_card_cart_view"
            android:layout_width="50dp"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.product.flow.view.bottom.ProductFlowCardBuyButton
            android:id="@+id/product_flow_card_buy_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
