<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="432dp"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ttlive_white"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="432dp"
        android:layout_marginBottom="20dp"
        android:weightSum="4">
        <FrameLayout
            android:id="@+id/audience_link_function_container"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/ttlive_video_interact_function"
                android:layout_marginStart="20dp"/>
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/audience_link_function_switch_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp">
                <Switch
                    android:id="@+id/audience_link_function_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/link_setting_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_paid_link_setting"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/payment_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_payment_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_payment"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/payment_guide_dot"
                        android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                        android:visibility="gone"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginStart="1dp"
                        app:layout_constraintStart_toEndOf="@+id/tv_payment_text"
                        app:layout_constraintTop_toTopOf="@+id/tv_payment_text"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/payment_option"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#80161823"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/payment_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:text="@string/ttlive_label_close"
                            android:layout_marginEnd="2dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginRight="16dp"
                            android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                            android:layout_marginEnd="16dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/payment_switch_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_payment"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/audience_pay_link_switch_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <Switch
                            android:id="@+id/audience_pay_link_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:checked="false"
                            android:textOn=""
                            android:textOff=""
                            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/payment_mode_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:id="@+id/payment_mode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_link_payment_mode"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/payment_mode_guide_dot"
                        android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                        android:visibility="gone"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginStart="1dp"
                        app:layout_constraintStart_toEndOf="@+id/payment_mode_text"
                        app:layout_constraintTop_toTopOf="@+id/payment_mode_text"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/payment_mode_option"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#80161823"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/payment_mode_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:text="@string/ttlive_interact_audience_link_payment_comm_mode"
                            android:layout_marginEnd="2dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginRight="16dp"
                            android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                            android:layout_marginEnd="16dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/history_bill_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:id="@+id/history_bill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_link_history_bill"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/application_reason_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_application_reason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_application_reason_setting"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/application_reason_option"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#80161823"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/application_reason_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:layout_marginEnd="2dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginRight="16dp"
                            android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                            android:layout_marginEnd="16dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/link_mic_assess_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:id="@+id/link_mic_assess_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/ttlive_interact_audience_link_assess_text"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/link_mic_assess_option"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#80161823"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/link_mic_assess_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:layout_marginEnd="2dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginRight="16dp"
                            android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                            android:layout_marginEnd="16dp"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_paid_link_playmode_entrance"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_paid_link_entrance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_paid_link_setting_entrance_desc"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/payment_playmode_guide_dot"
                    android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginStart="1dp"
                    app:layout_constraintStart_toEndOf="@+id/tv_paid_link_entrance"
                    app:layout_constraintTop_toTopOf="@+id/tv_paid_link_entrance"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_paid_link_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#80161823"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/tv_paid_link_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="2dp"
                        android:text="@string/ttlive_paid_link_state_close"
                        android:layout_marginEnd="2dp"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/no_apply"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_interact_video_talk_no_apply"
                    android:layout_marginStart="20dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_need_verify"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/no_fans"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_interact_video_talk_no_fans"
                    android:layout_marginStart="20dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_only_accept_follower"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/allow_send_gift"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/allow_send_gift_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_interact_video_talk_allow_send_gift"
                    android:layout_marginStart="20dp"/>
                <ImageView
                    android:id="@+id/allow_send_gift_rule_img"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/ttlive_guest_send_gift_rule"
                    android:layout_toRightOf="@+id/allow_send_gift_tv"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/allow_send_gift_tv"/>
                <Switch
                    android:id="@+id/switch_send_gift"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:layout_alignParentRight="true"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <include layout="@layout/ttlive_view_paid_queue_switch"/>
            <FrameLayout
                android:id="@+id/no_invite"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_interact_audience_setting_only_invite"
                    android:layout_marginStart="20dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_need_invite"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/support_admin_operate_v2"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/black"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/admin_operation_text_v2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/ttlive_interact_support_admin_operate"
                    android:layout_marginStart="20dp"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
