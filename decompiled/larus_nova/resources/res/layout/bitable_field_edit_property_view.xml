<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fieldPropertyRoot"
    android:paddingTop="@dimen/space_kit_len_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_kit_len_16"
    android:paddingEnd="@dimen/space_kit_len_16">
    <FrameLayout
        android:id="@+id/fieldPropertyTvLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/fieldPropertyText"
            android:paddingTop="-10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fieldPropertySelector"
        android:background="@drawable/facade_round_around_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/bitable_selector_item_text_color"
                    android:id="@+id/fieldPropertySelectorTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <com.larksuite.component.universe_design.badge.UDBadgeView
                    android:id="@+id/fieldPropertyNew"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="8dp"
                    app:ud_badge_size="14dp"
                    app:ud_badge_text="New"
                    app:ud_badge_textColor="@color/white"
                    app:ud_badge_textSize="10sp"
                    app:ud_badge_textWidthPadding="4dp"
                    app:ud_badge_type="text"
                    style="@style/UDBadge.Dot.StrongReminder.Small"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_placeholder"
                android:ellipsize="end"
                android:id="@+id/fieldPropertySelectorTVDesc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_4"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/rightSelectContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fieldPropertyWarning"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ud_icon_warning_colorful"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_placeholder"
                android:ellipsize="end"
                android:id="@+id/fieldPropertySelectorTip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/space_kit_len_4"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fieldPropertyRightArrow"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fieldPropertyChecker"
        android:background="@drawable/facade_round_around_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/fieldPropertyCheckerTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/checkBoxContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.udswitch.UDSwitch
                android:id="@+id/checkBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="@dimen/space_kit_len_16"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
