<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_guest_avatar_cl"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="122dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_virtual_avatar_area"
        android:layout_width="122dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/ttlive_guest_avatar_container"
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/guide_view_volume_container"
            android:layout_width="115dp"
            android:layout_height="115dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar"
            android:background="@drawable/ttlive_bg_default_anchor_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
        <FrameLayout
            android:id="@+id/ttlive_guest_avatar_video_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
        <com.bytedance.android.live.liveinteract.view.VirtualAvatarPauseTipsView
            android:id="@+id/ttlive_leave_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_mute_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar_container"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_volume_Anim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_view_volume_container"
            app:layout_constraintEnd_toEndOf="@+id/guide_view_volume_container"
            app:layout_constraintStart_toStartOf="@+id/guide_view_volume_container"
            app:layout_constraintTop_toTopOf="@+id/guide_view_volume_container"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/ttlive_avatar_right_top_widget_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationX="53dp"
            android:translationY="-53dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_avatar_right_top_widget"
                android:visibility="gone"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/random_emoji_container"
            android:layout_width="75dp"
            android:layout_height="75dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/speech_recognition_lyrics_container"
        android:layout_width="164dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_virtual_avatar_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ttlive_virtual_avatar_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
