<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_profile_set_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/tv_profile_setting_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:text="@string/ttlive_profile_shop_mode_check"
        app:layout_constraintBottom_toTopOf="@+id/iv_profile_setting_template"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_profile_setting_template"
        android:layout_width="325dp"
        android:layout_height="200dp"
        android:layout_marginBottom="26dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/setting_mode_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_color_57_161823"
        android:id="@+id/profile_mode_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_profile_setting_template"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.profile.ui.component.view.anchorsettingpanel.ProfileSettingListView
        android:id="@+id/setting_mode_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_area"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/smart_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_profile_anchor_setting_panel_smart_switch_text"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/smart_switch_desc"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/ttlive_anchor_setting_panel_smart_switch_icon"
            app:layout_constraintBottom_toBottomOf="@+id/smart_switch"
            app:layout_constraintLeft_toRightOf="@+id/smart_switch"
            app:layout_constraintTop_toTopOf="@+id/smart_switch"/>
        <com.bytedance.android.live.profile.ui.component.view.anchorsettingpanel.SwitchButton
            android:id="@+id/switch_button"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
