<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dialog_round_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="160dp">
    <ImageView
        android:id="@+id/bg_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,750:400"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/title_view"
        android:padding="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/negativeBtn"
        android:background="@drawable/ttlive_bg_stateful_negative_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/positiveBtn"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/positiveBtn"
        android:background="@drawable/ttlive_bg_stateful_positive_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="17dp"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/negativeBtn"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
