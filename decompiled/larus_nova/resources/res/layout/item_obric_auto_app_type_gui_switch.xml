<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_auto_gui_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_subTitle="@string/obric_setting_auto_gui_subtitle"
        app:ocardlistitem_title="@string/obric_setting_auto_gui"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_fast_mode_use_action"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/obric_setting_auto_gui_fast_mode_use"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_skill_extension_switch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/obric_setting_auto_gui_skill_extension"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_o_use_clipboard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_subTitle="@string/obric_setting_auto_gui_use_clipboard_subtitle"
        app:ocardlistitem_title="@string/obric_setting_auto_gui_use_clipboard"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_auto_execute_auth_action"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/obric_setting_auto_gui_auto_execute_auth"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/group_risk_preference_action"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/obric_setting_auto_gui_risk_preference"/>
</LinearLayout>
