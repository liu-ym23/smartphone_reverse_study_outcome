<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/experience_plan_option"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32">
        <com.obric.oui.checkbox.OCheckBoxLayout
            android:id="@+id/checkbox_experience_plan"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:checked="false"/>
        <com.obric.oui.text.OTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/obric_user_experience_plan_join"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_2"/>
    </LinearLayout>
    <com.obric.oui.text.OTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/experience_plan_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_4"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"/>
</LinearLayout>
