<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_discount_fingerprint_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_installment_payment_statusBar"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_no_pwd_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"/>
        <RelativeLayout
            android:id="@+id/rl_fingerprint_real_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fingerprint_real_amount_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/cj_pay_rmb_sign"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="38sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_discounted_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_2"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="16dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_pre_discount_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_pre_discount_comma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_discount_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_39"
            android:layout_marginRight="@dimen/cj_pay_padding_16">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_or_order_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_payment_method"
                android:includeFontPadding="false"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_fingerprint_discount_payment_method_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/cj_pay_icon_fingerprint_default_payment"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_installment_or_not_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_separation_line"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_18"
            android:layout_marginRight="@dimen/cj_pay_padding_16"/>
        <ImageView
            android:id="@+id/cj_pay_installment_plan_triangle_up"
            android:background="@drawable/cj_pay_icon_triangle_up"
            android:layout_width="@dimen/cj_pay_padding_16"
            android:layout_height="@dimen/cj_pay_padding_7"
            android:layout_marginLeft="@dimen/cj_pay_padding_38"
            android:layout_marginTop="@dimen/cj_pay_padding_8"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:background="@drawable/cj_pay_bg_verify_discount_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_installment_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginTop="@dimen/cj_pay_padding_11"
                android:layout_marginBottom="@dimen/cj_pay_padding_11"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            layout="@layout/cj_pay_view_no_pwd_agreement_guide_layout"/>
        <include
            android:id="@+id/cj_pay_front_confirm_payment"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_20"
            layout="@layout/cj_pay_common_loading_btn"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
</RelativeLayout>
