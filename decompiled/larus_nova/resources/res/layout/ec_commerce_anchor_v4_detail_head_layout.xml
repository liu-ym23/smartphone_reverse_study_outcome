<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_anchor_v4_detail_head_layout_872058143"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <FrameLayout
        android:id="@+id/anchor_v4_detail_header_container"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v4_detail_tag_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:actualImageScaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v3_ll_banner_items"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:orientation="vertical"
        android:id="@+id/expandable_layout_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/expandable_layout_area"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/commerce_color_161823"
                android:id="@+id/good_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ec_commerce_detail_of_product"
                android:layout_marginStart="16dp"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/ec_commerce_anchor_v4_normal_detail_head_content"/>
            <include
                android:id="@+id/combine_detail_head_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/ec_commerce_anchor_v4_combine_detail_head_content"/>
            <include
                android:id="@+id/combine_detail_head_content_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/ec_commerce_anchor_v4_combine_detail_head_content_opt"/>
        </LinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
</LinearLayout>
