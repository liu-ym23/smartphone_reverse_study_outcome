<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_credit_page_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/view_credit_indicator"
        android:background="@drawable/larus_bg_view_credit_indicator"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_12"/>
    <View
        android:id="@+id/view_top_close_range"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_28"
        android:contentDescription="@string/larus_accessibility_icon_close"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_200"
        app:rv_cornerRadius_TL="?attr/larus_dp_16"
        app:rv_cornerRadius_TR="?attr/larus_dp_16">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_invite_friends_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitEnd"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_container_invite_friends"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_container_invite_title"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_61">
            <TextView
                android:textSize="?attr/larus_dp_28"
                android:textStyle="bold"
                android:textColor="@color/larus_conditional_warning_50"
                android:id="@+id/tv_left_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="?attr/larus_dp_28"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/tv_right_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/tv_description"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            android:maxWidth="?attr/larus_dp_244"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_invite_infos"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_204"
            android:layout_marginTop="?attr/larus_dp_21"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buttons_container"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_48"
            android:layout_marginBottom="?attr/larus_dp_29">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/btn_first"
                android:background="@drawable/larus_bg_btn_douyin_invite"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_52">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_first_icon"
                    android:layout_width="?attr/larus_dp_28"
                    android:layout_height="?attr/larus_dp_28"
                    app:placeholderImage="@drawable/larus_ic_commerce_credit_douyin"
                    app:placeholderImageScaleType="fitCenter"/>
                <TextView
                    android:textSize="?attr/larus_dp_15"
                    android:textStyle="bold"
                    android:textColor="@color/larus_bg_base_1"
                    android:id="@+id/tv_first_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/btn_second"
                android:background="@drawable/larus_bg_btn_weixin_invite"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_52"
                android:layout_marginTop="?attr/larus_dp_12">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_second_icon"
                    android:layout_width="?attr/larus_dp_28"
                    android:layout_height="?attr/larus_dp_28"
                    app:placeholderImage="@drawable/larus_ic_commerce_credit_wechat"
                    app:placeholderImageScaleType="fitCenter"/>
                <TextView
                    android:textSize="?attr/larus_dp_15"
                    android:textStyle="bold"
                    android:textColor="@color/larus_bg_base_1"
                    android:id="@+id/tv_second_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_tv_copy_link"
                android:gravity="center"
                android:id="@+id/tv_copy_invite_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_failed_to_retry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_352"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:minWidth="?attr/larus_dp_130">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            app:srcCompat="@drawable/larus_ic_slim_refresh_gray"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_chat_list_load_failed"/>
    </LinearLayout>
</FrameLayout>
