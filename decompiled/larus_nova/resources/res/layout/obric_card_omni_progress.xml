<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.venus.ShapeConstraintLayout
        android:id="@+id/progress_card_layout"
        android:tag="progress_block"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_14"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:larus_sc_cornerRadius="8dp"
        app:larus_sc_fillColor="@color/obric_operate_phone_card_bg">
        <TextView
            android:textSize="@dimen/dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toTopOf="@+id/progress_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.obric.assistant.view.ObricShimmerProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_10"
            android:layout_marginTop="?attr/larus_dp_10"
            android:max="100"
            android:progressDrawable="?attr/larus_deep_research_progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </com.larus.common_ui.venus.ShapeConstraintLayout>
    <TextView
        android:textSize="@dimen/dp_17"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/finish_desc"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableRight="?attr/larus_ic_arrow_right_grey"
        android:drawablePadding="?attr/larus_dp_4"/>
</RelativeLayout>
