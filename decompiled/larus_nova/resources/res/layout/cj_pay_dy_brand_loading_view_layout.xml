<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dy_brand_loading_view_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/cj_pay_douyin_brand_loading"
        android:background="@drawable/cj_pay_bg_dy_brand_loading_view"
        android:paddingTop="24dp"
        android:layout_width="136dp"
        android:layout_height="122dp">
        <ImageView
            android:id="@+id/dy_brand_loading_iv_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/cj_pay_dy_brand_loading_icon"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#e6ffffff"
            android:id="@+id/dy_brand_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cj_pay_dy_pay"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11dp"
                android:textColor="#99ffffff"
                android:gravity="center"
                android:id="@+id/dy_brand_loading_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cj_pay_payment_info"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:id="@+id/dy_brand_loading_dots"
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:id="@+id/dy_brand_loading_dot_iv1"
                    android:background="@drawable/cj_pay_dy_brand_loading_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"/>
                <ImageView
                    android:id="@+id/dy_brand_loading_dot_iv2"
                    android:background="@drawable/cj_pay_dy_brand_loading_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="16dp"/>
                <ImageView
                    android:id="@+id/dy_brand_loading_dot_iv3"
                    android:background="@drawable/cj_pay_dy_brand_loading_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="32dp"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
