<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40">
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/tv_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lark_Legacy_Contact"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_expand_fold"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/ud_icon_addnew_outlined"
            app:tint="@color/icon_n2"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/text_caption"
            android:id="@+id/tv_expand_fold_department"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_ASLSearch_Contacts_ShowFullDepartment_Button"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
