<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:paddingTop="15dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/stub"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_avatar_view"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/radio_effect"
        app:layout_constraintEnd_toEndOf="@+id/radio_effect"
        app:layout_constraintStart_toStartOf="@+id/radio_effect"
        app:layout_constraintTop_toTopOf="@+id/radio_effect"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/radio_effect"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"/>
    <com.bytedance.android.live.liveinteract.view.PositionNameTv
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_position_name"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="4"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"/>
    <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pos_tag_label"
        android:background="@drawable/ttllive_audio_talk_seat_host_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:includeFontPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.seat.layer.interactivesong.RequestSongMicSeatView
        android:id="@+id/request_song_micseat_view"
        android:layout_width="@dimen/ttlive_voice_chat_guest_seat_row_width"
        android:layout_height="@dimen/ttlive_voice_chat_guest_seat_row_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="15dp"
        android:lines="1"
        android:maxEms="10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_avatar_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
