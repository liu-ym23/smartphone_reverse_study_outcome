<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/cj_pay_bg_card_grey"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/keyboard_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <ImageView
            android:id="@+id/keyboard_insurance_image"
            android:layout_width="200dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/keyboard_done_btn"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/cj_pay_amount_key_board_view"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:textAllCaps="false"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_1"
            android:tag="1"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_2"
            android:tag="2"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="2"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_3"
            android:tag="3"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="3"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_4"
            android:tag="4"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="4"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_5"
            android:tag="5"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="5"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_6"
            android:tag="6"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="6"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_7"
            android:tag="7"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="7"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_8"
            android:tag="8"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="8"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_9"
            android:tag="9"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="9"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_X"
            android:tag="X"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="X"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="24dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/key_lable_0"
            android:tag="0"
            android:background="@drawable/cj_pay_keyboard_key_bg_new"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0.5dp"
            android:text="0"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/key_lable_delete"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5dp"
            android:src="?attr/cj_pay_icon_pwd_delete_noise_reduction"
            android:scaleType="center"
            android:layout_weight="1"
            android:contentDescription="删除"/>
    </LinearLayout>
</LinearLayout>
