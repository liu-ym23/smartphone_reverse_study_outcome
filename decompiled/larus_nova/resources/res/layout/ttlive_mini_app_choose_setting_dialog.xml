<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_mini_app_choose_setting_dialog_bg"
    android:paddingBottom="57dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:adjustViewBounds="true">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/ttlive_douyin_light_TextPrimary"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_mini_app_choose_setting_dialog_title"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/close_btn"
        android:background="@drawable/ttlive_mini_app_choose_setting_dialog_close_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ttlive_mini_app_choose_setting_dialog_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/show_live_data_switch_layout"
        app:layout_constraintLeft_toLeftOf="@+id/memory_miniapp_switch_layout"
        app:layout_constraintRight_toRightOf="@+id/memory_miniapp_switch_layout"
        app:layout_constraintTop_toTopOf="@+id/memory_miniapp_switch_layout"/>
    <RelativeLayout
        android:id="@+id/memory_miniapp_switch_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/close_btn">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/memory_miniapp_switch"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/memory_miniapp_switch"
            android:layout_alignParentStart="true">
            <TextView
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:id="@+id/memory_miniapp_switch_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_mini_app_choose_setting_dialog_memory_miniapp_text"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/ttlive_douyin_text_TextReverse3"
                android:id="@+id/talent_no_support_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"
                android:text="@string/ttlive_mini_app_choose_setting_dialog_no_support_tip2"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/memory_miniapp_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:lsb_background="#33161823"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_mini_app_choose_setting_dialog_btn_checked"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider1"
        android:background="@color/ttlive_douyin_light_DialogDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="@+id/memory_miniapp_switch_layout"
        app:layout_constraintRight_toRightOf="@+id/memory_miniapp_switch_layout"
        app:layout_constraintTop_toBottomOf="@+id/memory_miniapp_switch_layout"/>
    <RelativeLayout
        android:id="@+id/open_first_explain_card_switch_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider1">
        <TextView
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:id="@+id/open_first_explain_card_switch_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_open_platform_setting_default_open_first_explain_card"
            android:layout_toLeftOf="@+id/open_first_explain_card_switch"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toStartOf="@+id/open_first_explain_card_switch"
            android:layout_alignParentStart="true"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/open_first_explain_card_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:lsb_background="#33161823"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_mini_app_choose_setting_dialog_btn_checked"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider2"
        android:background="@color/ttlive_douyin_light_DialogDivider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="@+id/open_first_explain_card_switch_layout"
        app:layout_constraintRight_toRightOf="@+id/open_first_explain_card_switch_layout"
        app:layout_constraintTop_toBottomOf="@+id/open_first_explain_card_switch_layout"/>
    <RelativeLayout
        android:id="@+id/show_live_data_switch_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider2">
        <TextView
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:id="@+id/show_live_data_switch_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_open_platform_setting_show_live_data"
            android:layout_toLeftOf="@+id/show_live_data_switch"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toStartOf="@+id/show_live_data_switch"
            android:layout_alignParentStart="true"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/show_live_data_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:lsb_background="#33161823"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_mini_app_choose_setting_dialog_btn_checked"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
