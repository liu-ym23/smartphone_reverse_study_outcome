<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet_radius_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close_dialog"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_close_dialog_btn"
        android:layout_marginEnd="?attr/larus_dp_8"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:text="@string/larus_creation_bottomsheet_title_replace"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/text_bind_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_28"
            android:text="@string/larus_creation_bottomsheet_desc_replace"
            android:fontFamily="sans-serif-medium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_28">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/white_t_image"
                android:layout_width="?attr/larus_dp_204"
                android:layout_height="?attr/larus_dp_204"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundAsCircle="true"/>
            <View
                android:id="@+id/bg_cover_mask"
                android:background="@drawable/larus_dialog_digital_mask"
                android:layout_width="?attr/larus_dp_204"
                android:layout_height="?attr/larus_dp_204"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/larus_replace_replica_bottomsheet_label_current"
                app:layout_constraintBottom_toBottomOf="@+id/white_t_image"
                app:layout_constraintEnd_toEndOf="@+id/white_t_image"
                app:layout_constraintStart_toStartOf="@+id/white_t_image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/button_replace_confirm"
            android:background="@drawable/larus_auto_publish_confirm"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_32"
            android:layout_marginRight="?attr/larus_dp_16"
            android:text="@string/larus_creation_bottomsheet_btn_replace"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/button_cancel"
            android:background="@drawable/larus_auto_publish_cancel"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_16"
            android:text="@string/larus_creation_bottomsheet_btn_cancel"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
