<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/html_preview_tab_layout"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/html_preview_render_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Lark_IM_Html_Preview_Tab"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/html_preview_source_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Lark_IM_Html_Code_Tab"
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/html_preview_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.larksuite.component.universe_design.notice.UDNotice
            android:layout_gravity="top"
            android:id="@+id/html_preview_disclaimer_banner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ud_notice_backgroundColor="@color/function_info_fill_solid_02"
            app:ud_notice_icon="@drawable/ud_icon_info_hollow_filled"
            app:ud_notice_iconBtn="@drawable/ud_icon_close_small_outlined"
            app:ud_notice_textColor="@color/text_title"/>
    </FrameLayout>
</LinearLayout>
