<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/single_mode_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView
                android:id="@+id/single_avatar"
                android:visibility="visible"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:scaleType="centerCrop"
                app:civ_border_width="0dp"
                app:civ_oval="true"/>
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/right_bottom_icon"
                android:visibility="gone"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:civ_border_color="@color/static_white"
                app:civ_border_width="1.5dp"
                app:civ_oval="true"
                app:layout_constraintCircle="@+id/single_avatar"
                app:layout_constraintCircleAngle="135"
                app:layout_constraintCircleRadius="24dp"/>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/single_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_toStartOf="@+id/chatPreview_icon"
            android:layout_toEndOf="@+id/avatar_container"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chatPreview_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="fitEnd"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_right_bold_outlined"
            app:tint="@color/icon_n3"/>
    </RelativeLayout>
    <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
        android:id="@+id/multi_mode_rv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/single_mode_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/base_content_container"
        android:background="@drawable/common_conner5_color10_solid_bg"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multi_mode_rv">
        <FrameLayout
            android:id="@+id/confirm_dialog_icon_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/confirm_dialog_content_layout"
            app:layout_constraintTop_toTopOf="parent">
            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/confirm_dialog_icon"
                android:background="@color/bg_float_overlay"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/confirm_dialog_sub_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="4dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/confirm_dialog_content_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/confirm_dialog_icon_layout"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.ss.android.lark.widget.EllipsizedEmojiconTextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/confirm_msg_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.ss.android.lark.widget.EllipsizedEmojiconTextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/confirm_msg_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_2"
                android:maxLines="2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_placeholder"
                android:ellipsize="end"
                android:id="@+id/confirm_msg_desc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/custom_content_container"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/base_content_container"/>
    <com.ss.android.lark.keyboard.edittext2.KeyboardFunctionEditText
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center"
        android:id="@+id/note_edit_text"
        android:background="@drawable/common_color_white_conner6_with_edge_new"
        android:paddingLeft="10.5dp"
        android:paddingTop="7.5dp"
        android:paddingRight="10.5dp"
        android:paddingBottom="7.5dp"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:maxHeight="55dp"
        android:hint="@string/Lark_Legacy_ADDNOTE"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/custom_content_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
