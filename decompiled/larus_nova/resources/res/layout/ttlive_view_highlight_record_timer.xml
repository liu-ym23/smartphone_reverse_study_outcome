<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/record_ball_layout"
        android:layout_width="wrap_content"
        android:layout_height="40dp">
        <View
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ball_background"
            android:background="@drawable/ttlive_record_handle_ball_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_record_red_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_record_handle_ball_red_dot"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:id="@+id/iv_record_stop"
            android:background="@drawable/ttlive_ic_record_stop"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:includeFontPadding="false"
            android:layout_marginStart="9dp"/>
    </FrameLayout>
</com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer>
