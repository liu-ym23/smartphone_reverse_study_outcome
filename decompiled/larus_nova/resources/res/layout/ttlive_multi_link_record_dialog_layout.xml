<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="144dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="与 番茄儿 连线中"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textSize="15dp"
            android:textColor="#161823"
            android:id="@+id/close"
            android:background="@drawable/ttlive_bg_interact_dialog_content_clear"
            android:layout_width="162dp"
            android:layout_height="44dp"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="20dp"
            android:text="立即结束"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <Button
            android:textSize="15dp"
            android:textColor="#fff"
            android:id="@+id/cancel"
            android:background="@drawable/ttlive_bg_interact_dialog_content_clear_red"
            android:layout_width="162dp"
            android:layout_height="44dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="20dp"
            android:text="再聊一会"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
