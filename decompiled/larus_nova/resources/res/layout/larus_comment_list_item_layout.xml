<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/img_header"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/neutral_50"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/view_like_wapper"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img_header"
        app:layout_constraintTop_toTopOf="@+id/img_header"/>
    <com.story.ai.biz.comment.view.CommentLikeView
        android:id="@+id/view_like_wapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.ExpandableTextView
        android:textSize="15sp"
        android:textColor="?attr/neutral_100"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="12dp"
        app:larus_etv_EllipsisHint="..."
        app:larus_etv_EnableToggle="true"
        app:larus_etv_MaxLinesOnShrink="5"
        app:larus_etv_ToExpandHint="@string/larus_load_more"
        app:larus_etv_ToExpandHintColor="?attr/neutral_50"
        app:larus_etv_ToExpandHintShow="true"
        app:larus_etv_ToShrinkHint="@string/larus_botsComment_commentPanel_label_collapse"
        app:larus_etv_ToShrinkHintColor="?attr/neutral_50"
        app:larus_etv_ToShrinkHintShow="true"
        app:layout_constraintEnd_toStartOf="@+id/view_like_wapper"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/neutral_50"
        android:id="@+id/tv_send_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/primary_50"
        android:id="@+id/tv_send_failed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/larus_loading_error_msg"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toEndOf="@+id/tv_send_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <TextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="?attr/neutral_50"
        android:id="@+id/tv_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintStart_toEndOf="@+id/tv_send_failed_label"
        app:layout_constraintTop_toTopOf="@+id/tv_send_time"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/neutral_50"
        android:id="@+id/tv_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_botsComment_comment_btn_reply"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toEndOf="@+id/tv_location"
        app:layout_constraintTop_toTopOf="@+id/tv_location"/>
</androidx.constraintlayout.widget.ConstraintLayout>
