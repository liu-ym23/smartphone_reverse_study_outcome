<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="52dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:background="@drawable/ttlive_bg_user_layout_new_style"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/head"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-2dp"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="-2dp"
            android:layout_toEndOf="@+id/avatar_container">
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/name_layout"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_white"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:shadowDy="1"
                    android:shadowRadius="1"/>
                <com.bytedance.android.livesdk.common.EllipsizeLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/user_name_with_tag_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/ttlive_white"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:id="@+id/user_name_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:lineSpacingExtra="0.5dp"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/user_verify_tag"
                        android:visibility="gone"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="3dp"/>
                </com.bytedance.android.livesdk.common.EllipsizeLayout>
                <com.bytedance.android.livesdk.common.MarqueeTextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/marquee_user_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ticket_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ticket_number_new_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#ffffff"
                        android:id="@+id/ticket_number_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:shadowColor="#26000000"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:lineSpacingExtra="-1dp"/>
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#eae9e9"
                        android:id="@+id/ticket_number_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:shadowColor="#26000000"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:lineSpacingExtra="-1dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ttlive_hs_w2"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/fans_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <FrameLayout
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/fl_room_cert"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_middle_container"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <com.bytedance.android.live.room.navi.userinfo_p.flipper.UserInfoFlipperLayout
                    android:id="@+id/first_tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flipper_auto_start="true"/>
                <com.bytedance.android.live.room.navi.userinfo_p.flipper.UserInfoFlipperLayout
                    android:id="@+id/second_tab"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    app:flipper_auto_start="true"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/add_ticket_layout"
                android:visibility="gone"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f8f8f8"
                    android:id="@+id/add_ticket_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                    android:id="@+id/add_ticket_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_room_live_end_ticket_count_label"
                    android:singleLine="true"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/temp_anim_name_container"
                android:visibility="visible"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
                android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f8f8f8"
                    android:id="@+id/temp_anim_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                    android:id="@+id/temp_anim_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <FrameLayout
                android:id="@+id/entrance_container"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/name_layout"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/flEeceremony"
        android:layout_width="52dp"
        android:layout_height="52dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_ceremony_border"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="7dp"
            android:layout_marginStart="7dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_iv_ceremony_border"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/user_gift_exhibition_light_container"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"/>
</RelativeLayout>
