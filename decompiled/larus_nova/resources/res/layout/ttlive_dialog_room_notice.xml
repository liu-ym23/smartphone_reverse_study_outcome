<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/notice_container"
        android:background="@drawable/ttlive_bg_broadcast_pre_room_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_edit"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="51.5dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#000000"
                    android:id="@+id/notice_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="取消"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:id="@+id/notice_title"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="直播公告"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#f04142"
                    android:id="@+id/notice_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:background="@color/ttlive_std_line_black_3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <EditText
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_std_text_black_1"
                android:textColorHint="#3c000000"
                android:gravity="top|left"
                android:id="@+id/notice_edit_view"
                android:background="@null"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="请输入直播公告"
                android:lines="5"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#0e408c"
                    android:id="@+id/notice_tips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="什么是直播间公告"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/notice_text_length"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
