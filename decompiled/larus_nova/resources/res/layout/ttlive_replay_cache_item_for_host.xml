<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.replay.cache.ui.customui.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vs_cache_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vs_cache_real_container"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/vs_cache_cover"
            android:layout_width="133dp"
            android:layout_height="64dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="2dp"/>
        <ImageView
            android:id="@+id/vs_cache_state_iv"
            android:background="@drawable/ttlive_bg_vs_cache_host_cover_bg"
            android:paddingLeft="41dp"
            android:paddingTop="16dp"
            android:paddingRight="41dp"
            android:paddingBottom="16dp"
            android:layout_width="133dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_cache_cover"
            app:layout_constraintEnd_toEndOf="@+id/vs_cache_cover"
            app:layout_constraintStart_toStartOf="@+id/vs_cache_cover"
            app:layout_constraintTop_toTopOf="@+id/vs_cache_cover"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vs_cache_info_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/vs_cache_cover"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_vs_cache_host_title_color"
                android:ellipsize="end"
                android:id="@+id/vs_cache_info_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:lines="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/vs_caching_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.livesdk.chatroom.replay.cache.ui.customui.CacheProgressBar
                android:id="@+id/vs_cache_progress"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginBottom="6dp"
                app:layout_constraintBottom_toTopOf="@+id/vs_cache_progress_detail"
                app:layout_constraintLeft_toLeftOf="@+id/vs_cache_info_title"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_vs_cache_host_sub_content_color"
                android:id="@+id/vs_cache_progress_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_replay_cache_speed"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/vs_cache_progress_ratio"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_vs_cache_host_sub_content_color"
                android:id="@+id/vs_cache_progress_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_replay_cache_download_progress"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/vs_cache_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_vs_cache_host_sub_content_color"
                android:id="@+id/vs_cache_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_vs_cache_host_sub_content_color"
                android:id="@+id/vs_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_replay_cache_watch_record"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/vs_history_phone"
                android:layout_width="8dp"
                android:layout_height="11dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ttlive_ic_vs_cache_phone"
                app:layout_constraintBottom_toBottomOf="@+id/vs_history"
                app:layout_constraintRight_toLeftOf="@+id/vs_history"
                app:layout_constraintTop_toTopOf="@+id/vs_history"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vs_cache_delete"
        android:background="@color/ttlive_vs_cache_host_delete_bg"
        android:layout_width="74dp"
        android:layout_height="match_parent"
        android:text="@string/ttlive_vs_cache_delete"/>
</com.bytedance.android.livesdk.chatroom.replay.cache.ui.customui.SwipeMenuLayout>
