<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_content"
    android:background="@drawable/ttlive_open_platform_shelf_card_background"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ttlive_open_platform_check_box_style"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/card_cover_img"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:layout_marginLeft="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/checkbox"
        app:layout_constraintStart_toEndOf="@+id/checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"
        app:roundingBorderColor="#33000000"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/card_index_tv"
        android:background="@drawable/ttlive_bg_miniapp_explain_card_index"
        android:layout_width="28dp"
        android:layout_height="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/card_cover_img"
        app:layout_constraintStart_toStartOf="@+id/card_cover_img"
        app:layout_constraintTop_toTopOf="@+id/card_cover_img"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/card_explaining_container"
        android:background="@drawable/ttlive_bg_miniapp_explaining_area"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/card_cover_img"
        app:layout_constraintEnd_toEndOf="@+id/card_cover_img"
        app:layout_constraintLeft_toLeftOf="@+id/card_cover_img"
        app:layout_constraintRight_toRightOf="@+id/card_cover_img"
        app:layout_constraintStart_toStartOf="@+id/card_cover_img">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_ic_card_explaining"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_miniapp_card_btn_explaining"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_uikit_const_tPrimary"
        android:ellipsize="end"
        android:id="@+id/card_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/more_tv"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toLeftOf="@+id/more_tv"
        app:layout_constraintStart_toEndOf="@+id/card_cover_img"
        app:layout_constraintTop_toTopOf="@+id/card_cover_img"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_douyin_light_TextReverse3"
        android:id="@+id/more_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_open_platform_shelf_more"
        app:layout_constraintBottom_toBottomOf="@+id/card_title_tv"
        app:layout_constraintLeft_toRightOf="@+id/card_title_tv"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_title_tv"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center_vertical"
        android:id="@+id/edit_explain_card"
        android:background="@drawable/ttlive_open_platform_set_explain_card_bg"
        android:paddingLeft="3dp"
        android:paddingTop="2dp"
        android:paddingRight="3dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/ttlive_open_platform_edit_explain_card"
        android:includeFontPadding="false"
        android:drawableRight="@drawable/ttlive_ic_explain_card_setting_arrow"
        android:drawablePadding="2dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="@+id/card_title_tv"
        app:layout_constraintRight_toLeftOf="@+id/review_status_tv"
        app:layout_constraintTop_toBottomOf="@+id/card_title_tv"/>
    <TextView
        android:textSize="10sp"
        android:id="@+id/review_status_tv"
        android:paddingLeft="3dp"
        android:paddingTop="2dp"
        android:paddingRight="3dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:includeFontPadding="false"
        android:drawableRight="@drawable/ttlive_open_platform_review_rejected_icon"
        android:drawablePadding="2dp"
        android:drawableEnd="@drawable/ttlive_open_platform_review_rejected_icon"
        app:layout_constraintLeft_toRightOf="@+id/edit_explain_card"
        app:layout_constraintRight_toLeftOf="@+id/drag_img"
        app:layout_constraintTop_toBottomOf="@+id/card_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:ellipsize="end"
        android:id="@+id/selling_point_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toLeftOf="@+id/drag_img"
        app:layout_constraintTop_toBottomOf="@+id/review_status_tv"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductIntroductionLayout
        android:id="@+id/product_introduction"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toLeftOf="@+id/drag_img"
        app:layout_constraintTop_toBottomOf="@+id/selling_point_tv"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductLabelLayout
        android:id="@+id/product_label"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toLeftOf="@+id/drag_img"
        app:layout_constraintTop_toBottomOf="@+id/product_introduction"/>
    <com.bytedance.android.live.openplatform.impl.miniappcommon.shelf.view.CommonProductPriceView
        android:id="@+id/product_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/card_cover_img"
        app:layout_constraintRight_toLeftOf="@+id/drag_img"/>
    <ImageView
        android:id="@+id/drag_img"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_open_platform_drag_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
