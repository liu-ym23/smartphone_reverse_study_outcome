<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:id="@+id/creation_like_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginEnd="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/creation_share_container"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rv_backgroundColor="@color/larus_neutral_transparent_2"
        app:rv_cornerRadius="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_like_img"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_like_count"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_like_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:id="@+id/creation_share_container"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:contentDescription="@string/larus_accessibility_icon_share"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/creation_make_same_container"
        app:layout_constraintStart_toEndOf="@+id/creation_like_container"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_share_img"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:src="@drawable/larus_image_detail_icon_share_hollow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:id="@+id/creation_make_same_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/creation_share_container"
        app:layout_constraintTop_toTopOf="parent"
        app:rv_backgroundColor="@color/larus_neutral_100"
        app:rv_cornerRadius="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_make_same_img"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_community_ic_use_template"
            android:tint="@color/larus_base_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_make_same_tips"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_base_1"
            android:id="@+id/tv_make_same_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_detail_btn_customize"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_make_same_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</merge>
