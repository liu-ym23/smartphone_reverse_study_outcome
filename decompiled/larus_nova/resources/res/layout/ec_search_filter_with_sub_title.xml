<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/filter_common_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.ss.android.ugc.aweme.search.filter.view.good.ECSearchFilterCornerBg
        android:id="@+id/filter_common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/filter_common_content_root"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/filter_common_icon_left"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="2dp"
                android:scaleType="fitXY"
                android:layout_marginEnd="2dp"/>
            <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
                android:textSize="14sp"
                android:id="@+id/filter_common_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:includeFontPadding="false"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/filter_common_icon_right"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:scaleType="fitXY"
                android:layout_marginStart="2dp"/>
            <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
                android:textSize="14sp"
                android:id="@+id/filter_common_text_tail"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:minHeight="16dp"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="10sp"
        android:id="@+id/filter_sub_title_text"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:fontFamily="PingFang SC"/>
</LinearLayout>
