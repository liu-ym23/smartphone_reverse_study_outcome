<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ktv_sing_icon_container"
    android:visibility="gone"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:contentDescription="@string/ttlive_ktv_tab_select"
    app:layout_constraintBottom_toBottomOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintEnd_toEndOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintStart_toStartOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintTop_toTopOf="@+id/ktv_float_ball_placeholder">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ktv_icon_animation"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"/>
    <View
        android:layout_gravity="center"
        android:background="@drawable/ttlive_ktv_icon_bg"
        android:layout_width="34dp"
        android:layout_height="34dp"/>
    <com.bytedance.android.live.ktv.common.midi.KtvComponentProgressView
        android:layout_gravity="center"
        android:id="@+id/ktv_progress"
        android:layout_width="34dp"
        android:layout_height="34dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ktv_icon_iv"
        android:visibility="visible"
        android:layout_width="26dp"
        android:layout_height="14dp"
        android:src="@drawable/ttlive_ktv_component_order_txt"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ktv_component_challenge_count_down"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_core_hs_w1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ktv_score_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:shadowColor="#1a000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="3"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/ktv_apply_user_list_size"
        android:background="@drawable/ttlive_ksong_multiple_ktv_music_list_size_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:minWidth="16dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="8dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/ktv_order_song_num"
        android:background="@drawable/ttlive_ksong_multiple_ktv_music_list_size_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:minWidth="16dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="8dp"/>
    <View
        android:layout_gravity="right"
        android:id="@+id/ktv_dress_unread"
        android:background="@drawable/ttlive_ktv_dress_yellow_dot"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
