<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/gray"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_std_text_black_1"
        android:id="@+id/debug_local_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_lynx_local_dubug"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="@android:color/black"
        android:id="@+id/title_origin_url_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_lynx_origin_schema"
        android:layout_below="@+id/debug_local_title"/>
    <TextView
        android:id="@+id/origin_url_text"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:text="@string/ttlive_lynx_local_url"
        android:layout_below="@+id/title_origin_url_text"
        android:textIsSelectable="true"/>
    <TextView
        android:textColor="@android:color/black"
        android:id="@+id/title_debug_url_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_lynx_local_debug_page"
        android:layout_below="@+id/origin_url_text"/>
    <EditText
        android:textSize="14dp"
        android:gravity="top"
        android:id="@+id/debug_url_text"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:hint="@string/ttlive_lynx_local_debug_tip"
        android:layout_below="@+id/title_debug_url_text"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/title_input_local_ip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_lynx_local_ip"/>
        <EditText
            android:id="@+id/edit_local_ip_port"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/ttlive_lynx_hint_ip"
            android:layout_toRightOf="@+id/title_input_local_ip"
            android:layout_alignTop="@+id/title_input_local_ip"/>
        <TextView
            android:textColor="@color/red"
            android:id="@+id/debug_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_lynx_local_ip_replace"
            android:layout_below="@+id/edit_local_ip_port"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/adb_schema_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_lynx_local_adb_schema"
            android:height="40dp"
            android:layout_below="@+id/debug_description"/>
        <EditText
            android:id="@+id/adb_schema"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text=""
            android:hint="@string/ttlive_lynx_local_edit_snssdk1234"
            android:layout_toLeftOf="@+id/copy_adb_shell"
            android:layout_toRightOf="@+id/adb_schema_txt"
            android:layout_below="@+id/debug_description"/>
        <Button
            android:textSize="12dp"
            android:id="@+id/copy_adb_shell"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_lynx_local_copy_adb"
            android:layout_below="@+id/debug_description"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textColor="@color/red"
            android:id="@+id/copy_adb_shell_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_lynx_local_copy_adb_tips"
            android:layout_below="@+id/copy_adb_shell"/>
        <Button
            android:textSize="12dp"
            android:id="@+id/send_to_user"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="0dp"
            android:text="@string/ttlive_lynx_local_send_to_lark"
            android:layout_below="@+id/copy_adb_shell_desc"
            android:layout_alignParentLeft="true"/>
        <Button
            android:textSize="12dp"
            android:id="@+id/open_debug_page"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="0dp"
            android:text="@string/ttlive_lynx_local_open_debug_page"
            android:layout_below="@+id/copy_adb_shell_desc"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
