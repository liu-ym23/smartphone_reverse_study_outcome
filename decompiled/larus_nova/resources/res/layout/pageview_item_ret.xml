<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/facade_round_around_xl"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:layout_width="match_parent"
    android:layout_height="105dp"
    android:backgroundTint="@color/bg_float_base">
    <TextView
        android:textSize="@dimen/space_kit_font_12"
        android:textColor="@color/text_caption"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/Doc_Doc_ReadingCount"
        app:layout_constraintBottom_toTopOf="@+id/value"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/space_kit_font_17"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="N/A"
        android:maxLines="1"
        app:autoSizeMaxTextSize="@dimen/space_kit_font_17"
        app:autoSizeMinTextSize="@dimen/space_kit_font_10"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/value">
        <ImageView
            android:id="@+id/image_up"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ud_icon_insert_up_outlined"
            android:tint="@color/function_success_fill_pressed"/>
        <TextView
            android:textSize="@dimen/space_kit_font_10"
            android:textColor="@color/function_success_fill_pressed"
            android:gravity="center"
            android:id="@+id/today_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:text="今日新增："/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_10"
        android:textColor="@color/function_success_fill_pressed"
        android:gravity="center"
        android:id="@+id/today_value2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
