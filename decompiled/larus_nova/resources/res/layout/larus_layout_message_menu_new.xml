<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_new_balloon_radius"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/balloon_menu_copy"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_14">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_ic_copy"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_2"
            app:srcCompat="?attr/larus_ic_balloon_copy"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/balloon_text_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_select_text_copy"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_1"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_19"
        android:layout_marginBottom="?attr/larus_dp_19"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/balloon_menu_read"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_14">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_ic_read"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_2"
            app:srcCompat="?attr/larus_ic_balloon_read"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/balloon_text_read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_select_text_speak"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_2"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_19"
        android:layout_marginBottom="?attr/larus_dp_19"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/balloon_menu_rewrite"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_14">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_ic_rewrite"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_2"
            app:srcCompat="?attr/larus_ic_balloon_rewrite"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_text_rewrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_select_text_rewrite"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_3"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_19"
        android:layout_marginBottom="?attr/larus_dp_19"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/balloon_menu_question"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_14">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_ic_question"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_2"
            app:srcCompat="?attr/larus_ic_balloon_question"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/balloon_text_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_select_text_quote"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
