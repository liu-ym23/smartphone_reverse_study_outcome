<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#161616"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ttlive_leftTopRadius="6dp"
    app:ttlive_rightTopRadius="6dp">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="完成录制"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="返回"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/tvSaveDraft"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="存草稿"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/flCoverContainer"
        android:background="@drawable/ttlive_highlight_record_cover_stroke"
        android:layout_width="108dp"
        android:layout_height="192dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:ttlive_allRadius="2dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/ivCover"
            android:layout_width="104dp"
            android:layout_height="188dp"
            app:actualImageScaleType="centerCrop"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
        android:gravity="center"
        android:id="@+id/llPublish"
        android:background="#0fffffff"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/llDownload"
        app:layout_constraintTop_toBottomOf="@+id/flCoverContainer"
        app:ttlive_allRadius="8dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布到抖音"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivPublishLoading"
            android:background="@drawable/ttlive_ic_highlight_record_loading"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
        android:gravity="center"
        android:id="@+id/llDownload"
        android:background="#fe2c55"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/llPublish"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llPublish"
        app:ttlive_allRadius="8dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
