<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_voice_chat_online_guest_click_option"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_change_position"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_interact_audio_talk_change_position"/>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_invite_friends"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_interact_audio_talk_invite_friends"/>
    <View
        android:background="#0d161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
