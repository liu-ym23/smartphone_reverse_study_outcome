<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/new_bot_tag_item_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/new_bot_tag_item_view_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/new_bot_tag_item_view_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/live_tutor_multi_tag_item_text_color"
            android:id="@+id/new_bot_tag_item_view_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/new_bot_tag_item_view_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/new_bot_tag_item_view_line"
        android:background="@color/larus_neutral_100_day"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_2"
        android:layout_marginTop="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="@+id/new_bot_tag_item_container"
        app:layout_constraintStart_toStartOf="@+id/new_bot_tag_item_container"
        app:layout_constraintTop_toBottomOf="@+id/new_bot_tag_item_container"/>
</merge>
