<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
        android:id="@+id/cj_pay_sign_agreement_view_checkbox"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="4dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:id="@+id/cj_pay_sign_agreement_view_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2.5dp"/>
</LinearLayout>
