<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/office_space_header"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <com.bytedance.ee.bear.office.space.OfficeSpaceTabLayout
                android:id="@+id/office_space_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/office_space_tab_layout_margin_default"
                android:layout_marginEnd="@dimen/office_space_tab_layout_margin_default"
                android:layout_toStartOf="@+id/office_space_right_actions"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/office_space_menu_button"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_alignParentStart="true"
                app:srcCompat="@drawable/office_ic_space_header_menu"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/office_space_right_actions"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/office_space_search_button"
                    android:padding="10dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:srcCompat="@drawable/office_ic_space_header_search"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/office_space_more_button"
                    android:padding="10dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:srcCompat="@drawable/ud_icon_more_outlined"
                    app:tint="@color/text_title"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/office_space_selection_header"
                android:background="@color/bg_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/office_space_selection_cancel"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:text="@string/LarkCCM_Common_Cancel_Button"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/office_space_selection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=""
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/office_space_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/office_space_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_gravity="top"
                android:id="@+id/office_space_upload_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
