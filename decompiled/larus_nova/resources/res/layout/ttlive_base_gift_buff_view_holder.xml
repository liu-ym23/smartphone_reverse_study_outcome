<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="97dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_buff_bg"
            android:layout_width="97dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:id="@+id/buff_card_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_buff_bg"
            app:layout_constraintStart_toEndOf="@+id/buff_lock_icon"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/buff_time_text"
            android:background="@drawable/ttlive_base_gift_cornor_bg"
            android:layout_width="33dp"
            android:layout_height="12dp"
            android:text="剩13天"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/selected_view"
            android:background="@drawable/ttlive_gift_buff_card_selected"
            android:visibility="gone"
            android:layout_width="97dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_buff_bg"
            app:layout_constraintEnd_toEndOf="@+id/gift_buff_bg"
            app:layout_constraintStart_toStartOf="@+id/gift_buff_bg"
            app:layout_constraintTop_toTopOf="@+id/gift_buff_bg"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/buff_sweep_light_view"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="35dp"
            app:layout_constraintStart_toStartOf="@+id/gift_buff_bg"
            app:layout_constraintTop_toTopOf="@+id/gift_buff_bg"/>
        <android.widget.Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_buff_bg"
            app:layout_constraintStart_toStartOf="@+id/gift_buff_bg"/>
        <ImageView
            android:id="@+id/buff_lock_icon"
            android:background="@drawable/ttlive_buffcard_lock_icon"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_buff_bg"
            app:layout_constraintStart_toStartOf="@+id/space"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
