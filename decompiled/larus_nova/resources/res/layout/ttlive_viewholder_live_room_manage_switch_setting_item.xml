<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white_90"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_switch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="21dp"/>
    <ImageView
        android:id="@+id/iv_switch_title"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_icon_help"
        android:layout_toRightOf="@+id/tv_switch_title"
        android:layout_toEndOf="@+id/tv_switch_title"/>
    <ImageView
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_ic_red_point_tip"
        android:layout_toRightOf="@+id/tv_switch_title"
        android:layout_alignTop="@+id/tv_switch_title"
        android:layout_toEndOf="@+id/tv_switch_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_commonui_white_50"
        android:gravity="center_vertical"
        android:id="@+id/tv_switch_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="310dp"
        android:minHeight="18dp"
        android:maxLines="1"
        android:layout_below="@+id/tv_switch_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_more_anchor_img_round"
        android:id="@+id/tv_desc_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/tv_switch_description"
        android:layout_alignBaseline="@+id/tv_switch_description"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/tv_switch_description"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:layout_gravity="center_vertical"
        android:id="@+id/setting_switch"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#d9ffffff"/>
</RelativeLayout>
