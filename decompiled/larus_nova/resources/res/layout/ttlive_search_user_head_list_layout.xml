<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxHeight="52dp">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/user_head_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ttlive_ic_search_legacy_uikit_ic_searshbar_search_white"
            android:scaleType="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/search_et"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ttlive_ic_search_legacy_uikit_ic_searshbar_search_white"/>
        <com.bytedance.android.live.core.widget.LiveEditText
            android:textSize="15dp"
            android:textColor="#161823"
            android:textColorHint="#99161823"
            android:gravity="start|center_vertical"
            android:id="@+id/search_et"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:hint="@string/ttlive_please_input_search_keyword_2"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/ttlive_search_legacy_cursor_white_drawable"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_search"
            app:layout_constraintRight_toLeftOf="@+id/btn_clear"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/btn_clear"
            android:background="@drawable/ttlive_ic_search_legacy_ic_clear_keyword_white"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
