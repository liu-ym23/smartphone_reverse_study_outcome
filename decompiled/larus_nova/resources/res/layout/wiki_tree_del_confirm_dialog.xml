<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/ud_N100">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/LarkCCM_Workspace_DeletePage_ConfirmScope"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_caption"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:text="@string/LarkCCM_NewCM_DeletedItemsGoToTrash_DayVar_Desc"
        android:layout_marginStart="@dimen/space_kit_len_20"
        android:layout_marginEnd="@dimen/space_kit_len_20"
        app:layout_constraintBottom_toTopOf="@+id/itemLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
        android:id="@+id/itemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_16"
        app:itemBackgroundColor="@color/bg_float"
        app:layout_constraintTop_toBottomOf="@+id/description">
        <com.bytedance.ee.bear.widgets.SelectItemView
            android:id="@+id/deleteCurrentOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:description="@string/LarkCCM_Workspace_DeletePage_WithSub_Descrip"
            app:layout_constraintTop_toBottomOf="@+id/description"
            app:showBottomDivider="false"
            app:subtitleMarginTop="8dp"
            app:title="@string/LarkCCM_Workspace_DeletePage_CurrentOnly_Radio"/>
        <com.bytedance.ee.bear.widgets.SelectItemView
            android:id="@+id/deleteWithSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:description="@string/CreationMobile_Common_DeleteOthersPage"
            app:layout_constraintTop_toBottomOf="@+id/singePageItem"
            app:showBottomDivider="false"
            app:subtitleMarginTop="8dp"
            app:title="@string/LarkCCM_Workspace_DeletePage_WithSub_Radio"/>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="17sp"
        android:textColor="@color/ud_N900"
        android:id="@+id/cancel"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/LarkCCM_Workspace_DeletePage_Cancel_Button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/confirm"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemLayout"
        app:ud_backgroundColor="@color/udtoken_component_outlined_bg"
        app:ud_radius="m"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"
        style="@style/UDButton.Small.Primary"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="17sp"
        android:textColor="@color/static_white"
        android:id="@+id/confirm"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/LarkCCM_Workspace_DeletePage_Delete_Button"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/cancel"
        app:layout_constraintTop_toBottomOf="@+id/itemLayout"
        app:ud_backgroundColor="@color/ud_button_red_bg"
        app:ud_radius="m"
        style="@style/UDButton.Small.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
