<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.livecommerce.room.widgets.promotion_card.refactor.widget.ExplainCardInfoLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_promotion_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ec_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/tv_promotion_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="14dp"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
        <com.bytedance.android.livesdk.livecommerce.room.widgets.promotion_card.refactor.widget.InfoSubTitleView
            android:textSize="10dp"
            android:textColor="@color/ec_color_FE2C55"
            android:gravity="center_vertical"
            android:id="@+id/tv_promotion_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <FrameLayout
            android:id="@+id/layout_rittag_container"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">
            <include
                android:id="@+id/layout_rittag_line1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                layout="@layout/ec_explain_card_uimodule_info_rittag_line"/>
            <include
                android:id="@+id/layout_rittag_line2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                layout="@layout/ec_explain_card_uimodule_info_rittag_line"/>
        </FrameLayout>
    </LinearLayout>
</com.bytedance.android.livesdk.livecommerce.room.widgets.promotion_card.refactor.widget.ExplainCardInfoLayout>
