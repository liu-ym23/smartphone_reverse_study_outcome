<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <FrameLayout
        android:id="@+id/bank_icon_layout"
        android:layout_width="@dimen/cj_pay_padding_24"
        android:layout_height="@dimen/cj_pay_padding_24"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/bank_card_icon"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"/>
        <ImageView
            android:id="@+id/bank_card_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bank_card_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/bank_card_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/bank_card_recommend_mark_tv"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_8"
            android:text="@string/cj_pay_recommend_way"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
        android:id="@+id/bank_card_select_checkbox"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:CJPayEnableBgDrawable="@drawable/cj_pay_icon_check_box_pressed2"
        app:CJPayUnenbleBgDrawable="@drawable/cj_pay_icon_check_box_normal2"
        app:CJPayWithCircleWhenUnchecked="true"/>
</RelativeLayout>
