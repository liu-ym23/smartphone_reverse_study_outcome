<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/page_btm_bar"
    android:layout_width="match_parent"
    android:layout_height="49dp"
    android:layout_marginBottom="4dp"
    app:layout_constraintBottom_toBottomOf="parent">
    <View
        android:background="@color/aos_picture_btm_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/photos_flow_bottom_action_layout_container_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/photos_flow_bottom_action_layout_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/photos_flow_bottom_action_layout_container"
        android:paddingLeft="4dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="12dp"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_comment"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_like"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/aos_pd_slides_like_selector"
                android:scaleType="fitCenter"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="12dp"
                android:textColor="@color/aos_text_primary_light"
                android:layout_gravity="center"
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_collect"
            app:layout_constraintStart_toEndOf="@+id/ll_like"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_comment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/aos_pd_slides_ic_comment"
                android:scaleType="fitCenter"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="12dp"
                android:textColor="@color/aos_text_primary_light"
                android:layout_gravity="center"
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_collect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_share"
            app:layout_constraintStart_toEndOf="@+id/ll_comment"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_collect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/aos_pd_slides_collect_selector"
                android:scaleType="fitCenter"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="12dp"
                android:textColor="@color/aos_text_primary_light"
                android:layout_gravity="center"
                android:id="@+id/tv_collect_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/ll_collect"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/aos_pd_slides_share"
                android:scaleType="fitCenter"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="12dp"
                android:textColor="@color/aos_text_primary_light"
                android:layout_gravity="center"
                android:id="@+id/tv_share_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/aos_text_primary2"
        android:textColorHint="@color/aos_text_primary2"
        android:gravity="start|center_vertical"
        android:id="@+id/et_input"
        android:background="@drawable/aos_slides_comment_input_bg"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="2dp"
        android:minWidth="127dp"
        android:text="@string/slides_comment_input_bar_hint"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="flagNoFullscreen"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/photos_flow_bottom_action_layout_container"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
