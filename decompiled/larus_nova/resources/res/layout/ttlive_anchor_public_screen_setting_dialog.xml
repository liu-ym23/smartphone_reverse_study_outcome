<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_anchor_public_screen_setting_dialog"
    android:layout_width="match_parent"
    android:layout_height="484dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/ttlive_ps_config"/>
    <com.bytedance.android.livesdk.widget.MaxHeightScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="432dp"
        app:maxHeight="432dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="432dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#99161823"
                android:gravity="center"
                android:id="@+id/basic_setting_title"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_basic_config"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_basic_settings"
                android:background="@drawable/ttlive_bg_anchor_public_screen_setting_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#99161823"
                android:gravity="center"
                android:id="@+id/interactivity_settings_title"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_interactivity_config"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_interactivity_settings"
                android:background="@drawable/ttlive_bg_anchor_public_screen_setting_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"/>
        </LinearLayout>
    </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
</LinearLayout>
