<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/item_number"
        android:background="#ff0000"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_hybrid_item_number"
        android:maxLines="1"/>
    <TextView
        android:textSize="@dimen/item_text_size"
        android:ellipsize="end"
        android:id="@+id/out_scheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="@string/ttlive_hybrid_out_scheme"
        android:maxLines="1"
        android:layout_toRightOf="@+id/item_number"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_origion_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/out_scheme">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/item_text_size"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_hybrid_host"
                android:maxLines="5"/>
            <TextView
                android:textSize="@dimen/item_text_size"
                android:id="@+id/origin_sub_url_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="5"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/item_text_size"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_hybrid_path"
                android:maxLines="5"/>
            <TextView
                android:textSize="@dimen/item_text_size"
                android:id="@+id/origin_sub_url_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="5"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/item_text_size"
        android:id="@+id/maped_sub_url"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="30dp"
        android:text="@string/ttlive_hybrid_history_url"
        android:maxLines="5"
        android:layout_below="@+id/ll_origion_url"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/ll_origion_url">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/ll_origion_url">
            <Button
                android:textSize="16dp"
                android:id="@+id/full_scheme_btn"
                android:text="@string/ttlive_hybrid_full"
                android:layout_centerVertical="true"
                style="@style/ttlive_debug_button"/>
            <TextView
                android:textSize="16dp"
                android:id="@+id/mapping_config"
                android:background="@color/gray"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_hybrid_mapping"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <Button
                android:id="@+id/copy_url"
                android:text="@string/ttlive_hybrid_copy"
                android:layout_centerVertical="true"
                style="@style/ttlive_debug_button"/>
            <Button
                android:id="@+id/open_local_debug_page"
                android:text="@string/ttlive_hybrid_local_debug"
                style="@style/ttlive_debug_button"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <Button
                android:id="@+id/open_debug_page"
                android:text="@string/ttlive_hybrid_open_debug_page"
                style="@style/ttlive_debug_button"/>
            <Button
                android:id="@+id/send_to_user"
                android:text="@string/ttlive_hybrid_send_to_lark"
                style="@style/ttlive_debug_button"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
