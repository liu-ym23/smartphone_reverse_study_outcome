<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/detail_task_list_item_container"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_4"
    android:layout_marginBottom="@dimen/dp_4">
    <com.larksuite.component.blockit.hashtag.widget.SwipeLayout
        android:id="@+id/task_list_item_swipelayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="right"
            android:id="@+id/behind_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center">
            <RelativeLayout
                android:id="@+id/behind_delete_view"
                android:background="@drawable/todo_bg_list_backend_red_corner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/behind_delete_view_image"
                        android:layout_width="20sp"
                        android:layout_height="20sp"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:tint="@color/static_white"
                        app:srcCompat="@drawable/ud_icon_delete_trash_outlined"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/static_white"
                        android:id="@+id/behind_delete_view_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_4"
                        android:layout_marginRight="@dimen/dp_20"
                        android:text="@string/Todo_common_Delete"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/subtask_content_container"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/first_icon"
                    android:visibility="gone"
                    android:layout_width="16sp"
                    android:layout_height="16sp"
                    android:tint="@color/icon_n3"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"
                    app:srcCompat="@drawable/ud_icon_tasklist_outlined"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="@dimen/dp_16">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_title"
                        android:id="@+id/container_tv"
                        android:background="@drawable/todo_detail_task_list_container_bg"
                        android:padding="@dimen/dp_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="170dp"
                        android:text="@string/Todo_TaskList_UntitledList_Title"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_title"
                        android:id="@+id/section_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Todo_New_Section_NoSection_Title"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_6"
                        android:layout_marginStart="@dimen/dp_16"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </com.larksuite.component.blockit.hashtag.widget.SwipeLayout>
</LinearLayout>
