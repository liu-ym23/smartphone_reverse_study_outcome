<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/record_setting_replay_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/replay_setting_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pre_setting_replay_enable"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/replay_setting_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            app:lsb_background="@color/ttlive_prelive_setting_switch_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/record_setting_record_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="77dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/record_setting_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pre_setting_record_enable"
            android:includeFontPadding="false"
            android:layout_weight="1"
            app:layout_constraintBottom_toTopOf="@+id/record_setting_title_tips_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_prelive_setting_tips"
            android:id="@+id/record_setting_title_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_live_pre_setting_record_enable_tips"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/record_setting_title_tv"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/record_setting_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lsb_background="@color/ttlive_prelive_setting_switch_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/anchor_backtrack_setting_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="77dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/anchor_backtrack_setting_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_backtrack_pre_setting_title"
            android:includeFontPadding="false"
            android:layout_weight="1"
            app:layout_constraintBottom_toTopOf="@+id/anchor_backtrack_setting_tips_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_prelive_setting_tips"
            android:id="@+id/anchor_backtrack_setting_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_anchor_backtrack_pre_setting_tips"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/anchor_backtrack_setting_title_tv"/>
        <View
            android:id="@+id/anchor_backtrack_setting_dot_view"
            android:background="@drawable/ttlive_ic_setting_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintBottom_toTopOf="@+id/anchor_backtrack_setting_title_tv"
            app:layout_constraintStart_toEndOf="@+id/anchor_backtrack_setting_title_tv"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:id="@+id/anchor_backtrack_setting_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:text="@string/ttlive_live_pre_setting_gift_enable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lsb_background="@color/ttlive_prelive_setting_switch_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_setting_paid_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/live_paid_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_live_pre_setting_paid_setting"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/live_paid_dot"
            android:background="@drawable/ttlive_ic_setting_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintBottom_toTopOf="@+id/live_paid_title"
            app:layout_constraintStart_toEndOf="@+id/live_paid_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_prelive_setting_tips"
            android:id="@+id/live_paid_desc"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pre_setting_paid_setting_intro"
            android:drawableRight="@drawable/ttlive_ic_forenotice_entry_arrow"
            android:drawablePadding="8dp"
            android:drawableEnd="@drawable/ttlive_ic_forenotice_entry_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/prelive_synchronize_layout"
        android:background="@color/transparent"
        android:paddingTop="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/prelive_synchronize_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pre_setting_sync_live_enable"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/prelive_synchronize_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            app:lsb_background="@color/ttlive_prelive_setting_switch_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="@color/transparent"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_setting_comment_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/live_comment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_live_pre_enable_comment_control"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/live_comment_dot"
            android:background="@drawable/ttlive_ic_setting_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintBottom_toTopOf="@+id/live_comment_title"
            app:layout_constraintStart_toEndOf="@+id/live_comment_title"/>
        <ImageView
            android:id="@+id/live_comment_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_ic_forenotice_entry_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_setting_key_info_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_prelive_setting_txt"
            android:gravity="start|center_vertical"
            android:id="@+id/live_key_info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_live_pre_enable_key_info_control"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/live_key_info_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_ic_forenotice_entry_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
