<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/docs_bg_top_round_conner_color_bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <View
        android:layout_gravity="center"
        android:background="@drawable/facade_dragview_handler"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/count_down_time_view_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dialog_icon_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/dialog_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_centerInParent="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dialog_icon_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
        </RelativeLayout>
        <View
            android:id="@+id/countdown_divider"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toBottomOf="@+id/countdown_header"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/synced_source_view_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
