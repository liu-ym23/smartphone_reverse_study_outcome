<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:placeholderImage="@drawable/ttlive_feed_cover_loading"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="@dimen/ttlive_dimen_feed_img_corner_radius"/>
    <View
        android:background="@drawable/ttlive_bg_recommend_live_feed_item"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignLeft="@+id/live_cover"
        android:layout_alignRight="@+id/live_cover"
        android:layout_alignBottom="@+id/live_cover"
        android:layout_alignStart="@+id/live_cover"
        android:layout_alignEnd="@+id/live_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_room_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_marginTop="@dimen/ttlive_feed_live_lable_margin_top"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_alignParentStart="true"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="false"
        app:roundedCornerRadius="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:background="@drawable/ttlive_douyin_official_landscape_bottom_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/locate"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_feed_mars"
            android:singleLine="true"
            android:layout_marginStart="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="6dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="80dp"
                android:layout_height="20dp"
                android:singleLine="true"/>
            <View
                android:id="@+id/weight_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ttlive_ic_people"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <com.bytedance.android.live.core.widget.CustomFontTextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_hs_s5_50"
                android:gravity="center_vertical"
                android:id="@+id/audience_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/ttlive_feed_live_feed_count_0"
                android:singleLine="true"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
