<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/shadow_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ux_shadow_color="#26000000"
    app:ux_shadow_offset_x="0dp"
    app:ux_shadow_offset_y="4dp"
    app:ux_shadow_radius="17dp"
    app:ux_shadow_size="14dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card"
        android:background="@drawable/larus_bg_interaction_panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:outlineProvider="background">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_container"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/environment_row"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/environment_icon_container"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/environment_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"/>
                </FrameLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="?attr/larus_neutral_70"
                    android:id="@+id/environment_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    app:lineHeight="22dp"/>
            </LinearLayout>
            <Space
                android:id="@+id/environment_text_gap"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17sp"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/title_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                app:lineHeight="24dp"/>
            <Space
                android:id="@+id/title_description_gap"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
            <ScrollView
                android:id="@+id/content_scroll"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/scroll_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="?attr/larus_neutral_100"
                        android:id="@+id/description_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:alpha="0.35"
                        android:fontFamily="monospace"
                        app:lineHeight="24dp"/>
                    <Space
                        android:id="@+id/folder_gap"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/folder_row"
                        android:background="@drawable/larus_bg_interaction_folder_row"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/larus_ic_interaction_folder_blue"
                            android:layout_marginEnd="10dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16sp"
                            android:textColor="?attr/larus_neutral_100"
                            android:ellipsize="end"
                            android:id="@+id/folder_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif-medium"
                            app:lineHeight="24dp"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
        <View
            android:id="@+id/button_divider"
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_group"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/larus_interaction_quick_reply_button_gap"
            android:showDividers="middle"/>
    </LinearLayout>
</com.larus.common_ui.widget.ShadowLayout>
