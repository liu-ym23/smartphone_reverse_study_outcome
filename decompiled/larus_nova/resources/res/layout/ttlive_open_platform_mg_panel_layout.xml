<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_preview_mg_dialog_root"
    android:background="@drawable/ttlive_bg_minigame_bottom_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_width="match_parent"
        android:layout_height="325dp"
        android:scaleType="fitXY"
        app:actualImageResource="@drawable/ttlive_preview_mg_bottom_dialog_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="12dp"/>
    <ImageView
        android:id="@+id/close_dialog_ic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ttlive_preview_mg_close_dark"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_open_platform_mg_promote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:id="@+id/exit_mount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_open_platform_mg_exit_mount"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_data_ll"
        android:background="@drawable/ttlive_bg_white_radius_4"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#e5000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_open_platform_mg_live_data"
            android:layout_marginStart="20dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="17sp"
                    android:textColor="#e5161823"
                    android:id="@+id/show_count_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="-"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_open_platform_mg_live_show_count"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="17sp"
                    android:textColor="#e5161823"
                    android:id="@+id/click_count_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="-"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_open_platform_mg_live_click_count"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="17sp"
                    android:textColor="#e5161823"
                    android:id="@+id/play_count_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="-"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_open_platform_mg_live_play_count"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:background="@drawable/ttlive_bg_white_radius_4"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_data_ll">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/game_info_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="4dp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/speaking_card_tv"
            android:background="@drawable/ttlive_bg_mg_anchor_card_speaking"
            android:paddingLeft="15dp"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="17dp"
            android:text="@string/ttlive_open_platform_mg_card_explaining"
            android:drawableLeft="@drawable/ttlive_mg_anchor_speaking_card"
            android:drawablePadding="2dp"
            android:layout_alignBottom="@+id/game_info_icon"
            android:drawableStart="@drawable/ttlive_mg_anchor_speaking_card"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/game_info_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/game_info_icon"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/game_info_icon"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:id="@+id/game_info_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_below="@+id/game_info_name"
            android:layout_alignLeft="@+id/game_info_name"
            android:layout_alignStart="@+id/game_info_name"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/speak_card_btn"
            android:background="@drawable/ttlive_bg_mg_anchor_card_confirm_btn"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_open_platform_mg_card_explain"
            android:layout_below="@+id/game_info_summary"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:textSize="13sp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/lottery_btn"
            android:background="@drawable/ttlive_bg_mg_anchor_card_lottery_btn"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="28dp"
            android:text="@string/ttlive_open_platform_mg_card_lottery"
            android:layout_alignTop="@+id/speak_card_btn"
            android:layout_alignBottom="@+id/speak_card_btn"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/speak_card_btn"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
