<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:id="@+id/shadowLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/UDShadow.S4.Up">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topBar"
        android:background="@drawable/facade_round_top_xxl"
        android:paddingTop="@dimen/space_kit_len_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:backgroundTint="@color/bg_float_base">
        <FrameLayout
            android:id="@+id/dragHandlerContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/lineDragHandler"
                android:background="@drawable/facade_dragview_handler"
                android:layout_width="@dimen/space_kit_len_40"
                android:layout_height="@dimen/space_kit_len_4"
                android:layout_marginTop="@dimen/space_kit_len_4"
                android:layout_marginBottom="@dimen/space_kit_len_4"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/downArrowDragHandler"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ud_icon_vc_toolbar_down_filled"
                android:tint="@color/icon_disable"/>
        </FrameLayout>
        <com.bytedance.ee.bear.widgets.panel.PanelTitleBarContainer
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_44"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/titleBarV2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textSize="@dimen/space_kit_font_17"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/titleTvV2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="16sp"
                android:textColor="@color/function_info_content_default"
                android:gravity="right"
                android:id="@+id/rightButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
