<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_popup_interact_apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_ic_audience_guest_no_bg"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="@string/ttlive_interact_icon_opt_pop_title"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/apply_tv"
            android:background="@drawable/ttlive_bg_view_popup_interact_apply_btn"
            android:layout_width="52dp"
            android:layout_height="24dp"
            android:text="@string/ttlive_interact_icon_opt_pop_btn"/>
    </LinearLayout>
    <ImageView
        android:background="@drawable/ttlive_bg_popup_interact_apply_triangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="75dp"
        android:layout_marginTop="38dp"/>
</RelativeLayout>
