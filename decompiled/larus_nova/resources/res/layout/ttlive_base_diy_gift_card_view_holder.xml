<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/ttlive_base_diy_gift_card_bg"
        android:layout_width="97dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:id="@+id/main_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="4dp"
            android:text=""
            android:alpha="0.8"
            android:layout_marginStart="7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:id="@+id/sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:alpha="0.4"
            app:layout_constraintStart_toStartOf="@+id/main_text"
            app:layout_constraintTop_toBottomOf="@+id/main_text"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/diy_icon"
            android:layout_width="43dp"
            android:layout_height="43dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:id="@+id/card_time_text"
            android:background="@drawable/ttlive_base_custom_gift_time_bg"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="10.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/remind_dot"
            android:background="@drawable/ttlive_base_gift_custom_card_remind_dot"
            android:visibility="gone"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/diy_lock_icon"
            android:background="@drawable/ttlive_custom_gift_lock_icon"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="11dp"
            android:layout_marginBottom="16dp"
            android:alpha="1"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toBottomOf="@+id/diy_icon"
            app:layout_constraintEnd_toEndOf="@+id/diy_icon"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/selected_view"
            android:background="@drawable/ttlive_gift_buff_card_selected"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
