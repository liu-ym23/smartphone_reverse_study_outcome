<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_iron_promotion_item_rootview"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <com.bytedance.android.ec.core.widget.ECConstrainLayout
        android:id="@+id/iron_promotion_item_rootview"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/fl_top_module"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemImageAreaModule
            android:id="@+id/liiam_image_container"
            android:clipChildren="false"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_top_module"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/liiam_image_container"
            app:layout_constraintTop_toTopOf="@+id/liiam_image_container"
            style="@style/font_size_28"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemInfoWidgetContainer
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_first_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"/>
            <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemInfoWidgetContainer
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_second_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:importantForAccessibility="noHideDescendants"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemPriceAreaModule
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/container_price_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:paddingEnd="6dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/libm_shop_cart_and_buy"
            app:layout_constraintEnd_toStartOf="@+id/libm_shop_cart_and_buy"
            app:layout_constraintStart_toStartOf="@+id/tv_title"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemButtonModule
            android:orientation="horizontal"
            android:id="@+id/libm_shop_cart_and_buy"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/liiam_image_container"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemBottomModule
            android:orientation="vertical"
            android:id="@+id/libm_bottom_module"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/liiam_image_container"/>
        <ImageView
            android:id="@+id/iv_promotion_card_close"
            android:paddingLeft="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ec_common_ic_playback_promotion_card_close"
            android:contentDescription="@string/ec_close_button"
            android:paddingStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.ec.core.widget.ECConstrainLayout>
    <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemGuideModule
        android:id="@+id/ligm_promotion_guide"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iron_promotion_item_rootview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemBottomBlockView
        android:id="@+id/libbm_bottom_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iron_promotion_item_rootview"/>
    <com.bytedance.android.livesdk.livecommerce.promotion.card.module.ListItemBottomCarryNewView
        android:id="@+id/list_bottom_carry_module"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/libbm_bottom_block"/>
</androidx.constraintlayout.widget.ConstraintLayout>
