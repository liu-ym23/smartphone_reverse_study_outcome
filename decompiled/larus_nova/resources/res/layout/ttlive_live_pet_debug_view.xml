<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Button
        android:id="@+id/debug_view_toggle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="10dp"
        android:minHeight="10dp"
        android:text="DBG"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/debug_view"
        android:background="#33000000"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="LivePet Debug View"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <GridLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:id="@+id/btn_load_uri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载URI"/>
            <Button
                android:id="@+id/btn_show_hide_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显隐容器"/>
            <Button
                android:id="@+id/btn_unload_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卸载容器"/>
            <Button
                android:id="@+id/btn_shake_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晃动容器"/>
            <Button
                android:id="@+id/btn_show_safe_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="安全区域"/>
            <Button
                android:id="@+id/btn_show_link_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连线区域"/>
            <Button
                android:id="@+id/btn_check_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测资源"/>
            <Button
                android:id="@+id/btn_delete_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除资源"/>
            <Button
                android:id="@+id/btn_capture_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="画面拍照"/>
        </GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
