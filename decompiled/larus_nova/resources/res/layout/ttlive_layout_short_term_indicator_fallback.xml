<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.view.InterceptTouchHorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/short_term_indicator_scroll_view"
    android:scrollbars="none"
    android:fadingEdgeLength="10dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:requiresFadingEdge="horizontal"
    android:importantForAccessibility="no">
    <com.bytedance.android.livesdk.chatroom.view.ShortTermFrameLayout
        android:orientation="horizontal"
        android:id="@+id/short_term_icon_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</com.bytedance.android.livesdk.chatroom.view.InterceptTouchHorizontalScrollView>
