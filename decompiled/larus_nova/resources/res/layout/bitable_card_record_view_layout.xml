<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/commentGuideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="13dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/topGuideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.card.record.cover.CardCoverView
        android:id="@+id/cardCoverView"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginRight="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/cardTitle"
        app:layout_constraintTop_toTopOf="@+id/topGuideline"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.card.record.title.CardTitleView
        android:id="@+id/cardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layout_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/cardCoverView"
        app:layout_constraintRight_toLeftOf="@+id/cardComment"
        app:layout_constraintTop_toTopOf="@+id/topGuideline"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.CommentView
        android:id="@+id/cardComment"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="-3dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/commentGuideline"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.card.record.title.CardSubTitleView
        android:id="@+id/cardSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/cardTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardTitle"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.card.record.cell.CardFieldCellListView
        android:id="@+id/cardTableView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        app:layout_constraintLeft_toLeftOf="@+id/cardTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardSubTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
