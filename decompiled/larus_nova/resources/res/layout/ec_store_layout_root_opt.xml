<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_store_root_fold_adapt_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ec.store.view.ECShopRootFrameLayout
        android:id="@+id/ec_store_root_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.store.home.view.MoveDelegateFrameLayout
            android:id="@+id/ec_store_live_container_lowest"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="415dp"/>
        <FrameLayout
            android:id="@+id/ec_store_background_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/ec_store_background_container_brand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/shop_live_tab_container"
            android:background="@color/ec_store_tab_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/shop_tab_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/ec_store_top_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/ec_store_coordinator_layout"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <View
                    android:id="@+id/ec_shop_click_for_finish_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.bytedance.android.shopping.store.home.view.TopSheetLayout
                    android:id="@+id/ec_store_content_container"
                    android:paddingTop="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="com.bytedance.android.shopping.store.tabkit.container.TabKitBottomSheetBehavior">
                    <FrameLayout
                        android:id="@+id/ec_store_content_top_container"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:layout_gravity="top"
                            android:id="@+id/ec_store_collapsing_layout_promotion_background_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_collapseMode="none"/>
                        <LinearLayout
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:id="@+id/ec_store_collapsing_layout_inner_container"
                            android:tag="unpinned"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0dp"
                            app:layout_collapseMode="none">
                            <com.bytedance.android.shopping.store.home.view.ECStoreHeaderFrameLayout
                                android:id="@+id/ec_store_info_group_area_container"
                                android:tag="ecStoreInfoGroupArea"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <FrameLayout
                                android:orientation="vertical"
                                android:id="@+id/ec_shop_lynx_card_container"
                                android:focusable="true"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>
                    <com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout
                        android:id="@+id/ec_store_tab_fold_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ec_store_controllable_view_pager_wrapper"
                            android:background="@color/ec_store_root_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_behavior="com.bytedance.android.shopping.store.tabkit.container.TabKitBottomSheetBehavior">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                                    android:layout_gravity="top"
                                    android:id="@+id/ec_store_tab_background_mask_image"
                                    android:focusable="false"
                                    android:visibility="gone"
                                    android:clickable="false"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:importantForAccessibility="no"
                                    app:actualImageScaleType="fitXY"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <com.bytedance.android.ec.store.product.widget.ECStoreTabLayout
                                        android:id="@+id/ec_store_tab_layout_top_brand"
                                        android:visibility="gone"
                                        android:fadingEdgeLength="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginLeft="4dp"
                                        android:layout_marginTop="5dp"
                                        android:requiresFadingEdge="horizontal"
                                        android:layout_marginStart="4dp"
                                        app:tabGravity="center"
                                        app:tabIndicator="@drawable/ec_store_top_bar_indicator_white"
                                        app:tabIndicatorColor="@color/transparent"
                                        app:tabIndicatorHeight="2dp"
                                        app:tabMinWidth="0dp"
                                        app:tabMode="scrollable"
                                        app:tabPaddingEnd="0dp"
                                        app:tabPaddingStart="0dp"
                                        app:tabRippleColor="@color/transparent"/>
                                    <com.bytedance.android.shopping.store.tabkit.view.ScrollableViewPager
                                        android:id="@+id/ec_tabkit_fragment_view_pager"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:overScrollMode="never"
                                        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                                </LinearLayout>
                                <FrameLayout
                                    android:id="@+id/ec_store_tab_status_view"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                            </FrameLayout>
                        </LinearLayout>
                    </com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout>
                </com.bytedance.android.shopping.store.home.view.TopSheetLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/ec_store_root_tab_bar_container"
            android:paddingTop="0.5dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ec_store_root_tab_bar_container_height">
            <com.bytedance.android.ec.store.product.widget.StoreMixTabLayout
                android:layout_gravity="bottom"
                android:id="@+id/ec_tabkit_bottom_bar_tab_layout"
                android:paddingTop="0.5dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scene="shop"
                app:tabIndicator="@null"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ec_store_tips_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/ec_store_float_cart_entry_container"
            android:layout_width="wrap_content"
            android:layout_height="64sp"
            android:layout_marginBottom="150sp"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/ec_store_float_go_top_container"
            android:layout_width="64sp"
            android:layout_height="64sp"
            android:layout_marginBottom="86sp"/>
        <com.bytedance.android.shopping.store.home.view.MovableFrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/ec_store_float_live_indicator_container"
            android:layout_width="48sp"
            android:layout_height="58sp"
            android:layout_marginRight="8sp"
            android:layout_marginBottom="334sp"/>
        <FrameLayout
            android:id="@+id/ec_store_float_marquee_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="141dp"
            android:layout_marginStart="8dp"/>
        <FrameLayout
            android:id="@+id/ec_store_status_view_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ec_store_watermark"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/shop_container_for_animation"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="4dp"/>
    </com.bytedance.android.ec.store.view.ECShopRootFrameLayout>
</com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout>
