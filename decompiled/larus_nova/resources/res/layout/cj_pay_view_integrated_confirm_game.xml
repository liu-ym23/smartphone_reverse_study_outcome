<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cj_pay_view_payment_confirm_dialog_root_view"
        android:background="@drawable/cj_pay_integrated_bg_dialog"
        android:layout_width="@dimen/cj_pay_height_319"
        android:layout_height="@dimen/cj_pay_height_320"
        android:layout_centerInParent="true">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <RelativeLayout
            android:id="@+id/cj_pay_total_value_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_7"
            android:layout_marginBottom="@dimen/cj_pay_padding_5"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_42"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/cj_pay_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cj_pay_padding_5"
                android:includeFontPadding="false"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_22"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/cj_pay_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/cj_pay_padding_2"
                android:layout_marginBottom="@dimen/cj_pay_padding_11"
                android:text="@string/cj_pay_currency_unit"
                android:layout_toLeftOf="@+id/cj_pay_total_value"
                android:layout_alignBottom="@+id/cj_pay_total_value"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textColor="@color/cj_pay_color_black_34"
                android:ellipsize="end"
                android:id="@+id/cj_pay_product_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_2"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_below="@+id/cj_pay_total_value"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cj_pay_payment_list_view"
            android:background="@color/cj_pay_color_trans"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/cj_pay_padding_68"
            android:divider="@color/cj_pay_color_trans"
            android:dividerHeight="0dp"
            android:layout_below="@+id/cj_pay_total_value_layout"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_confirm"
                android:background="@drawable/cj_pay_base_bg_red_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_confirm_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_20"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
        <com.android.ttcjpaysdk.base.ui.CJPayLoadingView
            android:id="@+id/cj_pay_activity_loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include layout="@layout/cj_pay_view_customer_service_layout"/>
    </RelativeLayout>
</RelativeLayout>
