<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_vip_emoji_template_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_vip_emoji_template_black"
        android:gravity="center"
        android:id="@+id/camera_method"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/vip_emoji_template_dialog_camera_method"/>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_vip_emoji_template_black"
        android:gravity="center"
        android:id="@+id/album_method"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/vip_emoji_template_dialog_album_method"/>
    <View
        android:background="#0a161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_vip_emoji_template_black"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="34dp"
        android:text="@string/vip_emoji_template_dialog_cancel"/>
</LinearLayout>
