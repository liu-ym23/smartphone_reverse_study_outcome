<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_dialog_inroom_user"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="236dp">
        <FrameLayout
            android:id="@+id/fl_audio"
            android:layout_width="match_parent"
            android:layout_height="92dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/img_name_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/view_num_bg"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:alpha="0.2"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:alpha="0.34"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_name"
                android:background="@drawable/ttlive_input_position_name_bg"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/ttlive_input_position_name_placeholder"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_video"
            android:visibility="gone"
            android:layout_width="92dp"
            android:layout_height="92dp">
            <View
                android:layout_gravity="center"
                android:id="@+id/view_num_bg_video"
                android:background="#626a9c"
                android:layout_width="92dp"
                android:layout_height="92dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_num_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:alpha="0.34"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:layout_gravity="end"
                android:id="@+id/tv_name_video"
                android:background="@drawable/ttlive_input_position_name_bg"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/ttlive_input_position_name_placeholder"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"/>
        </FrameLayout>
        <EditText
            android:textSize="15dp"
            android:textColor="#161823"
            android:textColorHint="#57161823"
            android:gravity="center_vertical"
            android:id="@+id/edt_name"
            android:background="@drawable/ttlive_bg_et_edit_reason"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:hint="@string/ttlive_input_position_name_hint"
            android:maxLength="4"
            android:paddingStart="12dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:background="@drawable/ttlive_bg_live_grey_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_confirm_decoration_text"/>
    </LinearLayout>
</ScrollView>
