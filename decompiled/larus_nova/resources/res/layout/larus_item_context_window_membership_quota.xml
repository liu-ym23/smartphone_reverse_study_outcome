<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="0dp"
    android:importantForAccessibility="yes">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/larus_dp_24">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/context_window_quota_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/context_window_quota_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_8"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="end"
            android:id="@+id/context_window_quota_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <com.larus.contextwindow.impl.ui.MembershipQuotaProgressView
        android:id="@+id/context_window_quota_progress"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_6"
        android:layout_marginTop="?attr/larus_dp_8"
        android:importantForAccessibility="no"/>
</LinearLayout>
