<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="102dp"
    android:layout_height="170dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/combo_arrow_effect_container"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="125dp"
        android:layout_marginBottom="4.5dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toTopOf="@+id/combo_bg"
        app:layout_constraintRight_toRightOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.newcombo.ComboProgressAnimationViewNew
        android:id="@+id/combo_progress"
        android:layout_width="102dp"
        android:layout_height="135dp"
        android:layout_marginBottom="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/background_wave_anim_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="114dp"
        android:layout_height="114dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/background_count_down_wave_anim_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="114dp"
        android:layout_height="114dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.newcombo.rareshopcombo.GiftRareShopComboWaveView
        android:layout_gravity="center"
        android:id="@+id/wave_anim_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/location_view"
        android:layout_width="86dp"
        android:layout_height="86dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/combo_bg"
        android:background="@drawable/ttlive_gift_rare_shop_combo_bg"
        android:visibility="gone"
        android:layout_width="86dp"
        android:layout_height="86dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/combo_bg_wave_anim_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/combo_bg_count_down_wave_anim_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/combo_title"
        android:background="@drawable/ttlive_gift_rare_shop_combo_single_click_desc"
        android:visibility="gone"
        android:layout_width="41dp"
        android:layout_height="18dp"
        android:layout_marginTop="34dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/long_combo_title"
        android:background="@drawable/ttlive_gift_rare_shop_combo_long_click_desc"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="36dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_0"
        android:background="@drawable/ttlive_gift_rare_shop_combo_count_down_0"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="24dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_1"
        android:background="@drawable/ttlive_gift_rare_shop_combo_count_down_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="24dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_2"
        android:background="@drawable/ttlive_gift_rare_shop_combo_count_down_2"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="24dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_3"
        android:background="@drawable/ttlive_gift_rare_shop_combo_count_down_3"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="24dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
