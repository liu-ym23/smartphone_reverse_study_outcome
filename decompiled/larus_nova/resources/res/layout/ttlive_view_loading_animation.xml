<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:frescro="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="90dp"
        android:layout_height="90dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/loading_anim_view"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_centerInParent="true"
            frescro:fadeDuration="0"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="12dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/loading_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_dialog_loading"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/loading_ellipsis_view"
                android:layout_width="30dp"
                android:layout_height="12dp"
                android:layout_toRightOf="@+id/loading_text_view"
                android:layout_alignParentBottom="true"
                android:layout_toEndOf="@+id/loading_text_view"
                frescro:actualImageScaleType="fitCenter"
                frescro:fadeDuration="0"/>
        </RelativeLayout>
    </RelativeLayout>
</merge>
