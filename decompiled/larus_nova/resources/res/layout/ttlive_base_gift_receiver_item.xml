<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="28dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/user_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="8dp"
        android:textColor="@color/ttlive_colorffffff_80"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_name"
        android:visibility="visible"
        android:layout_width="28dp"
        android:layout_height="10dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_avatar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="true"
        android:layout_width="28dp"
        android:layout_height="10dp"
        android:layout_marginTop="17.8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/status_label_container"
                android:background="@drawable/ttlive_base_receiver_status_label"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="6dp"
                    android:textColor="#e6ffffff"
                    android:gravity="center"
                    android:id="@+id/status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2.5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/status_label_container"
                    app:layout_constraintStart_toStartOf="@+id/status_label_container"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:gravity="center"
        android:id="@+id/gift_receiver_status_icon"
        android:layout_width="28dp"
        android:layout_height="10dp"
        android:layout_marginBottom="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintStart_toStartOf="@+id/user_avatar"/>
    <View
        android:id="@+id/select_view"
        android:background="@drawable/ttlive_base_receiver_select_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/all_mic_border"
        android:background="@drawable/ttlive_base_receiver_all_mic_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/gift_receiver_select_icon"
        android:visibility="gone"
        android:layout_width="10.5dp"
        android:layout_height="10.5dp"
        android:src="@drawable/ttlive_base_gift_receiver_select_tag"
        android:translationX="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
