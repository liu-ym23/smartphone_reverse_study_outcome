<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
        android:layout_gravity="bottom"
        android:id="@+id/dragView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:midHeightPercent="0.6"
        app:panel_background_color="@color/bg_float"
        app:panel_enable_drag="true"
        app:panel_left_text="@string/Bitable_Common_ButtonCancel"
        app:panel_left_text_color="@color/text_title"
        app:panel_menu_type="text"
        app:panel_right_text="@string/Bitable_Common_ButtonDone"
        app:panel_right_text_color="@color/primary_content_default"
        app:panel_show_divider="false"
        app:panel_show_drag_handler="true"
        app:panel_show_titlebar="true"/>
</FrameLayout>
