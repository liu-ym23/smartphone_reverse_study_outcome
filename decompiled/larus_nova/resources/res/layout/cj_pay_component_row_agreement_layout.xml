<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/cj_pay_component_row_agreement_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/cj_pay_text_secondary"
        android:id="@+id/cj_pay_component_row_agreement_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="10"
        android:layout_marginEnd="8dp"/>
    <View
        android:id="@+id/cj_pay_component_row_agreement_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.1"/>
    <LinearLayout
        android:gravity="top|right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="start|top"
            android:layout_gravity="top"
            android:id="@+id/cj_pay_component_row_tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp"
            android:layout_marginRight="4dp"/>
        <com.android.ttcjpaysdk.base.ui.component.CJSwitchView
            android:id="@+id/cj_pay_component_row_agreement_switch"
            android:layout_width="24dp"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            app:cjSwitchIsChecked="true"
            app:cjSwitchThumbDiameter="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:switchPadding="1dp"/>
    </LinearLayout>
</LinearLayout>
