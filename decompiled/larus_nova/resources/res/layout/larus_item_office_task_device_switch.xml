<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_54">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/office_task_device_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/office_task_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/office_task_device_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/office_task_device_status_dot"
        android:background="@drawable/larus_bg_office_task_device_online_dot"
        android:layout_width="?attr/larus_dp_6"
        android:layout_height="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/office_task_label"
        app:layout_constraintStart_toEndOf="@+id/office_task_label"
        app:layout_constraintTop_toTopOf="@+id/office_task_label"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/office_task_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/office_task_device_status_dot"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/office_task_device_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
