<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="37dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/head_left_img_dv"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layoutMode="width_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/head_center_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/head_left_img_dv"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="end"
        android:id="@+id/head_right_ll"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:minWidth="116dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/head_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/head_right_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/commerce_arrow_head_right_icon_coupon_divert"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
