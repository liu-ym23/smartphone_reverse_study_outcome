<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <EditText
        android:textSize="13sp"
        android:textColor="@color/TextPrimary"
        android:textColorHint="@color/TextQuaternary"
        android:gravity="center"
        android:id="@+id/start_input"
        android:background="@drawable/search_filter_normal_text_bg_border"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:hint="@string/search_filter_price_interval_min"
        android:layout_weight="1"
        android:inputType="numberDecimal"/>
    <View
        android:id="@+id/line"
        android:background="#c4c4c4"
        android:layout_width="16dp"
        android:layout_height="1dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"/>
    <EditText
        android:textSize="13sp"
        android:textColor="@color/TextPrimary"
        android:textColorHint="@color/TextQuaternary"
        android:gravity="center"
        android:id="@+id/end_input"
        android:background="@drawable/search_filter_normal_text_bg_border"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:hint="@string/search_filter_price_interval_max"
        android:layout_weight="1"
        android:inputType="numberDecimal"/>
</LinearLayout>
