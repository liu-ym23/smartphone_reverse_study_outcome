<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="#c0161823"
        android:id="@+id/to_user_fore_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/to_user_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/ttlive_talk_room_interact_emoji_dialog_title"
        app:layout_constraintBottom_toBottomOf="@+id/to_user_fore_tv"
        app:layout_constraintStart_toEndOf="@+id/to_user_fore_tv"
        app:layout_constraintTop_toTopOf="@+id/to_user_fore_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_action_list"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/to_user_tv"/>
    <View
        android:id="@+id/divider"
        android:background="#19000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_action_list"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/emoji_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_talk_room_emoji_dialog_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_emoji_list"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <View
        android:id="@+id/space_view"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#525252"
        android:gravity="center"
        android:id="@+id/empty_list_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text="@string/ttlive_talk_room_emoji_list_error_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/list_loading_webp_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
