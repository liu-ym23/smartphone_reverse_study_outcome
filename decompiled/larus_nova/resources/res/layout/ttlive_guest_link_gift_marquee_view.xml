<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_bg_guest_link_gift_marquee_view"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="20dp">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white_50"
        android:ellipsize="end"
        android:id="@+id/tv_from_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="45dp"
        android:maxLines="1"
        android:textAlignment="center"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#eca20f"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="给"
        android:maxLines="1"
        android:textAlignment="center"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white_50"
        android:ellipsize="end"
        android:id="@+id/tv_to_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="36dp"
        android:maxLines="1"
        android:textAlignment="center"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#eca20f"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="送出"
        android:maxLines="1"
        android:textAlignment="center"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#eca20f"
        android:ellipsize="end"
        android:id="@+id/tv_gift_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"/>
</LinearLayout>
