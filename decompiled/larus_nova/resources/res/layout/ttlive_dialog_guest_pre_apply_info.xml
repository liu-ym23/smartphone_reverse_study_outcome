<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/waiting_list_rlv"
        android:background="@color/ttlive_core_hs_w1"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:maxHeight="290dp"
        android:minHeight="290dp"
        app:layout_constraintBottom_toTopOf="@+id/waiting_user_info_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/waiting_list_empty_tips"
        android:layout_width="match_parent"
        android:layout_height="388dp"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:layout_width="180dp"
            android:layout_height="156dp"
            android:layout_marginTop="72dp">
            <View
                android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
                android:layout_width="match_parent"
                android:layout_height="120dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80161823"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/ttlive_apple_panel_nobody_in_waiting_list"/>
        </FrameLayout>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/waiting_user_info_layout"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginBottom="0dp"
        app:cardBackgroundColor="@color/ttlive_core_hs_w1"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="98dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_black_34"
                android:gravity="center"
                android:id="@+id/tv_current_position"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                app:actualImageScaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_current_position"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:maxLines="1"
                android:maxEms="7"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#161823"
                android:gravity="start"
                android:id="@+id/tv_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="17dp"
                android:layout_marginEnd="17dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
