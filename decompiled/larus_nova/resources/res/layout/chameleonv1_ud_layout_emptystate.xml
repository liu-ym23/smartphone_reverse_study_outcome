<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/ud_emptystate_padding_horizontal"
    android:paddingRight="@dimen/ud_emptystate_padding_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="245dp"
        android:layout_height="245dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:textAppearance="@style/chameleonv1_UDText.Headline"
        android:textColor="@color/text_title"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>
    <TextView
        android:textAppearance="@style/chameleonv1_UDText.Body2"
        android:textColor="@color/text_caption"
        android:gravity="center_horizontal"
        android:id="@+id/desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.larksuite.component.ud.button.UDButton
        android:textColor="@color/static_white"
        android:id="@+id/btnPrimary"
        android:visibility="gone"
        android:clickable="true"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        app:ud_backgroundColor="@color/chameleonv1_ud_button_blue_bg"
        app:ud_radius="m"
        style="@style/chameleonv1_UDButton.Middle.Primary"/>
    <com.larksuite.component.ud.button.UDButton
        android:textColor="@color/chameleonv1_ud_button_grey_text"
        android:id="@+id/btnSecondary"
        android:visibility="gone"
        android:clickable="true"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        app:ud_backgroundColor="@color/chameleonv1_ud_button_white_grey_bg"
        app:ud_radius="m"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"
        style="@style/chameleonv1_UDButton.Middle.Primary"/>
    <com.larksuite.component.ud.button.UDButton
        android:textColor="@color/chameleonv1_ud_button_blue_text"
        android:id="@+id/btnLink"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minWidth="0dp"
        android:maxLines="1"
        app:ud_backgroundColor="@color/chameleonv1_ud_button_text_primary_bg"
        style="@style/chameleonv1_UDButton.Middle.Primary"/>
</LinearLayout>
