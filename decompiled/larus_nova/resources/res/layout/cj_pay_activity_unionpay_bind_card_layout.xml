<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_unionpay_bind_card_layout"
    android:background="@color/cj_pay_color_gray_245"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cj_pay_titlebar_layout"
        layout="@layout/cj_pay_view_standard_titlebar_layout"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_bind_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_agreement_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_layout"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="22sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/bind_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_union_pay_select_bind_card"/>
            <LinearLayout
                android:id="@+id/ll_subtitle_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                    android:id="@+id/tv_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
                android:id="@+id/rv_bind_card"
                android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
                android:paddingLeft="16dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:overScrollMode="never"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.android.ttcjpaysdk.bindcard.base.view.CJPayAgreementView
        android:orientation="horizontal"
        android:id="@+id/cj_pay_agreement_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_next_step"
        app:layout_constraintTop_toBottomOf="@+id/sv_bind_card_content"/>
    <RelativeLayout
        android:id="@+id/layout_next_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_insurance_view"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_agreement_view">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/btn_next_step"
            android:background="@drawable/cj_pay_bg_red_btn_opacity_40"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:text="@string/cj_pay_agree_and_continue"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/iv_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="14dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:theme_type="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
