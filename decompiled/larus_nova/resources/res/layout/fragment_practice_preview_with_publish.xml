<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:id="@+id/content_region"
        android:background="#33ffffff"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_region"
        app:layout_constraintDimensionRatio="h,16:9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/st_topbar"
        app:ttlive_leftBottomRadius="12dp"
        app:ttlive_leftTopRadius="12dp"
        app:ttlive_rightBottomRadius="12dp"
        app:ttlive_rightTopRadius="12dp">
        <TextureView
            android:id="@+id/sf_preview_texture_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.ktv.common.view.PreviewProgressView
            android:id="@+id/preview_progress"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/preview_start_btn"
            android:background="@drawable/ttlive_solo_ktv_preview_play_ic"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toTopOf="@+id/preview_progress"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
    <FrameLayout
        android:id="@+id/bottom_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.live.soloktv.view.SoloKtvTopBar
        android:id="@+id/st_topbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_solo_ktv_preview_topbar_regin_heigh"
        android:layout_marginTop="@dimen/ttlive_solo_ktv_content_pading"
        app:layout_constraintTop_toTopOf="parent"
        app:rightMenuType="none"/>
    <com.bytedance.android.live.soloktv.view.FakeViewRoot
        android:id="@+id/fake_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
