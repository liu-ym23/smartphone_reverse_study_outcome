<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_intput_hint_container"
    android:background="@drawable/ttlive_search_legacy_bg_rectangle_lprimary"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/iv_search"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ttlive_ic_search_legacy_uikit_ic_searshbar_search"
        android:layout_marginStart="4dp"/>
    <com.bytedance.android.live.core.widget.LiveEditText
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:textColorHint="#59ffffff"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/et_search_kw"
        android:background="@null"
        android:paddingLeft="32.5dp"
        android:paddingRight="32.5dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:cursorVisible="false"
        android:singleLine="true"
        android:lineSpacingExtra="2dp"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/ttlive_search_legacy_cursor_drawable"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:paddingStart="32.5dp"
        android:paddingEnd="32.5dp"/>
    <ImageButton
        android:layout_gravity="end|center_vertical"
        android:id="@+id/btn_clear"
        android:background="@drawable/ttlive_ic_search_legacy_ic_clear_keyword"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/lv_search_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp">
        <ImageView
            android:textColor="#e6ffffff"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_ic_search_legacy_uikit_ic_searshbar_search"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#e6ffffff"
            android:id="@+id/tv_search_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_please_input_search_keyword"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
</FrameLayout>
