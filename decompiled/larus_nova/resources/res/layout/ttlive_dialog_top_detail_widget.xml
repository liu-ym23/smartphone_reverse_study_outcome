<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_detail_container"
    android:background="@drawable/ttlive_detail_button"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/top_detail_btn_sweep_webp"
        android:visibility="gone"
        android:layout_width="77dp"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_detail_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_gift_top_detail_color"
            android:gravity="center"
            android:id="@+id/top_detail_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/ttlive_honor_detail_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/detail_btn_dot"
            android:background="@drawable/ttlive_bg_gift_top_detail_dot"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"
            app:layout_constraintLeft_toRightOf="@+id/top_detail_btn"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_detail_btn"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_gift_top_detail_color"
            android:id="@+id/top_detail_award_btn"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/ttlive_honor_detail_text"
            app:layout_constraintBottom_toBottomOf="@+id/top_detail_btn"
            app:layout_constraintEnd_toEndOf="@+id/top_detail_btn"
            app:layout_constraintTop_toTopOf="@+id/top_detail_btn"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_gift_top_detail_color"
            android:id="@+id/top_detail_dynamic_text"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/top_detail_btn_sweep"
        android:visibility="gone"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:src="@drawable/ttlive_gift_top_detail_sweep"/>
</FrameLayout>
