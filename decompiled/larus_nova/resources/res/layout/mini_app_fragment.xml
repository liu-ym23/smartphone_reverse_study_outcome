<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/web_view_parent"
            android:background="@color/larus_base_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_56"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/title_bar_container"
            android:background="@color/mini_app_title_bar_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_32"
                    android:scaleType="centerInside"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.text.OTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/mini_app_title_bar_text_black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:singleLine="true"
                    android:maxLength="8"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ProgressBar
                android:id="@+id/progress_bar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_2"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/mini_app_progress_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
        </LinearLayout>
        <com.obric.miniapp.view.MiniAppActionBar
            android:layout_gravity="end"
            android:id="@+id/mini_action_bar"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_16"/>
        <com.bytedance.ai.view.input.FloatingSpeakerView
            android:layout_gravity="bottom"
            android:id="@+id/floating_speaker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:enable="false"/>
    </FrameLayout>
</LinearLayout>
