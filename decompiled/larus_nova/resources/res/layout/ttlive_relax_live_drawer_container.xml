<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/relax_drawer_shadow"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/relax_drawer_close_area"
        android:layout_width="12dp"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.drawer.LiveDrawerLayout
        android:id="@+id/relax_drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
            android:layout_gravity="end"
            android:id="@+id/relax_panel_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/relax_feed_back_bar"
                android:layout_width="17dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="52dp"
                    android:src="@drawable/ttlive_bar"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/relax_panel_background"
                android:background="#f3000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/relax_drawer_fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
    </com.bytedance.android.livesdk.drawer.LiveDrawerLayout>
</FrameLayout>
