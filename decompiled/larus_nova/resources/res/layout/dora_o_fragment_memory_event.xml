<?xml version="1.0" encoding="utf-8"?>
<com.larus.dora.o.impl.memory.OViewPager2FixLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.refresh.SuperSwipeRefreshLayout
        android:id="@+id/memory_event_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/memory_event_list"
                android:paddingBottom="?attr/larus_dp_24"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_secondary"
                android:layout_gravity="center"
                android:id="@+id/memory_event_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_environmental_data_event_empty_cn"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/memory_event_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_secondary"
                android:layout_gravity="center"
                android:id="@+id/memory_event_retry"
                android:padding="?attr/larus_dp_12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_o_memory_load_failed_retry"/>
        </FrameLayout>
    </com.larus.common_ui.refresh.SuperSwipeRefreshLayout>
</com.larus.dora.o.impl.memory.OViewPager2FixLayout>
