<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/popup_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/popup_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/popup_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.bytedance.ai.view.popup.anim.BottomSheetBehavior">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/popup_top_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ai.view.popup.RadiusLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/popup_inner_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/engine_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.ai.view.popup.RadiusLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
