<?xml version="1.0" encoding="utf-8"?>
<com.larus.photopicker.v2.impl.others.scale.ScaleGestureLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gesture_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <VideoView
        android:layout_gravity="center"
        android:id="@+id/preview_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/preview_video_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/preview_video_deleted"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/larus_tools_media_import_ic_video_delete"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/preview_video_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.larus.photopicker.v2.impl.others.scale.ScaleGestureLayout>
