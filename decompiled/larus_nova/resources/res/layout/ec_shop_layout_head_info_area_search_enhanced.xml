<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_shop_head_info_area"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:paddingEnd="4dp">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/iv_shop_user_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.RoundedFrameLayout
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="2dp"
            app:rounded_radius="16dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_shop_user"
                android:tag="scene_head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="@drawable/shape_shopping_shop_pic_foreground_38"
                app:roundAsCircle="true"
                app:roundedCornerRadius="16dp"/>
        </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
        <com.bytedance.android.ec.window.base.view.ECWindowLiveCircleView
            android:layout_gravity="center"
            android:id="@+id/iv_live_circle"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:live_strokeWidth="1dp"/>
        <FrameLayout
            android:layout_gravity="bottom|right"
            android:id="@+id/ec_window_info_area_follow_lottie_wrapper"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-4dp"
            android:layout_marginBottom="-4dp"
            android:translationZ="50dp"
            android:elevation="0dp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ec_window_info_area_follow_lottie_animation_view"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_shop_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp">
        <com.bytedance.android.ec.window.base.widget.BouncingMarqueeTextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_std_text_white_1"
            android:id="@+id/tv_shop_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="72dp"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/shopping_std_text_2"
            android:ellipsize="marquee"
            android:id="@+id/tv_sell_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="6"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="0"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_std_text_white_1"
            android:id="@+id/tv_name_right"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"/>
        <View
            android:id="@+id/view_enter"
            android:background="@drawable/ec_store_ic_round_right_arrow"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ec_shop_info_area_follow"
        android:background="@drawable/shape_shopping_shop_header_follow_background_18"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="28dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ec_shop_info_area_follow_button"
            android:tag="anchor_window_header_top_bar_follow"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ec_shop_info_area_follow_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ec_shop_follow_white"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/ec_shop_info_area_follow_text"
                android:paddingTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/ec_shop_info_area_fans_group"
            android:visibility="gone"
            android:layout_width="63dp"
            android:layout_height="28dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ec_shop_info_area_fans_group_icon"
                android:layout_width="26dp"
                android:layout_height="18dp"
                android:src="@drawable/ec_store_info_join_fans_group_image"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="@color/shopping_std_text_white_1"
                android:layout_gravity="center"
                android:id="@+id/ec_shop_info_area_fans_group_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
