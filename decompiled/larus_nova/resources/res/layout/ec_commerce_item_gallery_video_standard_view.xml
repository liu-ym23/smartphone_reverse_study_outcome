<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_item_gallery_video_player_block_compat_1915297013"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_video_cover"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/layout_video_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/view_bg_gradient"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_loading"
            android:visibility="gone"
            android:layout_width="92dp"
            android:layout_height="76dp">
            <com.bytedance.android.ec.core.widget.ECStatusView
                android:id="@+id/view_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载中"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btn_video_play_center"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ec_pdp_gallery_video_pause_center"
            android:scaleType="centerInside"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/layout_video_control"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.shopping.anchorv4.voavhs.headv2.gallery.vh.PdpGalleryVideoButtonView
                android:id="@+id/btn_video_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.headv2.gallery.vh.PdpGalleryVideoButtonView
                android:id="@+id/btn_more_video_handle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.headv2.gallery.vh.PdpGalleryVideoButtonView
                android:id="@+id/btn_video_audio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/btn_more_video_handle"
                app:layout_constraintEnd_toEndOf="@+id/btn_more_video_handle"
                app:layout_goneMarginBottom="0dp"
                app:layout_goneMarginEnd="8dp"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.headv2.item.video.VideoProgressBar
                android:id="@+id/video_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="66dp"
                android:layout_marginEnd="66dp"
                app:layout_constraintBottom_toBottomOf="@+id/btn_video_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btn_video_play"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.headv2.item.video.VideoProgressTextLayout
                android:id="@+id/video_progress_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="53dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/video_lynx_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
