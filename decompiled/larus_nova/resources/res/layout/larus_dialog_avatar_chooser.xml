<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/larus_bg_bottom_sheet_line"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="4dp"
        android:layout_marginTop="?attr/larus_dp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar_top_left"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_32"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/avatar_top_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.456"
        app:placeholderImage="@drawable/larus_bg_avatar_img4_top_left"
        app:roundBottomEnd="false"
        app:roundBottomStart="false"
        app:roundTopEnd="false"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <ImageView
        android:id="@+id/avatar_selected_icon_top_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_avatar_chooser_confirm"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_top_left"
        app:layout_constraintEnd_toEndOf="@+id/avatar_top_left"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar_top_right"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginStart="?attr/larus_dp_1"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_top_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_top_left"
        app:layout_constraintTop_toTopOf="@+id/avatar_top_left"
        app:layout_constraintWidth_percent="0.456"
        app:placeholderImage="@drawable/larus_bg_avatar_img4_top_right"
        app:roundBottomEnd="false"
        app:roundBottomStart="false"
        app:roundTopEnd="true"
        app:roundTopStart="false"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <ImageView
        android:id="@+id/avatar_selected_icon_top_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_avatar_chooser_confirm"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_top_right"
        app:layout_constraintEnd_toEndOf="@+id/avatar_top_right"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar_bottom_left"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_1"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/avatar_top_left"
        app:layout_constraintStart_toStartOf="@+id/avatar_top_left"
        app:layout_constraintTop_toBottomOf="@+id/avatar_top_left"
        app:placeholderImage="@drawable/larus_bg_avatar_img4_bottom_left"
        app:roundBottomEnd="false"
        app:roundBottomStart="true"
        app:roundTopEnd="false"
        app:roundTopStart="false"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <ImageView
        android:id="@+id/avatar_selected_icon_bottom_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_avatar_chooser_confirm"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_bottom_left"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bottom_left"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar_bottom_right"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_1"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/avatar_top_right"
        app:layout_constraintStart_toStartOf="@+id/avatar_top_right"
        app:layout_constraintTop_toBottomOf="@+id/avatar_top_right"
        app:placeholderImage="@drawable/larus_bg_avatar_img4_bottom_right"
        app:roundBottomEnd="true"
        app:roundBottomStart="false"
        app:roundTopEnd="false"
        app:roundTopStart="false"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <ImageView
        android:id="@+id/avatar_selected_icon_bottom_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_avatar_chooser_confirm"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_bottom_right"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bottom_right"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_cancel"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bottom_left"
        app:layout_constraintStart_toStartOf="@+id/avatar_bottom_left"
        app:layout_constraintTop_toBottomOf="@+id/avatar_bottom_left"
        app:rv_backgroundColor="@color/larus_neutral_transparent_1"
        app:rv_cornerRadius="?attr/larus_dp_16"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/btn_submit"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_AI_generate_choose"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bottom_right"
        app:layout_constraintStart_toStartOf="@+id/avatar_bottom_right"
        app:layout_constraintTop_toBottomOf="@+id/avatar_bottom_right"
        app:rv_backgroundColor="@color/larus_primary_50"
        app:rv_cornerRadius="?attr/larus_dp_16"/>
    <FrameLayout
        android:id="@+id/avatar_light_loading"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_bottom_right"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bottom_right"
        app:layout_constraintStart_toStartOf="@+id/avatar_top_left"
        app:layout_constraintTop_toTopOf="@+id/avatar_top_left">
        <View
            android:id="@+id/light"
            android:background="@drawable/larus_bg_avatar_preview_loading"
            android:layout_width="?attr/larus_dp_160"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/avatar_loading_fail"
        android:background="@color/larus_base_3"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar_top_left">
        <ImageView
            android:id="@+id/avatar_reload_btn"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_avatar_reload_btn"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_22"
            android:layout_marginBottom="?attr/larus_dp_32"
            android:text="@string/larus_AI_generate_reload"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
