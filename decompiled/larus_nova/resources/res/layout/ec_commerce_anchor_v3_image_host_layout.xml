<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_image_container"
    android:background="@color/white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.widget.RemoteRoundImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:actualImageScaleType="fitCenter"/>
    <com.bytedance.android.shopping.widget.RemoteRoundImageView
        android:id="@+id/atmosphere_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center"
        android:id="@+id/hint_image_special_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.anchorv3.matchpurchase.view.FloatingTagLayout
        android:id="@+id/float_tags_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
