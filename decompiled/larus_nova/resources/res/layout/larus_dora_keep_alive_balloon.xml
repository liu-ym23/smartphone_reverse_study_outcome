<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:background="@color/larus_base_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_8"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_keep_alive_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_66"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/dora_keep_alive_balloon_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_keep_alive_cdn_balloon_tips_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_keep_alive_balloon_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_static_white"
                android:id="@+id/dora_keep_alive_balloon_btn"
                android:background="@drawable/larus_dora_ota_bg_btn"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingTop="?attr/larus_dp_6"
                android:paddingRight="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_btn_turn_on_cn"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dora_keep_alive_balloon_close_btn"
                app:layout_constraintStart_toEndOf="@+id/dora_keep_alive_balloon_text"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/dora_keep_alive_balloon_close_btn"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_dora_keep_alive_balloon_close_btn"
                android:layout_marginStart="?attr/larus_dp_4"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_keep_alive_balloon_btn"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
