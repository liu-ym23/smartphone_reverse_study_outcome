<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/text"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minHeight="48dp"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toStartOf="@+id/icon"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="?attr/larus_dp_46"
        android:layout_height="?attr/larus_dp_32"
        android:paddingStart="0dp"
        android:paddingEnd="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text"
        app:srcCompat="?attr/larus_ic_suggest_reply"/>
</androidx.constraintlayout.widget.ConstraintLayout>
