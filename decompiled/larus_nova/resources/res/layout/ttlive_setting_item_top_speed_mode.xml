<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_play_opt_item_new"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_dialog_main_text"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_experience_item_top_speed_title"/>
    <ImageView
        android:id="@+id/ivTitleAbout"
        android:background="@drawable/ttlive_icon_circle_about"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="17dp"
        android:layout_toRightOf="@+id/tvTitle"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/switchButton"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        app:lsb_background="@color/ttlive_dialog_switch_button_unchecked"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="#67dca0"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#d9ffffff"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_dialog_desc_text"
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/tvTitle"/>
    <View
        android:id="@+id/view_topspeed_divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/tvDesc"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#fe2c55"
        android:id="@+id/top_speed_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@+id/view_topspeed_divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_setting_switch"
        android:background="@drawable/ttlive_bg_item_top_speed_sub_switch"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/tvDesc">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_dialog_main_text"
                android:id="@+id/picture_quality_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="91dp"
                android:text="@string/ttlive_experience_item_picture_quality_title"
                android:layout_centerVertical="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/switch_picture_quality"
                android:layout_width="35dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:lsb_background="@color/ttlive_dialog_switch_button_unchecked"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </RelativeLayout>
        <View
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_dialog_main_text"
                android:id="@+id/function_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="91dp"
                android:text="@string/ttlive_experience_item_function_title"
                android:layout_centerVertical="true"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/switch_base_function"
                android:layout_width="35dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:lsb_background="@color/ttlive_dialog_switch_button_unchecked"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="#67dca0"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
