<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/lkui_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.cameraview.cameraViewV2.JCameraViewV2
        android:id="@+id/jcameraview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:duration_max="10000"
        app:iconLeft="@drawable/ud_icon_cancel_buzz_outlined"
        app:iconMargin="20dp"
        app:iconRight="@drawable/ud_icon_camera_flip_outlined"
        app:iconSize="30dp"
        app:iconSrc="@drawable/ic_svg_camera"/>
</FrameLayout>
