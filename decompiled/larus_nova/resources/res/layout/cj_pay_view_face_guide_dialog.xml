<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/cj_pay_face_guide_dialog_panel_container"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="top|left"
        android:id="@+id/cj_pay_back_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_12"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cj_pay_pass_close_tallback"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/cj_pay_padding_70"
        android:layout_height="@dimen/cj_pay_padding_70"
        android:src="@drawable/cj_pay_icon_face_guide_dialog"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_face_guide_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:singleLine="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_face_guide_sub_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_10"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:maxLines="2"
        android:layout_below="@+id/cj_pay_face_guide_title_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:ellipsize="middle"
        android:id="@+id/cj_pay_face_guide_protocol_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:layout_marginRight="@dimen/cj_pay_padding_20"/>
    <FrameLayout
        android:id="@+id/cj_pay_face_guide_confirm_layout"
        android:paddingLeft="@dimen/cj_pay_padding_20"
        android:paddingTop="@dimen/cj_pay_padding_12"
        android:paddingRight="@dimen/cj_pay_padding_20"
        android:paddingBottom="@dimen/cj_pay_padding_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_face_guide_confirm_btn"
            android:background="@drawable/cj_pay_bg_face_guide_red_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cj_pay_face_guide_confirm_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
</LinearLayout>
