<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundLinearLayout
        android:orientation="vertical"
        android:id="@+id/container_layout"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/larus_base_1_overlay"
        app:rv_cornerRadius_BL="?attr/larus_dp_24"
        app:rv_cornerRadius_BR="?attr/larus_dp_24">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/find_device_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_scanning_cn"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:indeterminateDrawable="@drawable/larus_dora_loading"
                android:indeterminateDuration="750"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarThumbVertical="@drawable/larus_shape_nestscroll_bar"
            android:id="@+id/device_list_recycler_view"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_150"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:fadeScrollbars="true"/>
    </com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
</FrameLayout>
