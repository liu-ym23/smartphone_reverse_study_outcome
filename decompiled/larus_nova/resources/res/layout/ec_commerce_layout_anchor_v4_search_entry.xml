<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="top"
    android:id="@+id/ec_commerce_layout_anchor_v4_search_entry_1092254312"
    android:background="@drawable/ec_commerce_bg_anchor_v4_search_bg"
    android:layout_width="match_parent"
    android:layout_height="55dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/search_entry_area"
        android:background="@drawable/anchor_v4_search_entry_bkg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="8dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:background="@drawable/anchor_v4_search_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textColor="@color/commerce_color_CCFFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_search_word_hint"
            android:layout_marginStart="4dp"
            style="@style/font_size_28"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/commerce_color_FFFFFF"
            android:ellipsize="end"
            android:id="@+id/anchor_v4_search_suggest_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="242dp"
            android:lines="1"
            android:layout_marginStart="4dp"
            style="@style/font_size_28"/>
        <ImageView
            android:background="@drawable/anchor_v4_search_right_arrow"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</LinearLayout>
