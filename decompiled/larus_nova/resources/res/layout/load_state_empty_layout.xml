<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/list_state_empty_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/list_state_empty_state"
        android:layout_width="wrap_content"
        app:ud_empty_desc="@string/Doc_Facade_EmptyDocumentTips"
        app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_content"
        app:ud_empty_primaryText="@string/Doc_Facade_CreateDocument"
        app:ud_empty_secondaryText="@string/Doc_Facade_FilterEmptyDocTips"
        app:ud_empty_title="@string/Doc_Facade_OfflineEmptyAvailableFile"
        style="@style/SpaceEmptyStatusStyle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/primary_fill_default"
        android:id="@+id/list_state_empty_text_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</LinearLayout>
