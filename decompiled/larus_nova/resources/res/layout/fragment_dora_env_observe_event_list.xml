<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.refresh.SuperSwipeRefreshLayout
        android:id="@+id/dora_env_event_srl_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dora_env_event_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_16"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/neutral_50"
                android:layout_gravity="center"
                android:id="@+id/event_empty_guide"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_environmental_data_event_empty_cn"
                android:includeFontPadding="false"/>
            <com.larus.avlink.record.ui.RecordMinutesLoadingOrRetryView
                android:id="@+id/loading_or_retry"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="100dp"/>
        </FrameLayout>
    </com.larus.common_ui.refresh.SuperSwipeRefreshLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
