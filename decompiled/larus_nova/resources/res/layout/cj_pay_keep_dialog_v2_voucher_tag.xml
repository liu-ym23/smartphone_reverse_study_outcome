<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_keep_dialog_v2_bg_image"
    android:layout_width="220dp"
    android:layout_height="60dp">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/voucher_tag_left"
        android:layout_width="90dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voucher_tag_number_pre_des_layout"
            android:background="@drawable/cj_pay_voucher_tag_pre_desc_bg"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="9sp"
                android:textColor="#fffe2c55"
                android:id="@+id/voucher_tag_number_pre_des"
                android:layout_width="9sp"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="-2sp"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#fffe2c55"
            android:id="@+id/voucher_tag_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_toRightOf="@+id/voucher_tag_number_pre_des_layout"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4sp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#fffe2c55"
            android:id="@+id/voucher_tag_number_after_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_toRightOf="@+id/voucher_tag_number"
            android:layout_alignBaseline="@+id/voucher_tag_number"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/voucher_tag_middle_line"
        android:background="@drawable/cj_pay_voucher_tag_middle_line"
        android:layout_width="2dp"
        android:layout_height="38dp"
        android:layout_marginLeft="90dp"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:id="@+id/voucher_tag_right"
        android:paddingLeft="14dp"
        android:layout_width="129dp"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/voucher_tag_middle_line">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fffe2c55"
            android:ellipsize="end"
            android:id="@+id/voucher_tag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="14dp"
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:id="@+id/voucher_tag_right_tip"
            android:background="@drawable/cj_pay_voucher_tag_top_right_tip_bg"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="9sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/voucher_tag_top_right_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
