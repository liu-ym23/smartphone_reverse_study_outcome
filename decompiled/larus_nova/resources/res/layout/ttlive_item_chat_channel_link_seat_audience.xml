<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="26dp"
    android:layout_height="26dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/channel_user_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_withdraw_default_avatar"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/mic_bg"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_room_channel_link_seat_mic_bg"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/mic_status_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ttlive_room_channel_seat_mic_status_open"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:id="@+id/link_volume_view"
        android:visibility="gone"
        android:layout_width="3.5dp"
        android:layout_height="5.5dp"
        android:layout_marginTop="1.5dp"
        android:progress="100"
        android:layout_marginEnd="0.5dp"
        app:layout_constraintEnd_toEndOf="@+id/mic_status_iv"
        app:layout_constraintStart_toStartOf="@+id/mic_status_iv"
        app:layout_constraintTop_toTopOf="@+id/mic_status_iv"
        style="@style/ttlive_room_link_progress_bar_style_ver"/>
</androidx.constraintlayout.widget.ConstraintLayout>
