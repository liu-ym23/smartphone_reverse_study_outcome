<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ttlive_message_container_margin_right">
        <com.bytedance.android.livesdk.interactivity.api.publicscreen.ui.PublicScreenTextMessageFrameLayout
            android:id="@+id/public_text_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/quick_comment_container"/>
        <FrameLayout
            android:id="@+id/quick_comment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/light_feedback_container"/>
        <FrameLayout
            android:id="@+id/light_feedback_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/anchor_asr_hint_container"/>
        <FrameLayout
            android:id="@+id/anchor_asr_hint_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_container"/>
        <FrameLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_anchor"/>
        <View
            android:id="@+id/bottom_anchor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
