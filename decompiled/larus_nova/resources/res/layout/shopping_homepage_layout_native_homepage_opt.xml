<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.mall.widget.NoSlipFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mall_fragment_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/long_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/short_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.mall.widget.ECDetectableFrameLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.mall.widget.ECDetectableFrameLayout
            android:id="@+id/ec_mall_hybrid_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/refresh_list_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.shopping.mall.feed.ECMallListContainer
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:splitMotionEvents="false"/>
            </com.scwang.smartrefresh.layout.SmartRefreshLayout>
            <FrameLayout
                android:id="@+id/ec_mall_anchor_pendant_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.shopping.mall.widget.ECDetectableFrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/scroll_to_top"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="78dp"
        android:src="@drawable/shopping_homepage_scroll_top_icon"
        android:layout_marginEnd="12dp"/>
    <FrameLayout
        android:id="@+id/ec_mall_live_window_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ec_mall_marketing_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ec_mall_popup_layer_card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ec_mall_popup_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/pendant_popup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/page_card_container"
        android:layout_width="1dp"
        android:layout_height="1dp"/>
    <FrameLayout
        android:id="@+id/half_mall_top_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:src="@drawable/shopping_homepage_ic_half_mall_topbar"/>
    </FrameLayout>
</com.bytedance.android.shopping.mall.widget.NoSlipFrameLayout>
