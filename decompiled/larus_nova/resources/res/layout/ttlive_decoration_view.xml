<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/room_decoration_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_decoration_text"
        android:visibility="gone"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/nine_patch_sticker_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/room_decoration_audit_layout"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="14dp">
        <TextView
            android:textSize="9dp"
            android:gravity="center"
            android:id="@+id/room_decoration_audit_text"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:text="@string/ttlive_decoration_audit_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_decoration_button"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_reserve"
        android:maxLines="1"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/room_decoration_cancel"
        android:background="@drawable/ttlive_ic_room_decoration_cancel"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"/>
</merge>
