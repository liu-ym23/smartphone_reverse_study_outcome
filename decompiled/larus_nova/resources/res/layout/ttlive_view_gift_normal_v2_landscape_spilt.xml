<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/normal_gift_bg_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_anim_bg_height_v2_landscape_spilt"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="@+id/gift_icon_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/user_avatar_iv"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="1dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/multi_user_avatar_container"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginLeft="3dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
        <ImageView
            android:id="@+id/multi_user_avatar_bottom"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ttlive_img_avatar_empty"
            app:layout_constraintEnd_toEndOf="@+id/multi_user_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/multi_user_avatar_container"/>
        <ImageView
            android:id="@+id/multi_user_avatar_top"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ttlive_img_avatar_empty"
            app:layout_constraintBottom_toBottomOf="@+id/multi_user_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/multi_user_avatar_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/user_info_container"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toEndOf="@+id/user_avatar_iv"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/user_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:maxLines="1"
            android:maxLength="5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_type_iv"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_name_tv"
            app:layout_constraintLeft_toRightOf="@+id/user_name_tv"
            app:layout_constraintTop_toTopOf="@+id/user_name_tv"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#a3ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/gift_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_name_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_right_tips_iv"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="38dp"
        android:layout_marginLeft="28dp"
        android:layout_marginStart="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_icon_container"
        app:layout_constraintStart_toStartOf="@+id/gift_icon_container"
        app:layout_constraintTop_toTopOf="@+id/gift_icon_container"/>
    <FrameLayout
        android:id="@+id/gift_icon_container"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toEndOf="@+id/user_info_container"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
        <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
            android:id="@+id/gift_icon_animation_view"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/group_body"
            android:background="@drawable/ttlive_bg_spilt_gift_tray_goup_body"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="9dp">
            <com.bytedance.android.live.core.widget.CustomFontTextView
                android:textSize="8dp"
                android:textStyle="italic|bold"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x"/>
            <com.bytedance.android.live.core.widget.CustomFontTextView
                android:textSize="8dp"
                android:textStyle="italic|bold"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:id="@+id/group_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/dummy_view"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toEndOf="@+id/gift_icon_container"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/combo_body"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/normal_gift_bg_view">
        <TextView
            android:textSize="12dp"
            android:textStyle="italic"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="8dp"
            android:text="x"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="italic"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/combo_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
