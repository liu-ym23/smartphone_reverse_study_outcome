<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/product_buy_container"
    android:background="@drawable/shopping_buy_button_default"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:gravity="center"
        android:id="@+id/tv_buy_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_buy_now"
        android:lineSpacingExtra="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ec_uikit_const_icInverse3"
        android:id="@+id/tv_buy_sub_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"/>
</LinearLayout>
