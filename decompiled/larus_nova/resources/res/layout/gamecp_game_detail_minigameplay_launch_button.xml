<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_gameplay_launch_btn_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mini_gameplay_container"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center"
            android:id="@+id/mini_gameplay_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/mini_gameplay_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/gamecp_mini_game_instant_play"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/mini_game_play_with_download_btn"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/mini_game_play_with_download_btn_icon"
            android:visibility="visible"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/gamecp_ic_flash_red"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gamecp_game_FE2C55"
            android:id="@+id/mini_game_play_with_download_btn_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_play_with_download"/>
    </LinearLayout>
</FrameLayout>
