<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/cj_pay_titlebar_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_50">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cj_pay_back_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_font_size_16"
                android:src="@drawable/cj_pay_icon_titlebar_left_close_new"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cj_pay_middle_view"
                android:visibility="visible"
                android:layout_width="86dp"
                android:layout_height="@dimen/cj_pay_height_24"
                android:src="@drawable/cj_pay_icon_counter_title_dy_pay"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/cj_pay_total_value_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/cj_pay_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_currency_unit"/>
            <TextView
                android:textSize="36sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/cj_pay_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/cj_pay_discount_info_layout"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:ellipsize="end"
                android:id="@+id/cj_pay_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_light"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_order_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"/>
        <View
            android:background="#17161823"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="29dp"
            android:layout_marginRight="@dimen/cj_pay_padding_16"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/cj_pay_merchant_info_layout"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="17dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:id="@+id/cj_pay_merchant_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_integrated_counter_outer_pay_order_info"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:id="@+id/cj_pay_merchant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:singleLine="true"/>
        </LinearLayout>
        <View
            android:background="#17161823"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cj_payment_method_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_integrated_counter_outer_pay_payment_method"/>
            <LinearLayout
                android:gravity="right"
                android:orientation="vertical"
                android:id="@+id/cj_payment_method_voucher_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/cj_payment_method_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:ellipsize="middle"
                        android:id="@+id/cj_payment_method"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/cj_pay_color_red"
                        android:id="@+id/cj_pay_payment_method_voucher1"
                        android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cj_pay_padding_2"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="@dimen/cj_pay_padding_10"
                        android:textColor="@color/cj_pay_color_red"
                        android:id="@+id/cj_pay_payment_method_voucher2"
                        android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/cj_pay_padding_2"
                        android:layout_marginTop="@dimen/cj_pay_padding_2"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_toRightOf="@+id/cj_pay_payment_method_voucher1"/>
                </RelativeLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="@dimen/cj_pay_height_24"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cj_pay_payment_method_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/cj_pay_payment_method_loading"
                    android:background="@color/cj_pay_color_trans"
                    android:visibility="gone"
                    android:layout_width="@dimen/cj_pay_padding_24"
                    android:layout_height="@dimen/cj_pay_padding_24"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
                    android:indeterminateDuration="500"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:id="@+id/cj_pay_payment_method_divider"
            android:background="#17161823"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="15sp"
                android:textColor="?attr/cj_pay_button_text_white_color"
                android:gravity="center"
                android:id="@+id/cj_pay_confirm"
                android:background="@drawable/cj_pay_bg_red_btn_radius_2_fe2c55"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_marginBottom="12dp"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:id="@+id/cj_pay_confirm_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_20"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:layout_marginTop="@dimen/cj_pay_padding_14"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_button_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_alignTop="@+id/cj_pay_confirm"
                android:layout_centerHorizontal="true"/>
            <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
                android:id="@+id/cj_pay_insurance_tips_view"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_below="@+id/cj_pay_confirm"
                app:theme_type="0"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cj_pay_loading_outer_layout"
        android:background="@color/cj_pay_color_white"
        android:paddingTop="100dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_loading_view"
            android:background="@color/cj_pay_color_trans"
            android:layout_width="@dimen/cj_pay_height_60"
            android:layout_height="@dimen/cj_pay_height_60"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
</FrameLayout>
