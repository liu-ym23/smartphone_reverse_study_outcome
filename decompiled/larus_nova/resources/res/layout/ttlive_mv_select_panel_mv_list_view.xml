<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            app:placeholderImage="@drawable/ttlive_mv_select_dialog_network_error"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_mv_select_dialog_network_error_text"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#99161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_mv_select_dialog_network_error_hint"/>
        <FrameLayout
            android:id="@+id/btn_refresh"
            android:background="@drawable/ttlive_bg_mv_select_refresh"
            android:layout_width="165dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_mv_select_dialog_network_error_refresh"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
