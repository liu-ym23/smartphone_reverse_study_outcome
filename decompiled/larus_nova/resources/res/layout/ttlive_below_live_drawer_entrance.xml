<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="101dp"
    android:layout_height="22dp">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_gravity="center"
        android:id="@+id/drawer_entrance_background"
        android:background="@drawable/ttlive_below_drawer_entrance_bg"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        app:ttlive_leftBottomRadius="11dp"
        app:ttlive_leftTopRadius="11dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.uikit.textview.AlwaysMarqueeTextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_s5"
                android:id="@+id/entrance_text"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:text="@string/ttlive_top_drawer_entrance_text"
                android:singleLine="true"
                android:maxLength="4"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:src="@drawable/ttlive_drawer_entrance_arrow"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/slide_light"
                android:background="@drawable/ttlive_drawer_entrance_slide_light"
                android:visibility="gone"
                android:layout_width="64dp"
                android:layout_height="22dp"/>
        </RelativeLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="left"
        android:id="@+id/entrance_anim"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="22dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center"
        android:id="@+id/entrance_webp_anim"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="22dp"
        app:actualImageScaleType="fitCenter"/>
</FrameLayout>
