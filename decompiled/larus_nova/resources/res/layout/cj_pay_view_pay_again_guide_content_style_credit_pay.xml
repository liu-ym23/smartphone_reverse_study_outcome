<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/credit_pay_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/credit_pay_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="@dimen/cj_pay_padding_4"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
            android:layout_gravity="center_horizontal"
            android:id="@+id/credit_pay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/credit_pay_voucher_horizontal_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/credit_pay_voucher_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
</LinearLayout>
