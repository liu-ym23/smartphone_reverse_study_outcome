<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/space_kit_len_2">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/menu_icon"
        android:layout_width="@dimen/space_kit_len_20"
        android:layout_height="@dimen/space_kit_len_20"
        app:tint="@color/icon_n2"/>
    <TextView
        android:textSize="@dimen/space_kit_font_12"
        android:textColor="@color/text_placeholder"
        android:id="@+id/menu_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_kit_len_2"
        android:layout_marginTop="@dimen/space_kit_len_4"
        android:layout_marginRight="@dimen/space_kit_len_2"
        android:maxLines="1"/>
</LinearLayout>
