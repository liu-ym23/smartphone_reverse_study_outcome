<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_content"
    android:background="@drawable/larus_bg_dora_widget_diary_4x4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/diary_data_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/diary_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/larus_dp_40"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/diary_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/larus_dp_12">
                    <TextView
                        android:textSize="@dimen/larus_dp_13"
                        android:textColor="@color/neutral_100"
                        android:id="@+id/diary_year_month_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_13"
                        android:textColor="@color/neutral_100"
                        android:id="@+id/diary_day_week_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/diary_emotion_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/diary_emotion_icon"
                        android:layout_width="@dimen/larus_dp_26"
                        android:layout_height="@dimen/larus_dp_26"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_12"
                        android:textColor="@color/neutral_70"
                        android:id="@+id/diary_emotion_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/larus_dp_2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/diary_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/larus_dp_18"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/diary_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_4"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/larus_dp_12"
                android:textColor="@color/neutral_50"
                android:ellipsize="end"
                android:id="@+id/diary_subtitle_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/larus_dora_diary_tag_pausing_cn"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/larus_dp_14"
                android:textColor="@color/neutral_100"
                android:ellipsize="end"
                android:id="@+id/diary_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/larus_dp_8"
                android:maxLines="8"
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/larus_dp_4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/diary_no_data_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="@dimen/larus_dp_48"
                android:layout_height="@dimen/larus_dp_48"
                android:src="@drawable/larus_dora_widget_no_diary_icon"/>
            <TextView
                android:textSize="@dimen/larus_dp_14"
                android:textColor="@color/neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/larus_dp_8"
                android:text="@string/larus_dora_g_diary_empty_cn"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14">
            <TextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/neutral_50"
                android:id="@+id/glass_state_disconnected"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_widget_not_connected"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <LinearLayout
                android:id="@+id/glass_state_connected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:id="@+id/glass_info"
                    android:layout_width="@dimen/larus_dp_56"
                    android:layout_height="@dimen/larus_dp_27">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_20"
                        android:layout_height="@dimen/larus_dp_20"
                        android:src="@drawable/icon_dora_widget_glass"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/glass_power_level_percent"
                        android:layout_width="@dimen/larus_dp_34"
                        android:layout_height="@dimen/larus_dp_20"
                        android:text="@string/larus_dora_widget_power_percent_100"
                        android:includeFontPadding="false"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"/>
                    <RelativeLayout
                        android:layout_width="@dimen/larus_dp_46"
                        android:layout_height="@dimen/larus_dp_3"
                        android:layout_marginBottom="@dimen/larus_dp_4"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_dora_widget_power_progress_bg"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_green"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_yellow"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_red"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                            style="?android:attr/progressBarStyleHorizontal"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/glass_charge_flash"
                        android:visibility="gone"
                        android:layout_width="@dimen/larus_dp_10"
                        android:layout_height="@dimen/larus_dp_11"
                        android:src="@drawable/icon_dora_widget_lightening"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/larus_dp_18"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/glass_box_info"
                    android:layout_width="@dimen/larus_dp_56"
                    android:layout_height="@dimen/larus_dp_27"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_width="@dimen/larus_dp_16"
                        android:layout_height="@dimen/larus_dp_20"
                        android:src="@drawable/icon_dora_widget_glass_box"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/larus_dp_12"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/glass_box_power_level_percent"
                        android:layout_width="@dimen/larus_dp_34"
                        android:layout_height="@dimen/larus_dp_20"
                        android:text="@string/larus_dora_widget_power_percent_100"
                        android:includeFontPadding="false"
                        android:layout_alignParentTop="true"
                        android:layout_marginEnd="@dimen/larus_dp_4"
                        android:layout_alignParentEnd="true"/>
                    <RelativeLayout
                        android:layout_width="@dimen/larus_dp_46"
                        android:layout_height="@dimen/larus_dp_3"
                        android:layout_marginBottom="@dimen/larus_dp_4"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_dora_widget_power_progress_bg"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_green"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_yellow"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_red"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                            style="?android:attr/progressBarStyleHorizontal"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/glass_box_charge_flash"
                        android:visibility="gone"
                        android:layout_width="@dimen/larus_dp_10"
                        android:layout_height="@dimen/larus_dp_11"
                        android:src="@drawable/icon_dora_widget_lightening"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/larus_dp_18"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/diary_empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/neutral_70"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_device_my_devices_cn"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/larus_dora_g_device_no_available_cn"/>
    </LinearLayout>
</FrameLayout>
