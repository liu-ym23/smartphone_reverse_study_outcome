<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/hint"
        android:background="@color/ttlive_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_live_interact_hint"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/set_performer"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_interact_set_performing"/>
    <View
        android:id="@+id/line_set_performer"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/show_profile"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_interact_show_profile"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/silence"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_silence"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel_silence"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_silence_cancel"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/enlarge_c_position"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_voice_room_enlarge_c_position"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/set_c_position"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_talk_room_set_c_position"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/disconnect"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_disconnect"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/camera_switch"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_interact_open_camera"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/send_gift"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_send_gift"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/report"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_talk_room_report"/>
    <View
        android:id="@+id/line_set_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/set_position_name"
        android:background="@color/ttlive_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_set_position_name"/>
    <View
        android:id="@+id/line_edit_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/edit_position_name"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_edit_position_name"/>
    <View
        android:id="@+id/line_delete_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/delete_position_name"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_delete_position_name"/>
    <View
        android:id="@+id/line_adjust_guest_position"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/adjust_guest_position"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_aujust_guest_position"/>
    <View
        android:id="@+id/line_adjust_team_fight_camp"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/adjust_team_fight_camp"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_chat_room_panel_item_red_camp_hit"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
