<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="#99161823"
        android:gravity="center"
        android:id="@+id/top_tips_textview"
        android:background="#f4f3f4"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="@string/ttlive_video_comment_panel_top_tips"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_video_comment_panel_tab"/>
    <View
        android:id="@+id/top_bar_bg"
        android:background="@color/ttlive_white"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:theme="@style/Theme.AppCompat"
        android:id="@+id/ttlive_video_comment_panel_tab"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/search_video_btn_panel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/search_video_btn_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabBackground="@color/ttlive_white"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/ttlive_video_select_tab_indicator"
        app:tabIndicatorColor="#161823"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabMinWidth="60dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="#161823"
        app:tabTextAppearance="@style/InteractTextStyle"
        app:tabTextColor="#99161823"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_video_btn_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_video_comment_panel_tab"
        app:layout_constraintEnd_toStartOf="@+id/switch_or_send_btn"
        app:layout_constraintLeft_toRightOf="@+id/ttlive_video_comment_panel_tab"
        app:layout_constraintRight_toLeftOf="@+id/switch_or_send_btn"
        app:layout_constraintStart_toEndOf="@+id/ttlive_video_comment_panel_tab"
        app:layout_constraintTop_toTopOf="@+id/ttlive_video_comment_panel_tab">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_video_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:minWidth="90dp"
            android:layout_marginStart="30dp">
            <ImageView
                android:background="@drawable/ttlive_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#99161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_video_search_tips"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/switch_or_send_btn"
        android:background="@drawable/ttlive_video_comment_panel_key_board_ic"
        android:layout_width="@dimen/ttlive_video_comment_panel_send_btn_size"
        android:layout_height="@dimen/ttlive_video_comment_panel_send_btn_size"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="@dimen/ttlive_video_comment_panel_send_btn_margin_right"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="@dimen/ttlive_video_comment_panel_send_btn_margin_right"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_video_comment_panel_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ttlive_video_comment_panel_tab"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/ttlive_video_comment_panel_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_tips_textview"/>
    <FrameLayout
        android:id="@+id/ttlive_video_comment_panel_loading_container"
        android:background="#ffffff"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/ttlive_video_comment_panel_loading_animation_view"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ttlive_video_comment_panel_reloading_btn_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:background="@drawable/ttlive_bg_live_loading_error"
            android:layout_width="180dp"
            android:layout_height="120dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_comment_panel_error_network"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/ttlive_video_comment_panel_reloading_btn"
            android:background="@drawable/ttlive_button_gray_bg"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_video_comment_panel_reloading_btn_title"/>
    </LinearLayout>
    <View
        android:id="@+id/search_video_btn2_margin_view"
        android:clickable="false"
        android:layout_width="8dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_video_btn2_panel"
        android:background="@drawable/ttlive_video_comment_selection_background"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:translationZ="8dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_video_btn2_margin_view"
        app:layout_constraintEnd_toStartOf="@+id/search_video_btn2_margin_view"
        app:layout_constraintRight_toLeftOf="@+id/search_video_btn2_margin_view"
        app:layout_constraintTop_toTopOf="@+id/search_video_btn2_margin_view">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/search_video_btn2"
            android:background="@drawable/ttlive_video_comment_selection_background"
            android:layout_width="70dp"
            android:layout_height="40dp">
            <ImageView
                android:background="@drawable/ttlive_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#99161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_video_search_tips"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout
        android:theme="@style/Theme.AppCompat"
        android:id="@+id/ttlive_video_comment_panel_tab2"
        android:background="@drawable/ttlive_video_comment_selection_background"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="8dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:translationZ="8dp"
        android:elevation="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/search_video_btn2_panel"
        app:layout_constraintEnd_toStartOf="@+id/search_video_btn2_panel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/search_video_btn2_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_video_btn2_panel"
        app:tabBackground="@color/transparent"
        app:tabGravity="fill"
        app:tabIndicator="@null"
        app:tabIndicatorColor="@color/transparent"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="60dp"
        app:tabMode="fixed"
        app:tabPadding="0dp"
        app:tabSelectedTextColor="#161823"
        app:tabTextAppearance="@style/InteractTextStyle"
        app:tabTextColor="#66161823"/>
</merge>
