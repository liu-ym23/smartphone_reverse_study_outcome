<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shop_member_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="10dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shop_member_icon"
            android:layout_width="14sp"
            android:layout_height="14sp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.store.view.ECShopLabelTextView
            android:orientation="horizontal"
            android:id="@+id/shop_member_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/shop_member_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.store.view.ECShopLabelTextView
            android:orientation="horizontal"
            android:id="@+id/shop_member_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0.5dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintLeft_toRightOf="@+id/shop_member_title"
            app:layout_constraintRight_toLeftOf="@+id/shop_member_button_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/shop_member_button_arrow"
            android:layout_width="10sp"
            android:layout_height="10sp"
            android:layout_marginRight="5dp"
            android:src="@drawable/ec_shop_member_arrow"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
