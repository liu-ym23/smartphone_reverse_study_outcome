<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
        android:id="@+id/live_life_shelf_product_price_container"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:paddingEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/live_life_shelf_product_flash_sale_container"
        app:layout_constraintEnd_toStartOf="@+id/live_life_shelf_product_action_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_orientation="horizontal">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="11dp"
            android:textColor="#fe2c55"
            android:id="@+id/live_life_shelf_product_price_prefix_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_priority="1"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="17dp"
            android:textColor="#fe2c55"
            android:id="@+id/live_life_shelf_product_price_final_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_baseline_anchor="1"
            app:layout_priority="0"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:textColor="#cb7627"
            android:id="@+id/live_life_shelf_product_price_second_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="3dp"
            app:layout_priority="2"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:textColor="#59161823"
            android:id="@+id/live_life_shelf_product_price_origin_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_priority="5"/>
        <com.bytedance.locallife.live.goodsshelves.view.BaselineAlignedLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:baselineAlignedChildIndex="1"
            app:baselineOrientation="horizontal"
            app:layout_priority="3">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/live_life_shelf_product_price_third_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignBottom="true"
                android:layout_marginStart="3dp"
                app:layout_priority="4"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="10dp"
                android:textColor="#59161823"
                android:id="@+id/live_life_shelf_product_price_third_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"
                android:layout_marginStart="2dp"
                app:layout_priority="3"/>
        </com.bytedance.locallife.live.goodsshelves.view.BaselineAlignedLayout>
    </com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout>
    <com.bytedance.locallife.live.view.RoundedFrameLayout
        android:id="@+id/live_life_shelf_product_flash_sale_container"
        android:background="#0d161823"
        android:layout_width="115dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/live_life_shelf_product_marketing_container"
        app:layout_constraintStart_toStartOf="parent"
        app:rounded_radius="7dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/live_life_shelf_product_flash_sale_progress_iv"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            app:roundedCornerRadius="8dp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/live_life_shelf_product_flash_sale_status_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
        <com.ss.android.ugc.aweme.live.dsl.view.CountDownTextView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/live_life_shelf_product_flash_sale_count_down_tv"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"/>
    </com.bytedance.locallife.live.view.RoundedFrameLayout>
    <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfProductMarketingContainerView
        android:id="@+id/live_life_shelf_product_marketing_container"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:paddingEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/live_life_shelf_product_action_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/live_life_shelf_product_action_container"
        android:layout_width="80dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/live_life_shelf_product_action_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/live_life_shelf_product_action_tv"
            android:layout_width="70dp"
            android:layout_height="28dp"
            android:maxLines="1"
            app:autoSizeMaxTextSize="13dp"
            app:autoSizeMinTextSize="9dp"/>
    </FrameLayout>
</merge>
