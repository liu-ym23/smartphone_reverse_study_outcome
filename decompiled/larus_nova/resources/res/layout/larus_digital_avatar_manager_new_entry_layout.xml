<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/base_3"
    app:rv_cornerRadius="@dimen/dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/digital_avatar_material_entry"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_material_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_digital_avatar_material_entry_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_replica_model_menuOption_input"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_material_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/thumbnail_avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/take_video_hint"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/thumbnail_avatar_right"
                android:layout_width="?attr/larus_dp_26"
                android:layout_height="?attr/larus_dp_26"
                android:layout_marginStart="@dimen/dp_22"
                app:roundedCornerRadius="?attr/larus_dp_6"/>
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_11"
                app:rv_backgroundColor="@color/base_3"
                app:rv_cornerRadius="?attr/larus_dp_8">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/thumbnail_avatar_mid"
                    android:layout_width="?attr/larus_dp_26"
                    android:layout_height="?attr/larus_dp_26"
                    android:layout_margin="2dp"
                    app:roundedCornerRadius="?attr/larus_dp_6"/>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:rv_backgroundColor="@color/base_3"
                app:rv_cornerRadius="?attr/larus_dp_8">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/thumbnail_avatar_left"
                    android:layout_width="?attr/larus_dp_26"
                    android:layout_height="?attr/larus_dp_26"
                    android:layout_margin="2dp"
                    app:roundedCornerRadius="?attr/larus_dp_6"/>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_material_arrow"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_arrow"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/material_red_dot"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_voice_mix_red_dot"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/neutral_50"
            android:id="@+id/take_video_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_create_replica_video_btn_addVideo"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_material_arrow"
            app:layout_constraintStart_toEndOf="@+id/thumbnail_avatar_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/digital_avatar_manage_entry"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_manage_icon"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:srcCompat="@drawable/larus_digital_avatar_manage_entry_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_replica_bottomsheet_btn_manage"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp_10"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_material_arrow_2"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_arrow"/>
    </LinearLayout>
</com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
