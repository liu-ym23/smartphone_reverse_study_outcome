<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_fixed"
        android:background="@drawable/ttlive_bg_fixed_debug_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:text="@string/ttlive_report_room_fixed_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_fixed"
        app:layout_constraintRight_toLeftOf="@+id/btn_fixed"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_report"
            android:background="@drawable/ttlive_bg_debug_report_button"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:text="@string/ttlive_report_room_report_button"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_report_local"
            android:background="@drawable/ttlive_bg_debug_report_button"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:layout_marginTop="38dp"
            android:text="@string/ttlive_report_room_report_local_button"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
