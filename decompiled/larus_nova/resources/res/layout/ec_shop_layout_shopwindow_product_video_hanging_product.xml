<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_window_product_video_hanging_product"
    android:padding="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="42dp"
        android:layout_height="42dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/ec_shop_product_placeholder_color"
                app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/window_product_card_image_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/shopping_std_bg_black_1"
                app:roundedCornerRadius="6dp"/>
            <FrameLayout
                android:id="@+id/ec_shop_tag_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/store_product_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="48dp"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="17sp"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/store_product_card_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="48dp"
        app:pv_hideYuanSymbol="false"
        app:pv_prefixMarginRight="4dp"
        app:pv_prefixTextBold="false"
        app:pv_prefixTextColor="@color/ec_shop_FF1C49"
        app:pv_prefixTextSizeRatio="0.647"
        app:pv_priceBold="true"
        app:pv_priceTextColor="@color/ec_shop_FF1C49"
        app:pv_yuanSymbolBold="false"
        app:pv_yuanSymbolMarginRight="1dp"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
</FrameLayout>
