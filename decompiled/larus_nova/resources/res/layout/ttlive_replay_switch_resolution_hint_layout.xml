<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_btn"
        android:background="@drawable/ttlive_replay_resolution_hint_close_icon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="3dp"
        android:layout_marginEnd="3dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/hint_prefix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        android:text="@string/ttlive_replay_slow_hint"
        android:layout_marginEnd="3dp"/>
    <View
        android:id="@+id/resolution_icon"
        android:background="@drawable/ttlive_replay_ic_hdr_resolution_tip"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/resolution_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/switch_hint_postfix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_replay_switch_resolution_waiting_postfix"/>
</LinearLayout>
