<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/profile_setting_head"
        android:background="@drawable/ttlive_bg_live_profile_header"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16dp"
            android:textColor="#404040"
            android:layout_gravity="center"
            android:id="@+id/fans_club_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_profile_setting_title"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="14dp"
            android:textColor="#ff2200"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/save_fans_club_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_core_save"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <View
        android:background="#e0e0e0"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ttlive_core_hs_w2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_hs_s28"
            android:gravity="center_horizontal"
            android:id="@+id/fans_calub_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:text="@string/ttlive_live_profile_fans_club_tips"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/fans_club_icon_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>
