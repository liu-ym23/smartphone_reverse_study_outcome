<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.bot.share.ImmerseBgBitmapImageView
        android:id="@+id/immerse_avatar_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center_horizontal"
        android:id="@+id/bot_name"
        android:paddingLeft="?attr/larus_dp_45"
        android:paddingRight="?attr/larus_dp_45"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/bot_introduction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_static_white"
        android:gravity="center_horizontal"
        android:id="@+id/bot_introduction"
        android:paddingLeft="?attr/larus_dp_45"
        android:paddingRight="?attr/larus_dp_45"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/bot_heat_creator_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bot_heat_creator_area"
        android:paddingLeft="?attr/larus_dp_45"
        android:paddingRight="?attr/larus_dp_45"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_54"
        app:layout_constraintBottom_toTopOf="@+id/footer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/heat_icon"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_share_immerse_tag_hot"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/static_white_transparent_4"
            android:layout_gravity="center_vertical"
            android:id="@+id/bot_heat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_2"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/heat_divider_dot"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_17"
            android:src="@drawable/larus_share_immerse_divider_dot"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/static_white_transparent_4"
            android:layout_gravity="center_vertical"
            android:id="@+id/creator_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer_container"
        android:paddingBottom="?attr/larus_dp_26"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <include layout="@layout/larus_layout_share_footer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
