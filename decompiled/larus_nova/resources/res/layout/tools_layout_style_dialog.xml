<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/tools_std_transparent"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/rootview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/rl_top"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ic_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/close_iv"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tools_ic_dialog_close"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_below_top"
            android:background="@drawable/tools_bg_bottom_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_top"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:id="@+id/rl_custom_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textStyle="bold"
                android:textColor="@color/tools_dialog_title"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:ts_font_type="bold"
                style="@style/tools_font_size_34"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textColor="@color/tools_dialog_content"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:ts_font_type="regular"
                style="@style/tools_font_size_28"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textColor="@color/tools_dialog_content"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_second_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:ts_font_type="regular"
                style="@style/tools_font_size_28"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:id="@+id/divider_line"
                android:background="@color/tools_dialog_line"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="47.5dp">
                <com.ss.android.ugc.tools.view.style.StyleTextView
                    android:textColor="@color/tools_dialog_title"
                    android:gravity="center"
                    android:id="@+id/tv_left"
                    android:background="@drawable/tools_bg_bottom_left_selector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:ts_font_type="regular"
                    style="@style/tools_font_size_30"/>
                <com.ss.android.ugc.tools.view.style.StyleTextView
                    android:id="@+id/tv_line"
                    android:background="@color/tools_dialog_line"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"/>
                <com.ss.android.ugc.tools.view.style.StyleTextView
                    android:textStyle="bold"
                    android:textColor="@color/tools_dialog_title"
                    android:gravity="center"
                    android:id="@+id/tv_right"
                    android:background="@drawable/tools_bg_bottom_right_selector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:ts_font_type="bold"
                    style="@style/tools_font_size_30"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
