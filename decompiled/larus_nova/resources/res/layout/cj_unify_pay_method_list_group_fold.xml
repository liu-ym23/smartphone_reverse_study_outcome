<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="1">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="46dp"
        android:paddingTop="8dp"
        android:paddingRight="52dp"
        android:paddingBottom="14dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/tv_group_fold_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_unify_expand_all_payment_methods"/>
        <ImageView
            android:id="@+id/iv_group_fold_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_icon_unify_arrow_down_gray"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
