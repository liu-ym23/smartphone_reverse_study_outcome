<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/card_title_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/larus_bg_rounded_card"
        android:padding="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10">
        <com.larus.bmhome.view.RoundAvatarImageView
            android:gravity="center"
            android:id="@+id/avatar"
            android:layout_width="?attr/larus_dp_50"
            android:layout_height="?attr/larus_dp_50"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/bind_button"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_68"
            android:layout_height="?attr/larus_dp_42"
            android:text="@string/larus_rebind_douyin_available_bind_cn"
            app:rv_backgroundColor="@color/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_12"/>
    </LinearLayout>
</LinearLayout>
