<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_ban_dialog"
        android:layout_width="match_parent"
        android:layout_height="295dp">
        <View
            android:background="@drawable/ttlive_bg_ban_dialog_top"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/head_living_status_view"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="29dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="center"
                android:id="@+id/head_view"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:placeholderImage="@drawable/ttlive_ic_default_head_small"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <ImageView
                android:id="@+id/circle_living_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ttlive_ic_pk_rivals_search_living"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/living_view"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_nick_name_usertags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_pk_info"
            app:layout_constraintStart_toEndOf="@+id/head_living_status_view"
            app:layout_constraintTop_toTopOf="@+id/head_living_status_view">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#404040"
                android:ellipsize="end"
                android:id="@+id/tv_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="5"
                android:singleLine="true"/>
            <com.bytedance.android.livesdk.widget.VHeadView
                android:id="@+id/gender_view"
                android:background="@drawable/ttlive_bg_circle_head"
                android:visibility="visible"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ttlive_gender_male_icon"
                android:layout_marginStart="4dp"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#80161823"
                android:gravity="center"
                android:id="@+id/tv_follow_tag"
                android:background="@drawable/ttlive_bg_pk_record_user_tag"
                android:paddingLeft="4dp"
                android:paddingTop="1dp"
                android:paddingRight="4dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:maxLines="1"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/tv_pk_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:maxLines="1"
            android:alpha="0.34"
            app:autoSizeMaxTextSize="13dp"
            app:autoSizeMinTextSize="8dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@+id/head_living_status_view"
            app:layout_constraintEnd_toStartOf="@+id/tv_profile_follow"
            app:layout_constraintStart_toEndOf="@+id/head_living_status_view"
            app:layout_constraintTop_toBottomOf="@+id/ll_nick_name_usertags"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_profile_follow"
            android:background="@drawable/ttlive_bg_profile_anchor_follow"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:layout_marginRight="12dp"
            android:text="@string/ttlive_anchor_interact_ban_setting_follow"
            app:layout_constraintBottom_toBottomOf="@+id/head_living_status_view"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/head_living_status_view"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/option_container"
            android:background="@drawable/ttlive_bg_ban_setting_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/head_living_status_view">
            <FrameLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_add_push_container"
                android:layout_width="match_parent"
                android:layout_height="51dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_add_push"
                    android:paddingLeft="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:text="@string/ttlive_interact_pk_ban_setting_add"
                    android:drawablePadding="12dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_add_push"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="18dp"
                    android:src="@drawable/ttlive_ic_check_mark"/>
            </FrameLayout>
            <View
                android:id="@+id/divider_2"
                android:background="#1e161823"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
            <FrameLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_sub_push_container"
                android:layout_width="match_parent"
                android:layout_height="51dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_sub_push"
                    android:paddingLeft="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:text="@string/ttlive_interact_pk_ban_setting_sub"
                    android:drawablePadding="12dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_sub_push"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="18dp"
                    android:src="@drawable/ttlive_ic_check_mark"/>
            </FrameLayout>
            <View
                android:id="@+id/divider_3"
                android:background="#1e161823"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
            <FrameLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_not_push_container"
                android:layout_width="match_parent"
                android:layout_height="51dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_not_push"
                    android:paddingLeft="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:text="@string/ttlive_interact_pk_ban_setting_not"
                    android:drawablePadding="12dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_not_push"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="18dp"
                    android:src="@drawable/ttlive_ic_check_mark"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
