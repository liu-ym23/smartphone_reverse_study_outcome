<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fl_avatar_gender"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="center"
                android:id="@+id/iv_avatar"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:placeholderImage="@drawable/ttlive_ic_default_head_small"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/view_wave"
                android:background="@drawable/ttlive_bg_anchor_link_inviter_or_applier"
                android:visibility="gone"
                android:layout_width="72dp"
                android:layout_height="72dp"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/anim_wave"
                android:background="@drawable/ttlive_bg_anchor_link_inviter_or_applier"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.livesdk.widget.VHeadView
                android:layout_gravity="bottom|right"
                android:id="@+id/iv_gender"
                android:background="@drawable/ttlive_bg_circle_head"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="18dp"
                android:layout_marginBottom="18dp"
                android:src="@drawable/ttlive_gender_female_icon"
                android:layout_marginEnd="18dp"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:layout_gravity="top|right"
                android:id="@+id/tv_label_top"
                android:background="@drawable/ttlive_bg_anchor_link_anchor_invite_label"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="14dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="12dp"
                android:text="@string/ttlive_anchor_link_invite_label_followed"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_avatar_gender">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="8"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ttlive_white"
                    android:gravity="center"
                    android:id="@+id/tv_label_bottom"
                    android:background="@drawable/ttlive_bg_anchor_link_anchor_invite_label"
                    android:visibility="gone"
                    android:layout_width="26dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="3dp"
                    android:text="@string/ttlive_anchor_link_invite_label_followed"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_distance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
