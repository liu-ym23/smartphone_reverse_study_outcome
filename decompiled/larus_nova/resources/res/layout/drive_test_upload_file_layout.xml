<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingTop="@dimen/space_kit_len_20"
    android:paddingBottom="@dimen/space_kit_len_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/upload_type_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true">
        <com.larksuite.component.universe_design.p010switch.UDSwitch
            android:id="@+id/switchView"
            android:paddingTop="@dimen/space_kit_len_10"
            android:paddingBottom="@dimen/space_kit_len_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingStart="@dimen/space_kit_len_10"
            android:paddingEnd="0dp"
            android:layout_marginEnd="@dimen/space_kit_len_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_upload_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/test_upload_type_share_token"/>
    </LinearLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center_vertical"
        android:id="@+id/edt_code"
        android:paddingLeft="@dimen/space_kit_len_12"
        android:paddingRight="@dimen/space_kit_len_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_48"
        android:layout_margin="@dimen/space_kit_len_16"
        android:hint="@string/test_upload_type_share_token"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_below="@+id/upload_type_container"
        app:ud_backgroundColor="@color/bg_body"
        app:ud_strokeColor="@color/primary_fill_default"
        app:ud_strokeWidth="@dimen/space_kit_len_1"
        style="@style/SpaceEditTextStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/file_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginBottom="@dimen/space_kit_len_20"
        android:layout_below="@+id/edt_code"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_name"
            android:layout_marginEnd="@dimen/space_kit_len_10"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/colorful_blue"
            android:id="@+id/tv_upload_file_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_selection"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_20"
        android:layout_below="@+id/file_container"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_progress"
            android:layout_marginEnd="@dimen/space_kit_len_10"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/colorful_blue"
            android:id="@+id/tv_upload_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_upload_file_progress_not_start"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="16sp"
        android:textColor="@color/static_white"
        android:id="@+id/btn_start"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/test_upload_file_start"
        android:layout_below="@+id/progress_container"
        app:ud_backgroundColor="@color/ud_button_blue_bg"
        app:ud_radius="l"
        app:ud_strokeWidth="@dimen/ud_divider_size"
        style="@style/UDButton.Small.Primary"/>
</RelativeLayout>
