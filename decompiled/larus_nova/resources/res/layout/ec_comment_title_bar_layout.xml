<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="45dp">
    <ImageView
        android:id="@+id/title_back_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ec_comment_black_back_arrow"
        android:scaleType="fitCenter"
        android:contentDescription="@string/shopping_return"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/commerce_color_161823"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_comment"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_back_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sku_entrance_ll"
        android:background="@drawable/ec_comment_sku_select_entrance_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:maxWidth="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title_right_container"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sku_select_entrance_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ec_comment_sku_entrance_icon_unselected"
            android:scaleType="fitXY"
            android:contentDescription="@string/ec_comment_sku_select_entrance_text"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_color_161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/sku_select_entrance_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:maxWidth="68dp"
            android:text="@string/ec_comment_sku_select_entrance_text"
            android:maxLines="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/title_right_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:paddingStart="9dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
