<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/commonui_white"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequent_chat_cancel"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#ff161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_57_161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequent_chat_save"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/edit_text_container"
        android:background="@drawable/ttlive_bg_frequent_chat_edit_input"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:id="@+id/emoji_panel_entrance_container"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:id="@+id/emoji_panel_entrance"
            android:background="@drawable/ttlive_control_emoji_toggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"/>
        <FrameLayout
            android:id="@+id/hide_keyboard_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="36dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/recommend_chat_container"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="13dp"
                android:id="@+id/recommend_chat_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/frequent_chat_recent_frequent_chats"
                android:layout_marginStart="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/recommend_chat_list"
                android:paddingBottom="32dp"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/emoji_panel_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
