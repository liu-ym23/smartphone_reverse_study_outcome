<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.profile.impl.view.MineTabTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.larus.profile.impl.view.ProfileHeaderUserInfoView
                android:id="@+id/header_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tablayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/larus_tab_bottom"
                app:tabIndicatorColor="@color/larus_neutral_100"
                app:tabIndicatorFullWidth="true"
                app:tabMaxWidth="0dp"
                app:tabPaddingEnd="?attr/larus_dp_8"
                app:tabPaddingStart="?attr/larus_dp_8"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/larus_neutral_100"
                app:tabTextAppearance="@style/larus_mine_tab_layout"
                app:tabTextColor="@color/larus_neutral_50"/>
            <View
                android:id="@+id/divider_profile_info_to_tab"
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0_5"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.larus.bmhome.view.CreateBotButton
        android:id="@+id/bot_create"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/outer_chat_input"
        android:background="@drawable/larus_bg_widget_outer_chat_input"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/profile_user_info_loading"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_283"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        layout="@layout/larus_page_profile_user_info_skeleton"/>
    <include
        android:id="@+id/profile_tab_info_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user_info_loading"
        app:layout_goneMarginTop="?attr/larus_dp_310"
        layout="@layout/larus_page_profile_tab_info_loading"/>
    <include
        android:id="@+id/profile_info_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        layout="@layout/larus_page_profile_info_error"/>
</androidx.constraintlayout.widget.ConstraintLayout>
