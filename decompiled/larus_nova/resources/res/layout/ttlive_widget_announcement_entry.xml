<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="50dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_announce_entry_container"
        android:paddingTop="6dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_white_90"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_announce_status"
                    android:paddingLeft="4dp"
                    android:paddingTop="1.5dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="1.5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_white_90"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_announcement_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_advance_announcement_entry_title"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="#80ffffff"
                android:id="@+id/tv_status_guide_desc"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/ttlive_ic_announcement_entry_arrow"
                android:drawablePadding="8dp"
                android:layout_alignParentRight="true"
                android:drawableEnd="@drawable/ttlive_ic_announcement_entry_arrow"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ll_announce_desc_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="80dp"
            android:layout_marginBottom="2dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_white_50"
                android:ellipsize="end"
                android:id="@+id/tv_announce_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="360dp"
                android:singleLine="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/pre_setting_forenotice_divider"
            android:background="@color/ttlive_std_line_white_2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/tv_loading_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="请检查网络连接后重试"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/mDcbLoadingView"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
</FrameLayout>
