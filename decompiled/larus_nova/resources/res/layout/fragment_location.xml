<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/location_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.ss.android.lark.location_ui.widget.SearchBar
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/fl_set_location_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsing_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <FrameLayout
                        android:id="@+id/location_fl_map_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.5">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/map_container"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iv_location_icon"
                            android:visibility="gone"
                            android:layout_width="22dp"
                            android:layout_height="34dp"
                            android:src="@drawable/location_icon_event_location"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/white"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_request_permission"
                            android:background="@drawable/location_bg_request_permission"
                            android:paddingLeft="12dp"
                            android:paddingTop="3dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="3dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/Lark_Core_EnableLocationAccess_Button"
                            android:drawableRight="@drawable/location_ic_request_location_permission"
                            android:drawablePadding="4dp"/>
                    </FrameLayout>
                    <ImageView
                        android:layout_gravity="bottom|right"
                        android:id="@+id/location_iv_locate_position"
                        android:layout_width="64dp"
                        android:layout_height="69dp"
                        android:layout_marginRight="8.5dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/location_navigate_position_selector"
                        app:layout_anchor="@+id/appbar"
                        app:layout_anchorGravity="end|bottom"/>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.larksuite.framework.ui.StableNestedScrollView
                android:id="@+id/scroll_near"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.ss.android.lark.location_ui.widget.LoadingView
                        android:id="@+id/location_nearby_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>
                    <ListView
                        android:id="@+id/lv_nearby"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@drawable/location_position_item_divider_line"
                        android:dividerHeight="0.5dp"/>
                </FrameLayout>
            </com.larksuite.framework.ui.StableNestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/location_fl_recommend"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.location_ui.widget.LoadingView
            android:id="@+id/location_recommend_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/location_ll_recommend"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/location_line_recommend"
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <ListView
                android:id="@+id/lv_recommend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/location_position_item_divider_line"
                android:dividerHeight="0.5dp"/>
        </LinearLayout>
        <include layout="@layout/location_empty_view"/>
    </FrameLayout>
</LinearLayout>
