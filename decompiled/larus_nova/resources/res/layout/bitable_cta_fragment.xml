<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/cta_state"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:ud_empty_operableTextColor="@color/text_link_normal"
        style="@style/SpaceEmptyStatusStyle"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/desc_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <com.larksuite.component.universe_design.button.UDButton
            android:textColor="@color/ud_button_grey_text"
            android:id="@+id/destructive_btn"
            android:visibility="gone"
            android:maxLines="1"
            app:ud_backgroundColor="@color/ud_button_white_grey_bg"
            app:ud_radius="s"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Middle.Primary"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textColor="@color/static_white"
            android:id="@+id/primary_btn"
            android:visibility="gone"
            android:maxLines="1"
            android:layout_marginStart="11dp"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            app:ud_radius="s"
            style="@style/UDButton.Middle.Primary"/>
    </LinearLayout>
</LinearLayout>
