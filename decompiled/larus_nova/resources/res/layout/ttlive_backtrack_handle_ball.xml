<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.ReverseHorizontalLinearLayout
        android:orientation="horizontal"
        android:id="@+id/handle_bar_layout"
        android:background="@drawable/ttlive_record_handle_ball_bg"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <FrameLayout
            android:id="@+id/progress_layout"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <com.bytedance.android.livesdk.chatroom.widget.LiveCircleProgressView
                android:id="@+id/progress_view"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/record_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:includeFontPadding="false"/>
    </com.bytedance.android.livesdk.widget.ReverseHorizontalLinearLayout>
</com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer>
