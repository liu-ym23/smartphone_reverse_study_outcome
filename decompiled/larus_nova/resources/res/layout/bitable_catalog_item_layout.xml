<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.infoarch.SafeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/catalog_wrapper"
    android:background="@drawable/bitable_catalog_item_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:duplicateParentState="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_kit_len_4"
    android:minHeight="@dimen/space_kit_len_44"
    android:paddingStart="@dimen/space_kit_len_12">
    <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/left_icon"
        android:layout_width="@dimen/space_kit_len_16"
        android:layout_height="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_8"
        app:tint="@color/icon_n2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/left_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tips_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tips_icon"
            android:padding="@dimen/space_kit_len_7"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_28"
            android:layout_height="@dimen/space_kit_len_28"
            android:translationY="1dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/left_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/right_icon_wrapper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/space_kit_len_8"
        android:paddingEnd="@dimen/space_kit_len_8">
        <FrameLayout
            android:layout_gravity="end"
            android:background="@drawable/bitable_item_icon_bg_selector"
            android:layout_width="@dimen/space_kit_len_28"
            android:layout_height="@dimen/space_kit_len_28">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/right_icon"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                app:tint="@color/icon_n3"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_icon_secondary"
            android:background="@drawable/bitable_item_icon_bg_selector"
            android:padding="@dimen/space_kit_len_6"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_28"
            android:layout_height="@dimen/space_kit_len_28"
            android:layout_marginEnd="@dimen/space_kit_len_32"
            app:tint="@color/icon_n3"/>
    </FrameLayout>
</com.bytedance.ee.bear.bitable.infoarch.SafeLinearLayout>
