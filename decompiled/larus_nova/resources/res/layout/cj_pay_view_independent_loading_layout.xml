<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_independent_loading_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_view_half_screen_amount_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="bottom"
            android:id="@+id/amount_unit"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:text="@string/cj_pay_currency_unit"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.05"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#ff6e26"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_view_half_screen_discount_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="320dp"
        android:maxLines="2"
        android:layout_centerHorizontal="true"/>
    <include layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</LinearLayout>
