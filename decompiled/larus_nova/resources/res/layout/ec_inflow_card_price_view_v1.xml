<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/min_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:extraTextColor="@color/inflow_ui_card_price"
        app:extraTextSize="13sp"
        app:prefixTextSize="13sp"
        app:priceBold="true"
        app:priceDecimalTextSize="19sp"
        app:priceTextColor="@color/inflow_ui_card_price"
        app:priceTextSize="24sp"
        app:spaceSize="1sp"
        app:thinDecimal="true"
        app:yangTextSize="14sp"/>
</RelativeLayout>
