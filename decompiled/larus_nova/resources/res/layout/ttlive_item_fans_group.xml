<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/iv_chosen"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ttlive_ic_fans_group_chosen"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintRight_toRightOf="@+id/iv_icon"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="58dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
