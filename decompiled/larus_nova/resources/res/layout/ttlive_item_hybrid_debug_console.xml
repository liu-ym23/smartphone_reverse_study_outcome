<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="5dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/msg_rl"
        android:background="@color/white"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/msg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/msg_subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/msg_title"
            android:layout_marginStart="5dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/msg_ll"
            android:background="#d3d3d3"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/msg_subTitle">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginRight="5dp"
                android:layout_below="@+id/msg_title"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/msg_content1"
                android:background="@drawable/ttlive_debug_bg_jsb_info"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/msg_subTitle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ttlive_red"
                android:id="@+id/msg_content2"
                android:background="@drawable/ttlive_debug_bg_jsb_info"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_below="@+id/msg_content1"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
