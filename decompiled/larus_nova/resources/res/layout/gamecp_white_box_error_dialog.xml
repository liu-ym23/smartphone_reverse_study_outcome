<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gamecp_white"
    android:layout_width="400dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/gamecp_black"
        android:id="@+id/tv_desc"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        style="@style/gamecp_live_dialog_divider_horizontal"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_black"
        android:id="@+id/error_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
    <View
        android:id="@+id/button_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_content"
        style="@style/gamecp_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cl_button_area"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_divider">
        <Button
            android:textSize="15dp"
            android:textColor="@color/gamecp_black"
            android:gravity="center"
            android:id="@+id/button_copy"
            android:background="@color/gamecp_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gamecp_copy"
            android:layout_weight="1"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/gamecp_black"
            android:gravity="center"
            android:id="@+id/button_cancel"
            android:background="@color/gamecp_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gamecp_cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
