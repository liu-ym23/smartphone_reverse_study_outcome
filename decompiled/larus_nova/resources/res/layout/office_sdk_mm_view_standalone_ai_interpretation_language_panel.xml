<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/closeButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/closeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"
                app:tint="@color/icon_n2"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/languageHeader"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/sourceLanguageChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="140dp"
                android:minWidth="48dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:drawablePadding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                app:drawableEndCompat="@drawable/office_sdk_mm_ic_standalone_ai_interpretation_expand_down"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/arrowView"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/office_sdk_mm_ic_standalone_ai_interpretation_arrow"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/targetLanguageChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="140dp"
                android:minWidth="48dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:drawablePadding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                app:drawableEndCompat="@drawable/office_sdk_mm_ic_standalone_ai_interpretation_expand_down"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topContainer">
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmNormalHintSwitchView
            android:id="@+id/bilingualSwitch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:normal_content_text="@string/View_G_Record_SelectLan_ShowOriginalTranslation_Checkbox"
            app:normal_content_text_bold="false"
            app:normal_layout_style="switch_only"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/languageList"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
