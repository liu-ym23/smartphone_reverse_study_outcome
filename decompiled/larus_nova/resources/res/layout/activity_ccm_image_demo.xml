<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/ccm_image_demo_btn_show_local_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示本地图片(assets)"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_office"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用Office容器显示图片"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_gif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用Office容器显示GIF"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_heif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用Office容器显示HEIF"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_png"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用Office容器显示PNG"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_big_jpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用Office容器显示大图JPG"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_long_png"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用容器显示长图PNG"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_high_hz_gif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用容器显示高频GIF"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_big_gif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用容器显示大图GIF"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_image_demo_btn_show_asset_big_heic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用容器显示大图HEIC"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textSize="14sp"
        android:textColor="#333333"
        android:id="@+id/ccm_image_demo_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <FrameLayout
        android:id="@+id/ccm_image_demo_photo_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"/>
</LinearLayout>
