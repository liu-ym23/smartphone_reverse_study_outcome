<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/shopping_color_FFF8F8F8"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="64dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:id="@+id/ec_shop_store_entrance_guide_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_color_E5161823"
            android:id="@+id/ec_shop_store_entrance_store_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ec_shop_store_entrance_navigator"
        android:background="@drawable/shopping_bg_common_light_gray_round_rect_background"
        android:paddingLeft="20dp"
        android:paddingTop="7dp"
        android:paddingRight="20dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_enter_store"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ec_shop_ic_forward_store"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
