<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.shadow.ShadowLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/horizontal_template_more_bg"
    android:layout_width="128dp"
    android:layout_height="122dp"
    android:layout_marginBottom="@dimen/dp_10"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="@dimen/dp_16"
    app:radius="@dimen/space_radius_m"
    app:shadowAlpha="0.5"
    app:shadowElevation="5dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="43dp"
        android:layout_height="43dp"
        app:srcCompat="@drawable/ccm_ccm_empty_specialized_more_templates"/>
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/text_caption"
        android:layout_gravity="center"
        android:id="@+id/iv_more_templates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/LarkCCM_Docs_Homepage_Templates_More_Epty"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</com.bytedance.ee.bear.shadow.ShadowLinearLayout>
