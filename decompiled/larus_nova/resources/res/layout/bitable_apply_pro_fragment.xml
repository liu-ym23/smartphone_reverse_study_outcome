<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/permission_root_layout"
    android:background="@color/ud_N00"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/empty_state"
            app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_access"
            app:ud_empty_operableTextColor="@color/text_link_normal"
            app:ud_empty_title="@string/Bitable_AdvancedPermission_NoPermToAccessBitable_Title"
            style="@style/SpaceEmptyStatusStyle"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/apply_permission_layout"
            android:background="@drawable/perm_background"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.larksuite.component.universe_design.edittext.UDTextInputLayout
                android:id="@+id/input_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ud_inputLayout_bottomTextInputMargin="@dimen/space_kit_len_4">
                <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                    android:textSize="16sp"
                    android:id="@+id/input_note"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="48dp"
                    android:hint="@string/Bitable_AdvancedPermission_NoPermToAccessBitable_AddNote_Placeholder"
                    app:ud_backgroundColor="@color/ud_edittext_white_bg"
                    app:ud_radius="m"
                    app:ud_strokeColor="@color/ud_edittext_stroke"
                    app:ud_strokeWidth="1dp"
                    style="@style/UDEditText.Normal.SingleLine"/>
            </com.larksuite.component.universe_design.edittext.UDTextInputLayout>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="17sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/apply_pro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/Bitable_AdvancedPermission_NoPermToAccessBitable_Apply_Button"
                app:ud_backgroundColor="@color/primary_fill_default"
                app:ud_radius="m"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:gravity="center_horizontal"
            android:id="@+id/use_pro_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"/>
    </LinearLayout>
</RelativeLayout>
