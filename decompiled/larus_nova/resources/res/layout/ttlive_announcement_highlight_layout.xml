<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.api.DragContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:background="@drawable/ttlive_bg_announcement_highlight_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="103dp">
        <View
            android:id="@+id/indicator"
            android:background="@drawable/ttlive_announcement_highlight_indicator"
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_title"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/ttlive_advance_announcement_entry_title"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/indicator"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_close"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_icon_announcement_highlight_cloe"
            android:contentDescription="@string/ttlive_advance_announcement_close_content_description"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:id="@+id/text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_title"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/ll_anchor_subscribe_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_time">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_announcement_highlight_title_color_audience"
                android:id="@+id/text_subscribe_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="9dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_announcement_highlight_title_color_audience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_announcement_highlight_subscribe_count_suffix"
                android:layout_alignBaseline="@+id/text_subscribe_count"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/text_subscribe_count"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/fl_audience_subscribe_info"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:contentDescription="@string/ttlive_announcement_highlight_subscribe_content_description"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_time">
            <TextView
                android:textSize="11dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_announcement_highlight_title_color_audience"
                android:gravity="center"
                android:id="@+id/btn_subscribe"
                android:background="@drawable/ttlive_bg_announcement_highlight_subscribe_btn"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="40dp"
                android:layout_height="18dp"
                android:text="@string/ttlive_announcement_highlight_subscribe_btn"
                android:importantForAccessibility="no"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_subscribed"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_icon_announcement_highlight_subscribed"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.interactivity.api.DragContainer>
