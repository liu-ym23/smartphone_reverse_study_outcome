<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_card"
    android:background="#161734"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minHeight="498dp">
    <ImageView
        android:id="@+id/preview_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="matrix"
        app:layout_constraintBottom_toTopOf="@+id/preview_bottom"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/preview_original_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:layout_marginBottom="20dp"
        android:scaleType="matrix"
        android:minHeight="310dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/preview_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/preview_user_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="21dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/preview_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="102dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preview_user_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:id="@+id/preview_user_account"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="102dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preview_user_avatar"
        app:layout_constraintTop_toBottomOf="@+id/preview_user_name"/>
    <ImageView
        android:id="@+id/preview_watermark_host"
        android:layout_width="20dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/preview_watermark_divider"
        android:background="@drawable/ttlive_share_poster_preview_watermark_divider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/preview_watermark_host"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/preview_watermark_sjb"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/preview_watermark_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#bfffffff"
        android:id="@+id/preview_match_timing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#bfffffff"
        android:id="@+id/preview_match_schedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:maxLines="1"
        android:layout_marginEnd="20dp"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/preview_bottom"
        android:background="#ffffff"
        android:layout_width="280dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_original_bg"/>
    <ImageView
        android:id="@+id/preview_qr_code_container"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginBottom="15dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_bottom"
        app:layout_constraintEnd_toEndOf="@+id/preview_bottom"/>
    <ImageView
        android:id="@+id/preview_image_guide"
        android:background="@drawable/ttlive_share_poster_preview_image_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/preview_bottom"/>
    <TextView
        android:textSize="11.2sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_image_saving_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_image_guide"
        app:layout_constraintEnd_toStartOf="@+id/preview_qr_code_container"
        app:layout_constraintStart_toEndOf="@+id/preview_image_guide"
        app:layout_constraintTop_toTopOf="@+id/preview_image_guide"/>
    <ImageView
        android:id="@+id/preview_scan_guide"
        android:background="@drawable/ttlive_share_poster_preview_scan_guide"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="54dp"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/preview_bottom"/>
    <TextView
        android:textSize="11.2sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/preview_search_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_scan_guide"
        app:layout_constraintEnd_toStartOf="@+id/preview_qr_code_container"
        app:layout_constraintStart_toEndOf="@+id/preview_scan_guide"
        app:layout_constraintTop_toTopOf="@+id/preview_scan_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
