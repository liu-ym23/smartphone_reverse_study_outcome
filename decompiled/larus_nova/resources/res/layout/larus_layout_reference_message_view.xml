<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ref_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ref_hint"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/ref_text"
            android:padding="?attr/larus_dp_12"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:rv_backgroundColor="@android:color/transparent"
            app:rv_cornerRadius="?attr/larus_dp_16"
            app:rv_isRippleEnable="false"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ref_hint"
        android:layout_width="?attr/larus_dp_4"
        android:layout_height="?attr/larus_dp_42"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ref_text_container"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_reply_view_hint"/>
</merge>
