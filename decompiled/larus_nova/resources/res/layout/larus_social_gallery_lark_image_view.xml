<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48"
        android:indeterminate="true"
        android:indeterminateDuration="750"
        android:indeterminateTint="?attr/larus_neutral_50"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/retry_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/retry_icon"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            android:src="@drawable/larus_ic_refresh_white"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_photo_loading_retry"
            android:layout_below="@+id/retry_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/security_mask_view"
        android:background="#e6000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/security_placeholder_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/larus_bg_social_gallery_permission_placeholder"
            android:padding="?attr/larus_dp_12"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            android:src="@drawable/larus_ic_social_gallery_lock"
            android:contentDescription="@string/larus_social_gallery_no_permission_preview"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_social_gallery_no_permission_preview"/>
    </LinearLayout>
</merge>
