<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tab_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_goneMarginTop="?attr/larus_dp_8">
        <ImageView
            android:id="@+id/icon_left"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_ic_side_bar"
            android:layout_marginStart="?attr/larus_dp_8"/>
        <FrameLayout
            android:id="@+id/profile_image_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/profile_image"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
                app:roundAsCircle="true"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_container"/>
    <com.larus.community.impl.view.CommunityCreateButton
        android:id="@+id/community_create_button_main"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
