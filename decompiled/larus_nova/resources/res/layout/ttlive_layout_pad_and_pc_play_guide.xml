<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/llGuideContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="46dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llPadGuideContainer"
        android:background="@color/ttlive_cast_screen_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flPadTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_pad_and_pc_pad_guide_title"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivPadArrow"
                android:background="@drawable/ttlive_ic_pad_and_pc_play_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="16dp"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/dividerPad"
                android:background="@color/ttlive_std_line_white_3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svPad"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="9dp"
                layout="@layout/ttlive_layout_pad_play_guide_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llPcGuideContainer"
        android:background="@color/ttlive_cast_screen_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flPcTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_pad_and_pc_pc_guide_title"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivPcArrow"
                android:background="@drawable/ttlive_ic_pad_and_pc_play_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="16dp"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/dividerPc"
                android:background="@color/ttlive_std_line_white_3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svPc"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="9dp"
                layout="@layout/ttlive_layout_pc_play_guide_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
