<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/shape_bg_ffffff_corner_4"
    android:layout_width="288dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_game_promote_prop_account_rebind"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#bf161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_game_promote_prop_account_rebind_tip"
        android:lines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_goneMarginTop="16dp"/>
    <View
        android:id="@+id/divider_account_info_bottom"
        android:background="#1f161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/ttlive_game_promote_prop_account_info_cancel"
        app:layout_constraintEnd_toStartOf="@+id/divider_btn"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_account_info_bottom"/>
    <View
        android:id="@+id/divider_btn"
        android:background="#1f161823"
        android:layout_width="0.5dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cancel"
        app:layout_constraintEnd_toStartOf="@+id/tv_ok"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_ok"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/ttlive_game_promote_prop_account_info_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider_btn"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
