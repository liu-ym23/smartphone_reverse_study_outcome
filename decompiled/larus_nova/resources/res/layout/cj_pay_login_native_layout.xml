<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_pay_login_info_title_zone"
        android:background="@drawable/cj_pay_outer_pay_login_pay_info_top"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cj_pay_login_info_card_zone"
        android:background="@drawable/cj_pay_outer_pay_login_card_bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/cj_pay_login_info_title_zone">
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="40"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cj_pay_main_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_login_amount_zone"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#ff161823"
                    android:id="@+id/cj_pay_pay_info_currency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥"/>
                <TextView
                    android:textSize="62sp"
                    android:textStyle="bold"
                    android:textColor="#ff161823"
                    android:id="@+id/cj_pay_pay_info_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="130.0"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/cj_pay_product_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/cj_pay_merchant_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_service_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:singleLine="true"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_promotion_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:layout_below="@+id/cj_pay_main_info_container"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"/>
        <ImageView
            android:id="@+id/cj_pay_login_info_status_image"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/cj_pay_outer_pay_login_error_img"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:id="@+id/cj_pay_login_info_status_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:maxLines="2"
            android:layout_below="@+id/cj_pay_login_info_status_image"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="68"/>
    </LinearLayout>
</RelativeLayout>
