<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopping_layout_appointment_dialog_1854317749"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/shopping_layout_appointment_dialog_973912242"
        android:background="@drawable/ec_result_dialog_bkg"
        android:layout_width="280dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/shopping_layout_appointment_dialog_495419018"
            android:layout_width="match_parent"
            android:layout_height="156dp">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/ec_color_black_text_level1"
                android:gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:maxLines="2"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#bf161823"
                android:gravity="center_horizontal"
                android:id="@+id/tv_message"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
        <View
            android:id="@+id/devider"
            android:background="@color/shopping_color_1F161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/ec_color_black_text_level1"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:layout_width="256dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mutiple_options_part"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:gravity="center"
                    android:id="@+id/cancel_btn"
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/ec_color_black"
                    android:gravity="center"
                    android:id="@+id/confirm_btn"
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/shopping_color_1F161823"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
