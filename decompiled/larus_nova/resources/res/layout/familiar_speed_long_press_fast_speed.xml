<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.feed.ui.view.PinchRippleContainer
        android:id="@+id/left_ripple"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        app:aos_direction="left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <View
            android:background="@drawable/familiar_long_press_speed_ripple_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.awemeopen.apps.framework.feed.ui.view.PinchRippleContainer>
    <com.bytedance.awemeopen.apps.framework.feed.ui.view.PinchRippleContainer
        android:id="@+id/right_ripple"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        app:aos_direction="right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:background="@drawable/familiar_long_press_speed_ripple_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.awemeopen.apps.framework.feed.ui.view.PinchRippleContainer>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/speed_text_container"
        android:background="@drawable/familiar_press_speed_text_container"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_marginTop="68dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/speed_image_2x"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/familiar_long_press_speed_2x"
            android:scaleType="centerInside"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textColor="#e6ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/aos_speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:singleLine="true"
            android:shadowColor="#26000000"
            android:shadowDy="2"
            android:shadowRadius="2"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/forward_pre_triangle"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:src="@drawable/common_feed_long_press_fast_speed"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/forward_next_triangle"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:src="@drawable/common_feed_long_press_fast_speed"
            android:scaleType="centerInside"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
