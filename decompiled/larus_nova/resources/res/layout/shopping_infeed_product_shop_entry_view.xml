<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center_vertical"
        android:background="@drawable/shopping_bg_infeed_product_shop_entry"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/infeed_product_shop_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="9dp"
        app:layoutMode="round"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/infeed_product_live_icon"
        android:layout_width="36dp"
        android:layout_height="10dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/shopping_ic_infeed_product_live_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_vertical"
        android:id="@+id/infeed_product_shop_image_lottie"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="3dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="shopping_infeed_live_lottie.json"
        app:lottie_repeatCount="-1"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/infeed_product_shop_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="6dp"
        app:layout_constraintLeft_toRightOf="@+id/infeed_product_shop_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/shopping_color_B3FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="1dp"
        android:text="@string/shopping_infeed_product_shop_guide"
        android:layout_marginStart="6dp"
        app:layout_constraintLeft_toRightOf="@+id/infeed_product_shop_image"
        app:layout_constraintTop_toBottomOf="@+id/infeed_product_shop_name"/>
</merge>
