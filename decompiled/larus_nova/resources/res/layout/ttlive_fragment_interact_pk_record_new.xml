<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="42dp">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:id="@+id/preload_progress_icon_double_ball"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <ProgressBar
            android:id="@+id/preload_progress_icon_normal"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/empty_image_view"
                android:layout_width="192dp"
                android:layout_height="128dp"
                app:placeholderImage="@drawable/ttlive_empty_content_light"
                app:placeholderImageScaleType="fitXY"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80161823"
                android:id="@+id/empty_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ttlive_interact_pk_no_pk_record"/>
        </LinearLayout>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerView
            android:id="@+id/recycler_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_filter_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerView
            android:id="@+id/recycler_view_tab"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </LinearLayout>
</RelativeLayout>
