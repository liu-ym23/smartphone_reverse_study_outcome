<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/ttlive_bg_broadcast_pre_room_intro_new"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_std_text_black_1"
        android:gravity="center"
        android:id="@+id/title"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/ttlive_live_room_intro"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/room_intro_top_switch_container"
        android:background="@drawable/ttlive_bg_broadcast_pre_room_intro_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/inner_switch_container"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_std_text_black_1"
                android:gravity="start|center_vertical"
                android:id="@+id/switch_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_room_intro_switch"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/switch_button"
                android:layout_width="43dp"
                android:layout_height="25dp"
                app:lsb_background="@color/ttlive_room_intro_switch_button_unchecked_bg"
                app:lsb_button_color="@color/commonui_white"
                app:lsb_checked_color="@color/ttlive_room_intro_switch_button_checked_bg"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="@color/commonui_white"/>
        </LinearLayout>
        <View
            android:id="@+id/switch_divider_line"
            android:background="@color/ttlive_std_line_black_2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/off_switch_anchor_intro_container"
            android:paddingLeft="16dp"
            android:paddingTop="12.5dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_std_text_black_3"
                android:id="@+id/off_switch_intro_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_broadcast_room_intro_desc"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/off_switch_intro_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:actualImageScaleType="fitCenter"
                app:placeholderImage="@drawable/ttlive_bg_broadcast_room_intro_demo"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/room_intro_bottom_intro_container"
        android:background="@drawable/ttlive_bg_broadcast_pre_room_intro_white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="34dp">
        <LinearLayout
            android:id="@+id/avatar_tags_container"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ttlive_avatar_view"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="10dp"
                app:actualImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
                android:id="@+id/tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hSpacing="10dp"
                app:vSpacing="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/room_intro_edit_guide_container"
            android:background="@drawable/ttlive_bg_broadcast_pre_room_intro_gray"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <FrameLayout
                android:id="@+id/room_intro_edit_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:minHeight="58dp">
                <com.bytedance.android.livesdk.widget.TextCorrectionEditText
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:textColorHint="@color/ttlive_edit_view_show_text_view_color"
                    android:id="@+id/edit_view"
                    android:background="@null"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:textColorHint="@color/ttlive_edit_view_show_text_view_color"
                    android:id="@+id/edit_view_show_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="58dp"
                    android:maxLines="3"/>
            </FrameLayout>
            <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
                android:id="@+id/intro_guide_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hSpacing="8dp"
                app:vSpacing="8dp"/>
        </LinearLayout>
        <View
            android:id="@+id/poi_space"
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/poi_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:id="@+id/poi_location_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ttlive_broadcast_poi_location"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_poi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_live_room_intro_poi_title"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/poi_location_icon"
                app:layout_constraintLeft_toRightOf="@+id/poi_location_icon"
                app:layout_constraintTop_toTopOf="@+id/poi_location_icon"/>
            <ImageView
                android:id="@+id/poi_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ttlive_broadcast_poi_arrow"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_poi_select_state"
                android:id="@+id/poi_select_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/poi_arrow"
                app:layout_constraintRight_toLeftOf="@+id/poi_arrow"
                app:layout_constraintTop_toTopOf="@+id/poi_arrow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/appointment_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:id="@+id/appointment_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ttlive_broadcast_appointment_icon"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_poi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_live_room_appointment_title"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/appointment_icon"
                app:layout_constraintLeft_toRightOf="@+id/appointment_icon"
                app:layout_constraintTop_toTopOf="@+id/appointment_icon"/>
            <ImageView
                android:id="@+id/appointment_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ttlive_broadcast_poi_arrow"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_poi_select_state"
                android:id="@+id/appointment_select_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/appointment_arrow"
                app:layout_constraintRight_toLeftOf="@+id/appointment_arrow"
                app:layout_constraintTop_toTopOf="@+id/appointment_arrow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/locallife_poi_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:id="@+id/locallife_poi_location_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ttlive_broadcast_room_intro_locallife_poi_icon"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_locallife_poi_title"
                android:id="@+id/locallife_poi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_live_room_intro_local_life_title"
                android:includeFontPadding="true"
                app:layout_constraintBottom_toBottomOf="@+id/locallife_poi_location_icon"
                app:layout_constraintLeft_toRightOf="@+id/locallife_poi_location_icon"
                app:layout_constraintTop_toTopOf="@+id/locallife_poi_location_icon"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_locallife_poi_select_text"
                android:ellipsize="end"
                android:id="@+id/locallife_poi_select_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="2dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/locallife_poi_arrow"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toRightOf="@+id/locallife_poi_title"
                app:layout_constraintRight_toLeftOf="@+id/locallife_poi_arrow"
                app:layout_constraintTop_toTopOf="@+id/locallife_poi_arrow"/>
            <ImageView
                android:id="@+id/locallife_poi_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ttlive_broadcast_poi_arrow"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.uicomponent.button.UIButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/ttlive_save_and_update"
            style="@style/room_intro_submit_button"/>
    </LinearLayout>
</LinearLayout>
