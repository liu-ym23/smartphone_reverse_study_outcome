<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_anchor_strong_container"
    android:background="@drawable/aos_camera_anchor_strong_bg"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginTop="12dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_camera_strong"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#242424"
        android:id="@+id/tv_camera_strong_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="机位"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_camera_strong"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_camera_anchor_divider"
        android:background="#1a242424"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_strong_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_camera_strong_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_camera_anchor_arrow_text"
        app:layout_constraintStart_toEndOf="@+id/view_camera_anchor_divider"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#242424"
            android:ellipsize="end"
            android:id="@+id/tv_camera_strong_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="香港尖沙咀"
            android:maxLines="1"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="10sp"
            android:textColor="#99242424"
            android:gravity="center"
            android:id="@+id/tv_camera_strong_browse"
            android:background="@drawable/aos_camera_anchor_strong_browse_bg"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="5.7万人浏览"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#ff4182"
        android:id="@+id/tv_camera_anchor_arrow_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="去看看"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_camera_anchor_arrow"
        app:layout_constraintStart_toEndOf="@+id/ll_camera_strong_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_camera_anchor_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/icon_camera_anchor_arrow"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
