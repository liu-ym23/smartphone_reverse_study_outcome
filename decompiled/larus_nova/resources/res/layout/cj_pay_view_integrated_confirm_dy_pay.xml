<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cj_pay_view_payment_confirm_dialog_two_root_view"
        android:background="@drawable/cj_pay_integrated_bg_dialog_two"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/cj_pay_douyin_back_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
            android:contentDescription="@string/cj_pay_old_adapter_close_text"/>
        <TextView
            android:id="@+id/cj_pay_douyin_middle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14sp"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/cj_pay_total_value_layout"
            android:layout_width="match_parent"
            android:layout_height="56sp"
            android:layout_marginTop="44dp">
            <RelativeLayout
                android:id="@+id/cj_pay_money_value_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_red_two"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"/>
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/cj_pay_color_red_two"
                    android:id="@+id/cj_pay_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/cj_pay_padding_2"
                    android:layout_marginBottom="-2dp"
                    android:text="@string/cj_pay_currency_unit"
                    android:includeFontPadding="false"
                    android:layout_toLeftOf="@+id/cj_pay_total_value"
                    android:layout_alignBottom="@+id/cj_pay_total_value"/>
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cj_pay_total_original_value_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_toRightOf="@+id/cj_pay_total_value"
                    android:layout_alignBottom="@+id/cj_pay_total_value">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_gray_153"
                        android:id="@+id/cj_pay_total_original_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"/>
                    <View
                        android:background="@color/cj_pay_color_gray_153"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/cj_pay_padding_1"
                        android:layout_marginRight="@dimen/cj_pay_padding_1"
                        android:layout_alignLeft="@+id/cj_pay_total_original_value"
                        android:layout_alignRight="@+id/cj_pay_total_original_value"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff7a38"
                android:gravity="center_horizontal"
                android:id="@+id/cj_pay_dy_confirm_discount_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:maxWidth="320dp"
                android:maxLines="2"
                android:layout_below="@+id/cj_pay_money_value_layout"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/cj_pay_dy_confirm_product_desc_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_3"
                android:layout_below="@+id/cj_pay_dy_confirm_discount_text">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                    android:id="@+id/tv_original_price_tip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_original_price"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                    android:id="@+id/tv_original_price"
                    android:paddingRight="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_product_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@+id/cj_pay_middle_divider"
            android:background="@color/cj_pay_color_gray_240"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/cj_pay_total_value_layout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cj_pay_payment_list_view"
            android:background="@color/cj_pay_color_trans"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="76dp"
            android:divider="@color/cj_pay_color_trans"
            android:dividerHeight="0dp"
            android:layout_below="@+id/cj_pay_middle_divider"
            android:overScrollMode="never"/>
        <LinearLayout
            android:id="@+id/cj_pay_floating_banner_layout"
            android:background="@drawable/cj_pay_bg_floating_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:layout_above="@+id/cj_pay_confirm_layout">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_floating_banner_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:maxLines="1"
                android:maxEms="17"/>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_floating_banner_button"
                android:background="@drawable/cj_pay_bg_douyin_gray_btn"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/cj_pay_confirm_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_22"
            android:layout_marginRight="@dimen/cj_pay_padding_22"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:layout_alignParentBottom="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_confirm"
                android:background="@drawable/cj_pay_bg_red_btn_radis_8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_confirm_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_20"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
        <com.android.ttcjpaysdk.base.ui.CJPayLoadingView
            android:id="@+id/cj_pay_activity_loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            android:visibility="gone"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <FrameLayout
            android:id="@+id/cj_pay_loading_outer_layout"
            android:background="@color/cj_pay_color_white"
            android:paddingTop="100dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_loading_view"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
