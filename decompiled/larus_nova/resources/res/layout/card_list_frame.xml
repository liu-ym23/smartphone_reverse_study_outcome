<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/card_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.suite.lark.platform.component.widget_biz_dinghelper.helper.view.TopCardContainer
                android:id="@+id/single_top_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:id="@+id/action_layout"
                android:paddingTop="6dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.shadow.UDShadowLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ud_shadow_radius="18dp"
                    style="@style/FloatCardShadow">
                    <com.larksuite.component.universe_design.button.UDButton
                        android:textColor="@color/text_title"
                        android:id="@+id/ellipsize_button"
                        android:text="@string/Lark_Meetings_ShowLessCard_Button"
                        app:ud_backgroundColor="@color/bg_color_card_list_button"
                        app:ud_strokeColor="@color/line_border_card"
                        style="@style/UDButton.Middle.Circle"/>
                </com.larksuite.component.universe_design.shadow.UDShadowLayout>
                <com.larksuite.component.universe_design.shadow.UDShadowLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ud_shadow_radius="18dp"
                    style="@style/FloatCardShadow">
                    <com.larksuite.component.universe_design.button.UDButton
                        android:textColor="@color/text_title"
                        android:id="@+id/clear_button"
                        android:padding="0dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        app:ud_backgroundColor="@color/bg_color_card_list_button"
                        app:ud_isRadiusAdjustBounds="true"
                        app:ud_strokeColor="@color/line_border_card"
                        style="@style/UDButton.Middle.Circle"/>
                </com.larksuite.component.universe_design.shadow.UDShadowLayout>
            </LinearLayout>
            <com.suite.lark.platform.component.widget_biz_dinghelper.helper.view.CardListLayout
                android:id="@+id/card_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:id="@+id/action_layout_bottom"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.shadow.UDShadowLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ud_shadow_radius="18dp"
                    style="@style/FloatCardShadow">
                    <com.larksuite.component.universe_design.button.UDButton
                        android:textColor="@color/text_title"
                        android:id="@+id/ellipsize_button_bottom"
                        android:text="@string/Lark_Meetings_ShowLessCard_Button"
                        app:ud_backgroundColor="@color/bg_color_card_list_button"
                        app:ud_strokeColor="@color/line_border_card"
                        style="@style/UDButton.Middle.Circle"/>
                </com.larksuite.component.universe_design.shadow.UDShadowLayout>
                <com.larksuite.component.universe_design.shadow.UDShadowLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ud_shadow_radius="18dp"
                    style="@style/FloatCardShadow">
                    <com.larksuite.component.universe_design.button.UDButton
                        android:textColor="@color/text_title"
                        android:id="@+id/clear_button_bottom"
                        android:padding="0dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        app:ud_backgroundColor="@color/bg_color_card_list_button"
                        app:ud_isRadiusAdjustBounds="true"
                        app:ud_strokeColor="@color/line_border_card"
                        style="@style/UDButton.Middle.Circle"/>
                </com.larksuite.component.universe_design.shadow.UDShadowLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</merge>
