<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.document.loading.LoadingLayout
        android:id="@+id/edition_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_bar_back"
            android:layout_width="@dimen/widget_menu_img_size"
            android:layout_height="@dimen/widget_menu_img_size"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            app:srcCompat="@drawable/ud_icon_left_outlined"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
