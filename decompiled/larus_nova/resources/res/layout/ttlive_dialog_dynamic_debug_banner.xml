<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/debug_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ttlive_banner_debug_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/split_line"
        android:background="#33161823"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        app:layout_constraintTop_toBottomOf="@+id/debug_title"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/msg_rl"
        android:background="@color/white"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/split_line">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/banner_show_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_banner_debug_info_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/banner_show_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/banner_show_title"
            android:layout_marginStart="5dp"/>
        <ScrollView
            android:background="#d3d3d3"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/banner_show_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/msg_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_container"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_container_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_condition_A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_condition_A"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_condition_A_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_condition_B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_condition_B"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_condition_B_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_condition_C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_condition_C"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_condition_C_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_condition_D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_condition_D"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_condition_D_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/banner_condition_E"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/ttlive_banner_debug_info_condition_E"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffff0000"
                    android:id="@+id/banner_condition_E_content"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
