<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#f5f6f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bg_cornerRadius_TL="20dp"
    app:bg_cornerRadius_TR="20dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/error_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/buynow_161823"
        android:id="@+id/error_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/buynow_60_percent_161823"
        android:id="@+id/error_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/buynow_161823"
        android:gravity="center"
        android:id="@+id/error_button"
        android:layout_width="165dp"
        android:layout_height="44dp"
        android:layout_marginTop="40dp"/>
</com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
