<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/ec_store_popup_tips_padding_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/ec_store_layout_popup_tips_text"
        android:padding="@dimen/ec_store_popup_tips_padding_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ec_store_layout_popup_tips_triangle"
        android:layout_width="@dimen/ec_store_popup_tips_triangle_width"
        android:layout_height="@dimen/ec_store_popup_tips_triangle_height"
        android:src="@drawable/ec_store_ic_triangle_down_black"/>
</LinearLayout>
