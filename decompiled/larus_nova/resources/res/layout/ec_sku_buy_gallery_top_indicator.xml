<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="36dp"
    android:layout_marginRight="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <com.bytedance.android.ui.base.widget.round.RoundTextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/top_indicator_count_tv"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="25dp"
            android:layout_marginBottom="6dp"
            android:minWidth="72dp"
            android:layout_centerInParent="true"
            app:bg_color="#33161823"
            app:bg_cornerRadius="90dp"/>
        <ImageView
            android:id="@+id/top_indicator_back_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/gallery_back_btn"
            android:layout_centerVertical="true"
            android:contentDescription="@string/ec_common_back_button_description"
            android:layout_alignParentStart="true"/>
        <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/detail_entrance_top_right"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:layout_alignParentEnd="true"
            app:bg_color="#1fffffff"
            app:bg_cornerRadius="17dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_common_detail_button"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/gallery_viewer_arrow"
                android:layout_marginStart="2dp"/>
        </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
    </RelativeLayout>
    <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/detail_entrance_center_bottom"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        app:bg_color="#1affffff"
        app:bg_cornerRadius="12dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/main_pic_image_view"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:actualImageScaleType="centerCrop"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#b3ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_common_show_detail_button"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/gallery_viewer_arrow"
            android:alpha="0.7"
            android:layout_marginStart="2dp"/>
    </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
</LinearLayout>
