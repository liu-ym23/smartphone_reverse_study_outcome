<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.TitleAvatarImageView
        android:id="@+id/avatar"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/larus_neutral_transparent_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
