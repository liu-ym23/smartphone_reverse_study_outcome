<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:minWidth="93dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/gsContentLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/search_commodity_gs_main_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/gsWordView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <android.widget.Space
                android:id="@+id/attachWordPaddingView"
                android:layout_width="0dp"
                android:layout_height="2dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:textColor="@color/search_commodity_gs_attach_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/attachWordView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/gsTagIconView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="10sp"
            android:id="@+id/gsTagTextView"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
