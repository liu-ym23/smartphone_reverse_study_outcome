<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/last_read_hint_mask"
        android:background="@color/ao_bgsecondary3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/follow_feed_no_auth_img"
        android:background="@drawable/follow_feed_no_auth_img"
        android:layout_width="192dp"
        android:layout_height="128dp"
        android:layout_marginTop="241dp"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="@color/ConstTextInverse"
        android:gravity="center"
        android:id="@+id/follow_feed_no_auth_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/common_feed_tab_no_auth_desc"
        android:layout_below="@+id/follow_feed_no_auth_img"
        style="@style/font_size_34"/>
    <TextView
        android:textColor="@color/aos_reverse_t_tertiary"
        android:gravity="center"
        android:id="@+id/follow_feed_no_auth_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/common_feed_tab_to_auth_desc"
        android:layout_below="@+id/follow_feed_no_auth_title"
        style="@style/font_size_28"/>
    <TextView
        android:textColor="@color/ConstTextInverse"
        android:gravity="center"
        android:id="@+id/follow_feed_to_auth"
        android:background="@drawable/aos_profile_bg_red_full_rectangular"
        android:layout_width="165dp"
        android:layout_height="44dp"
        android:layout_marginTop="60dp"
        android:text="@string/common_feed_tab_to_auth_btn"
        android:layout_below="@+id/follow_feed_no_auth_desc"
        android:layout_centerHorizontal="true"
        style="@style/font_size_30"/>
</RelativeLayout>
