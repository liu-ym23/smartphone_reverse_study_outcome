<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_sku_shop_info_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/shopping_std_line_black_3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textColor="@color/shopping_color_161823"
        android:id="@+id/common_sku_tv_shop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/shopping_sku_poi_shop_title"
        style="@style/font_size_28"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/common_sku_tv_shop_title">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/common_sku_shop_info_container"
            android:background="@drawable/shopping_bg_sku_panel_check"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/ec_color_FE2C55"
                android:ellipsize="end"
                android:id="@+id/common_sku_tv_shop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/font_size_24"/>
            <TextView
                android:textColor="@color/ec_color_FE2C55"
                android:ellipsize="end"
                android:id="@+id/common_sku_tv_shop_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/font_size_24"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/shopping_color_BF161823"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/common_sku_tv_select_shop"
            android:paddingLeft="28dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_sku_change_poi_info"
            android:drawableRight="@drawable/shopping_ic_arrow_right_gray"
            android:drawablePadding="7dp"
            android:drawableEnd="@drawable/shopping_ic_arrow_right_gray"
            android:paddingStart="28dp"/>
    </LinearLayout>
</RelativeLayout>
