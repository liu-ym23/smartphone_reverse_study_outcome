<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/style_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Rating_Icon_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/styleSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <com.bytedance.ee.bear.bitable.common.widgets.rating.BTRatingBar
            android:id="@+id/ratingBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/min_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Rating_Minimum_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/minSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/minTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/max_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Rating_Maximum_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/maxSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/maxTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
</LinearLayout>
