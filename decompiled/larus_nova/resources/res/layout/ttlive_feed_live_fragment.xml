<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.feed.BannerSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:background="@color/ttlive_feed_bg"
            android:paddingLeft="@dimen/ttlive_dimen_feed_left_rignt_blanck"
            android:paddingRight="@dimen/ttlive_dimen_feed_left_rignt_blanck"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingStart="@dimen/ttlive_dimen_feed_left_rignt_blanck"
            android:paddingEnd="@dimen/ttlive_dimen_feed_left_rignt_blanck"/>
    </com.bytedance.android.livesdk.feed.BannerSwipeRefreshLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/surface_container"
        android:background="@drawable/ttlive_feed_live_small_bg"
        android:padding="0.5dp"
        android:visibility="invisible"
        android:layout_width="2dp"
        android:layout_height="2dp">
        <com.bytedance.android.livesdkapi.view.TextureRenderView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.feed.ui.FeedLiveCoverInfoView
            android:id="@+id/cover_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.bytedance.android.livesdk.feed.widget.LiveFeedFloatTabView
        android:id="@+id/float_tab_view"
        android:background="@color/ttlive_feed_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/ttlive_dimen_feed_tab_left_rignt_blanck"
        android:layout_marginRight="@dimen/ttlive_dimen_feed_tab_left_rignt_blanck"
        android:translationY="-48dp"
        android:layout_marginStart="@dimen/ttlive_dimen_feed_tab_left_rignt_blanck"
        android:layout_marginEnd="@dimen/ttlive_dimen_feed_tab_left_rignt_blanck"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ttlive_feed_start_live"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="40dp"
        android:src="@drawable/ttlive_ic_feed_start_live"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bt_start_live"
        android:background="@drawable/ttlive_feed_start_btn1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="32dp"
        android:text="开直播"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/bt_start_live2"
        android:layout_width="116dp"
        android:layout_height="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ttlive_feed_douyin_start_live_type2"/>
</FrameLayout>
