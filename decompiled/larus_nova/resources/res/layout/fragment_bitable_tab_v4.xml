<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_tab_v4_center_container"
    android:background="@drawable/bitable_home_bg_v4_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_tab_v4_center_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/bitable_toolbar_height">
        <FrameLayout
            android:id="@+id/home_tab_v4_bottom_bar_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/home_tab_v4_tabBar_root"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/home_tab_v4_divider"
                    android:background="@color/line_divider_default"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/home_tab_v4_tabBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/home_tab_v4_hp"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1">
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="26dp">
                            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/home_tab_v4_hp_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:srcCompat="@drawable/ud_icon_base_home_outlined"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="10sp"
                            android:gravity="bottom"
                            android:layout_gravity="center"
                            android:id="@+id/home_tab_v4_hp_name"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Bitable_HomeDashboard_Homepage_Tab"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/home_tab_v4_feed"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1">
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="26dp">
                            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/home_tab_v4_feed_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:srcCompat="@drawable/ud_icon_base_agent_jobs_outlined"/>
                            <View
                                android:layout_gravity="end|top"
                                android:id="@+id/home_tab_v4_feed_red_dot"
                                android:background="@drawable/bitable_feed_tab_red_dot"
                                android:visibility="gone"
                                android:layout_width="8dp"
                                android:layout_height="8dp"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="10sp"
                            android:gravity="bottom"
                            android:layout_gravity="center"
                            android:id="@+id/home_tab_v4_feed_name"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Bitable_Homepage_Sidebar_FeedInbox_Option"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/home_tab_v4_discovery"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1">
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="26dp">
                            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/home_tab_v4_discovery_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                app:srcCompat="@drawable/ud_icon_base_discover_outlined"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="10sp"
                            android:gravity="bottom"
                            android:layout_gravity="center"
                            android:id="@+id/home_tab_v4_discovery_name"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Bitable_HomeDashboard_Discover_Tab"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/home_tab_v4_create_new"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1">
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="30dp"
                            android:layout_height="26dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/home_tab_v4_create_new_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:tint="@color/icon_n2"
                                app:srcCompat="@drawable/ud_icon_base_add_outlined"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/text_caption"
                            android:gravity="bottom"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/home_tab_v4_create_new_name"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Bitable_HomeDashboard_Create_Tab"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <com.bytedance.ee.bear.bitable.homepage.chart.home.edit.AddChartEntryView
                android:id="@+id/home_tab_v4_add_chart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <com.bytedance.ee.bear.list.homepage.tab.HomeViewPager
            android:id="@+id/home_tab_v4_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/home_tab_v4_bottom_bar_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <include layout="@layout/bitable_home_loading_v4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/home_tab_v4_list_container"
        android:background="@color/bitable_homepage_list_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bitable_homepage_list_section_height"
        android:layout_marginTop="@dimen/bitable_toolbar_height"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:radius="20dp"/>
    <View
        android:id="@+id/home_tab_v4_bg_header"
        android:background="@drawable/bitable_home_bg_v4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/home_tab_v4_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bitable_toolbar_height">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_tab_v4_title_bar_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/icon_n1"
            android:layout_centerVertical="true"
            android:layout_marginEnd="22dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_close_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_tab_v4_title_bar_search"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/icon_n1"
            android:layout_toLeftOf="@+id/home_tab_v4_title_bar_close"
            android:layout_centerVertical="true"
            android:layout_marginEnd="22dp"
            app:srcCompat="@drawable/ud_icon_search_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_tab_v4_title_bar_subscribe"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/icon_n1"
            android:layout_toLeftOf="@+id/home_tab_v4_title_bar_search"
            android:layout_centerVertical="true"
            android:layout_marginEnd="22dp"
            app:srcCompat="@drawable/ud_icon_subscribe_add_outlined"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:id="@+id/home_tab_v4_title_bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Home_Base_Tab"
            android:layout_centerInParent="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_tab_v4_title_bar_back"
            android:visibility="invisible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/icon_n1"
            android:layout_centerVertical="true"
            android:layout_marginStart="22dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/ud_icon_left_outlined"/>
    </RelativeLayout>
</FrameLayout>
