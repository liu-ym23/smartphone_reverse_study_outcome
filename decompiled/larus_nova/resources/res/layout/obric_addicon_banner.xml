<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/obric_bg_banner_popup_window"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_112">
    <ImageView
        android:id="@+id/obric_banner_icon"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/obric_icon_banner_popup_window"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/neutral_100"
        android:id="@+id/obric_banner_hint"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:text="@string/obric_add_doubao_icon_to_screen"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/obric_banner_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/obric_banner_btn_add"
        android:background="@drawable/obric_banner_add_bg"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_36"
        android:text="@string/obric_add"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/primary_50"
        android:gravity="center"
        android:id="@+id/obric_banner_btn_added"
        android:background="@drawable/obric_banner_added_bg"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:visibility="gone"
        android:layout_width="@dimen/dp_70"
        android:layout_height="@dimen/dp_36"
        android:text="@string/obric_added"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obric_banner_btn_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/obric_banner_btn_close"
        android:background="@drawable/obric_banner_close_selector"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/obric_banner_close"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
