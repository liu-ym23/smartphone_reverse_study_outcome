<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/video_view"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_300"
        android:layout_height="?attr/larus_dp_400"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_download"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_download_white_shadow"
        android:contentDescription="@string/larus_accessibility_save"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ProgressBar
        android:id="@+id/video_download_loading"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:padding="?attr/larus_dp_8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="@+id/video_download"
        app:layout_constraintEnd_toEndOf="@+id/video_download"
        app:layout_constraintStart_toStartOf="@+id/video_download"
        app:layout_constraintTop_toTopOf="@+id/video_download"/>
    <ImageView
        android:id="@+id/play_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="@drawable/larus_action_button_icon"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="@+id/video_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_cite"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:padding="?attr/larus_dp_7"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_reply"
        android:contentDescription="@string/larus_message_long_press_reply"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/larus_static_white"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/video_extend"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_8"
        android:text="@string/larus_extendVideo_label_btn_extend"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/video_view"/>
    <ViewStub
        android:id="@+id/video_loading"
        android:layout="@layout/larus_sketch_progress_loading"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/video_view"
        app:layout_constraintEnd_toEndOf="@+id/video_view"
        app:layout_constraintStart_toStartOf="@+id/video_view"
        app:layout_constraintTop_toTopOf="@+id/video_view"/>
    <ViewStub
        android:id="@+id/video_generate_failed_view_stub"
        android:layout="@layout/larus_layout_video_generate_failed"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/video_view"
        app:layout_constraintEnd_toEndOf="@+id/video_view"
        app:layout_constraintStart_toStartOf="@+id/video_view"
        app:layout_constraintTop_toTopOf="@+id/video_view"/>
</merge>
