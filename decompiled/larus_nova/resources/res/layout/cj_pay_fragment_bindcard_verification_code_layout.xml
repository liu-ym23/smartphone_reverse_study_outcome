<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_verification_code_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_gray_153"
        android:id="@+id/cj_pay_verification_code_sent_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:text="@string/cj_pay_bind_card_sms_verification_code_sended"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_red"
        android:id="@+id/cj_pay_verification_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/cj_pay_verification_code_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_14_with_half"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_14_with_half"
        android:layout_below="@+id/cj_pay_verification_code_sent_tip"
        android:layout_centerHorizontal="true">
        <com.android.ttcjpaysdk.base.ui.component.input.CJSmsCodeInputView
            android:id="@+id/cj_pay_new_verification_code_edit_view"
            android:visibility="gone"
            style="@style/CJ_Pay_New_Verification_Code_Style_Opt"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_agreement"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_verification_code_layout">
        <TextView
            android:textSize="?attr/cj_pay_page_size_14"
            android:textColor="?attr/cj_pay_text_quaternary"
            android:id="@+id/cj_pay_checkbox_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_14_with_half"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:text="@string/cj_pay_bind_card_agree"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="?attr/cj_pay_page_size_14"
            android:textColor="?attr/cj_pay_text_link_default"
            android:id="@+id/cj_pay_checkbox_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:text="@string/cj_pay_bind_card_service_agreement"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_blue"
        android:id="@+id/cj_pay_get_verification_code"
        android:paddingTop="@dimen/cj_pay_padding_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14.5dp"
        android:text="@string/cj_pay_bind_card_get_sms_verification_code_enable"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        android:layout_alignParentRight="true"/>
    <include layout="@layout/cj_pay_view_custom_keyboard_layout"/>
    <include layout="@layout/cj_pay_view_bandcard_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
