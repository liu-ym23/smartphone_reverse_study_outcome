<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_mid_bottom_item_area_height">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_ps_panel_word_75_gray"
        android:id="@+id/mark_user_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ps_mark_user_text"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tip_content"
        android:background="@drawable/ttlive_bg_float_window_tips"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="47dp"
        android:layout_marginLeft="1dp"
        android:layout_marginBottom="37dp"
        android:text="@string/ttlive_mark_user_tip_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/mark_user_text"/>
    <ImageView
        android:id="@+id/mark_user_tips"
        android:padding="10dp"
        android:layout_width="30dp"
        android:layout_height="36dp"
        android:src="@drawable/ttlive_ps_panel_mark_user_desc"
        android:scaleType="centerCrop"
        android:layout_toRightOf="@+id/mark_user_text"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/mark_user_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/btn_mark_user"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lsb_background="#21161823"
        app:lsb_border_width="1dp"
        app:lsb_checked_color="#67dca0"
        app:lsb_checkedbutton_color="#ffffff"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
