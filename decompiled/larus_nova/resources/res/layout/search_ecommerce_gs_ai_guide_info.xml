<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gs_ai_info_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ai_info_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/ai_summary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/ai_guide_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.bytedance.lighten.loader.SmartImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ai_left_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ai_guide_text"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/ai_guide_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ai_right_icon"
                app:layout_constraintStart_toEndOf="@+id/ai_left_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ai_right_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ai_guide_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
