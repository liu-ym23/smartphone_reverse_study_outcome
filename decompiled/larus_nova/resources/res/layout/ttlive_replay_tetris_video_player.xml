<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_ec_product_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/play_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vertical_thumb_process_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/thumb_process_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/play_bottom_area"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/interactive_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_vs_activity_interaction_height"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/play_tip_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="50dp"/>
        <FrameLayout
            android:id="@+id/bottom_right_banner_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="14dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/play_tip_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginBottom="50dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_tip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/vertical_version_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="6dp"/>
        <FrameLayout
            android:id="@+id/vertical_version_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toTopOf="@+id/play_control_container"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_control_container"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_high_light_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/progress_area_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_area_container"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/send_danmaku_control_container"
            app:layout_constraintStart_toEndOf="@+id/play_control_container"/>
        <FrameLayout
            android:id="@+id/send_danmaku_control_container"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/orientation_control_container"/>
        <FrameLayout
            android:id="@+id/orientation_control_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.livesdk.chatroom.replay.player.seekbar.ReplaySeekBar
        android:id="@+id/vertical_simple_progress_seekbar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginEnd="10dp"
        app:ttlive_background_progress_color="#383838"
        app:ttlive_measure_depend_on_dragging_radius="false"
        app:ttlive_progress_height="2dp"
        app:ttlive_progress_slide_height="10dp"
        app:ttlive_round_point_style="true"
        app:ttlive_secondary_progress_color="@color/transparent"
        app:ttlive_thumb_outer_stroke_color="#1affffff"
        app:ttlive_thumb_radius="2dp"
        app:ttlive_thumb_radius_on_dragging="15dp"
        app:ttlive_track_color="@color/white"
        app:ttlive_track_color_end="@color/white"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_lock_screen_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/vs_close_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/error_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/version_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/paid_ticket_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
