<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/open_rl_container"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/open_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/cancel"
            android:paddingLeft="19dp"
            android:paddingRight="19dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:src="@drawable/openplatform_auth_backpress_icon"
            android:scaleType="centerInside"
            android:contentDescription="@string/aweme_open_web_auth_cancel"
            android:paddingStart="19dp"
            android:paddingEnd="19dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/auth_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/aweme_open_auth_title"
            android:layout_centerInParent="true"
            android:contentDescription="@string/aweme_open_auth_title"/>
    </RelativeLayout>
    <View
        android:id="@+id/auth_top_divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/open_header_view"/>
    <FrameLayout
        android:id="@+id/open_loading_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/auth_top_divider"/>
</RelativeLayout>
