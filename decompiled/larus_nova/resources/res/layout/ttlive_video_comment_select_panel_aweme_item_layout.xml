<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/item_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ttlive_video_comment_select_panel_item_mask_bottom"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_cover"
        app:layout_constraintEnd_toEndOf="@+id/item_cover"
        app:layout_constraintLeft_toLeftOf="@+id/item_cover"
        app:layout_constraintRight_toRightOf="@+id/item_cover"
        app:layout_constraintStart_toStartOf="@+id/item_cover"/>
    <View
        android:id="@+id/item_selected_mask"
        android:background="#56000000"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_cover"
        app:layout_constraintEnd_toEndOf="@+id/item_cover"
        app:layout_constraintLeft_toLeftOf="@+id/item_cover"
        app:layout_constraintRight_toRightOf="@+id/item_cover"
        app:layout_constraintStart_toStartOf="@+id/item_cover"
        app:layout_constraintTop_toTopOf="@+id/item_cover"/>
    <ImageView
        android:id="@+id/item_like_ic"
        android:background="@drawable/ttlive_video_comment_select_panel_like_ic"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_cover"
        app:layout_constraintLeft_toLeftOf="@+id/item_cover"
        app:layout_constraintStart_toStartOf="@+id/item_cover"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:id="@+id/item_like_count_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_like_ic"
        app:layout_constraintLeft_toRightOf="@+id/item_like_ic"
        app:layout_constraintStart_toEndOf="@+id/item_like_ic"
        app:layout_constraintTop_toTopOf="@+id/item_like_ic"/>
    <ImageView
        android:id="@+id/item_select"
        android:background="@drawable/ttlive_video_comment_select_panel_unselect_bg"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="@+id/item_cover"
        app:layout_constraintTop_toTopOf="@+id/item_cover"/>
</androidx.constraintlayout.widget.ConstraintLayout>
