<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_end_close"
        android:background="@drawable/ttlive_liveroom_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_end_title_position"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_end_title_position"/>
    <View
        android:id="@+id/live_end_title_position"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/live_end_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/ttlive_live_end_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_end_title_position"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/live_end_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="61dp"
        android:text="@string/ttlive_live_end_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ttlive_core_hs_s5_50"
        android:id="@+id/live_end_user_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_end_title_position"/>
    <View
        android:id="@+id/avatar_position"
        android:background="@drawable/ttlive_bg_avatar_border"
        android:visibility="gone"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_end_user_count"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/user_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_end_user_count"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/follow"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="43dp"
        android:src="@drawable/ttlive_ic_live_follow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
    <ImageView
        android:id="@+id/follow_icon"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="43dp"
        android:src="@drawable/ttlive_ic_live_follow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/user_name_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/user_avatar">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_hs_sys3"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="7"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:gravity="center"
            android:id="@+id/user_verify_tag"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_core_hs_s5_50"
            android:id="@+id/room_tag"
            android:background="@drawable/ttlive_bg_live_end_room_tag"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:minHeight="154dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name_container"
        layout="@layout/ttlive_layout_live_end_recommend_window"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_core_hs_s5_50"
        android:gravity="center"
        android:id="@+id/anchor_prediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_subscribe_opt"
        android:background="@drawable/ttlive_bg_announcement_live_end_subscribe_bg"
        android:visibility="gone"
        android:layout_width="89dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor_prediction">
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/subscribe_announcement_icon_opt"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/live_announcement_unsubscribed_icon_opt"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/subscribe_announcement_desc_opt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预约直播"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_subscribe_without_announcement"
        android:background="@drawable/ttlive_bg_announcement_live_end_subscribe_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_subscribe_opt">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_subscribe_without_announcement_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/live_no_announcement_unsubscribed_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#e5ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_subscribe_without_announcement_icon_desc"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="开播通知我"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/anchor_announcement_subscribe_container"
        android:background="@drawable/ttlive_bg_announcement_live_end_like"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_subscribe_without_announcement">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/subscribe_announcement_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_ic_announcement_like"/>
        <TextView
            android:textColor="#e6ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/subscribe_announcement_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_live_end_i_want_to_look"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/self_rank_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/anchor_announcement_subscribe_container">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_core_hs_s5_50"
            android:layout_gravity="center_vertical"
            android:id="@+id/self_total_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/divider"
            android:background="@drawable/ttlive_divide_line_live_end"
            android:layout_width="0.5dp"
            android:layout_height="12dp"
            android:layout_marginLeft="8.5dp"
            android:layout_marginRight="8.5dp"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s5_50"
            android:layout_gravity="center_vertical"
            android:id="@+id/self_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/reverve_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/self_rank_info_container">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_core_hs_s5_50"
            android:layout_gravity="center_vertical"
            android:id="@+id/reserve_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_core_hs_sys3"
            android:layout_gravity="center_vertical"
            android:id="@+id/reserve_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/live_tab_recom_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@+id/reverve_container">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/live_tab_recom_button"
            android:background="@drawable/ttlive_bg_end_page_live_tab_recom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_end_page_live_tab_recom"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ttlive_arrowrright_icon"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/live_tab_recom_button_new"
            android:background="@drawable/ttlive_bg_end_page_live_tab_recom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/guide_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="5:2"
                app:layout_constraintHeight_max="64dp"
                app:layout_constraintHeight_min="56dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/guide_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="160dp"
                app:layout_constraintWidth_min="140dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/guide_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_end_page_live_tab_recom_new"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/guide_image"
                app:layout_constraintRight_toLeftOf="@+id/guide_arrow"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/guide_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_arrowrright_icon"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/guide_text"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/live_end_replay_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@+id/user_name_container">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:gravity="center"
                android:id="@+id/live_end_replay_generating"
                android:visibility="gone"
                android:layout_width="115dp"
                android:layout_height="38dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/live_end_go_replay_page"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="32dp"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/live_end_replay_hit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.5"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
