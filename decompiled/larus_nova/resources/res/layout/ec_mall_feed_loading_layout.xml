<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/lv_feed_loading_slogan"
        android:layout_width="164dp"
        android:layout_height="48dp"
        app:lottie_autoPlay="true"
        app:lottie_fileName="ec_mall_load_more_footer_lottie.json"
        app:lottie_loop="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_feed_error_container"
        android:layout_width="match_parent"
        android:layout_height="261dp">
        <ImageView
            android:layout_width="120dp"
            android:layout_height="177dp"
            android:src="@drawable/ec_mall_feed_status_error"/>
        <Button
            android:textSize="15dp"
            android:id="@+id/bt_feed_error_retry"
            android:background="@drawable/ec_mall_error_retry_button_bg"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/shopping_mall_refresh"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_feed_empty_container"
        android:layout_width="match_parent"
        android:layout_height="261dp">
        <ImageView
            android:layout_width="120dp"
            android:layout_height="176dp"
            android:src="@drawable/ec_mall_feed_status_empty"/>
    </LinearLayout>
</FrameLayout>
