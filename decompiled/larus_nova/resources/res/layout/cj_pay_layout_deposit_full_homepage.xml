<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_deposit_homepage_layout"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_background_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cj_pay_bg_light_brand_low_opacity"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_deposit_homepage_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <RelativeLayout
            android:id="@+id/cj_top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="44dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_nav_close_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cj_pay_sign_and_pay_left_leave"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/cj_nav_logo"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="true"
            android:layout_weight="1"
            android:overScrollMode="never">
            <include
                android:id="@+id/cj_deposit_main_info_section"
                layout="@layout/cj_pay_deposit_core_info_layout"/>
        </androidx.core.widget.NestedScrollView>
        <include
            android:id="@+id/cj_deposit_marketing_section"
            layout="@layout/cj_pay_layout_voucher_label_section"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/cj_deposit_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/cj_deposit_bottom_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="-8dp"
            app:theme_type="0"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="20dp"/>
    </LinearLayout>
</FrameLayout>
