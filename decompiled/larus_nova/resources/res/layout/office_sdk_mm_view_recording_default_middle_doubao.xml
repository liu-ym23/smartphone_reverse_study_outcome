<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.officesdk.minutes.ui.foundation.widget.HideKeyboardLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mmMiddleContainerArea"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mmTabLayoutContainerFl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp">
        <com.larksuite.component.universe_design.tab.UDTabLayout
            android:id="@+id/mmTabLayout"
            android:background="@color/flow_ud_bg_base_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ud_tab_backgroundColor="@color/transparent"
            app:ud_tab_bottomDividerEnabled="false"
            app:ud_tab_gravity="start"
            app:ud_tab_indicatorColor="@color/flow_ud_neutral_100"
            app:ud_tab_indicatorFullWidth="false"
            app:ud_tab_indicatorHeight="2dp"
            app:ud_tab_mode="auto"
            app:ud_tab_paddingEnd="10dp"
            app:ud_tab_tabMargin="4dp"
            app:ud_tab_titleColor="@color/office_sdk_mm_color_recording_tab_title_doubao"
            app:ud_tab_titleSize="16sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_new_summary_indicator"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            app:srcCompat="@drawable/office_sdk_mm_ic_meeting_ai_filled_doubao"/>
    </FrameLayout>
    <View
        android:id="@+id/dividerLine"
        android:background="@color/flow_ud_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <FrameLayout
        android:id="@+id/notificationContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmViewPagerGestureArbiterLayout
        android:id="@+id/mmViewPagerArbiter"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/mmViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmViewPagerGestureArbiterLayout>
</com.ss.android.lark.officesdk.minutes.ui.foundation.widget.HideKeyboardLinearLayout>
