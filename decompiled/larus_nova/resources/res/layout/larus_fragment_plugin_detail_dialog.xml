<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_cornerRadius_TL="?attr/larus_dp_20"
        app:rv_cornerRadius_TR="?attr/larus_dp_20">
        <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_base_2_overlay"
            app:rv_cornerRadius_TL="?attr/larus_dp_20"
            app:rv_cornerRadius_TR="?attr/larus_dp_20"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/plugin_icon"
            android:layout_width="?attr/larus_dp_72"
            android:layout_height="?attr/larus_dp_72"
            android:layout_marginTop="?attr/larus_dp_24"
            android:layout_marginStart="?attr/larus_dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_icon"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_14"
            android:scaleType="center"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_plugin_dialog_close"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/plugin_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_26"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_52"
            app:layout_constraintBottom_toTopOf="@+id/plugin_author"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/plugin_icon"
            app:layout_constraintTop_toTopOf="@+id/plugin_icon"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/plugin_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_21"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_52"
            app:layout_constraintBottom_toBottomOf="@+id/plugin_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/plugin_icon"
            app:layout_constraintTop_toBottomOf="@+id/plugin_name"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="start"
            android:id="@+id/plugin_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_24"
            android:maxLines="6"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/plugin_icon"/>
        <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
            android:id="@+id/plugin_full_auth_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/plugin_desc"
            app:rv_backgroundColor="?attr/larus_base_3"
            app:rv_cornerRadius="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/full_auth_always"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_plugin_always_allow_btn"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/divider1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider1"
                android:background="?attr/larus_base_2_overlay"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                app:layout_constraintBottom_toTopOf="@+id/full_auth_once"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/full_auth_always"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/full_auth_once"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_plugin_allow_btn"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/divider2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider1"/>
            <View
                android:id="@+id/divider2"
                android:background="?attr/larus_base_2_overlay"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                app:layout_constraintBottom_toTopOf="@+id/full_auth_deny"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/full_auth_once"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_danger_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/full_auth_deny"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_plugin_decline_btn"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider2"/>
        </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
        <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
            android:id="@+id/plugin_part_auth_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/plugin_desc"
            app:rv_backgroundColor="?attr/larus_base_3"
            app:rv_cornerRadius="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/part_auth_always"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_plugin_always_allow_btn"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/divider4"
                app:layout_constraintEnd_toStartOf="@+id/part_auth_always_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="?attr/larus_dp_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/part_auth_always_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:scaleType="center"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/part_auth_always"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/part_auth_always"
                app:layout_constraintTop_toTopOf="@+id/part_auth_always"
                app:srcCompat="?attr/larus_ic_plugin_dialog_select"/>
            <View
                android:id="@+id/divider4"
                android:background="?attr/larus_base_2_overlay"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/part_auth_always"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/part_auth_ask"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_plugin_always_ask_permission"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/part_auth_ask_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider4"
                app:layout_goneMarginEnd="?attr/larus_dp_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/part_auth_ask_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:scaleType="center"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/part_auth_ask"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/part_auth_ask"
                app:layout_constraintTop_toTopOf="@+id/part_auth_ask"
                app:srcCompat="?attr/larus_ic_plugin_dialog_select"/>
        </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
