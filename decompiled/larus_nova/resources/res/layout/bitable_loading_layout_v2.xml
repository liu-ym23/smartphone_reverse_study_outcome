<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/card_view"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/recordcard_close"
        android:paddingLeft="@dimen/dp_12"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="6dp"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/icon_n1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_left_outlined"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.facade.common.widget.BearLottieView
            android:layout_gravity="center"
            android:id="@+id/loadingIcon"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"
            style="@style/BearLottieView"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/Doc_Doc_CoverLoading"/>
    </LinearLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:layout_gravity="center"
        android:id="@+id/emptyView"
        android:paddingTop="@dimen/space_kit_len_16"
        android:paddingBottom="@dimen/space_kit_len_16"
        android:visibility="gone"
        android:layout_height="match_parent"
        app:ud_empty_imageRes="@drawable/empty_search"
        app:ud_empty_primaryText="@string/Bitable_Common_ButtonRetry"
        style="@style/SpaceEmptyStatusStyle"/>
</FrameLayout>
