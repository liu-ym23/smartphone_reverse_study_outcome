<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/insufficient_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/insufficient_text_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/insufficient_bank_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="2dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/insufficient_text_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/insufficient_text_below_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_orange_1"
            android:id="@+id/insufficient_text_below_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
