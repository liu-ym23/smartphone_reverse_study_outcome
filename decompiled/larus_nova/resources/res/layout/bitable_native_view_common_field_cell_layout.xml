<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fieldNameContainer"
        android:layout_width="match_parent"
        android:layout_height="18dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/fieldName"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
            android:layout_gravity="center_vertical"
            android:id="@+id/fieldNameLoading"
            android:background="@drawable/bitable_native_view_loading_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:maxWidth="48dp"
            app:widthPercent="0.8"/>
    </FrameLayout>
    <View
        android:id="@+id/horizontalSpace"
        android:layout_width="8dp"
        android:layout_height="3dp"/>
    <FrameLayout
        android:id="@+id/cellViewContainer"
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonCellView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/cellView"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
            android:layout_gravity="center_vertical"
            android:id="@+id/cellValueLoading"
            android:background="@drawable/bitable_native_view_loading_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:widthPercent="0.95"/>
    </FrameLayout>
</LinearLayout>
