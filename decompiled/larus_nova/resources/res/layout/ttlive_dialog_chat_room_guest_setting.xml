<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ttlive_ic_distribute_help_back"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_setting_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_setting_tips"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:id="@+id/tv_setting_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_live_interact_guest_setting"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_line"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_tips"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ct_link_distribute_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line">
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:id="@+id/tv_link_distribute_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_chatroom_distribute_tips"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_link_distribute_tips"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_link_distribute_more"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_link_distribute_tips"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_link_distribute_tips">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ttlive_room_notice_dialog_disable_textcolor"
                android:id="@+id/tv_link_distribute_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/ttlive_live_link_distribute_state_close"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/iv_link_distribute_state"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/link_distribute_setting_more"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_distribute_to_friend"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginRight="16dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/tv_tips"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="66dp"
            android:text="@string/ttlive_chatroom_distribute_tips_to_setting"
            android:maxLines="2"
            android:singleLine="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/switch_distribute_to_friend"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
