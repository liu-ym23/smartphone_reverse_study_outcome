<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.shadow.ShadowLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="128dp"
    android:layout_height="122dp"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginBottom="@dimen/dp_10"
    app:radius="@dimen/space_radius_m"
    app:shadowAlpha="0.5"
    app:shadowElevation="5dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/template_top"
            android:background="@drawable/template_top_border"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/template_bg"
            android:background="@color/static_white"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/template_top"/>
        <com.bytedance.ee.bear.facade.common.widget.NiceImageView
            android:id="@+id/templateImg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/template_bg"
            app:layout_constraintLeft_toLeftOf="@+id/template_bg"
            app:layout_constraintRight_toRightOf="@+id/template_bg"
            app:layout_constraintTop_toTopOf="@+id/template_bg"/>
        <View
            android:background="@color/space_template_image_mask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/template_bg"
            app:layout_constraintLeft_toLeftOf="@+id/template_bg"
            app:layout_constraintRight_toRightOf="@+id/template_bg"
            app:layout_constraintTop_toTopOf="@+id/template_bg"/>
        <com.bytedance.ee.bear.facade.common.widget.NiceImageView
            android:id="@+id/operationLabelImg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginStart="1dp"
            android:elevation="8dp"
            app:corner_top_right_radius="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/horizontal_template_item_liner_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/templateImg"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/typeIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/templateImg"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/templateNameTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/typeIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/typeIcon"
            app:layout_constraintTop_toTopOf="@+id/typeIcon"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/labelTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.ee.bear.shadow.ShadowLinearLayout>
