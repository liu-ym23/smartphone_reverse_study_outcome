<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/add_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@color/primary_on_primary_fill"
        app:srcCompat="@drawable/ud_icon_add_outlined"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textColor="@color/primary_on_primary_fill"
        android:gravity="center"
        android:id="@+id/add_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Bitable_HomeDashboard_AddCharts_Button"
        android:layout_marginStart="4dp"/>
</LinearLayout>
