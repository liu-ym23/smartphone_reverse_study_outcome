<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_left_back"
        android:contentDescription="@null"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/password_container"
        android:paddingLeft="?attr/larus_dp_19"
        android:paddingRight="?attr/larus_dp_19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        app:layout_constraintVertical_bias="0.33">
        <ImageView
            android:id="@+id/iv_lock"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:layout_margin="?attr/larus_dp_18"
            android:src="@drawable/larus_office_no_permission_lock"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/tv_password_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_24"
            android:text="@string/larus_office_title_enterPassword"/>
        <EditText
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/neutral_100"
            android:textColorHint="@color/neutral_50"
            android:gravity="center_vertical"
            android:id="@+id/et_password"
            android:background="@drawable/larus_bg_input_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_48"
            android:hint="@string/larus_office_placeholder_enterPassword"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="textPassword"
            style="@style/larus_EditTextStyle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_confirm"
            android:background="@drawable/larus_bg_button_register_flow"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginTop="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_32">
            <ProgressBar
                android:id="@+id/pb_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:indeterminateTint="@android:color/white"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/tv_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_office_btn_confirm"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
