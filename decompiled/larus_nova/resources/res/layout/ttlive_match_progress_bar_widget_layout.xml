<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.progressbar.ForceInterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="11dp"
            android:typeface="normal"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/progress_current_time"
            android:layout_width="50dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.8"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_seekbar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vs_seek_to_now"
            android:background="@drawable/ttlive_bg_match_seek_to_now"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="23dp"
            app:layout_constraintBottom_toTopOf="@+id/vs_progress_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_match_seek_to_now"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_std_text_white_1"
                android:id="@+id/ttlive_vs_seek_to_now_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:text="@string/ttlive_match_seek_to_now_text"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.livesdk.chatroom.progressbar.ui.PlayerSeekBar
            android:id="@+id/vs_progress_seekbar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/progress_current_time"
            app:layout_goneMarginEnd="10dp"
            app:ttlive_background_progress_color="@color/ttlive_progress_track_bg_color"
            app:ttlive_measure_depend_on_dragging_radius="false"
            app:ttlive_progress_height="3dp"
            app:ttlive_round_point_style="true"
            app:ttlive_secondary_progress_color="@color/transparent"
            app:ttlive_thumb_outer_stroke_color="@color/ttlive_vs_progress_outer_stroke_color"
            app:ttlive_thumb_radius="6dp"
            app:ttlive_thumb_radius_on_dragging="15dp"
            app:ttlive_track_color="#b3ffffff"
            app:ttlive_track_color_end="#b3ffffff"
            app:ttlive_track_color_slide="#e5ffffff"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vs_progress_high_light_pop_holder"
            android:padding="0.5dp"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/progress_current_time">
            <LinearLayout
                android:id="@+id/vs_progress_high_light_pop_root"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <include layout="@layout/ttlive_match_progress_bar_highlight_pop"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.chatroom.progressbar.ForceInterceptConstraintLayout>
