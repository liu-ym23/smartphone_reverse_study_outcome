<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.deepfeed.weights.DeepFeedFragmentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_root_view"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/skeleton_diagram_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/shopping_ic_deepfeed_product_bg"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <com.bytedance.android.shopping.deepfeed.ui.DeepFeedProductRecyclerview
        android:id="@+id/rv_cards"
        android:background="@color/black"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/cover_top_mask"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/slice_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_bar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/shopping_ic_deepfeed_topbar_back"
            app:customMarginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
            android:id="@+id/iv_cart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/shopping_ic_deepfeed_topbar_cart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/cart_anim_view"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
            android:id="@+id/iv_fold_back"
            android:visibility="gone"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/shopping_ic_deepfeed_topbar_fold_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenSimpleDraweeView
            android:id="@+id/shop_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            app:customBg="@android:color/white"
            app:customRadius="6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shop_dance_log"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/shop_logo"
            app:layout_constraintEnd_toEndOf="@+id/shop_logo"
            app:layout_constraintStart_toStartOf="@+id/shop_logo"
            app:layout_constraintTop_toTopOf="@+id/shop_logo"/>
        <com.bytedance.android.shopping.deepfeed.weights.common.ProductMarqueeTextView
            android:textSize="16dp"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/shop_name"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:shadowColor="#1f000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="4"
            android:layout_marginStart="8dp"
            app:ec_scroll_max_loop="1"
            app:ec_scroll_start_delay="1000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/shop_logo"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/deep_feed_net_error_stub"
        android:layout="@layout/shopping_deepfeed_net_error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/deep_feed_swipe_down_for_tips_card_stub"
        android:layout="@layout/shopping_deep_feed_swipe_down_for_tips"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deep_feed_popup_stub"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/deep_feed_popup_bg"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <FrameLayout
            android:id="@+id/deep_feed_popup_lynx_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/deep_feed_popup_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.shopping.deepfeed.weights.DeepFeedFragmentView>
