<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/vs_author_reputation_horizontal_style"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ec_color_black_text_level1"
        android:id="@+id/tv_author_reputation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:id="@+id/tv_author_reputation_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"/>
    <TextView
        android:textSize="14dp"
        android:id="@+id/tv_author_reputation_level"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginStart="2dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ec_color_black_161823_50"
        android:id="@+id/tv_author_reputation_no_data"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/ec_author_reputation_no_data"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/iv_reputation_forward"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:src="@drawable/ec_icon_reputation_forward"
        android:contentDescription="@string/ec_button"
        android:layout_marginStart="2dp"/>
</LinearLayout>
