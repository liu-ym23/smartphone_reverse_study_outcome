<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_ai_proactive_task_card"
    android:paddingTop="12dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/ai_proactive_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/ai_proactive_item_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.view.item.CustomSwitchCompat
        android:id="@+id/ai_proactive_item_switch"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ai_proactive_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ai_proactive_item_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="@color/larus_neutral_70"
        android:ellipsize="end"
        android:id="@+id/ai_proactive_item_desc_line1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ai_proactive_item_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/ai_proactive_item_desc_line2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ai_proactive_item_desc_line1"/>
    <Space
        android:id="@+id/ai_proactive_item_bottom_gap"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toTopOf="@+id/ai_proactive_task_bottom_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ai_proactive_item_desc_line2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ai_proactive_task_bottom_banner"
        android:background="@drawable/larus_bg_ai_proactive_task_bottom_banner"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ai_proactive_item_bottom_gap">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ai_proactive_head_down_calibration_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/larus_dora_avlink_ai_proactive_info"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/larus_additional_brown"
            android:ellipsize="end"
            android:id="@+id/ai_proactive_head_down_calibration_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_ai_active_head_down_calibration_banner_desc_cn"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ai_proactive_head_down_calibration_action"
            app:layout_constraintStart_toEndOf="@+id/ai_proactive_head_down_calibration_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/primary_50"
            android:id="@+id/ai_proactive_head_down_calibration_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_ai_active_head_down_calibration_banner_button_cn"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
