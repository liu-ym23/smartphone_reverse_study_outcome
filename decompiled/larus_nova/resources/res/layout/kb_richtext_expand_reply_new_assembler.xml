<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/status_transform_btn"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:tint="@color/icon_n3"
        app:layout_constraintLeft_toRightOf="@+id/kb_rich_text_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_fold_btn"/>
    <com.ss.android.lark.keyboard.edittext2.KeyboardFunctionEditText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center_vertical"
        android:id="@+id/kb_rich_text_title"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:hint="@string/Lark_Legacy_ComposePostTitle"
        android:lineSpacingExtra="3sp"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/text_cursor_drawable_ig"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/status_transform_btn"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
