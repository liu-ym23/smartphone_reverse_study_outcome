<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background_iv"
        android:background="@drawable/ttlive_bg_vigo_webp_enter"
        android:layout_width="250dp"
        android:layout_height="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatar_icon"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginLeft="1dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_iv"
        app:layout_constraintLeft_toLeftOf="@+id/background_iv"
        app:layout_constraintTop_toTopOf="@+id/background_iv"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/honor_icon"
        android:layout_width="30dp"
        android:layout_height="16dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_iv"
        app:layout_constraintLeft_toRightOf="@+id/avatar_icon"
        app:layout_constraintTop_toTopOf="@+id/background_iv"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:ellipsize="none"
        android:id="@+id/description_tv"
        android:layout_width="102dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_iv"
        app:layout_constraintLeft_toRightOf="@+id/honor_icon"
        app:layout_constraintTop_toTopOf="@+id/background_iv"/>
    <com.bytedance.android.livesdk.interactivity.enteranim.view.BaseLightView
        android:id="@+id/base_light_view"
        android:layout_width="140dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_iv"
        app:layout_constraintLeft_toLeftOf="@+id/honor_icon"
        app:layout_constraintTop_toTopOf="@+id/background_iv"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/anim_icon"
        android:layout_width="107dp"
        android:layout_height="65dp"
        android:layout_marginLeft="190dp"
        android:layout_marginStart="190dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/background_iv"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
