<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/menu_icon_border"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_42"
        android:layout_height="?attr/larus_dp_42"
        app:layout_constraintBottom_toBottomOf="@+id/iv_menu_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_menu_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_menu_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_menu_icon"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_menu_icon"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_22"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/larus_neutral_transparent_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_menu_badge"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        app:actualImageScaleType="fitXY"
        app:failureImage="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/iv_menu_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_menu_icon"
        app:roundBottomEnd="true"
        app:roundBottomStart="false"
        app:roundTopEnd="false"
        app:roundTopStart="false"
        app:roundedCornerRadius="?attr/larus_dp_7"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_text_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_arrow"
        app:layout_constraintStart_toEndOf="@+id/iv_menu_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/tv_menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/tv_menu_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_menu_arrow"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:src="@drawable/larus_ic_chevron_right"
        android:layout_marginEnd="?attr/larus_dp_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
