<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_header_container"
    android:background="@drawable/commerce_bg_comment_header_with_sort_button"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/commerce_color_FF161823"
            android:id="@+id/sort_default_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_comment_comprehensive_button_text"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/commerce_color_1F161823"
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/commerce_color_99161823"
            android:id="@+id/sort_latest_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_comment_update_to_date_button_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_iv_tip_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="3dp"
            app:layoutMode="square"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_color_57161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_tv_comment_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/explain_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
