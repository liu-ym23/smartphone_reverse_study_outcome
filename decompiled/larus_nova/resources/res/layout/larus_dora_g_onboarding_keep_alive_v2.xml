<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/dora_onboarding_keep_alive_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_32"
            android:layout_marginTop="?attr/larus_dp_164"
            android:layout_marginRight="?attr/larus_dp_32">
            <ImageView
                android:layout_width="?attr/larus_dp_160"
                android:layout_height="?attr/larus_dp_160"
                android:src="@drawable/larus_dora_onboarding_keep_alive_avatar_img"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_23"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_33"
                android:text="@string/larus_dora_onboarding_keep_alive_title_cn"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_neutral_70"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:text="@string/larus_dora_g_onboard_keep_active_cn"
                android:lineSpacingMultiplier="1.2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
    <include
        android:id="@+id/dora_g_onboarding_bottom_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/larus_dora_g_onboarding_bottom_btn_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
