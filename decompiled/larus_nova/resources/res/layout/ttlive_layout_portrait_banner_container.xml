<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portrait_banner_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/portrait_activity_indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"/>
    <FrameLayout
        android:id="@+id/portrait_predictor_entrance_container"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_multi_top_right_banner_width"
        android:layout_height="@dimen/ttlive_room_top_right_banner_height"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"/>
</FrameLayout>
