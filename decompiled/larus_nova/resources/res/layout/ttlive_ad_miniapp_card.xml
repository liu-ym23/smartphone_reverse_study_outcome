<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_ad_miniapp_card"
    android:background="@drawable/ttlive_live_miniapp_card_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="112dp">
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
        android:id="@+id/ttlive_ad_miniapp_card_snapshot"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:scaleType="matrix"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_radius_top_left="6dp"
        app:ttlive_radius_top_right="6dp"/>
    <View
        android:id="@+id/ttlive_snapshot_bottom_bg_top"
        android:background="@drawable/ttlive_ad_miniapp_gradual_bg_top"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintStart_toStartOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintTop_toTopOf="@+id/ttlive_ad_miniapp_card_snapshot"/>
    <View
        android:id="@+id/ttlive_snapshot_bottom_bg_2"
        android:background="@drawable/ttlive_ad_miniapp_gradual_bg_bottom"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintStart_toStartOf="@+id/ttlive_ad_miniapp_card_snapshot"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/ttlive_minicard_left_top_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintTop_toTopOf="@+id/ttlive_ad_miniapp_card_snapshot">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ttlive_minicard_left_top_circle"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_minicard_left_top_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_mini_app_talking"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ttlive_ad_miniapp_card_close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ttlive_ad_miniapp_close_button"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
        android:id="@+id/ttlive_ad_miniapp_card_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:layout_constraintStart_toStartOf="@+id/ttlive_ad_miniapp_card_snapshot"
        app:ttlive_radius="2dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/ttlive_ad_miniapp_card_name"
        android:layout_width="84dp"
        android:layout_height="14dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_ad_miniapp_card_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ttlive_ad_miniapp_card_icon"
        app:layout_constraintTop_toTopOf="@+id/ttlive_ad_miniapp_card_icon"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ttlive_layout_ad_miniapp_card_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_ad_miniapp_card_snapshot">
        <TextView
            android:textSize="10dp"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/ttlive_ad_miniapp_card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="100dp"
            android:maxLines="2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/supplement_info_layout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <com.bytedance.android.livesdk.chatroom.miniapp.views.CardAvatarsLayout
                android:id="@+id/avatar_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/supplement_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/ttlive_live_miniapp_card_button_bg"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/ttlive_live_miniapp_card_btn_text_view_details"
        android:shadowColor="#56000000"
        android:shadowDy="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_layout_ad_miniapp_card_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
