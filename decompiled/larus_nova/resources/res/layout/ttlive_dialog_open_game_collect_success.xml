<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/ttlive_bg_collect_success"
    android:layout_width="match_parent"
    android:layout_height="368dp">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_open_game_collect_success_dialog_title"
        android:layout_marginStart="@dimen/ttlive_open_game_collect_success_text_margin_start"
        android:layout_marginEnd="@dimen/ttlive_open_game_collect_success_text_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:gravity="center"
        android:id="@+id/collect_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_open_game_collect_success_dialog_desc"
        android:layout_marginStart="@dimen/ttlive_open_game_collect_success_text_margin_start"
        android:layout_marginEnd="@dimen/ttlive_open_game_collect_success_text_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/revisit_collect_game_tip"
        android:layout_width="0dp"
        android:layout_height="168dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/ttlive_open_game_collect_success_image_horizontal_margin"
        android:layout_marginEnd="@dimen/ttlive_open_game_collect_success_image_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/collect_desc"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/user_understand"
        android:background="@drawable/ttlive_bg_game_collect_success_btn"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_open_game_collect_success_dialog_btn_text"
        android:layout_marginStart="@dimen/ttlive_open_game_collect_success_btn_horizontal_margin"
        android:layout_marginEnd="@dimen/ttlive_open_game_collect_success_btn_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/revisit_collect_game_tip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
