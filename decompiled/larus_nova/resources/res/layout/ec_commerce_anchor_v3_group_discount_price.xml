<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.AutoResizePriceContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_group_discount_price_596117221"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_discount_price_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_discount_price_divider"
        android:layout_width="0.5dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/commerce_anchor_v3_divider"
        android:scaleType="centerCrop"
        android:layout_toRightOf="@+id/tv_discount_price_text"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tv_discount_price_text"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/tv_discount_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/iv_discount_price_divider"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/iv_discount_price_divider"
        app:extraTextColor="@android:color/white"
        app:extraTextSize="10sp"
        app:priceBold="true"
        app:priceDecimalTextSize="15sp"
        app:priceText="78.88"
        app:priceTextColor="@android:color/white"
        app:priceTextSize="17sp"
        app:spaceSize="2dp"
        app:yangTextSize="13sp"/>
</com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
