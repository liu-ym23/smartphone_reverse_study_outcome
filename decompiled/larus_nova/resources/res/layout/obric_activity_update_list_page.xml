<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.common_ui.view.ChatSettingScrollView
            android:id="@+id/scroll_view"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_38"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/larus_layout_common_padding"
            android:paddingEnd="@dimen/larus_layout_common_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/user_agreement"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_term_of_use"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/privacy_policy_abs"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_privacy_terms_abs_cn"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/privacy_policy"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_privacy_policy"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/sensitive_permissions"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_settings_privacy_access_cn"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/community_guidelines"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_community_guidelines"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/protect_guideline"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_ip_protection_guideline_cn"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/bug_submission"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_subEntry_aboutCiCiPage_menuLink"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/business_license"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_aboutdoubao_license_commercial_cn"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/icp_record"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_aboutdoubao_license_icp_cn"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/about_sky_luck"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/business_ipc_oco"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_wangwen_certificate"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/business_ipc_operate"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_icp_certificate"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/about_stop_app_service"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/about_check_app_update"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.larus.bmhome.view.item.ItemGroup>
                <TextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/neutral_50"
                    android:gravity="center"
                    android:id="@+id/model_detail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"/>
            </LinearLayout>
        </com.larus.common_ui.view.ChatSettingScrollView>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_50"
            android:gravity="center"
            android:id="@+id/hotline"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_hotline_desc_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
