<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintDimensionRatio="9:16"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
        <include
            android:id="@+id/left_check_box"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/larus_layout_ai_gen_bg_choose_check_box"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_8">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintDimensionRatio="9:16"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
        <include
            android:id="@+id/center_check_box"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/larus_layout_ai_gen_bg_choose_check_box"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_8">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/right"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintDimensionRatio="9:16"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
        <include
            android:id="@+id/right_check_box"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/larus_layout_ai_gen_bg_choose_check_box"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
