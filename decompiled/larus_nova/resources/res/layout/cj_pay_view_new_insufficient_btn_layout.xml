<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/insufficient_confirm_btn_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/insufficient_confirm_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/insufficient_confirm_normal_loading"
        android:background="@color/cj_pay_color_trans"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
        android:indeterminateDuration="500"
        android:indeterminateBehavior="repeat"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/insufficient_confirm_no_pwd_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:layout_gravity="center"
            android:background="@color/cj_pay_color_trans"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_button_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/insufficient_confirm_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/cj_pay_one_step_pay_paying"/>
    </LinearLayout>
</FrameLayout>
