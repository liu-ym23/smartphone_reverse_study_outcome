<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_shop_top_info_bar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/ec_shop_status_bar_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ec_shop_top_bar_container_inner"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ec_store_top_bar_height_without_status_bar_style_a"
            android:paddingEnd="12dp">
            <ImageView
                android:id="@+id/ec_shop_top_bar_back_btn"
                android:tag="anchor_window_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ec_window_ic_back_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ec_window_click_enter_live_hint"
                android:visibility="gone"
                android:layout_width="182dp"
                android:layout_height="18dp"
                android:src="@drawable/ec_window_click_enter_live_icon"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/ec_shop_head_info_area_container"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ec_shop_top_bar_back_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_top_bar_action_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toRightOf="@+id/ec_shop_head_info_area_container"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.window.shop.widget.topbar.ECWindowSearchView
                    android:id="@+id/ec_shop_top_bar_search_placeholder"
                    android:tag="anchor_window_search"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ec_window_ic_search_white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ViewStub
                    android:id="@+id/ec_shop_top_bar_im_entry"
                    android:layout="@layout/ec_window_generic_icon_view"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="12dp"/>
                <ImageView
                    android:id="@+id/ec_shop_top_bar_more_btn"
                    android:tag="anchor_window_more"
                    android:focusable="true"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/ec_window_ic_more_white"
                    android:contentDescription="@string/shopping_more"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
