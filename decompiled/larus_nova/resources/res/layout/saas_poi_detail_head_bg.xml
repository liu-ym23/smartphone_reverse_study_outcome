<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_detail_head_bg_1385699547"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.poi.newdetail.widget.PoiDetailBgView
        android:id="@+id/poi_detail_content_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/poi_detail_head_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.locallife.poi.newdetail.widget.lynx.PoiSimpleLynxView
            android:id="@+id/poi_detail_lynx_head_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/poi_detail_native_head_image"
            android:layout_width="match_parent"
            android:layout_height="160dp">
            <View
                android:id="@+id/poi_detail_head_bg"
                android:background="#f3f3f4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/poi_detail_head_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:failureImage="@color/POIBgPlaceholder"
                app:placeholderImage="@color/POIBgPlaceholder"/>
            <com.bytedance.locallife.poi.dito.poi.ui.HeaderImageMaskView
                android:id="@+id/poi_detail_head_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.bytedance.locallife.poi.newdetail.widget.trip.TripPoiHeadWidget
            android:id="@+id/poi_quick_page_trip_head_image"
            android:background="#f3f3f4"
            android:layout_width="match_parent"
            android:layout_height="240dp"/>
        <com.bytedance.locallife.poi.newdetail.widget.contentplayer.PoiContentPlayerView
            android:id="@+id/poi_content_player_view"
            android:background="#f3f3f4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
