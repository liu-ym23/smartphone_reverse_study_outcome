<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ec_store_top_tips_promotion_background_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="top"
            android:id="@+id/ec_store_top_tips_promotion_background"
            android:background="@android:color/white"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:actualImageScaleType="fitXY"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/ec_store_top_tips_line"
        android:layout_width="match_parent"
        android:layout_height="16sp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ec_store_top_tips_line_light"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ec_ec_store_top_tips_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ec_store_top_tips_status"
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:src="@drawable/ec_store_ic_live_status"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/ec_store_top_tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <com.bytedance.android.ec.core.widget.ECLottieAnimationView
            android:id="@+id/ec_store_top_tips_arrow"
            android:layout_width="16sp"
            android:layout_height="16sp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
    </LinearLayout>
</FrameLayout>
