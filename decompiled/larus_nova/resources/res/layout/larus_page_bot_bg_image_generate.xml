<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_32"
        app:layout_constraintBottom_toTopOf="@+id/painting_style_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.larus.bot.impl.feature.edit.feature.bgimage.aigen.img2img.widget.ReferenceImageContainer
            android:layout_gravity="center"
            android:id="@+id/reference_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/painting_style_list"
        android:paddingLeft="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_10"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_108"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/desc_prompt"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:textColorHint="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/desc_prompt"
        android:background="@drawable/larus_bg_bot_edit"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:hint="@string/larus_describe_image_textBox"
        android:maxLines="1"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_52"
        app:layout_constraintBottom_toTopOf="@+id/generate_btn"/>
    <com.larus.bot.impl.feature.edit.feature.bgimage.aigen.img2img.widget.PromptInputButtonView
        android:id="@+id/desc_prompt_input_button"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginEnd="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/desc_prompt"
        app:layout_constraintEnd_toEndOf="@+id/desc_prompt"
        app:layout_constraintTop_toTopOf="@+id/desc_prompt"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/generate_btn"
        android:background="@drawable/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_generate_ai_btn"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
