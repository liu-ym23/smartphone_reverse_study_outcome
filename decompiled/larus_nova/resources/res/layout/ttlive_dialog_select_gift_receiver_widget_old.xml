<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/receiver_content_container"
        android:background="@drawable/ttlive_bg_gift_receiver_new"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/receiver_info_container"
            android:background="@drawable/ttlive_base_gift_receiver_info_old_container_bg"
            android:layout_width="116dp"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/give_for_title"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/user_avatar"
                android:visibility="visible"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ttlive_img_avatar_empty"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#face15"
                android:ellipsize="end"
                android:id="@+id/user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintEnd_toStartOf="@+id/space"
                app:layout_constraintStart_toEndOf="@+id/user_avatar"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <View
                android:gravity="end"
                android:id="@+id/space"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="104dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/right_back"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintEnd_toEndOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"
                app:srcCompat="@drawable/ttlive_ui_gift_change_receiver_arrow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:id="@+id/give_for_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_live_send_text"
            android:alpha="0.8"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/receiver_content_container"
            app:layout_constraintStart_toStartOf="@+id/receiver_content_container"
            app:layout_constraintTop_toTopOf="@+id/receiver_content_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/receiver_item_list"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#face15"
        android:gravity="end"
        android:id="@+id/change_receiver_text"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_live_change_receiver_text_new"
        android:maxLines="1"
        android:alpha="0"
        android:layout_marginStart="134dp"
        app:layout_constraintBottom_toBottomOf="@+id/receiver_content_container"
        app:layout_constraintStart_toStartOf="@+id/receiver_content_container"
        app:layout_constraintTop_toTopOf="@+id/receiver_content_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
