<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wiki_item_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.wikiv2.wikitreev2.scroll.ScrollSwipeMenuLayout
        android:id="@+id/swipe_menu_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/header"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/indicator"
                        android:padding="7dp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ud_icon_expand_right_filled"/>
                    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/loading"
                        android:padding="5dp"
                        android:visibility="visible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="1252_loading.json"
                        app:lottie_loop="true"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-2dp">
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:layout_width="22dp"
                        android:layout_height="22dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@drawable/ud_icon_file_doc_colorful"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/shortcut"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
                    </FrameLayout>
                    <com.bytedance.ee.bear.wikiv2.wikitreev2.scroll.WikiScrollTextView
                        android:textSize="@dimen/space_kit_font_14"
                        android:textStyle="normal"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="@dimen/space_kit_len_16"/>
                </LinearLayout>
            </LinearLayout>
            <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiItemBackgroundView
                android:layout_gravity="center_vertical"
                android:id="@+id/background"
                android:layout_width="0dp"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <include
            android:id="@+id/item_menu"
            android:visibility="invisible"
            layout="@layout/wiki_tree_item_menu_v2"/>
    </com.bytedance.ee.bear.wikiv2.wikitreev2.scroll.ScrollSwipeMenuLayout>
</FrameLayout>
