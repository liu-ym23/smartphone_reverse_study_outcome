<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ttlive_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"
        android:alpha="0"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:background="@drawable/ttlive_bg_simple_share_picture_dialog"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/ttlive_live_start_share_tip_v2"
        android:paddingStart="12dp"/>
    <HorizontalScrollView
        android:id="@+id/audience_action_container"
        android:background="#eeeeee"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/action_container"
            android:layout_width="wrap_content"
            android:layout_height="88dp">
            <View
                android:background="#eeeeee"
                android:layout_width="10dp"
                android:layout_height="1dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:background="#d0d1d3"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <RelativeLayout
        android:id="@+id/cancel"
        android:background="#fefefe"
        android:layout_width="match_parent"
        android:layout_height="86dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/ttlive_cancel"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
