<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_84"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <View
        android:id="@+id/avatar"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_toEndOf="@+id/avatar">
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="?attr/larus_dp_95"
            android:layout_height="?attr/larus_dp_16"/>
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_8"/>
    </LinearLayout>
</RelativeLayout>
