<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp">
    <SeekBar
        android:id="@+id/seek_bar_with_progress"
        android:background="@color/transparent"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="21dp"
        android:maxHeight="3dp"
        android:max="100"
        android:progressDrawable="@drawable/ttlive_seek_bar_with_progress_bg_horizontal"
        android:thumb="@drawable/ttlive_ktv_seek_bar_with_progress_thumb"
        android:paddingStart="21dp"
        android:paddingEnd="21dp"
        android:layout_marginEnd="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/seek_bar_progress_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:id="@+id/seek_bar_progress_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/seek_bar_with_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/seek_bar_with_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
