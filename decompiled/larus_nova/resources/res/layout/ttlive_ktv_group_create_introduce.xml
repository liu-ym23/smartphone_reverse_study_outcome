<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_live_ktv_group_is"
        android:drawableLeft="@drawable/ttlive_ktv_group_description_left_drawable"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ttlive_ktv_group_description_left_drawable"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9.5dp"
        android:text="@string/ttlive_live_ktv_audience_group_intro_tips"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25.5dp"
        android:text="@string/ttlive_live_ktv_group_achive"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ttlive_ktv_group_description_left_drawable"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9.5dp"
        android:text="@string/ttlive_live_ktv_audience_group_tips"/>
</LinearLayout>
