<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_bottom_sheet_dialog"
    android:layout_width="match_parent"
    android:layout_height="234dp">
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_smart_generate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="智能生成"/>
    <View
        android:background="#1618231f"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_camera_upload"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="拍照上传"/>
    <View
        android:background="#1618231f"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_album_upload"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="相册上传"/>
    <View
        android:background="#1618230d"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="取消"/>
</LinearLayout>
