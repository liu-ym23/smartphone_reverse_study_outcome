<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_comment_gallery_activity_layout_1081596073"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ec_comment_gallery_top_mask"
        android:background="@drawable/ec_comment_gallery_top_mask"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ec_comment_gallery_iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="54dp"
        android:src="@drawable/commerce_comment_gallery_back_new"
        android:contentDescription="@string/shopping_return"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/ec_comment_gallery_num"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_comment_gallery_iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ec_comment_gallery_iv_back"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ec_comment_multipic_mode_view"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_comment_gallery_iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ec_comment_gallery_iv_back">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ec_comment_big_pic_mode_icon"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_comment_big_pic_all_photo"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:ellipsize="end"
        android:id="@+id/ec_comment_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/ec_comment_type"
        app:layout_constraintEnd_toEndOf="@+id/ec_comment_content_text"
        app:layout_constraintStart_toStartOf="@+id/ec_comment_content_text"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/commerce_color_ADFFFFFF"
        android:ellipsize="end"
        android:id="@+id/ec_comment_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/ec_comment_content_text"
        app:layout_constraintEnd_toEndOf="@+id/ec_comment_content_text"
        app:layout_constraintStart_toStartOf="@+id/ec_comment_content_text"/>
    <com.bytedance.android.shopping.commentgallery.view.CommentGalleryExpandableTextView
        android:id="@+id/ec_comment_content_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="66dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="26dp"
        app:collapsed_content="@string/shopping_tv_collapsed"
        app:content_maxHeight="230dp"
        app:content_text_maxLine="2"
        app:content_textcolor="@color/commerce_color_FFFFFF"
        app:content_textsize="15sp"
        app:enable_big_big_opt="true"
        app:expandable_status_textcolor="@color/commerce_color_FFFFFF"
        app:expandable_status_textsize="15dp"
        app:expanded_content="@string/shopping_tv_expanded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ec_comment_iv_like"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ec_comment_iv_like"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/commerce_comment_gallery_unliked_new"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/ec_comment_tv_like"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:id="@+id/ec_comment_tv_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ec_comment_iv_like"
        app:layout_constraintStart_toStartOf="@+id/ec_comment_iv_like"/>
</androidx.constraintlayout.widget.ConstraintLayout>
