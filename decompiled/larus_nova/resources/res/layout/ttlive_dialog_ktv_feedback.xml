<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/close_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/ttlive_bg_ktv_feedback_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="#a3a3a3"
            android:gravity="right"
            android:layout_gravity="right"
            android:id="@+id/tv_feedback_exhibition"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_feedback_dialog_title"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#1d1e28"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_feedback_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_ktv_turn_off_confirm_title"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#898a8f"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_feedback_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_ksong_turn_off_tips"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/feedback_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.ktv.common.ordersong.feedback.KtvFeedbackComponentView
                android:id="@+id/feedback_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:support_multi_select="false"
                app:title="@string/ttlive_ktv_room_feedback_tag_title"/>
            <com.bytedance.android.live.ktv.common.ordersong.feedback.KtvFeedbackComponentView
                android:id="@+id/feedback_issues"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:support_multi_select="true"
                app:title="@string/ttlive_ktv_music_feedback_dialog_issue_select_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/issue_detail_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="91dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="#80ffffff"
                    android:layout_width="130dp"
                    android:layout_height="18dp"
                    android:text="@string/ttlive_ktv_music_feedback_dialog_issue_detail"/>
                <EditText
                    android:textSize="13dp"
                    android:textColor="#e6ffffff"
                    android:textColorHint="#57ffffff"
                    android:gravity="top"
                    android:id="@+id/issue_detail"
                    android:background="@drawable/ttlive_bg_ktv_music_feedback_edit"
                    android:paddingLeft="8dp"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/ttlive_ktv_music_feedback_dialog_issue_detail_hint"
                    android:maxLength="1000"
                    android:textCursorDrawable="@drawable/ttlive_bg_ktv_edit_cursor"
                    android:paddingStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ktv_feedback_finish_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="34dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#fe2c55"
                android:gravity="center"
                android:id="@+id/ktv_feedback_finish"
                android:background="@drawable/ttlive_bg_ktv_end"
                android:layout_width="163dp"
                android:layout_height="44dp"
                android:text="@string/ttlive_ktv_feedback_confirm_close"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ktv_feedback_cancel"
                android:background="@drawable/ttlive_bg_ktv_cancel"
                android:layout_width="163dp"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_cancel"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <Button
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_submit"
            android:background="@drawable/ttlive_bg_ktv_feedback_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_ktv_feedback_dialog_submit_issues"/>
    </LinearLayout>
</FrameLayout>
