<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/live_shelf_top_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/poi_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="20dp"
            android:layout_marginStart="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/poi_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:id="@+id/poi_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:fontFamily="PingFangSC"/>
                <ImageView
                    android:id="@+id/poi_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.5dp"
                    android:src="@drawable/live_local_life_shelf_bar_arrow"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/poi_city_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12sp"
                    android:textColor="#bf161823"
                    android:id="@+id/user_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12sp"
                    android:textColor="#bf161823"
                    android:id="@+id/poi_city"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC"/>
                <View
                    android:id="@+id/split_line"
                    android:background="#57161823"
                    android:layout_width="0.5dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="3dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12sp"
                    android:textColor="#bf161823"
                    android:id="@+id/poi_district_town"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.bytedance.locallife.live.goodsshelves.topbar.view.LiveLocalLifeTopBarFunctionView
            android:id="@+id/function_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
</FrameLayout>
