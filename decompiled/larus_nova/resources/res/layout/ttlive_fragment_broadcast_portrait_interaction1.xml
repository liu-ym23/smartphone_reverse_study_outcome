<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.GestureDetectLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/interaction_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/top_widget_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/user_info_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_marginStart="0dp"/>
            <FrameLayout
                android:id="@+id/top_right_widget_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_toRightOf="@+id/user_info_container"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_toEndOf="@+id/user_info_container"/>
            <FrameLayout
                android:id="@+id/top_right_watch_user_container_v1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/net_speed_monitor_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_below="@+id/top_widget_container"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
        <FrameLayout
            android:gravity="center_vertical"
            android:id="@+id/toolbar_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <FrameLayout
            android:gravity="center_vertical"
            android:id="@+id/live_media_review_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="14dp"
            android:layout_above="@+id/toolbar_container"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/filter_style"
        android:paddingTop="@dimen/ttlive_filter_margin_top"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/view_filter_arrow1"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_filter_switch_arrow_size"
            android:layout_height="@dimen/ttlive_filter_switch_arrow_size"
            android:src="@drawable/ttlive_live_img_arrow_filterswitch_left"/>
        <TextView
            android:textSize="@dimen/ttlive_filter_text_size"
            android:textColor="@color/ttlive_core_hs_s5"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/filter_style_text"
            android:layout_width="192dp"
            android:layout_height="32dp"
            android:layout_marginLeft="@dimen/ttlive_filter_text_margin"
            android:layout_marginRight="@dimen/ttlive_filter_text_margin"
            android:text="@string/ttlive_slide_right_and_left_to_switch_filter"
            android:shadowColor="@color/ttlive_filter_name_shadow_color"
            android:shadowDx="1"
            android:shadowDy="1"
            android:lineSpacingExtra="8dp"
            android:layout_marginStart="@dimen/ttlive_filter_text_margin"
            android:layout_marginEnd="@dimen/ttlive_filter_text_margin"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/view_filter_arrow2"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_filter_switch_arrow_size"
            android:layout_height="@dimen/ttlive_filter_switch_arrow_size"
            android:src="@drawable/ttlive_live_img_arrow_filterswitch_right"/>
    </LinearLayout>
</com.bytedance.android.livesdk.widget.GestureDetectLayout>
