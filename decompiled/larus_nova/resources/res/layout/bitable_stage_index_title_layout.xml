<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/facade_round_around_s"
        android:paddingLeft="@dimen/dp_4"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:backgroundTint="@color/ud_B600_10">
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/ud_B900"
            android:ellipsize="end"
            android:id="@+id/cell_title_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/cell_title_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:id="@+id/single_line_temp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CreationMobile_mention_sharing_yes"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintLeft_toRightOf="@+id/cell_title_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
            android:id="@+id/cell_title_icon"
            android:layout_width="@dimen/space_kit_len_14"
            android:layout_height="@dimen/space_kit_len_14"
            android:tint="@color/ud_B900"
            app:layout_constraintBottom_toBottomOf="@+id/single_line_temp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/single_line_temp"
            app:srcCompat="@drawable/ud_icon_maybe_outlined"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
