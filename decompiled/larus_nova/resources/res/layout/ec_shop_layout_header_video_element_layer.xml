<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_shop_header_video_element_layer"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="end|top"
        android:id="@+id/ec_shop_header_video_sound_button"
        android:background="@drawable/shopping_ic_store_v3_live_sound_shut"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:translationZ="10dp"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/ec_header_video_top_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="111dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_video_bottom_Info_area_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="264dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_video_bottom_gradual_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="47dp"/>
    <com.bytedance.android.ec.store.view.ECHeaderSlideIndicator
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ec_header_video_slide_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:layout_marginStart="97dp"
        android:layout_marginEnd="97dp"/>
</FrameLayout>
