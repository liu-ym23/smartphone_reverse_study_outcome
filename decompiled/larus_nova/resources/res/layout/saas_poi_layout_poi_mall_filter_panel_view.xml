<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/poi_layout_poi_mall_filter_panel_view_1844323773"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/poi_mall_selector_view"
        android:background="@color/POIBgPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/poi_mall_filter_panel_first_level_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/poi_mall_filter_panel_second_level_list"
            android:background="#0a161823"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <View
        android:background="@color/POISDTertiary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
