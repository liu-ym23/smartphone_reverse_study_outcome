<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_ktv_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="106dp">
    <FrameLayout
        android:id="@+id/picContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end|top"
            android:id="@+id/anchorAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/guestAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderPadding="1dp"
            app:roundingBorderWidth="3dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/anchorBg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tipsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="76dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="76dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:id="@+id/tipsDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="@+id/tipsTitle"
        app:layout_constraintTop_toBottomOf="@+id/tipsTitle"/>
    <Button
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/btn"
        android:background="@drawable/ttlive_ktv_btn_follow"
        android:layout_width="63dp"
        android:layout_height="28dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
