<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/permSearchUserTopbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/permSearchUserSelectLayout"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permSearchUserTopbarContainer">
        <View
            android:id="@+id/permSearchUserDepDividerTop"
            android:background="@color/bg_base"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/permSearchUserDepLayout"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/permSearchUserDepIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ud_icon_organization_outlined"
                android:scaleType="fitCenter"
                android:tint="@color/colorful_wathet"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/permSearchUserDepTitle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Doc_Permission_AddUserSelctDepartmentTitle"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/permSearchUserDepIcon"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/permSearchUserDepDivider"
                android:background="@color/ud_divider_color"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/permSearchUserDepTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/permSearchUserGroupLayout"
            android:background="@color/bg_body"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/permSearchUserGroupIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ud_icon_group_outlined"
                android:scaleType="fitCenter"
                android:tint="@color/colorful_purple"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/permSearchUserGroupTitle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/CreationMobile_ECM_Add_UserGroup_Tab"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/permSearchUserGroupIcon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/permSearchUserDepDividerBottom"
            android:background="@color/bg_base"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/permSearchUserResultContainer"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/permSearchUserBottomLayout"
        app:layout_constraintTop_toBottomOf="@+id/permSearchUserSelectLayout"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/permSearchUserBottomLayout"
        android:background="@color/bg_float"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_fill_default"
            android:id="@+id/permSearchUserBottomTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/Doc_Permission_AddUserSelectedTips"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@drawable/space_kit_text_l1_color_sel"
            android:id="@+id/permSearchUserNextBtn"
            android:background="@drawable/facade_round_around_m"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/Doc_Facade_Next"
            android:layout_centerVertical="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/space_kit_btn_l1_bg_color_selector"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
