<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/title_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                app:cardCornerRadius="?attr/larus_dp_16"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/larus_base_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/minor_title_image"
                        android:layout_width="?attr/larus_dp_56"
                        android:layout_height="?attr/larus_dp_56"
                        android:layout_marginTop="?attr/larus_dp_24"
                        android:src="@drawable/larus_icon_setting_teenager"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/minor_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:text="@string/larus_teenagerMode_modeName_parent_cn"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintEnd_toEndOf="@+id/minor_title_image"
                        app:layout_constraintStart_toStartOf="@+id/minor_title_image"
                        app:layout_constraintTop_toBottomOf="@+id/minor_title_image"/>
                    <com.larus.common_ui.widget.UrlSpanTextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="@color/larus_neutral_70"
                        android:gravity="center"
                        android:id="@+id/minor_sub_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_4"
                        android:text="@string/larus_teenagerMode_desc_cn"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:fontFamily="sans-serif-medium"
                        app:larus_linkColor="@color/larus_neutral_100"
                        app:larus_linkUnderLine="false"
                        app:layout_constraintEnd_toEndOf="@+id/minor_title"
                        app:layout_constraintStart_toStartOf="@+id/minor_title"
                        app:layout_constraintTop_toBottomOf="@+id/minor_title"/>
                    <View
                        android:id="@+id/splitter"
                        android:background="@color/larus_neutral_transparent_1"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_0_5"
                        android:layout_marginTop="?attr/larus_dp_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/minor_sub_title"/>
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/minor_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_teenagerMode_modeName_parent_cn"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_icon_setting_lock"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/splitter"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <com.larus.bmhome.view.item.ItemGroup
                android:background="@drawable/larus_bg_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/show_video"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_teenagerMode_subSettings_videos_cn"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_setting_related_video_v2"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/enter_web"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_teenagerMode_subSettings_webPages_cn"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_setting_webaccess"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/ai_creation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_teenagerMode_subSettings_aiCreation_cn"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_setting_genimg"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
