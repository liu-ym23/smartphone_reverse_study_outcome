<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_click_area"
    android:layout_width="wrap_content"
    android:layout_height="16dp"
    android:divider="@drawable/ec_divider_horizontal_dp_4"
    android:showDividers="middle">
    <com.bytedance.android.ec.store.view.ECTagListView
        android:id="@+id/ec_shop_info_tag_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16sp"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/ec_store_info_area_brand_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14sp"
        app:layoutMode="width_self_adjust"/>
    <com.bytedance.android.shopping.store.home.view.ECStoreExperienceScoreView
        android:id="@+id/ec_store_info_area_flag_ship_experience_score_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="11sp"
        android:id="@+id/self_store_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_no_score"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_store_no_score"
        android:lines="1"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/score_area_wrap"
        android:background="@drawable/ec_store_info_score_background"
        android:visibility="gone"
        android:layout_width="47dp"
        android:layout_height="14sp">
        <TextView
            android:textSize="13sp"
            android:typeface="sans"
            android:textStyle="bold"
            android:textColor="@color/shopping_std_brand"
            android:ellipsize="end"
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_score_fen"
            android:visibility="gone"
            android:layout_width="12sp"
            android:layout_height="12sp"
            android:src="@drawable/ec_store_red_fen_icon"/>
    </LinearLayout>
    <com.bytedance.android.shopping.store.home.view.ECStoreXzgLevelView
        android:id="@+id/ec_store_xzg_view"
        android:layout_width="wrap_content"
        android:layout_height="16sp"/>
    <com.bytedance.android.ec.store.view.ECTagListView
        android:id="@+id/ec_shop_info_welfare_corp_label"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16sp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#e38f52"
        android:gravity="center"
        android:id="@+id/store_selling_point_tag1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14sp"
        android:lines="1"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#e38f52"
        android:gravity="center"
        android:id="@+id/store_selling_point_tag2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14sp"
        android:lines="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_sales_and_tag"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/tv_sales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:includeFontPadding="false"/>
        <View
            android:id="@+id/tag_divider"
            android:background="#57161823"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="9sp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#99161823"
            android:ellipsize="end"
            android:id="@+id/shop_tag_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</merge>
