<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <ImageView
        android:id="@+id/quick_bindcard_item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/cj_pay_quick_bind_item_icon_default"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_15"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/quick_bindcard_item_bankname"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="12dp"
        android:lines="1"
        android:layout_toLeftOf="@+id/quick_bindcard_cardtype_support"
        android:layout_toRightOf="@+id/quick_bindcard_item_icon"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_12"
        android:gravity="center_vertical"
        android:id="@+id/quick_bindcard_cardtype_support"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/quick_bindcard_item_right_arrow"/>
    <ImageView
        android:id="@+id/quick_bindcard_item_right_arrow"
        android:paddingTop="1dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="16dp"
        android:src="?attr/cj_pay_small_icon_right_arrow"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <ProgressBar
        android:id="@+id/quick_bindcard_item_loading"
        android:background="@color/cj_pay_color_trans"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="16dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
        android:indeterminateDuration="500"
        android:indeterminateBehavior="repeat"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
