<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/line"
        android:background="@color/ttlive_color_link_video_introduce_info_bg"
        android:layout_width="2dp"
        android:layout_height="12dp"
        android:layout_marginTop="25dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_color_link_video_introduce_info_text_title"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@+id/line"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/line"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_color_link_video_introduce_info_text_des"
        android:id="@+id/des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/title"
        android:layout_marginStart="6dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/image_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="30dp"
        android:layout_below="@+id/des">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/image_first_iv"
                android:layout_width="match_parent"
                android:layout_height="233dp"
                android:layout_marginLeft="6dp"
                android:scaleType="fitXY"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_color_link_video_introduce_info_text_des"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_text_link_video_introduce_pic_des_pic1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/image_second_iv"
                android:layout_width="match_parent"
                android:layout_height="233dp"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_color_link_video_introduce_info_text_des"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_text_link_video_introduce_pic_des_pic2"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
