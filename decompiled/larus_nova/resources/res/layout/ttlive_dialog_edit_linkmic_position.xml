<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/hint"
        android:background="@drawable/ttlive_bg_dialog_inroom_user"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_live_edit_linkmic_position_title"/>
    <View
        android:id="@+id/line_change_position"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/change_position"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_change_position"/>
    <View
        android:id="@+id/line_set_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/set_position_name"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_set_position_name"/>
    <View
        android:id="@+id/line_edit_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/edit_position_name"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_edit_position_name"/>
    <View
        android:id="@+id/line_delete_position_name"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/delete_position_name"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_delete_position_name"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/adjust_guest_position"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_aujust_guest_position"/>
    <View
        android:id="@+id/line_adjust_guest_position"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:id="@+id/line_update_position"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/update_position"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_edit_linkmic_open_position"/>
    <View
        android:id="@+id/line_adjust_team_fight_camp"
        android:background="@color/ttlive_core_hs_s9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/adjust_team_fight_camp"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_chat_room_panel_item_red_camp_hit"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
