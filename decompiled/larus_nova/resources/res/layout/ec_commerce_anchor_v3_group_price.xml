<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.AutoResizePriceContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v3_group_price_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#bfffffff"
        android:id="@+id/tv_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/font_size_24"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/text_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/tv_group"
        android:layout_alignParentBottom="true"
        app:extraTextColor="@color/BGReverse"
        app:extraTextSize="12sp"
        app:priceBold="true"
        app:priceText="18.8"
        app:priceTextColor="@color/ConstTextInverse"
        app:priceTextSize="20sp"
        app:spaceSize="2dp"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/normal_text_market_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="2dp"
        android:layout_toRightOf="@+id/text_price"
        android:layout_alignBottom="@+id/text_price"
        android:layout_alignParentBottom="false"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/text_price"
        app:extraTextColor="@color/commerce_const_text_inverse_4"
        app:extraTextSize="12sp"
        app:priceText="100.1"
        app:priceTextColor="@color/commerce_const_text_inverse_4"
        app:priceTextSize="12sp"
        app:showDeleteLine="true"
        app:spaceSize="0dp"
        app:yangTextSize="12sp"/>
    <include
        android:id="@+id/container_discount_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="1dp"
        android:layout_toRightOf="@+id/text_price"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/text_price"
        layout="@layout/ec_commerce_anchor_v3_group_discount_price"/>
</com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
