<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_alert_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="#808080"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="20dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:background="@drawable/ttlive_bg_alert_btn_left"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/ttlive_cancel"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:background="@drawable/ttlive_bg_alert_btn_right_fix"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/ttlive_disconnect"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
