<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_mv_singer_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_avatar"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_mv_singer_avatar_anim"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:fadeDuration="250"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/ktv_mv_singer_avatar"
        app:layout_constraintRight_toRightOf="@+id/ktv_mv_singer_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_singer_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_mv_singer_avatar"
        app:layout_constraintLeft_toRightOf="@+id/ktv_mv_singer_avatar"
        app:layout_constraintTop_toTopOf="@+id/ktv_mv_singer_avatar">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:id="@+id/ktv_mv_singer_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/ktv_mv_singer_singing_tag"
            android:background="@drawable/ttlive_bg_ktv_room_nick_tag"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_ktv_resident_singer"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ktv_mv_singer_nickname"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffffff"
            android:id="@+id/ktv_mv_hot_info"
            android:background="@drawable/ttlive_ktv_mv_singer_hot_bg"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_ktv_zero_str"
            android:drawableLeft="@drawable/ttlive_ktv_mv_singer_hot_icon"
            android:drawablePadding="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/ktv_mv_singer_nickname"
            app:layout_constraintLeft_toRightOf="@+id/ktv_mv_singer_singing_tag"
            app:layout_constraintTop_toTopOf="@+id/ktv_mv_singer_nickname"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
