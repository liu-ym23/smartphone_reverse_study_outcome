<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/img_back"
        android:padding="8dp"
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/ttlive_open_feature_back_btn"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="normal"
        android:textColor="#e6ffffff"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_open_platform_feature_list_subtitle"
        android:maxLines="1"
        android:singleLine="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/feature_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="使用说明"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/help_btn"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="46dp"
        android:src="@drawable/ttlive_open_feature_list_help_tip_icon"
        android:layout_marginEnd="46dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/setting_btn"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/ttlive_open_feature_list_setting_icon"
        android:layout_marginEnd="14dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/search_btn"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="14dp"
        android:src="@drawable/ttlive_open_feature_top_right_search_icon"
        android:layout_marginEnd="14dp"/>
</FrameLayout>
