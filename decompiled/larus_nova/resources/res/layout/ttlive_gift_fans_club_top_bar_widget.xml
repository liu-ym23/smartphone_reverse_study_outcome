<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gift_panel_fans_club"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_panel_fans_club_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="13dp"
            android:src="@drawable/ttlive_img_avatar_empty"
            android:layout_marginStart="13dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/user_avatar_border"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:src="@drawable/ttlive_user_fansclub_icon_with_border"
            app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
            app:layout_constraintEnd_toEndOf="@+id/user_avatar"
            app:layout_constraintStart_toStartOf="@+id/user_avatar"
            app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
        <RelativeLayout
            android:id="@+id/fans_club_icon_layout"
            android:background="@drawable/ttlive_top_fansclub_icon_bg"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/fans_club_icon"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                app:actualImageScaleType="centerInside"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/fans_club_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#c0ffffff"
            android:id="@+id/left_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_gift_fans_club_top_bar_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/right_title_bg"
            android:background="@drawable/ttlive_detail_button"
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_fans_club_top_bar_title"
            android:id="@+id/right_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_gift_fans_club_top_bar_subtitle"
            app:layout_constraintBottom_toBottomOf="@+id/right_title_bg"
            app:layout_constraintEnd_toEndOf="@+id/right_title_bg"
            app:layout_constraintStart_toStartOf="@+id/right_title_bg"
            app:layout_constraintTop_toTopOf="@+id/right_title_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
