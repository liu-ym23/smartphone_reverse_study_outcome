<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_view_payment_confirm_dialog_root_view"
        android:background="@drawable/cj_pay_integrated_bg_dialog"
        android:layout_width="@dimen/cj_pay_height_319"
        android:layout_height="307dp"
        android:layout_centerInParent="true">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <RelativeLayout
            android:id="@+id/cj_pay_total_value_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_60"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_38"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/cj_pay_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_22"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/cj_pay_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/cj_pay_padding_2"
                android:layout_marginBottom="@dimen/cj_pay_padding_2"
                android:text="@string/cj_pay_currency_unit"
                android:layout_toLeftOf="@+id/cj_pay_total_value"
                android:layout_alignBottom="@+id/cj_pay_total_value"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_12"
            android:textColor="@color/cj_pay_color_gray_153"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_product_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_padding_18"
            android:layout_marginTop="@dimen/cj_pay_padding_2"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_below="@+id/cj_pay_total_value"
            android:layout_centerHorizontal="true"/>
        <androidx.core.widget.NestedScrollView
            android:background="@color/cj_pay_color_trans"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:divider="@color/cj_pay_color_trans"
            android:dividerHeight="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_payment_list_view"
                android:background="@color/cj_pay_color_trans"
                android:paddingBottom="@dimen/cj_pay_padding_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include layout="@layout/cj_pay_view_dialog_secondary_confirmation"/>
    <com.android.ttcjpaysdk.base.ui.CJPayLoadingView
        android:id="@+id/cj_pay_activity_loading_view"
        android:layout_width="319dp"
        android:layout_height="307dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
