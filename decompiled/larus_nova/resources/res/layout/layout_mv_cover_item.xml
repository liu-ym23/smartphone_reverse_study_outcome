<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    app:ttlive_allRadius="1dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/cover_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|left"
        android:id="@+id/tv_thumbup_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:drawableLeft="@drawable/ttlive_ktv_opus_thumbup"
        android:drawablePadding="5dp"/>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
