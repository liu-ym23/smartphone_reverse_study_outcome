<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/sidebar_border"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_kit_len_48"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sidebar_navi_item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/space_kit_len_22"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:id="@+id/sidebar_navi_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_6"/>
</LinearLayout>
