<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="?attr/larus_dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_step_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_20"
        android:paddingStart="?attr/larus_dp_12">
        <ProgressBar
            android:id="@+id/progress_step_loading"
            android:padding="?attr/larus_dp_3"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_bg_loading_expert_step"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_step_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:tint="?attr/larus_neutral_70"
            app:failureImage="@drawable/larus_icon_expert_fail"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:id="@+id/text_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <com.larus.bmhome.chat.view.FlowTagLayout
        android:id="@+id/tag_layout_step_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:layout_below="@+id/layout_step_title"
        android:layout_marginStart="?attr/larus_dp_34"
        android:layout_marginEnd="?attr/larus_dp_12"/>
    <com.larus.bmhome.chat.layout.widget.ScrollToRecyclerView
        android:id="@+id/rv_step_horizontal_content"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_below="@+id/layout_step_title"
        android:paddingStart="?attr/larus_dp_34"/>
</RelativeLayout>
