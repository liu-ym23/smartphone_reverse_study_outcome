<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/debug_dialog_real_container"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/larus_black"
            android:gravity="center"
            android:id="@+id/debug_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_10"/>
        <ViewStub
            android:id="@+id/debug_dialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/larus_black"
            android:gravity="center"
            android:id="@+id/debug_dialog_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/larus_debug_dialog_close"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <Space
        android:id="@+id/debug_dialog_empty_view"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="30dp"/>
</LinearLayout>
