<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/init_loading_fl"
    android:background="@color/aos_bg_secondary3"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/init_cover_from_host"
        android:background="@drawable/aos_feed_loading_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/init_loading_double_ball"
        android:padding="4dp"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</FrameLayout>
