            android:id="@+id/end_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/listen_live_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/broadcast_pause_page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/pk_audience_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/pk_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ceremony_border_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/draw_guess_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/live_decoration_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.interactivity.api.DragParentView
            android:id="@+id/highlight_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:layout_gravity="center"
            android:id="@+id/anchor_pause_tips_view"
            android:visibility="gone"
            android:layout_width="188dp"
            android:layout_height="166dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/font_layer_master_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
