<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/entrance_text_container"
    android:background="@drawable/larus_bg_border_develop_entrance_group"
    android:padding="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_12"
    android:layout_marginTop="?attr/larus_dp_3"
    android:layout_marginRight="?attr/larus_dp_12"
    android:layout_marginBottom="?attr/larus_dp_3">
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/entrance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_12">
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:gravity="end"
            android:layout_gravity="end"
            android:id="@+id/entrance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
