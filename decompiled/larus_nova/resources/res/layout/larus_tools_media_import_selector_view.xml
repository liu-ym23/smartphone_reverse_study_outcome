<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/selection_list_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#1f161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textColor="@color/larus_tools_media_secondary_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_selector_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                app:ts_enable_text_color="false"
                style="@style/tools_font_size_26"/>
            <com.ss.android.ugc.tools.view.style.StyleTextView
                android:textStyle="bold"
                android:textColor="@color/larus_tools_media_import_selector_next_step_text_color"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/sure_view"
                android:background="?attr/larus_tools_media_import_selector_next_step_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/larus_album_next_btn"
                android:layout_weight="0"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:ts_enable_text_color="false"
                app:ts_font_type="medium"
                style="@style/tools_font_size_30"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
