<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/poi_player_loading_error_1209909497"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/poi_player_error_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/uikit_network_error"
        style="@style/font_size_34_sp"/>
    <TextView
        android:textColor="#80ffffff"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/check_and_retry"
        style="@style/font_size_28_sp"/>
    <TextView
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/poi_player_retry"
        android:background="@drawable/life_poi_media_bg_retry_btn"
        android:paddingTop="13dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="@string/retry"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        style="@style/font_size_30_sp"/>
</LinearLayout>
