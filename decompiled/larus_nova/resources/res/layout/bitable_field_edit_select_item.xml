<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/space_kit_len_52">
    <FrameLayout
        android:id="@+id/color_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/space_kit_len_8"
        android:paddingEnd="@dimen/space_kit_len_8"
        android:layout_marginStart="@dimen/space_kit_len_8">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:layout_gravity="center"
            android:id="@+id/color_iv"
            android:background="@color/primary_fill_solid_02"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            app:radius="@dimen/space_kit_len_20"/>
    </FrameLayout>
    <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.FieldEditText
        android:textSize="@dimen/space_kit_font_16"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center_vertical"
        android:id="@+id/option_et"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:hint="@string/Bitable_Field_AddAnOptionPlaceholder"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:imeOptions="actionDone"
        android:layout_marginStart="@dimen/space_kit_len_8"
        style="@style/SpaceEditTextStyle"/>
</LinearLayout>
