<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_room_midi_score_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:actualImageScaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ktv_room_midi_song_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ktv_room_midi_score_container">
        <View
            android:id="@+id/view_song_info_left_line"
            android:layout_width="22dp"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="10dp"
            android:id="@+id/singer_sing_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/view_song_info_right_line"
            android:layout_width="22dp"
            android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ktv_room_midi_score_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <com.bytedance.android.livesdk.widget.GradientTextView
            android:textSize="40dp"
            android:textStyle="italic|bold"
            android:textColor="#ffc163"
            android:id="@+id/ktv_room_midi_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.bytedance.android.livesdk.widget.GradientTextView
            android:textSize="28dp"
            android:textStyle="bold"
            android:textColor="#ffc163"
            android:id="@+id/ktv_room_midi_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_midi_feed_back_score_tips"
            android:layout_marginStart="2dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_room_midi_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_room_midi_tips"
        app:layout_constraintEnd_toStartOf="@+id/ktv_room_midi_tips"
        app:layout_constraintTop_toTopOf="@+id/ktv_room_midi_tips"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:id="@+id/ktv_room_midi_tips"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ktv_room_midi_song_info_container"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/singer_avatar"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="37dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
