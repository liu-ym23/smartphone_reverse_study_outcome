<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bitable_superagent_at_skeleton_circle"
        android:background="@drawable/bitable_superagent_at_skeleton_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <View
        android:id="@+id/bitable_superagent_at_skeleton_bar"
        android:background="@drawable/bitable_superagent_at_skeleton_bar"
        android:layout_width="120dp"
        android:layout_height="12dp"
        android:layout_marginStart="12dp"/>
</LinearLayout>
