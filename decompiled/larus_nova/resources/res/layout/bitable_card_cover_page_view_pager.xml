<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cover_container"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:layout_gravity="bottom"
        android:id="@+id/bitable_card_cover_view_pager"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/bitable_card_cover_empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <com.bytedance.ee.bear.bitable.card.view.table.EmptyCoverView
            android:id="@+id/bitable_card_cover_empty_image"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ud_N600"
            android:gravity="center"
            android:id="@+id/bitable_card_cover_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_ItemView_Cover_NoAttachmentsInField_Desc"
            android:layout_below="@+id/bitable_card_cover_empty_image"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:id="@+id/cover_index_layout"
        android:background="@drawable/bitable_page_view_cover_indicator_bg"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ud_N900"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cover_index"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lineSpacingExtra="2sp"/>
    </LinearLayout>
</FrameLayout>
