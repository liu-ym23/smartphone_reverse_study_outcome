<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ec_common_page_loading_layout_583238627"
    android:background="@drawable/commerce_bg_common_loading_view"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="88dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.DoubleColorBallStatusView
        android:id="@+id/ec_commerce_loading_view"
        android:layout_width="28dp"
        android:layout_height="28dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/commerce_color_E5FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/shopping_show_loading"/>
</LinearLayout>
