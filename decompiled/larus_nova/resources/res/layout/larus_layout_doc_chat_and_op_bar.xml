<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/chat_input_bg_mask_v2"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.office.base.view.TextLoadingView
        android:id="@+id/loading_text_v2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/doc_chat_input_container_v2"
        app:layout_constraintStart_toStartOf="parent"
        app:tlv_loadingIconRes="@drawable/larus_common_ui_office_loading_dot"
        app:tlv_text="@string/larus_thinking_state"
        app:tlv_textColor="@color/larus_neutral_100"
        app:tlv_text_weight="400"/>
    <ViewStub
        android:id="@+id/doc_operation_bar_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/doc_chat_input_container_v2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.doc.impl.view.InterceptTouchFrameLayout
        android:id="@+id/doc_chat_input_container_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
