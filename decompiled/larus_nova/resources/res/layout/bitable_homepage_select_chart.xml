<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/bg_float_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/hp_back"
                android:background="@null"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                app:srcCompat="@drawable/ud_icon_left_small_ccm_outlined"
                app:tint="@color/ud_N800"/>
            <com.larksuite.component.ui.avatar.v2.LarkAvatarView
                android:id="@+id/hp_bitable_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/dp_8"
                app:radius="3.6dp"
                style="@style/UDAvatar.Rectangular"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/hp_bitable_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_8"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="@dimen/sp_14"
                android:textColor="@color/primary_on_primary_fill"
                android:gravity="center"
                android:id="@+id/hp_confirm"
                android:paddingLeft="@dimen/dp_12"
                android:paddingRight="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="@dimen/dp_8"
                app:ud_backgroundColor="@color/bitable_homepage_select_chart_confirm_color"
                app:ud_radius="xxl"
                style="@style/UDButton.Big.Primary"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
                android:id="@+id/hp_chart_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/hp_chart_list_status_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.larksuite.component.universe_design.emptystate.UDEmptyState
                    android:layout_gravity="center"
                    android:id="@+id/hp_chart_list_status"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hp_chart_list_loading_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.larksuite.component.ui.loading.LKUILoadingView
                    android:layout_gravity="center"
                    android:id="@+id/hp_chart_list_loading_view"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    app:lottie_autoPlay="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:text="@string/Bitable_HomeDashboard_LoadingBase_Desc"
                    android:maxLines="1"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/hp_add_chart_loading_mask"
        android:background="@color/fill_loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
