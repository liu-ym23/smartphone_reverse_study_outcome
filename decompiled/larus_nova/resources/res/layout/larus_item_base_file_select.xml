<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_80">
    <View
        android:id="@+id/base_file_select"
        android:background="@drawable/larus_selector_chat_file_recent_select"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
        android:id="@+id/base_file_icon_bg"
        android:padding="?attr/larus_dp_4"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/base_file_select"
        app:layout_constraintTop_toTopOf="parent"
        app:rv_cornerRadius="?attr/larus_dp_10">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/base_file_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/base_file_thumbnail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundedCornerRadius="?attr/larus_dp_10"/>
    </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/base_file_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/base_file_icon_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/base_file_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/base_file_icon_bg">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/base_file_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/base_file_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxLines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
