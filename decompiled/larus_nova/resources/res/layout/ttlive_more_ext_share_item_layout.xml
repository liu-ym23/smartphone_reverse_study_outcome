<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="64dp"
    android:layout_height="72dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ext_share_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/ext_share_corner_icon"
        android:background="@drawable/ttlive_more_ext_share_lark_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/ext_share_icon"
        app:layout_constraintRight_toRightOf="@+id/ext_share_icon"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_new_profile_90white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ext_share_title"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginBottom="1dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
