<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="?attr/larus_bg_send_file"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <androidx.cardview.widget.CardView
        android:id="@+id/image_container"
        android:background="@color/larus_static_white"
        android:clipChildren="false"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginBottom="?attr/larus_dp_10"
        android:layout_centerVertical="true"
        app:cardCornerRadius="?attr/larus_dp_8"
        app:cardElevation="?attr/larus_dp_0">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/image_view"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"/>
    </androidx.cardview.widget.CardView>
    <com.larus.bmhome.view.FileNameView
        android:textSize="?attr/larus_sp_14"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/file_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="?attr/larus_dp_252"
        android:minWidth="?attr/larus_dp_78"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_toEndOf="@+id/image_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_upload_file"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginBottom="?attr/larus_dp_10">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_1"
            app:srcCompat="?attr/larus_bg_non_compliance"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_252"
            android:minWidth="?attr/larus_dp_78"
            android:text="@string/larus_file_upload_safety_reject"/>
    </LinearLayout>
</RelativeLayout>
