<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.base.view.FixRatioRoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:frMode="fixed_width"
    app:whRatio="0.75">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/profile_feed_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/photo_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/aos_familiar_slides_photo_feed_ic"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/aos_work_item_bottom_linear_gradient"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start|bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="8dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/aos_icon_home_like"
            android:layout_marginEnd="4dp"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="12sp"
            android:textColor="@color/aos_uikit_t_primary_dark"
            android:id="@+id/work_digg_count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/recently_see_layout"
        android:background="#bf000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/just_play_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/profile_ic_play"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aos_recently_see"/>
    </LinearLayout>
</com.bytedance.awemeopen.apps.framework.base.view.FixRatioRoundFrameLayout>
