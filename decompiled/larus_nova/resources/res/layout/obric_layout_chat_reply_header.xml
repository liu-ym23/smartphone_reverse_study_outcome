<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/reply_hint"
        android:layout_width="?attr/larus_dp_2"
        android:layout_height="?attr/larus_dp_16"
        android:src="@drawable/obric_ic_reply_rect"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/neutral_70"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/reply_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableRight="@drawable/obric_msg_ref_arrow"
        android:drawablePadding="@dimen/dp_4"
        android:paddingStart="?attr/larus_dp_4"/>
</merge>
