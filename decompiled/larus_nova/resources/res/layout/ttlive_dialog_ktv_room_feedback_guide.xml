<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/container"
        android:background="#121212"
        android:layout_width="match_parent"
        android:layout_height="160dp">
        <TextView
            android:textSize="18dp"
            android:textColor="#ffffff"
            android:id="@+id/ktv_feedback_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ttlive_ktv_music_feedback_guide_msg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ktv_feedback_title">
            <TextView
                android:textSize="15dp"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/ktv_music_feedback_guide_cancel"
                android:background="@drawable/ttlive_bg_ktv_common_btn_dark"
                android:layout_width="163dp"
                android:layout_height="44dp"
                android:text="@string/ttlive_cancel"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ktv_music_feedback_guide_go"
                android:background="@drawable/ttlive_bg_ktv_bt"
                android:layout_width="163dp"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_ktv_music_feedback_guide_go"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
