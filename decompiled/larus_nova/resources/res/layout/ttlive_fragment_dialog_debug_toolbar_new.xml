<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="32dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="32dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toolbar互斥测试工具 :: "
        style="@style/TextAppearance.AppCompat.Headline"/>
    <TextView
        android:textColor="@color/ttlive_std_brand"
        android:id="@+id/text_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="COMMERCE"
        style="@style/TextAppearance.AppCompat.Headline"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示中按钮："
        style="@style/TextAppearance.AppCompat.Subhead"/>
    <TextView
        android:id="@+id/tv_showing_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Button]"
        style="@style/TextAppearance.AppCompat.Caption"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="排队中按钮："
        style="@style/TextAppearance.AppCompat.Subhead"/>
    <TextView
        android:id="@+id/tv_waiting_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Button]"
        style="@style/TextAppearance.AppCompat.Caption"/>
    <Button
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_toolbar_debug_refresh"
        android:background="@drawable/ttlive_bg_live_black_corner_rect"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:text="刷新以上按钮状态"/>
    <Spinner
        android:id="@+id/spinner_all_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
</LinearLayout>
