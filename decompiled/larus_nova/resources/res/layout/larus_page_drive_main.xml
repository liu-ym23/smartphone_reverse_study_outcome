<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/larus_drive_list_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.drive.biz.impl.view.widget.DriveTagListView
        android:id="@+id/larus_drive_tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/larus_drive_list_title_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/larus_drive_list_title_bar"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/larus_drive_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/larus_drive_list_title_bar"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/larus_drive_upload_main_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:cardBackgroundColor="@color/larus_base_3"
        app:cardCornerRadius="?attr/larus_dp_16"
        app:cardElevation="?attr/larus_dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/larus_drive_list_title_bar">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/larus_bg_drive_upload_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/larus_drive_upload_main_banner_uploading"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/larus_drivebiz_ic_drive_loading_more"
                android:layout_marginStart="?attr/larus_dp_19"
                style="?android:attr/progressBarStyleSmall"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/larus_drive_upload_main_banner_success"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_toast_success_icon"
                android:layout_marginStart="?attr/larus_dp_16"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/larus_drive_upload_main_banner_warning"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_toast_warning_icon"
                android:layout_marginStart="?attr/larus_dp_16"/>
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:layout_gravity="center_vertical"
                android:id="@+id/larus_drive_upload_main_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="?attr/larus_dp_48"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/larus_drive_upload_main_banner_close"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_ic_drive_upload_item_remove"
                android:contentDescription="@null"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
