<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_language_selection_bottom_sheet"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/neutral_100"
        android:gravity="center"
        android:id="@+id/title_text"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_si_select_language_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/neutral_50"
        android:gravity="center"
        android:id="@+id/subtitle_text"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_si_only_primary_secondary_translation_toast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/current_languages_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_text">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/left_language_container"
            android:background="@drawable/bg_language_select_window"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/left_language_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_left_earphone_translating_si"
                app:tint="@color/neutral_100"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/larus_static_black"
                android:id="@+id/left_language_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/swap_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/icon_switch_language_si"
            android:rotation="90"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/right_language_container"
            android:background="@drawable/bg_language_select_window"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/right_language_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_right_earphone_translating_si"
                android:layout_marginStart="8dp"
                app:tint="@color/neutral_100"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/larus_static_black"
                android:id="@+id/right_language_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/language_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="448dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/current_languages_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/language_recycler_view">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/bg_language_select_window"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/larus_si_cancel"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/confirm_button"
            android:background="@drawable/bg_language_confirm_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/larus_si_confirm"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
