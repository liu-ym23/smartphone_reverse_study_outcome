<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ec_commerce_comment_publish_work_bg"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="24dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="0.5dp"
        android:src="@drawable/commerce_comment_publish_work_icon"
        android:scaleType="fitCenter"
        android:contentDescription="@string/commerce_comment_publish_work"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/TextHighLight_Light"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_comment_publish_work"
        android:layout_marginEnd="10dp"/>
</LinearLayout>
