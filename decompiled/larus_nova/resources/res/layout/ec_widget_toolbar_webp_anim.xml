<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_cart_image"
        android:clipChildren="false"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:layout_gravity="center"
            android:id="@+id/ecniv_small_card_animated"
            android:visibility="invisible"
            android:layout_width="130dp"
            android:layout_height="130dp"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_static"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:layout_gravity="center"
            android:id="@+id/ecniv_animated"
            android:layout_width="130dp"
            android:layout_height="130dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/fl_animated"
            android:visibility="invisible"
            android:layout_width="130dp"
            android:layout_height="130dp"/>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="bottom"
        android:layout_gravity="end|top"
        android:id="@+id/tv_shopping_number"
        android:background="@drawable/ec_bg_shoppingcart_number"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="-1dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginEnd="-6dp"/>
</FrameLayout>
