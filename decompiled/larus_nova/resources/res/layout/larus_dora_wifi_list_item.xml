<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_56">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dora_wifi_level_image_view"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:src="@drawable/larus_dora_wifi_level_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/neutral_100"
        android:id="@+id/dora_wifi_ssid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_wifi_cn"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dora_wifi_level_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_danger_50"
        android:gravity="center"
        android:id="@+id/dora_wifi_opt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_btn_delete_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/dora_wifi_opt_progress_bar"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminateDrawable="@drawable/larus_dora_loading"
        android:indeterminateDuration="750"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
