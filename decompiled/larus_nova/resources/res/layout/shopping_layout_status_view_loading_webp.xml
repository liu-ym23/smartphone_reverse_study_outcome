<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:rounded_radius="4dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center"
        android:id="@+id/shopping_loading_lottie_drawee"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="60dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/shopping_fl_xg_or_tt_loading_lottie"
        android:background="@color/shopping_color_85000000"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/shopping_iv_xg_or_tt_loading_lottie"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/shopping_ic_xg_or_tt_loading"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/tt_loading"
        android:background="@drawable/tt_loading_bg"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp">
        <ProgressBar
            android:id="@+id/tt_loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateDrawable="@drawable/tt_loading_progress_res"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_loading_hint"/>
    </LinearLayout>
</com.bytedance.android.ec.core.widget.RoundedFrameLayout>
