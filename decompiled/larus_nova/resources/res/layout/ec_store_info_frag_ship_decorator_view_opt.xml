<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/store_info_decorator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/store_info_decorator_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="top|left"
        android:id="@+id/store_info_decorator_icon"
        android:layout_width="0dp"
        android:layout_height="14sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="15dp"
        app:layoutMode="width_self_adjust"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#c0ffffff"
        android:layout_gravity="top|right"
        android:id="@+id/store_info_decorator_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6sp"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
