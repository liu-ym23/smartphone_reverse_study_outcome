<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_comment_item_fragment_layout_1393347107"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.commentfeed.HorizontalRecyclerView
        android:id="@+id/ec_comment_feed_item_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_comment_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="48dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/commerce_color_FFFFFF"
                android:id="@+id/ec_comment_feed_item_tv_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.shopping.commentfeed.widget.CommentImageIndicatorNumView
                android:id="@+id/ec_comment_image_indicator_num_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <com.bytedance.android.shopping.commentfeed.widget.ECExpandableTextView
            android:id="@+id/ec_comment_feed_item_content_text"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:collapsed_content="@string/shopping_tv_collapsed"
            app:content_maxHeight="220dp"
            app:content_text_maxLine="4"
            app:content_textcolor="@color/commerce_color_FFFFFF"
            app:content_textsize="15dp"
            app:expandable_status_textcolor="@color/commerce_color_FFFFFF"
            app:expandable_status_textsize="12dp"
            app:expanded_content="@string/shopping_tv_expanded"/>
    </LinearLayout>
    <com.bytedance.android.shopping.commentfeed.widget.CommentItemDiggView
        android:orientation="vertical"
        android:id="@+id/ec_commerce_comment_digg_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="312dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.shopping.commentfeed.widget.CommentIndicatorLayout
        android:id="@+id/ec_commerce_comment_indicator_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="32dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:gravity="center_horizontal"
        android:id="@+id/ec_comment_no_more_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:text="@string/shopping_tip_no_more_data"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
