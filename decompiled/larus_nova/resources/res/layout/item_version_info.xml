<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/version_info_checkbox"
        android:padding="0dp"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="radio"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/version_info_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/version_info_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:id="@+id/version_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/version_info_title_text_left_margin"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/price_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/version_info_symbol_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_caption"
            android:gravity="center_vertical"
            android:id="@+id/price_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/version_info_symbol_top_margin"/>
        <TextView
            android:textSize="@dimen/version_info_price_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/price_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/version_info_price_count_horizontal_margin"
            android:layout_marginRight="@dimen/version_info_price_count_horizontal_margin"
            android:minWidth="@dimen/version_info_price_count_min_width"/>
        <TextView
            android:textSize="@dimen/version_info_unit_text_size"
            android:textColor="@color/text_caption"
            android:gravity="center_vertical"
            android:id="@+id/price_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/version_info_unit_top_margin"/>
    </LinearLayout>
</LinearLayout>
