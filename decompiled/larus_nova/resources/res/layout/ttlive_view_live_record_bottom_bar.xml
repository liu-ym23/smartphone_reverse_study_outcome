<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/record_bottom_bar"
        android:background="@drawable/ttlive_bg_live_record_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/new_bg_dismiss_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/record_ready_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:id="@+id/iv_start"
                android:background="@drawable/ttlive_bg_live_record_start"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/record_hint"
                android:background="@drawable/ttlive_bg_live_record_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:layout_above="@+id/iv_start"
                app:layout_constraintBottom_toTopOf="@+id/iv_start"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="70dp"
                android:text="@string/ttlive_cancel"
                android:shadowColor="#1a000000"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:drawableTop="@drawable/ttlive_ic_live_record_cancel"
                android:layout_marginStart="70dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_start"
                app:layout_constraintLeft_toRightOf="@+id/iv_start"
                app:layout_constraintTop_toTopOf="@+id/iv_start"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/tv_clear_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="70dp"
                android:text="@string/ttlive_clear_screen"
                android:shadowColor="#1a000000"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:drawableTop="@drawable/ttlive_ic_live_clear_screen_off"
                android:layout_marginEnd="70dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_start"
                app:layout_constraintRight_toLeftOf="@+id/iv_start"
                app:layout_constraintTop_toTopOf="@+id/iv_start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dismiss_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/bg_interaction_view"
            android:background="#f2000000"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/ll_record_user_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="13dp"
            android:textColor="#b3ffffff"
            android:gravity="right"
            android:id="@+id/tv_water_mark_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="143dp"
            android:maxLines="2"
            android:shadowColor="#77000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#b3ffffff"
            android:id="@+id/tv_water_mark_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#77000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:layout_below="@+id/tv_water_mark_label"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragParentView
        android:id="@+id/drag_parent_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
