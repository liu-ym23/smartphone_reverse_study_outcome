<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.card.view.page.PageCellContainerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cell_container"
    android:background="@drawable/bitable_page_container_item_bg"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/cell_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="cell_title_container,cell_content_container"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="12dp"
        app:flow_horizontalStyle="spread_inside"
        app:flow_verticalGap="8dp"
        app:flow_wrapMode="chain"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/cell_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/cell_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/empty_add_view"
            android:background="@drawable/bitable_page_field_empty_value_icon_bg"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cell_content_empty_uneditable"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="20dp"
            android:tint="@color/icon_disable"
            app:srcCompat="@drawable/ud_icon_reduce_outlined"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_placeholder"
            android:id="@+id/fast_add_autofill_tips_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_QuickAdd_AutoFillAfterSubmit_Placeholder"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cell_content_container"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/function_danger_500"
        android:ellipsize="end"
        android:id="@+id/warning_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <FrameLayout
        android:id="@+id/cell_content_right_icon_parent"
        android:layout_width="@dimen/space_kit_len_24"
        android:layout_height="@dimen/space_kit_len_24"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cell_content_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/cell_content_right_icon"
            android:background="@drawable/facade_round_around_s"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/icon_n3"
            android:backgroundTint="@color/bitable_page_field_item_right_icon_color"/>
    </FrameLayout>
</com.bytedance.ee.bear.bitable.card.view.page.PageCellContainerLayout>
