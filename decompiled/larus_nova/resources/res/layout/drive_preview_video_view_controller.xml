<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_controller_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/drive_video_player_title_root"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/static_white"
            android:layout_gravity="top|left"
            android:id="@+id/file_name_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="55dp"
            android:singleLine="true"/>
        <FrameLayout
            android:layout_gravity="top|right"
            android:id="@+id/control_fullscreen_root"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <FrameLayout
                android:id="@+id/drive_video_player_enter_full_screen_button"
                android:background="@drawable/drive_block_play_bg_round"
                android:padding="11dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tint="@color/white"
                    app:srcCompat="@drawable/ud_icon_screen_rotation_outlined"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drive_video_player_back_image"
                android:background="@drawable/drive_block_play_bg_round"
                android:padding="11dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tint="@color/white"
                app:srcCompat="@drawable/ud_icon_screen_rotation_outlined"/>
        </FrameLayout>
    </FrameLayout>
    <com.bytedance.ee.bear.drive.view.widget.ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/progress_bar"
        android:background="@color/lkui_N900"
        android:layout_width="match_parent"
        android:layout_height="@dimen/drive_progress_bar_height"
        app:backgroundAlpha="0.1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/block_play"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/drive_player_play_button"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/static_white"
        android:layout_gravity="bottom|left"
        android:id="@+id/block_length"
        android:background="@drawable/drive_block_video_length"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"/>
    <View
        android:id="@+id/drive_video_controller_view_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
