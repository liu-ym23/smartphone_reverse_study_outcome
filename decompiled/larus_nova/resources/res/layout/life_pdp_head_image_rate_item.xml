<?xml version="1.0" encoding="utf-8"?>
<android.widget.FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/head_image_item_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/container_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/container"
            android:background="@drawable/life_pdp_head_image_rate_bg"
            android:layout_width="match_parent"
            android:layout_height="244dp"
            android:layout_marginTop="100dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <include
                android:id="@+id/loading_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/life_pdp_head_image_rate_item_loading"/>
            <include
                android:id="@+id/error_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/life_pdp_head_image_rate_item_error"/>
            <include
                android:id="@+id/success_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/life_pdp_head_image_rate_item_success"/>
        </FrameLayout>
    </FrameLayout>
</android.widget.FrameLayout>
