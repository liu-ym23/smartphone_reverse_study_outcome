<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_sms_code_send_top_tip_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignWithParentIfMissing="true">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_bg_inverse"
            android:id="@+id/cj_sms_code_bubble_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="12sp"
        android:textColor="@color/cj_std_ui_component_text_error_color"
        android:id="@+id/cj_sms_code_input_error_tip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/cj_sms_code_input_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/cj_sms_code_send_top_tip_layout"
        android:layout_centerHorizontal="true">
        <com.android.ttcjpaysdk.base.ui.component.input.CJSmsCodeInputView
            android:id="@+id/cj_sms_code_input_view"
            android:visibility="visible"
            style="@style/CJ_Pay_New_Verification_Code_Style_Opt"/>
    </FrameLayout>
    <include
        android:id="@+id/cj_sms_code_agreement_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_sms_code_input_layout"
        android:layout_alignStart="@+id/cj_sms_code_input_layout"
        layout="@layout/cj_pay_view_agreement_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cj_sms_code_send_bottom_tip_layout"
        android:paddingTop="@dimen/cj_pay_padding_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_sms_code_input_layout"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_link_default"
            android:gravity="left"
            android:id="@+id/cj_sms_code_acquire_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_reacquire_sms_code_enable_tip"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
</RelativeLayout>
