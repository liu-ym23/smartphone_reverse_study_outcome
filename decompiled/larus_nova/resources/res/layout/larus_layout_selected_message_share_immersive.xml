<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.bot.share.ImmerseBgBitmapImageView
        android:id="@+id/immerse_avatar_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_spacing"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_47"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/header_mask"
        android:background="@drawable/larus_bg_selected_msg_share_header"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_160"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/header_container"
        android:background="@drawable/larus_bg_selected_msg_share_title"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_spacing">
        <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24">
            <ImageView
                android:id="@+id/header_avatar"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/larus_common_ui_avatar_placeholder"/>
        </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_static_white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/message_container"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_109"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <com.larus.common_ui.widget.MaxHeightRecyclerView
            android:id="@+id/message_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="2780dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.bmhome.chat.view.share.MessageListMaskView
        android:id="@+id/mask_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer_container"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingBottom="?attr/larus_dp_26"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_container">
        <include layout="@layout/larus_layout_share_footer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
