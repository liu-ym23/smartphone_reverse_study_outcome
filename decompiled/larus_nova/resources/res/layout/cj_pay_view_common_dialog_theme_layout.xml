<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_16"
    android:layout_width="@dimen/cj_pay_height_270"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_common_dialog_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/close_dialog_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:src="?attr/cj_pay_icon_titlebar_left_close_noise_reduction"/>
        <TextView
            android:textSize="17sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_title_view"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="@dimen/cj_pay_padding_3"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_sub_title_view"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="left"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_content_view"
            android:paddingLeft="@dimen/cj_pay_padding_20"
            android:paddingRight="@dimen/cj_pay_padding_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15dp"
        android:textColor="?attr/cj_pay_text_always_white"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/cj_pay_common_dialog_single_btn_view"
        android:background="@drawable/cj_pay_bg_red_btn_radius_4_fe2c55"
        android:paddingLeft="@dimen/cj_pay_padding_12"
        android:paddingRight="@dimen/cj_pay_padding_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="20dp"
        android:singleLine="true"
        android:layout_below="@+id/cj_pay_common_dialog_title_layout"/>
</RelativeLayout>
