<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_44">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_icon"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:contentDescription="@string/larus_accessibility_icon_back"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_ic_left_back"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/more_icon"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:tint="@color/larus_neutral_100"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_common_slide_more"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share_icon"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:tint="@color/larus_neutral_100"
        android:contentDescription="@string/larus_accessibility_icon_share"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/more_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_image_detail_icon_share_hollow"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/user_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_10"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_icon"
        app:layout_constraintStart_toEndOf="@+id/user_avatar_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/user_avatar_icon"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:contentDescription="@string/larus_accessibility_profile_profilePhoto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"
        app:roundAsCircle="true"/>
</merge>
