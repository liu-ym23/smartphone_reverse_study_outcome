<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_reference_title_wrapper"
        android:background="@drawable/larus_office_sdk_loading_card_bg"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp_17"
            android:id="@+id/text_loading_main_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_reference_title"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/sdv_reference_icon"
                android:layout_width="?attr/larus_dp_22"
                android:layout_height="?attr/larus_dp_22"
                android:layout_marginEnd="?attr/larus_dp_4"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextSwitcher
                    android:id="@+id/tv_switcher_reference_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_neutral_70"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_reference_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_24"
                    android:maxLines="1"
                    android:maxEms="15"/>
            </FrameLayout>
        </com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
