<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.container.datadrill.TableTabList
        android:id="@+id/tabBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.bytedance.ee.bear.bitable.uikit.search.SearchBar
            android:id="@+id/searchBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/space_kit_font_15"
            android:textColor="@color/primary_fill_default"
            android:id="@+id/cancelSearchBtn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Doc_Facade_Cancel"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/noticeTip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:ud_notice_backgroundColor="@color/function_info_fill_solid_02"
        app:ud_notice_icon="@drawable/ud_icon_info_hollow_filled"
        app:ud_notice_iconColor="@color/function_info_fill_default"
        app:ud_notice_textColor="@color/text_title"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.BitableNativeViewContainer
        android:id="@+id/nativeViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
