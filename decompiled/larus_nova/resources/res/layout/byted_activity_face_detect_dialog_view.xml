<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main"
    android:background="@color/byted_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.opengl.GLSurfaceView
        android:id="@+id/id_gl_sv"
        android:layout_width="217dp"
        android:layout_height="217dp"
        android:layout_centerInParent="true"/>
    <com.ss.android.bytedcert.view.RoundedRectangleImageView
        android:id="@+id/iv_wb_mask"
        android:visibility="gone"
        android:layout_width="217dp"
        android:layout_height="217dp"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/rl_face_subscript"
        android:padding="12dp"
        android:visibility="invisible"
        android:layout_width="217dp"
        android:layout_height="217dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_face_left_top"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@mipmap/byted_dialog_face_ic_left_top"
            android:contentDescription="@string/byted_dialog_face_detect_tip"/>
        <ImageView
            android:id="@+id/iv_face_left_bottom"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@mipmap/byted_dialog_face_ic_left_bottom"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/byted_dialog_face_detect_tip"/>
        <ImageView
            android:id="@+id/iv_face_right_top"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@mipmap/byted_dialog_face_ic_right_top"
            android:layout_alignParentRight="true"
            android:contentDescription="@string/byted_dialog_face_detect_tip"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/iv_face_right_bottom"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@mipmap/byted_dialog_face_ic_right_bottom"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/byted_dialog_face_detect_tip"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:orientation="vertical"
        android:id="@+id/view_face_detect_dialog"
        android:background="@drawable/byted_cert_face_detect_dialog_bg"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_no_face_left_top"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@mipmap/byted_dialog_face_ic_left_top"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/byted_dialog_face_detect_tip"
        android:translationX="-14dp"
        android:translationY="-29dp"/>
    <ImageView
        android:id="@+id/iv_no_face_left_bottom"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@mipmap/byted_dialog_face_ic_left_bottom"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/byted_dialog_face_detect_tip"
        android:translationX="-14dp"
        android:translationY="-0.5dp"/>
    <ImageView
        android:id="@+id/iv_no_face_right_top"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@mipmap/byted_dialog_face_ic_right_top"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/byted_dialog_face_detect_tip"
        android:translationX="14dp"
        android:translationY="-29dp"/>
    <ImageView
        android:id="@+id/iv_no_face_right_bottom"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@mipmap/byted_dialog_face_ic_right_bottom"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/byted_dialog_face_detect_tip"
        android:translationX="14dp"
        android:translationY="-0.5dp"/>
    <ImageView
        android:id="@+id/iv_no_face_face_mask"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@mipmap/byted_dialog_face_ic_face"
        android:layout_centerInParent="true"
        android:contentDescription="@string/byted_dialog_face_detect_tip"
        android:translationY="-15dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_task_board"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lines="1"
        android:singleLine="true"
        android:layout_below="@+id/iv_no_face_face_mask"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="0dp"/>
</RelativeLayout>
