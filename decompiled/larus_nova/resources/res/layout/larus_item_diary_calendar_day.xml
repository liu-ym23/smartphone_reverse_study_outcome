<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_45">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/diary_calendar_item_emoji"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_ic_diary_loading"/>
    <View
        android:id="@+id/diary_calendar_item_empty"
        android:background="@drawable/larus_bg_diary_empty"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/diary_calendar_item_selected_bg"
        android:background="@drawable/larus_bg_diary_calendar_selected"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/diary_calendar_item_day"
        app:layout_constraintEnd_toEndOf="@+id/diary_calendar_item_day"
        app:layout_constraintStart_toStartOf="@+id/diary_calendar_item_day"
        app:layout_constraintTop_toTopOf="@+id/diary_calendar_item_day"/>
    <TextView
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/diary_calendar_item_today_bg_normal"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:text="今"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/diary_calendar_item_today_bg_selected"
        android:background="@drawable/larus_bg_diary_calendar_today"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:text="今"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/diary_calendar_item_day"
        android:layout_width="?attr/larus_dp_25"
        android:layout_height="?attr/larus_dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
