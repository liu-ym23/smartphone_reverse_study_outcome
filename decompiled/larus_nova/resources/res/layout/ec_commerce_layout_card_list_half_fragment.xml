<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.card_list.widgets.CardListRootFrameLayoutContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:alpha="0.6"
        android:importantForAccessibility="no"/>
    <com.bytedance.android.shopping.card_list.widgets.CardListRootFrameLayoutContainer
        android:id="@+id/card_list_container"
        android:background="#f5f6f9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/bottomSheetStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/card_list_main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_list_body_title"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.shopping.card_list.widgets.nest.CardListSwipeNestRefreshLayout
                android:id="@+id/card_list_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/place_holder_footer"
                app:layout_constraintTop_toBottomOf="@+id/card_list_body_title">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vv">
                    <com.bytedance.android.shopping.card_list.widgets.CardListRefreshHeadView
                        android:id="@+id/pull_refresh_header"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="-32dp"/>
                    <com.bytedance.android.shopping.card_list.widgets.nest.CardListLinkedScrollView
                        android:id="@+id/linked_scroll_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </com.bytedance.android.shopping.card_list.widgets.nest.CardListSwipeNestRefreshLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/place_holder_footer"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/debug_btn_native"
            android:background="@color/order_list_FE496A"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="Native"
            android:alpha="0.8"/>
        <FrameLayout
            android:id="@+id/card_list_error_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/card_list_loading_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.shopping.card_list.widgets.CardListRootFrameLayoutContainer>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_list_header"
            android:focusable="true"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_footer_Hybrid_popup_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pendant_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/card_list_footer"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/back_to_top_btn"
            android:background="@drawable/commerce_anchor_v4_back_to_top_btn"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="60dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toTopOf="@+id/card_list_footer"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_list_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_footer_popup_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_list_sort_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_list_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.shopping.card_list.widgets.CardListRootFrameLayoutContainer>
