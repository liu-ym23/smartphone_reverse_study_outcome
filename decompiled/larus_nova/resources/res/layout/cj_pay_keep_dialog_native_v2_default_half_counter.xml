<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_lynx_dialog_root_layout"
    android:background="@drawable/cj_pay_grey_bg_fragment_container"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true">
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/keep_dialog_close_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:id="@+id/keep_dialog_v2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:maxLines="2"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/cj_pay_reverse_counter_voucher_layout"
        android:background="@drawable/cj_pay_white_bg_with_radius"
        android:paddingLeft="16dp"
        android:paddingTop="20dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/keep_dialog_v2_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_reverse_counter_inner_card_title"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择放弃原因"/>
            <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayReasonSelectorLayout
                android:id="@+id/keep_dialog_reason_selector"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/cj_pay_reverse_bottom_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/cj_pay_reverse_counter_voucher_layout">
        <RelativeLayout
            android:id="@+id/cj_pay_reverse_counter_cancel_button_layout"
            android:background="@drawable/cj_pay_reverse_counter_cancel_button_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff161823"
                android:id="@+id/cj_pay_reverse_counter_cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="5dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:id="@+id/cj_pay_reverse_counter_confirm_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/cj_pay_reverse_bottom_button_layout"
        app:theme_type="0"/>
</RelativeLayout>
