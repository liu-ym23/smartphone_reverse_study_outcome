<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/larus_item_adjust_app_icon_225438791"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/larus_item_adjust_app_icon_1137982379"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/static_avatar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/larus_share_app_icon"
            app:roundAsCircle="true"/>
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/dynamic_avatar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/appAboveCircle"
            android:background="@drawable/larus_app_above_circle"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.larus.setting.impl.iconchanger.CircleRingView
            android:layout_gravity="center"
            android:id="@+id/selctCircle"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
