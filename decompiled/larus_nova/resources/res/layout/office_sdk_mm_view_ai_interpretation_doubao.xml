<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/office_sdk_mm_half_screen_dialog_padding_bottom_doubao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.titlebar.MmTitleBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tbv_title_text="@string/office_sdk_mm_ai_interpretation_title_doubao"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
            android:textSize="13sp"
            android:textColor="@color/office_sdk_mm_color_ai_interpretation_section_title_doubao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/View_G_Interpret_Ai_SetChannel_Title"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/aiInterpretationLanguageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/flow_ud_static_white"
                android:gravity="center"
                android:id="@+id/startAIInterpretation"
                android:background="@drawable/office_sdk_mm_bg_ai_interpretation_start_button_doubao"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/View_G_AiInterpret_Start_Button"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/office_sdk_mm_color_ai_interpretation_stop_text_doubao"
                android:gravity="center"
                android:id="@+id/stopAIInterpretation"
                android:background="@drawable/office_sdk_mm_bg_ai_interpretation_stop_button_doubao"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/View_G_AiInterpret_Stop_Button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
