<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="191dp"
    android:layout_height="34dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/group_live_room_widget_bg"
        android:layout_width="191dp"
        android:layout_height="34dp"
        android:src="@drawable/ttlive_bg_group_live_room_widget"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/more_anchor"
        android:layout_width="86dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:text="@string/ttlive_group_live_room_show_more_anchor"
        android:alpha="0.75"
        android:layout_marginStart="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_avatar_3"
        android:background="@drawable/ttlive_bg_group_live_room_user_avatar"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="138dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/inner_user_avatar_3"
            android:background="@drawable/ttlive_bg_group_live_room_inner_user_avatar"
            android:layout_width="21dp"
            android:layout_height="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_base_group_live_room_inner_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_avatar_2"
        android:background="@drawable/ttlive_bg_group_live_room_user_avatar"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="122dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/inner_user_avatar_2"
            android:background="@drawable/ttlive_bg_group_live_room_inner_user_avatar"
            android:layout_width="21dp"
            android:layout_height="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_base_group_live_room_inner_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_avatar_1"
        android:background="@drawable/ttlive_bg_group_live_room_user_avatar"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="106dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/inner_user_avatar_1"
            android:background="@drawable/ttlive_bg_group_live_room_inner_user_avatar"
            android:layout_width="21dp"
            android:layout_height="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_base_group_live_room_inner_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/send_to_anchor"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:alpha="0"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/send_text"
            android:layout_width="14dp"
            android:layout_height="20dp"
            android:layout_marginTop="9dp"
            android:text="@string/ttlive_group_live_room_send_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="73dp"
            android:layout_height="20dp"
            android:layout_marginTop="9dp"
            android:lines="1"
            android:layout_marginStart="35dp"
            app:layout_constraintStart_toEndOf="@+id/send_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/current_user_avatar"
        android:background="@drawable/ttlive_bg_group_live_room_current_user_avatar"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginTop="7dp"
        android:alpha="1"
        android:layout_marginStart="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/current_inner_user_avatar"
            android:background="@drawable/ttlive_bg_group_live_room_inner_user_avatar"
            android:layout_width="21dp"
            android:layout_height="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_base_group_live_room_inner_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/more_image"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/ttlive_group_live_room_more"
        android:alpha="0"
        android:layout_marginStart="144dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
