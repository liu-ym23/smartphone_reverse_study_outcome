<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_float_base"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rootView"
        android:background="@color/bg_float_base"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.BaseTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:widget_widgets_tb_background="@color/bg_float_base"
            app:widget_widgets_tb_divider_visible="false"
            app:widget_widgets_tb_title="@string/Bitable_BTModule_EditField"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_below="@+id/titleBar">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.larksuite.component.universe_design.notice.UDNotice
                    android:id="@+id/notice"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ud_notice_backgroundColor="@color/function_warning_100"
                    app:ud_notice_icon="@drawable/ud_icon_warning_colorful"
                    app:ud_notice_iconColorful="true"
                    app:ud_notice_text=""
                    app:ud_notice_textBtn=""
                    app:ud_notice_textBtnPosition="auto"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fieldBaseMetaContainer"
                    android:paddingTop="@dimen/space_kit_len_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_kit_len_16"
                    android:paddingEnd="@dimen/space_kit_len_16">
                    <TextView
                        android:textSize="@dimen/space_kit_font_14"
                        android:textColor="@color/text_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_BTModule_FieldName"/>
                    <com.larksuite.component.universe_design.edittext.UDTextInputLayout
                        android:id="@+id/fieldNameErrorBg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_kit_len_4">
                        <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.FieldEditText
                            android:textSize="@dimen/space_kit_font_16"
                            android:gravity="center_vertical"
                            android:id="@+id/fieldNameET"
                            android:paddingLeft="@dimen/space_kit_len_16"
                            android:paddingRight="@dimen/space_kit_len_16"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_kit_len_52"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:imeOptions="actionDone"
                            app:ud_backgroundColor="@color/bg_float"
                            app:ud_editText_clearBtnEnabled="true"
                            app:ud_editText_iconHeight="@dimen/space_kit_len_16"
                            app:ud_editText_iconWidth="@dimen/space_kit_len_16"
                            app:ud_editText_rightIconTint="@color/icon_n3"
                            app:ud_radius="xl"
                            app:ud_strokeColor="@color/bitable_field_edittext_stroke_color"
                            app:ud_strokeWidth="0dp"
                            style="@style/SpaceEditTextStyle"/>
                    </com.larksuite.component.universe_design.edittext.UDTextInputLayout>
                    <TextView
                        android:textSize="@dimen/space_kit_font_14"
                        android:textColor="@color/text_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_kit_len_14"
                        android:text="@string/Bitable_BTModule_FieldType"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/fieldTypeSelectorWrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/fieldTypeSelector"
                            android:background="@drawable/facade_round_around_xl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_kit_len_4"
                            android:minHeight="@dimen/space_kit_len_52"
                            android:paddingStart="@dimen/space_kit_len_16"
                            android:paddingEnd="@dimen/space_kit_len_16"
                            android:backgroundTint="@color/facade_selector_item_float">
                            <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
                                android:id="@+id/fieldTypeIV"
                                android:layout_width="@dimen/space_kit_len_20"
                                android:layout_height="@dimen/space_kit_len_20"
                                android:tint="@color/icon_n1"/>
                            <TextView
                                android:textSize="@dimen/space_kit_font_16"
                                android:textColor="@color/text_title"
                                android:id="@+id/fieldTypeTV"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_kit_len_12"
                                android:layout_marginEnd="@dimen/space_kit_len_12"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/fieldRightIcon"
                                android:layout_width="@dimen/space_kit_len_16"
                                android:layout_height="@dimen/space_kit_len_16"
                                android:tint="@color/icon_n3"
                                app:srcCompat="@drawable/ud_icon_right_outlined"/>
                        </LinearLayout>
                        <include layout="@layout/bitable_field_shortcut"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/aiConfigLayout"
                        android:background="@drawable/facade_round_around_xl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_kit_len_16"
                        android:minHeight="@dimen/space_kit_len_52"
                        android:paddingStart="@dimen/space_kit_len_16"
                        android:paddingEnd="@dimen/space_kit_len_16"
                        android:backgroundTint="@color/facade_selector_item_float">
                        <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
                            android:layout_width="@dimen/space_kit_len_20"
                            android:layout_height="@dimen/space_kit_len_20"
                            android:src="@drawable/ud_icon_myai_colorful"/>
                        <TextView
                            android:textSize="@dimen/space_kit_font_16"
                            android:textColor="@color/text_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/Bitable_BaseAI_AIField_GenerateWithAI_Option"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_kit_len_12"
                            android:layout_marginEnd="@dimen/space_kit_len_12"/>
                        <TextView
                            android:textSize="@dimen/space_kit_font_14"
                            android:textColor="@color/icon_n2"
                            android:id="@+id/aiConfigTx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/space_kit_len_12"
                            android:layout_marginEnd="@dimen/space_kit_len_12"/> /&gt; 
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/space_kit_len_16"
                            android:layout_height="@dimen/space_kit_len_16"
                            android:tint="@color/icon_n3"
                            app:srcCompat="@drawable/ud_icon_right_outlined"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fieldPropertyWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:id="@+id/fieldPropertyEditContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.ee.bear.bitable.fieldedit.view.edit.extendfield.ExtendFieldPropertyEditView
                        android:id="@+id/fieldPropertyExtendContainer"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/space_kit_len_16"
                        android:paddingEnd="@dimen/space_kit_len_16"/>
                </LinearLayout>
                <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
                    android:id="@+id/keyboardPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</FrameLayout>
