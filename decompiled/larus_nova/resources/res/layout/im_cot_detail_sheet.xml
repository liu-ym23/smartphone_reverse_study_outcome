<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_cot_detail_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">
        <com.ss.android.lark.widget.textview.ShineTextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/cot_detail_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/cot_detail_header_close"
            android:layout_alignParentStart="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cot_detail_header_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_close_outlined"
            app:tint="@color/icon_n3"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/cot_detail_recycler_view"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <FrameLayout
        android:id="@+id/cot_detail_bottom_action_container"
        android:background="@color/bg_body"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cot_detail_stop_button"
            android:background="@drawable/bg_cot_detail_stop_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ud_icon_stop_outlined"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_IM_AgentCot_StopTask_Button"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
