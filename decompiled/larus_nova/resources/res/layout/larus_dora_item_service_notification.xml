<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_64"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dora_noti_v3_service_item_icon"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_10"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/dora_noti_v3_service_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/dora_noti_v3_service_item_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/dora_noti_v3_service_item_selected"
        app:layout_constraintStart_toEndOf="@+id/dora_noti_v3_service_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/dora_noti_v3_service_item_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dora_noti_v3_service_item_title"
        app:layout_constraintStart_toStartOf="@+id/dora_noti_v3_service_item_title"
        app:layout_constraintTop_toBottomOf="@+id/dora_noti_v3_service_item_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dora_noti_v3_service_item_selected"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_dora_ailab_keyword_checkbox_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dora_noti_v3_service_item_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/dora_noti_v3_service_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
