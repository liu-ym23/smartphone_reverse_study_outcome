<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_content"
    android:background="@drawable/list_item_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:civ_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_file_round_doc_colorful"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_shortcut"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_icon"
        app:layout_constraintLeft_toLeftOf="@+id/item_icon"
        app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
    <com.bytedance.ee.bear.list.docstate.SyncStateView
        android:id="@+id/item_sync_state"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toBottomOf="@+id/item_name"/>
    <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/update_time"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/item_icon"
        app:layout_constraintRight_toLeftOf="@+id/item_external_notice"
        app:layout_constraintTop_toTopOf="parent"
        app:titleSize="@dimen/facade_title_text_size"
        app:titleText="@string/Doc_List_TitleLabel"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/update_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/Doc_List_LastUpdateWithSpace"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/list_item_security_desc"
        app:layout_constraintRight_toLeftOf="@+id/item_external_notice"
        app:layout_constraintTop_toBottomOf="@+id/item_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/list_item_sync_state_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_12"
        android:text="@string/Doc_List_WaitingForSync"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/item_sync_state"
        app:layout_constraintTop_toBottomOf="@+id/item_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/list_item_security_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="@dimen/space_kit_len_2"
        android:drawableStart="@drawable/ud_icon_safe_pass_outlined"
        app:layout_constraintBottom_toBottomOf="@+id/update_time"
        app:layout_constraintStart_toEndOf="@+id/list_item_sync_state_desc"
        app:layout_constraintTop_toBottomOf="@+id/item_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_external_notice"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@color/icon_n1"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_warning_outlined"
        app:tint="@color/icon_n3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
