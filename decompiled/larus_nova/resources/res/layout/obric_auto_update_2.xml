<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.appstore.autoupdate.MaxScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/oui_text_2"
                    android:id="@+id/app_update_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="25.5dp"
                    android:layout_marginRight="25.5dp"
                    style="@style/Body_M"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/log_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/auto_update_log"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/app_update_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="24dp"/>
            </LinearLayout>
        </com.obric.appstore.autoupdate.MaxScrollView>
    </RelativeLayout>
</FrameLayout>
