<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_mid_bottom_item_area_height">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_ps_panel_word_75_gray"
        android:id="@+id/create_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_create_chat_channel"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tip_content"
        android:background="@drawable/ttlive_bg_float_window_tips"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="47dp"
        android:layout_marginLeft="1dp"
        android:layout_marginBottom="37dp"
        android:text="@string/ttlive_create_channel_tip_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/create_channel"/>
    <ImageView
        android:id="@+id/create_channel_tips"
        android:padding="10dp"
        android:layout_width="30dp"
        android:layout_height="36dp"
        android:src="@drawable/ttlive_ps_panel_mark_user_desc"
        android:scaleType="centerCrop"
        android:layout_toRightOf="@+id/create_channel"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/create_channel"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@drawable/ttlive_ps_panel_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
