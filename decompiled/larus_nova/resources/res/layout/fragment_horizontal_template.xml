<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/templates"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/left_mask"
        android:background="@drawable/horizontal_template_left_mask"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/templates"
        app:layout_constraintLeft_toLeftOf="@+id/templates"
        app:layout_constraintTop_toTopOf="@+id/templates"/>
    <View
        android:id="@+id/right_mask"
        android:background="@drawable/horizontal_template_right_mask"
        android:layout_width="24dp"
        android:layout_height="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/templates"
        app:layout_constraintRight_toRightOf="@+id/templates"
        app:layout_constraintTop_toTopOf="@+id/templates"/>
    <com.bytedance.ee.bear.list.loadstateview.LoadStateView
        android:id="@+id/loadStateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
