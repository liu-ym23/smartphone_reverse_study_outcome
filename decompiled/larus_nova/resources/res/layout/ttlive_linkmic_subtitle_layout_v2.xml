<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.api.DragContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linkmic_subtitle_root"
        android:layout_width="222dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/speaker_name_container"
            android:background="@drawable/ttlive_bg_subtitle_speaker_name"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="10dp"
                android:textColor="#80ffffff"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/speaker_name"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="2dp"
                android:maxWidth="45dp"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/ttlive_bg_linkmic_subtitle_container_v2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/speaker_name_container">
            <com.bytedance.android.live.liveinteract.voicechat.subtitle.SubtitleRecyclerView
                android:id="@+id/linkmic_subtitle_rv"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linkmic_subtitle_lynx_root"
        android:visibility="gone"
        android:layout_width="222dp"
        android:layout_height="59dp"/>
</com.bytedance.android.livesdk.interactivity.api.DragContainer>
