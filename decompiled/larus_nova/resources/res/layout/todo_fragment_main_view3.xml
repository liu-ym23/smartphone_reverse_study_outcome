<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/todo_content_view"
        android:background="@color/bg_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/tab_container"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_tab"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48sp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/button_more_container"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/bg_more_menu"/>
                <FrameLayout
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.ss.android.lark.todo.impl.features.center.v3.tablayout.FeedTabLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tab_layout_default"
                        style="@style/TodoFeedTabLayout"/>
                    <com.ss.android.lark.todo.impl.features.center.v3.tablayout.CurrentGroupIndicator
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tab_layout_current"
                        style="@style/TodoFeedTabLayout">
                        <com.ss.android.lark.todo.impl.features.center.v3.tablayout.FeedTabTextView
                            android:id="@+id/tab_first"
                            style="@style/TodoTabSlidingItemStyle"/>
                    </com.ss.android.lark.todo.impl.features.center.v3.tablayout.CurrentGroupIndicator>
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/button_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/dp_16">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/image_filter"
                        android:padding="6sp"
                        android:layout_width="32sp"
                        android:layout_height="32sp"
                        app:srcCompat="@drawable/ud_icon_quicksetting_outlined"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/task_list_more_icon"
                        android:padding="6sp"
                        android:visibility="gone"
                        android:layout_width="32sp"
                        android:layout_height="32sp"
                        android:tint="@color/icon_n2"
                        android:layout_marginStart="@dimen/dp_12"
                        app:srcCompat="@drawable/ud_icon_more_outlined"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/filter_container_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_tab">
                <RelativeLayout
                    android:id="@+id/filter_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/task_filter_section_container"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/filter_container_tasklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/tasklist_filter_section_container"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/task_notice_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/filter_container_layout">
                <include layout="@layout/todo_center_notice_container"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/list_content_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tab_container">
            <include layout="@layout/task_list_container"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/list_events_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tab_container">
            <FrameLayout
                android:id="@+id/fragment_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
                android:id="@+id/list_events_linearlayout"
                android:background="@color/bg_base"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                app:rl_radius_left_bottom="@dimen/dp_8"
                app:rl_radius_left_top="@dimen/dp_8"
                app:rl_radius_right_bottom="@dimen/dp_8"
                app:rl_radius_right_top="@dimen/dp_8">
                <include
                    android:id="@+id/events_container"
                    layout="@layout/task_list_events_recycler"/>
                <View
                    android:id="@+id/main_fragment_mask"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/task_lists_manage_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tab_container">
            <FrameLayout
                android:id="@+id/task_lists_manage_fragment_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:id="@+id/task_lists_manage_rl"
                android:background="@color/bg_base"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/task_list_manage_lists"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"/>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/task_list_manage_empty_container"
                    android:background="@color/bg_base"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/task_list_manage_empty_img"
                            android:layout_width="@dimen/dp_125"
                            android:layout_height="@dimen/dp_125"
                            app:srcCompat="@drawable/illustration_empty_positive_complete"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/text_title"
                            android:id="@+id/task_list_manage_empty_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_20"
                            android:layout_marginTop="@dimen/dp_16"
                            android:layout_marginRight="@dimen/dp_20"
                            android:layout_below="@+id/img_empty"/>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/task_create_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <include layout="@layout/task_create_btn_container"/>
    </RelativeLayout>
</RelativeLayout>
