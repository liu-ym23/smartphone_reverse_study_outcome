<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/video_web_sdk_dialog_corner_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="155dp"
        android:layout_height="120dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_web_sdk_brightness_image_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/video_web_sdk_video_brightness"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_web_sdk_tv_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_web_sdk_brightness_progressbar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="20dp"
            android:max="100"
            android:progressDrawable="@drawable/video_web_sdk_volume_progress"
            style="@style/Video_Web_Widget_ProgressBar_Horizontal"/>
    </LinearLayout>
</LinearLayout>
