<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_comment_control_advanced_item_height"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_setting_contaner"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:layout_marginBottom="14dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_ps_panel_word_75_gray"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_switch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="21dp"/>
        <ImageView
            android:id="@+id/iv_switch_title"
            android:visibility="gone"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ttlive_ps_panel_mark_user_desc"/>
        <ImageView
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/ttlive_ic_red_dot_on_white_bg"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_setting_bottom_contaner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_setting_contaner"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_ps_panel_comment_60_gray"
            android:gravity="center_vertical"
            android:id="@+id/tv_label_bottom_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="9dp"
            android:maxWidth="310dp"
            android:minHeight="18dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_ps_panel_comment_60_gray"
            android:gravity="center_vertical"
            android:id="@+id/tv_label_bottom_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="9dp"
            android:maxWidth="310dp"
            android:minHeight="18dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_ps_panel_comment_60_gray"
            android:gravity="center_vertical"
            android:id="@+id/tv_label_bottom_3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="9dp"
            android:maxWidth="310dp"
            android:minHeight="18dp"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_ps_panel_comment_60_gray"
        android:gravity="center_vertical"
        android:id="@+id/tv_switch_description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:maxWidth="310dp"
        android:minHeight="18dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:layout_gravity="center_vertical"
        android:id="@+id/setting_switch"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        app:lsb_background="#21161823"
        app:lsb_border_width="1dp"
        app:lsb_checked_color="#67dca0"
        app:lsb_checkedbutton_color="#ffffff"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"/>
</RelativeLayout>
