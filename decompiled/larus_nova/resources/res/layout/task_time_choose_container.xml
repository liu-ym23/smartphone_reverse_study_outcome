<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/start_time_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_toStartOf="@+id/time_start_end_divider">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/start_no_time_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/start_no_time_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginEnd="@dimen/dp_8"
                app:srcCompat="@drawable/ud_icon_add_middle_outlined"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_placeholder"
                android:id="@+id/start_no_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_TaskStartTime_Button"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/start_have_time_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/start_have_time_txt_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/start_time_date_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/start_time_specific_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/start_have_time_close_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginEnd="@dimen/dp_10"
                app:srcCompat="@drawable/ud_icon_close_outlined"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/time_start_end_divider"
        android:layout_width="@dimen/dp_12"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/end_time_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_toEndOf="@+id/time_start_end_divider">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/end_no_time_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/end_no_time_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginEnd="@dimen/dp_8"
                app:srcCompat="@drawable/ud_icon_add_middle_outlined"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/static_white"
                android:id="@+id/end_no_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_New_DueTime_Text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/end_have_time_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/end_have_time_txt_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/end_time_date_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/static_white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/end_time_specific_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/end_have_time_close_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginEnd="@dimen/dp_10"
                app:srcCompat="@drawable/ud_icon_close_outlined"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
