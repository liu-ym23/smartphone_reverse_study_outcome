<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.creativex.mediaimport.widget.viewpager.SafeViewPager
        android:id="@+id/preview_view_pager"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/larus_ViewPagerForPreview"/>
    <FrameLayout
        android:id="@+id/selector_view_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="top"
        android:id="@+id/preview_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/preview_top_mask"
            android:background="@drawable/larus_tools_media_import_preview_top_mask"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>
        <com.ss.android.ugc.tools.view.widget.AVAutoRTLImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="48dp"
            android:src="?attr/larus_ic_left_back"
            android:tint="@color/larus_static_white"
            android:layout_marginStart="8dp"
            style="@style/larus_BtnPreviewBack"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/container_original_image"
            android:paddingTop="?attr/larus_dp_2"
            android:paddingBottom="?attr/larus_dp_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/btn_back"
            android:layout_alignBottom="@+id/btn_back"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/checkbox_original_image"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_ic_checkbox_original_image_white"
                android:layout_marginEnd="?attr/larus_dp_6"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_static_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_IM_image_radioButton_original"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
