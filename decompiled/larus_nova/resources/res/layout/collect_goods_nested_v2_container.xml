<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.collect.custom_view.MaxHeightRecyclerView
        android:id="@+id/rev1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.collect.custom_view.LoadMoreFooterView
        android:id="@+id/load_more_footer_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <com.bytedance.android.shopping.collect.custom_view.CollectGoodsGULView
        android:id="@+id/nested_v2_gul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
