<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_pay_payment_guide_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_payment_method_merge_icon_layout"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_16">
            <ImageView
                android:id="@+id/cj_pay_payment_method_merge_icon"
                android:layout_width="@dimen/cj_pay_padding_24"
                android:layout_height="@dimen/cj_pay_padding_24"/>
            <ImageView
                android:id="@+id/cj_pay_payment_method_merge_icon_unable_mask"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_24"
                android:layout_height="@dimen/cj_pay_padding_24"
                android:src="@drawable/cj_pay_bg_payment_icon_unable"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/cj_pay_payment_method_merge_content_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_height_56"
            android:layout_marginRight="64dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_16"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_merge_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_10"
                    android:textColor="@color/cj_pay_color_red"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_payment_method_merge_recommend_icon"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_8"
                    android:text="@string/cj_pay_recommend_way"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textColor="@color/cj_pay_color_gray_153"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_merge_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_10"
                    android:textColor="@color/cj_pay_color_red"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cj_pay_payment_method_merge_sub_title_icon"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:layout_gravity="center"
            android:id="@+id/cj_pay_payment_method_checkbox"
            android:layout_width="@dimen/cj_pay_height_24"
            android:layout_height="@dimen/cj_pay_height_24"
            android:layout_marginRight="@dimen/cj_pay_padding_16"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/cj_pay_payment_detail_section"
        android:paddingLeft="@dimen/cj_pay_height_56"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_payment_guide_section">
        <View
            android:id="@+id/cj_pay_middle_divider"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_payment_method_icon_layout"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_18"
            android:layout_height="@dimen/cj_pay_padding_18"
            android:layout_marginRight="@dimen/cj_pay_padding_8">
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon"
                android:layout_width="@dimen/cj_pay_padding_18"
                android:layout_height="@dimen/cj_pay_padding_18"/>
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon_unable_mask"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_18"
                android:layout_height="@dimen/cj_pay_padding_18"
                android:src="@drawable/cj_pay_bg_payment_icon_unable"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/cj_pay_payment_method_content_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="64dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_14"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_10"
                    android:textColor="@color/cj_pay_color_red"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_payment_method_recommend_icon"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_8"
                    android:text="@string/cj_pay_recommend_way"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textColor="@color/cj_pay_color_gray_153"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_10"
                    android:textColor="@color/cj_pay_color_red"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cj_pay_payment_method_sub_title_icon"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_payment_method_arrow"
            android:layout_width="@dimen/cj_pay_padding_16"
            android:layout_height="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cj_pay_payment_method_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:layout_marginTop="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/cj_pay_icon_discount_more_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="56dp"
        android:src="@drawable/cj_pay_icon_discount_more_arrow"
        android:layout_above="@+id/cj_pay_discount_more_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_discount_more_layout"
        android:background="#0ffe2c55"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/cj_pay_payment_detail_section"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12dp"
            android:textColor="#fe2c55"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_discount_more_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="56dp"
            android:maxLines="1"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#fe2c55"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_discount_more_btn"
                android:background="@drawable/cj_pay_bg_douyin_red_btn"
                android:layout_width="64dp"
                android:layout_height="24dp"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_discount_more_loading"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_discount_banner_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_bottom_divider"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
