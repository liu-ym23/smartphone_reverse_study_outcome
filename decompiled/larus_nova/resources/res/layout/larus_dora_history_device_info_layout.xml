<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/larus_dora_bg_history_device_normal"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_8"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_38">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/history_device_image"
        android:layout_width="?attr/larus_dp_13"
        android:layout_height="?attr/larus_dp_20"
        app:actualImageScaleType="fitCenter"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_static_black"
        android:id="@+id/history_device_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_1"
        android:textAlignment="viewStart"/>
</LinearLayout>
