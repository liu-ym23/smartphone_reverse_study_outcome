<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/md_image_group_join_3_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/larus_neutral_transparent_1"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_first"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_second"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            android:layout_marginEnd="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/image_group_img_third"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_first"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_group_img_third"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/larus_accessibility_message_photo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_group_img_second"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/image_group_img_more_tag"
            android:background="@drawable/larus_md_image_group_join_vertical_more_tag_bg"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:paddingStart="?attr/larus_dp_6"
            android:paddingEnd="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/image_group_img_third"
            app:layout_constraintEnd_toEndOf="@+id/image_group_img_third"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
