<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.ugc.aweme.search.common.view.DispatchConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ecSearchRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/bg_header_img_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"/>
    <FrameLayout
        android:id="@+id/ambientContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/statusBarContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/dragIndicatorBar"
            android:background="@drawable/ec_search_drag_guide_bg"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/topGapLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/statusBarContainer">
        <View
            android:id="@+id/topGapView"
            android:layout_width="match_parent"
            android:layout_height="13dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ecSearchScrollView"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topGapLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerContentLayout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ecSearchTitleLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginBottom="11dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/search_TextPrimary_light"
                    android:gravity="center"
                    android:id="@+id/ecSearchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ecSearchClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ec_search_7page_close_btn"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerContentLayout">
            <com.ss.android.ugc.aweme.search.common.view.DispatchFrameLayout
                android:id="@+id/ec_common_search_middle_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/ec_common_search_result_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/ec_common_search_sug_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/ec_ai_search_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ec_search_voice_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/ec_search_saas_ai_input_container"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.ss.android.ugc.aweme.search.common.view.DispatchConstraintLayout>
