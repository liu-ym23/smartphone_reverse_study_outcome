<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/update_image"
            android:background="@color/bg_base"
            android:layout_width="match_parent"
            android:layout_height="221dp"
            android:src="@drawable/ud_icon_image_outlined"
            android:scaleType="centerInside"
            android:tint="@color/icon_n3"
            app:radius="@dimen/space_kit_len_8"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_caption"
            android:id="@+id/reference_data_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/Bitable_AdvancedPermission_AllMemberCanViewReferencedData_Description"/>
        <com.bytedance.ee.bear.shadow.ShadowLinearLayout
            android:id="@+id/effect_list"
            android:background="@color/bg_float"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:borderColor="@color/line_border_card"
            app:borderWidth="0.5dp"
            app:radius="8dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.bytedance.ee.bear.shadow.ShadowLinearLayout>
        <View
            android:id="@+id/bottom_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bitable_panel_bottom_fixed_btn_container_height"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
