<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_float_window_layout"
    android:background="@drawable/ttlive_bg_float_window_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#181823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/ttlive_live_anchor_backtrack_cancel_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#c0162823"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_desc"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:text="@string/ttlive_live_anchor_backtrack_cancel_title_desc"/>
    <View
        android:background="#1e181823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="32dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sure_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/ttlive_live_backtrack_cancel_sure_cancel"
            android:layout_weight="1"/>
        <View
            android:background="#1e181823"
            android:layout_width="0.5dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/continue_record"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/ttlive_live_backtrack_cancel_continue_record"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
