<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_replay_error_container"
    android:background="@color/ttlive_std_bg_inverse"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tv_error_image"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="160dp"
        android:src="@drawable/ttlive_bg_network_error"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/tv_error_hint"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:id="@+id/tv_error_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_vs_loading_error_tips"
        app:layout_constraintBottom_toTopOf="@+id/tv_retry"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/iv_back_icon"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_vs_left_check_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:background="@drawable/ttlive_bg_player_click_to_retry"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_replay_click_to_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_hint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
