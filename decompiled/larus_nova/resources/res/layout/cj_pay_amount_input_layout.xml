<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_cj_amount_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="32sp"
        android:textColor="?attr/cj_pay_page_text_color"
        android:id="@+id/tv_currency_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/cj_pay_currency_unit"
        android:includeFontPadding="false"
        android:layout_alignBaseline="@+id/et_input"
        android:layout_alignBottom="@+id/et_input"/>
    <com.android.ttcjpaysdk.thirdparty.view.CJPayAmountEditText
        android:textSize="44sp"
        android:textColor="?attr/cj_pay_page_text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/et_input"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_8"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:maxLength="11"
        android:layout_toLeftOf="@+id/iv_clear"
        android:layout_toRightOf="@+id/tv_currency_unit"
        android:inputType="numberDecimal"
        android:textCursorDrawable="@drawable/cj_pay_amount_input_cursor_bg"/>
    <ImageView
        android:id="@+id/iv_clear"
        android:paddingLeft="@dimen/cj_pay_padding_10"
        android:paddingTop="@dimen/cj_pay_padding_10"
        android:paddingBottom="@dimen/cj_pay_padding_10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/cj_pay_common_icon_delete_background"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/et_input"/>
</RelativeLayout>
