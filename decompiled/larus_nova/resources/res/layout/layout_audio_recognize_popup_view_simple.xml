<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_recognize_popup_view_bg"
    android:background="@color/bg_body_overlay"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.suite.lark.emm.design.edittext.SCAppCompatEditText
        android:textAppearance="@style/UDText.Body0"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="start|top"
        android:id="@+id/audio_recognize_popup_view_edit_text"
        android:background="@drawable/kb_input_round_bg"
        android:padding="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:minLines="1"
        android:lineSpacingExtra="3sp"
        android:textCursorDrawable="@drawable/text_cursor_drawable_ig"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/audio_record_popup_view_duration_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/audio_recognize_popup_view_main_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_recognize_popup_view_edit_text"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:id="@+id/audio_recognize_popup_view_main_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_record_popup_view_duration_text"
        app:ud_backgroundColor="@color/function_info_content_pressed"
        style="@style/UDButton.Big.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
