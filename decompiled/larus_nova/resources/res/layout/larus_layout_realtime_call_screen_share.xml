<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_20"
        android:textStyle="bold"
        android:textColor="@color/neutral_70"
        android:id="@+id/tv_screen_share_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_call_shareScreen_tip_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/neutral_70"
        android:gravity="center"
        android:id="@+id/tv_screen_share_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_call_shareScreen_tip_desc"
        android:paddingStart="?attr/larus_dp_32"
        android:paddingEnd="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_screen_share_title"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/btn_screen_share_end"
        android:background="@drawable/larus_bg_exit_screen_share"
        android:paddingTop="?attr/larus_dp_11"
        android:paddingBottom="?attr/larus_dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_40"
        android:text="@string/larus_call_shareScreen_stopSharing"
        android:paddingStart="?attr/larus_dp_24"
        android:paddingEnd="?attr/larus_dp_24"
        android:stateListAnimator="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_screen_share_subtitle"/>
</merge>
