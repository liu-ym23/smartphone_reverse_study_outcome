<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_outer_root_layout"
    android:background="@color/cj_pay_color_gray_393B44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dy_loading"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/fl_loading_gif_view"
            android:layout_width="80dp"
            android:layout_height="80dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/cj_pay_brand_pay_label"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_user_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:id="@+id/iv_avatar"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@color/cj_pay_color_gray_248"
            android:scaleType="centerCrop"
            android:alpha="0.5"
            app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="36dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/tv_nickname"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.5"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_user_info_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:alpha="0">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:id="@+id/iv_avatar_left"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@color/cj_pay_color_gray_248"
            android:scaleType="centerCrop"
            android:alpha="0.5"
            app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="36dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/tv_nickname_right"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:alpha="0.5"/>
    </LinearLayout>
</FrameLayout>
