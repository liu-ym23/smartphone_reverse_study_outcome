<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="start|top"
        android:id="@+id/head_view_container"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/head_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="bottom|right"
            android:id="@+id/gender_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ttlive_gender_male_icon"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/play_icon_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_nick_name_usertags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/button_container"
        app:layout_constraintStart_toEndOf="@+id/head_view_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#404040"
            android:ellipsize="end"
            android:id="@+id/tv_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="5"
            android:singleLine="true"/>
        <FrameLayout
            android:id="@+id/grade_level_container"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_grade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/iv_level"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitXY"/>
        </FrameLayout>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tags_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_room_tags"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/button_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/head_view_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_nick_name_usertags">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_fire_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ttlive_audience_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_icon_audience"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_douyin_pklist_audience"
                android:id="@+id/ttlive_audience_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.bytedance.android.live.revlink.impl.multianchor.ui.AnchorLinkInfoView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rival_link_info_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="@+id/button_container"
        app:layout_constraintStart_toStartOf="@+id/ll_room_tags"
        app:layout_constraintTop_toBottomOf="@+id/ll_room_tags"/>
    <FrameLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_room_tags"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_nick_name_usertags">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/invite_container"
            android:layout_width="80dp"
            android:layout_height="28dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_invite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="fitXY"
                app:placeholderImage="@drawable/ttlive_bg_live_red_btn"
                app:roundedCornerRadius="@dimen/ttlive_pk_invite_random_btn_radius"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_invite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ttlive_interact_multi_link_search_invite"/>
        </FrameLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_unaccept_invite"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="64dp"
            android:text="@string/ttlive_interact_multi_link_search_unaccept"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="#e0e0e0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_view_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
