<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="59dp">
    <TextView
        android:textSize="15dp"
        android:textColor="#56000000"
        android:gravity="center"
        android:id="@+id/tv_num"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_head"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_num"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_gender"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintRight_toRightOf="@+id/iv_head"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintLeft_toRightOf="@+id/iv_head"
        app:layout_constraintTop_toTopOf="@+id/iv_head">
        <LinearLayout
            android:gravity="start"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="70dp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/other_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#80161823"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80161823"
                android:id="@+id/tv_control"
                android:background="@drawable/ttlive_bg_list_item_label"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text=""/>
            <View
                android:id="@+id/gap"
                android:background="#16000000"
                android:layout_width="0.5dp"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <ImageView
                android:id="@+id/iv_location"
                android:visibility="visible"
                android:layout_width="10dp"
                android:layout_height="12dp"
                android:src="@drawable/ttlive_ic_location_v2"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80161823"
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text=""
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/ktv_song_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp">
            <View
                android:id="@+id/iv_user_from_type"
                android:background="@drawable/ttlive_icon_ktv_apply_list_song"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80161823"
                android:ellipsize="end"
                android:id="@+id/tv_song_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80161823"
                android:id="@+id/tv_song_suffix"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_arrow"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ttlive_ic_pk_time_setting_arrow"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_head"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_accept"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_head"/>
</androidx.constraintlayout.widget.ConstraintLayout>
