<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ud_O100"
    android:paddingTop="12dp"
    android:paddingRight="11dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/risk_icon"
        android:background="@drawable/ud_icon_warning_colorful"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="2.5dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/risk_banner_txt"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:id="@+id/risk_banner_txt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LarkCCM_Docs_DLP_ExternalSharing_Off"
        app:layout_constraintLeft_toRightOf="@+id/risk_icon"
        app:layout_constraintRight_toLeftOf="@+id/close_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/primary_fill_default"
        android:gravity="center"
        android:id="@+id/see_detail"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LarkCCM_Workspace_Security_Learnmore_mob"
        app:layout_constraintLeft_toLeftOf="@+id/risk_banner_txt"
        app:layout_constraintTop_toBottomOf="@+id/risk_banner_txt"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_icon"
        android:paddingRight="1dp"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_12"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="2.5dp"
        android:tint="@color/ud_N800"
        app:layout_constraintLeft_toRightOf="@+id/risk_banner_txt"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_close_outlined"/>
</androidx.constraintlayout.widget.ConstraintLayout>
