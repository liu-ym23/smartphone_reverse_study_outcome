<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:background="#57000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_content"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/ttlive_anchor_link_dialog_quit_link_confirm_message"/>
        <View
            android:id="@+id/divider_line_1"
            android:background="#f1f1f2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/quit_with_teammate"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/ttlive_anchor_link_dialog_option_quit_with_teammate"/>
        <View
            android:id="@+id/divider_line_2"
            android:background="#f1f1f2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/select_relink_anchor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/ttlive_anchor_link_dialog_option_select_relink_anchor"/>
        <View
            android:background="#f1f1f2"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/ttlive_cancel"/>
    </LinearLayout>
</LinearLayout>
