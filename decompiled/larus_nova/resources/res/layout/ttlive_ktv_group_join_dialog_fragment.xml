<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="35dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_group_avatar"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="35dp"
        app:failureImage="@drawable/ttlive_avatar_placeholder"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="16dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ktv_group_friend_count"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="16dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="24dp">
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_group_online_state"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            layout="@layout/ttlive_viewstub_ktv_group_onlie_state"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#7effffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/ktv_group_in_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
    </FrameLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ktv_group_dialog_access"
        android:background="@drawable/ttlive_ktv_group_btn_selector"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_ktv_group_join"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/main_content"
        app:layout_constraintEnd_toEndOf="@+id/main_content"
        app:layout_constraintTop_toTopOf="@+id/main_content"/>
</LinearLayout>
