<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="52dp"
    android:layout_height="52dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_invite_link_guide_effect"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/ttlive_ktv_empty_bg"
        android:background="@drawable/ttlive_bg_default_anchor_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_empty_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ttlive_ic_interact_guest_add"/>
    <com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayout
        android:layout_gravity="center"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:round="18dp">
        <ImageView
            android:id="@+id/avatar"
            android:visibility="invisible"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <View
            android:id="@+id/shader"
            android:background="@color/white"
            android:visibility="invisible"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tick"
            android:visibility="invisible"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayout>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/guide_button_bg"
        android:background="@drawable/ttlive_bg_friend_online_guide_button_ktv"
        android:visibility="invisible"
        android:layout_width="43dp"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"/>
    <TextView
        android:textSize="8dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/online_text"
        android:visibility="invisible"
        android:layout_width="43dp"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"
        android:text="@string/ttlive_friend_online_text"/>
    <TextView
        android:textSize="8dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/invite_text"
        android:visibility="invisible"
        android:layout_width="34dp"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"
        android:text="@string/ttlive_friend_online_invite"/>
    <TextView
        android:textSize="8dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/has_invited_text"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="12dp"
        android:layout_marginTop="36dp"
        android:text="@string/ttlive_friend_online_has_invited"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#87ffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_empty_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ttlive_live_radio_interact_waiting"
        android:includeFontPadding="false"/>
</FrameLayout>
