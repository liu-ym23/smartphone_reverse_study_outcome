<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_item_container"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_38"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12"
    app:rv_backgroundColor="@color/base_1"
    app:rv_backgroundPressColor="@color/press"
    app:rv_cornerRadius="?attr/larus_dp_8"
    app:rv_strokeColor="@color/neutral_transparent_2"
    app:rv_strokePressColor="@color/press"
    app:rv_strokeWidth="?attr/larus_dp_1">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skill_item_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:src="@drawable/larus_icon_skills"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.GradientTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/skill_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        app:larus_gradient_enable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_11"
        android:textColor="@color/primary_50"
        android:gravity="center"
        android:id="@+id/skill_new_tag"
        android:background="@drawable/larus_action_bar_blue_update_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_18"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="?attr/larus_dp_4"
        android:paddingEnd="?attr/larus_dp_4"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/skill_item_name"
        app:layout_constraintTop_toTopOf="parent"/>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
