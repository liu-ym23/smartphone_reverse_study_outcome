<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/item_bg_selector_c11"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:id="@+id/at_select_box"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:ud_checkbox_type="check_box"/>
        <com.joooonho.SelectableRoundedImageView
            android:id="@+id/single_avator"
            android:visibility="visible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:layout_alignParentBottom="true"
            app:sriv_border_width="0dp"
            app:sriv_oval="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.larksuite.framework.ui.PriorityLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/first_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/department_info"
                app:layout_constraintEnd_toStartOf="@+id/profile_info_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginEnd="@dimen/dp_0">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/ll_name_tag_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:priority="2">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="250dp"
                        android:text="name"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_caption"
                        android:gravity="bottom"
                        android:id="@+id/text_owner"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Lark_Legacy_Creator"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/custom_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/status_icon_left_margin"
                    app:priority="2"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tag_wrapper"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_toEndOf="@+id/ll_name_tag_container"
                    app:priority="3"/>
                <TextView
                    android:textColor="@color/function_danger_500"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/workday_leave"
                    android:background="@drawable/mine_leave_tag_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_toRightOf="@+id/tag_wrapper"
                    android:layout_centerVertical="true"
                    app:priority="3"
                    style="@style/TagTextViewStyle"/>
                <com.suite.lark.platform.component.widget_biz_userstatus.UserStatusLinearLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/user_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_toEndOf="@+id/workday_leave"
                    app:priority="1"/>
            </com.larksuite.framework.ui.PriorityLayout>
            <TextView
                android:ellipsize="start"
                android:layout_gravity="center_vertical"
                android:id="@+id/department_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginEnd="15dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/profile_info_card"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/first_line"
                app:layout_goneMarginEnd="@dimen/dp_0"/>
            <ImageView
                android:id="@+id/profile_info_card"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/first_line"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_business_card_outlined"
                app:tint="@color/icon_n3"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/divider"
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <View
        android:id="@+id/shadow"
        android:background="@drawable/white_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="0.5dp"/>
</FrameLayout>
