<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_presale_ip_activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/tv_top_prefix"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="9dp"
        android:height="12dp"
        app:fontFamily="PingFang SC"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_top_sales"
        android:background="@drawable/commerce_bg_sales"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="8dp"
        app:fontFamily="PingFang SC"
        app:layout_constraintLeft_toRightOf="@+id/tv_top_prefix"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_presale_ip_activity_logo"
        android:layout_width="68dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="11dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.bytedance.android.ec.core.widget.price.PriceView
            android:id="@+id/pv_main"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <com.bytedance.android.ec.core.widget.price.PriceView
            android:textColor="@color/white_75"
            android:id="@+id/pv_market"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/pv_main"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_discount_layout"
            android:background="@drawable/commerce_bg_discount"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            android:layout_marginLeft="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/pv_market">
            <TextView
                android:textSize="11dp"
                android:textStyle="bold"
                android:textColor="@color/ec_inner_flow_presale_activity_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_discount_header"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="3dp"/>
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:layout_gravity="center_vertical"
                android:id="@+id/pv_discount"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/tv_bottom_tips"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginRight="11dp"
            android:layout_marginBottom="2dp"
            app:fontFamily="PingFang SC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
