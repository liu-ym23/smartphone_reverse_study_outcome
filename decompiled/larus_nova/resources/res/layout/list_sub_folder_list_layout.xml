<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smartrefresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_refresh_layout"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:srlEnableLoadMore="false"
    app:srlEnableOverScrollBounce="false"
    app:srlEnableOverScrollDrag="false"
    app:srlEnablePreviewInEditMode="true"
    app:srlEnableRefresh="true">
    <com.bytedance.ee.bear.facade.common.widget.recyclerview.DigitDanceHeader
        android:id="@+id/list_refresh_header"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_60"
        android:layout_marginTop="@dimen/space_kit_len_35"/>
    <com.bytedance.ee.bear.list.homepage.HomeCoordinatorLayout
        android:id="@+id/list_home_coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/list_sub_menu_layout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.bytedance.ee.bear.list.homepage.FlingBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/list_collapsing_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="61dp"
                app:layout_scrollFlags="enterAlwaysCollapsed|enterAlways|exitUntilCollapsed|scroll">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.bytedance.ee.bear.facade.common.widget.recyclerview.DigitDanceHeader
                        android:id="@+id/list_appbar_refresh_header"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/list_home_title_bar_height_min"/>
                    <com.bytedance.ee.bear.facade.common.widget.NoNetworkView
                        android:id="@+id/no_net_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <FrameLayout
                        android:id="@+id/list_notification_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <include
                        android:id="@+id/history_shared_folder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/list_history_shared_folder_tips"/>
                    <com.bytedance.ee.bear.facade.common.widget.ForbiddenBannerView
                        android:id="@+id/list_folder_forbidden"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.ee.bear.facade.common.widget.ForbiddenBannerNewView
                        android:id="@+id/list_folder_new_forbidden"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <com.bytedance.ee.bear.list.homepage.title.SubMenuView
                android:id="@+id/home_sub_title_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_44"/>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.bytedance.ee.bear.list.list.OptimizedListRecyclerView
                android:id="@+id/list_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <com.bytedance.ee.bear.list.loadstateview.LoadStateView
                android:id="@+id/list_state_view_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </com.bytedance.ee.bear.list.homepage.HomeCoordinatorLayout>
</com.scwang.smartrefresh.layout.SmartRefreshLayout>
