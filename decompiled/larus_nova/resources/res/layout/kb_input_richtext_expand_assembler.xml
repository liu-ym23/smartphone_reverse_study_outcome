<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kb_expand_observe_anim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/shadow_view"
        android:background="@color/kb_input_post_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/shadow_click_cover"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.keyboard.widget.DragShrinkLayout
        android:orientation="vertical"
        android:id="@+id/kb_rich_text_shrink_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/post_header_outter_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/full_screen_page_container"
            android:background="@drawable/kb_common_top_corner9_color_c11"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/post_header_inner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/input_container_all"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/post_header_inner_container">
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/kb_rich_text_content_wrapper"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="1dp"
                    android:fillViewport="true"
                    android:overScrollMode="always"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/kb_rich_text_title"
                    app:layout_constraintVertical_weight="1">
                    <include
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/kb_richtext_expand_editor_content2_assembler"/>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end"
                android:id="@+id/ivSendExpand"
                android:layout_width="@dimen/width_keyboard_inject_menu"
                android:layout_height="@dimen/height_keyboard_inject_menu"
                android:layout_marginEnd="12dp"
                app:srcCompat="@drawable/ic_send_btn"/>
            <FrameLayout
                android:id="@+id/et_bottom_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"/>
        </LinearLayout>
    </com.ss.android.lark.keyboard.widget.DragShrinkLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
