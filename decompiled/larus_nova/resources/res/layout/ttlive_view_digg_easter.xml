<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <com.bytedance.android.livesdk.interactivity.publicscreen.topcontainer.likeegg.ui.LikeEggProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/digg_text"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/digg_title_icon"
        app:layout_constraintTop_toTopOf="@+id/progress_bar"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/digg_title_icon"
        android:layout_width="60dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/digg_title_icon_active"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
