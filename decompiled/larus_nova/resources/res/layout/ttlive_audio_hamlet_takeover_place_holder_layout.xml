<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leave_content"
        android:background="#cc000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/icon_leave"
            android:background="@drawable/ttlive_hamlet_avatar_audio_link_leave_ic"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintBottom_toTopOf="@+id/leave_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:id="@+id/leave_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_live_interact_anchor_enter_background"
            app:layout_constraintBottom_toTopOf="@+id/leave_des"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_leave"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#80ffffff"
            android:id="@+id/leave_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_live_interact_anchor_pause_tips_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/leave_title"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/x_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/y_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <View
        android:id="@+id/take_over_view"
        android:layout_width="@dimen/ttlive_hamlet_avatar_place_holder_view_size"
        android:layout_height="@dimen/ttlive_hamlet_avatar_place_holder_view_size"
        app:layout_constraintBottom_toBottomOf="@+id/y_guide_line"
        app:layout_constraintLeft_toLeftOf="@+id/x_guide_line"
        app:layout_constraintRight_toRightOf="@+id/x_guide_line"
        app:layout_constraintTop_toTopOf="@+id/y_guide_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
