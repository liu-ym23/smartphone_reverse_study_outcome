<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="end"
    android:orientation="horizontal"
    android:clipChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.bytedance.android.livesdk.chatroom.view.InterceptTouchScrollView
        android:layout_gravity="bottom"
        android:id="@+id/short_term_indicator_scroll_view"
        android:scrollbars="none"
        android:fadingEdgeLength="25dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="vertical">
        <com.bytedance.android.livesdk.chatroom.view.ShortTermFrameLayout
            android:orientation="vertical"
            android:id="@+id/short_term_icon_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.livesdk.chatroom.view.InterceptTouchScrollView>
    <FrameLayout
        android:id="@+id/enhanced_touch_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ttlive_live_spacing_sti_enhanced_normal"/>
</LinearLayout>
