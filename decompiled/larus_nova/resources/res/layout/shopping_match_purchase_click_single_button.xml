<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_buy_container"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <FrameLayout
        android:id="@+id/fl_buy_text_container"
        android:background="@drawable/shopping_buy_button_mp_default"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/commerce_color_FFFFFF"
            android:layout_gravity="center"
            android:id="@+id/tv_buy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_buy_now"
            android:lineSpacingExtra="2dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_buy_sub_text_container"
        android:background="@drawable/shopping_match_purchase_button_tip"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/product_buy_container"
        app:layout_constraintRight_toRightOf="@+id/product_buy_container"
        app:layout_constraintTop_toTopOf="@+id/product_buy_container">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_buy_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.bytedance.android.shopping.anchorv3.matchpurchase.view.TriangleView
        android:id="@+id/triangle"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="4dp"
        app:layout_constraintLeft_toRightOf="@+id/fl_buy_text_container"
        app:layout_constraintStart_toEndOf="@+id/fl_buy_text_container"
        app:layout_constraintTop_toBottomOf="@+id/fl_buy_sub_text_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
