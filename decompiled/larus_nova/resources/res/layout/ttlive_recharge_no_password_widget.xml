<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/close_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/no_password_widget_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_password_widget_panel"
        android:background="@drawable/ttlive_bg_recharge_dialog_v2"
        android:paddingBottom="34dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="382dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_view"
        app:layout_constraintVertical_bias="1">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/close_panel_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_recharge_dialog_no_password_close_btn"
            app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_close_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_recharge_diamond_unit_color"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"
            android:alpha="0.34"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="36dp"
            android:textColor="#000000"
            android:id="@+id/diamond_count"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="78dp"
            android:alpha="0.9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/currency"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="104dp"
            android:text="钻"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/diamond_count"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_recharge_diamond_unit_color"
            android:id="@+id/diamond_detail"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:text="余额800钻｜还需29800钻(2920元)"
            android:alpha="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diamond_count"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/diamond_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="5dp"
            app:layout_constraintEnd_toStartOf="@+id/diamond_detail"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diamond_count"/>
        <FrameLayout
            android:id="@+id/recharge_no_pw_cj_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp"
            app:layout_constraintBottom_toTopOf="@+id/use_no_password_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pay_method_container"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="208dp"
            android:layout_marginRight="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_recharge_diamond_unit_color"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="支付方式"
                android:alpha="0.6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/pay_method_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/ttlive_recharge_dialog_no_password_douyin_pay"
                app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_douyin_pay"
                app:layout_constraintEnd_toStartOf="@+id/pay_method_label"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_recharge_diamond_unit_color"
                android:id="@+id/pay_method_label"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="4dp"
                android:text="抖音支付"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/pay_method_arrow"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/pay_method_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/ttlive_recharge_dialog_no_password_arrow"
                app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_arrow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/use_no_password_button"
            android:background="@drawable/ttlive_bg_recharge_dialog_pay_no_password_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="243dp"
            android:layout_marginRight="16dp"
            android:text="免密支付2000元并送出该礼物"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_recharge_diamond_unit_color"
            android:id="@+id/without_no_password_button"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="11dp"
            android:text="不使用免密支付"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/use_no_password_button"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#4d000000"
            android:gravity="center_vertical"
            android:id="@+id/protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/use_no_password_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/srceen_center_recharge_mask"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pay_method_choose_dialog"
        android:background="@drawable/ttlive_bg_recharge_dialog_pay_method_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="219dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_recharge_diamond_unit_color"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="13dp"
            android:text="选择支付方式"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/pay_method_dialog_return_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ttlive_recharge_dialog_no_password_method_arrow"
            android:layout_marginStart="16dp"
            app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_method_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/ttlive_bg_recharge_dialog_pay_method_inner_bg"
            android:layout_width="351dp"
            android:layout_height="125dp"
            android:layout_marginTop="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pay_method_douyin_container"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/ttlive_recharge_dialog_no_password_douyin_pay"
                    android:layout_marginStart="12dp"
                    app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_douyin_pay"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/ttlive_recharge_diamond_unit_color"
                    android:id="@+id/pay_method_container_douyin_pay"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="12dp"
                    android:text="抖音支付"
                    android:layout_marginStart="40dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/recommend_douyin_pay"
                    android:background="@drawable/ttlive_recharge_dialog_no_password_method_recommend"
                    android:layout_width="26dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="3dp"
                    android:text="推荐"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toEndOf="@+id/pay_method_container_douyin_pay"
                    app:layout_constraintTop_toTopOf="@+id/pay_method_container_douyin_pay"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="可安全免密支付"
                    app:layout_constraintStart_toStartOf="@+id/pay_method_container_douyin_pay"
                    app:layout_constraintTop_toBottomOf="@+id/pay_method_container_douyin_pay"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/select_douyin_pay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/ttlive_recharge_dialog_no_password_selected"
                    android:layout_marginEnd="12dp"
                    app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_selected"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pay_method_zfb_container"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintTop_toBottomOf="@+id/pay_method_douyin_container">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/ttlive_recharge_dialog_no_password_zfb_pay"
                    android:layout_marginStart="12dp"
                    app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_zfb_pay"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/ttlive_recharge_diamond_unit_color"
                    android:id="@+id/pay_method_container_zfb_pay"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="12dp"
                    android:text="支付宝"
                    android:layout_marginStart="40dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/recommend_zfb_pay"
                    android:background="@drawable/ttlive_recharge_dialog_no_password_method_recommend"
                    android:layout_width="26dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="3dp"
                    android:text="推荐"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toEndOf="@+id/pay_method_container_zfb_pay"
                    app:layout_constraintTop_toTopOf="@+id/pay_method_container_zfb_pay"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="可安全免密支付 | 支持花呗支付"
                    app:layout_constraintStart_toStartOf="@+id/pay_method_container_zfb_pay"
                    app:layout_constraintTop_toBottomOf="@+id/pay_method_container_zfb_pay"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/select_zfb_pay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/ttlive_recharge_dialog_no_password_unselected"
                    android:layout_marginEnd="12dp"
                    app:actualImageResource="@drawable/ttlive_recharge_dialog_no_password_unselected"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
