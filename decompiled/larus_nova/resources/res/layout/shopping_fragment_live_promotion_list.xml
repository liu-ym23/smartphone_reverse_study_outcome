<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/ec_close_button">
    <include
        android:id="@+id/first_tab_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/shopping_layout_live_promotion_list_tab"/>
    <com.bytedance.android.livesdk.livecommerce.promotionlist.widget.LivePromotionListTopTabLayout
        android:id="@+id/tl_promotion_list"
        android:background="@drawable/shopping_bg_live_list_top_tab_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/vp_promotion_list"
        app:layout_constraintEnd_toStartOf="@+id/iv_toggle_top_close_btn"
        app:tabBackground="@color/transparent"
        app:tabGravity="center"
        app:tabIndicator="@drawable/shopping_bg_live_list_top_tab_indicator"
        app:tabIndicatorColor="@color/transparent"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="32dp"
        app:tabMinWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabPaddingTop="0dp"
        app:tabRippleColor="@color/transparent"/>
    <ImageView
        android:id="@+id/iv_toggle_top_close_btn"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ec_icon_promotion_list_top_close"
        android:contentDescription="@string/ec_close_button"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tl_promotion_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tl_promotion_list"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_promotion_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/store_shell_fragment_container_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
