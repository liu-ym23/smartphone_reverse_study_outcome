<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_switch_btn_list_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/ktv_echo_title"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_ktv_echo"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/ktv_echo_switch"
        android:visibility="gone"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_list_item_title"
        app:lsb_background="#cfd0d2"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="@color/ttlive_ktv_adjust_dialog_switch_bg"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="#ffffff"
        app:lsb_uncheckbutton_color="#ffffff"
        app:lsb_uncheckcircle_color="#ffffff"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/echo_volume_title"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_ktv_echo_volume"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_switch_btn_list_top"/>
    <com.bytedance.android.livesdk.widget.SeekBarWithProgress
        android:id="@+id/echo_volume_seek_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/echo_volume_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/echo_volume_title"
        app:layout_constraintTop_toTopOf="@+id/echo_volume_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/voice_volume_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_ktv_voice_volume"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/echo_volume_title"/>
    <com.bytedance.android.livesdk.widget.SeekBarWithProgress
        android:id="@+id/voice_volume_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_volume_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voice_volume_title"
        app:layout_constraintTop_toTopOf="@+id/voice_volume_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/music_volume_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/ttlive_ktv_music_volume"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_volume_title"/>
    <com.bytedance.android.livesdk.widget.SeekBarWithProgress
        android:id="@+id/music_volume_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_volume_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/music_volume_title"
        app:layout_constraintTop_toTopOf="@+id/music_volume_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/adjust_tone_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/ttlive_ktv_adjust_tone"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_volume_title"/>
    <View
        android:id="@+id/ic_decrease"
        android:background="@drawable/ttlive_ktv_tone_decrease_light"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="84dp"
        android:layout_marginStart="84dp"
        app:layout_constraintBottom_toBottomOf="@+id/adjust_tone_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/adjust_tone_title"/>
    <com.bytedance.android.live.ktv.common.adjust.view.ToneProcessView
        android:id="@+id/tone_process"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ic_decrease"
        app:layout_constraintEnd_toStartOf="@+id/ic_increase"
        app:layout_constraintStart_toEndOf="@+id/ic_decrease"
        app:layout_constraintTop_toTopOf="@+id/ic_decrease"
        app:tone_num="9"/>
    <View
        android:id="@+id/ic_increase"
        android:background="@drawable/ttlive_ktv_tone_increase_light"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ic_decrease"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ic_decrease"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_switch_btn_list_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/adjust_tone_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tuning_effect_list"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_switch_btn_list_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
