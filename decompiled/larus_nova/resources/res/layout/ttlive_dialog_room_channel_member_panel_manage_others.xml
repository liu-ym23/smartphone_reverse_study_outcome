<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelLinkShadowView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bottomShow="true"
    app:leftShow="true"
    app:rightShow="true"
    app:shadowColor="#90cccccc"
    app:shadowLimit="8dp"
    app:topShow="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearlayout_container"
        android:background="@drawable/ttlive_bg_room_channel_member_manage_white"
        android:layout_width="160dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/link_report_view"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:contentDescription="@string/ttlive_room_channel_member_manage_report">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ttlive_icon_room_channel_report"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_room_channel_member_manage_report"/>
        </LinearLayout>
        <View
            android:id="@+id/link_report_guide_line"
            android:background="#1d161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/kick_out_link_view"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:contentDescription="@string/ttlive_room_channel_member_manage_kick_out_link">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ttlive_icon_room_channel_down_link"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_room_channel_member_manage_kick_out_link"/>
        </LinearLayout>
        <View
            android:id="@+id/kick_out_link_guide_line"
            android:background="#15161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/kick_out_channel_view"
            android:focusable="true"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:contentDescription="@string/ttlive_room_channel_member_manage_kick_out_channel">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ttlive_icon_room_channel_leave"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#fe3824"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_room_channel_member_manage_kick_out_channel"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="7dp"
        android:layout_height="20dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ttlive_dialog_room_channel_member_panel_manage_arrow"
        android:layout_marginStart="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/linearlayout_container"
        app:layout_constraintStart_toStartOf="@+id/linearlayout_container"/>
</com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelLinkShadowView>
