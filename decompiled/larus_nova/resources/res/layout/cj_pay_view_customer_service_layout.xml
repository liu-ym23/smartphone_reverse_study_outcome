<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_customer_service_layout"
    android:background="@drawable/cj_pay_integrated_bg_dialog"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_customer_service_back_view"
            android:paddingLeft="@dimen/cj_pay_padding_11"
            android:paddingTop="@dimen/cj_pay_padding_13"
            android:paddingRight="@dimen/cj_pay_padding_11"
            android:paddingBottom="@dimen/cj_pay_padding_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_customer_service_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/cj_pay_customer_service_bottom_divider_line"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_14"
        android:textColor="@color/cj_pay_color_black_34"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_customer_service_content"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_56"
        android:lineSpacingExtra="10dp"
        style="@style/CJPayShadowTextStyle"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_customer_service_tel_layout"
        android:layout_width="186dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_22">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/cj_pay_customer_service_tel_tip"
            android:layout_width="47dp"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_customer_service_tel"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/cj_pay_customer_service_tel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_blue"
            android:id="@+id/cj_pay_customer_service_tel_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_customer_service_call"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_customer_service_qq_layout"
        android:layout_width="186dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_22">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/cj_pay_customer_service_qq_tip"
            android:layout_width="47dp"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_customer_service_qq"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/cj_pay_customer_service_qq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_blue"
            android:id="@+id/cj_pay_customer_service_qq_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_customer_service_copy"/>
    </LinearLayout>
</LinearLayout>
