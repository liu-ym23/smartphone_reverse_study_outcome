<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp">
    <com.larksuite.component.universe_design.image.UDAvatar
        android:layout_gravity="center_vertical"
        android:id="@+id/member_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/facade_common_avatar_place_holder"
        android:layout_marginStart="16dp"
        app:ud_avatar_borderWidth="0dp"
        app:ud_avatar_size="large"
        style="@style/UDAvatar.Circle"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.ee.bear.facade.common.widget.CustomTitleView
            android:id="@+id/member_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:titleColor="@color/text_title"
            app:titleSize="@dimen/space_kit_font_14"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/member_department"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
