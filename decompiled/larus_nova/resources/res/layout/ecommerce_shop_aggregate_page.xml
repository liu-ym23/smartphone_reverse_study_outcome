<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/aggregate_back_ground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="70dp"/>
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"/>
    <RelativeLayout
        android:id="@+id/header_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/status_bar">
        <ImageView
            android:id="@+id/view_back"
            android:padding="5dp"
            android:layout_width="34sp"
            android:layout_height="34sp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/shopping_ic_store_v2_back_black"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/tv_product_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/shop_aggregate_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/store_undertake_search_icon_tab"
                android:padding="5dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="34sp"
                android:layout_height="34sp"
                android:src="@drawable/ec_store_search_icon_black"
                android:contentDescription="@string/commerce_search"/>
            <FrameLayout
                android:id="@+id/ec_store_fold_close_btn"
                android:visibility="gone"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="12dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/shopping_ic_store_sheet_close_black"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
    <com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout
        android:id="@+id/store_undertake_product_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header_area">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/multi_classification_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
                android:id="@+id/classification_filter_tab_container"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:bg_color="#ffffffff"
                app:bg_cornerRadius_TL="16dp"
                app:bg_cornerRadius_TR="16dp">
                <View
                    android:layout_gravity="bottom"
                    android:background="#14161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <com.bytedance.android.ui.base.widget.tablayout.ECTabLayout
                    android:id="@+id/classification_filter_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:tabGravity="center"
                    app:tabIndicator="@drawable/ec_shop_classification_tab_indicator"
                    app:tabIndicatorColor="@color/transparent"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorHeight="2dp"
                    app:tabMinWidth="0dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="12dp"
                    app:tabPaddingStart="12dp"/>
            </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
            <com.bytedance.android.shopping.store.tabkit.view.ScrollableViewPager
                android:id="@+id/classification_filter_view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </com.bytedance.android.shopping.store.arch.FoldAdaptedFrameLayout>
    <FrameLayout
        android:id="@+id/store_undertake_water_mark_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
