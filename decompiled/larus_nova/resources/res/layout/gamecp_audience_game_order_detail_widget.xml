<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_game_header_full_bg"
        android:background="@drawable/gamecp_game_detail_header_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="92dp"/>
    <View
        android:id="@+id/v_game_header_top_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_game_header_top_alpha"
        app:leftTopRound="12dp"
        app:rightTopRound="12dp">
        <RelativeLayout
            android:id="@+id/cl_game_header_info_container"
            android:background="@drawable/gamecp_order_game_detail_header_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
                android:id="@+id/icon_container"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/v_game_header_top_alpha">
                <com.bytedance.android.gamecp.common.ui.HSImageView
                    android:id="@+id/game_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:roundedCornerRadius="8dp"/>
            </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:layout_below="@+id/v_game_header_top_alpha"
                android:layout_toStartOf="@+id/game_rating_container"
                android:layout_toEndOf="@+id/icon_container">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/name_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="52dp">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:id="@+id/game_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/game_security"
                        android:layout_width="37dp"
                        android:layout_height="16dp"
                        android:src="@drawable/gamecp_ic_game_promote_sacurity_type_three"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/game_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.bytedance.android.gamecp.common.ui.FlowLayout
                    android:orientation="horizontal"
                    android:id="@+id/tags_container"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/name_container"
                    android:layout_alignStart="@+id/head_game_developer"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80161823"
                    android:ellipsize="end"
                    android:id="@+id/tv_game_header_short_additional_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="7dp"
                    android:maxLines="1"
                    android:layout_below="@+id/tags_container"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
</androidx.constraintlayout.widget.ConstraintLayout>
