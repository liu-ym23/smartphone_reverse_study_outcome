<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v4_sku_image_layout_tab_ab_676274788"
    android:layout_width="match_parent"
    android:layout_height="20dp">
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/sku_stub"
        android:background="@drawable/commerce_bg_indicator_container_v4"
        android:paddingLeft="12dp"
        android:paddingTop="2.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="2.5dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sku_title"
        android:background="@drawable/commerce_bg_indicator_container_v4"
        android:paddingLeft="12dp"
        android:paddingTop="2.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/sku_index"
        app:layout_constraintStart_toEndOf="@+id/sku_stub"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/sku_index"
        android:background="@drawable/commerce_bg_indicator_container_v4"
        android:paddingLeft="12dp"
        android:paddingTop="2.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="2.5dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
