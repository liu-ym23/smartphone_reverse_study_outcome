<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.effect.base.AdjustPercentBar
        android:id="@+id/small_item_beauty_seek_bar"
        android:background="#0000"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="159dp"
        android:maxHeight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ttlive_effect_bar_padding="24dp"
        app:ttlive_effect_textColor="#ffffff"
        app:ttlive_effect_textSize="14dp"/>
    <com.bytedance.android.live.effect.base.BeautifyAdjustPercentBar
        android:id="@+id/small_item_beauty_seek_bar_new"
        android:background="#0000"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="228dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/reset_view"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/beauty_list_content"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/icon"
            android:background="@drawable/ttlive_effect_ic_beauty_item_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_effect_broadcast_beauty_item_reset_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_effect_live_beauty_small_reset"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/beauty_list_content"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/toast_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
