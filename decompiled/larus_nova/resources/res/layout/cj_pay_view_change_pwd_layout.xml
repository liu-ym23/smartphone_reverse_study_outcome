<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/change_pwd_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_change_pwd_first_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:id="@+id/cj_pay_change_pwd_first_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_red_fe3824"
            android:id="@+id/cj_pay_change_pwd_first_error_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_change_pwd_error_tips_simple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
            android:id="@+id/cj_pay_change_pwd_first_input"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:layout_centerHorizontal="true"
            app:CJPayDotRadius="6dp"
            app:CJPayIsCursorBlinkInterval="500"
            app:CJPayIsCursorColor="@color/cj_pay_color_red_11"
            app:CJPayIsCursorHeight="20dp"
            app:CJPayIsCursorWidth="2dp"
            app:CJPayIsShowCursor="true"
            app:CJPayPwdCount="6"
            app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
            app:CJPayStrokeColor="@color/cj_pay_color_gray_161823_opacity_32"
            app:CJPayStrokeRadius="4dp"
            app:CJPayStrokeStyle="CJPayStrokeStyleStroke"
            app:CJPayStrokeWidth="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_change_pwd_second_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/cj_pay_change_pwd_second_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_red_fe3824"
            android:id="@+id/cj_pay_change_pwd_second_error_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_change_pwd_error_tips_simple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
            android:id="@+id/cj_pay_change_pwd_second_input"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:layout_centerHorizontal="true"
            app:CJPayDotRadius="6dp"
            app:CJPayIsCursorBlinkInterval="500"
            app:CJPayIsCursorColor="@color/cj_pay_color_red_11"
            app:CJPayIsCursorHeight="20dp"
            app:CJPayIsCursorWidth="2dp"
            app:CJPayIsShowCursor="true"
            app:CJPayPwdCount="6"
            app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
            app:CJPayStrokeColor="@color/cj_pay_color_gray_161823_opacity_32"
            app:CJPayStrokeRadius="4dp"
            app:CJPayStrokeStyle="CJPayStrokeStyleStroke"
            app:CJPayStrokeWidth="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
