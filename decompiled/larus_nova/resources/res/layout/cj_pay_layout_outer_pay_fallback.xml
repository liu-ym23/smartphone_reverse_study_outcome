<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_rooter_fallback"
    android:background="@color/cj_pay_color_gray_245"
    android:paddingTop="44dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/cj_pay_left_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/cj_pay_sign_and_pay_left_leave"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_fallback_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/cj_pay_fallback_info_title_zone"
            android:background="@drawable/cj_pay_outer_pay_login_pay_info_top"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/navigation_bar_icon"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:src="@drawable/cj_pay_dy_pay_icon"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_fallback_info_card_zone"
            android:background="@drawable/cj_pay_bg_r8_bottom_solid_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp">
            <ImageView
                android:id="@+id/cj_pay_fallback_status_image"
                android:visibility="visible"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/cj_pay_icon_weak_net"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:ellipsize="end"
                android:id="@+id/cj_pay_fallback_status_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cj_pay_net_weak"
                android:maxLines="2"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center"
                android:id="@+id/cj_pay_fallback_status_retry"
                android:background="@drawable/cj_pay_bg_r6_gray_0d161823"
                android:layout_width="80dp"
                android:layout_height="28dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/cj_pay_refresh"/>
        </LinearLayout>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
        android:gravity="center"
        android:id="@+id/cj_pay_btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_custom_button_height_44"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="11dp"
        app:btnTextColor="@color/cj_pay_color_white"
        app:btnTextSize="15sp"
        app:loadingHeight="20dp"
        app:loadingWidth="20dp"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/cj_pay_insurance_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        app:theme_type="0"/>
</LinearLayout>
