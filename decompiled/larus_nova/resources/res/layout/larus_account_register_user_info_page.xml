<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/register_page_main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/register_page_title_bar">
        <com.larus.bmhome.view.RoundAvatarImageView
            android:id="@+id/register_page_avatar"
            android:layout_width="?attr/larus_dp_110"
            android:layout_height="?attr/larus_dp_110"
            android:layout_marginTop="?attr/larus_dp_24"
            app:avatar_placeholder="@drawable/larus_avatar_profile_default_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_avatar_icon"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_avatar"
            app:layout_constraintEnd_toEndOf="@+id/register_page_avatar"
            app:srcCompat="@drawable/larus_ic_add_header"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/register_page_nickname_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:text="@string/larus_setting_profile_nickname_title"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="@+id/register_page_nickname_editor"
            app:layout_constraintTop_toBottomOf="@+id/register_page_avatar"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_sp_17"
            android:gravity="start|center_vertical"
            android:id="@+id/register_page_nickname_editor"
            android:background="@drawable/larus_bg_register_edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_8"
            android:hint="@string/larus_registration_set_nickname_input_placeholder"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="40"
            android:paddingStart="?attr/larus_dp_18"
            android:paddingEnd="?attr/larus_dp_56"
            android:layout_marginStart="?attr/larus_dp_32"
            android:layout_marginEnd="?attr/larus_dp_32"
            app:layout_constraintTop_toBottomOf="@+id/register_page_nickname_title"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_clear_nickname"
            android:paddingTop="?attr/larus_dp_18"
            android:paddingBottom="?attr/larus_dp_18"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_52"
            android:layout_height="?attr/larus_dp_56"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_nickname_editor"
            app:layout_constraintEnd_toEndOf="@+id/register_page_nickname_editor"
            app:layout_constraintTop_toTopOf="@+id/register_page_nickname_editor"
            app:srcCompat="@drawable/larus_ic_name_edit_clear"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_nickname_error_hint_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_6"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="@+id/register_page_nickname_editor"
            app:layout_constraintTop_toBottomOf="@+id/register_page_nickname_editor"
            app:srcCompat="@drawable/larus_ic_name_err_tip"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_danger_50"
            android:id="@+id/register_page_nickname_error_hint"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_setting_profile_nickname_error"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_nickname_error_hint_icon"
            app:layout_constraintEnd_toEndOf="@+id/register_page_nickname_editor"
            app:layout_constraintStart_toEndOf="@+id/register_page_nickname_error_hint_icon"
            app:layout_constraintTop_toTopOf="@+id/register_page_nickname_error_hint_icon"
            app:layout_goneMarginStart="?attr/larus_dp_4"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/register_page_nickname_error_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="register_page_nickname_error_hint_icon, register_page_nickname_error_hint"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/register_page_username_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_30"
            android:text="@string/larus_setting_profile_username_title"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toBottomOf="@+id/register_page_nickname_editor"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_sp_17"
            android:gravity="center_vertical"
            android:id="@+id/register_page_username_editor"
            android:background="@drawable/larus_bg_register_edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_8"
            android:hint="@string/larus_setting_profile_username_placeholder"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="16"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_56"
            android:layout_marginStart="?attr/larus_dp_32"
            android:layout_marginEnd="?attr/larus_dp_32"
            app:layout_constraintTop_toBottomOf="@+id/register_page_username_title"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_clear_username"
            android:paddingTop="?attr/larus_dp_18"
            android:paddingBottom="?attr/larus_dp_18"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_56"
            android:layout_height="?attr/larus_dp_56"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_username_editor"
            app:layout_constraintEnd_toEndOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toTopOf="@+id/register_page_username_editor"
            app:srcCompat="@drawable/larus_ic_name_edit_clear"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_username_available_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_username_editor"
            app:layout_constraintEnd_toEndOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toTopOf="@+id/register_page_username_editor"
            app:srcCompat="@drawable/larus_ic_username_available"/>
        <ProgressBar
            android:id="@+id/register_page_username_loading_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:indeterminateTint="@color/larus_neutral_50"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_username_editor"
            app:layout_constraintEnd_toEndOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toTopOf="@+id/register_page_username_editor"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/register_page_username_hint"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:text="@string/larus_setting_profile_username_tips"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="@+id/register_page_username_editor"
            app:layout_constraintStart_toStartOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toBottomOf="@+id/register_page_username_editor"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/register_page_username_error_hint_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_6"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="@+id/register_page_username_editor"
            app:layout_constraintTop_toBottomOf="@+id/register_page_username_editor"
            app:srcCompat="@drawable/larus_ic_name_err_tip"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_danger_50"
            android:id="@+id/register_page_username_error_hint"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/register_page_username_error_hint_icon"
            app:layout_constraintEnd_toEndOf="@+id/register_page_username_editor"
            app:layout_constraintStart_toEndOf="@+id/register_page_username_error_hint_icon"
            app:layout_constraintTop_toTopOf="@+id/register_page_username_error_hint_icon"
            app:layout_goneMarginStart="?attr/larus_dp_4"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/register_page_username_error_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="register_page_username_error_hint_icon, register_page_username_error_hint"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/register_page_enter_button"
        android:background="@drawable/larus_bg_button_register_flow"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_58"
        android:text="@string/larus_registration_set_nickname_get_started"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/register_page_title_bar"
        android:background="@color/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/register_page_skip"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/register_page_skip"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_setting_userprofile_skip"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/register_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_registration_set_nickname_title"
        app:layout_constraintBottom_toBottomOf="@+id/register_page_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/register_page_skip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
