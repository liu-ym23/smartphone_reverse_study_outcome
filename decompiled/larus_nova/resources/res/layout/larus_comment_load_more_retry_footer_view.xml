<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_48">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/retryButton"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:src="@drawable/larus_comment_bot_arrow_clockwise"/>
    <TextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/retryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_inapp_search_no_internet"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/retryButton"/>
</LinearLayout>
