<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:layout_constraintBottom_toTopOf="@+id/group_bottom_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/activity_price_desc_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="11dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                android:id="@+id/activity_price_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7dp"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                android:id="@+id/activity_sales"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.bytedance.android.shopping.anchorv4.voavhs.baseinfo.AnchorV4PriceViewContainer
            android:orientation="horizontal"
            android:id="@+id/activity_price_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/activity_sec_kill_time"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
                android:id="@+id/activity_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:pv_autoResize="true"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
                android:id="@+id/activity_discount_price"
                android:paddingLeft="7dp"
                android:paddingTop="0.5dp"
                android:paddingRight="7dp"
                android:paddingBottom="0.5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                app:pv_autoResize="true"
                app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
                android:id="@+id/activity_market_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="7dp"
                app:pv_autoResize="true"/>
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.PriceElementView
                android:id="@+id/activity_deposit_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="7dp"/>
        </com.bytedance.android.shopping.anchorv4.voavhs.baseinfo.AnchorV4PriceViewContainer>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/activity_icon_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/activity_sec_kill_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/activity_sec_kill_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="9dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/activity_price_container">
            <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
                android:id="@+id/activity_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.shopping.anchorv4.widgets.CountDownLayout
                android:id="@+id/activity_sec_kill_time_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/group_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ViewStub
        android:id="@+id/activity_subsidized_viewstub"
        android:layout="@layout/ec_commerce_layout_subsidized_activity_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
