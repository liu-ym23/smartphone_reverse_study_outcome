<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_anchor_v3_preview_panel_layout_824506757"
    android:background="@drawable/commerce_order_show_off_panel_bg"
    android:layout_width="match_parent"
    android:layout_height="537dp">
    <FrameLayout
        android:id="@+id/ec_commerce_anchor_v3_preview_panel_layout_22013601"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="16dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/TextReverse"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/law_hint_title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/shopping_order_show_off_preview_panel_title"
            style="@style/font_size_34"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/close_panel_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shopping_ic_close_panel"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <com.bytedance.android.shopping.order.VideoHolderFrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/preview_video_holder"
        android:background="@color/ec_color_white"
        android:layout_width="295dp"
        android:layout_height="393dp"
        android:layout_marginTop="20dp"
        app:rounded_radius="6dp">
        <View
            android:id="@+id/default_bg"
            android:background="@drawable/shopping_default_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shopping_default_panel_bg_icon"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/commerce_video_title_bg"
            android:layout_width="match_parent"
            android:layout_height="154dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comment_content_first_line"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/shopping_icon_order_showoff_default"/>
                <TextView
                    android:textColor="@color/ec_color_white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:layout_width="35dp"
                    android:layout_height="21dp"
                    android:text="@string/shopping_order_show_off_title_default"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"
                    style="@style/font_size_30"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/commerce_video_preview_divider"
                    android:layout_width="1dp"
                    android:layout_height="10dp"/>
                <TextView
                    android:textColor="@color/ec_color_white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/video_title"
                    android:layout_width="131dp"
                    android:layout_height="21dp"
                    android:maxLines="1"
                    android:layout_marginStart="5dp"
                    style="@style/font_size_30"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/ec_color_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/video_content"
                android:layout_width="238dp"
                android:layout_height="21dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                style="@style/font_size_30"/>
        </LinearLayout>
        <com.bytedance.android.ec.core.widget.ECStatusView
            android:layout_gravity="center"
            android:id="@+id/load_status_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </com.bytedance.android.shopping.order.VideoHolderFrameLayout>
    <Button
        android:textSize="15dp"
        android:textColor="@color/ConstTextInverse"
        android:id="@+id/law_hint_agree_but"
        android:background="@drawable/commerce_law_hint_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/shopping_order_show_off_confirm"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="?android:attr/borderlessButtonStyle"/>
    <Space
        android:layout_width="1px"
        android:layout_height="24dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:id="@+id/test_post_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布评价"/>
        <Button
            android:id="@+id/test_post_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布视频"/>
    </LinearLayout>
</LinearLayout>
