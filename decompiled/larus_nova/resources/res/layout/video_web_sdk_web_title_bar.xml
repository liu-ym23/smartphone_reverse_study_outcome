<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/video_web_sdk_web_title_bar_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/video_title_height">
    <ImageView
        android:id="@+id/video_web_sdk_title_bar_close"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-12dp"
        android:src="@drawable/video_web_sdk_title_bar_close_selector"
        android:layout_toRightOf="@+id/video_web_sdk_title_bar_back"
        android:layout_centerVertical="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/video_web_sdk_title_bar_back"
        android:paddingLeft="6dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="50dp"
        android:minHeight="30dp"
        android:drawableLeft="@drawable/video_web_sdk_title_bar_back_selector"
        android:layout_centerVertical="true"/>
    <TextView
        android:id="@+id/video_web_sdk_title_bar_more"
        android:paddingLeft="8dp"
        android:paddingRight="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="0dp"
        android:minHeight="@dimen/video_title_height"
        android:drawableRight="@drawable/video_web_sdk_title_bar_more_selector"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#464646"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/video_web_sdk_title_bar_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_title_height"
        android:layout_marginLeft="85dp"
        android:layout_marginRight="85dp"
        android:maxLines="1"
        android:layout_centerVertical="true"/>
</merge>
