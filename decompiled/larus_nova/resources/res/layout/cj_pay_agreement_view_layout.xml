<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
        android:id="@+id/cj_pay_agreement_checkbox"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="6dp"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_13"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:id="@+id/cj_pay_agreement_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2.5dp"/>
</LinearLayout>
