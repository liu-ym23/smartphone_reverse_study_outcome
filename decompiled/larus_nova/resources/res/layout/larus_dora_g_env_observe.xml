<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_4">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_g_env_observe_toggle"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_lab_environmental_observation_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_g_env_observe_pause_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_environmental_observation_time_range_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_g_env_observe_pause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_g_env_observe_time_toggle"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_environmental_observation_time_range_switch_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_g_env_observe_time_start_toggle"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_environmental_observation_timed_pause_start_time_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_g_env_observe_time_end_toggle"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_environmental_observation_timed_pause_end_time_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_g_env_observe_wifi"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_g_env_observe_wifi_toggle"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:id="@+id/dora_g_env_observe_light_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_environmental_observation_inside_led_cn"/>
            <com.larus.bmhome.view.item.ItemTextToggle
                android:id="@+id/dora_g_env_observe_light_toggle"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_environmental_observation_white_light_inside_while_observing_cn"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
