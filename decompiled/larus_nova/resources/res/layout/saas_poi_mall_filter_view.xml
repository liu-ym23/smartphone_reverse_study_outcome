<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/poi_mall_filter_layout"
    android:background="@color/POIBgPrimary"
    android:paddingLeft="16dp"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/mall_filter_floor_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="13dp"
            android:textColor="@color/POITextPrimary"
            android:ellipsize="end"
            android:id="@+id/tv_poi_mall_filter_floor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_poi_mall_filter_floor"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:srcCompat="@drawable/ic_s_s_trianglesdown_filled"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/mall_filter_category_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="13dp"
            android:textColor="@color/POITextPrimary"
            android:ellipsize="end"
            android:id="@+id/tv_poi_mall_filter_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center_vertical"
            android:id="@+id/iv_poi_mall_filter_category"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:srcCompat="@drawable/ic_s_s_trianglesdown_filled"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/mall_filter_sort_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="13dp"
            android:textColor="@color/POITextPrimary"
            android:ellipsize="end"
            android:id="@+id/tv_poi_mall_filter_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_poi_mall_filter_sort"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:srcCompat="@drawable/ic_s_s_trianglesdown_filled"/>
    </LinearLayout>
</LinearLayout>
