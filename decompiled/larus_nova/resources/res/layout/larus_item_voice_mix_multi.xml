<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/speaker_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_speaker"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/voice_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_name"/>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/play_lottie"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/speaker_icon"
        app:layout_constraintEnd_toEndOf="@+id/speaker_icon"
        app:layout_constraintStart_toStartOf="@+id/speaker_icon"
        app:layout_constraintTop_toTopOf="@+id/speaker_icon"
        app:lottie_fileName="lottie/text_msg_voice_playing.json"
        app:lottie_loop="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/voice_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/voice_remove"
        app:layout_constraintStart_toEndOf="@+id/speaker_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:layout_gravity="center"
        android:id="@+id/voice_progress_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/speaker_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/speaker_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voice_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/voice_progress_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_progress_text"
        app:srcCompat="@drawable/larus_ic_voice_remove"/>
    <SeekBar
        android:id="@+id/voice_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:max="99"
        android:progress="99"
        android:progressDrawable="?attr/larus_voice_mix_progress"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/speaker_icon"
        style="@style/larus_mix_seekbar_style"/>
</merge>
