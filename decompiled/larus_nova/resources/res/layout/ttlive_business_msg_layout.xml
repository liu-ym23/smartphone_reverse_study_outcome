<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/business_msg_root"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/business_msg_container"
        android:background="@drawable/ttlive_bg_business_msg"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="27dp">
        <ImageView
            android:id="@+id/business_logo"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_marginRight="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/business_text"/>
        <com.bytedance.android.livesdk.common.MarqueeTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:id="@+id/business_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/business_logo"
            app:layout_constraintRight_toLeftOf="@+id/business_tail_image"/>
        <ImageView
            android:id="@+id/business_jump_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/business_text"
            app:layout_constraintRight_toLeftOf="@+id/business_tail_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/business_tail_image"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/business_jump_icon"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
