<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/profile_info_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/profile_info_page_back_btn"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/profile_info_title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_info_title_bar"
        app:srcCompat="@drawable/larus_ic_left_back"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/profile_info_page_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_60"
        app:layout_constraintBottom_toBottomOf="@+id/profile_info_title_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profile_info_page_back_btn"
        app:layout_constraintTop_toTopOf="@+id/profile_info_title_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/profile_setting"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_bot_setting"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/profile_info_title_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_info_title_bar"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_title_bar">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/appBarLayout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.larus.profile.impl.view.ProfileHeaderUserInfoView
                android:id="@+id/header_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tablayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_12"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/larus_tab_bottom"
                app:tabIndicatorColor="@color/larus_neutral_100"
                app:tabIndicatorFullWidth="true"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/larus_neutral_100"
                app:tabTextAppearance="@style/larus_mine_tab_layout"
                app:tabTextColor="@color/larus_neutral_50"/>
            <View
                android:id="@+id/tab_divider"
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0_5"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include
        android:id="@+id/profile_user_info_loading"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_247"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_title_bar"
        layout="@layout/larus_page_profile_user_info_skeleton"/>
    <include
        android:id="@+id/profile_tab_info_loading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user_info_loading"
        app:layout_goneMarginTop="?attr/larus_dp_247"
        layout="@layout/larus_page_profile_tab_info_loading"/>
    <include
        android:id="@+id/block_user"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user_info_loading"
        app:layout_goneMarginTop="?attr/larus_dp_158"
        layout="@layout/larus_profile_block_cover"/>
    <include
        android:id="@+id/profile_info_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_title_bar"
        layout="@layout/larus_page_profile_info_error"/>
</androidx.constraintlayout.widget.ConstraintLayout>
