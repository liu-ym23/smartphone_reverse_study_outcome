<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="?attr/larus_base_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:placeholderImage="?attr/larus_base_2"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/icon_template"
        android:background="@drawable/larus_bg_same_template_button"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:paddingStart="?attr/larus_dp_14"
        android:paddingEnd="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/item_image"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/discovery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_make_the_template_style"/>
    </FrameLayout>
    <com.larus.common_ui.widget.CommonAuthorInfoLayout
        android:id="@+id/layout_author_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
