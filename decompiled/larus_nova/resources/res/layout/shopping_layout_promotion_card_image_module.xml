<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ec.core.widget.ECPromotionImageView
        android:id="@+id/piv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.livecommerce.view.roundcorner.ECPromotionTopTagLinearlayout
        android:orientation="horizontal"
        android:id="@+id/top_left_tag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/shopping_std_text_white_1"
            android:gravity="center"
            android:id="@+id/tv_promotion_index"
            android:background="@color/shopping_color_73161823"
            android:layout_width="26dp"
            android:layout_height="19dp"
            android:includeFontPadding="false"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/iv_status_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            app:layoutMode="width_self_adjust"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/sdv_flash_tag"
            android:layout_width="41dp"
            android:layout_height="19dp"/>
    </com.bytedance.android.livesdk.livecommerce.view.roundcorner.ECPromotionTopTagLinearlayout>
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:id="@+id/iv_flicker_icon"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="19dp"
        android:importantForAccessibility="noHideDescendants"/>
    <com.bytedance.android.ec.core.widget.ECHotAtmosphereView
        android:id="@+id/layout_hot_atmosphere"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="-8dp"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_explain_end"
        android:background="@drawable/ec_bg_audience_live_promotion_explain_end"
        android:paddingLeft="8dp"
        android:paddingRight="9.5dp"
        android:paddingBottom="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:minWidth="60dp"
        android:text="@string/ec_promotion_list_tip_look_explain"
        android:includeFontPadding="false"
        android:drawableLeft="@drawable/ec_ic_audience_live_promotion_explain_end"
        android:drawablePadding="0.5dp"
        android:drawableStart="@drawable/ec_ic_audience_live_promotion_explain_end"/>
</merge>
