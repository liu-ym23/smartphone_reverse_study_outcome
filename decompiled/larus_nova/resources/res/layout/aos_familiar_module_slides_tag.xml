<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:minWidth="20dp">
    <View
        android:background="@drawable/aos_familiar_slides_tag_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/tag_main_layout"
        app:layout_constraintStart_toStartOf="@+id/tag_main_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tag_main_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="2dp"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/slides_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/aos_familiar_slides_photo_feed_ic"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/aos_const_text_inverse"
            android:id="@+id/slides_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aos_familiar_slides_photo_tag"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            app:fontType="bold"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/aos_const_text_inverse"
            android:id="@+id/slides_tag_index"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:fontType="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
