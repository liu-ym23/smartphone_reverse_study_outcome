<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/phone_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10"
        android:src="@drawable/larus_ic_back_left"
        android:layout_marginStart="?attr/larus_dp_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_40"
        android:maxWidth="?attr/larus_dp_326"
        android:text="@string/larus_ageGate_enter_title_age_global"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_back_button"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:maxWidth="?attr/larus_dp_326"
        android:text="@string/larus_dola_ageGate_enter_desc_verify_global"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <EditText
        android:textSize="?attr/larus_dp_17"
        android:gravity="start|center_vertical"
        android:id="@+id/age_input"
        android:background="@drawable/larus_bg_age_input_button"
        android:padding="?attr/larus_dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:hint="@string/larus_ageGate_enter_placeholder_age_global"
        android:digits="0123456789"
        android:inputType="number"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"
        style="@style/larus_EditTextStyle"/>
    <com.larus.common_ui.widget.RectangleButton
        android:id="@+id/next_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
