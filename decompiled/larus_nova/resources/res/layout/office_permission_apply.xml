<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/permission_root_layout"
    android:background="@color/bg_body"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/permission_title_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/office_apply_container"
                android:paddingLeft="19dp"
                android:paddingRight="19dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.28">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/office_permission_icon"
                    android:layout_width="40dp"
                    android:layout_height="41dp"
                    android:layout_marginBottom="26dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/office_permission_lock"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:gravity="center"
                    android:id="@+id/office_permission_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:gravity="start"
                    android:id="@+id/office_permission_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:lineSpacingExtra="2dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/permission_type_choose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Doc_Facade_ApplyFor"/>
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_fill_default"
                        android:id="@+id/permission_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:drawableEnd="@drawable/office_permission_arrow_down"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/edit_optional_container"
                    android:background="@drawable/office_permission_input_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:minHeight="48dp">
                    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                        android:textSize="16sp"
                        android:textColorHint="#a8a8a8"
                        android:id="@+id/edit_optional"
                        android:background="@null"
                        android:paddingLeft="16dp"
                        android:paddingTop="12dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="@string/Doc_Facade_AddRemarks"
                        android:cursorVisible="true"
                        app:ud_backgroundColor="@android:color/transparent"
                        app:ud_strokeWidth="0dp"
                        style="@style/UDEditText"/>
                </FrameLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/function_danger_500"
                    android:id="@+id/office_permission_input_error"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/send_request"
                    android:background="@drawable/office_permission_primary_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:gravity="center"
                    android:id="@+id/office_permission_help"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
