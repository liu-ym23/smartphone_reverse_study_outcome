<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/ttlive_bg_qa_title_prefix"
                android:layout_width="2dp"
                android:layout_height="10dp"/>
            <TextView
                android:textSize="11dp"
                android:ellipsize="end"
                android:id="@+id/tv_title_rendertext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="52dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
                android:id="@+id/iv_picture"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:ttlive_allRadius="4dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:id="@+id/tv_main_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="20dp"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#99161823"
                    android:ellipsize="end"
                    android:id="@+id/tv_sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="15dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/ttlive_pin_container_process_area"/>
    </LinearLayout>
</merge>
