<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/ud_icon_left_outlined"
            app:tint="@color/icon_n1"/>
        <com.larksuite.component.universe_design.tab.UDTabLayout
            android:gravity="bottom"
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:tabRippleColor="@null"
            app:ud_tab_bottomDividerEnabled="false"
            app:ud_tab_indicatorColor="@color/text_title"
            app:ud_tab_titleColor="@color/text_caption"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_pri_500"
            android:gravity="center"
            android:id="@+id/tv_no_fill"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/LarkCCM_SlidesMobile_Highlight_NoFill_Button"
            android:layout_centerVertical="true"
            android:layout_marginEnd="21dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/divider"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
