<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/goods_header_container"
        android:background="#08161823"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/goods_title_bar_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/poi_goods_detail_header_origin_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/status_bar">
            <com.bytedance.dux.text.DuxTextView
                android:textStyle="bold"
                android:textColor="@color/TextReverse"
                android:id="@+id/goods_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/font_size_34_sp"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/goods_detail_title_tab_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabIndicatorColor="#161823"
                app:tabIndicatorFullWidth="false"
                app:tabMinWidth="10dp"
                app:tabPaddingEnd="12dp"
                app:tabPaddingStart="12dp"
                app:tabRippleColor="@android:color/transparent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/trade_product_detail_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_s_s_arrowleft_outlined"
                app:tint="#161823"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/trade_product_search"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/search"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/trade_product_collect_container"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_s_s_magnifier_outlined"
                app:tint="#161823"/>
            <FrameLayout
                android:id="@+id/trade_product_collect_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="44dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/trade_product_share_container"
                app:layout_constraintTop_toTopOf="parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/trade_product_collect"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/poi_groupon_collect"
                    app:srcCompat="@drawable/poi_detail_collect_icon"
                    app:tint="#161823"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/trade_product_share_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/trade_product_share"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/share"
                    app:srcCompat="@drawable/ic_s_s_arrowupright_outlined_20"
                    app:tint="#161823"/>
            </FrameLayout>
            <include
                android:id="@+id/goods_detail_search_bar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/trade_product_collect_container"
                app:layout_constraintStart_toEndOf="@+id/trade_product_detail_back"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/saas_poi_trade_search_bar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/multi_sku_tab"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/goods_detail_full_title_tab_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/poi_goods_detail_header_full_tab_height"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:tabIndicatorColor="#161823"
            app:tabIndicatorFullWidth="true"
            app:tabMinWidth="10dp"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabRippleColor="@android:color/transparent"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/iconContainer"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/topXScreenSpaceStub"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"/>
        <FrameLayout
            android:id="@+id/share_in_screen_container"
            android:background="@drawable/bg_icon_in_x_screen"
            android:clipChildren="false"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/topXScreenSpaceStub"
            android:contentDescription="@string/share"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/trade_product_share_in_x_screen"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:srcCompat="@drawable/ic_s_s_arrowupright_outlined_20"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/collect_in_screen_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/topXScreenSpaceStub"
            android:layout_toStartOf="@+id/share_in_screen_container">
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_icon_in_x_screen"
                android:clipChildren="false"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/poi_groupon_collect">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/trade_product_collect_in_x_screen"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/poi_detail_collect_icon"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/search_x_screen_container"
            android:background="@drawable/bg_icon_in_x_screen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/topXScreenSpaceStub"
            android:contentDescription="@string/search"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/collect_in_screen_container">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/trade_product_search_in_x_screen"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_s_s_magnifier_outlined"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fold_x_screen_container"
            android:background="@drawable/bg_icon_in_x_screen"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/topXScreenSpaceStub"
            android:layout_marginStart="12dp"
            android:layout_alignParentStart="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/trade_product_fold_in_x_screen"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_s_s_arrowup_outlined"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/close_x_screen_container"
            android:background="@drawable/bg_icon_in_x_screen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/topXScreenSpaceStub"
            android:layout_marginStart="12dp"
            android:layout_alignParentStart="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/trade_product_close_in_x_screen"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_s_s_arrowleft_outlined"/>
        </FrameLayout>
        <View
            android:id="@+id/spaceStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/share_in_screen_container"/>
    </RelativeLayout>
</FrameLayout>
