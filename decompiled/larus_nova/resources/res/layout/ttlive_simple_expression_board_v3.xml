<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.uikit.viewpager.SSViewPager
        android:id="@+id/emoji_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0.5dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="bottom"
        android:id="@+id/emoji_section_list"
        android:background="@drawable/ttlive_emoji_button_background"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:overScrollMode="never"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/emoji_delete_send_container"
        android:background="@drawable/ttlive_bg_simple_emoji_panel_btn_container"
        android:layout_width="204dp"
        android:layout_height="97dp">
        <ImageView
            android:id="@+id/emoji_delete_btn"
            android:background="@drawable/ttlive_bg_simple_emoji_panel_delete_btn_toggle"
            android:layout_width="73dp"
            android:layout_height="32dp"
            android:layout_marginBottom="36dp"
            android:src="@drawable/ttlive_emoji_ic_new_delete"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@drawable/ttlive_color_simple_emoji_panel_send_btn_toggle"
            android:gravity="center"
            android:id="@+id/emoji_send_btn"
            android:background="@drawable/ttlive_bg_simple_emoji_panel_send_btn_toggle"
            android:layout_width="73dp"
            android:layout_height="32dp"
            android:layout_marginTop="36dp"
            android:text="@string/ttlive_emoji_new_send"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</merge>
