<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_item_gallery_video_player_block_compat_1915297013"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/shopping_color_80FFFFFF"
        android:id="@+id/tv_media_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="62dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:id="@+id/tv_media_progress"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_media_duration"
        app:layout_constraintRight_toLeftOf="@+id/tv_media_duration"
        app:layout_constraintTop_toTopOf="@+id/tv_media_duration"/>
    <SeekBar
        android:id="@+id/pb_media_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:progressDrawable="@drawable/commerce_anchor_v3_gallery_media_progress_bar"
        android:thumb="@drawable/commerce_anchor_v3_gallery_media_progress_thumb"
        android:paddingEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_media_progress"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_media_progress"
        app:layout_constraintTop_toTopOf="@+id/tv_media_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <ImageView
        android:id="@+id/iv_audio_status"
        android:paddingLeft="15dp"
        android:paddingTop="12dp"
        android:paddingRight="15dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginBottom="94dp"
        android:src="@drawable/commerce_anchor_v3_audio_status"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
