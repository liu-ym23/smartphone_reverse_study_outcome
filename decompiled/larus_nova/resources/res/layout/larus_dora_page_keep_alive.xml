<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lock_app_opt_container"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4">
                <com.larus.dora.impl.view.DoraItemTitleTextView
                    android:id="@+id/lock_app_opt_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_12"
                    android:text="@string/larus_dora_keep_alive_multi_task_locked_cn"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/lock_app_opt_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/larus_dp_16"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:layout_marginRight="?attr/larus_dp_16"
                    android:text="@string/larus_dora_keep_alive_multi_task_locked_tips_cn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lock_app_opt_title"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lock_app_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lock_app_opt_desc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_keep_alive_cdm_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.dora.impl.view.DoraItemTextToggleSubTitle
                    android:id="@+id/dora_keep_alive_cdm_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_keep_alive_ongoing_cdm_title_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_keep_alive_cdm_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_keep_alive_ongoing_cdm_hint_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_keep_alive_auto_start_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dora_keep_alive_auto_start_btn"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:paddingLeft="?attr/larus_dp_16"
                    android:paddingTop="?attr/larus_dp_12"
                    android:paddingRight="?attr/larus_dp_16"
                    android:paddingBottom="?attr/larus_dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_56">
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_17"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/dora_keep_alive_auto_start_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_keep_alive_auto_start_cn"
                        android:maxLines="2"
                        app:layout_constraintBottom_toTopOf="@+id/dora_keep_alive_auto_start_sub_title"
                        app:layout_constraintEnd_toStartOf="@+id/dora_keep_alive_auto_start_arrow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_13"
                        android:textColor="@color/larus_neutral_50"
                        android:ellipsize="end"
                        android:id="@+id/dora_keep_alive_auto_start_sub_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_2"
                        android:text="@string/larus_dora_keep_alive_auto_start_tips_cn"
                        android:maxLines="2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/dora_keep_alive_auto_start_arrow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/dora_keep_alive_auto_start_title"/>
                    <ImageView
                        android:id="@+id/dora_keep_alive_auto_start_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/larus_ic_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/dora_keep_alive_auto_start_hint_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/larus_neutral_70"
                        android:id="@+id/dora_keep_alive_auto_start_step_hint"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_dora_keep_alive_auto_start_step_hint_cn"/>
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/dora_keep_alive_auto_start_img_view"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_460"
                        android:layout_marginTop="?attr/larus_dp_20"
                        app:actualImageScaleType="fitCenter"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <Space
                        android:layout_width="?attr/larus_dp_1"
                        android:layout_height="?attr/larus_dp_16"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dora_keep_alive_auto_start_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_keep_alive_battery_optimization_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_keep_alive_battery_optimization"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_keep_alive_close_battery_optimization_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_keep_alive_battery_optimization_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_keep_alive_close_battery_optimization_tips_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_keep_alive_notification_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_keep_alive_notification_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_keep_alive_ongoing_notification_title_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_keep_alive_notification_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_keep_alive_ongoing_notification_hint_cn"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
