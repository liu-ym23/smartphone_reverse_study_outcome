<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ec_bg_size_info_container"
    android:padding="8dp"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite">
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_product_cover"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="5dp"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <ImageButton
            android:id="@+id/iv_arrow"
            android:background="@color/ec_color_transparent"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ec_ic_size_info_arrow"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content_list"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="yes"/>
</LinearLayout>
