<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/recent_forward_container"
    android:layout_width="60dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.larksuite.component.universe_design.image.UDAvatar
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            app:ud_avatar_size="large"
            style="@style/UDAvatar.Circle"/>
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:layout_gravity="top|right"
            android:id="@+id/user_check_box"
            android:background="@drawable/checkbox_circle_bg"
            android:padding="0dp"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            app:ud_checkbox_size="small"
            app:ud_checkbox_type="check_box"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/shield_chat_icon"
            android:background="@drawable/ic_shield_chat_recent_forward"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="5dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/user_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:maxLines="2"/>
</LinearLayout>
