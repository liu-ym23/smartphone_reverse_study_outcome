<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:paddingTop="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_8"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="@dimen/dp_80"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/applet_share_sheet_menu_bg"
        android:background="@drawable/bg_applet_share_sheet_item"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/applet_share_sheet_menu_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/applet_action_sheet_menu_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/applet_share_sheet_menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:maxLines="2"/>
</LinearLayout>
