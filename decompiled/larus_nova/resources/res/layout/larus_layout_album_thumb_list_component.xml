<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <androidx.constraintlayout.widget.Placeholder
        android:id="@+id/focus_container_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Placeholder
        android:id="@+id/album_thumb_list_placeholder"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginTop="@dimen/larus_camera_control_album_thumb_list_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/focus_container_placeholder"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_album_thumb_list"
        android:background="@color/larus_bg_album_thumb_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_125"
        android:paddingStart="?attr/larus_dp_8"
        android:paddingEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/album_thumb_list_placeholder">
        <ImageView
            android:id="@+id/iv_album_thumb_list_handler"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_5"
            android:layout_marginTop="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_album_thumb_list_handler"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.camera.impl.widget.SwipeVerticalView
            android:id="@+id/swipe_down_view_album_thumb_list_handler"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_album_thumb_list"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_72"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_album_thumb_list_handler"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
</androidx.constraintlayout.widget.ConstraintLayout>
