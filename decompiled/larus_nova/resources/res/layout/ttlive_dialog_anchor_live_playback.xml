<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_broadcast_more_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/live_replay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_live_replay_setting_title"
            android:layout_centerHorizontal="true"
            android:alpha="0.7"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/live_replay_setting_back"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ttlive_ic_interact_beauty_back"
            android:layout_centerVertical="true"
            android:alpha="0.8"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/live_replay_setting_top_divider"
        android:background="@color/ttlive_std_line_white_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_replay_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="14dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/record_replay_layout"
            android:background="@color/transparent"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="79dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_prelive_setting_dark_txt"
                android:gravity="start|center_vertical"
                android:id="@+id/record_replay_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ttlive_live_pre_setting_replay_enable"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="@+id/record_replay_tip_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_prelive_setting_dark_tips"
                android:id="@+id/record_replay_tip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ttlive_anchor_replay_and_highlight"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/record_replay_title_tv"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/record_replay_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/support_user_view_layout"
            android:background="@color/transparent"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="79dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_prelive_setting_dark_txt"
                android:gravity="start|center_vertical"
                android:id="@+id/support_user_view_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ttlive_anchor_support_user_view"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="@+id/support_user_view_tip_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_prelive_setting_dark_tips"
                android:ellipsize="marquee"
                android:id="@+id/support_user_view_tip_tv"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_anchor_support_user_view_tip"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:marqueeRepeatLimit="marquee_forever"
                android:importantForAccessibility="no"
                android:layout_marginEnd="43dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/support_user_view_title_tv"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/support_user_view_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/replay_publish_layout"
            android:background="@color/transparent"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_prelive_setting_dark_txt"
                android:gravity="start|center_vertical"
                android:id="@+id/anchor_publish_setting_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_anchor_publish_to_profile"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_prelive_setting_dark_tips"
                android:id="@+id/anchor_publish_setting_tips_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ttlive_anchor_publish_pre_setting_tips"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/anchor_publish_setting_title_tv"/>
            <View
                android:id="@+id/anchor_publish_setting_dot_view"
                android:background="@drawable/ttlive_ic_setting_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                app:layout_constraintBottom_toTopOf="@+id/anchor_publish_setting_title_tv"
                app:layout_constraintStart_toEndOf="@+id/anchor_publish_setting_title_tv"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/anchor_publish_setting_switch"
                android:layout_width="43dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/real_time_play_back"
            android:background="@color/transparent"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_prelive_setting_dark_txt"
                android:gravity="start|center_vertical"
                android:id="@+id/real_time_play_back_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_live_real_time_playback"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <ImageView
                android:id="@+id/real_time_switch_helper"
                android:padding="5dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_icon_help"
                app:layout_constraintBottom_toBottomOf="@+id/real_time_play_back_title"
                app:layout_constraintStart_toEndOf="@+id/real_time_play_back_title"
                app:layout_constraintTop_toTopOf="@+id/real_time_play_back_title"/>
            <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                android:id="@+id/real_time_play_back_switch_button"
                android:layout_width="43dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                app:lsb_button_color="#ffffff"
                app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                app:lsb_effect_duration="50"
                app:lsb_shadow_radius="0dp"
                app:lsb_show_indicator="false"
                app:lsb_uncheck_color="@color/transparent"
                app:lsb_uncheckbutton_color="#d9ffffff"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/live_replay_recycler"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
