<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="65dp"
    android:layout_height="74dp">
    <View
        android:id="@+id/line"
        android:background="@drawable/ttlive_effect_bg_line"
        android:layout_width="0.5dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5.5dp"
        android:layout_marginEnd="5.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/switch_button"
        android:layout_width="28dp"
        android:layout_height="17dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/line"
        app:layout_constraintEnd_toStartOf="@+id/line"
        app:layout_constraintTop_toTopOf="@+id/line"
        app:lsb_background="@color/transparent"
        app:lsb_checked="true"
        app:lsb_checked_color="#57ffffff"
        app:lsb_checkedbutton_color="#fff"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#fff"/>
    <View
        android:id="@+id/switch_button_background"
        android:background="@drawable/ttlive_effect_switch_background"
        android:layout_width="30dp"
        android:layout_height="19dp"
        app:layout_constraintBottom_toBottomOf="@+id/switch_button"
        app:layout_constraintEnd_toEndOf="@+id/switch_button"
        app:layout_constraintStart_toStartOf="@+id/switch_button"
        app:layout_constraintTop_toTopOf="@+id/switch_button"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/switch_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:text="@string/ttlive_effect_switch_button_open"
        android:lines="1"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/switch_button"
        app:layout_constraintStart_toStartOf="@+id/switch_button"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
