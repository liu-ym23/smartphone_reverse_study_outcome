<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.visibilityproxy.RelativeLayoutVisibilityProxy xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/entrance_layout"
        android:background="@drawable/ttlive_below_drawer_entrance_bg"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_centerVertical="true"
        app:ttlive_leftBottomRadius="11dp"
        app:ttlive_leftTopRadius="11dp">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/entrance_anim"
                android:visibility="visible"
                android:layout_width="28dp"
                android:layout_height="22dp"
                app:actualImageScaleType="fitCenter"/>
            <com.bytedance.android.live.uikit.textview.AlwaysMarqueeTextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_s5"
                android:id="@+id/entrance_text"
                android:focusable="true"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="4"/>
            <ImageView
                android:id="@+id/entrance_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_more_video_arrow"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <FrameLayout
        android:id="@+id/avatar_area"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_centerVertical="true">
        <com.bytedance.android.live.core.view.LiveCircleView
            android:id="@+id/iv_circle"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.lighten.loader.SmartCircleImageView
            android:layout_gravity="center"
            android:id="@+id/iv_avatar"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
    </FrameLayout>
</com.bytedance.android.livesdk.visibilityproxy.RelativeLayoutVisibilityProxy>
