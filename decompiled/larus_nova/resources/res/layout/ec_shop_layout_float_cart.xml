<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="64sp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/float_cart_slide_wrapper"
        android:background="@drawable/ec_shop_cart_slide_wrapper_bg"
        android:paddingLeft="7dp"
        android:paddingRight="40sp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40sp"
        android:layout_marginTop="12sp"
        android:layout_marginRight="12sp"
        android:minWidth="20sp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/float_cart_product"
            android:layout_width="26sp"
            android:layout_height="26sp"
            android:layout_marginRight="4dp"
            app:roundedCornerRadius="8dp"/>
        <com.bytedance.android.ec.store.view.ECShopLabelTextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/float_cart_slide_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:clipChildren="false"
        android:layout_width="64sp"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shop_float_cart_icon"
            android:visibility="gone"
            android:layout_width="64sp"
            android:layout_height="64sp"/>
        <com.bytedance.android.shopping.store.home.view.LottieAnimationViewWithPlayCount
            android:id="@+id/lottie_animation_view"
            android:layout_width="64sp"
            android:layout_height="64sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_fileName="shop_cart_animation_black_red.json"
            app:lottie_loop="false"/>
        <com.bytedance.android.ec.store.view.ECShopLabelTextView
            android:gravity="center_vertical"
            android:id="@+id/shop_float_cart_bottom_desc"
            android:background="@drawable/float_cart_bottom_desc_bg"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18sp"
            android:layout_marginBottom="1sp"
            android:maxWidth="62dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
