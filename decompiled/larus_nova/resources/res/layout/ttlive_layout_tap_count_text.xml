<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_digg_count_prefix"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x"
        android:includeFontPadding="false"
        android:paddingEnd="2dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:id="@+id/tv_digg_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_double_digg_suffix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="10dp"
            android:textColor="#face15"
            android:id="@+id/tv_double_digg_suffix_x"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_digg_double_tap_suffix_x"
            android:includeFontPadding="false"
            android:paddingEnd="2dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#face15"
            android:id="@+id/tv_double_digg_suffix_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_digg_double_tap_suffix_2"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
