<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_item_normal_pay_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="83dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"/>
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon_unable_mask"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="-20dp"
                android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:id="@+id/cj_pay_payment_method_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                app:layout_goneMarginLeft="44dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red"
                android:id="@+id/cj_pay_payment_method_sub_label_first"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:id="@+id/cj_pay_payment_method_sub_label_second"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/cj_pay_payment_method_label"
                android:paddingLeft="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginRight="2dp"
                android:includeFontPadding="false"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
                android:id="@+id/cj_pay_payment_method_checkbox"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="16dp"
                android:scaleType="centerCrop"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:id="@+id/cj_pay_payment_method_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
