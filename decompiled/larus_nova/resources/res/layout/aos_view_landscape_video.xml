<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.player.FullVideoView
        android:id="@+id/item_feeditem_videoview"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:id="@+id/item_gesture_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/landscape_status_bar"
        android:visibility="gone"
        layout="@layout/aos_view_landscape_status_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_interactions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/top_gradient"
            android:background="@drawable/aos_feed_top_linear_gradient"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/bottom_gradient"
            android:background="@drawable/aos_feed_bottom_linear_gradient"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.bytedance.awemeopen.apps.framework.base.view.AutoRTLImageView
            android:id="@+id/back_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="22dp"
            android:scaleType="centerInside"
            android:layout_marginStart="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/aos_icon_back_white"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/aos_uikit_t_inverse_light"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toBottomOf="@+id/back_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/back_btn"
            app:layout_constraintTop_toTopOf="@+id/back_btn"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_profile_widget"
            android:background="@drawable/aos_common_bg_a20_r12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintWidth_max="164dp">
            <com.bytedance.awemeopen.infra.base.image.AoImageView
                android:id="@+id/iv_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerCrop"
                app:radius="12dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/aos_uikit_t_inverse_light"
                android:ellipsize="end"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="104dp"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/lottie_follow"
                android:layout_toEndOf="@+id/iv_avatar"/>
            <com.bytedance.awemeopen.infra.base.anim.lottie.AoAnimationLottieView
                android:id="@+id/lottie_follow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/interaction_icon_bar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="27dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_icon_like"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/aos_ic_heart_filled"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/aos_uikit_t_inverse_light"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_count_likes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#66000000"
                    android:shadowRadius="1"
                    android:layout_marginStart="17.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="19dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/aos_ic_msg_filled"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/aos_uikit_t_inverse_light"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_count_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#66000000"
                    android:shadowRadius="1"
                    android:layout_marginStart="17.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="27dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_icon_favorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/aos_ic_star_filled"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/aos_uikit_t_inverse_light"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_count_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#66000000"
                    android:shadowRadius="1"
                    android:layout_marginStart="17.5dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_bottom_icon_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/aos_uikit_t_inverse_light"
                android:id="@+id/tv_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="倍速"
                android:shadowColor="#66000000"
                android:shadowRadius="1"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/pause_btn"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/landscape_seekbar_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView>
