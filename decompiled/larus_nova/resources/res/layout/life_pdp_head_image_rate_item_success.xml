<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="16sp"
                android:textColor="#ff161823"
                android:ellipsize="end"
                android:id="@+id/rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:id="@+id/rate_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="好评率"
                android:maxLines="1"
                android:layout_marginStart="12dp"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:id="@+id/rate_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.locallife.pdp.headimage.view.rate.MultiPicRateView
            android:id="@+id/multipic_rate_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.bytedance.locallife.pdp.headimage.view.rate.SimpleRateView
            android:id="@+id/first_simple_rate_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.bytedance.locallife.pdp.headimage.view.rate.SimpleRateView
            android:id="@+id/second_simple_rate_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/success_bottom_split"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="#ff161823"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看全部评价"
                android:maxLines="1"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/success_right_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
