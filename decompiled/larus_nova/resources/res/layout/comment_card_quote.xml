<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/facade_round_around_m"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="3dp"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        android:elevation="4dp"
        android:backgroundTint="@color/bg_float">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/comment_card_collaborator"
            android:background="@color/udtoken_tag_bg_indigo"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            app:border_drawable="@drawable/ud_icon_group_filled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/comment_card_divider"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="6dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/comment_card_collaborator_icon"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/comment_card_divider"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_lock_filled"
            app:tint="@color/icon_n3"/>
        <View
            android:id="@+id/comment_card_divider"
            android:background="@drawable/facade_round_around_xs"
            android:layout_width="2dp"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            android:backgroundTint="@color/udtoken_quote_bar_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/comment_card_collaborator"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/comment_card_quote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/comment_card_divider"
            app:layout_constraintRight_toLeftOf="@+id/comment_card_menu_wrapper"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/comment_card_menu_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/revision"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/comment_card_reply"
                android:layout_width="@dimen/space_kit_len_32"
                android:layout_height="@dimen/space_kit_len_16"
                android:scaleType="centerInside"
                android:tint="@color/icon_n2"
                android:paddingStart="@dimen/space_kit_len_16"
                app:srcCompat="@drawable/ud_icon_yes_outlined"/>
            <ImageView
                android:id="@+id/comment_card_more"
                android:visibility="visible"
                android:layout_width="@dimen/space_kit_len_32"
                android:layout_height="@dimen/space_kit_len_16"
                android:scaleType="centerInside"
                android:tint="@color/icon_n2"
                android:paddingStart="@dimen/space_kit_len_16"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/revision"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:paddingStart="@dimen/space_kit_len_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/accept_revision"
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                app:tint="@color/function_success_content_default"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/reject_revision"
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:layout_marginRight="@dimen/space_kit_len_15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/accept_revision"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_close_bold_outlined"
                app:tint="@color/function_danger_content_default"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
