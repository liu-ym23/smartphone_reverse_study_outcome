<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/iv_top_bg"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.3333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rv_video_team_bg"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_bg">
        <com.bytedance.android.live.liveinteract.videotalk.ui.TeamFightPartBackground
            android:id="@+id/rv_video_red_team_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:bgCornerRadius="0.8dp"
            app:endColor="@color/ttlive_team_fight_border_left"
            app:leftPart="true"
            app:startColor="@color/ttlive_team_fight_border_alpha_left"
            app:strokeWidth="1.2dp"/>
        <com.bytedance.android.live.liveinteract.videotalk.ui.TeamFightPartBackground
            android:id="@+id/rv_video_blud_team_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:bgCornerRadius="0.8dp"
            app:endColor="@color/ttlive_team_fight_border_alpha_right"
            app:leftPart="false"
            app:startColor="@color/ttlive_team_fight_border_right"
            app:strokeWidth="1.2dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/video_team_fight_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationY="-12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_bg">
        <com.bytedance.android.live.liveinteract.revenue.fight.view.TeamFightTitleLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/team_fight_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="0dp"/>
        <com.bytedance.android.live.liveinteract.revenue.fight.view.TeamFightPKProgressLayout
            android:id="@+id/team_fight_progressbar"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_team_fight_progress_layout_height"
            android:layout_marginTop="-4dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/team_fight_result_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/red_team_fight_result_iv"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/blue_team_fight_result_iv"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/blue_team_fight_result_iv"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/red_team_fight_result_iv"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
