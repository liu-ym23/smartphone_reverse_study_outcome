<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/uicomponent_common_alert_dialog_content_container">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/uicomponent_common_alert_dialog_sub_container">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/uicomponent_common_alert_dialog_title_tv"/>
        <TextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/uicomponent_common_alert_dialog_content_tv"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <com.bytedance.android.uicomponent.button.UIButton
            android:id="@+id/main_action_btn"
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            style="@style/uicomponent_button_style_primary_l"/>
        <TextView
            android:textSize="@dimen/uicomponent_button_text_size_m"
            android:textColor="@color/ttlive_std_text_modal_2"
            android:gravity="center"
            android:id="@+id/sub_action_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/uicomponent_button_height_m"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>
