<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/mini_app_image_view"
        android:background="@drawable/larus_mini_artifact_viewholder_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <View
        android:id="@+id/shadow_layer_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/mini_app_image_view"
        app:layout_constraintEnd_toEndOf="@+id/mini_app_image_view"
        app:layout_constraintStart_toStartOf="@+id/mini_app_image_view"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/larus_static_white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
