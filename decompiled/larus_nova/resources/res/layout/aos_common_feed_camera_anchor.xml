<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_anchor_rl"
    android:background="@drawable/aos_camera_anchor_item_bg"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginTop="5dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_camera_anchor"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/aos_white"
        android:id="@+id/tv_camera_anchor_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aos_camera_anchor_title"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_camera_anchor"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_camera_anchor_divider"
        android:background="@color/aos_reverse_t_tertiary"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_anchor_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/aos_white"
        android:ellipsize="end"
        android:id="@+id/tv_camera_anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="香港尖沙咀海边"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_camera_anchor_distance"
        app:layout_constraintStart_toEndOf="@+id/view_camera_anchor_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/aos_white"
        android:id="@+id/tv_camera_anchor_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2km"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_anchor_name"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
