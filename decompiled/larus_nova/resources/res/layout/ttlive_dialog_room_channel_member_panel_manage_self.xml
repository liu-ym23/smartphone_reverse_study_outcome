<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelLinkShadowView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bottomShow="true"
    app:leftShow="true"
    app:rightShow="true"
    app:shadowColor="#90cccccc"
    app:shadowLimit="8dp"
    app:topShow="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearlayout_container"
        android:background="@drawable/ttlive_bg_room_channel_member_manage_white"
        android:focusable="true"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ttlive_room_channel_member_manage_leave_link">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/leave_link_view"
            android:layout_width="160dp"
            android:layout_height="52dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ttlive_icon_room_channel_down_link"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_room_channel_member_manage_leave_link"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="7dp"
        android:layout_height="20dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ttlive_dialog_room_channel_member_panel_manage_arrow"
        android:layout_marginStart="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/linearlayout_container"
        app:layout_constraintStart_toStartOf="@+id/linearlayout_container"/>
</com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelLinkShadowView>
