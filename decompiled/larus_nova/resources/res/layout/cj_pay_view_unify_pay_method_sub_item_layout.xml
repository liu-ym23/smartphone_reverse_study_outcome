<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/unify_credit_pay_voucher_item_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/cj_pay_padding_8">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/unify_credit_pay_voucher_item_content_layout"
            android:background="@drawable/cj_pay_bg_credit_pay_voucher_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_4">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:layout_gravity="center_horizontal"
                android:id="@+id/unify_tv_tip_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_10"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.5"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_10"
                android:textColor="@color/cj_pay_color_red_fe2c55_opacity_75"
                android:layout_gravity="center_horizontal"
                android:id="@+id/unify_tv_tip_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_2"
                android:layout_marginBottom="@dimen/cj_pay_padding_10"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.4"
                android:textAlignment="center"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
            android:layout_gravity="right"
            android:id="@+id/unify_tv_right_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
