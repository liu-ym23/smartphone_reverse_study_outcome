<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_bank"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_padding_48">
    <ImageView
        android:id="@+id/iv_bank_icon"
        android:layout_width="@dimen/cj_pay_padding_20"
        android:layout_height="@dimen/cj_pay_padding_20"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_16"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/tv_bank_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cj_pay_padding_22"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_toRightOf="@+id/iv_bank_icon"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/cj_pay_color_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/cj_pay_height_50"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
