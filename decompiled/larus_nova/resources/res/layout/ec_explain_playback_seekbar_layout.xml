<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/white"
        android:id="@+id/commerce_playback_tv_video_curtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:text="@string/ec_explain_playback_video_length_zero"
        android:layout_marginEnd="8dp"
        style="@style/font_size_28"/>
    <TextView
        android:textColor="@color/ec_color_white_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ec_explain_playback_divider"
        style="@style/font_size_28"/>
    <TextView
        android:textColor="@color/ec_color_white_50"
        android:id="@+id/commerce_playback_tv_video_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/ec_explain_playback_video_length_unknown"
        android:layout_marginStart="8dp"
        style="@style/font_size_28"/>
    <com.bytedance.android.livesdk.livecommerce.playback.widget.VideoPlaybackSeekBar
        android:id="@+id/commerce_playback_video_seekbar"
        android:background="@null"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxHeight="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/ec_explain_playback_video_seekbar_layer_progress"
        android:minHeight="3dp"
        android:thumb="@drawable/ec_explain_playback_video_seekbar_shape_circle"
        android:thumbOffset="0dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="12dp"/>
    <com.bytedance.android.ui.base.widget.button.CornersButton
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_speed"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:bg_color="@color/explain_playback_color_3A3A3A_50"
        style="@style/font_size_24"/>
</LinearLayout>
