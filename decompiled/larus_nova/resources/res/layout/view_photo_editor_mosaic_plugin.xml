<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.photoeditor.mosaic.MosaicView
        android:id="@+id/mosaic_vew"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/rl_mosaic_select"
        android:background="@drawable/photo_editor_text_choice_color_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:layout_marginBottom="0.5dp"
        android:layout_alignParentBottom="true">
        <com.ss.android.photoeditor.graffiti.ShowTipsSeekBarLinearLayout
            android:id="@+id/show_tips_seek_bar_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18.5dp"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_mosaic_type_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="82.5dp"
            android:layout_marginRight="82.5dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/show_tips_seek_bar_ll">
            <LinearLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_normal_mosaic"
                    android:background="@drawable/photo_editor_mosaic_normal_mosaic"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/photo_editor_mosaic_rect"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_brush_mosaic"
                    android:background="@drawable/photo_editor_mosaic_brush_mosaic"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/photo_editor_mosaic_rect"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_mosaic_secondary_tools"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/show_tips_seek_bar_ll"
            android:layout_centerHorizontal="true">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="@color/photo_editor_preset_mask_text_color"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_preset_mask_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="68dp"
                android:text="@string/Lark_Screenshot_AutoBlur_Button"
                android:maxLines="1"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ud_icon_mosaic_ai_outlined"
                app:drawableTint="@color/photo_editor_preset_mask_icon_tint"/>
            <View
                android:id="@+id/preset_mask_divider"
                android:background="@color/lkui_N500"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
            <FrameLayout
                android:id="@+id/ll_mosaic_type_choice_compact"
                android:layout_width="101dp"
                android:layout_height="22dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/iv_normal_mosaic_compact"
                    android:background="@drawable/photo_editor_mosaic_normal_mosaic"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="1dp"
                    app:srcCompat="@drawable/photo_editor_mosaic_rect"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/iv_brush_mosaic_compact"
                    android:background="@drawable/photo_editor_mosaic_brush_mosaic"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/photo_editor_mosaic_rect"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
