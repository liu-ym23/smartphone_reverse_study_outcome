<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.larus.photopicker.v2.impl.ui.MyTitleViewBehavior">
        <include
            android:id="@+id/title_hint_allow_album_permission"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/larus_item_title_hint_allow_album_permission"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:paddingBottom="?attr/larus_dp_8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="?attr/larus_neutral_100"
            app:tabIndicatorFullWidth="false"
            app:tabRippleColor="@android:color/transparent"/>
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mediaViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.larus.photopicker.v2.impl.ui.MyScrollingViewBehavior"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/media_list_bottom_selector_container"
        android:background="?attr/larus_base_1"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/media_list_bottom_selector_recycler"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/media_list_confirm"
            android:background="?attr/larus_tools_media_import_preview_selector_next_step_bg"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/larus_album_next_btn"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="16dp"
            style="@style/tools_font_size_30"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_list_folder_recycler"
        android:background="?attr/larus_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"/>
    <com.google.android.material.appbar.AppBarLayout
        android:orientation="vertical"
        android:id="@+id/app_bar"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:layout_scrollFlags="enterAlways|scroll">
            <ImageView
                android:id="@+id/title_close"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="?attr/larus_media_import_ic_titlebar_black_close"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/larus_BtnCloseMediaImport"/>
            <TextView
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title_folder_entrance"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/larus_album_all_photos_btn"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/title_entrance_arrow"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/tools_font_size_34"/>
            <ImageView
                android:id="@+id/title_entrance_arrow"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="?attr/larus_media_import_ic_down_chevron_black"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/title_folder_entrance"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_original_image"
                android:paddingTop="?attr/larus_dp_2"
                android:paddingBottom="?attr/larus_dp_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/title_original_image_checkbox"
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:src="@drawable/larus_ic_checkbox_original_image"
                    android:layout_marginEnd="?attr/larus_dp_6"/>
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="?attr/larus_neutral_100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_IM_image_radioButton_original"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
