<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_sms_code_received_exception_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/cj_pay_sms_code_received_exception_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:includeFontPadding="false"/>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:id="@+id/cj_pay_sms_code_received_exception_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_10"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:text="@string/cj_pay_sms_code_received_exception_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/cj_pay_padding_1"/>
</LinearLayout>
