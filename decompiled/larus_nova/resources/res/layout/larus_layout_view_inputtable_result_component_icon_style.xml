<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/larus_camera_top_height_and_top_margin"/>
    <androidx.constraintlayout.widget.Placeholder
        android:id="@+id/focus_container_placeholder"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_line"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/larus_camera_bottom_height"/>
    <FrameLayout
        android:id="@+id/left_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/main_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/main_icon_bg"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_icon_bg">
        <ImageView
            android:id="@+id/left_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="center"/>
        <View
            android:id="@+id/left_icon_border"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/main_icon_bg"
        android:layout_width="@dimen/larus_camera_capture_button_size"
        android:layout_height="@dimen/larus_camera_capture_button_size"
        android:layout_marginTop="@dimen/larus_camera_control_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/focus_container_placeholder"/>
    <ImageView
        android:id="@+id/main_icon"
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/main_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/main_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/main_icon_bg"/>
    <FrameLayout
        android:id="@+id/right_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/main_icon_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toEndOf="@+id/main_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/main_icon_bg">
        <ImageView
            android:id="@+id/right_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="center"/>
    </FrameLayout>
    <com.larus.camera.impl.widget.CameraInputContainer
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
