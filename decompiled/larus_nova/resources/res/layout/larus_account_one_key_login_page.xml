<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/mine_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_34"
        android:text="@string/larus_doubao_login_tel_sdk_title"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="?attr/larus_dp_28"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/mask_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_28"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_phone_number"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/phone_carrier_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_28"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mask_phone_number"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_base_1"
        android:id="@+id/button_login"
        android:background="@drawable/larus_bg_align_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_68"
        android:text="@string/larus_doubao_login_tel_sdk_confirm"
        android:textAllCaps="false"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@+id/phone_carrier_name"/>
    <Button
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/button_login_other_phone"
        android:background="@drawable/larus_bg_account_button"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_doubao_login_tel_sdk_other_phone"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@+id/button_login"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/login_bottom_items"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_45"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/left_space"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/right_space"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintEnd_toStartOf="@+id/right_space"
        app:layout_constraintStart_toEndOf="@+id/left_space"
        app:layout_constraintTop_toBottomOf="@+id/button_login_other_phone">
        <CheckBox
            android:gravity="top"
            android:id="@+id/select_privacy_circle_view"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/larus_select_circle_view"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:gravity="top"
            android:layout_gravity="center"
            android:id="@+id/privacy_policy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_0_5"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
