<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:paddingBottom="33dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:id="@+id/tv_setting_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_interact_link_permission"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_line"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_tips"/>
    <FrameLayout
        android:id="@+id/fl_no_need_apply"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_link_no_need_apply"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_no_need_apply"
            android:layout_width="16dp"
            android:layout_height="11dp"
            android:layout_marginRight="18dp"
            android:src="@drawable/ttlive_ic_interact_permission_dialog_need_apply"
            android:layout_marginEnd="18dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_need_apply"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_no_need_apply">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_link_need_apply"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_need_apply"
            android:layout_width="16dp"
            android:layout_height="11dp"
            android:layout_marginRight="18dp"
            android:src="@drawable/ttlive_ic_interact_permission_dialog_need_apply"
            android:layout_marginEnd="18dp"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="#f1f1f2"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_need_apply"/>
    <FrameLayout
        android:id="@+id/no_fans"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_pk_no_fans"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_only_accept_follower"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_switch_only_join_through_invitation"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@+id/no_fans">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_pk_integration_only_by_invate"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_only_join_through_invitation"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
