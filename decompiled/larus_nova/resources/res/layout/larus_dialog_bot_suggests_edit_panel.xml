<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_ugc_bot_bg_bottom_sheet_gray"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:background="@drawable/larus_bg_sheet_handle"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_10"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_22"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_settings_pull_up_menu_tip"/>
    <com.larus.bmhome.view.item.ItemTextToggle
        android:id="@+id/suggest_switch_toggle"
        android:background="@drawable/larus_bg_bot_edit"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_settings_toggle"
        app:larus_sub_text="@string/larus_create_bot_settings_toggle_on"/>
    <com.larus.bmhome.view.item.ItemGroup
        android:background="@drawable/larus_bg_bot_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:divider="@drawable/larus_bg_divider">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_dp_16"
            android:gravity="center_vertical"
            android:id="@+id/suggest_edit_1"
            android:background="@null"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:hint="@string/larus_create_bot_settings_textBox"
            android:inputType="textNoSuggestions"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_dp_16"
            android:gravity="center_vertical"
            android:id="@+id/suggest_edit_2"
            android:background="@null"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:hint="@string/larus_create_bot_settings_textBox"
            android:inputType="textNoSuggestions"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_dp_16"
            android:gravity="center_vertical"
            android:id="@+id/suggest_edit_3"
            android:background="@null"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:hint="@string/larus_create_bot_settings_textBox"
            android:inputType="textNoSuggestions"
            style="@style/larus_EditTextStyle"/>
    </com.larus.bmhome.view.item.ItemGroup>
</LinearLayout>
