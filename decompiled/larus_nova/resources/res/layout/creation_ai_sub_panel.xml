<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/creation_mask_full_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ss.android.lark.inline.ai.creationai.NSPConstraintLayout
        android:id="@+id/creation_panel_view"
        android:background="@drawable/creation_ai_section_background_2r"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_350"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/creation_drag_view_wrapper"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toTopOf="@+id/creation_header_container"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/creation_drag_view"
                android:background="@drawable/inline_ai_drag_bar_background"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/creation_header_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:layout_constraintTop_toBottomOf="@+id/creation_drag_view_wrapper">
            <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsRecyclerView
                android:id="@+id/creation_header_left_rv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="18dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/space_kit_font_17"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/creation_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="@dimen/space_kit_len_12"
                android:paddingEnd="@dimen/space_kit_len_12"/>
            <com.ss.android.lark.inline.ai.creationai.operates.ButtonGroupsRecyclerView
                android:id="@+id/creation_header_right_rv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="18dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.ss.android.lark.inline.ai.creationai.quickPrompt.QuickPromptRecyclerView
            android:id="@+id/rv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/creation_header_container"/>
        <FrameLayout
            android:id="@+id/creation_ai_loading_state_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/creation_ai_loading_state_view"
                layout="@layout/creation_ai_default_empty_view"/>
        </FrameLayout>
    </com.ss.android.lark.inline.ai.creationai.NSPConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
