<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="right"
        android:id="@+id/compat_bg_wrapper"
        android:paddingLeft="@dimen/space_kit_len_12"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/bg_compat_for_content_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/bg_compat_for_pincontainer_radius"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.bytedance.ee.bear.bitable.infoarch.header.BitableHeaderContainer
        android:id="@+id/bitable_drawer_header"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/compat_bg_wrapper"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/catalog_container"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_wrapper"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/compat_bg_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/bitable_drawer_header">
        <View
            android:id="@+id/catalog_top_compat"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.ee.bear.bitable.uikit.search.SearchBar
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginBottom="8dp"/>
        <com.bytedance.ee.bear.bitable.uikit.empty.EmptyView
            android:id="@+id/search_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.ee.bear.bitable.common.widgets.ClippingRecyclerView
            android:id="@+id/blockCatalogRv"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/compat_bg_wrapper">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_caption"
            android:id="@+id/bottom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_kit_len_16"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:text="@string/Bitable_Mobile_CreateNew_Text"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_62"
            android:layout_marginLeft="@dimen/space_kit_len_10"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:layout_marginRight="@dimen/space_kit_len_10"
            android:layout_marginBottom="@dimen/space_kit_len_20">
            <com.bytedance.ee.bear.bitable.uikit.simpleitem.MenuItemView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/space_kit_len_6"
                android:layout_marginRight="@dimen/space_kit_len_6"
                android:layout_weight="1"/>
            <com.bytedance.ee.bear.bitable.uikit.simpleitem.MenuItemView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/space_kit_len_6"
                android:layout_marginRight="@dimen/space_kit_len_6"
                android:layout_weight="1"/>
            <com.bytedance.ee.bear.bitable.uikit.simpleitem.MenuItemView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/space_kit_len_6"
                android:layout_marginRight="@dimen/space_kit_len_6"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
