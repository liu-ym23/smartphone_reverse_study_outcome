<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:failureImage="?attr/larus_base_3_overlay"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintHorizontal_bias="0"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent"
        fresco:layout_constraintVertical_bias="0"
        fresco:placeholderImage="?attr/larus_base_3_overlay"
        fresco:roundedCornerRadius="?attr/larus_dp_4"/>
    <View
        android:id="@+id/shadow_layer_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        fresco:layout_constraintBottom_toBottomOf="@+id/item_image"
        fresco:layout_constraintEnd_toEndOf="@+id/item_image"
        fresco:layout_constraintStart_toStartOf="@+id/item_image"
        fresco:layout_constraintTop_toTopOf="@+id/item_image"/>
    <com.larus.uaigc.music.widget.LyricsToSongTemplatePlayerView
        android:layout_gravity="start|top"
        android:id="@+id/player_view"
        android:layout_width="?attr/larus_dp_52"
        android:layout_height="?attr/larus_dp_52"
        fresco:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_static_white"
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/music_title_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="?attr/larus_dp_150"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_12"
        fresco:layout_constraintStart_toStartOf="@+id/player_view"
        fresco:layout_constraintTop_toBottomOf="@+id/player_view"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/static_white_transparent_4"
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/music_genry_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_4"
        android:maxWidth="?attr/larus_dp_150"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_12"
        fresco:layout_constraintStart_toStartOf="@+id/player_view"
        fresco:layout_constraintTop_toBottomOf="@+id/music_title_text"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/icon_template"
        android:background="@drawable/larus_bg_same_template_button"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:paddingStart="?attr/larus_dp_14"
        android:paddingEnd="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_12"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/discovery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_make_the_template_style"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
