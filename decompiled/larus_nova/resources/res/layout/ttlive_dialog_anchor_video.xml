<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:background="@drawable/ttlive_bg_link_video_list_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ttlive_leftTopRadius="8dp"
    app:ttlive_rightTopRadius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17dp"
            android:textColor="#161823"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_choose_related_video"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_back"
            android:paddingLeft="15dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/link_video_back_icon"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <ImageView
            android:id="@+id/iv_question"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="14dp"
            android:src="@drawable/ttlive_ic_link_video_question"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_top">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_tip"
            android:background="#f4f3f4"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textSize="12dp"
                android:textColor="#99161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_only_choose_checked_video"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
            android:layout_gravity="center"
            android:id="@+id/live_play_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="94dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="94dp"
            android:layout_marginBottom="19dp"
            android:layout_marginStart="94dp"
            android:layout_marginEnd="94dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_tip"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_allRadius="8dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_link_success_tag"
            android:background="@drawable/ttlive_bg_link_video_success_tag"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_link_success_tag_width"
            android:layout_height="@dimen/ttlive_link_success_tag_height"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_linked_video_tag"
            android:layout_marginStart="8dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_play_container"
            app:layout_constraintTop_toTopOf="@+id/live_play_container"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_video_list_height"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_pager_rlv"
            android:background="@color/ttlive_core_hs_w1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_tip"/>
        <FrameLayout
            android:id="@+id/fl_loading"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_video_list_height">
            <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                android:layout_gravity="center"
                android:id="@+id/animation_double_ball"
                android:layout_width="36dp"
                android:layout_height="36dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_reload"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:background="@drawable/ttlive_ic_link_video_empty"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="79dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_network_error"/>
            <Button
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:gravity="center"
                android:id="@+id/btn_reload"
                android:background="@drawable/ttlive_bg_button_gray"
                android:layout_width="200dp"
                android:layout_height="38dp"
                android:layout_marginTop="24dp"
                android:text="@string/ttlive_retry"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_empty"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_empty"
                android:background="@drawable/ttlive_ic_link_video_empty"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_marginTop="79dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_video_list_empty"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_link"
        android:background="@drawable/ttlive_bg_button_link"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_room_video_link"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="15dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/ttlive_bg_button_gray"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_cancel_link"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/v_space"/>
        <View
            android:id="@+id/v_space"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toRightOf="@+id/btn_cancel"
            app:layout_constraintRight_toLeftOf="@+id/btn_again"/>
        <Button
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_again"
            android:background="@drawable/ttlive_bg_button_link"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_choose_again"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/v_space"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
