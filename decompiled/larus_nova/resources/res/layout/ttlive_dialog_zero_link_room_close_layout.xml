<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_pk_room_close_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14dp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="32dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/room_center_button_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <Button
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/room_center_button_left"
            android:background="@drawable/ttlive_bg_pk_room_close_dialog_btn_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/room_center_button_right"
            android:background="@drawable/ttlive_bg_pk_room_close_dialog_btn_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
