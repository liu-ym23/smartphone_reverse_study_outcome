<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/aos_linear_gradient_horizontal"
        android:paddingTop="36dp"
        android:paddingBottom="36dp"
        android:layout_width="243dp"
        android:layout_height="match_parent"
        android:weightSum="4">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_selected_white_pink"
            android:gravity="center"
            android:id="@+id/speed_20x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_selected_white_pink"
            android:gravity="center"
            android:id="@+id/speed_15x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.5x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_selected_white_pink"
            android:gravity="center"
            android:id="@+id/speed_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_selected_white_pink"
            android:gravity="center"
            android:id="@+id/speed_05x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.5x"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
