<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_root_container"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintVertical_chainStyle="packed">
    <FrameLayout
        android:id="@+id/cj_pay_layout_pwd_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_layout_pwd_extra_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.android.ttcjpaysdk.base.ui.component.input.CJPwdInputLayout
            android:id="@+id/cj_pay_layout_pwd_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.android.ttcjpaysdk.base.ui.component.input.CJPwdInputLayout
            android:id="@+id/cj_pay_change_pwd_first_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.android.ttcjpaysdk.base.ui.component.input.CJPwdInputLayout
            android:id="@+id/cj_pay_change_pwd_second_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/cj_pay_layout_pwd_extra_container"
        android:paddingLeft="30px"
        android:paddingRight="30px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_view_num_keyboard"
        app:layout_constraintEnd_toEndOf="@+id/cj_pay_layout_pwd_input_container"
        app:layout_constraintStart_toStartOf="@+id/cj_pay_layout_pwd_input_container"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_pwd_input_container"/>
    <com.android.ttcjpaysdk.base.ui.component.keyboard.CJNumKeyboardView
        android:id="@+id/cj_pay_view_num_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:CJNumKeyboardStyle="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_pwd_extra_container"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
