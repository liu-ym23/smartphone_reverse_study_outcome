<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ttlive_dialog_interact_anchor_contaienr"
    android:layout_width="match_parent"
    android:layout_height="106dp">
    <FrameLayout
        android:id="@+id/pk_season_panel_info"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginLeft="13dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_container"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <RelativeLayout
        android:id="@+id/tab_container"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/ttlive_black"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabMaxWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabSelectedTextColor="@color/ttlive_black"
            app:tabTextAppearance="@style/AnchorInteractTextStyle"
            app:tabTextColor="#4c000000"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/liveuikit_black"
            android:id="@+id/center_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/top_precise_find"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_ic_pk_precise_find_close"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/top_search"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_ic_pk_search_list"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/top_record"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_pk_history_icon_new"
                android:layout_marginEnd="8dp"/>
            <LinearLayout
                android:id="@+id/set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_ic_anchor_container_set"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80000000"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/set_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_setting"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
