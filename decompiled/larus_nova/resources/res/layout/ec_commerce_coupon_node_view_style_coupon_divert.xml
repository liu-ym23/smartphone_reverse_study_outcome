<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coupon_container_cl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layoutMode="height_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_left_container"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="7dp"
        android:layout_marginStart="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="26dp"
            android:textColor="@color/commerce_color_coupon"
            android:id="@+id/tv_price_big"
            android:layout_width="wrap_content"
            android:layout_height="28dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/commerce_color_coupon"
            android:id="@+id/tv_price_small"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:text="@string/shopping_currency_yuan"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_center_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="86dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/commerce_color_coupon"
            android:id="@+id/tv_top_coupon"
            android:layout_width="wrap_content"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/tv_price_bottom"
            android:layout_width="wrap_content"
            android:layout_height="13dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_right_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_hours"
            android:background="@drawable/commerce_inflow_count_down_bg"
            android:layout_width="16dp"
            android:layout_height="14dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/commerce_color_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="2dp"
            android:text="@string/colon"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_min"
            android:background="@drawable/commerce_inflow_count_down_bg"
            android:layout_width="16dp"
            android:layout_height="14dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/commerce_color_coupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="2dp"
            android:text="@string/colon"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sec"
            android:background="@drawable/commerce_inflow_count_down_bg"
            android:layout_width="25dp"
            android:layout_height="14dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ec_inner_flow_coupon_expire_color"
        android:id="@+id/tv_expired"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="@string/ec_inner_flow_count_down_expired"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
