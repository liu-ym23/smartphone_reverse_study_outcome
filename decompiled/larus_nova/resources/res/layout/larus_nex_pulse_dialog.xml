<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/out_side"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_content_view"
        android:background="?attr/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:actualImageScaleType="centerCrop"
            app:failureImage="?attr/larus_neutral_50"
            app:layout_constraintBottom_toTopOf="@+id/title_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"
            app:viewAspectRatio="1.2188"/>
        <com.larus.common_ui.video.VideoPlayView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/title_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/mute_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_nex_pulse_dialog_mute"
            app:layout_constraintBottom_toBottomOf="@+id/video_view"
            app:layout_constraintEnd_toEndOf="@+id/video_view"/>
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_24"
            app:layout_constraintBottom_toTopOf="@+id/scroll_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ScrollView
            android:id="@+id/scroll_view"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_24"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_119"
            android:paddingStart="?attr/larus_dp_24"
            android:paddingEnd="?attr/larus_dp_24"
            app:layout_constraintBottom_toTopOf="@+id/button_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.larus.bmhome.view.textview.impl.CustomMarkdownTextView
                android:textSize="?attr/larus_dp_15"
                android:textColor="?attr/larus_neutral_70"
                android:id="@+id/content_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"/>
        </ScrollView>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/button_view"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_btn"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_nex_pulse_dialog_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
