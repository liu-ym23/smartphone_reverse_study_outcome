<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/date_content_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/date_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:lineSpacingExtra="3dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/date_content_reminder"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_16"
        android:layout_height="@dimen/space_kit_len_16"
        android:tint="@color/primary_fill_default"
        android:layout_marginStart="8dp"
        app:srcCompat="@drawable/ud_icon_alarm_clock_filled"/>
</LinearLayout>
