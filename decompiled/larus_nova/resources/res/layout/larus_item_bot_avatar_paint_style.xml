<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_6"
    android:paddingRight="?attr/larus_dp_6"
    android:layout_width="?attr/larus_dp_94"
    android:layout_height="?attr/larus_dp_108">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_106"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/larus_neutral_transparent_1"/>
    <View
        android:id="@+id/mask"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"/>
    <FrameLayout
        android:id="@+id/overlay"
        android:background="@drawable/larus_ugc_bot_bg_avatar_shadow"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
            android:layout_gravity="center"
            android:background="@color/larus_primary_50"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="?attr/larus_dp_7_5"
                android:layout_height="?attr/larus_dp_8"
                android:src="@drawable/larus_ugc_bot_icon_union"/>
        </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="?attr/larus_dp_68"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
