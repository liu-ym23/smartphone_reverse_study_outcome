<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/title_container"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="177dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_ban_cur_round"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_anchor_interact_ban_invite_round_setting"/>
    <View
        android:id="@+id/divider_2"
        android:background="#e0e0e0"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_ban_cur_day"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_anchor_interact_ban_invite_temp_setting"/>
    <View
        android:id="@+id/divider_3"
        android:background="#0c161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_anchor_link_dialog_confirm_negative_button"/>
</LinearLayout>
