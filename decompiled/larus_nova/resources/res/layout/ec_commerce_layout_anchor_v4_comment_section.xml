<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_layout_anchor_v4_comment_section_2073861485"
    android:background="#ffffff"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:id="@+id/anchor_v4_comment_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
        android:id="@+id/anchor_v4_comment_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
        android:id="@+id/anchor_v4_comment_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
        android:id="@+id/anchor_v4_comment_content_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.MediaScrollBoxComponentView
        android:id="@+id/anchor_v4_comment_medias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v4_multi_comments"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/anchor_v4_comment_divider_1"
        android:background="#f6f7fb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:id="@+id/anchor_v4_comment_buyers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.MediaScrollBoxComponentView
        android:id="@+id/anchor_v4_comment_buyers_medias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <View
        android:id="@+id/anchor_v4_comment_divider_2"
        android:background="#f6f7fb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:id="@+id/anchor_v4_comment_other_goods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.TagsScrollBoxComponentView
        android:id="@+id/anchor_v4_comment_other_goods_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <View
        android:id="@+id/anchor_v4_comment_divider_3"
        android:background="#f6f7fb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:id="@+id/anchor_v4_comment_kol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/anchor_v4_comment_cl_kol"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="12dp">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:id="@+id/anchor_v4_comment_kol_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextElementView
            android:ellipsize="end"
            android:id="@+id/anchor_v4_comment_kol_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/anchor_v4_comment_kol_media"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/anchor_v4_comment_kol_user"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:id="@+id/anchor_v4_comment_kol_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:id="@+id/anchor_v4_comment_kol_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/anchor_v4_comment_kol_media"
            app:layout_constraintStart_toEndOf="@+id/anchor_v4_comment_kol_likes"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.MediaBoxElementView
            android:id="@+id/anchor_v4_comment_kol_media"
            android:layout_width="81dp"
            android:layout_height="81dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <HorizontalScrollView
        android:id="@+id/anchor_v4_ll_new_kol_review"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <View
        android:id="@+id/anchor_v4_comment_divider_ask_around"
        android:background="#f6f7fb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:id="@+id/anchor_v4_ask_around_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v4_ll_ask_around_items"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
</LinearLayout>
