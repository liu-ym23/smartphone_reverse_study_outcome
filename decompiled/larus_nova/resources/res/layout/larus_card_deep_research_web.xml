<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/web_card_root"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_48">
    <com.larus.bmhome.chat.layout.widget.DeepResearchWebProgressBar
        android:layout_gravity="center"
        android:id="@+id/web_loading_bar"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/web_icon"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_web"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/web_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/larus_deepResearch_messageCard_status_viewWeb"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_6"
        android:layout_marginEnd="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/web_icon"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
