<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_sign_layout"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_pay_sign_layout_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_sign_half_page_container"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="504dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:id="@+id/sign_page_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/cj_pay_bg_sign_page"
            android:scaleType="centerCrop"
            app:CJPayCorners="CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="20dp"/>
        <RelativeLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/sign_left_close_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/cj_pay_icon_titlebar_left_round_close"
                android:layout_marginStart="12dp"/>
            <ImageView
                android:id="@+id/navigation_bar_icon"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="72dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="true"
            android:layout_above="@+id/ll_sign_bottom_content"
            android:overScrollMode="never">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/v_sign_half_page_main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
                    android:id="@+id/sign_merchant_icon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
                    app:CJPayCornersRadius="12dp"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:gravity="center"
                    android:id="@+id/sign_product_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="32dp"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/sign_risk_fund_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/risk_fund_amount_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/cj_pay_currency_unit"/>
                    <TextView
                        android:textSize="40sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/risk_fund_amount"
                        android:paddingTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/risk_fund_description_text"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:gravity="center"
                    android:id="@+id/sign_product_sub_name_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"/>
                <View
                    android:id="@+id/sign_split_line"
                    android:background="#14161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sign_product_sub_name_text"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/sign_service_detail_line_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#99161823"
                        android:layout_gravity="top"
                        android:id="@+id/sign_service_detail_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cj_pay_sign_and_pay_service_title"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff161823"
                        android:gravity="left"
                        android:layout_gravity="top"
                        android:id="@+id/sign_service_detail_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/sign_service_detail_left"
                        android:layout_marginStart="24dp"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_sign_bottom_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <ViewStub
                android:id="@+id/rl_voucher_label_layout"
                android:layout="@layout/cj_pay_sign_voucher_label_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <FrameLayout
                android:id="@+id/layout_lynx_card_btn_up"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>
            <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
                android:id="@+id/sign_agreement_view_above"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                android:gravity="center"
                android:id="@+id/sign_confirm_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                app:btnTextColor="@color/cj_pay_color_white"
                app:btnTextSize="15sp"
                app:loadingHeight="20dp"
                app:loadingWidth="20dp"/>
            <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
                android:id="@+id/sign_agreement_view_below"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
