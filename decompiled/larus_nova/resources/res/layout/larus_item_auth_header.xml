<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_12">
    <ImageView
        android:id="@+id/auth_account_logo"
        android:background="@drawable/image_view_border"
        android:padding="?attr/larus_dp_1"
        android:layout_width="?attr/larus_dp_72"
        android:layout_height="?attr/larus_dp_72"
        android:src="@drawable/icon_logo_v2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/auth_account_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_auth_login_title"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/auth_account_logo"
        app:layout_constraintTop_toBottomOf="@+id/auth_account_logo"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/auth_account_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:text="@string/larus_auth_login_desc"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/auth_account_title"
        app:layout_constraintTop_toBottomOf="@+id/auth_account_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
