<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="128dp"
    android:layout_height="128dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/find_same_item_pic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:id="@+id/find_same_item_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/commerce_anchor_v4_find_same_item_mask"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.2031"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/find_same_item_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="6dp"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:pv_priceDecimalTextSizeRatio="1"
        app:pv_priceTextColor="@color/white"/>
    <ImageView
        android:id="@+id/find_same_item_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:src="@drawable/commerce_anchor_v4_find_same_item_arrow"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/find_same_item_price"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/find_same_item_price"/>
</merge>
