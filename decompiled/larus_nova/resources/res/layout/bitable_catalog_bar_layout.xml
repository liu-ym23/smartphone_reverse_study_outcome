<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bitable_catelog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:weightSum="1">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/catalog_wrapper"
                android:paddingRight="@dimen/space_kit_len_16"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/space_kit_len_16">
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/table_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/space_kit_len_50"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="0"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/divider"
                    android:visibility="gone"
                    android:layout_width="@dimen/space_kit_len_22"
                    android:layout_height="@dimen/space_kit_len_22"
                    android:tint="@color/line_divider_default"
                    android:tintMode="src_in"
                    app:srcCompat="@drawable/ud_icon_diagonal_outlined"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/view_icon"
                    android:layout_width="@dimen/space_kit_len_18"
                    android:layout_height="@dimen/space_kit_len_18"
                    android:layout_marginEnd="@dimen/space_kit_len_6"
                    app:srcCompat="@drawable/ud_icon_bitablegrid_outlined"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/view_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/space_kit_len_12"
                    android:layout_height="@dimen/space_kit_len_12"
                    android:tint="@color/icon_n1"
                    android:layout_marginStart="@dimen/space_kit_len_9"
                    app:srcCompat="@drawable/ud_icon_expand_down_filled"/>
                <com.larksuite.component.universe_design.badge.UDBadgeView
                    android:layout_gravity="top"
                    android:id="@+id/badge"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="2dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintStart_toEndOf="@+id/title"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/UDBadge.Dot.StrongReminder.Medium"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/catalog_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_divider"/>
</LinearLayout>
