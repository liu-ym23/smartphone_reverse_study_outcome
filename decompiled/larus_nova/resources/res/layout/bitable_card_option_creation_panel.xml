<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
        android:id="@+id/panel"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:panel_left_text="@string/Bitable_Common_ButtonCancel"
        app:panel_left_text_color="@color/bitable_cell_edit_panel_text_color"
        app:panel_menu_type="text"
        app:panel_right_text="@string/Bitable_Common_ButtonDone"
        app:panel_right_text_color="@color/bitable_cell_edit_panel_text_color"
        app:panel_title="@string/Bitable_Option_CreateTitle">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/optionInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.suite.lark.emm.design.edittext.SCEditText
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/optionET"
                    android:background="@drawable/bitable_option_edit_capsule_bg"
                    android:paddingTop="@dimen/space_kit_len_4"
                    android:paddingBottom="@dimen/space_kit_len_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_kit_len_16"
                    android:layout_marginBottom="@dimen/space_kit_len_16"
                    android:hint="@string/Bitable_Option_PleaseEnter"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/space_kit_len_12"
                    android:paddingEnd="@dimen/space_kit_len_12"
                    android:layout_marginStart="@dimen/space_kit_len_16"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:backgroundTint="@color/ud_Y300"/>
                <View
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_divider"/>
            </LinearLayout>
            <com.bytedance.ee.bear.widgets.colorpicker.CommonColorSchemeView
                android:id="@+id/colorSchemeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_14"
                android:layout_marginBottom="@dimen/space_kit_len_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/availableOptionContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_kit_len_16">
                <View
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_divider"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/bg_float"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_56"
                    android:backgroundTint="@color/facade_selector_item_body">
                    <TextView
                        android:textSize="@dimen/space_kit_font_16"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Option_OptionExists"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/space_kit_len_16"/>
                    <com.bytedance.ee.bear.bitable.card.view.cell.select.SelectTextView
                        android:textSize="@dimen/space_kit_font_14"
                        android:id="@+id/availableOptionTV"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/space_kit_len_24"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/space_kit_len_2"
                        android:layout_marginEnd="@dimen/space_kit_len_14"/>
                </LinearLayout>
                <View
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_divider"/>
            </LinearLayout>
            <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView>
</FrameLayout>
