<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/poi_dito_empty_video_view_593303024"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_parent"
        android:paddingLeft="@dimen/empty_page_padding"
        android:paddingRight="@dimen/empty_page_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp">
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/poi_empty_title"
            app:fontType="medium"
            style="@style/font_size_34_sp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextTertiary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/poi_empty_content"
            style="@style/font_size_28_sp"/>
    </LinearLayout>
</LinearLayout>
