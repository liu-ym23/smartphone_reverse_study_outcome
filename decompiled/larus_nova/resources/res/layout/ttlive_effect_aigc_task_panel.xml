<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_effect_bg_aigc_tack_panel"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:cardBackgroundColor="#33000000"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/fl_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/fl_bottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/keyword_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#80ffffff"
                        android:id="@+id/keyword_selector_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_effect_aigc_task_keyword_selector_title"
                        app:layout_constraintBottom_toTopOf="@+id/keyword_selector_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.android.live.effect.sticker.ui.aigc.HorizontalScrollItemSelector
                        android:id="@+id/keyword_selector_content"
                        android:background="#80ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/keyword_selector_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#e5ffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_running_keyword_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_top">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:id="@+id/btn_white"
                        android:background="@drawable/ttlive_effect_bg_aigc_button_white"
                        android:visibility="gone"
                        android:layout_width="98dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="9dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_blue"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/btn_blue"
                        android:background="@drawable/ttlive_effect_bg_aigc_button_blue"
                        android:layout_width="112dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="9dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/btn_white"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/progress_bar"
                    android:background="@drawable/ttlive_effect_bg_aigc_button_blue_active"
                    android:visibility="gone"
                    android:layout_width="250dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
