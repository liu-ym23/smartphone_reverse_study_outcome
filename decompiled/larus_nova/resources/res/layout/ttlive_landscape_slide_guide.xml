<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ttlive_landscape_slide_guide"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_landscape_layout_brightness"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/ttlive_landscape_guide_brightness"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="135dp"
            android:src="@drawable/ttlive_bg_landscape_guide_brightness"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ttlive_landscape_guide_brightness_progress"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="134dp"
            android:src="@drawable/ttlive_bg_landscape_guide_progress"
            android:layout_marginStart="7dp"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_landscape_guide_brightness"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_landscape_guide_brightness_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="134dp"
            android:layout_marginBottom="100dp"
            android:text="@string/ttlive_landscape_adjust_brightness"
            android:fontFamily="PingFangSC"
            android:layout_marginStart="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_landscape_guide_divide_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_landscape_layout_slide"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_landscape_guide_slide"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="105dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_landscape_guide_slide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="134dp"
            android:layout_marginBottom="100dp"
            android:text="@string/ttlive_landscape_adjust_slide"
            android:fontFamily="PingFangSC"
            android:layout_marginStart="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_landscape_layout_volume"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/ttlive_landscape_guide_volume"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="135dp"
            android:src="@drawable/ttlive_bg_landscape_guide_volume"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ttlive_landscape_guide_volume_progress"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="134dp"
            android:src="@drawable/ttlive_bg_landscape_guide_progress"
            android:layout_marginStart="7dp"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_landscape_guide_volume"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_landscape_guide_volume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="134dp"
            android:layout_marginBottom="100dp"
            android:text="@string/ttlive_landscape_adjust_volume"
            android:fontFamily="PingFangSC"
            android:layout_marginStart="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_landscape_guide_divide_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
