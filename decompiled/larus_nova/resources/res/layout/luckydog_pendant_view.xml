<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/luckydog_pendant_main_ll"
    android:background="@drawable/luckydog_pendant_bg"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/luckydog_pendant_unfolded_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/luckydog_pendant_iv_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/spring_db"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/luckydog_pendant_text_white"
            android:id="@+id/luckydog_pendant_tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="8"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/luckydog_pendant_text_white"
        android:layout_gravity="center_vertical"
        android:id="@+id/luckydog_pendant_folded_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:maxEms="8"/>
</LinearLayout>
