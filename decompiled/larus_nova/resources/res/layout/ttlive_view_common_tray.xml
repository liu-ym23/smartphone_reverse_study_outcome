<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/common_tray_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.interactivity.common.combinedtext.CombinedTextRenderView
        android:id="@+id/content"
        android:background="@drawable/ttlive_bg_common_tray_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/combo_body"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/combo_body"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="-3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/content"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:id="@+id/combo_count_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x"/>
        <com.bytedance.android.livesdk.widget.MaxWidthTextView
            android:textSize="24dp"
            android:textColor="#ffffff"
            android:id="@+id/combo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="1"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
