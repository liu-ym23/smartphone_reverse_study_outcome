<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/title_img_dv"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layoutMode="width_self_adjust"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ec_commerce_color_90FFFFFF"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/sub_title_img_dv"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="4dp"
        app:layoutMode="width_self_adjust"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ec_commerce_color_90FFFFFF"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/sub_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:maxWidth="126dp"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/right_icon_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/right_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</LinearLayout>
