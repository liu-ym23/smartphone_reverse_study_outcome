<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_selected_message_more_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_color_161823"
        android:gravity="center"
        android:id="@+id/msg_preference_option"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_selected_msg_option_intro"/>
    <FrameLayout
        android:background="@color/ttlive_color_0D_161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_color_161823"
        android:gravity="center"
        android:id="@+id/close_selected_message"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_close_selected_msg"/>
    <FrameLayout
        android:background="@color/ttlive_color_0D_161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_color_161823"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
