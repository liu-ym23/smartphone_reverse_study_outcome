<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_view_payment_confirm_dialog_two_root_view"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="392dp">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_sign_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/cj_pay_douyin_back_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
                android:contentDescription="@string/cj_pay_old_adapter_close_text"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_douyin_middle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_sign_show_text_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:singleLine="true"
            android:layout_below="@+id/cj_pay_sign_title"
            android:layout_centerHorizontal="true">
            <TextView
                android:textColor="@color/cj_pay_color_black_50"
                android:orientation="vertical"
                android:id="@+id/cj_pay_sign_show_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_sign_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_sign_show_text_ll"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/cj_pay_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:layout_alignParentBottom="true"
            app:btnText="@string/cj_pay_confirm_sign"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
        <FrameLayout
            android:id="@+id/cj_pay_loading_outer_layout"
            android:background="@color/cj_pay_color_white"
            android:paddingTop="100dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_loading_view"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_text_loading_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
