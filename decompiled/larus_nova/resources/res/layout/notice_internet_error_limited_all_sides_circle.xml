<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/item_all_sides_10dp_round_bg"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon_failed"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_weak_net_notice"
        app:layout_constraintEnd_toStartOf="@+id/tv_weak_net_notice"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_weak_net_notice"
        app:srcCompat="@drawable/ud_icon_cloud_failed_outlined"
        app:tint="@color/icon_n1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/ud_N900"
        android:id="@+id/tv_weak_net_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/Lark_ASLSearch_WeakNetworkNotice_InternetErrorLimitedSearch_NoticeMobile"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_retry_search"
        app:layout_constraintStart_toEndOf="@+id/iv_icon_failed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/text_link_normal"
        android:id="@+id/tv_retry_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lark_ASLSearch_WeakNetworkNotice_InternetErrorLimitedSearch_RetryMobile"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_weak_net_notice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_weak_net_notice"
        app:layout_constraintTop_toTopOf="@+id/tv_weak_net_notice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
