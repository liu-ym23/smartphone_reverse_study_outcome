<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/center_view"
        android:paddingBottom="146dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/thumb_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/thumb_img_layout"
                android:background="@drawable/ttlive_vs_bg_video_progress_thumb_img_opt"
                android:padding="0.5dp"
                android:layout_width="100dp"
                android:layout_height="180dp"
                android:layout_centerHorizontal="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/thumb_img"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/hot_label"
                    android:layout_width="29dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ttlive_replay_ic_hot_label"
                    android:layout_marginStart="6dp"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/thumb_img_loading"
                android:background="@drawable/ttlive_vs_bg_video_progress_thumb_loading_opt"
                android:padding="0.5dp"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="180dp"
                android:layout_centerHorizontal="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:id="@+id/thumb_img_loading_anim"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/progress_time"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/thumb_layout">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_cur_time"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:minWidth="65dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#ffffff"
                android:id="@+id/time_middle_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_vs_thumb_process_time_middle_line"
                android:alpha="0.5"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="4dp"
                android:alpha="0.5"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/thumb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="290dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="@+id/progress_time"
            app:layout_constraintRight_toRightOf="@+id/progress_time"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
