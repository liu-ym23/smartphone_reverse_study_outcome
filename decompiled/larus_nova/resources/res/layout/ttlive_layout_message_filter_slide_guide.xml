<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/container_background"
        android:background="#a3000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/slide_guide_view"
            android:layout_width="180dp"
            android:layout_height="230dp"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLTextView
            android:textSize="24dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/ttlive_message_filter_guide_tip"
            android:includeFontPadding="false"/>
    </LinearLayout>
</RelativeLayout>
