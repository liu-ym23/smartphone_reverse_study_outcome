<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/shape_corner_12_content_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="134dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ecommerce_common_error"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/shopping_std_bg_primary_1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/shopping_network_error"
            style="@style/font_size_34"/>
        <TextView
            android:textColor="@color/shopping_std_text_black_3"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ec_follow_store_network_error"
            style="@style/font_size_28"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_refresh"
            android:background="@drawable/ec_common_refresh_button"
            android:padding="5dp"
            android:layout_width="165dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"
            android:text="@string/shopping_refresh"
            style="@style/font_size_30"/>
    </LinearLayout>
</FrameLayout>
