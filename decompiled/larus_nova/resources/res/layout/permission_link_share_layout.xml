<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/linkShareIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ud_icon_cancel_link_outlined"
        android:scaleType="centerInside"
        android:tint="@color/icon_n1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/linkShareMore"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_14"
        android:layout_height="@dimen/space_kit_len_14"
        android:src="@drawable/ud_icon_right_outlined"
        android:scaleType="centerInside"
        android:tint="@color/icon_n3"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linkShareTitleLayout"
        android:paddingTop="@dimen/share_panel_row_entry_padding_vertical"
        android:paddingBottom="@dimen/share_panel_row_entry_padding_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_kit_len_12"
        android:layout_marginEnd="@dimen/space_kit_len_8"
        app:layout_constraintEnd_toStartOf="@+id/linkShareMore"
        app:layout_constraintStart_toEndOf="@+id/linkShareIcon"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/linkShareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/space_kit_len_22"
                android:text="@string/Bitable_Share_PeopleWithLinkInTheOrgCanView_Dropdown"
                android:layout_marginEnd="4dp"/>
            <com.bytedance.ee.bear.widgets.universedesign.SimpleTagTextView
                android:layout_gravity="left"
                android:id="@+id/linkNewShareTagView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:text="@string/CreationMobile_Wiki_Perm_ExternalShare_Current_tag"/>
        </LinearLayout>
        <com.bytedance.ee.bear.widgets.universedesign.SimpleTagTextView
            android:layout_gravity="left"
            android:id="@+id/linkShareTagView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:text="@string/CreationMobile_Wiki_Perm_ExternalShare_Current_tag"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_caption"
            android:gravity="fill"
            android:id="@+id/linkShareSubTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_4"
            android:singleLine="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
