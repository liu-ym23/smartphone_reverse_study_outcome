<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAbilityShop
        android:id="@+id/deep_feed_product_shop"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAbilityCollect
        android:id="@+id/deep_feed_product_collect_with_shop"
        android:layout_width="40dp"
        android:layout_height="37dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toRightOf="@+id/deep_feed_product_shop"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAbilityComment
        android:id="@+id/deep_feed_product_comment_with_shp"
        android:layout_width="40dp"
        android:layout_height="37dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toRightOf="@+id/deep_feed_product_collect_with_shop"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
