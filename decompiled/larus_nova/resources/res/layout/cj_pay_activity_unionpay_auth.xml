<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cj_pay_color_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_unionpay_auth_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:paddingLeft="@dimen/cj_pay_padding_16"
        android:paddingRight="@dimen/cj_pay_padding_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <ImageView
            android:id="@+id/cj_pay_unionpay_auth_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="13dp"
            android:src="@drawable/cj_pay_icon_left_close"/>
        <ImageView
            android:id="@+id/cj_pay_unionpay_auth_icons"
            android:layout_width="152dp"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:layout_centerHorizontal="true"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_unionpay_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/cj_pay_union_pay_dy_bind_up_account"
            android:layout_below="@+id/cj_pay_unionpay_auth_icons"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/cj_pay_unionpay_auth_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/cj_pay_union_pay_auth_bind_account"
            android:layout_below="@+id/cj_pay_unionpay_auth_title"/>
        <View
            android:id="@+id/cj_pay_unionpay_auth_line"
            android:background="@color/cj_pay_color_gray_161823_opacity_12"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="14dp"
            android:layout_below="@+id/cj_pay_unionpay_auth_subtitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_unionpay_auth_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_below="@+id/cj_pay_unionpay_auth_line">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_icon_authorization_correct"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/cj_pay_add_new_bank_card_input_name_label"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/cj_pay_unionpay_auth_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_unionpay_auth_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/cj_pay_unionpay_auth_name">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_icon_authorization_correct"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/cj_pay_two_elements_auth_id_num"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/cj_pay_unionpay_auth_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_unionpay_auth_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/cj_pay_unionpay_auth_id">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_icon_authorization_correct"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/cj_pay_union_pay_phone_info"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/cj_pay_unionpay_auth_phone_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/cj_pay_unionpay_auth_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:layout_alignParentBottom="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_unionpay_auth_button"
                android:background="@drawable/cj_pay_bg_red_btn_opacity_40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:text="@string/cj_pay_agree_and_continue"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:id="@+id/cj_pay_unionpay_auth_button_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="14dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <com.android.ttcjpaysdk.bindcard.base.view.CJPayAgreementView
            android:orientation="horizontal"
            android:id="@+id/cj_pay_agreement_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_above="@+id/cj_pay_unionpay_auth_button_layout"/>
    </RelativeLayout>
</FrameLayout>
