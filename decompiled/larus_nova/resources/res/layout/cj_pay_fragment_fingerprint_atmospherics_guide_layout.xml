<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_fragment_fingerprint_atmospherics_guide_root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        android:layout_height="50dp"
        android:layout_centerVertical="true"
        layout="@layout/cj_pay_view_titlebar_icon_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_result_guide_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_40"
        android:layout_below="@+id/cj_pay_titlebar_root_view">
        <TextView
            android:textSize="22dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
            android:gravity="center"
            android:id="@+id/tv_guide_tips_atmospherics"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_above="@+id/tv_sub_guide_tips_atmospherics"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/sub_guide_rl"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/iv_guide_atmospherics">
            <ImageView
                android:id="@+id/iv_sub_guide_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="6dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/tv_sub_guide_tips_atmospherics"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/iv_sub_guide_icon"
                android:layout_alignBaseline="@+id/iv_sub_guide_icon"/>
        </RelativeLayout>
        <ImageView
            android:gravity="center"
            android:id="@+id/iv_guide_atmospherics"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="173dp"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:paddingTop="203dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="30dp"
            android:textColor="@color/cj_pay_color_red_11"
            android:id="@+id/tv_discount_amount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/cj_pay_color_red_11"
            android:id="@+id/tv_cny"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/cj_pay_cny"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/tv_discount_amount"
            android:layout_alignBaseline="@+id/tv_discount_amount"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bubble_label_layout"
        android:background="@drawable/cj_pay_bg_pay_again_voucher_label"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="59dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:id="@+id/bubble_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_7"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cj_pay_open_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include
            android:gravity="center"
            android:id="@+id/cj_pay_guide_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            layout="@layout/cj_pay_common_loading_btn"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJFlashLightingView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_flashlight"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cjpay_animationDuration="1"
            app:cjpay_roundedCornerRadius="4dp"/>
    </FrameLayout>
</RelativeLayout>
