<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <com.android.ttcjpaysdk.base.ui.widget.LabelTextLayout
        android:id="@+id/cj_pay_titlebar_root_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:id="@+id/cj_pay_forget_password_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cj_pay_forget_password"
        app:layout_constraintRight_toRightOf="@+id/cj_pay_pwd_view"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <TextView
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:id="@+id/cj_pay_view_pwd_verify_error_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <com.android.ttcjpaysdk.base.ui.widget.TalkbackKeyboardNoiseReductionView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
    <include
        android:id="@+id/sign_result_rooter_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_sign_result_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
