<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="112dp"
    android:layout_height="135dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/single_drawer_holder_image_container"
        android:clipChildren="true"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/single_drawer_holder_image_multi_container"
            android:background="#161823"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/single_drawer_holder_image_v1"
                android:layout_width="39.2dp"
                android:layout_height="39.2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/single_drawer_holder_image_v2"
                android:layout_width="39.2dp"
                android:layout_height="39.2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/single_drawer_holder_image_v3"
                android:layout_width="39.2dp"
                android:layout_height="39.2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/single_drawer_holder_image_v4"
                android:layout_width="39.2dp"
                android:layout_height="39.2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/single_drawer_holder_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom"
            android:id="@+id/live_cover_dynamic_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/live_operation_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="15.5dp"
            android:layout_marginTop="6dp"
            android:scaleType="centerInside"
            android:layout_marginStart="7dp"
            app:roundedCornerRadius="2dp"/>
        <FrameLayout
            android:id="@+id/single_drawer_holder_image_shadow"
            android:background="@drawable/ttlive_feed_single_drawer_holder_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="bottom"
            android:id="@+id/single_drawer_holder_live_playing"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="feed_live_volume_icon_lottie.json"
            app:lottie_loop="true"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/single_drawer_holder_big_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/single_drawer_holder_image_container"
        app:layout_constraintStart_toStartOf="@+id/single_drawer_holder_image_container"
        app:layout_constraintTop_toBottomOf="@+id/single_drawer_holder_image_container"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ttlive_feed_single_drawer_small_tiltle"
        android:ellipsize="end"
        android:id="@+id/single_drawer_holder_small_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/single_drawer_holder_image_container"
        app:layout_constraintStart_toStartOf="@+id/single_drawer_holder_image_container"
        app:layout_constraintTop_toBottomOf="@+id/single_drawer_holder_big_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
