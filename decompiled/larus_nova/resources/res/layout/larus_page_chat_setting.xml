<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <ScrollView
        android:paddingBottom="?attr/larus_dp_20"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.RoundAvatarImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bot_avatar"
                android:layout_width="?attr/larus_dp_160"
                android:layout_height="?attr/larus_dp_160"
                android:contentDescription="@string/larus_accessibility_botAvatar"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bot_bg"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_124"
                android:layout_height="?attr/larus_dp_220"
                app:placeholderImage="?attr/larus_neutral_transparent_1"
                app:roundedCornerRadius="?attr/larus_dp_16"/>
            <FrameLayout
                android:id="@+id/chat_setting_header_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:weightSum="1"
                android:layout_marginStart="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_24">
                <TextView
                    android:textSize="?attr/larus_dp_22"
                    android:textColor="?attr/larus_neutral_100"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/bot_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"/>
                <com.larus.common_ui.widget.TagTextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/bot_tag_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_1"
                    android:layout_marginStart="?attr/larus_dp_6"/>
            </LinearLayout>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_neutral_100"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bot_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginStart="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_24"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/bot_info_area"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginStart="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_24">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hot_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_0_5"
                    android:layout_marginEnd="?attr/larus_dp_4"
                    app:srcCompat="?attr/larus_icon_tag_hot"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_50"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/bot_creator_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/bot_switch_area"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_6"
                android:layout_marginStart="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_24">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/bot_enable_web_search"
                    android:background="?attr/larus_bg_switch_config"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_24"
                    android:paddingStart="?attr/larus_dp_8"
                    android:paddingEnd="?attr/larus_dp_8">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        app:srcCompat="?attr/larus_icon_link"/>
                    <TextView
                        android:textSize="?attr/larus_sp_12"
                        android:textColor="?attr/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/bot_enable_web_search_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_search_web_btn"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_2_5"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/bot_enable_gen_pic"
                    android:background="?attr/larus_bg_switch_config"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_24"
                    android:paddingStart="?attr/larus_dp_8"
                    android:paddingEnd="?attr/larus_dp_8"
                    android:layout_marginStart="?attr/larus_dp_6">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="?attr/larus_dp_12"
                        android:layout_height="?attr/larus_dp_12"
                        app:srcCompat="?attr/larus_icon_photo"/>
                    <TextView
                        android:textSize="?attr/larus_sp_12"
                        android:textColor="?attr/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/bot_enable_gen_pic_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_image_generation"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="?attr/larus_dp_2_5"/>
                </LinearLayout>
            </LinearLayout>
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/share_button_center"
                android:background="?attr/larus_bg_share_btn"
                android:layout="@layout/larus_share_button_center_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"
                android:minWidth="?attr/larus_dp_160"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_search"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/search_section"
                    android:background="?attr/larus_bg_item_selector_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_search_chat_history"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_search_message_setting"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_get_pro"
                android:background="?attr/larus_bg_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/get_pro_item"
                    android:background="?attr/larus_bg_item_selector_only"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_cici_monetization_get_pro_btn"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_get_pro"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_review"
                android:background="?attr/larus_bg_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:textColor="@color/larus_danger_50"
                    android:id="@+id/resubmit_button"
                    android:background="?attr/larus_bg_item_selector_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_latest_edit_failed_review"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_warning"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_1"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/edit_cvs_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_edit_chat_name"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_edit"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_2"
                android:background="?attr/larus_bg_bot_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/icon_edit_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_change_app_avatar_setting"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_common_ui_avatar_placeholder"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/edit_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_bot_settings"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_edit"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/model_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_bot_setting_llm"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="?attr/larus_ic_bot_model"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/tts_speaker_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_bot_setting_voice"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_tts_speaker"
                    app:larus_image_width="?attr/larus_dp_32"
                    app:larus_long_sub_text="true"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/tts_voice_create"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_create_my_voice"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="?attr/larus_ic_voice_add"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/language_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_language"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_language_setting"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/ltm_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_settings_memory_on_off"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_ltm_settings_new"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemLongTextArrow
                    android:id="@+id/access_permission_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_bot_access_permission_public"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/nick_name_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_user_name_setting_for_bot_entrance"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_nick_name"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/plugin_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_settings_plugin_section"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_setting_plugin"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/sounds_group"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/tts_speaker_item_v2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_bot_setting_voice"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_tts_speaker"
                    app:larus_image_width="?attr/larus_dp_32"
                    app:larus_long_sub_text="true"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/realtime_call_style_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_continuousChat_fullScreen_toggle"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_realtime_full_call_switch"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_dora"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_entrance"
                    android:background="?attr/larus_bg_item_selector_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_dora_icon"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_3"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/msg_push_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_message_notifications"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_allow_message_push"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_4"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/expert_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_complex_search_chat_name_mode_toggle"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_icon_setting_expert"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_shortcart"
                android:background="?attr/larus_bg_bot_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextView
                    android:id="@+id/add_shortcart"
                    android:background="?attr/larus_bg_item_selector_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_botsettings_AddToHomescreen"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_item_add_pin_shortcut_new"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/group_5"
                android:background="?attr/larus_bg_bot_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/clear_cache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_infra_clearCache_settingsEntry_clearCache"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_setting_clear_cache"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/renew_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_clear_context"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_ic_renew_section"
                    app:larus_image_width="?attr/larus_dp_32"/>
                <com.larus.bmhome.view.item.ItemTextView
                    android:id="@+id/delete_conversation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_remove_recent_chat"
                    app:larus_image_height="?attr/larus_dp_32"
                    app:larus_image_src="@drawable/larus_clear_history"
                    app:larus_image_width="?attr/larus_dp_32"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <TextView
                android:textSize="?attr/larus_sp_11"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/healthAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24"
                android:text="@string/larus_Health_compliance_popup_notice"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_primary_50"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/llm_disclaimer_powered_by"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24"
                android:text="由豆包大模型提供支持"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
