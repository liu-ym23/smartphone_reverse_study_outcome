<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.toast.ToastBackgroundView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/toast_root"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <com.obric.oui.progress.ODownloadProgressView
            android:id="@+id/toast_progress"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            style="@style/OStyleV2.ODownloadProgressView.DayNight"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:includeFontPadding="false"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_toast_text"
            android:ellipsize="end"
            android:id="@+id/tv_msg"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:maxWidth="288dp"
            android:maxLines="3"
            android:layout_weight="1"
            style="@style/Label_L_Thin"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/oui_toast_text"
            android:id="@+id/right_button"
            android:background="@color/oui_toast_button_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            style="@style/OButton.M1.Standard.Neutral.White"/>
    </LinearLayout>
</com.obric.oui.toast.ToastBackgroundView>
