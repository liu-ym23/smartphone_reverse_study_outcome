<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scroll_view"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_8"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="?attr/larus_dp_12"
            android:paddingEnd="?attr/larus_dp_12">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="?attr/larus_dp_56"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/dorag_anti_sound_leak_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextToggle
                        android:id="@+id/dorag_anti_sound_leak_switch"
                        android:background="@drawable/larus_bg_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_antiaudioleak_title_cn"/>
                </com.larus.bmhome.view.item.ItemGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/dorag_anti_sound_leak_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="@string/larus_dora_antisoundleak_button_cn"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/dora_page_mask"
            android:background="@color/larus_dora_page_mask_color"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
