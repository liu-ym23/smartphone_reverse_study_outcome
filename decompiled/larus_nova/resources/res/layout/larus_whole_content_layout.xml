<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/text_container"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/larus_base_1"
    app:cardCornerRadius="?attr/larus_dp_16"
    app:cardElevation="?attr/larus_dp_0"
    app:cardMaxElevation="?attr/larus_dp_0">
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/content_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"/>
</androidx.cardview.widget.CardView>
