<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18dp"
        android:textColor="#404040"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_networkflow"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_core_hs_g4"
        android:gravity="center_horizontal"
        android:id="@+id/tv_free_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_networkflow_text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <View
        android:background="@color/ttlive_core_hs_g1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#404040"
        android:gravity="center"
        android:id="@+id/network_free_ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ttlive_live_mian"/>
    <View
        android:background="@color/ttlive_core_hs_g1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#404040"
        android:gravity="center"
        android:id="@+id/open"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ttlive_live_network_dialog_open"/>
    <View
        android:background="@color/ttlive_core_hs_g1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#404040"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ttlive_live_network_dialog_cancel"/>
</LinearLayout>
