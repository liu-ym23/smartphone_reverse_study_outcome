<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_constraint_layout"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.community.impl.publish.ImageAdjustView
        android:id="@+id/creation_show_component_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/creation_desc_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"/>
    <FrameLayout
        android:id="@+id/creation_desc_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/creation_publish_set_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_24"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toTopOf="@+id/publish_button_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/publish_button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larus.bmhome.view.ChatConstraintLayout>
