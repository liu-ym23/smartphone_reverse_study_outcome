<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/cj_pay_color_black"
        android:id="@+id/cj_pay_layout_money_currency"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        android:text="@string/cj_pay_currency_unit"/>
    <com.android.ttcjpaysdk.base.ui.component.money.CJMoneyTextComponent
        android:id="@+id/cj_pay_layout_money_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
