<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.view.CommonSlideRootContainer
        android:id="@+id/dismiss_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/common_pager"
            android:background="@color/larus_static_black"
            android:visibility="gone"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/container"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/back"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_common_slide_close"
            android:contentDescription="@string/larus_accessibility_icon_close"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/share"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_image_detail_icon_share_fill"
                android:contentDescription="@string/larus_accessibility_icon_share"/>
            <ImageView
                android:id="@+id/more"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_common_slide_more"
                android:contentDescription="@string/larus_accessibility_icon_more"/>
        </LinearLayout>
    </com.larus.common_ui.view.CommonSlideRootContainer>
</FrameLayout>
