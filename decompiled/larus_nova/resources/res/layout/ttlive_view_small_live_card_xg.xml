<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_card_live_cover"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_feed_cover_loading"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="@dimen/ttlive_dimen_feed_img_corner_radius"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_feed_open_d2_75"
        android:gravity="center"
        android:id="@+id/tv_douyin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:text="@string/ttlive_feed_title_tag"
        android:shadowColor="@color/ttlive_feed_open_d2_74"
        android:shadowRadius="4"
        android:layout_marginStart="6dp"
        app:layout_constraintLeft_toLeftOf="@+id/iv_card_live_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_card_live_cover"/>
    <View
        android:id="@+id/card_content_mask"
        android:background="@drawable/ttlive_bg_live_feed_small"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_card_live_cover"
        app:layout_constraintLeft_toLeftOf="@+id/iv_card_live_cover"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_card_live_cover"
        app:layout_constraintLeft_toLeftOf="@+id/iv_card_live_cover"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_feed_audience_count_color"
            android:id="@+id/tv_audience_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_white"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:maxEms="10"
            android:singleLine="true"
            android:shadowColor="@color/ttlive_feed_audience_count_shadow_color"
            android:shadowRadius="2"
            android:layout_toLeftOf="@+id/tv_audience_count"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_feed_black_text"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_card_title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5dp"
        android:maxEms="10"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/iv_card_live_cover"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover"
        app:layout_constraintTop_toBottomOf="@+id/iv_card_live_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_room_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:scaleType="centerInside"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_card_live_cover"/>
    <FrameLayout
        android:id="@+id/surface_container"
        android:background="@drawable/ttlive_feed_live_small_bg_radius2"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_card_live_cover_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover_bg"/>
    <include
        app:layout_constraintBottom_toBottomOf="@+id/iv_card_live_cover"
        app:layout_constraintLeft_toLeftOf="@+id/iv_card_live_cover"
        app:layout_constraintRight_toRightOf="@+id/iv_card_live_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_card_live_cover"
        layout="@layout/ttlive_feed_dislike_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
