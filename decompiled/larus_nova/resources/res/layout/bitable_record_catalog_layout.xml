<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:gravity="center_vertical"
        android:id="@+id/catalog_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/Bitable_QuickAdd_AddTo_Text"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="5dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/base_name"
        android:background="@drawable/bitable_page_catalog_text_bg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/base_name_right_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:tint="@color/icon_n3"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/table_name"
        android:background="@drawable/bitable_page_catalog_text_bg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"/>
</LinearLayout>
