<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/leftIconIV"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/space_kit_len_16"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ud_icon_close_small_outlined"
        app:tint="@color/facade_selector_icon_n1"/>
    <TextView
        android:textSize="@dimen/font_size_17"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/leftTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/space_kit_len_16"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <TextView
            android:textSize="@dimen/space_kit_font_17"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/titleTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/space_kit_len_16"
            android:paddingEnd="@dimen/space_kit_len_16"/>
        <TextView
            android:textSize="@dimen/space_kit_font_10"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/subTitleTV"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rightIconIV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ud_icon_close_small_outlined"
        app:tint="@color/facade_selector_icon_n1"/>
    <TextView
        android:textSize="@dimen/font_size_17"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/rightTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        android:layout_alignParentBottom="true"/>
</merge>
