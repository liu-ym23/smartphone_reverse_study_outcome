<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_lynx_dialog_root_layout"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true">
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/keep_dialog_close_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <ImageView
        android:id="@+id/title_image"
        android:layout_width="184dp"
        android:layout_height="25dp"
        android:layout_marginTop="34dp"
        android:src="@drawable/cj_pay_native_v2_reverse_counter_title"
        android:layout_centerHorizontal="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cj_pay_reverse_counter_voucher_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_below="@+id/title_image"/>
    <LinearLayout
        android:id="@+id/cj_pay_reverse_bottom_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="16dp"
        android:layout_below="@+id/cj_pay_reverse_counter_voucher_layout">
        <RelativeLayout
            android:id="@+id/cj_pay_reverse_counter_cancel_button_layout"
            android:background="@drawable/cj_pay_reverse_counter_cancel_button_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:id="@+id/cj_pay_reverse_counter_cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="5dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:id="@+id/cj_pay_reverse_counter_confirm_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_below="@+id/cj_pay_reverse_bottom_button_layout"
        app:theme_type="0"/>
</RelativeLayout>
