<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="@string/ec_window_list_tag"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.window.shop.product.pinrecyclerview.ECRecyclerViewPinnableLayout
        android:id="@+id/ec_rv_content_pin_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.window.shop.widget.ECShopRecyclerView
            android:id="@+id/ec_rv_content"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.window.shop.product.pinrecyclerview.ECRecyclerViewPinnableLayout>
</LinearLayout>
