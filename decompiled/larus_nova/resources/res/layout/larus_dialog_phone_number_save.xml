<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_dialog_phone_number_interact_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/larus_phone_save_header"
        android:background="@drawable/larus_bg_dialog_phone_number_interact_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/larus_phone_save_header_text"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_callNumber_bottomsheet_label"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/larus_phone_button_save_to_new"
        android:background="@drawable/larus_bg_phone_number_interact_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_callNumber_menuOption_createNew"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/larus_phone_button_save_to_old"
        android:background="@drawable/larus_bg_phone_number_interact_item"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_callNumber_menuOption_addToExisting"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/larus_phone_button_cancel"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:text="@string/larus_cancel"/>
</LinearLayout>
