<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rank_list_award_webp_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-44dp"
        android:layout_centerHorizontal="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/rank_list_award_webp_di"
            android:layout_width="375dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/rank_list_award_webp_light"
            android:layout_width="375dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_fans_rank_list_top_text"
            android:gravity="center"
            android:id="@+id/rank_list_award_webp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="95dp"
            android:shadowColor="@color/ttlive_fans_rank_list_top_text_shadow"
            android:shadowDy="2"
            android:shadowRadius="0.5"
            android:layout_alignTop="@+id/rank_list_award_webp_di"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/fans_rank_list_tip_lottie"
        android:visibility="gone"
        android:layout_width="175dp"
        android:layout_height="75dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="-10dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="14dp"
        android:layout_alignParentStart="true"/>
    <RelativeLayout
        android:id="@+id/pk_anim"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_pk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_level"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"
            app:placeholderImageScaleType="fitXY"/>
    </RelativeLayout>
</RelativeLayout>
