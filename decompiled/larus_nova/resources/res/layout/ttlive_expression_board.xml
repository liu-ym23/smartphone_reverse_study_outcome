<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.uikit.viewpager.SSViewPager
        android:id="@+id/emoji_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0.5dp"
        android:layout_marginBottom="60dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <View
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toTopOf="@+id/rv_emoji_section_list"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_emoji_section_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#838489"
            android:gravity="center"
            android:id="@+id/emoji_send_btn_grey"
            android:background="@drawable/ttlive_emoji_send_btn_grey"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_emoji_new_send"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/emoji_send_btn_red"
            android:background="@drawable/ttlive_emoji_send_btn_red"
            android:visibility="invisible"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_emoji_new_send"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:textSize="18dp"
            android:id="@+id/emoji_delete_btn"
            android:background="@drawable/ttlive_emoji_del_btn_stroke"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ttlive_emoji_ic_new_delete"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/emoji_send_btn_grey"
            app:layout_constraintRight_toLeftOf="@+id/emoji_send_btn_grey"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
