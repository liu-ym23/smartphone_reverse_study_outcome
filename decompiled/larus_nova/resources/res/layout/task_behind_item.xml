<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/primary_fill_default"
    android:layout_width="@dimen/dp_100"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/behind_item_icon"
        android:layout_width="20sp"
        android:layout_height="20sp"
        android:src="@drawable/ud_icon_share_outlined"
        android:tint="@color/static_white"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/static_white"
        android:gravity="center_horizontal"
        android:id="@+id/behind_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/Todo_Common_Share"
        android:maxLines="1"
        android:singleLine="true"/>
</LinearLayout>
