<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_home_drive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/list_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/list_home_coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/list_sub_menu_layout"
                android:background="@color/translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.FlingBehavior">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/list_collapsing_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    app:layout_scrollFlags="enterAlwaysCollapsed|exitUntilCollapsed|scroll"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/list_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.bytedance.ee.bear.list.homepage.tab.HomeSubMenuView
                        android:id="@+id/home_sub_title_view"
                        android:paddingTop="@dimen/dp_16"
                        android:paddingBottom="9dp"
                        android:layout_width="match_parent"
                        android:layout_height="53dp"
                        android:paddingStart="@dimen/dp_10"
                        android:paddingEnd="@dimen/dp_10"/>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.bytedance.ee.bear.list.homepage.tab.HomeViewPager
                android:id="@+id/list_home_viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.KeepWithinParentBoundsScrollingBehavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</FrameLayout>
