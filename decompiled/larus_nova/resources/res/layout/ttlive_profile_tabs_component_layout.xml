<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/my_live_tabs_error_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tabs_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="71dp"
            android:text="@string/ttlive_tab_error_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_color_66_161823"
            android:id="@+id/tabs_error_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_tab_error_desc"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tabs_error_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/my_live_tabs_container"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/tab_layout_container_dress_bg"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tab_layout_container"
            app:layout_constraintLeft_toLeftOf="@+id/tab_layout_container"
            app:layout_constraintRight_toRightOf="@+id/tab_layout_container"
            app:layout_constraintTop_toTopOf="@+id/tab_layout_container"/>
        <FrameLayout
            android:id="@+id/tab_layout_container"
            android:background="@drawable/ttlive_bg_tab_layout"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabBackground="@color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/ttlive_color_161823"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@color/transparent"/>
        </FrameLayout>
        <View
            android:id="@+id/tab_layout_divider_bg"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="@+id/tab_layout_divider"
            app:layout_constraintLeft_toLeftOf="@+id/tab_layout_divider"
            app:layout_constraintRight_toRightOf="@+id/tab_layout_divider"
            app:layout_constraintTop_toTopOf="@+id/tab_layout_divider"/>
        <View
            android:id="@+id/tab_layout_divider"
            android:background="@color/ttlive_color_1F_161823"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_layout_container"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:background="@color/ttlvie_tab_viewpager_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_layout_divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
