<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="39dp">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ttlive_live_fans_pop"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/pop_text"
        android:background="@drawable/ttlive_bg_fans_clup_tip"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:text="@string/ttlive_live_fans_club_tips"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <View
        android:background="@drawable/ttlive_ic_top_arrow"
        android:layout_width="12dp"
        android:layout_height="6dp"
        android:layout_marginLeft="15dp"
        android:layout_marginStart="15dp"/>
</FrameLayout>
