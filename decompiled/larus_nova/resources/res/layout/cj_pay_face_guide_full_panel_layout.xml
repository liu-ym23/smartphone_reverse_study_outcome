<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_face_guide_full_panel_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.facelive.view.CJPayFaceTopRoundFL
        android:id="@+id/cj_pay_face_guide_bg_view_con"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/cj_pay_face_guide_status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
    <RelativeLayout
        android:id="@+id/cj_pay_face_guide_title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@+id/cj_pay_face_guide_status_bar_placeholder">
        <ImageView
            android:id="@+id/cj_pay_face_guide_back_view"
            android:padding="@dimen/cj_pay_padding_4"
            android:layout_width="21dp"
            android:layout_height="29dp"
            android:layout_marginLeft="@dimen/cj_pay_padding_12"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/cj_pay_face_guide_top_dy_icon_con"
            android:layout_width="90dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="23sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_face_guide_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="122dp"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:singleLine="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_face_guide_sub_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:maxLines="2"
        android:layout_below="@+id/cj_pay_face_guide_title_view"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/cj_pay_face_guide_scan_gif_view_con"
        android:layout_width="271dp"
        android:layout_height="271dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cj_pay_color_white"
        android:id="@+id/cj_pay_face_guide_scan_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_height_28"
        android:layout_alignTop="@+id/cj_pay_face_guide_scan_gif_view_con"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_face_guide_protocol_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/cj_pay_padding_40"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/cj_pay_face_guide_scan_gif_view_con">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_face_guide_protocol_checkbox_light"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="4dp"
            app:CJPayEnableBgDrawable="@drawable/cj_pay_icon_check_box_pressed2"
            app:CJPayUnenbleBgDrawable="@drawable/cj_pay_icon_face_guide_activity_circle_checkbox_unnable_light"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_face_guide_protocol_checkbox_dark"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="4dp"
            app:CJPayEnableBgDrawable="@drawable/cj_pay_icon_face_guide_activity_circle_checkbox_enable_dark"
            app:CJPayUnenbleBgDrawable="@drawable/cj_pay_icon_face_guide_activity_circle_checkbox_unnable_dark"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="middle"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_face_guide_protocol_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cj_pay_face_guide_confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:layout_below="@+id/cj_pay_face_guide_protocol_container">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_face_guide_confirm_btn"
            android:background="@drawable/cj_pay_bg_face_guide_red_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cj_pay_face_guide_confirm_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        app:theme_type="0"/>
</RelativeLayout>
