<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.common.TouchDetectFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touch_detect_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.core.infoarch.arch.BitableBackgroundContainer
        android:id="@+id/bitable_background_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bitable_nested_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.bitable.infoarch.top.BitableTopContainer
            android:id="@+id/bitable_top_container"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.ee.bear.bitable.core.infoarch.BitableContentContainer
            android:id="@+id/bitable_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:radius="0dp">
            <include layout="@layout/doc_web_container"/>
            <com.bytedance.ee.bear.bitable.infoarch.nativeview.BitableNativeViewContainer
                android:id="@+id/bitable_native_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ViewStub
                android:id="@+id/bitable_native_empty_view"
                android:layout="@layout/bitable_native_empty_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.ee.bear.bitable.core.infoarch.BitableContentContainer>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.bytedance.ee.bear.bitable.infoarch.block.BitableBlockCatalogContainer
        android:id="@+id/bitable_block_catalog_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/contentOuterContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/doc_appbar_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/titleContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.infoarch.titlebar.BitableBaseTitleBar
                android:gravity="center_vertical"
                android:id="@+id/doc_main_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/doc_titlebar_height"
                app:widget_widgets_tb_background="@color/transparent"/>
            <ViewStub
                android:id="@+id/doc_main_tip"
                android:layout="@layout/doc_main_tips_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.bytedance.ee.bear.bitable.infoarch.view.BitableLoadingContainer
        android:id="@+id/global_loading_layout"
        android:background="@color/bg_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/pluginUIContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/native_record_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/permission_forbid_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.bytedance.ee.bear.bitable.common.TouchDetectFrameLayout>
