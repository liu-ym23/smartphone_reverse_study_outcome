<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/container_layout"
    android:background="@drawable/larus_dora_toast_wearing_detection_background"
    android:padding="?attr/larus_dp_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="?attr/larus_dp_5">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dora_g_wear_toast_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/dora_g_wear_toast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_184"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/dora_g_wear_toast_battery_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_g_wear_toast_battery_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_g_wear_toast_title">
            <ImageView
                android:id="@+id/dora_g_wear_toast_device_icon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/dora_g_wear_toast_battery_progress_layout"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginStart="?attr/larus_dp_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_g_wear_toast_device_icon"
                app:layout_constraintTop_toTopOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dora_g_wear_toast_battery_progress"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dora_g_wear_toast_battery_progress_none"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"
                    android:src="@drawable/larus_dora_onboarding_battery_none"/>
            </FrameLayout>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_g_wear_toast_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_g_wear_toast_battery_progress_layout"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_g_box_wear_toast_battery_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dora_g_wear_toast_battery_layout"
            app:layout_constraintTop_toTopOf="@+id/dora_g_wear_toast_battery_layout">
            <ImageView
                android:id="@+id/dora_g_box_wear_toast_device_icon"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/dora_g_box_wear_toast_battery_progress_layout"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginStart="?attr/larus_dp_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_g_box_wear_toast_device_icon"
                app:layout_constraintTop_toTopOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dora_g_box_wear_toast_battery_progress"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dora_g_box_wear_toast_battery_progress_none"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"
                    android:src="@drawable/larus_dora_onboarding_battery_none"/>
            </FrameLayout>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/dora_g_box_wear_toast_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_g_box_wear_toast_battery_progress_layout"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/dora_g_wear_toast_icon"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_48"
        android:src="@null"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dora_g_wear_toast_content_layout"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
