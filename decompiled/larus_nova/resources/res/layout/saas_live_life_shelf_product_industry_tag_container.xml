<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="40dp"
    android:layout_height="40dp">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_industry_tag_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="9dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/live_life_shelf_product_industry_tag_tv"
        android:background="@drawable/bg_poi_live_goods_shelves_industry_tag"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Medium"/>
</merge>
