<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttdownloader_bg_order_wifi_choose_dialog"
    android:layout_width="250dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/iv_dialog_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="5dp"
        android:src="@drawable/ttdownloader_icon_close"/>
    <ImageView
        android:id="@+id/iv_order_result"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ttdownloader_icon_correct_circle"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_order_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="12dp"
            android:textColor="#4d161823"
            android:id="@+id/tv_order_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Switch
            android:id="@+id/switch_order_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttdownloader_thumb_wifi_choose"
            android:track="@drawable/ttdownloader_track_wifi_choose"
            android:switchMinWidth="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_wifi_choose"
        android:background="@drawable/ttdownloader_bg_appinfo_btn"
        android:layout_width="240dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="5dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成"/>
    </LinearLayout>
</LinearLayout>
