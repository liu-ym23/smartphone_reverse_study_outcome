<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/container_layout"
    android:background="@drawable/larus_toast_background"
    android:padding="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="?attr/larus_dp_5">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/left_icon_view"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/larus_dora_phone_icon"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/inner_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/left_icon_view"
        app:layout_constraintTop_toTopOf="@+id/left_icon_view">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:ellipsize="end"
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:maxWidth="280dp"
            android:maxLines="1"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/left_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_10"
                android:layout_height="?attr/larus_dp_10"
                android:src="@drawable/larus_dora_left"
                android:layout_marginEnd="?attr/larus_dp_2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#666666"
                android:id="@+id/left_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/right_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_10"
                android:layout_height="?attr/larus_dp_10"
                android:src="@drawable/larus_dora_right"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#666666"
                android:id="@+id/right_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
