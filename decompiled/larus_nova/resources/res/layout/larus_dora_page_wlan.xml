<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_wlan_group"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_20"
                android:layout_marginEnd="?attr/larus_dp_20">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/dora_wlan_switch"
                    android:background="@drawable/larus_bg_item_selector"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI视觉能力启用WiFi通道"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <TextView
                android:textSize="?attr/larus_dp_18"
                android:textColor="@color/larus_neutral_100"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_wlan_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24"
                android:text=""
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_20"
                android:layout_marginEnd="?attr/larus_dp_20"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginStart="?attr/larus_dp_20"
                android:layout_marginEnd="?attr/larus_dp_20">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="打开【AI视觉能力启用WiFi通道】后,进入陪伴模式会自动联网。\10联网需要满足如下条件:"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/dora_wlan_state_perm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="1.APP有位置权限"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/dora_wlan_state_gps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="2.手机定位处于打开状态"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/dora_wlan_state_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="3.手机WiFi处于打开状态"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/dora_wlan_state_ap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:text="4.手机热点处于关闭状态"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </LinearLayout>
            <View
                android:background="@drawable/larus_item_divider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="?attr/larus_dp_24"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_48">
                <TextView
                    android:textSize="?attr/larus_dp_16"
                    android:textColor="@color/larus_primary_50"
                    android:gravity="center"
                    android:id="@+id/wlan_config"
                    android:background="@drawable/larus_bg_rightdown_selector"
                    android:layout_width="?attr/larus_dp_0"
                    android:layout_height="match_parent"
                    android:text="连接热点"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.larus.bmhome.view.item.ItemGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_p2p_connect"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="建立p2p连接"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_p2p_disconnect"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="断开p2p连接"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
