<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_skill_item_middle"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <FrameLayout
        android:id="@+id/item_left_icon_container"
        android:layout_width="?attr/larus_dp_22"
        android:layout_height="?attr/larus_dp_22"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/item_left_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/larus_ic_connector_fallback"
            app:failureImageScaleType="centerCrop"
            app:placeholderImage="@drawable/larus_ic_connector_fallback"
            app:placeholderImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
        <View
            android:id="@+id/item_left_icon_outer_border"
            android:background="@drawable/larus_bg_connector_icon_outer_border"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/item_left_icon_border"
            android:background="@drawable/larus_bg_connector_action_bar_icon_border"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/item_main_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_end_container"
        app:layout_constraintStart_toEndOf="@+id/item_left_icon_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/item_end_container"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.bmhome.view.item.CustomSwitchCompat
            android:layout_gravity="end|center_vertical"
            android:id="@+id/item_connect_switch"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_24"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:thumb="@drawable/larus_bg_switch_thumb"
            android:switchMinWidth="?attr/larus_dp_48"
            android:switchPadding="0dp"
            android:thumbTextPadding="0dp"
            android:showText="false"
            app:track="?attr/larus_bg_switch_track"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_connect_action"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_24">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="?attr/larus_neutral_50"
                android:gravity="center_vertical"
                android:id="@+id/item_connect_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_input_connector_connect"
                android:includeFontPadding="false"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_connect_arrow"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:scaleType="center"
                android:contentDescription="@null"
                app:srcCompat="?attr/larus_ic_arrow"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/item_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
